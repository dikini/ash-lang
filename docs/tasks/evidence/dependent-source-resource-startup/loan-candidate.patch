+            .unwrap();
+        let mut short = TypeWorkBudget::with_limit(3);
+        assert_resource(loan.get(ids[0], &sources[0], &mut short));
+        let mut exact = TypeWorkBudget::with_limit(4);
+        assert!(Arc::ptr_eq(
+            &warm,
+            &loan.get(ids[0], &sources[0], &mut exact).unwrap()
+        ));
+        assert_eq!(exact.used(), 4);
+    }
+}
