+            0..crate::module::ForeignCheckedNominalRole::ViolationCause.local() + 1
+        } else {
+            1..2
+        };
+        let module = self.module();
+        range.map(move |local| {
+            (
+                crate::types::NominalTypeId::new(module, local),
+                !matches!(local, 0 | 5),
+            )
+        })
+    }
