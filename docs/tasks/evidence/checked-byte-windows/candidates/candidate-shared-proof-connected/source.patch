index 33e640ff..f4de82d7 100644
--- a/src/resolved/checked_codec_category_tests.rs
+++ b/src/resolved/checked_codec_category_tests.rs
@@ -290,3 +290,86 @@ fn checked_memory_scheme_kinds_require_exact_complete_original_formals() {
         }
     }
 }
