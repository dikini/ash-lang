+/// Test-only scheduling experiment. This scope supplies no graph/proof/result.
+pub(crate) fn with_deferred_calls<T>(operation: impl FnOnce() -> T) -> T {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            DEFER_CALLS.with(|value| value.set(self.0));
+        }
+    }
+    let previous = DEFER_CALLS.with(|value| value.replace(true));
+    let _restore = Restore(previous);
+    operation()
+}
+
+pub(crate) fn defer_calls() -> bool {
+    DEFER_CALLS.with(Cell::get)
+}
