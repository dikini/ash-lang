+        );
+        changed
+            .replace(
+                "Foreign.CheckedFinish<State<H, R>, Unit>",
+                "FakeFinish<State<H, R>, Unit>",
+            )
+            .replace("Foreign.FinishedConsumed", "FakeConsumed")
+            .replace("Foreign.FinishedRetained", "FakeRetained")
+            .replace("Foreign.FinishedBoundary", "FakeBoundary")
+    });
+}
