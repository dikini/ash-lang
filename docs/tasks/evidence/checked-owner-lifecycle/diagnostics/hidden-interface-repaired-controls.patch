+#[test]
+fn checked_hidden_provider_interface_cannot_be_imported_by_private_spelling() {
+    assert_hidden_provider(&producer());
+    let graph = graph(Some(
+        "import producer (ProbeProvider)\nmain : Unit -> Int\nmain () = 42\n",
