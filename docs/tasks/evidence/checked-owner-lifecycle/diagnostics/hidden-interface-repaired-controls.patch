+                    "{message}"
+                );
+                assert!(!message.contains("ResourceExhausted"), "{message}");
+                return;
+            }
+            Err(error) => {
+                panic!("unsupported scalar lifecycle must reject semantically: {error:?}")
+            }
+        }
+    }
+    panic!("fallible scalar conversion cannot use the State-only void finish refinement");
+}
