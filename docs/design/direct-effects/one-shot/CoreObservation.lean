import CoreMachine

/-! Structural projection of the independent machine and actual Rust snapshots.
This is a successful finite-trace comparison interface, not a general simulation
or static admission theorem. Rust frames are exported inner-first. Model handler
occurrence, ticket, cleanup and close names are ghost data: projection retains
all static owner identities and every live/consumed capture, but those dynamic
names have no Rust field. The checker also retains the complete model ghost
state through `next`; it never invents a successor from a desired observation.

Export expands the immutable observer environment table into finite lexical
chains, retaining each entry's visible length and instantiation plus the current
map. Observer table sharing indices and static origins remain in Rust snapshots;
they are not semantic fields of this model. Heap locations and sharing survive.

Raw tuple metadata survives export. Its binary progress and graph membership
are checked; the right phase's environment/elements are inert in both machines.
Effect-event declaration identities retain no invented arguments; currently the
checker compares entered nodes and the cell-event subsequence. Handler effect
events are retained, with semantic selection checked by states rather than an
equality of ghost-labelled events. Request projection compares exact lexical resource instantiation, because Rust
stores that map rather than the model's complete request environment. Heap
aliases/uninitialized cells are retained but rejected by this successful trace.
Capacity/work records are Rust annotations, not mathematical storage bounds or
proof that failing preparation is atomic. -/
namespace Ash.OneShot.CoreObservation
open CoreSyntax

abbrev ResourceMap := List (Nat × Nat)

def insertResource (name key : Nat) : ResourceMap → ResourceMap
  | [] => [(name, key)]
  | (other, value) :: rest =>
      if name < other then (name, key) :: (other, value) :: rest
      else if name == other then (name, key) :: rest
      else (other, value) :: insertResource name key rest

mutual
inductive Value where
  | unit | boolean : Bool → Value | integer : Int → Value
  | handle : Nat → Value | location : Nat → Value
  | closure : Nat → NodeRef → NodeRef → Nat → Environment → Value
  deriving Repr
inductive Environment where
  | mk : Nat → ResourceMap → List Entry → Environment
  deriving Repr
inductive Entry where
  | binding : Nat → Value → Nat → ResourceMap → Entry
  | template : Nat → Nat → NodeRef → Nat → ResourceMap → Entry
  deriving Repr
end

/- Transparent comparisons are used instead of the opaque mutual BEq code
   generated by deriving. Their complete structural recursion is kernel data. -/
mutual
def valueEq : Value → Value → Bool
  | .unit, .unit => true
  | .boolean left, .boolean right => left == right
  | .integer left, .integer right => left == right
  | .handle left, .handle right | .location left, .location right => left == right
  | .closure parameter body root nodes environment, .closure other otherBody otherRoot otherNodes otherEnvironment =>
      parameter == other && body == otherBody && root == otherRoot && nodes == otherNodes && environmentEq environment otherEnvironment
  | _, _ => false
def environmentEq : Environment → Environment → Bool
  | .mk length resources entries, .mk otherLength otherResources otherEntries =>
      length == otherLength && resources == otherResources && entriesEq entries otherEntries
def entryEq : Entry → Entry → Bool
  | .binding binder value length resources, .binding other otherValue otherLength otherResources =>
      binder == other && valueEq value otherValue && length == otherLength && resources == otherResources
  | .template binder parameter body length resources, .template other otherParameter otherBody otherLength otherResources =>
      binder == other && parameter == otherParameter && body == otherBody && length == otherLength && resources == otherResources
  | _, _ => false
def entriesEq : List Entry → List Entry → Bool
  | [], [] => true
  | entry :: rest, other :: otherRest => entryEq entry other && entriesEq rest otherRest
  | _, _ => false
end

mutual
theorem valueEq_sound (left right : Value) (equal : valueEq left right = true) : left = right := by
  cases left <;> cases right <;> simp_all [valueEq, Bool.and_eq_true]
  rcases equal with ⟨⟨⟨⟨rfl, rfl⟩, rfl⟩, rfl⟩, environment⟩
  have environmentEqual := environmentEq_sound _ _ environment
  simp_all
theorem environmentEq_sound (left right : Environment) (equal : environmentEq left right = true) : left = right := by
  cases left <;> cases right <;> simp_all [environmentEq, Bool.and_eq_true]
  rcases equal with ⟨⟨rfl, rfl⟩, entries⟩
  have entriesEqual := entriesEq_sound _ _ entries
  simp_all
theorem entryEq_sound (left right : Entry) (equal : entryEq left right = true) : left = right := by
  cases left <;> cases right <;> simp_all [entryEq, Bool.and_eq_true]
  rcases equal with ⟨⟨⟨rfl, value⟩, rfl⟩, rfl⟩
  have valueEqual := valueEq_sound _ _ value
  simp_all
theorem entriesEq_sound (left right : List Entry) (equal : entriesEq left right = true) : left = right := by
  cases left <;> cases right <;> simp_all [entriesEq, Bool.and_eq_true]
  obtain ⟨head, tail⟩ := equal
  have headEqual := entryEq_sound _ _ head
  have tailEqual := entriesEq_sound _ _ tail
  simp_all
end

instance : BEq Value := ⟨valueEq⟩
instance : BEq Environment := ⟨environmentEq⟩
instance : BEq Entry := ⟨entryEq⟩

def Environment.length : Environment → Nat | .mk length _ _ => length
def Environment.resources : Environment → ResourceMap | .mk _ resources _ => resources
def Environment.entries : Environment → List Entry | .mk _ _ entries => entries

mutual
def projectValue (graph : Graph) : CoreMachine.Value → Value
  | .unit => .unit | .boolean value => .boolean value | .integer value => .integer value
  | .handle key => .handle key | .location key => .location key
  | .closure parameter body environment => .closure parameter body graph.root graph.nodes.length (projectEnvironment graph environment)
def projectEnvironment (graph : Graph) : CoreMachine.Environment → Environment
  | .empty => .mk 0 [] []
  | .resource name key rest =>
      let .mk length resources entries := projectEnvironment graph rest
      .mk length (insertResource name key resources) entries
  | .binding binder value rest =>
      let .mk length resources entries := projectEnvironment graph rest
      .mk (length + 1) resources (.binding binder (projectValue graph value) (length + 1) resources :: entries)
  | .functionTemplate binder parameter body rest =>
      let .mk length resources entries := projectEnvironment graph rest
      .mk (length + 1) resources (.template binder parameter body (length + 1) resources :: entries)
end

inductive HeapCell where
  | uninitialized | alias : Nat → HeapCell | pair : Value → Value → HeapCell
  deriving BEq, Repr

inductive RawFrame where
  | closeCompletion
  | cleanupBoundary : NodeRef → Environment → RawFrame
  | cleanupCompletion : Value → RawFrame
  | resourceInitializer : NodeRef → Environment → RawFrame
  | resourceBoundary : NodeRef → Nat → Int → RawFrame
  | bind : Nat → NodeRef → Environment → RawFrame
  | applyFunction : NodeRef → Environment → RawFrame
  | applyArgument : Value → RawFrame
  | tuple : List NodeRef → Nat → List Value → Environment → RawFrame
  | matchCases : List MatchArm → Environment → RawFrame
  | handlerBoundary : NodeRef → Instantiation.Effect → Environment → RawFrame
  | request : NodeRef → Instantiation.Effect → ResourceMap → RawFrame
  | resume : NodeRef → RawFrame
  | clauseBoundary : Nat → Nat → Option (List RawFrame) → RawFrame
  deriving BEq, Repr

inductive Frame where
  | closeCompletion
  | cleanupBoundary : NodeRef → Environment → Frame
  | cleanupCompletion : Value → Frame
  | resourceInitializer : NodeRef → Environment → Frame
  | resourceBoundary : NodeRef → Nat → Int → Frame
  | bind : Nat → NodeRef → Environment → Frame
  | applyFunction : NodeRef → Environment → Frame
  | applyArgument : Value → Frame
  | tupleLeft : NodeRef → Environment → Frame
  | tupleRight : Value → Frame
  | matchCases : List MatchArm → Environment → Frame
  | handlerBoundary : NodeRef → Environment → Frame
  | request : Instantiation.Effect → Nat → ResourceMap → Frame
  | resume : Nat → Nat → Frame
  | clauseBoundary : Nat → Nat → Option (List Frame) → Frame
  deriving Repr

mutual
def frameEq : Frame → Frame → Bool
  | .closeCompletion, .closeCompletion => true
  | .cleanupBoundary action environment, .cleanupBoundary other otherEnvironment => action == other && environment == otherEnvironment
  | .cleanupCompletion value, .cleanupCompletion other => value == other
  | .resourceInitializer node environment, .resourceInitializer other otherEnvironment => node == other && environment == otherEnvironment
  | .resourceBoundary node key payload, .resourceBoundary other otherKey otherPayload => node == other && key == otherKey && payload == otherPayload
  | .bind binder body environment, .bind other otherBody otherEnvironment => binder == other && body == otherBody && environment == otherEnvironment
  | .applyFunction node environment, .applyFunction other otherEnvironment => node == other && environment == otherEnvironment
  | .applyArgument value, .applyArgument other => value == other
  | .tupleLeft node environment, .tupleLeft other otherEnvironment => node == other && environment == otherEnvironment
  | .tupleRight value, .tupleRight other => value == other
  | .matchCases arms environment, .matchCases other otherEnvironment => arms == other && environment == otherEnvironment
  | .handlerBoundary node environment, .handlerBoundary other otherEnvironment => node == other && environment == otherEnvironment
  | .request effect operation resources, .request other otherOperation otherResources => effect == other && operation == otherOperation && resources == otherResources
  | .resume handler owner, .resume other otherOwner => handler == other && owner == otherOwner
  | .clauseBoundary handler owner capture, .clauseBoundary other otherOwner otherCapture => handler == other && owner == otherOwner && captureEq capture otherCapture
  | _, _ => false
def captureEq : Option (List Frame) → Option (List Frame) → Bool
  | none, none => true
  | some saved, some other => framesEq saved other
  | _, _ => false

def framesEq : List Frame → List Frame → Bool
  | [], [] => true
  | frame :: rest, other :: otherRest => frameEq frame other && framesEq rest otherRest
  | _, _ => false
end

mutual
theorem frameEq_sound (left right : Frame) (equal : frameEq left right = true) : left = right := by
  cases left <;> cases right <;> simp_all [frameEq, Bool.and_eq_true, and_assoc]
  all_goals repeat (first | obtain ⟨rfl, equal⟩ := equal)
  all_goals first
    | (have same := valueEq_sound _ _ equal; simp_all)
    | (have same := environmentEq_sound _ _ equal; simp_all)
    | (have same := captureEq_sound _ _ equal; simp_all)
    | simp_all
theorem captureEq_sound (left right : Option (List Frame)) (equal : captureEq left right = true) : left = right := by
  cases left <;> cases right <;> simp_all [captureEq]
  have savedEqual := framesEq_sound _ _ equal
  simp_all

theorem framesEq_sound (left right : List Frame) (equal : framesEq left right = true) : left = right := by
  cases left <;> cases right <;> simp_all [framesEq, Bool.and_eq_true]
  obtain ⟨head, tail⟩ := equal
  have headEqual := frameEq_sound _ _ head
  have tailEqual := framesEq_sound _ _ tail
  simp_all
end

instance : BEq Frame := ⟨frameEq⟩

inductive Control where
  | evaluate : NodeRef → Environment → Control
  | returned : Value → Control
  | discard : Nat → Nat → Control
  deriving BEq, Repr

structure Accounting where
  nextActivation : Nat
  capturedCells : Nat
  liveResources : Nat
  liveCleanups : Nat
  liveRegistrations : Nat
  nextRegistration : Nat
  maxFrameDepth : Nat
  captureLimit : Nat
  resourceLimit : Nat
  cleanupLimit : Nat
  registrationLimit : Nat
  workUsed : Nat
  workRemaining : Nat
  deriving BEq, Repr

inductive EffectDeclaration where
  | cell | user : Nat → EffectDeclaration
  deriving BEq, Repr

inductive EffectEvent where
  | acquired : Nat → EffectEvent | read : Nat → EffectEvent
  | written : Nat → EffectEvent | released : Nat → EffectEvent
  | handlerActivated : Nat → EffectEvent | request : EffectDeclaration → Nat → EffectEvent
  | handlerSelected : Nat → EffectEvent | clauseEntered : Nat → EffectDeclaration → Nat → EffectEvent
  | resumed : Nat → EffectEvent | discarded : Nat → EffectEvent
  | handlerRestored : Nat → EffectEvent | clauseReturned : Nat → EffectEvent
  deriving BEq, Repr

structure Snapshot where
  control : Control
  frames : List RawFrame
  heap : List HeapCell
  accounting : Accounting
  entered : List NodeRef
  effects : List EffectEvent
  deriving BEq, Repr

mutual
def projectFrame (graph : Graph) : CoreMachine.Frame → Frame
  | .bind binder body environment => .bind binder body (projectEnvironment graph environment)
  | .applyFunction argument environment => .applyFunction argument (projectEnvironment graph environment)
  | .applyArgument value => .applyArgument (projectValue graph value)
  | .tupleLeft right environment => .tupleLeft right (projectEnvironment graph environment)
  | .tupleRight left => .tupleRight (projectValue graph left)
  | .matchCases arms environment => .matchCases arms (projectEnvironment graph environment)
  | .resourceInitializer index _ _ _ environment => .resourceInitializer index (projectEnvironment graph environment)
  | .resourceBoundary index key payload => .resourceBoundary index key payload
  | .request effect operation environment => .request effect operation (projectEnvironment graph environment).resources
  | .handlerBoundary node environment _ => .handlerBoundary node (projectEnvironment graph environment)
  | .resume handler owner => .resume handler owner
  | .clauseBoundary handler owner _ _ none => .clauseBoundary handler owner none
  | .clauseBoundary handler owner _ _ (some capture) => .clauseBoundary handler owner (some (projectFrames graph capture))
  | .cleanupBoundary action environment _ => .cleanupBoundary action (projectEnvironment graph environment)
  | .cleanupCompletion _ saved => .cleanupCompletion (projectValue graph saved)
  | .closeCompletion _ => .closeCompletion
def projectFrames (graph : Graph) : List CoreMachine.Frame → List Frame
  | [] => [] | frame :: rest => projectFrame graph frame :: projectFrames graph rest
end

def projectControl (graph : Graph) : CoreMachine.Control → Control
  | .evaluate node environment => .evaluate node (projectEnvironment graph environment)
  | .returned value => .returned (projectValue graph value)
  | .discard handler owner => .discard handler owner

def projectHeap (graph : Graph) (heap : CoreMachine.Heap) : List HeapCell :=
  heap.map fun cell => match cell with | .pair left right => .pair (projectValue graph left) (projectValue graph right)

mutual
/-- Saved cells include every recursively dormant capture. -/
def frameCapturedCells : Frame → Nat
  | .clauseBoundary _ _ (some saved) => saved.length + capturedCells saved
  | _ => 0
def capturedCells : List Frame → Nat
  | [] => 0
  | frame :: rest => frameCapturedCells frame + capturedCells rest
end

mutual
/-- Ownership includes active and dormant cells, armed and running cleanups. -/
def frameOwners : Frame → Nat × Nat
  | .resourceBoundary _ _ _ => (1, 0)
  | .cleanupBoundary _ _ | .cleanupCompletion _ => (0, 1)
  | .clauseBoundary _ _ (some saved) => owners saved
  | _ => (0, 0)
def owners : List Frame → Nat × Nat
  | [] => (0, 0)
  | frame :: rest =>
      let (resources, cleanups) := frameOwners frame
      let (outerResources, outerCleanups) := owners rest
      (resources + outerResources, cleanups + outerCleanups)
end

/-- Only data needed by a live tuple phase is projected. Original raw metadata
    is retained in `Snapshot.frames` and must pass this exact shape check. -/
def tupleInGraph (graph : Graph) (elements : List NodeRef) : Bool :=
  graph.nodes.any fun node => match node.kind with | .tuple saved => saved == elements | _ => false

mutual
def frameView (graph : Graph) : RawFrame → Option Frame
  | .closeCompletion => some .closeCompletion
  | .cleanupBoundary node environment => some (.cleanupBoundary node environment)
  | .cleanupCompletion value => some (.cleanupCompletion value)
  | .resourceInitializer node environment => do
      match (← graph.node node).kind with
      | .resource _ _ _ _ => some (.resourceInitializer node environment)
      | _ => none
  | .resourceBoundary node key payload => do
      match (← graph.node node).kind with
      | .resource _ _ _ _ => some (.resourceBoundary node key payload)
      | _ => none
  | .bind binder body environment => some (.bind binder body environment)
  | .applyFunction argument environment => some (.applyFunction argument environment)
  | .applyArgument value => some (.applyArgument value)
  | .tuple elements next values environment =>
      if !tupleInGraph graph elements then none else
      match elements, next, values with
      | [_, right], 1, [] => some (.tupleLeft right environment)
      | [_, _], 2, [left] => some (.tupleRight left)
      | _, _, _ => none
  | .matchCases arms environment => some (.matchCases arms environment)
  | .handlerBoundary node effect environment => do
      match (← graph.node node).kind with
      | .handler _ handled _ _ => if effect == handled then some (.handlerBoundary node environment) else none
      | _ => none
  | .request node effect resources => do
      match (← graph.node node).kind with
      | .request requested operation _ => if effect == requested then some (.request effect operation resources) else none
      | _ => none
  | .resume node => do
      match (← graph.node node).kind with
      | .resume handler owner _ _ => some (.resume handler owner)
      | _ => none
  | .clauseBoundary handler owner capture => do
      let saved ← match capture with | none => some none | some frames => some <$> framesView graph frames
      some (.clauseBoundary handler owner saved)
def framesView (graph : Graph) : List RawFrame → Option (List Frame)
  | [] => some []
  | frame :: rest => do pure ((← frameView graph frame) :: (← framesView graph rest))
end

/- Binary right-phase metadata must have appeared in an earlier left-phase
    frame, whose caller environment was compared to the model. This also checks
    dormant frames, rather than treating arbitrary unused metadata as valid. -/
mutual
def frameTupleMetadata : RawFrame → List (List NodeRef × Environment)
  | .tuple elements 1 [] environment => [(elements, environment)]
  | .clauseBoundary _ _ (some saved) => tupleMetadata saved
  | _ => []
def tupleMetadata : List RawFrame → List (List NodeRef × Environment)
  | [] => []
  | frame :: rest => frameTupleMetadata frame ++ tupleMetadata rest
end

mutual
def frameTupleRightValid (seen : List (List NodeRef × Environment)) : RawFrame → Bool
  | .tuple elements 2 [_] environment =>
      seen.any (fun prior => prior.1 == elements && prior.2 == environment)
  | .clauseBoundary _ _ (some saved) => tupleRightValid seen saved
  | _ => true
def tupleRightValid (seen : List (List NodeRef × Environment)) : List RawFrame → Bool
  | [] => true
  | frame :: rest => frameTupleRightValid seen frame && tupleRightValid seen rest
end

def actualCallback (actual : Snapshot) : Option NodeRef :=
  match actual.control, actual.frames with
  | .returned _, .cleanupBoundary action _ :: _ => some action
  | _, _ => none

def modelCallback (model : CoreMachine.State) : Option NodeRef :=
  match model.control, model.frames with
  | .returned _, .cleanupBoundary action _ _ :: _ => some action
  | _, _ => none

/-- Callback-start order comes from matched control/boundary transitions, not
    from equating Rust events with model ghost cleanup observations. -/
def callbackStarts : List Snapshot → List NodeRef
  | [] => []
  | actual :: rest => (actualCallback actual).toList ++ callbackStarts rest

def entered (model : CoreMachine.State) : List NodeRef :=
  model.observations.filterMap fun event => match event with | .entered node => some node | _ => none

def modelCells (model : CoreMachine.State) : List EffectEvent :=
  model.observations.filterMap fun event => match event with
  | .acquired _ key => some (.acquired key)
  | .read key _ => some (.read key)
  | .written key _ => some (.written key)
  | .released key => some (.released key)
  | _ => none

def actualCells (actual : Snapshot) : List EffectEvent :=
  actual.effects.filter fun event => match event with
  | .acquired _ | .read _ | .written _ | .released _ => true
  | _ => false

/-- Equality includes the complete semantic state and ownership accounting.
    Work/capacity fields remain retained annotations with locally checked bounds. -/
def relates (graph : Graph) (model : CoreMachine.State) (actual : Snapshot) : Bool :=
  match framesView graph actual.frames with
  | none => false
  | some frames =>
      let (resources, cleanups) := owners frames
      actual.control == projectControl graph model.control &&
      actual.entered == entered model && actualCells actual == modelCells model &&
      actualCallback actual == modelCallback model &&
      frames == projectFrames graph model.frames && actual.heap == projectHeap graph model.heap &&
      actual.accounting.nextActivation == model.nextActivation &&
      actual.accounting.capturedCells == capturedCells frames &&
      actual.accounting.liveResources == resources && actual.accounting.liveCleanups == cleanups &&
      actual.accounting.liveRegistrations == 0 && actual.accounting.nextRegistration == 0 &&
      actual.accounting.capturedCells ≤ actual.accounting.captureLimit &&
      resources ≤ actual.accounting.resourceLimit && cleanups ≤ actual.accounting.cleanupLimit &&
      actual.frames.length ≤ actual.accounting.maxFrameDepth

/-- Retained host annotations have explicit local obligations. Work is not a
    model fuel and capacities are not mathematical freshness. No failure path
    is certified by these successful-trace checks. -/
def annotationStep (before after : Snapshot) : Bool :=
  before.accounting.captureLimit == after.accounting.captureLimit &&
  before.accounting.resourceLimit == after.accounting.resourceLimit &&
  before.accounting.cleanupLimit == after.accounting.cleanupLimit &&
  before.accounting.registrationLimit == after.accounting.registrationLimit &&
  before.accounting.workUsed + before.accounting.workRemaining ==
    after.accounting.workUsed + after.accounting.workRemaining &&
  before.accounting.workUsed ≤ after.accounting.workUsed &&
  after.accounting.maxFrameDepth == max before.accounting.maxFrameDepth after.frames.length

/-- Exact one successful model transition for every actual boundary pair.
    A singleton suffix must be genuinely terminal; missing/extra steps reject. -/
def checkTrace (graph : Graph) (model : CoreMachine.State)
    (seen : List (List NodeRef × Environment)) (actual : List Snapshot) : Bool :=
  match actual with
  | [] => false
  | before :: rest => match rest with
    | [] => relates graph model before && tupleRightValid seen before.frames &&
        match CoreMachine.next graph model with
        | .done value => before.control == .returned (projectValue graph value) && before.frames.isEmpty
        | _ => false
    | next :: _ =>
        relates graph model before && tupleRightValid seen before.frames && annotationStep before next &&
        match CoreMachine.next graph model with
        | .stepped successor => checkTrace graph successor (tupleMetadata before.frames ++ seen) rest
        | _ => false
termination_by structural actual

/-- A proof witness retains one real model step per actual boundary pair, a
    matching structural projection at every boundary, and a genuine terminal
    model outcome. The count is explicit, so zero-step or truncated matching
    cannot certify a nonterminal suffix. -/
inductive CheckedTrace (graph : Graph) : CoreMachine.State → List (List NodeRef × Environment) → List Snapshot → Nat → Prop
  | terminal (model : CoreMachine.State) (seen : List (List NodeRef × Environment)) (actual : Snapshot) (value : CoreMachine.Value)
      (related : relates graph model actual = true)
      (metadata : tupleRightValid seen actual.frames = true)
      (done : CoreMachine.next graph model = .done value)
      (result : (actual.control == .returned (projectValue graph value)) = true)
      (empty : actual.frames.isEmpty = true) : CheckedTrace graph model seen [actual] 0
  | step (model successor : CoreMachine.State) (seen : List (List NodeRef × Environment)) (actual : Snapshot) (rest : List Snapshot) (count : Nat)
      (related : relates graph model actual = true)
      (metadata : tupleRightValid seen actual.frames = true)
      (annotations : ∀ next ∈ rest.head?, annotationStep actual next = true)
      (transition : CoreMachine.Step graph model successor)
      (remaining : CheckedTrace graph successor (tupleMetadata actual.frames ++ seen) rest count) :
      CheckedTrace graph model seen (actual :: rest) (count + 1)

theorem checkTrace_sound (graph : Graph) (model : CoreMachine.State)
    (seen : List (List NodeRef × Environment)) (actual : List Snapshot)
    (checked : checkTrace graph model seen actual = true) :
    CheckedTrace graph model seen actual (actual.length - 1) := by
  induction actual generalizing model seen with
  | nil => simp [checkTrace] at checked
  | cons actual rest ih =>
      cases rest with
      | nil =>
          cases outcome : CoreMachine.next graph model with
          | stepped successor => simp [checkTrace, outcome] at checked
          | rejected error => simp [checkTrace, outcome] at checked
          | done value =>
              simp only [checkTrace, outcome, Bool.and_eq_true] at checked
              exact .terminal model seen actual value checked.1.1 checked.1.2 outcome checked.2.1 checked.2.2
      | cons next rest =>
          cases outcome : CoreMachine.next graph model with
          | done value => simp [checkTrace, outcome] at checked
          | rejected error => simp [checkTrace, outcome] at checked
          | stepped successor =>
              simp only [checkTrace, outcome, Bool.and_eq_true] at checked
              have remaining := ih successor (tupleMetadata actual.frames ++ seen) checked.2
              have witness := CheckedTrace.step model successor seen actual (next :: rest)
                ((next :: rest).length - 1) checked.1.1.1 checked.1.1.2 (by simpa using checked.1.2) outcome remaining
              simpa using witness

/-- Development diagnostics locate the first state/metadata/terminal mismatch.
    They use the same independent evaluator; they never alter actual data. -/
def firstMismatch (graph : Graph) (model : CoreMachine.State)
    (seen : List (List NodeRef × Environment)) (index : Nat) (actual : List Snapshot) : Option Nat :=
  match actual with
  | [] => some index
  | before :: rest => match rest with
    | [] => if checkTrace graph model seen [before] then none else some index
    | next :: _ =>
        if !relates graph model before || !tupleRightValid seen before.frames ||
          !annotationStep before next then some index else
        match CoreMachine.next graph model with
        | .stepped successor => firstMismatch graph successor (tupleMetadata before.frames ++ seen) (index + 1) rest
        | _ => some index
termination_by structural actual

def payload (key : Nat) : List RawFrame → Option Int
  | [] => none
  | .resourceBoundary _ found value :: rest => if key == found then some value else payload key rest
  | _ :: rest => payload key rest

def writesBetween (before after : Snapshot) : List Int :=
  (after.effects.drop before.effects.length).filterMap fun event => match event with
  | .written key => payload key after.frames
  | _ => none

def writtenValues (actual : List Snapshot) : List Int :=
  match actual with
  | [] => []
  | before :: rest => match rest with
    | [] => []
    | after :: _ => writesBetween before after ++ writtenValues rest
termination_by structural actual

/-- Model-only ghost state evolves exclusively by successful `next` equations.
    These labels are not invented Rust identities or source-visible events. -/
def atStep (graph : Graph) : Nat → CoreMachine.State → Option CoreMachine.State
  | 0, state => some state
  | count + 1, state => match CoreMachine.next graph state with
    | .stepped successor => atStep graph count successor
    | _ => none

def ghostCounts (state : Option CoreMachine.State) : Option (Nat × Nat × Nat × Nat) :=
  state.map fun state => (state.nextHandler, state.nextOwner, state.nextCleanup, state.nextClose)

def ghostCaptures (state : Option CoreMachine.State) : List (Nat × Nat) :=
  state.toList.flatMap fun state => state.observations.filterMap fun event => match event with
  | .captured occurrence ticket => some (occurrence, ticket)
  | _ => none


#print axioms checkTrace_sound
#print axioms valueEq_sound
#print axioms environmentEq_sound
#print axioms entryEq_sound
#print axioms framesEq_sound

end Ash.OneShot.CoreObservation
