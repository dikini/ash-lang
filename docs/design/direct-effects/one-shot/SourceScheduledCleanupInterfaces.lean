theorem CaptureSourceAt.pending_live
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    (split : CaptureSourceAt site captured tail)
    (cut : Cut effect operation site.context captured tail selectedContract modes)
    (fresh : actions owner = none) (absent : owner ∉ site.context.ticketNames) :
    SourceAdmission.Pending outward (actions.insert owner rights) budget (introduce phases owner)
      world installations (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail)
      .nil .ordinary output.mode := by
  have retained := (site.retained.permissions (Syntax.fresh_usage_insert_extends (rights := rights) fresh)).introduce_absent
    (by simpa only [Context.append_ticketNames, Context.ticketNames, List.append_nil] using absent)
  obtain ⟨middle, saved, waiting⟩ := retained.at_cut cut
  exact .live (saved.reindex_outside tail.append_nil_pack.symm) waiting

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
/-- Capture's retained resource evidence is built from the predecessor at the
same lexical cut, using established action and phase transports. -/
theorem capture_pending_live
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    (split : CaptureSourceAt site captured tail)
    (checked : PendingChecked ambient outward site.retained)
    (cut : Cut effect operation site.context captured tail selectedContract modes)
    (fresh : actions owner = none) (absent : owner ∉ site.context.ticketNames) :
    PendingChecked ambient outward (split.pending_live (rights := rights) cut fresh absent) := by
  have retained := (checked.permissions (Syntax.fresh_usage_insert_extends (rights := rights) fresh)).introduce_absent
    (by simpa only [Context.append_ticketNames, Context.ticketNames, List.append_nil] using absent)
  obtain ⟨middle, _, _, saved, waiting⟩ := retained.at_cut cut
  exact .live (saved.reindex_outside tail.append_nil_pack.symm) waiting


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport

