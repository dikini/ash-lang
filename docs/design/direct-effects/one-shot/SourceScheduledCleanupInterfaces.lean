namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.SiteRules
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyAnnotations (Dependencies)
open SourcePlannedTyping (Operations Contracts Environment Value)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)

/-- Reuse the already checked finite metadata checker for one callback leaf.
The dummy dependency labels affect neither its row nor its interpretation;
the source constructor below supplies the actual rich function typing. -/
def callbackCheck (latent : Footprint) (receiving : OwnerPhases.Context)
    (phases : OwnerPhaseTransitions.Phases) (budget : Footprint) : Bool :=
  (Metadata.cleanup (needs := []) (callback := Dependencies.pure) latent Metadata.nil).check receiving phases budget

theorem callback_check_iff : callbackCheck latent receiving phases budget = true ↔
    ∃ row, OwnerSource.exportAt receiving phases (qualify true latent) = some row ∧ row ⊆ budget := by
  rw [callbackCheck, Metadata.check_iff]
  simp only [Metadata.closing, Metadata.context, RecursiveRequirements.evaluate_sequence,
    RecursiveRecomposition.evaluate_empty, RecursiveRecomposition.merge_empty_right]
  simp only [SourceDependencyFrames.evaluate_request_at, List.nil_append]

/-- A proposed local cleanup rule, using existing rich Expression witnesses.
Its receiving context must be the actual source suffix supplied by the enclosing
contextual judgment. This site rule is not a full source-admission judgment. -/
inductive CleanupAt (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (world : List Nat) (allowed outward : List Instance)
    (runtimeScope : Execution.Scope) (environment : Environment)
    (actions : Syntax.UsageTickets) (phases : OwnerPhaseTransitions.Phases)
    {scope : SourceDependencyCapture.Scope} (hints : ReturnHints scope)
    (receiving : OwnerPhases.Context) (budget : Footprint) :
    Code → Value → (demand : List Nat) → Requirements demand →
      {dependencies : Dependencies} → Signature dependencies → Prop where
  | cleanup
      (callbackSource : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment action
        (.function .unit .unit requests latent (callbackBody : Signature callbackDependenciesBody))
        callbackDemand callbackReq (callbackSignature : Signature callbackDependencies))
      (bodySource : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment code
        output bodyDemand bodyReq (bodySignature : Signature bodyDependencies))
      (admitted : requests ⊆ allowed)
      (callbackEvaluation : Local outward actions phases world callbackDependencies
        (.plain (dependencies := .cleanup requests callbackDependenciesBody bodyDependencies) hints))
      (body : Local outward actions phases world bodyDependencies
        (.cleanup (needs := requests) (callback := callbackDependenciesBody) hints))
      (normalCallback : Local outward actions phases world callbackDependenciesBody (.running .normal hints))
      (ordinaryCheck : callbackCheck latent receiving phases budget = true) :
      CleanupAt operations policy contracts world allowed outward runtimeScope environment actions phases hints receiving budget
        (.cleanup action code) output (callbackDemand ++ bodyDemand)
        (.emitAfter (.sequence callbackReq bodyReq) [] (qualify true latent))
        (.sequence (callbackSignature : Signature callbackDependencies)
          (.cleanup (needs := requests) (callbackBody : Signature callbackDependenciesBody) (bodySignature : Signature bodyDependencies)))

theorem CleanupAt.source
    (site : CleanupAt operations policy contracts world allowed outward runtimeScope environment actions phases hints receiving budget
      code output demand requirements signature) :
    SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment code output demand requirements signature := by
  cases site with
  | cleanup callbackSource bodySource admitted callbackEvaluation body normalCallback ordinaryCheck =>
      exact .cleanup callbackSource bodySource admitted

theorem CleanupAt.local
    (site : CleanupAt operations policy contracts world allowed outward runtimeScope environment actions phases hints receiving budget
      code output demand requirements (signature : Signature dependencies)) :
    Local outward actions phases world dependencies hints := by
  cases site with
  | cleanup callbackSource bodySource admitted callbackEvaluation body normalCallback ordinaryCheck =>
      exact .sequence callbackEvaluation (.cleanup body normalCallback)

/-- A finite check belongs to the actual visited suffix and return mode.
In particular, ordinary registration does not demand an unwind capability for
callbacks whose scopes cannot be abandoned. -/
theorem callback_entry
    (callback : Local outward actions phases world dependencies
      (.running (SourceDependencyChecks.Lexical.ReturnHints.Recursive.callbackBoundary mode) (rest.append outside)))
    (tail : Pending outward actions phases world rest outside mode finalMode)
    (checked : callbackCheck latent receiving phases budget = true) :
    Pending outward actions phases world (.cleanup (needs := needs) (callback := dependencies) rest) outside mode finalMode ∧
    (∃ row, OwnerSource.exportAt receiving phases (qualify true latent) = some row ∧ row ⊆ budget) :=
  ⟨.cleanup callback tail, callback_check_iff.mp checked⟩

/-- The empty source context has no cleanup obligation, for any external
receiving context or phase. This is the nil-context base only. -/
theorem initial_nil (operations : SourceDependencyAnnotations.Operations)
    (policy : Syntax.TicketPolicy) (contracts : SourceDependencyAnnotations.Contracts)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    (world : List Nat) (outward : List Instance) (actions : Syntax.UsageTickets)
    (phases : OwnerPhaseTransitions.Phases) (receiving : OwnerPhases.Context) (budget : Footprint) :
    Agreement operations policy contracts tables families world Metadata.nil .nil [] (.request [] []) ∧
    Pending outward actions phases world .nil .nil .ordinary .ordinary ∧
    Metadata.nil.check receiving phases budget = true ∧
    Metadata.nil.check (.ordinary (.barrier true) :: receiving) phases budget = true := by
  refine ⟨⟨.nil, .nil, rfl, rfl⟩, .nil, ?_, ?_⟩ <;>
    simp [Metadata.check, Metadata.closing, RecursiveRecomposition.evaluate_empty]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.SiteRules
