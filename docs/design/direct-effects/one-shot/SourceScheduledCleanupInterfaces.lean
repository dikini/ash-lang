/-- The same certified frame keeps its exact context and endpoint metadata
when the resource world grows. -/
theorem FrameRows.world_weaken
    {frame : CertifiedFrame (evidence := declarationPolicy.accepts outward)
      operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing}
    (checked : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (larger : world ⊆ nextWorld) :
    FrameRows operations policy contracts tables families required outward nextWorld ports owners emptyRows
      (frame.world_weaken larger) inputRows outputRows tail decorated := by
  cases checked with
  | plain authenticated =>
      exact .plain (authenticated.world_weaken larger)
        (scopeKnown := by assumption) (inputAnnotation := by assumption) (outputAnnotation := by assumption)
        (certified := certified_world_weaken (by assumption) larger)
  | handler authenticated =>
      exact .handler (authenticated.world_weaken larger)
        (scopeKnown := by assumption) (annotation := by assumption)
        (clauses := ScopedPorts.clauses_world_weaken (by assumption) larger)
        (coverage := by assumption) (unique := by assumption) (recipes := by assumption)
        (capabilities := by assumption) (modes := by assumption)
        (certified := SourcePlannedPhases.certified_clauses_world (evidence := declarationPolicy) (by assumption) larger)
  | cell =>
      exact .cell (scopeKnown := by assumption) (noEscape := by assumption) (annotation := by assumption)
        (interface := ScopedPorts.effect_frame_world_weaken (by assumption) larger)
  | armed authenticated =>
      exact .armed (authenticated.world_weaken larger) (scopeKnown := by assumption) (annotation := by assumption)
        (interface := ScopedPorts.effect_frame_world_weaken (by assumption) larger)
        (certified := certified_world_weaken (by assumption) larger)
  | running callback saved =>
      exact .running (callback.world_weaken larger) (saved.world_weaken larger)
        (scopeKnown := by assumption) (annotation := by assumption)
        (interface := ScopedPorts.effect_frame_world_weaken (by assumption) larger)
  | closing =>
      exact .closing (scopeKnown := by assumption)
        (interface := ScopedPorts.effect_frame_world_weaken (by assumption) larger)
  | retiring =>
      exact .retiring (known := by assumption)
        (interface := ScopedPorts.effect_frame_world_weaken (by assumption) larger)

/-- Every existing mode, including running and unwind markers, keeps its
coherent metadata under the existing mode-frame world transport. -/
theorem ModeFrameRows.world_weaken
    {frame : PlannedModeFrame operations policy contracts tables families required outward world
      entry input output demand requirements layer}
    (checked : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (larger : world ⊆ nextWorld) :
    ModeFrameRows operations policy contracts tables families required outward nextWorld ports owners emptyRows
      (frame.world_weaken larger) inputRows outputRows tail decorated := by
  cases checked with
  | ordinary authenticated => exact .ordinary (authenticated.world_weaken larger)
  | unwinding authenticated =>
      exact .unwinding (authenticated.world_weaken larger)
        (certified := certified_world_weaken (by assumption) larger)
  | closing => exact .closing (scopeKnown := by assumption)
  | retiring => exact .retiring
  | skipped => exact .skipped
  | handler authenticated => exact .handler (authenticated.world_weaken larger)
  | cell => exact .cell
  | cleanup authenticated =>
      exact .cleanup (authenticated.world_weaken larger)
        (certified := certified_world_weaken (by assumption) larger)

/-- Weakening transports the same rich pending derivation, including saved
contexts and their shared owner/return endpoints. No rows are reconstructed. -/
theorem PendingRows.world_weaken
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (larger : world ⊆ nextWorld) :
    PendingRows operations policy contracts tables families required outward actions nextWorld ports owners emptyRows
      (source.world_weaken larger) inputRows outputRows context := by
  induction checked with
  | nil => exact .nil
  | push head tail ih => exact .push (head.world_weaken larger) ih
  | live answerRows inside tail ihInside ihTail =>
      exact .live answerRows ihInside ihTail (known := by assumption) (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption) (callerScope := by assumption)
        (held := by assumption) (answer := by assumption)
  | opening inside tail ihInside ihTail => exact .opening ihInside ihTail
  | spent tail ih =>
      exact .spent ih (known := by assumption) (annotation := by assumption) (callerScope := by assumption)
  | skippedSpent tail ih => exact .skippedSpent ih

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
