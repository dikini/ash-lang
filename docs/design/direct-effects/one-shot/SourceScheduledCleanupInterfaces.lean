/-- Unwind entry retains the exact installed callback authentication and
its existing protected receiver budget in the physical unwinding marker. -/
theorem RetainedState.start_unwind_cleanup
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope (.push (.armed action) tail), issued, completed⟩, actions⟩) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.app action.action .unit, .none, .push (.unwinding action) tail⟩,
        issued, completed⟩, actions⟩ := by
  have operational := state.joined.start_unwind_cleanup
  cases state.source with
  | unwind pending coherent pendingBudget retained bound finite annotation checked bounded pendingCertificate =>
    cases coherent with
    | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
        restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest =>
      cases head with
      | cleanup callbackAuth =>
        rename_i dependencies latent callbackPlan bodyRows callbackCertified callback annotated
        cases pendingBudget with | cleanup callbackBudget remainingBudget =>
          cases retained with | cleanup completion remainingLocal =>
            cases bound with | cleanup restBound =>
              have callbackLocal : Local outward actions (available (ownedTickets tail)) world dependencies
                  (.running .unwind restHints) := by
                change Local outward actions (available (ownedTickets tail)) world dependencies
                  (Context.unwinding (restContext.append .nil).pack.context).pack.hints at completion
                rw [restContext.append_nil_pack] at completion
                exact completion
              have bodyBudget : Budgeted budget (available (ownedTickets tail)) world history bodyRows (.unwinding restContext) := by
                change Budgeted budget (available (ownedTickets tail)) world history bodyRows
                  (Context.unwinding (restContext.append .nil).pack.context) at callbackBudget
                rw [restContext.append_nil_pack] at callbackBudget
                exact callbackBudget
              let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
              let nextRequirements := Requirements.sequence
                ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) restRequirements
              let nextRoot := Requirements.sequence
                (callbackRequirements.prepend (OwnerPhases.ofStack tables (.push (.unwinding action) tail))) nextRequirements
              have callbackSource : SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
                  (.app action.action .unit) .unit [] callbackRequirements
                  (signature (.sequence .pure (.sequence .pure callbackPlan))) :=
                .app (SourcePlannedSources.Values.change_context callback action.closed.1 action.requests .none) .unit (List.Subset.refl _)
              have nextAuth : Auth operations policy ports owners emptyRows callbackSource .unit
                  (.sequence .pure (.sequence .pure bodyRows)) :=
                .app (callbackAuth.value_context action.closed.1 action.requests .none) .unit (admitted := List.Subset.refl _)
              have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows world history
                  action.requests outward .none actions (available (ownedTickets tail)) budget tables families
                  (.unwinding restContext) (.push (.unwinding action) tail)
                  (.app action.action .unit) .unit [] callbackRequirements
                  (signature (.sequence .pure (.sequence .pure callbackPlan))) .unit
                  (.sequence .pure (.sequence .pure bodyRows)) :=
                ⟨callbackSource, nextAuth, .sequence .pure (.sequence .pure callbackLocal),
                  .sequence .pure (.sequence .pure bodyBudget), .unwinding rest.forget.source⟩
              have nextCertified : Certified (evidence := declarationPolicy) outward world
                  (.sequence .pure (.sequence .pure callbackPlan)) :=
                Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
                  (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) callbackCertified)
              have generated : ∀ entries receiving before,
                  evaluate entries receiving before (annotateDisposals nextRoot) =
                    evaluate entries receiving before (annotateDisposals
                      (.sequence ((Requirements.request [] (qualify true latent)).prepend (OwnerPhases.ofStack tables tail)) restRequirements)) := by
                intro entries receiving before
                simp only [nextRoot, nextRequirements, callbackRequirements, annotateDisposals, disposal_prepend,
                  RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
                  RecursiveRequirements.evaluate_emit, RecursiveRecomposition.evaluate_empty,
                  spendAll, RecursiveRecomposition.merge_empty_left, RecursiveContexts.evaluate_request,
                  OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase, ActionData.erase,
                  ProtectionContexts.frameProtected, OwnerPhaseTransitions.project, OwnerSource.exportAt,
                  residualize, DisposalProtection.through_barrier, List.cons_append, List.nil_append]
              obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked checked
              have nextCheck : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets tail))
                  (annotateDisposals nextRoot) normalRow :=
                RecursiveRequirements.evaluate_sound ((generated _ _ _).trans (RecursiveRequirements.checked_complete normalCheck))
              refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
              apply RetainedSource.eval (annotated := .choice nextRoot annotated (.refl _)) nextCurrent nextCertified ⟨.none, .none⟩
                (.push (.unwinding callback callbackCertified) restSource) (.push (.unwinding (certified := callbackCertified) callbackAuth) rest)
                (.unwinding remainingBudget) (.unwinding remainingLocal) (.running restBound) ?_
                (.alternatives .original (.refl _)) (.choice nextCheck checked)
                ((List.append_subset.mpr ⟨within, List.Subset.refl _⟩).trans bounded)
                (by
                  cases pendingCertificate with
                  | cleanup callbackCertificate tailCertificate =>
                    change SourceAdmission.Code _ _ _ _ _ _ bodyRows
