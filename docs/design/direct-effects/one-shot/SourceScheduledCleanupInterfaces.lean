namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open OwnerPhaseTransitions (available)

/-- General value completion uses the actual closing delimiter and preserves
all common-state fields. Raw Unit closing is the same successor. -/
theorem ExecutableState.close_value
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    LexicalUnwind.Event
      ⟨.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩
      ⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩, actions⟩ := by
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows (.eval ⟨.unit, caller, tail⟩) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩ = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
        obtain ⟨expression, _runtime, stackSame⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
        have isValue : site.expression.IsValue := by simpa only [← expression] using closed.1
        obtain ⟨next, expressionSame, scopeSame, nextStack, waiting, nextBound⟩ :=
          site.close_value stackSame.symm (rooted.value_wait isValue)
        have ownersSame : ownedTickets next.stack = ownedTickets site.stack := by
          rw [nextStack, ← stackSame]
          rfl
        have nextPhase := phaseAgreement.trans (congrArg available ownersSame.symm)
        have certified := ExecutableSource.eval next nextPhase (.contextualValue (by rw [expressionSame]; trivial) waiting)
          (nextBound annotations bound) annotation checked bounded
        simpa only [expressionSame, scopeSame, nextStack] using certified
    | unwind => cases machineEq
  have event : LexicalUnwind.Event
      ⟨.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩
      ⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩ := by
    simpa only [List.append_nil, List.singleton_append] using
      (LexicalUnwind.Event.step
        (before := ⟨.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩)
        (.closeValue closed) (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
  have resources : LexicalUnwind.MachineAccess ambient (.eval ⟨.unit, caller, tail⟩) := by
    cases state.resources with
    | eval supported => cases supported.control with
      | push frame rest ambient next access =>
        exact .eval ⟨next, by simp [Code.dependencies, Syntax.resourceDependencies]⟩
  refine ⟨event, nextSource, ?_, ?_, state.storeAnnotation,
    LexicalUnwind.event_preserves_ledger event state.ledger, state.registry, resources,
    state.activations, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
        cases located with | push rest => exact .resume rest known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
        cases located with | push rest => exact .dispose rest held recorded source

/-- The raw Unit-close alternative has the same full successor as closeValue. -/
theorem ExecutableState.finish_close_unit
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩, actions⟩) :
    RawStep ⟨.unit, runtimeScope, .push (.closing identity caller) tail⟩ ⟨.unit, caller, tail⟩ [] [.close identity] ∧
    LexicalUnwind.Event
      ⟨.eval ⟨.unit, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩
      ⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩, actions⟩ :=
  ⟨.finishClose identity runtimeScope caller tail, state.close_value ⟨trivial, rfl, by intro _ present; cases present⟩⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.close_value
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.finish_close_unit

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourcePlannedChecks (Certified)
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (available spendAll)

/-- Remove the actual retirement frame, spending only its absent tail owner. -/
theorem ExecutionSite.retire_value
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (closed : ClosedValue site.expression)
    (stackEq : site.stack = .push (.retiring owner) tail)
    (phaseAgreement : phases = available (ownedTickets site.stack))
    (absent : owner ∉ ownedTickets tail)
    (waiting : Accounting.Wait world installations site.context .ordinary (root : Requirements demand)) :
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand,
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions (available (ownedTickets tail)) world installations
      (RecursiveTransport.removeOwner owner resumes) budget ports owners emptyRows output outputRows,
      next.expression = site.expression ∧ next.runtimeScope = site.runtimeScope ∧ next.stack = tail ∧
      demand = owner :: nextDemand ∧ HEq root (Requirements.sequence (.retire owner) nextRoot) ∧
      Accounting.Wait world installations next.context .ordinary nextRoot ∧
      (∀ annotations, SourceDependencySchemes.Closing.Bound annotations site.receiving →
        SourceDependencySchemes.Closing.Bound annotations next.receiving) := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at stackEq phaseAgreement closed waiting ⊢
  subst stack phases
  cases coherent with
  | push head remaining =>
    cases head
    case' ordinary frame => cases frame
    all_goals
      cases retained with | retiring tailCertificate =>
        cases waiting with | retiring tailWaiting =>
          have returned := (current.previous.authenticated.value_summary closed.1).value_context closed.1 [] runtimeScope
          have certificate := tailCertificate.spend_absent (owner := owner) (by
            simp only [Context.append_owned, Context.owned, List.append_nil]
            exact fun member => absent (remaining.forget.source.owned_subset member))
          have phaseSame : OwnerPhaseTransitions.spend (available (ownedTickets (.push (.retiring owner) tail))) owner =
              available (ownedTickets tail) := OwnerPhaseTransitions.spend_available_cons absent
          rw [phaseSame] at certificate
          let next : ExecutionSite ambient operations policy contracts tables families required outward actions (available (ownedTickets tail)) world installations
              (RecursiveTransport.removeOwner owner resumes) budget ports owners emptyRows output outputRows :=
            { expression := expression, runtimeScope := runtimeScope, stack := tail,
              result := _, resultRows := _, allowed := [],
              dependencies := .pure, plan := .pure, rows := .pure,
              sourceDemand := [], sourceRequirements := .request [] [],
              receiving := _, hints := _, context := _,
              current := SourceAdmission.Admitted.of_source _ returned .pure remaining.forget.source,
              certified := Certified.pure (evidence := declarationPolicy), scopeTyped := scopeTyped,
              pendingDemand := _, pendingRequirements := _,
              pending := _, coherent := remaining.remove_records owner, retained := certificate, currentResource := .pure,
              retainedResource := by
                cases retainedResource with | retiring tailResource =>
                  exact ((tailResource.spend_absent (owner := owner) (by
                    simp only [Context.append_owned, Context.owned, List.append_nil]
                    exact fun member => absent (remaining.forget.source.owned_subset member))).phases phaseSame).reproof }
          refine ⟨_, _, next, rfl, rfl, rfl, rfl, HEq.rfl, tailWaiting, ?_⟩
          intro annotations bounded
          cases bounded with | running rest => exact rest

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (available spendAll)

theorem ExecutableState.retire_value
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    LexicalUnwind.Event
      ⟨.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩
      ⟨.eval ⟨value, runtimeScope, tail⟩, issued, .ticket owner :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner disposals)
      (RecursiveTransport.removeOwner owner annotatedStore) budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, tail⟩, issued, .ticket owner :: completed⟩, actions⟩ := by
  have unique := owned_tickets_unique (ledger_unique_live state.ledger)
  have distinct : owner ∉ ownedTickets tail ∧ (ownedTickets tail).Nodup := List.nodup_cons.mp unique
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner annotatedStore)
      budget ports owners emptyRows output outputRows (.eval ⟨value, runtimeScope, tail⟩) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩ = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
        obtain ⟨expression, scopeSame, stackSame⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
        have closedSite : ClosedValue site.expression := by simpa only [← expression] using closed
        obtain ⟨nextDemand, nextRoot, next, expressionSame, nextScope, nextStack, demandSame, rootSame, waiting, nextBound⟩ :=
          site.retire_value closedSite stackSame.symm phaseAgreement distinct.1 (rooted.value_wait closedSite.1)
        cases demandSame
        rw [eq_of_heq rootSame] at annotation
        obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked checked
        obtain ⟨_, tailRow, _, tailCheck, rowSame⟩ := RecursiveRequirements.checked_sequence_parts normalCheck
        have tailBoundRow := (rowSame ▸ List.subset_append_right _ _).trans normalBound
        have removed := RecursiveTransport.checked_remove_consumed tailCheck
          (owner := owner) (by simp only [spendAll, OwnerPhaseTransitions.spend_self])
        have phaseSame : OwnerPhaseTransitions.spend (available (ownedTickets (.push (.retiring owner) tail))) owner =
            available (ownedTickets tail) := OwnerPhaseTransitions.spend_available_cons distinct.1
        have nextCheck : Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) []
            (available (ownedTickets tail)) (annotateDisposals nextRoot) tailRow := by
          simpa only [← disposal_store_remove_owner, spendAll, phaseAgreement, ← stackSame, phaseSame] using removed
        have certified := ExecutableSource.eval next (by rw [nextStack])
          (.contextualValue (by rw [expressionSame]; exact closedSite.1) waiting)
          (nextBound annotations bound) .original nextCheck (tailBoundRow.trans bounded)
        simpa only [expressionSame, nextScope, nextStack, ← expression, ← scopeSame] using certified
    | unwind => cases machineEq
  have transition : LexicalUnwind.Transition
      (.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩)
      (.eval ⟨value, runtimeScope, tail⟩) [] [.ticket owner] := .retireValue closed
  have event : LexicalUnwind.Event
      ⟨.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩
      ⟨.eval ⟨value, runtimeScope, tail⟩, issued, .ticket owner :: completed⟩ := by
    simpa only [List.append_nil, List.singleton_append] using
      (LexicalUnwind.Event.step
        (before := ⟨.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩)
        transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
  refine ⟨event, nextSource, ?_, ?_, ?_, LexicalUnwind.event_preserves_ledger event state.ledger,
    state.registry, ?_, state.activations, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body (RecursiveTransport.remove_owner_sublist.subset member) with
    | resume located known recorded source answer =>
      cases located with | push rest => exact .resume rest known recorded source answer
  · intro key body member
    cases state.unwindRecords key body (RecursiveTransport.remove_owner_sublist.subset member) with
    | dispose located held recorded source =>
      cases located with | push rest => exact .dispose rest held recorded source
  · simpa only [RecursiveConsumption.remove_owner_append] using state.storeAnnotation.remove_owner owner
  · cases state.resources with
    | eval supported =>
      cases supported.control with | push _ _ _ next access =>
        exact .eval ⟨next, by simpa [Stack.erase, ExecFrame.erase, CloseItem.frame,
          Control.visible, Frame.visible] using supported.expression⟩

/-- The raw Unit retirement is the corresponding instance of general value retirement. -/
theorem ExecutableState.retire
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩, actions⟩) :
    RawStep ⟨.unit, runtimeScope, .push (.retiring owner) tail⟩ ⟨.unit, runtimeScope, tail⟩ [] [.ticket owner] ∧
    LexicalUnwind.Event
      ⟨.eval ⟨.unit, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩
      ⟨.eval ⟨.unit, runtimeScope, tail⟩, issued, .ticket owner :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner disposals)
      (RecursiveTransport.removeOwner owner annotatedStore) budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, tail⟩, issued, .ticket owner :: completed⟩, actions⟩ :=
  ⟨.retire owner runtimeScope tail, state.retire_value ⟨trivial, rfl, by intro _ present; cases present⟩⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
