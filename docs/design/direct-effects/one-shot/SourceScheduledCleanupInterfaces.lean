namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open OwnerPhaseTransitions (Phases)
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Operations Contracts Environment Value)

/-- The actual authenticated source retains its structural certificate. The
older source judgment is a projection used by established semantic proofs;
compiling the certificate does not replace or discard it. Declaration schemas
and whole-machine source retention remain separate obligations. -/
structure Admitted
    (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (environment : Environment) (environmentRows : EnvironmentRows environment)
    (world installations : List Nat) (allowed outward : List Instance) (runtimeScope : Execution.Scope)
    (actions : Syntax.UsageTickets) (phases : Phases) (budget : Footprint)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    {scope : SourceDependencyCapture.Scope} {hints : ReturnHints scope} (context : Context hints) (stack : Stack)
    (code : ScopedExpressions.Code) (result : Value) (demand : List Nat) (requirements : Requirements demand)
    {dependencies : SourceDependencyAnnotations.Dependencies} (checking : Signature dependencies)
    (resultRows : ValueRows result) (rows : Rows checking) : Prop where
  previous : Contextual.Admitted operations policy contracts ports owners environment environmentRows
    world installations allowed outward runtimeScope actions phases budget tables families context stack
    code result demand requirements checking resultRows rows
  certificate : Code outward actions budget phases world installations rows context

/-- Existing typed syntax, its authenticated rows and the structural source
certificate originate both old local-check fields. No successor is inspected. -/
theorem Admitted.of_source
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result demand requirements checking)
    (authenticated : Auth operations policy ports owners environmentRows source resultRows rows)
    (certificate : Code outward actions budget phases world installations rows context)
    (receiving : Context.Source operations.erase policy contracts.erase tables families world context stack) :
    Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack code result demand requirements checking resultRows rows :=
  ⟨⟨source, authenticated, certificate.compile.1, certificate.compile.2, receiving⟩, certificate⟩

/-- Closed substitution preserves the same latent metadata and complete
certificate, reusing the established authenticated source substitution. -/
theorem Admitted.substitution
    (checked : Admitted operations policy contracts ports owners (environment.extend name input)
      (environmentRows.extend name inputRows) world installations allowed outward runtimeScope actions phases budget
      tables families context stack code result demand requirements checking resultRows rows)
    (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input)
    (replacementChecked : Auth operations policy ports owners environmentRows replacement inputRows .pure)
    (closed : ClosedValue value) :
    Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (code.subst name value) result demand requirements
      checking resultRows rows :=
  ⟨checked.previous.substitution replacement replacementChecked closed, checked.certificate⟩

/-- Binding consumes the existing suffix certificate and preserves its exact
source/body rows under substitution. -/
theorem Admitted.bind_expression
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (.bind parameter value body) result demand requirements
      (.sequence initialSignature bodySignature) resultRows (.sequence initialRows bodyRows))
    (closed : ClosedValue value) :
    ∃ reduced, Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (body.subst parameter value) result demand reduced
      bodySignature resultRows bodyRows ∧
      ∀ store receiving before, RecursiveRequirements.evaluate store receiving before reduced =
        RecursiveRequirements.evaluate store receiving before requirements := by
  obtain ⟨reduced, next, evaluation⟩ := checked.previous.bind_expression closed
  cases checked.certificate with
  | sequence first second => exact ⟨reduced, ⟨next, second⟩, evaluation⟩

/-- Application retains the authenticated latent body's complete certificate;
it does not reconstruct internal cleanup checks from the function's effect row. -/
theorem Admitted.beta_expression
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (.app (.lambda parameter body) value) result demand requirements
      (.sequence functionSignature (.sequence argumentSignature bodySignature)) resultRows
      (.sequence functionRows (.sequence argumentRows bodyRows)))
    (closed : ClosedValue value) :
    ∃ reduced, Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      .none actions phases budget tables families context stack (body.subst parameter value) result demand reduced
      bodySignature resultRows bodyRows ∧
      ∀ store receiving before, RecursiveRequirements.evaluate store receiving before reduced =
        RecursiveRequirements.evaluate store receiving before requirements := by
  obtain ⟨reduced, next, evaluation⟩ := checked.previous.beta_expression closed
  cases checked.certificate with
  | sequence functionCertificate rest =>
    cases rest with
    | sequence argumentCertificate bodyCertificate => exact ⟨reduced, ⟨next, bodyCertificate⟩, evaluation⟩

/-- Registration retains both the body certificate and the actual callback's
normal-return certificate from the existing source derivation. -/
theorem Admitted.cleanup_body
    {callbackSignature : Signature callbackDependencies} {callbackRows : Rows callbackSignature}
    {bodySignature : Signature bodyDependencies} {bodyRows : Rows bodySignature}
    {callbackBody : Signature callbackBodyDependencies} {callbackBodyRows : Rows callbackBody}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (.cleanup action.action body) result demand requirements
      (.sequence callbackSignature (.cleanup (needs := action.requests) callbackBody bodySignature)) resultRows
      (.sequence callbackRows (.cleanup (needs := action.requests) latent callbackBodyRows bodyRows)))
    (closed : ClosedValue action.action) :
    ∃ bodyDemand, ∃ bodyRequirements : Requirements bodyDemand,
      Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
        runtimeScope actions phases budget tables families (.cleanup (needs := action.requests) latent callbackBodyRows context)
        (.push (.armed action) stack) body result bodyDemand bodyRequirements bodySignature resultRows bodyRows ∧
      Code outward actions budget phases world installations callbackBodyRows (.normal context) := by
  obtain ⟨bodyDemand, bodyRequirements, next, normalBudget⟩ := checked.previous.cleanup_body closed
  cases checked.certificate with
  | sequence callbackCertificate cleanupCertificate =>
    cases cleanupCertificate with
    | cleanup bodyCertificate normalCertificate =>
      exact ⟨bodyDemand, bodyRequirements, ⟨next, bodyCertificate⟩, normalCertificate⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Admitted.of_source
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Admitted.substitution
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Admitted.bind_expression
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Admitted.beta_expression
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Admitted.cleanup_body


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PureTransport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (Scope OwnerCut)
/-- Insert pure waiting frames on the active lexical spine while retaining
every existing row and saved continuation literally. -/
inductive PureHistory : {firstScope secondScope : SourceDependencyCapture.Scope} →
    {firstHints : ReturnHints firstScope} → {secondHints : ReturnHints secondScope} →
    Context firstHints → Context secondHints → Prop where
  | same (context) : PureHistory context context
  | add (related : PureHistory first second) : PureHistory first (.plain .pure second)
  | plain (rows : Rows checking) (related : PureHistory first second) : PureHistory (.plain rows first) (.plain rows second)
  | handler (rows : ClauseRows declarations) (related : PureHistory first second) : PureHistory
      (.handler (effect := effect) (table := table) activation rows first)
      (.handler (effect := effect) (table := table) activation rows second)
  | cell (related : PureHistory first second) : PureHistory (.cell (identity := identity) first) (.cell (identity := identity) second)
  | cleanup (rows : Rows checking) (related : PureHistory first second) : PureHistory
      (.cleanup (needs := needs) latent rows first) (.cleanup (needs := needs) latent rows second)
  | normal (related : PureHistory first second) : PureHistory (.normal first) (.normal second)
  | unwinding (related : PureHistory first second) : PureHistory (.unwinding first) (.unwinding second)
  | closing (related : PureHistory first second) : PureHistory (.closing first) (.closing second)
  | retiring (related : PureHistory first second) : PureHistory (.retiring owner first) (.retiring owner second)
  | live {resumeDemand : List Nat} (saved : Context savedHints) (related : PureHistory first second) :
      PureHistory (.live (owner := owner) (resumeDemand := resumeDemand) saved first) (.live (owner := owner) (resumeDemand := resumeDemand) saved second)
  | spent (related : PureHistory first second) : PureHistory (.spent (owner := owner) first) (.spent (owner := owner) second)


theorem PureHistory.hints {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : PureHistory first second) :
    SourceDependencyNeutral.Lexical.Recursive.History firstHints secondHints := by
  induction related with
  | same => exact .refl
  | add related ih => exact .pureFrame ih
  | plain rows related ih => exact .plain ih
  | handler rows related ih => exact .handler ih
  | cell related ih => exact .cell ih
  | cleanup rows related ih => exact .cleanup ih
  | normal related ih | unwinding related ih | closing related ih | retiring related ih => exact .running ih
  | live saved related ih => exact .live ih
  | spent related ih => exact .spent ih

theorem PureHistory.prefix (front : Context prefixHints) (related : PureHistory first second) :
    PureHistory (front.append first) (front.append second) := by
  induction front with
  | nil => exact related
  | plain rows tail ih => exact .plain rows ih
  | handler activation rows tail ih => exact .handler rows ih
  | cell tail ih => exact .cell ih
  | cleanup latent rows tail ih => exact .cleanup rows ih
  | normal tail ih => exact .normal ih
  | unwinding tail ih => exact .unwinding ih
  | closing tail ih => exact .closing ih
  | retiring owner tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live saved ihTail
  | spent tail ih => exact .spent ih

theorem PureHistory.append (first : PureHistory a b) (second : PureHistory c d) :
    PureHistory (a.append c) (b.append d) := by
  induction first with
  | same context => exact second.prefix context
  | add related ih => exact .add ih
  | plain rows related ih => exact .plain rows ih
  | handler rows related ih => exact .handler rows ih
  | cell related ih => exact .cell ih
  | cleanup rows related ih => exact .cleanup rows ih
  | normal related ih => exact .normal ih
  | unwinding related ih => exact .unwinding ih
  | closing related ih => exact .closing ih
  | retiring related ih => exact .retiring ih
  | live saved related ih => exact .live saved ih
  | spent related ih => exact .spent ih

theorem PureHistory.callback (related : PureHistory first second) (mode : LexicalUnwind.UseMode) :
    PureHistory (first.callback mode) (second.callback mode) := by
  cases mode
  · exact .normal related
  · exact .unwinding related

private inductive SelectedPure : Option Selection → Option Selection → Prop where
  | none : SelectedPure none none
  | builtin : SelectedPure (some (.builtin identity)) (some (.builtin identity))
  | handler (capture : PureHistory first.context second.context) (tail : PureHistory firstTail.context secondTail.context) :
      SelectedPure (some (.handler first firstTail contract modes)) (some (.handler second secondTail contract modes))

private theorem SelectedPure.same (selected : Option Selection) : SelectedPure selected selected := by
  cases selected with
  | none => exact .none
  | some selected => cases selected with
    | builtin => exact .builtin
    | handler => exact .handler (.same _) (.same _)

private theorem SelectedPure.prepend (related : SelectedPure first second)
    (frame nextFrame : Packed → Packed)
    (congruent : ∀ left right, PureHistory left.context right.context → PureHistory (frame left).context (nextFrame right).context) :
    SelectedPure (first.map (.prepend frame)) (second.map (.prepend nextFrame)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (congruent _ _ capture) tail

private theorem SelectedPure.add (related : SelectedPure first second) :
    SelectedPure first (second.map (.prepend fun captured => (Context.plain .pure captured.context).pack)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (.add capture) tail

private theorem PureHistory.selected (related : PureHistory first second) effect operation :
    SelectedPure (select effect operation first) (select effect operation second) := by
  induction related with
  | same context => exact .same _
  | add related ih => exact ih.add
  | plain rows related ih => exact ih.prepend _ _ (fun _ _ h => .plain rows h)
  | handler rows related ih =>
      simp only [select]
      split
      · split
        · exact .handler (.same _) related
        · exact .none
      · exact ih.prepend _ _ (fun _ _ h => .handler rows h)
  | cell related ih =>
      simp only [select]
      split
      · exact .builtin
      · exact ih.prepend _ _ (fun _ _ h => .cell h)
  | cleanup rows related ih => exact ih.prepend _ _ (fun _ _ h => .cleanup rows h)
  | normal related ih => exact ih.prepend _ _ (fun _ _ h => .normal h)
  | unwinding related ih => exact ih.prepend _ _ (fun _ _ h => .unwinding h)
  | closing related ih => exact ih.prepend _ _ (fun _ _ h => .closing h)
  | retiring related ih => exact ih.prepend _ _ (fun _ _ h => .retiring h)
  | live saved related ih => exact ih.prepend _ _ (fun _ _ h => .live saved h)
  | spent related ih => exact ih.prepend _ _ (fun _ _ h => .spent h)

theorem PureHistory.builtin (related : PureHistory first second)
    (found : select effect operation first = some (.builtin identity)) :
    select effect operation second = some (.builtin identity) := by
  have transformed := related.selected effect operation
  rw [found] at transformed
  generalize select effect operation second = selected at transformed ⊢
  cases transformed
  rfl

theorem PureHistory.cut
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {captured : Context capturedHints} {tail : Context tailHints}
    (related : PureHistory first second)
    (cut : Cut effect operation first captured tail contract modes) :
    ∃ nextCapturedScope nextTailScope,
    ∃ nextCapturedHints : ReturnHints nextCapturedScope, ∃ nextTailHints : ReturnHints nextTailScope,
    ∃ nextCaptured : Context nextCapturedHints, ∃ nextTail : Context nextTailHints,
      Cut effect operation second nextCaptured nextTail contract modes ∧
      PureHistory captured nextCaptured ∧ PureHistory tail nextTail := by
  have transformed := related.selected effect operation
  rw [cut] at transformed
  generalize found : select effect operation second = selected at transformed
  cases transformed with
  | handler captureHistory tailHistory =>
      exact ⟨_, _, _, _, _, _, found, captureHistory, tailHistory⟩
theorem PureHistory.decompose_live
    {resumeDemand : List Nat}
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : PureHistory first second)
    {frontHints : ReturnHints frontScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    (front : Context frontHints) (captured : Context captureHints) (tail : Context tailHints)
    (same : first.pack = (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)).pack) :
    ∃ nextFront nextTail : Packed,
      second.pack = (nextFront.context.append (.live (owner := owner) (resumeDemand := resumeDemand) captured nextTail.context)).pack ∧
      PureHistory front nextFront.context ∧ PureHistory tail nextTail.context := by
  induction related generalizing frontScope captureScope tailScope with
  | same context => exact ⟨front.pack, tail.pack, same, .same front, .same tail⟩
  | add related ih =>
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih front captured tail same
      exact ⟨(Context.plain .pure nextFront.context).pack, nextTail,
        congrArg (fun packed : Packed => (Context.plain .pure packed.context).pack) nextSame,
        .add frontHistory, tailHistory⟩
  | plain rows related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.plain rows nextFront.context).pack, nextTail, ?_, PureHistory.plain rows frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.plain rows packed.context).pack) nextSame
  | handler rows related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.handler _ rows nextFront.context).pack, nextTail, ?_, PureHistory.handler rows frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.handler _ rows packed.context).pack) nextSame
  | cell related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.cell (identity := _) nextFront.context).pack, nextTail, ?_, PureHistory.cell frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.cell (identity := _) packed.context).pack) nextSame
  | cleanup rows related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.cleanup (needs := _) _ rows nextFront.context).pack, nextTail, ?_, PureHistory.cleanup rows frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.cleanup (needs := _) _ rows packed.context).pack) nextSame
  | normal related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.normal nextFront.context).pack, nextTail, ?_, PureHistory.normal frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.normal packed.context).pack) nextSame
  | unwinding related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.unwinding nextFront.context).pack, nextTail, ?_, PureHistory.unwinding frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.unwinding packed.context).pack) nextSame
  | closing related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.closing nextFront.context).pack, nextTail, ?_, PureHistory.closing frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.closing packed.context).pack) nextSame
  | retiring related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.retiring _ nextFront.context).pack, nextTail, ?_, PureHistory.retiring frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.retiring _ packed.context).pack) nextSame
  | @live savedScope savedHints oldScope oldHints oldTail newScope newHints newTail innerOwner innerDemand saved related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      · exact ⟨Context.nil.pack, newTail.pack, rfl, .same .nil, related⟩
      · obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
        refine ⟨(Context.live (owner := _) saved nextFront.context).pack, nextTail, ?_, .live saved frontHistory, tailHistory⟩
        exact congrArg (fun packed : Packed => (Context.live (owner := _) saved packed.context).pack) nextSame
  | spent related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextTail, nextSame, frontHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.spent (owner := _) nextFront.context).pack, nextTail, ?_, PureHistory.spent frontHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.spent (owner := _) packed.context).pack) nextSame
theorem PureHistory.owner_cut_to
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (changed : PureHistory first second)
    (located : OwnerCut owner (firstScope.append (.live owner captured tail)) ⟨firstScope, captured, tail⟩)
    (nextTail : Scope) :
    OwnerCut owner (secondScope.append (.live owner captured nextTail)) ⟨secondScope, captured, nextTail⟩ := by
  induction changed with
  | same context => exact SpentTransport.owner_cut_replace_tail _ located nextTail
  | add related ih => exact .plain (ih located)
  | plain rows related ih => cases located with | plain next => exact .plain (ih next)
  | handler rows related ih => cases located with | handler next => exact .handler (ih next)
  | cell related ih => cases located with | cell next => exact .cell (ih next)
  | cleanup rows related ih => cases located with | cleanup next => exact .cleanup (ih next)
  | normal related ih | unwinding related ih | closing related ih | retiring related ih =>
      cases located with | running next => exact .running (ih next)
  | live saved related ih => cases located with | live different next => exact .live different (ih next)
  | spent related ih => cases located with | spent next => exact .spent (ih next)

/-- Reconstruct the same owner's cut after decorating both caller and tail
with pure waiting frames. -/
theorem PureHistory.owner_cut
    {frontHints : ReturnHints frontScope} {nextFrontHints : ReturnHints nextFrontScope}
    {tailHints : ReturnHints tailScope} {nextTailHints : ReturnHints nextTailScope}
    {front : Context frontHints} {nextFront : Context nextFrontHints}
    {tail : Context tailHints} {nextTail : Context nextTailHints}
    (frontHistory : PureHistory front nextFront)
    (_tailHistory : PureHistory tail nextTail)
    (located : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
      ⟨frontScope, capturedScope, tailScope⟩) :
    OwnerCut owner (nextFrontScope.append (.live owner capturedScope nextTailScope))
      ⟨nextFrontScope, capturedScope, nextTailScope⟩ :=
  frontHistory.owner_cut_to located nextTailScope

theorem PureHistory.toPlain (related : PureHistory first second) : Plain first second := by
  induction related with
  | same context => exact .same context
  | add related ih => exact .add .pure ih
  | plain rows related ih => exact .plain rows ih
  | handler rows related ih => exact .handler rows ih
  | cell related ih => exact .cell ih
  | cleanup rows related ih => exact .cleanup rows ih
  | normal related ih => exact .normal ih
  | unwinding related ih => exact .unwinding ih
  | closing related ih => exact .closing ih
  | retiring related ih => exact .retiring ih
  | live saved related ih => exact .live saved ih
  | spent related ih => exact .spent ih

theorem PureHistory.requestBudget (related : PureHistory first second)
    (checked : RequestBudget budget phases effect operation first) :
    RequestBudget budget phases effect operation second := related.toPlain.requestBudget checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PureTransport

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open PureTransport

/-- Pure-frame transport is the existing plain-frame transport specialized to pure rows. -/
theorem ResumeBudget.pure_history
    (frontRelated : PureHistory front nextFront) (tailRelated : PureHistory tail nextTail)
    (checked : ResumeBudget budget before owner demand mode front tail = true) :
    ResumeBudget budget before owner demand mode nextFront nextTail = true :=
  ResumeBudget.plain frontRelated.toPlain tailRelated.toPlain checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeBudget.pure_history


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AccountingTransport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (Scope OwnerCut)

inductive DeepPureHistory : {firstScope secondScope : SourceDependencyCapture.Scope} →
    {firstHints : ReturnHints firstScope} → {secondHints : ReturnHints secondScope} →
    Context firstHints → Context secondHints → Prop where
  | same (context) : DeepPureHistory context context
  | add (related : DeepPureHistory first second) : DeepPureHistory first (.plain .pure second)
  | plain (rows : Rows checking) (related : DeepPureHistory first second) : DeepPureHistory (.plain rows first) (.plain rows second)
  | handler (rows : ClauseRows declarations) (related : DeepPureHistory first second) : DeepPureHistory
      (.handler (effect := effect) (table := table) activation rows first)
      (.handler (effect := effect) (table := table) activation rows second)
  | cell (related : DeepPureHistory first second) : DeepPureHistory (.cell (identity := identity) first) (.cell (identity := identity) second)
  | cleanup (rows : Rows checking) (related : DeepPureHistory first second) : DeepPureHistory
      (.cleanup (needs := needs) latent rows first) (.cleanup (needs := needs) latent rows second)
  | normal (related : DeepPureHistory first second) : DeepPureHistory (.normal first) (.normal second)
  | unwinding (related : DeepPureHistory first second) : DeepPureHistory (.unwinding first) (.unwinding second)
  | closing (related : DeepPureHistory first second) : DeepPureHistory (.closing first) (.closing second)
  | retiring (related : DeepPureHistory first second) : DeepPureHistory (.retiring owner first) (.retiring owner second)
  | live {resumeDemand : List Nat}
      (saved : DeepPureHistory oldSaved nextSaved) (tail : DeepPureHistory first second) :
      DeepPureHistory (.live (owner := owner) (resumeDemand := resumeDemand) oldSaved first)
        (.live (owner := owner) (resumeDemand := resumeDemand) nextSaved second)
  | spent (related : DeepPureHistory first second) : DeepPureHistory (.spent (owner := owner) first) (.spent (owner := owner) second)


theorem DeepPureHistory.of_shallow (related : PureTransport.PureHistory first second) :
    DeepPureHistory first second := by
  induction related with
  | same context => exact .same context
  | add related ih => exact .add ih
  | plain rows related ih => exact .plain rows ih
  | handler rows related ih => exact .handler rows ih
  | cell related ih => exact .cell ih
  | cleanup rows related ih => exact .cleanup rows ih
  | normal related ih => exact .normal ih
  | unwinding related ih => exact .unwinding ih
  | closing related ih => exact .closing ih
  | retiring related ih => exact .retiring ih
  | live saved related ih => exact .live (.same saved) ih
  | spent related ih => exact .spent ih

theorem DeepPureHistory.held {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepPureHistory first second) : firstScope.held = secondScope.held := by
  induction related <;> simp_all [Scope.held]

theorem DeepPureHistory.return_mode {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepPureHistory first second) (mode : LexicalUnwind.UseMode) :
    firstHints.returnMode mode = secondHints.returnMode mode := by
  induction related generalizing mode <;> simp_all [ReturnHints.returnMode]

theorem DeepPureHistory.prefix (front : Context prefixHints) (related : DeepPureHistory first second) :
    DeepPureHistory (front.append first) (front.append second) := by
  induction front with
  | nil => exact related
  | plain rows tail ih => exact .plain rows ih
  | handler activation rows tail ih => exact .handler rows ih
  | cell tail ih => exact .cell ih
  | cleanup latent rows tail ih => exact .cleanup rows ih
  | normal tail ih => exact .normal ih
  | unwinding tail ih => exact .unwinding ih
  | closing tail ih => exact .closing ih
  | retiring owner tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live (.same saved) ihTail
  | spent tail ih => exact .spent ih

theorem DeepPureHistory.append (first : DeepPureHistory a b) (second : DeepPureHistory c d) :
    DeepPureHistory (a.append c) (b.append d) := by
  induction first with
  | same context => exact second.prefix context
  | add related ih => exact .add ih
  | plain rows related ih => exact .plain rows ih
  | handler rows related ih => exact .handler rows ih
  | cell related ih => exact .cell ih
  | cleanup rows related ih => exact .cleanup rows ih
  | normal related ih => exact .normal ih
  | unwinding related ih => exact .unwinding ih
  | closing related ih => exact .closing ih
  | retiring related ih => exact .retiring ih
  | live saved related ihSaved ih => exact .live saved ih
  | spent related ih => exact .spent ih

theorem DeepPureHistory.callback (related : DeepPureHistory first second) (mode : LexicalUnwind.UseMode) :
    DeepPureHistory (first.callback mode) (second.callback mode) := by
  cases mode
  · exact .normal related
  · exact .unwinding related

private inductive SelectedDeepPure : Option Selection → Option Selection → Prop where
  | none : SelectedDeepPure none none
  | builtin : SelectedDeepPure (some (.builtin identity)) (some (.builtin identity))
  | handler (capture : DeepPureHistory first.context second.context) (tail : DeepPureHistory firstTail.context secondTail.context) :
      SelectedDeepPure (some (.handler first firstTail contract modes)) (some (.handler second secondTail contract modes))

private theorem SelectedDeepPure.same (selected : Option Selection) : SelectedDeepPure selected selected := by
  cases selected with
  | none => exact .none
  | some selected => cases selected with
    | builtin => exact .builtin
    | handler => exact .handler (.same _) (.same _)

private theorem SelectedDeepPure.prepend (related : SelectedDeepPure first second)
    (frame nextFrame : Packed → Packed)
    (congruent : ∀ left right, DeepPureHistory left.context right.context → DeepPureHistory (frame left).context (nextFrame right).context) :
    SelectedDeepPure (first.map (.prepend frame)) (second.map (.prepend nextFrame)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (congruent _ _ capture) tail

private theorem SelectedDeepPure.add (related : SelectedDeepPure first second) :
    SelectedDeepPure first (second.map (.prepend fun captured => (Context.plain .pure captured.context).pack)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (.add capture) tail

private theorem DeepPureHistory.selected (related : DeepPureHistory first second) effect operation :
    SelectedDeepPure (select effect operation first) (select effect operation second) := by
  induction related with
  | same context => exact .same _
  | add related ih => exact ih.add
  | plain rows related ih => exact ih.prepend _ _ (fun _ _ h => .plain rows h)
  | handler rows related ih =>
      simp only [select]
      split
      · split
        · exact .handler (.same _) related
        · exact .none
      · exact ih.prepend _ _ (fun _ _ h => .handler rows h)
  | cell related ih =>
      simp only [select]
      split
      · exact .builtin
      · exact ih.prepend _ _ (fun _ _ h => .cell h)
  | cleanup rows related ih => exact ih.prepend _ _ (fun _ _ h => .cleanup rows h)
  | normal related ih => exact ih.prepend _ _ (fun _ _ h => .normal h)
  | unwinding related ih => exact ih.prepend _ _ (fun _ _ h => .unwinding h)
  | closing related ih => exact ih.prepend _ _ (fun _ _ h => .closing h)
  | retiring related ih => exact ih.prepend _ _ (fun _ _ h => .retiring h)
  | live saved related ihSaved ih => exact ih.prepend _ _ (fun _ _ h => .live saved h)
  | spent related ih => exact ih.prepend _ _ (fun _ _ h => .spent h)

theorem DeepPureHistory.builtin (related : DeepPureHistory first second)
    (found : select effect operation first = some (.builtin identity)) :
    select effect operation second = some (.builtin identity) := by
  have transformed := related.selected effect operation
  rw [found] at transformed
  generalize select effect operation second = selected at transformed ⊢
  cases transformed
  rfl

theorem DeepPureHistory.cut
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {captured : Context capturedHints} {tail : Context tailHints}
    (related : DeepPureHistory first second)
    (cut : Cut effect operation first captured tail contract modes) :
    ∃ nextCapturedScope nextTailScope,
    ∃ nextCapturedHints : ReturnHints nextCapturedScope, ∃ nextTailHints : ReturnHints nextTailScope,
    ∃ nextCaptured : Context nextCapturedHints, ∃ nextTail : Context nextTailHints,
      Cut effect operation second nextCaptured nextTail contract modes ∧
      DeepPureHistory captured nextCaptured ∧ DeepPureHistory tail nextTail := by
  have transformed := related.selected effect operation
  rw [cut] at transformed
  generalize found : select effect operation second = selected at transformed
  cases transformed with
  | handler captureHistory tailHistory =>
      exact ⟨_, _, _, _, _, _, found, captureHistory, tailHistory⟩
theorem DeepPureHistory.decompose_live
    {resumeDemand : List Nat}
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepPureHistory first second)
    {frontHints : ReturnHints frontScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    (front : Context frontHints) (captured : Context captureHints) (tail : Context tailHints)
    (same : first.pack = (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)).pack) :
    ∃ nextFront nextCaptured nextTail : Packed,
      second.pack = (nextFront.context.append (.live (owner := owner) (resumeDemand := resumeDemand) nextCaptured.context nextTail.context)).pack ∧
      DeepPureHistory front nextFront.context ∧ DeepPureHistory captured nextCaptured.context ∧ DeepPureHistory tail nextTail.context := by
  induction related generalizing frontScope captureScope tailScope with
  | same context => exact ⟨front.pack, captured.pack, tail.pack, same, .same front, .same captured, .same tail⟩
  | add related ih =>
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih front captured tail same
      exact ⟨(Context.plain .pure nextFront.context).pack, nextCaptured, nextTail,
        congrArg (fun packed : Packed => (Context.plain .pure packed.context).pack) nextSame,
        .add frontHistory, capturedHistory, tailHistory⟩
  | plain rows related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.plain rows nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.plain rows frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.plain rows packed.context).pack) nextSame
  | handler rows related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.handler _ rows nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.handler rows frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.handler _ rows packed.context).pack) nextSame
  | cell related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.cell (identity := _) nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.cell frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.cell (identity := _) packed.context).pack) nextSame
  | cleanup rows related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.cleanup (needs := _) _ rows nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.cleanup rows frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.cleanup (needs := _) _ rows packed.context).pack) nextSame
  | normal related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.normal nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.normal frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.normal packed.context).pack) nextSame
  | unwinding related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.unwinding nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.unwinding frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.unwinding packed.context).pack) nextSame
  | closing related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.closing nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.closing frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.closing packed.context).pack) nextSame
  | retiring related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.retiring _ nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.retiring frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.retiring _ packed.context).pack) nextSame
  | @live oldSavedScope oldSavedHints oldSaved nextSavedScope nextSavedHints nextSaved
      oldScope oldHints oldTail newScope newHints newTail innerOwner innerDemand savedRelated tailRelated ihSaved ihTail =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      · exact ⟨Context.nil.pack, nextSaved.pack, newTail.pack, rfl, .same .nil, savedRelated, tailRelated⟩
      · obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ :=
          ihTail _ captured tail rfl
        refine ⟨(Context.live (owner := _) nextSaved nextFront.context).pack, nextCaptured, nextTail,
          ?_, .live savedRelated frontHistory, capturedHistory, tailHistory⟩
        exact congrArg (fun packed : Packed => (Context.live (owner := _) nextSaved packed.context).pack) nextSame
  | spent related ih =>
      cases front <;> simp only [Context.append, Context.pack] at same <;> cases same
      obtain ⟨nextFront, nextCaptured, nextTail, nextSame, frontHistory, capturedHistory, tailHistory⟩ := ih _ captured tail rfl
      refine ⟨(Context.spent (owner := _) nextFront.context).pack, nextCaptured, nextTail, ?_, DeepPureHistory.spent frontHistory, capturedHistory, tailHistory⟩
      exact congrArg (fun packed : Packed => (Context.spent (owner := _) packed.context).pack) nextSame
private theorem owner_cut_replace_regions (front : Scope)
    (located : OwnerCut owner (front.append (.live owner captured tail)) ⟨front, captured, tail⟩)
    (nextCaptured nextTail : Scope) :
    OwnerCut owner (front.append (.live owner nextCaptured nextTail)) ⟨front, nextCaptured, nextTail⟩ := by
  induction front with
  | nil => exact .hit
  | plain dependencies rest ih => cases located with | plain next => exact .plain (ih next)
  | handler effect table families rest ih => cases located with | handler next => exact .handler (ih next)
  | cell identity rest ih => cases located with | cell next => exact .cell (ih next)
  | cleanup needs callback rest ih => cases located with | cleanup next => exact .cleanup (ih next)
  | running rest ih => cases located with | running next => exact .running (ih next)
  | live other saved rest ihSaved ihRest => cases located with
    | live different next => exact .live different (ihRest next)
  | spent other rest ih => cases located with | spent next => exact .spent (ih next)

theorem DeepPureHistory.owner_cut_to
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (changed : DeepPureHistory first second)
    (located : OwnerCut owner (firstScope.append (.live owner captured tail)) ⟨firstScope, captured, tail⟩)
    (nextCaptured nextTail : Scope) :
    OwnerCut owner (secondScope.append (.live owner nextCaptured nextTail)) ⟨secondScope, nextCaptured, nextTail⟩ := by
  induction changed with
  | same context => exact owner_cut_replace_regions _ located nextCaptured nextTail
  | add related ih => exact .plain (ih located)
  | plain rows related ih => cases located with | plain next => exact .plain (ih next)
  | handler rows related ih => cases located with | handler next => exact .handler (ih next)
  | cell related ih => cases located with | cell next => exact .cell (ih next)
  | cleanup rows related ih => cases located with | cleanup next => exact .cleanup (ih next)
  | normal related ih | unwinding related ih | closing related ih | retiring related ih =>
      cases located with | running next => exact .running (ih next)
  | live saved related ihSaved ih => cases located with | live different next => exact .live different (ih next)
  | spent related ih => cases located with | spent next => exact .spent (ih next)

theorem DeepPureHistory.owner_cut
    {frontHints : ReturnHints frontScope} {nextFrontHints : ReturnHints nextFrontScope}
    {capturedHints : ReturnHints capturedScope} {nextCapturedHints : ReturnHints nextCapturedScope}
    {tailHints : ReturnHints tailScope} {nextTailHints : ReturnHints nextTailScope}
    {front : Context frontHints} {nextFront : Context nextFrontHints}
    {captured : Context capturedHints} {nextCaptured : Context nextCapturedHints}
    {tail : Context tailHints} {nextTail : Context nextTailHints}
    (frontHistory : DeepPureHistory front nextFront)
    (_capturedHistory : DeepPureHistory captured nextCaptured)
    (_tailHistory : DeepPureHistory tail nextTail)
    (located : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
      ⟨frontScope, capturedScope, tailScope⟩) :
    OwnerCut owner (nextFrontScope.append (.live owner nextCapturedScope nextTailScope))
      ⟨nextFrontScope, nextCapturedScope, nextTailScope⟩ :=
  frontHistory.owner_cut_to located nextCapturedScope nextTailScope

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AccountingTransport
