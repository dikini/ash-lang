namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Value Environment Operations Contract Contracts AgreeOn agree_left agree_right agree_extend opened_environment_agree)

/-- Agreement is required only at ordinary free variables. Resource free names
are tracked separately by the existing resource-world judgments. -/
def EnvironmentRows.AgreeOn {environment destination : Environment}
    (rows : EnvironmentRows environment) (nextRows : EnvironmentRows destination)
    (dependencies : List Syntax.Dependency) : Prop :=
  ∀ name value, Syntax.Dependency.variable name ∈ dependencies →
    ∀ (known : environment name = some value) (nextKnown : destination name = some value),
      rows name value known = nextRows name value nextKnown

theorem EnvironmentRows.agree_left
    (agree : EnvironmentRows.AgreeOn rows nextRows (left ++ right)) :
    EnvironmentRows.AgreeOn rows nextRows left :=
  fun _ _ member => agree _ _ (List.mem_append_left _ member)

theorem EnvironmentRows.agree_right
    (agree : EnvironmentRows.AgreeOn rows nextRows (left ++ right)) :
    EnvironmentRows.AgreeOn rows nextRows right :=
  fun _ _ member => agree _ _ (List.mem_append_right _ member)

theorem EnvironmentRows.agree_extend
    {rows : EnvironmentRows environment} {nextRows : EnvironmentRows destination}
    (agree : EnvironmentRows.AgreeOn rows nextRows (Syntax.without (.variable binder) dependencies))
    (valueRows : ValueRows value) :
    EnvironmentRows.AgreeOn (rows.extend binder valueRows) (nextRows.extend binder valueRows) dependencies := by
  intro name result member known nextKnown
  by_cases same : name = binder
  · subst name
    have values : value = result := Option.some.inj (by simpa [Environment.extend] using known)
    subst result
    simp only [EnvironmentRows.extend_same]
  · have sourceKnown : environment name = some result := by simpa [Environment.extend, same] using known
    have targetKnown : destination name = some result := by simpa [Environment.extend, same] using nextKnown
    simpa only [EnvironmentRows.extend_other rows valueRows same sourceKnown,
      EnvironmentRows.extend_other nextRows valueRows same targetKnown] using
      agree name result (Syntax.mem_without.mpr ⟨member, by simpa using same⟩) sourceKnown targetKnown

theorem EnvironmentRows.opened_agree {code : Code}
    (agree : EnvironmentRows.AgreeOn rows nextRows code.dependencies) :
    EnvironmentRows.AgreeOn rows nextRows
      (code.instantiate (Instantiation.Environment.empty.bind binder identity)).dependencies := by
  intro name value member known nextKnown
  rcases List.mem_append.mp (ScopedExpressions.acquisition_dependency_bound _ identity _ member) with original | introduced
  · exact agree name value original known nextKnown
  · simp at introduced
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Value Environment Operations Contract Contracts AgreeOn agree_left agree_right agree_extend opened_environment_agree)

/-- Retain exactly the same value and callback-row decorations while changing
ordinary variable bindings only outside the code's free-variable dependencies. -/
theorem Auth.environment_congr
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment} {destinationRows : EnvironmentRows destination}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (agree : AgreeOn environment destination code.dependencies)
    (metadata : EnvironmentRows.AgreeOn environmentRows destinationRows code.dependencies) :
    Auth operations policy ports owners destinationRows
      (SourcePlannedSources.expression_environment_congr source agree) valueRows rows := by
  induction checked using Auth.rec
      (motive_2 := fun {contracts} owners {world allowed scope environment} environmentRows {code answer} answerRows
        {header dependencies checking} source rows checked =>
        ∀ destination (destinationRows : EnvironmentRows destination),
          AgreeOn environment destination code.dependencies →
          EnvironmentRows.AgreeOn environmentRows destinationRows code.dependencies →
          ∃ next : SourcePlannedSources.Body operations policy contracts world allowed scope destination code answer header checking,
            AuthBody operations policy ports owners destinationRows answerRows next rows)
      (motive_3 := fun {contracts} owners {world environment} environmentRows {allowed parameter binder argument} argumentRows
        {input} inputRows {answer} answerRows {resumeEffects closeEffects code held disposes row family plans} source rows checked =>
        ∀ destination (destinationRows : EnvironmentRows destination),
          AgreeOn environment destination (Syntax.without (.variable parameter) code.dependencies) →
          EnvironmentRows.AgreeOn environmentRows destinationRows (Syntax.without (.variable parameter) code.dependencies) →
          ∃ next : SourcePlannedSources.Offer operations policy contracts world destination allowed parameter binder argument input answer
            resumeEffects closeEffects code held disposes row plans,
            AuthOffer operations policy ports owners destinationRows argumentRows inputRows answerRows next rows)
      (motive_4 := fun {contracts} owners {world environment} environmentRows {allowed requested answer} answerRows
        {clauses table families plans} source rows checked =>
        ∀ destination (destinationRows : EnvironmentRows destination),
          AgreeOn environment destination clauses.dependencies →
          EnvironmentRows.AgreeOn environmentRows destinationRows clauses.dependencies →
          ∃ next : SourcePlannedSources.Declarations operations policy contracts world destination allowed requested answer clauses table plans,
            AuthDeclarations operations policy ports owners destinationRows answerRows next rows)
      generalizing destination with
  | unit => exact .unit
  | boolean => exact .boolean
  | integer => exact .integer
  | reference => exact Auth.reference (issued := by assumption)
  | «variable» =>
      have nextKnown := (agree _ List.mem_cons_self).symm.trans (by assumption)
      rw [metadata _ _ List.mem_cons_self (by assumption) nextKnown]
      exact Auth.variable (known := nextKnown) (formed := by assumption)
  | lambda body captured ih =>
      exact Auth.lambda (ih (agree_extend agree) (EnvironmentRows.agree_extend metadata _))
        (LambdaPortCaptureSupport.captures_environment captured agree)
        (outward := by assumption) (formed := by assumption) (latentBound := by assumption)
  | purePair left right ihLeft ihRight =>
      exact .purePair (ihLeft (agree_left agree) (EnvironmentRows.agree_left metadata))
        (ihRight (agree_right agree) (EnvironmentRows.agree_right metadata))
  | pair left right ihLeft ihRight =>
      exact .pair (ihLeft (agree_left agree) (EnvironmentRows.agree_left metadata))
        (ihRight (agree_right agree) (EnvironmentRows.agree_right metadata))
  | app function argument ihFunction ihArgument =>
      exact Auth.app (ihFunction (agree_left agree) (EnvironmentRows.agree_left metadata))
        (ihArgument (agree_right agree) (EnvironmentRows.agree_right metadata)) (admitted := by assumption)
  | bind initializer body ihInit ihBody =>
      exact .bind (ihInit (agree_left agree) (EnvironmentRows.agree_left metadata))
        (ihBody (agree_extend (agree_right agree)) (EnvironmentRows.agree_extend (EnvironmentRows.agree_right metadata) _))
  | branch condition yes no ihCondition ihYes ihNo =>
      exact Auth.branch (ihCondition (agree_left (agree_left agree)) (EnvironmentRows.agree_left (EnvironmentRows.agree_left metadata)))
        (ihYes (agree_right (agree_left agree)) (EnvironmentRows.agree_right (EnvironmentRows.agree_left metadata)))
        (ihNo (agree_right agree) (EnvironmentRows.agree_right metadata)) (same := by assumption)
  | perform operand ih =>
      exact Auth.perform (ih (agree_right agree) (EnvironmentRows.agree_right metadata))
        (known := by assumption) (admitted := by assumption) (formed := by assumption)
  | handler body declarations ihBody ihDecl =>
      obtain ⟨nextDeclarations, nextAuth⟩ := ihDecl destination destinationRows (agree_right agree) (EnvironmentRows.agree_right metadata)
      exact Auth.handler (ihBody (agree_right (agree_left agree)) (EnvironmentRows.agree_right (EnvironmentRows.agree_left metadata)))
        nextAuth
        (clauses := by
          apply ScopedPorts.clauses_environment_congr (by assumption)
          intro name member
          simp only [CoherentSourceTypes.Environment.ports, SourceDependencyAnnotations.Environment.erase,
            Environment.erase, agree_right agree name member])
        (capabilities := by assumption) (coverage := by assumption) (unique := by assumption)
        (admitted := by assumption) (modes := by assumption)
  | resume operand ih =>
      exact Auth.resume (ih (fun name member => agree name (List.mem_cons_of_mem _ member))
        (fun name value member => metadata name value (List.mem_cons_of_mem _ member)))
        (known := by assumption) (resolved := by assumption) (permission := by assumption)
        (admitted := by assumption) (formed := by assumption)
  | discard =>
      exact Auth.discard (known := by assumption) (resolved := by assumption) (permission := by assumption)
        (unprotected := by assumption) (admitted := by assumption)
  | cleanup callback body ihCallback ihBody =>
      exact Auth.cleanup (ihCallback (agree_left agree) (EnvironmentRows.agree_left metadata))
        (ihBody (agree_right agree) (EnvironmentRows.agree_right metadata)) (admitted := by assumption)
  | resource initializer body ihInit ihBody =>
      exact Auth.resource (ihInit (agree_left agree) (EnvironmentRows.agree_left metadata))
        (fun identity fresh => ihBody identity fresh (opened_environment_agree (agree_right agree))
          (EnvironmentRows.opened_agree (EnvironmentRows.agree_right metadata)))
        (formed := by assumption) (effectsBound := by assumption) (admitted := by assumption) (hidden := by assumption)
  | typed body ih =>
      rename_i destination destinationRows agree metadata
      exact ⟨_, AuthBody.typed (ih agree metadata) (rows := by assumption) (closingRows := by assumption)⟩
  | unavailable =>
      rename_i destination destinationRows agree metadata
      exact ⟨.unavailable, .unavailable⟩
  | available checked ih =>
      rename_i destination destinationRows agree metadata
      let changed := fun owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands =>
        (ih owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
          _ _ (agree_extend agree) (EnvironmentRows.agree_extend metadata _)).choose
      refine ⟨.available (by assumption) (by assumption) changed, AuthOffer.available (source := changed) (resumeInterface := by assumption) (closeInterface := by assumption) ?_⟩
      intro owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
      exact (ih owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
        _ _ (agree_extend agree) (EnvironmentRows.agree_extend metadata _)).choose_spec
  | nil =>
      rename_i destination destinationRows agree metadata
      exact ⟨.nil, .nil⟩
  | cons ordinary protectedMode rest support ihOrdinary ihProtected ihRest =>
      rename_i destination destinationRows agree metadata
      have bodyAgree := fun name member => agree_left agree name
        (Syntax.mem_without.mpr ⟨member, by simp⟩)
      have bodyMetadata := fun name value member => EnvironmentRows.agree_left metadata name value
        (Syntax.mem_without.mpr ⟨member, by simp⟩)
      obtain ⟨nextOrdinary, ordinaryAuth⟩ := ihOrdinary destination destinationRows bodyAgree bodyMetadata
      obtain ⟨nextProtected, protectedAuth⟩ := ihProtected destination destinationRows bodyAgree bodyMetadata
      obtain ⟨nextRest, restAuth⟩ := ihRest destination destinationRows (agree_right agree) (EnvironmentRows.agree_right metadata)
      exact ⟨_, AuthDeclarations.cons ordinaryAuth protectedAuth restAuth
        (LambdaPortCaptureSupport.declaration_bound_environment support bodyAgree) (known := by assumption)⟩

/-- A closed replacement has no free ordinary variables, so arbitrary target
environment metadata is safe without replacing any stored decoration. -/
theorem Auth.closed_environment
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment} {destinationRows : EnvironmentRows destination}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed code value)
      valueRows rows)
    (closed : ClosedValue code) :
    Auth operations policy ports owners destinationRows
      (SourcePlannedSources.Values.closed_environment source closed destination) valueRows rows :=
  checked.environment_congr
    (fun _ member => False.elim (ScopedTyping.closedValue_no_variable closed member))
    (fun _ _ member => False.elim (ScopedTyping.closedValue_no_variable closed member))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.environment_congr
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.closed_environment

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourcePlannedTyping (Value Environment Operations Contract Contracts)
open SourceDeclarationPlans (ModePlans ClausePlans)
open SourcePlanSignatures (Signature signature modeSignatures clauseSignatures)

private theorem body_source_world
    (source : SourcePlannedSources.Body operations policy contracts world allowed scope environment code value header checking)
    (larger : world ⊆ nextWorld) :
    SourcePlannedSources.Body operations policy contracts nextWorld allowed scope environment code value header checking := by
  cases source with
  | typed expression rows closingRows =>
      exact .typed (SourcePlannedSources.expression_world_weaken expression larger) rows closingRows

private theorem offer_source_world
    (source : SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
      resumeEffects closeEffects code held disposes row plans)
    (larger : world ⊆ nextWorld) :
    SourcePlannedSources.Offer operations policy contracts nextWorld environment allowed parameter binder argument input answer
      resumeEffects closeEffects code held disposes row plans := by
  cases source with
  | unavailable =>
      exact .unavailable
  | available resumeInterface closeInterface family =>
      exact .available resumeInterface closeInterface (fun owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance =>
        body_source_world (family owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance) larger)

/-- Enlarging the resource world changes only source world evidence. Actual
value, callback and hereditary clause decorations remain exactly the same. -/
theorem Auth.world_weaken
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (larger : world ⊆ nextWorld) :
    Auth operations policy ports owners environmentRows
      (SourcePlannedSources.expression_world_weaken source larger) valueRows rows := by
  induction checked using Auth.rec
      (motive_2 := fun {contracts} owners {world allowed scope environment} environmentRows {code answer} answerRows
          {header dependencies checking} source rows _ => ∀ nextWorld (larger : world ⊆ nextWorld),
        AuthBody operations policy ports owners environmentRows answerRows (body_source_world source larger) rows)
      (motive_3 := fun {contracts} owners {world environment} environmentRows {allowed parameter binder argument} argumentRows
          {input} inputRows {answer} answerRows {resumeEffects closeEffects code held disposes row family plans} source rows _ =>
        ∀ nextWorld (larger : world ⊆ nextWorld),
          AuthOffer operations policy ports owners environmentRows argumentRows inputRows answerRows (offer_source_world source larger) rows)
      (motive_4 := fun {contracts} owners {world environment} environmentRows {allowed requested answer} answerRows
          {clauses table families plans} source rows _ => ∀ nextWorld (larger : world ⊆ nextWorld),
        AuthDeclarations operations policy ports owners environmentRows answerRows
          (declarations_world_weaken source larger) rows)
      generalizing nextWorld with
  | unit =>
      exact .unit
  | boolean =>
      exact .boolean
  | integer =>
      exact .integer
  | reference =>
      exact Auth.reference (issued := larger (by assumption))
  | «variable» =>
      exact Auth.variable (known := by assumption)
        (formed := ScopedPorts.in_world_mono (by assumption) larger)
  | lambda body captured ih =>
      exact Auth.lambda (ih larger) captured
        (outward := by assumption) (formed := ScopedPorts.in_world_mono (by assumption) larger) (latentBound := by assumption)
  | purePair left right ihLeft ihRight =>
      exact .purePair (ihLeft larger) (ihRight larger)
  | pair left right ihLeft ihRight =>
      exact .pair (ihLeft larger) (ihRight larger)
  | app function argument ihFunction ihArgument =>
      exact .app (ihFunction larger) (ihArgument larger) (admitted := by assumption)
  | bind initializer body ihInitializer ihBody =>
      exact .bind (ihInitializer larger) (ihBody larger)
  | branch condition yes no ihCondition ihYes ihNo =>
      exact .branch (ihCondition larger) (ihYes larger) (ihNo larger) (same := by assumption)
  | perform operand ih =>
      exact Auth.perform (ih larger) (known := by assumption) (admitted := by assumption)
        (formed := ScopedPorts.in_world_mono (by assumption) larger)
  | handler body declarations ihBody ihDeclarations =>
      exact Auth.handler (ihBody larger) (ihDeclarations nextWorld larger)
        (clauses := ScopedPorts.clauses_world_weaken (by assumption) larger)
        (capabilities := by assumption) (coverage := by assumption) (unique := by assumption)
        (admitted := by assumption) (modes := by assumption)
  | resume operand ih =>
      exact Auth.resume (ih larger)
        (known := by assumption) (resolved := by assumption) (permission := by assumption)
        (admitted := by assumption) (formed := ScopedPorts.in_world_mono (by assumption) larger)
  | discard =>
      exact Auth.discard (known := by assumption) (resolved := by assumption)
        (permission := by assumption) (unprotected := by assumption) (admitted := by assumption)
  | cleanup callback body ihCallback ihBody =>
      exact .cleanup (ihCallback larger) (ihBody larger) (admitted := by assumption)
  | resource initializer body ihInitializer ihBody =>
      exact Auth.resource (ihInitializer larger)
        (fun identity fresh => ihBody identity (fun member => fresh (larger member))
          (ScopedExpressions.append_subset larger (List.Subset.refl _)))
        (formed := ScopedPorts.in_world_mono (by assumption) larger)
        (effectsBound := List.Subset.trans (by assumption) larger) (admitted := by assumption)
        (hidden := fun identity fresh => by
          apply_assumption
          exact fun member => fresh (larger member))
  | typed checked ih =>
      rename_i nextWorld larger
      exact AuthBody.typed (ih larger) (rows := by assumption) (closingRows := by assumption)
  | unavailable => intros; exact .unavailable
  | available checked ih =>
      rename_i nextWorld larger
      exact AuthOffer.available
        (fun owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance =>
          ih owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance nextWorld larger)
        (resumeInterface := by assumption) (closeInterface := by assumption)
  | nil => intros; exact .nil
  | cons ordinary protectedMode rest support ihOrdinary ihProtected ihRest =>
      rename_i nextWorld larger
      exact AuthDeclarations.cons (ihOrdinary nextWorld larger) (ihProtected nextWorld larger)
        (ihRest nextWorld larger) support (known := by assumption)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.world_weaken

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Value Environment Operations Contract Contracts)
open SourcePlannedSources (Expression)
open SourcePlannedCheckedFrames (body_extension offer_extension declarations_extension)

/-- A retained owner keeps both exact higher-order value decorations. -/
def ContractRows.Compatible {contracts next : Contracts} (extension : contracts.Extends next)
    (owners : ContractRows contracts) (nextOwners : ContractRows next) : Prop :=
  ∀ owner contract (known : contracts owner = some contract),
    nextOwners owner contract (extension owner contract known) = owners owner contract known

theorem ContractRows.Compatible.insert
    {contracts next : Contracts} {extension : contracts.Extends next}
    {owners : ContractRows contracts} {nextOwners : ContractRows next}
    (compatible : ContractRows.Compatible extension owners nextOwners)
    (input : ValueRows contract.input) (answer : ValueRows contract.answer) :
    ContractRows.Compatible (SourcePlannedTyping.insert_extension (owner := owner) (contract := contract) extension)
      (owners.insert owner input answer) (nextOwners.insert owner input answer) := by
  intro other result known
  by_cases same : other = owner
  · subst other
    have equal : contract = result := Option.some.inj (by simpa [Contracts.insert] using known)
    subst result
    simp [ContractRows.insert]
  · have old : contracts other = some result := by simpa [Contracts.insert, same] using known
    simpa [ContractRows.insert, same] using compatible other result old

theorem ContractRows.compatible_fresh_insert
    (owners : ContractRows contracts) (fresh : contracts owner = none)
    (input : ValueRows contract.input) (answer : ValueRows contract.answer) :
    ContractRows.Compatible (SourcePlannedTyping.insert_extends (contract := contract) contracts fresh)
      owners (owners.insert owner input answer) := by
  intro other result known
  have different : other ≠ owner := by
    intro same
    subst other
    rw [fresh] at known
    cases known
  simp [ContractRows.insert, different]

/-- Contract extension retains every authenticated value and executed-signature
row, including clauses abstracted over fresh continuation owners. -/
theorem Auth.contract_extension
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (extension : contracts.Extends next) (nextOwners : ContractRows next)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    Auth operations policy ports nextOwners environmentRows
      (SourcePlannedSources.expression_extension source extension) valueRows rows := by
  induction checked using Auth.rec
    (motive_2 := fun {contracts} owners {world allowed scope environment} environmentRows
      {code answer} answerRows {header dependencies checking} source rows _ =>
      ∀ {next : Contracts} (extension : contracts.Extends next) (nextOwners : ContractRows next),
        ContractRows.Compatible extension owners nextOwners →
        AuthBody operations policy ports nextOwners environmentRows answerRows
          (body_extension source extension) rows)
    (motive_3 := fun {contracts} owners {world environment} environmentRows
      {allowed parameter binder argument} argumentRows {input} inputRows {answer} answerRows
      {resumeEffects closeEffects code held disposes row family plans} source rows _ =>
      ∀ {next : Contracts} (extension : contracts.Extends next) (nextOwners : ContractRows next),
        ContractRows.Compatible extension owners nextOwners →
        AuthOffer operations policy ports nextOwners environmentRows argumentRows inputRows answerRows
          (offer_extension source extension) rows)
    (motive_4 := fun {contracts} owners {world environment} environmentRows
      {allowed requested answer} answerRows {clauses table families plans} source rows _ =>
      ∀ {next : Contracts} (extension : contracts.Extends next) (nextOwners : ContractRows next),
        ContractRows.Compatible extension owners nextOwners →
        AuthDeclarations operations policy ports nextOwners environmentRows answerRows
          (declarations_extension source extension) rows)
    generalizing next with
  | unit => exact .unit
  | boolean => exact .boolean
  | integer => exact .integer
  | reference => exact Auth.reference (issued := by assumption)
  | «variable» => exact Auth.variable (known := by assumption) (formed := by assumption)
  | lambda body captured ih => exact Auth.lambda (ih extension nextOwners compatible) captured (outward := by assumption) (formed := by assumption) (latentBound := by assumption)
  | purePair left right ihLeft ihRight => exact .purePair (ihLeft extension nextOwners compatible) (ihRight extension nextOwners compatible)
  | pair left right ihLeft ihRight => exact .pair (ihLeft extension nextOwners compatible) (ihRight extension nextOwners compatible)
  | app function argument ihFunction ihArgument => exact Auth.app (ihFunction extension nextOwners compatible) (ihArgument extension nextOwners compatible) (admitted := by assumption)
  | bind initializer body ihInit ihBody => exact .bind (ihInit extension nextOwners compatible) (ihBody extension nextOwners compatible)
  | branch condition yes no ihCondition ihYes ihNo => exact Auth.branch (ihCondition extension nextOwners compatible) (ihYes extension nextOwners compatible) (ihNo extension nextOwners compatible) (same := by assumption)
  | perform operand ih => exact Auth.perform (ih extension nextOwners compatible) (known := by assumption) (admitted := by assumption) (formed := by assumption)
  | handler body declarations ihBody ihDecl => exact Auth.handler (ihBody extension nextOwners compatible) (ihDecl extension nextOwners compatible) (clauses := by assumption) (capabilities := by assumption) (coverage := by assumption) (unique := by assumption) (admitted := by assumption) (modes := by assumption)
  | resume operand ih =>
      rename_i owner contract known operandRows binder resolved permission admitted formed operandSource
      have same := compatible owner contract known
      have moved := ih extension nextOwners compatible
      have result := Auth.resume (operations := operations) (ports := ports) (owners := nextOwners)
        (operand := SourcePlannedSources.expression_extension operandSource extension)
        (operandRows := operandRows) (known := extension owner contract known)
        (resolved := resolved) (permission := permission) (admitted := admitted) (formed := formed)
        (by simpa only [same] using moved)
      simpa only [same] using result
  | discard => exact Auth.discard (known := extension _ _ (by assumption)) (resolved := by assumption) (permission := by assumption) (unprotected := by assumption) (admitted := by assumption)
  | cleanup callback body ihCallback ihBody => exact Auth.cleanup (ihCallback extension nextOwners compatible) (ihBody extension nextOwners compatible) (admitted := by assumption)
  | resource initializer body ihInit ihBody => exact Auth.resource (ihInit extension nextOwners compatible) (fun identity fresh => ihBody identity fresh extension nextOwners compatible) (formed := by assumption) (effectsBound := by assumption) (admitted := by assumption) (hidden := by assumption)
  | typed checked ih =>
      rename_i next extension nextOwners compatible
      exact AuthBody.typed (ih extension nextOwners compatible) (rows := by assumption) (closingRows := by assumption)
  | unavailable => intros; exact .unavailable
  | available checked ih =>
      rename_i next extension nextOwners compatible
      apply AuthOffer.available (resumeInterface := by assumption) (closeInterface := by assumption)
      intro owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
      exact ih owner contract (SourcePlannedTyping.extension_fresh extension fresh)
        inputSame answerSame resumeSame closeSame heldSame demands
        (SourcePlannedTyping.insert_extension extension)
        (nextOwners.insert owner (inputSame.symm ▸ _) (answerSame.symm ▸ _))
        (compatible.insert _ _)
  | nil => intros; exact .nil
  | cons ordinary protectedMode rest support ihOrdinary ihProtected ihRest =>
      rename_i next extension nextOwners compatible
      exact AuthDeclarations.cons
        (ihOrdinary extension nextOwners compatible) (ihProtected extension nextOwners compatible) (ihRest extension nextOwners compatible)
        support (known := by assumption)

/-- Fresh insertion supplies compatibility automatically. The inserted input
and answer decorations are explicit; existing authenticated code is unchanged. -/
theorem Auth.contract_insert
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (fresh : contracts owner = none)
    (input : ValueRows contract.input) (answer : ValueRows contract.answer) :
    Auth operations policy ports (owners.insert owner input answer) environmentRows
      (SourcePlannedSources.expression_extension source
        (SourcePlannedTyping.insert_extends (contract := contract) contracts fresh)) valueRows rows :=
  checked.contract_extension (SourcePlannedTyping.insert_extends contracts fresh)
    (owners.insert owner input answer) (ContractRows.compatible_fresh_insert owners fresh input answer)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.ContractRows.Compatible.insert
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.ContractRows.compatible_fresh_insert
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.contract_extension
