#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CapturedClauseRows.at_terminal

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.TerminalHandler.unique
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CapturedClauseRows.unique


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (ClauseSignatures)

private def HasTerminal (effect : Instance) (context : Packed) : Prop :=
  ∃ activation, ∃ families, ∃ declarations : ClauseSignatures families,
    ∃ rows : ClauseRows declarations, TerminalHandler effect activation rows context.context

private def SelectionHasTerminal (effect : Instance) : Option Selection → Prop
  | some (.handler captured _ _ _) => HasTerminal effect captured
  | _ => True

private theorem terminal_prepend
    (frame : Packed → Packed)
    (preserves : ∀ captured, HasTerminal effect captured → HasTerminal effect (frame captured))
    (found : SelectionHasTerminal effect selected) :
    SelectionHasTerminal effect (selected.map (Selection.prepend frame)) := by
  cases selected with
  | none => trivial
  | some selected => cases selected with
    | builtin => trivial
    | handler => exact preserves _ found

private theorem select_terminal (effect : Instance) (operation : Nat) (whole : Context hints) :
    SelectionHasTerminal effect (select effect operation whole) := by
  induction whole with
  | nil => trivial
  | handler activation rows tail ih =>
      simp only [select]
      split
      · split
        · subst_vars
          exact ⟨_, _, _, _, .here⟩
        · trivial
      · apply terminal_prepend _ _ ih
        intro captured found
        obtain ⟨activation, families, declarations, rows, found⟩ := found
        exact ⟨_, _, _, _, .handler found⟩
  | cell tail ih =>
      simp only [select]
      split
      · trivial
      · apply terminal_prepend _ _ ih
        intro captured found
        obtain ⟨activation, families, declarations, rows, found⟩ := found
        exact ⟨_, _, _, _, .cell found⟩
  | plain waiting tail ih =>
      apply terminal_prepend _ _ ih
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .plain found⟩
  | cleanup latent callback tail ih =>
      apply terminal_prepend _ _ ih
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .cleanup found⟩
  | normal tail ih =>
      apply terminal_prepend _ _ ih
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .normal found⟩
  | unwinding tail ih =>
      apply terminal_prepend _ _ ih
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .unwinding found⟩
  | closing tail ih =>
      apply terminal_prepend _ _ ih
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .closing found⟩
  | retiring owner tail ih =>
      apply terminal_prepend _ _ ih
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .retiring found⟩
  | live saved tail ihSaved ihTail =>
      apply terminal_prepend _ _ ihTail
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .live found⟩
  | spent tail ih =>
      apply terminal_prepend _ _ ih
      intro captured found
      obtain ⟨activation, families, declarations, rows, found⟩ := found
      exact ⟨_, _, _, _, .spent found⟩

/-- Every actual handler cut ends at a retained handler row decoration. -/
theorem Cut.terminal_handler (cut : Cut effect operation whole captured tail contract modes) :
    ∃ activation, ∃ families, ∃ declarations : ClauseSignatures families,
      ∃ rows : ClauseRows declarations, TerminalHandler effect activation rows captured := by
  have found := select_terminal effect operation whole
  rw [cut] at found
  exact found

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)
open OwnerPhaseTransitions (Phases spend)
open LexicalUnwind (UseMode)

def rightsAt (operation : Nat) : {families : SourceDependencyAnnotations.ClauseDependencies} →
    SourcePlanSignatures.ClauseSignatures families → Option Syntax.OneShotRights
  | _, .nil => none
  | _, @SourcePlanSignatures.ClauseSignatures.cons _ _ _ other rights _ _ rest =>
      if operation = other then some rights else rightsAt operation rest

mutual
/-- Structural checking of the authenticated row syntax at its lexical receiver.
Request and owner primitives inspect the actual cut; recursive premises check
retained source syntax, never a future Local, Pending or execution result. -/
inductive Code (outward : List Instance) :
    (actions : Syntax.UsageTickets) → (budget : Footprint) → Phases → (world installations : List Nat) →
    {dependencies : SourceDependencyAnnotations.Dependencies} →
    {checking : SourcePlanSignatures.Signature dependencies} → Rows checking →
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} → Context hints → Prop where
  | pure : Code outward actions budget phases world installations .pure context
  | builtin
      (found : select effect operation context = some (.builtin identity)) :
      Code outward actions budget phases world installations (Rows.request (effect := effect) (operation := operation)) context
  | request {wholeHints : ReturnHints wholeScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
      {whole : Context wholeHints} {captured : Context capturedHints} {tail : Context tailHints}
      (cut : Cut effect operation whole captured tail contract modes)
      (guarded : SourceDependencyChecks.Lexical.Capture wholeScope effect operation)
      (callbacks : contract.dispose = true → Pending outward actions budget phases world installations
        captured (.closing tail) .unwind .unwind)
      (ownerBound : contract.dispose = true → SourceDependencyOwners.PendingWithin world
        (SourceDependencyOwners.owners capturedScope) capturedScope)
      (cleanupBudget : RequestBudget budget phases effect operation whole)
      {family : Nat → SourceDependencyAnnotations.Dependencies}
      {bodies : ∀ owner, SourcePlanSignatures.Signature (family owner)}
      {bodyRows : ∀ owner, Rows (bodies owner)}
      {declarations : SourcePlanSignatures.ClauseSignatures declarationFamilies}
      {declarationRows : ClauseRows declarations}
      (selected : CapturedClauseRows effect operation capturedScope.held captured bodyRows)
      (terminal : TerminalHandler effect activation declarationRows captured)
      (requiredRights : rightsAt operation declarations = some rights)
      (retained : Pending outward actions budget phases world installations whole Context.nil
        .ordinary (wholeHints.returnMode .ordinary))
      (body : ∀ owner resumeDemand, actions owner = none → owner ∉ whole.ticketNames →
        Code outward (actions.insert owner rights) budget (OwnerPhaseTransitions.introduce phases owner)
          world installations (bodyRows owner)
          (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail)) :
      Code outward actions budget phases world installations (Rows.request (effect := effect) (operation := operation)) whole
  | resume {resumeDemand : List Nat} {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
      {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
      (located : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
        ⟨frontScope, capturedScope, tailScope⟩)
      (known : actions owner = some rights) (permission : rights.resume = true)
      (available : phases owner = .available)
      (resumeShape : ResumeShape (capturedHints.returnMode .ordinary) front = true)
      (restored : Pending outward actions budget (spend phases owner) world installations
        (captured.append (front.append (.spent (owner := owner) tail))) .nil .ordinary
        ((frontHints.append (.live (owner := owner) capturedHints tailHints)).returnMode .ordinary)) :
      Code outward actions budget phases world installations (Rows.invoke (key := ⟨owner, .resume⟩))
        (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail))
  | dispose {resumeDemand : List Nat} {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
      {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
      (located : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
        ⟨frontScope, capturedScope, tailScope⟩)
      (known : actions owner = some rights) (permission : rights.dispose = true)
      (available : phases owner = .available) (unprotected : capturedScope.held = false)
      (abandoned : Pending outward actions budget (spend phases owner) world installations captured
        (.closing (front.append (.spent (owner := owner) tail))) .unwind .unwind)
      (waiting : Pending outward actions budget (spend phases owner) world installations
        (front.append (.spent (owner := owner) tail)) .nil .ordinary
        ((frontHints.append (.live (owner := owner) capturedHints tailHints)).returnMode .ordinary)) :
      Code outward actions budget phases world installations (Rows.invoke (key := ⟨owner, .dispose⟩))
        (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail))
  | sequence
      (first : Code outward actions budget phases world installations firstRows (.plain secondRows context))
      (second : Code outward actions budget phases world installations secondRows context) :
      Code outward actions budget phases world installations (.sequence firstRows secondRows) context
  | choice
      (left : Code outward actions budget phases world installations first context)
      (right : Code outward actions budget phases world installations second context) :
      Code outward actions budget phases world installations (.choice first second) context
  | handler
      (body : ∀ activation, activation ∉ installations →
        Code outward actions budget phases world (activation :: installations) bodyRows
          (.handler (effect := effect) (table := table) activation declarations context)) :
      Code outward actions budget phases world installations
        (.handler (effect := effect) (table := table) (required := required) declarations bodyRows) context
  | cleanup
      (body : Code outward actions budget phases world installations bodyRows (.cleanup (needs := needs) latent callbackRows context))
      (callback : Code outward actions budget phases world installations callbackRows (.normal context)) :
      Code outward actions budget phases world installations (.cleanup (needs := needs) latent callbackRows bodyRows) context
  | resource
      (body : ∀ identity, identity ∉ world →
        Code outward actions budget phases (world ++ [identity]) installations (bodyRows identity) (.cell (identity := identity) context)) :
      Code outward actions budget phases world installations (.resource bodyRows) context

/-- Retained source checking follows the actual lexical stack in its return
mode. Unwinding skips plain expressions and handlers, retains still-live builtin
scopes, and checks each callback where it will execute. -/
inductive Pending (outward : List Instance) :
    (actions : Syntax.UsageTickets) → (budget : Footprint) → Phases → (world installations : List Nat) →
    {scope outside : SourceDependencyCapture.Scope} →
    {hints : ReturnHints scope} → {external : ReturnHints outside} →
    Context hints → Context external → UseMode → UseMode → Prop where
  | nil : Pending outward actions budget phases world installations .nil outside mode mode
  | plain
      (code : Code outward actions budget phases world installations rows (rest.append outside))
      (tail : Pending outward actions budget phases world installations rest outside .ordinary finalMode) :
      Pending outward actions budget phases world installations (.plain rows rest) outside .ordinary finalMode
  | skipped (tail : Pending outward actions budget phases world installations rest outside .unwind finalMode) :
      Pending outward actions budget phases world installations (.plain rows rest) outside .unwind finalMode
  | handler (tail : Pending outward actions budget phases world installations rest outside mode finalMode) :
      Pending outward actions budget phases world installations (.handler activation rows rest) outside mode finalMode
  | cell (tail : Pending outward actions budget phases world installations rest outside mode finalMode) :
      Pending outward actions budget phases world installations (.cell rest) outside mode finalMode
  | cleanup
      (callback : Code outward actions budget phases world installations rows ((rest.append outside).callback mode))
      (tail : Pending outward actions budget phases world installations rest outside mode finalMode) :
      Pending outward actions budget phases world installations (.cleanup latent rows rest) outside mode finalMode
  | normal (tail : Pending outward actions budget phases world installations rest outside .ordinary finalMode) :
      Pending outward actions budget phases world installations (.normal rest) outside .ordinary finalMode
  | unwinding (tail : Pending outward actions budget phases world installations rest outside .unwind finalMode) :
      Pending outward actions budget phases world installations (.unwinding rest) outside .ordinary finalMode
  | closing (tail : Pending outward actions budget phases world installations rest outside .ordinary finalMode) :
      Pending outward actions budget phases world installations (.closing rest) outside mode finalMode
  | retiring (tail : Pending outward actions budget phases world installations rest outside mode finalMode) :
      Pending outward actions budget phases world installations (.retiring owner rest) outside mode finalMode
  | live {resumeDemand : List Nat} (saved : Pending outward actions budget phases world installations captured (rest.append outside) .ordinary middle)
      (tail : Pending outward actions budget phases world installations rest outside middle finalMode) :
      Pending outward actions budget phases world installations (.live (resumeDemand := resumeDemand) captured rest) outside .ordinary finalMode
  | opening {resumeDemand : List Nat}
      (saved : Pending outward actions budget phases world installations captured (.retiring owner (rest.append outside)) .unwind .unwind)
      (tail : Pending outward actions budget phases world installations rest outside .unwind finalMode) :
      Pending outward actions budget phases world installations (.live (owner := owner) (resumeDemand := resumeDemand) captured rest) outside .unwind finalMode
  | spent (tail : Pending outward actions budget phases world installations rest outside mode finalMode) :
      Pending outward actions budget phases world installations (.spent rest) outside mode finalMode
end
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open SourceDependencyChecks.Lexical (ReturnHints)

theorem Code.compile
    {checking : SourcePlanSignatures.Signature dependencies} {rows : Rows checking}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations rows context) :
    SourceDependencyChecks.Lexical.ReturnHints.Recursive.Local outward actions phases world dependencies hints ∧
      Budgeted budget phases world installations rows context := by
  apply Code.rec (motive_1 := fun actions budget phases world installations {dependencies checking} rows {scope hints} context _ =>
      SourceDependencyChecks.Lexical.ReturnHints.Recursive.Local outward actions phases world dependencies hints ∧
        Budgeted budget phases world installations rows context) (motive_2 := fun actions budget phases world installations {scope outsideScope hints external} context outside input output _ =>
      SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward actions phases world hints external input output ∧
        PendingBudget budget phases world installations context outside input output) (t := checked)
  · intros
    exact ⟨.pure, .pure⟩
  · intro effect operation scope hints context identity actions budget phases world installations found
    have selection := Contextual.select_sound effect operation context
    rw [found] at selection
    have guard : SourceDependencyChecks.Lexical.Capture _ _ _ := .builtin selection.symm
    refine ⟨.request guard ?_ ?_, .request (.builtin found)⟩
    · intro capturedScope tailScope captured tail contract modes same selected disposing
      rw [← selection] at selected
      cases selected
    · intro captured tail contract modes selected disposing
      rw [← selection] at selected
      cases selected
  · intros
    rename_i ihCallbacks _ihRetained _ihBody
    exact ⟨local_request_at_cut (by assumption) (by assumption)
      (fun disposing => (ihCallbacks disposing).1) (by assumption), .request (by assumption)⟩
  · intros
    rename_i located known permission available resumeBudget restored ih
    exact ⟨.resume located known permission available ih.1, .invoke⟩
  · intros
    rename_i located known permission available unprotected abandoned waiting ihAbandoned ihWaiting
    exact ⟨.dispose located known permission available unprotected
      ihAbandoned.1 ihWaiting.1, .invoke⟩
  · intros
    rename_i first second ihFirst ihSecond
    exact ⟨.sequence ihFirst.1 ihSecond.1,
      .sequence ihFirst.2 ihSecond.2⟩
  · intros
    rename_i left right ihLeft ihRight
    exact ⟨.choice ihLeft.1 ihRight.1,
    .choice ihLeft.2 ihRight.2⟩
  · intros
    rename_i body ih
    exact ⟨.handler (ih _ (Classical.choose_spec (ScopedTyping.fresh_world_name _))).1,
      .handler (fun activation fresh => (ih activation fresh).2)⟩
  · intros
    rename_i body callback ihBody ihCallback
    exact ⟨.cleanup ihBody.1 ihCallback.1,
    .cleanup ihBody.2 ihCallback.2⟩
  · intros
    rename_i body ih
    exact ⟨.resource (fun identity fresh => (ih identity fresh).1),
    .resource (fun identity fresh => (ih identity fresh).2)⟩

  · intros
    exact ⟨.nil, .nil⟩
  · intros
    rename_i code tail ihCode ihTail
    exact ⟨.plain ihCode.1 ihTail.1,
    .plain ihCode.2 ihTail.2⟩
  · intros
    rename_i tail ih
    exact ⟨.skipped ih.1, .skipped ih.2⟩
  · intros
    rename_i tail ih
    exact ⟨.handler ih.1, .handler ih.2⟩
  · intros
    rename_i tail ih
    exact ⟨.cell ih.1, .cell ih.2⟩
  · intros
    rename_i callback tail ihCallback ihTail
    exact ⟨.cleanup ihCallback.1 ihTail.1,
    .cleanup ihCallback.2 ihTail.2⟩
  · intros
    rename_i tail ih
    exact ⟨.normal ih.1, .normal ih.2⟩
  · intros
    rename_i tail ih
    exact ⟨.unwinding ih.1, .unwinding ih.2⟩
  · intros
    rename_i tail ih
    exact ⟨.closing ih.1, .closing ih.2⟩
  · intros
    rename_i tail ih
    exact ⟨.retiring ih.1, .retiring ih.2⟩
  · intros
    rename_i saved tail ihSaved ihTail
    exact ⟨.live ihSaved.1 ihTail.1,
    .live ihSaved.2 ihTail.2⟩
  · intros
    rename_i saved tail ihSaved ihTail
    exact ⟨.opening ihSaved.1 ihTail.1,
    .opening ihSaved.2 ihTail.2⟩
  · intros
    rename_i tail ih
    exact ⟨.spent ih.1, .spent ih.2⟩

theorem Pending.compile
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside input output) :
    SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward actions phases world hints external input output ∧
      PendingBudget budget phases world installations context outside input output := by
  apply Pending.rec (motive_2 := fun actions budget phases world installations {scope outsideScope hints external} context outside input output _ =>
      SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward actions phases world hints external input output ∧
