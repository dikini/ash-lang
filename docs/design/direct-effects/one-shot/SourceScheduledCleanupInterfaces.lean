/-- The first resume is checked with the exact non-pure bind suffix installed. -/
theorem firstPrimitive : SourceAdmission.Code [] actions []
    (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] []
    (Rows.invoke (key := ⟨0, .resume⟩)) (.plain currentRows parentContext) := by
