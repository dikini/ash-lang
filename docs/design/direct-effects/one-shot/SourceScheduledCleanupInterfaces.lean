                        normalBudget.reindex_context
                          (congrArg (fun p : Packed => (Context.normal p.context).pack) context.append_nil_pack.symm)
                      have callbackCertificateAtNil := certificates.2.reindex_context
                        (congrArg (fun p : Packed => (Context.normal p.context).pack) context.append_nil_pack.symm)
