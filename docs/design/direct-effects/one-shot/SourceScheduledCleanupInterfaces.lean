private theorem retained_cell_reply
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
        runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩)
    (selected : CellUpdate identity old new beforeStack afterStack)
    (isValue : operand.IsValue)
    (response : ∀ allowed argument result, operations (.cell identity) operation = some (argument, result) →
      SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) allowed reply result)
    (responseAuth : ∀ allowed scope result,
      ∀ source : SourcePlannedSources.Expression operations policy contracts world allowed scope (fun _ => none)
        reply result [] (.request [] []) .pure,
      ∀ resultRows : ValueRows result,
        Auth operations policy ports owners emptyRows source resultRows .pure)
    (step : RawStep ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
      runtimeScope, beforeStack⟩ ⟨reply, runtimeScope, afterStack⟩ [] [])
    (operational : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨reply, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨reply, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i hints context resultRows
    obtain ⟨nextAnnotated, nextRow, empty, nextSource, nextCertified, nextPending,
      nextAnnotation, rawPath, generatedPath, nextChecked, included, nextLocal,
      nextRetained, nextMatching, nextBound, nextResumes, nextDisposals, raw,
      transition, sameOwners, nextUse, nextTickets, nextResources⟩ :=
      cell_reply_planned_generated current.source pending retained coherent.forget.source.matching bound annotation checked
        state.lifetime.2.2 state.tickets state.resources selected isValue (response _) step
    have nextCoherent := coherent.cell_update selected
    have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows
        world history _ outward runtimeScope actions (OwnerPhaseTransitions.available (ownedTickets afterStack)) budget
        tables families context afterStack reply _ [] (.request [] []) .pure resultRows .pure :=
      ⟨nextSource, responseAuth _ _ _ nextSource resultRows, .pure, .pure, nextCoherent.forget.source⟩
    refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
      operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
    exact RetainedSource.eval nextCurrent nextCertified scopeTyped nextPending nextCoherent
      (by simpa only [sameOwners] using pendingBudget)
      (by simpa only [sameOwners] using nextRetained) nextBound
      ((cell_update_check_forest selected coherent.forget.source.matching).symm.trans finite)
      nextAnnotation (by simpa only [sameOwners] using nextChecked) (included.trans bounded)
      .pure (by simpa only [sameOwners] using pendingCertificate)

/-- Reading an integer cell preserves the exact retained source metadata.
The builtin signature and selected physical update are the existing premises. -/
theorem RetainedState.read_cell
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)),
        runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩)
    (builtin : operations.erase.erase.ports (.cell identity) 0 = some (.reference identity, .integer))
    (selected : CellUpdate identity payload payload beforeStack afterStack) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.integer payload, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  apply retained_cell_reply state selected (by trivial) ?_ ?_
    (.readCell identity payload runtimeScope beforeStack afterStack selected)
    (state.joined.read_cell builtin selected)
  · intro allowed argument result known
    have answer := (Prod.mk.inj (Option.some.inj (builtin.symm.trans (CoherentSourceTypes.port_lookup
      (SourceDependencyAnnotations.operation_erase (SourcePlannedSources.operation_erase known)))))).2
    cases result <;> cases answer
    exact .integer
  · intro allowed scope result source resultRows
    cases source
    cases resultRows
    exact .integer

