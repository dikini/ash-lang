/-- Install the actual authenticated callback, preserving its contextual ownership root. -/
theorem ExecutionSite.register_cleanup_accounting
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows)
    (expressionEq : site.expression = .cleanup callback body)
    (isValue : callback.IsValue)
    (interpreted : Accounting.Run world history site.rows site.context (root : Requirements demand))
    (identity : Nat) :
    ∃ action : ActionData,
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows,
      action.identity = identity ∧ action.action = callback ∧ action.scope = site.runtimeScope ∧
      next.expression = body ∧ next.runtimeScope = site.runtimeScope ∧
      next.stack = .push (.armed action) site.stack ∧
      Accounting.Run world history next.rows next.context root ∧
      (∀ annotations, Bound annotations site.receiving → Bound annotations next.receiving) ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [.cleanup identity] [] := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at expressionEq interpreted ⊢
  subst expression
  obtain ⟨ticket, typed⟩ := scopeTyped
  rcases current with ⟨current, currentCertificate⟩
  change CodeChecked ambient outward currentCertificate at currentResource
  change PendingChecked ambient outward retained at retainedResource
  cases plan with
  | sequence initialPlan remainingPlan => cases remainingPlan with
    | cleanup callbackPlan bodyPlan =>
      rename_i callbackDependencies bodyDependencies requests
      rcases current with ⟨source, authenticated, localCheck, cleanupBudget, contextSource⟩
      cases authenticated with
      | cleanup callbackAuth bodyAuth =>
        rename_i latent initialDemand initialReq bodyDemand bodyReq admitted callbackRows callbackBodyRows callbackSource bodyRows bodySource
        have certificates :
            SourceAdmission.Code outward actions budget phases world history
              bodyRows (.cleanup (needs := requests) latent callbackBodyRows context) ∧
            SourceAdmission.Code outward actions budget phases world history
              callbackBodyRows (.normal context) := by
          cases currentCertificate with
          | sequence initial remaining =>
            cases remaining with
            | cleanup bodyCertificate callbackCertificate => exact ⟨bodyCertificate, callbackCertificate⟩
        have remainingRun := (Accounting.silent_prefix_iff
          (SourceDependencyAnnotations.value_silent (SourcePlannedSources.expression_erase callbackSource) isValue)
          callbackRows (.cleanup (needs := requests) latent callbackBodyRows bodyRows)).mp interpreted
        have bodyRun : Accounting.Run world history bodyRows
            (.cleanup (needs := requests) latent callbackBodyRows context) root := by
          cases remainingRun with | installCleanup inside => exact inside
        have oldCallback := DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
          (SourcePlannedSources.expression_erase callbackSource))
        have empty := SourceTemplates.expression_value_demand oldCallback isValue
        subst initialDemand
        have summaryAuth := (callbackAuth.value_summary isValue).value_context isValue [] .none
        let summary := SourcePlannedSources.Values.change_context
          (SourcePlannedSources.Values.summary callbackSource isValue) isValue [] .none
        have callbackPorts := SourceTemplates.expression_ports
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase summary))) ScopedPorts.EffectScope.none
        have closed := ScopedPorts.typed_value_closed callbackPorts isValue
        let action : ActionData := ⟨identity, callback, closed, runtimeScope,
          ScopedPorts.embedPort result.erase.erase.port, requests⟩
        cases certified with | sequence initialCertified remainingCertified =>
          cases remainingCertified with | cleanup callbackCertified bodyCertified =>
            have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required
                outward world (.armed action) result result [] (.request [] (qualify true latent))
                (.cleanup requests callbackDependencies) (fun rest => .cleanup rest) allowed allowed :=
              .armed ⟨_, ScopedPorts.effect_scope_has_types typed⟩ summary (by simp [action])
                (.armed ⟨_, typed⟩ callbackPorts admitted) callbackCertified
            have frameRows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
                frame resultRows resultRows context (.cleanup (needs := requests) latent callbackBodyRows context) :=
              .armed (action := action) (resultRows := resultRows) (callback := summary)
                (scopeKnown := ⟨_, ScopedPorts.effect_scope_has_types typed⟩)
                (annotation := by simp [action])
                (interface := .armed ⟨_, typed⟩ callbackPorts admitted) (certified := callbackCertified) summaryAuth
            have nextContextSource : Context.Source operations.erase policy contracts.erase tables families world
                (.cleanup (needs := requests) latent callbackBodyRows context) (.push (.armed action) stack) :=
              .cleanup (action := action) (rows := callbackBodyRows)
                (SourcePlannedSources.expression_erase summary) contextSource
            have callbackCertificateAtNil := certificates.2.reindex_context
              (congrArg (fun p : Packed => (Context.normal p.context).pack) context.append_nil_pack.symm)
            let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
                resumes budget ports owners emptyRows output outputRows :=
              { expression := body, runtimeScope := runtimeScope, stack := .push (.armed action) stack,
                result := result, resultRows := resultRows, allowed := allowed,
                dependencies := bodyDependencies, plan := bodyPlan, rows := bodyRows,
                sourceDemand := bodyDemand, sourceRequirements := bodyReq,
                receiving := .cleanup requests callbackDependencies receiving, hints := .cleanup hints,
                context := .cleanup (needs := requests) latent callbackBodyRows context,
                current := SourceAdmission.Admitted.of_source bodySource bodyAuth certificates.1 nextContextSource,
                certified := bodyCertified, scopeTyped := ⟨ticket, typed⟩,
                pendingDemand := [] ++ pendingDemand,
                pendingRequirements := .sequence
                  ((Requirements.request [] (qualify true latent)).prepend (OwnerPhases.ofStack tables stack)) pendingRequirements,
                pending := .push (.ordinary frame) pending,
                coherent := .push (.ordinary frameRows) coherent,
                retained := .cleanup callbackCertificateAtNil retained,
                currentResource := by
                  cases currentResource with | sequence _ remaining =>
                    cases remaining with | cleanup bodyResource _ => exact bodyResource,
                retainedResource := by
                  cases currentResource with | sequence _ remaining =>
                    cases remaining with | cleanup _ callbackResource =>
                      exact .cleanup (callbackResource.reindex_context
                        (congrArg (fun p : Packed => (Context.normal p.context).pack) context.append_nil_pack.symm)) retainedResource }
            exact ⟨action, next, rfl, rfl, rfl, rfl, rfl, rfl, bodyRun,
              (fun _ bound => .cleanup bound), .enterCleanup action body stack⟩
    | pure | request | invoke | sequence | choice | handler | resource => cases current.source
  | pure | request | invoke | choice | handler | cleanup | resource => cases current.source

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
