                have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows world history
                    allowed outward caller actions (available (ownedTickets tail)) budget tables families
                    restContext tail .unit .unit [] (.request [] []) (signature Plan.pure) .unit .pure :=
                  ⟨.unit, .unit, .pure, .pure, remaining.forget.source⟩
                refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                  operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
                apply RetainedSource.eval nextCurrent (Certified.pure (evidence := declarationPolicy)) callerKnown
                  suffix remaining remainingBudget remainingLocal restBound ?_ nextAnnotation nextChecked (included.trans bounded) .pure remainingCertificate
                simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
                  Bool.true_and] using finite

