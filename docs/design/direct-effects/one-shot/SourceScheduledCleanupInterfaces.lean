/-- An inherited disposing request can abandon a live capture. The annotation
follows lexical unwinding, including the saved capture and its retirement. -/
theorem inherited_disposing_request : Code [] actions [] phases [] [2]
    (Rows.request (effect := effect) (operation := 0)) (inherited) := by
  apply Code.request (effect := effect) (operation := 0) (whole := inherited)
    (captured := inherited) (tail := Context.nil) (contract := consuming)
