open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local)

/-- The existing contextual site checker consumes the row authenticated by the
structural cleanup rule. The enclosing admission judgment must still supply the
actual receiving suffix and the recursive Local proofs. -/
theorem Auth.cleanup_checked_site
    {callbackSignature : Signature callbackDependencies}
    {callbackBody : Signature callbackBodyDependencies}
    {bodySignature : Signature bodyDependencies}
    {callbackRows : Rows callbackSignature} {callbackBodyRows : Rows callbackBody}
    {bodyRows : Rows bodySignature}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.cleanup action code) output demand requirements
      (.sequence callbackSignature (.cleanup (needs := requests) callbackBody bodySignature))}
    (checked : Auth operations policy ports owners environmentRows source outputRows
      (.sequence callbackRows (.cleanup latent callbackBodyRows bodyRows)))
    {hints : ReturnHints scope}
    (callbackEvaluation : Local outward actions phases world callbackDependencies
      (.plain (dependencies := .cleanup requests callbackBodyDependencies bodyDependencies) hints))
    (body : Local outward actions phases world bodyDependencies
      (.cleanup (needs := requests) (callback := callbackBodyDependencies) hints))
    (normalCallback : Local outward actions phases world callbackBodyDependencies (.running .normal hints))
    (rowChecked : CleanupHints.SiteRules.callbackCheck latent receiving phases budget = true) :
    CleanupHints.SiteRules.CleanupAt operations policy contracts world allowed outward runtimeScope environment
      actions phases hints receiving budget (.cleanup action code) output demand requirements
      (.sequence callbackSignature (.cleanup (needs := requests) callbackBody bodySignature)) := by
  cases checked with
  | cleanup callbackChecked bodyChecked =>
      exact .cleanup (by assumption) (by assumption) (by assumption) callbackEvaluation body normalCallback rowChecked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
