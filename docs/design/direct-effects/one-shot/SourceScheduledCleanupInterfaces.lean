/-- Both ordinary and opening owners carry their ordinary contract's exact
resume demand. The unwind source cannot replace this annotation. -/
theorem RecordPendingRows.resume_demand
    {contract : SourcePlannedTyping.Contract}
    {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {capturedContext : Context capturedHints} {tailContext : Context tailHints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements (.live owner capturedScope tailScope)}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows
        (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (known : contracts owner = some contract) :
    resumeDemand = contract.resumeDemand := by
  have physical := rows.forget.source
  cases physical with
  | live captured tail =>
      cases rows with
      | live answerRows agreement inside tail =>
          have sameContract := Option.some.inj
            ((by assumption : contracts owner = some _).symm.trans known)
          subst_vars
          rfl
      | opening answerRows agreement ordinary inside tail =>
          have sameContract := Option.some.inj
            ((by assumption : contracts owner = some _).symm.trans known)
          subst_vars
          rfl

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_demand


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts

/-- The authenticated resume expression contains the primitive's structural
certificate after its operand. Projection retains every primitive premise. -/
theorem Code.ready_resume
    {current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.resume binder value) result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows current resultRows rows)
    (resolved : runtimeScope.resolve binder = some owner)
    (checked : Code outward actions budget phases world installations rows context) :
    Code outward actions budget phases world installations (Rows.invoke (key := ⟨owner, .resume⟩)) context := by
  cases authenticated with
  | resume operandChecked =>
      rename_i actual operand
      cases Option.some.inj (actual.symm.trans resolved)
      cases checked with
      | sequence first second => exact second

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Code.ready_resume

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)
open OwnerPhaseTransitions (spend)

/-- Primitive inversion retains the exact live-context demand and caller shape.
It does not identify that demand with a separately selected contract. -/
theorem Code.resume_parts
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .resume⟩)) context) :
    ∃ front captured tail : Packed, ∃ resumeDemand : List Nat, ∃ rights : Syntax.OneShotRights,
      context.pack = (front.context.append
        (.live (owner := owner) (resumeDemand := resumeDemand) captured.context tail.context)).pack ∧
      OwnerCut owner scope ⟨front.scope, captured.scope, tail.scope⟩ ∧
      actions owner = some rights ∧ rights.resume = true ∧ phases owner = .available ∧
      ResumeShape (captured.hints.returnMode .ordinary) front.context = true ∧
      Pending outward actions budget (spend phases owner) world installations
        (captured.context.append (front.context.append (.spent (owner := owner) tail.context)))
        .nil .ordinary (hints.returnMode .ordinary) := by
  cases checked with
  | resume located known permission available resumeBudget restored =>
      exact ⟨⟨_, _, _⟩, ⟨_, _, _⟩, ⟨_, _, _⟩, _, _, rfl, located, known, permission, available, resumeBudget, restored⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Code.resume_parts

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)
open OwnerPhaseTransitions (spend)

/-- The current structural primitive and coherent pending source identify one
caller shape using the selected contract's actual source. -/
theorem RecordPendingRows.resume_site
    {contract : SourcePlannedTyping.Contract}
    {hints : ReturnHints scope} {context : Context hints}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (code : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .resume⟩)) context)
    (known : contracts owner = some contract) :
    ∃ front captured tail : Packed, ∃ rights : Syntax.OneShotRights,
      context.pack = (front.context.append
        (.live (owner := owner) (resumeDemand := contract.resumeDemand) captured.context tail.context)).pack ∧
      OwnerCut owner scope ⟨front.scope, captured.scope, tail.scope⟩ ∧
      actions owner = some rights ∧ rights.resume = true ∧ phases owner = .available ∧
      ResumeShape (captured.hints.returnMode .ordinary) front.context = true ∧
      SourceAdmission.Pending outward actions budget (spend phases owner) world installations
        (captured.context.append (front.context.append (.spent (owner := owner) tail.context)))
        .nil .ordinary (hints.returnMode .ordinary) := by
  obtain ⟨front, captured, tail, resumeDemand, rights, same, located, actionKnown,
    permission, available, budgeted, restored⟩ := code.resume_parts
  obtain ⟨firstStack, secondStack, middle, middleRows, firstDemand, secondDemand,
    firstRequirements, secondRequirements, firstSource, secondSource,
    stackSame, firstRows, secondRows, demandSame, evaluation, generatedEvaluation⟩ :=
    rows.split_disposals front.context
      (Context.live (owner := owner) (resumeDemand := resumeDemand) captured.context tail.context) same
  have exactDemand := secondRows.resume_demand known
  subst resumeDemand
  exact ⟨front, captured, tail, rights, same, located, actionKnown, permission, available, budgeted, restored⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_site

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Checked evaluate)

/-- The actual caller's authenticated frames generate their own cleanup source.
Its generated requirements evaluate exactly as the actual projected metadata;
no equality with an independently reconstructed source witness is assumed. -/
theorem RecordPendingRows.closing_generated
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (found : context.closing? = some metadata) :
    ∃ generated : Requirements metadata.closing.1,
      PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind .unwind metadata.closing.1 generated scope ∧
      annotateDisposals generated = generated ∧
      metadata.closing.1.Perm (ownedTickets stack) ∧
      ∀ entries receiving phases,
        evaluate entries receiving phases (annotateDisposals generated) =
          evaluate entries receiving phases metadata.closing.2 := by
  have actual := (rows.forget.planned_closing found).planned found
  obtain ⟨generated, planned, unchanged, storedUnchanged, evaluation⟩ := actual.disposal_evaluation
  refine ⟨generated, planned, unchanged, actual.erase.template.ownership, ?_⟩
  intro entries receiving phases
  simpa only [storedUnchanged] using evaluation entries receiving phases

/-- A finite check of the actual metadata checks the generated planned caller
at any record store. The metadata check itself supplies its ownership trace. -/
theorem RecordPendingRows.closing_generated_checked
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (found : context.closing? = some metadata)
    (accepted : metadata.check receiving phases budget = true) (entries : RecursiveRequirements.Store) :
    ∃ generated : Requirements metadata.closing.1, ∃ row,
      PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind .unwind metadata.closing.1 generated scope ∧
      annotateDisposals generated = generated ∧
      metadata.closing.1.Perm (ownedTickets stack) ∧
      Checked entries receiving phases (annotateDisposals generated) row ∧ row ⊆ budget := by
  obtain ⟨generated, planned, unchanged, ownership, evaluation⟩ := rows.closing_generated found
  obtain ⟨metadataRow, evaluated, bounded⟩ := metadata.check_iff.mp accepted
  have trace := RecursiveRequirements.checked_trace (RecursiveRequirements.evaluate_sound evaluated)
  have agreed := rows.forget.source.closing_agreement found
  obtain ⟨row, checked, within⟩ := (agreed.effects accepted).checked (store := entries) trace
  refine ⟨generated, row, planned, unchanged, ownership, ?_, within⟩
  apply RecursiveRequirements.evaluate_sound
  rw [evaluation]
  exact RecursiveRequirements.checked_complete checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.closing_generated
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.closing_generated_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut OwnerSelection Realizes)

/-- Deterministic owner lookup fixes the three source scopes without any
uniqueness premise on source derivations. -/
theorem owner_cut_scope_parts
    (first : OwnerCut owner scope ⟨front, captured, tail⟩)
    (second : OwnerCut owner scope ⟨nextFront, nextCaptured, nextTail⟩) :
    front = nextFront ∧ captured = nextCaptured ∧ tail = nextTail := by
  exact OwnerSelection.mk.inj (Option.some.inj (first.lookup.symm.trans second.lookup))

private def scopePrefixLength : SourceDependencyCapture.Scope → Nat
  | .nil => 0
  | .plain _ rest | .handler _ _ _ rest | .cell _ rest | .cleanup _ _ rest
  | .running rest | .live _ _ rest | .spent _ rest => scopePrefixLength rest + 1

private def stackPrefixLength : Stack → Nat
  | .nil => 0
  | .push _ rest | .live _ _ _ _ _ rest | .spent _ _ _ rest => stackPrefixLength rest + 1

private theorem realized_prefix_length (source : Realizes tables families scope stack) :
    scopePrefixLength scope = stackPrefixLength stack := by
  induction source with
  | nil => rfl
  | push frame rest ih => cases frame <;> exact congrArg (· + 1) ih
  | live saved rest ihSaved ihRest => exact congrArg (· + 1) ihRest
  | spent rest ih => exact congrArg (· + 1) ih

private theorem equal_length_append_unique
    (length : stackPrefixLength a = stackPrefixLength c)
    (same : a.append b = c.append d) : a = c ∧ b = d := by
  induction a generalizing c b d with
  | nil => cases c <;> simp_all [stackPrefixLength, Stack.append]
  | push frame rest ih =>
      cases c <;> simp only [stackPrefixLength] at length <;> simp only [Stack.append] at same
      all_goals try omega
      all_goals try cases same
      obtain ⟨rfl, remaining⟩ := Stack.push.inj same
      obtain ⟨rfl, rfl⟩ := ih (Nat.add_right_cancel length) remaining
      exact ⟨rfl, rfl⟩
  | live owner input answer captured caller rest ihCaptured ihRest =>
      cases c <;> simp only [stackPrefixLength] at length <;> simp only [Stack.append] at same
      all_goals try omega
      all_goals try cases same
      obtain ⟨rfl, rfl, rfl, rfl, rfl, remaining⟩ := Stack.live.inj same
      obtain ⟨rfl, rfl⟩ := ihRest (Nat.add_right_cancel length) remaining
      exact ⟨rfl, rfl⟩
  | spent owner answer caller rest ih =>
      cases c <;> simp only [stackPrefixLength] at length <;> simp only [Stack.append] at same
      all_goals try omega
      all_goals try cases same
      obtain ⟨rfl, rfl, rfl, remaining⟩ := Stack.spent.inj same
      obtain ⟨rfl, rfl⟩ := ih (Nat.add_right_cancel length) remaining
      exact ⟨rfl, rfl⟩

/-- Equal physical stacks have equal pieces at a fixed realized lexical scope. -/
theorem realized_append_stacks_unique
    (first : Realizes tables families scope a)
    (second : Realizes tables families scope c)
    (same : a.append b = c.append d) : a = c ∧ b = d :=
  equal_length_append_unique ((realized_prefix_length first).symm.trans (realized_prefix_length second)) same


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.owner_cut_scope_parts

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.realized_append_stacks_unique

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (Realizes)
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)

/-- The existing rich split, aligned to its actual physical prefix by lexical
scope. All generated sources, requirements and evaluation equations are retained. -/
theorem RecordPendingRows.split_disposals_at
    {whole : ReturnHints scope} {context : Context whole}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      (physicalFront.append physicalTail) input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      source inputRows outputRows context) :
    ∀ {firstScope secondScope} {first : ReturnHints firstScope} {second : ReturnHints secondScope}
      (head : Context first) (tail : Context second),
      context.pack = (head.append tail).pack →
      Realizes tables families firstScope physicalFront →
    ∃ middle, ∃ middleRows : ModeRowsValue middle,
    ∃ firstDemand secondDemand, ∃ firstRequirements : Requirements firstDemand,
    ∃ secondRequirements : Requirements secondDemand,
    ∃ firstSource : PlannedModeSource operations policy contracts tables families required outward actions world
      physicalFront input middle firstDemand firstRequirements firstScope,
    ∃ secondSource : PlannedModeSource operations policy contracts tables families required outward actions world
      physicalTail middle output secondDemand secondRequirements secondScope,
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        firstSource inputRows middleRows head ∧
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        secondSource middleRows outputRows tail ∧
      demand = firstDemand ++ secondDemand ∧
      (∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables physicalTail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals requirements) =
          merge (evaluate store (OwnerPhases.ofStack tables physicalTail ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  intro firstScope secondScope first second head tail same realized
  obtain ⟨inside, outside, middle, middleRows, firstDemand, secondDemand,
    firstRequirements, secondRequirements, firstSource, secondSource,
    stackSame, firstRows, secondRows, demandSame, evaluation, generatedEvaluation⟩ :=
    rows.split_disposals head tail same
  obtain ⟨rfl, rfl⟩ := realized_append_stacks_unique realized firstRows.forget.source.matching.erases stackSame
  exact ⟨middle, middleRows, firstDemand, secondDemand,
    firstRequirements, secondRequirements, firstSource, secondSource,
    firstRows, secondRows, demandSame, evaluation, generatedEvaluation⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.split_disposals_at

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut Realizes)
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (spend spendAll)


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open OwnerPhaseTransitions (spendAll)

/-- Add a fresh caller normal/cleanup alternative at its actual receiver.
Both the old pending subtree and the new caller choice remain visible. The
result is bounded by the common admitted budget, not by the old checked row. -/
theorem caller_pending_annotation_generated
    {front : Requirements frontDemand} {cleanup : Requirements cleanupDemand}
    {tail : Requirements tailDemand} {retained : Requirements pendingDemand}
    (aligned : frontDemand.Perm cleanupDemand)
    (pendingAligned : pendingDemand.Perm (frontDemand ++ tailDemand))
    (frontChecked : Checked entries (callerReceiver ++ receiving) before
      (annotateDisposals front) frontRow)
    (cleanupChecked : Checked entries (callerReceiver ++ receiving) before
      (annotateDisposals cleanup) cleanupRow)
    (tailChecked : Checked entries receiving (spendAll before frontDemand)
      (annotateDisposals tail) tailRow)
    (retainedChecked : Checked entries receiving before (annotateDisposals retained) retainedRow)
    (frontBound : frontRow ⊆ budget) (cleanupBound : cleanupRow ⊆ budget)
    (tailBound : tailRow ⊆ budget) (retainedBound : retainedRow ⊆ budget) :
    ∃ continuing : Requirements pendingDemand, ∃ row,
      RowAnnotation retained continuing ∧
      RequirementPath retained continuing [] ∧
      RequirementPath (.choice (front.prepend callerReceiver) (cleanup.prepend callerReceiver) aligned)
        continuing [] ∧
      Checked entries receiving before (annotateDisposals continuing) row ∧ row ⊆ budget := by
  have frontAtRoot : Checked entries receiving before
      (annotateDisposals (front.prepend callerReceiver)) frontRow := by
    rw [disposal_prepend]
    exact RecursiveRequirements.checked_prepend_iff.mpr frontChecked
  have cleanupAtRoot : Checked entries receiving before
      (annotateDisposals (cleanup.prepend callerReceiver)) cleanupRow := by
    rw [disposal_prepend]
    exact RecursiveRequirements.checked_prepend_iff.mpr cleanupChecked
  let callerChoice : Requirements frontDemand :=
    .choice (front.prepend callerReceiver) (cleanup.prepend callerReceiver) aligned
  have callerChecked : Checked entries receiving before
      (annotateDisposals callerChoice) (frontRow ++ cleanupRow) :=
    .choice frontAtRoot cleanupAtRoot
  refine ⟨.choice retained (.sequence callerChoice tail) pendingAligned,
    retainedRow ++ ((frontRow ++ cleanupRow) ++ tailRow),
    .alternatives .original pendingAligned, .yes .here, .no (.first .here),
    .choice retainedChecked (.sequence callerChecked tailChecked), ?_⟩
  exact List.append_subset.mpr ⟨retainedBound,
    List.append_subset.mpr ⟨List.append_subset.mpr ⟨frontBound, cleanupBound⟩, tailBound⟩⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.caller_pending_annotation_generated

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open OwnerPhaseTransitions (spendAll)

/-- Recompose unwind-return resumption from the actual caller's structural
cleanup check. The old pending annotation survives as an alternative; cleanup
is generated locally rather than selected from an inherited root path. -/
theorem resume_unwind_recomposition_generated
    (closeSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front .unwind .unwind closeDemand closeRequirements frontScope)
    (closeBalance : closeDemand.Perm (ownedTickets front))
    (closeChecked : Checked (annotateDisposalStore entries)
      (OwnerPhases.ofStack tables (.spent owner answerType caller tail)) (spendAll before resumeDemand)
      (annotateDisposals closeRequirements) closeRow)
    (savedSource : PlannedModeSource operations policy contracts tables families required outward actions world
      captured (.value input) .unwind resumeDemand savedRequirements capturedScope)
    (tailSource : PlannedModeSource operations policy contracts tables families required outward actions world
      tail .unwind output tailDemand tailRequirements tailScope)
    (frontBalance : frontDemand.Perm (ownedTickets front))
    (pendingBalance : pendingDemand.Perm (frontDemand ++ tailDemand))
    (wholeBalance : (resumeDemand ++ pendingDemand).Perm
      (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))))
    (consumed : before owner = .consumed)
    (savedChecked : Checked (annotateDisposalStore entries)
      (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail))) before
      (annotateDisposals savedRequirements) savedRow)
    (savedAnnotatedCheck : Checked (annotateDisposalStore entries)
      (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail))) before
      (annotateDisposals (savedAnnotated : Requirements resumeDemand)) savedAnnotatedRow)
    (frontChecked : Checked (annotateDisposalStore entries)
      (OwnerPhases.ofStack tables (.spent owner answerType caller tail)) (spendAll before resumeDemand)
      (annotateDisposals (frontRequirements : Requirements frontDemand)) frontRow)
    (tailChecked : Checked (annotateDisposalStore entries) []
      (spendAll (spendAll before resumeDemand) frontDemand) (annotateDisposals tailRequirements) tailRow)
    (retainedChecked : Checked (annotateDisposalStore entries) [] (spendAll before resumeDemand)
      (annotateDisposals (retained : Requirements pendingDemand)) retainedRow)
    (savedBound : savedRow ⊆ budget) (savedAnnotatedBound : savedAnnotatedRow ⊆ budget)
    (closeBound : closeRow ⊆ budget)
    (frontBound : frontRow ⊆ budget) (tailBound : tailRow ⊆ budget) (retainedBound : retainedRow ⊆ budget) :
    ∃ aligned : frontDemand.Perm closeDemand,
    ∃ demand, ∃ requirements annotatedNext : Requirements demand, ∃ row annotatedRow,
      PlannedModeSource operations policy contracts tables families required outward actions world
        (captured.append (front.append (.spent owner answerType caller tail))) (.value input) output
        demand requirements (capturedScope.append (frontScope.append (.spent owner tailScope))) ∧
      Checked (annotateDisposalStore entries) [] before (annotateDisposals requirements) row ∧ row ⊆ budget ∧
      RowAnnotation requirements annotatedNext ∧
      Checked (annotateDisposalStore entries) [] before (annotateDisposals annotatedNext) annotatedRow ∧
      annotatedRow ⊆ budget ∧
      RequirementPath retained annotatedNext resumeDemand ∧
      RequirementPath
        (.choice (frontRequirements.prepend (OwnerPhases.ofStack tables (.spent owner answerType caller tail)))
          (closeRequirements.prepend (OwnerPhases.ofStack tables (.spent owner answerType caller tail))) aligned)
        annotatedNext resumeDemand ∧
      RequirementPath
        (savedAnnotated.prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail))))
        annotatedNext [] ∧
      demand.Perm (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) := by
  have aligned : frontDemand.Perm closeDemand := frontBalance.trans closeBalance.symm
  have spentChecked : Checked (annotateDisposalStore entries) []
      (spendAll (spendAll before resumeDemand) closeDemand)
      (annotateDisposals (.sequence (.spent owner) tailRequirements)) tailRow := by
    have phased := PhaseRechecking.spendAll_permutation (before := spendAll before resumeDemand) aligned
    have stillConsumed := RecursiveTransport.phases_spendAll_later (owners := closeDemand) owner
      (RecursiveTransport.phases_spendAll_later (owners := resumeDemand) owner consumed)
    simpa only [annotateDisposals, OwnerPhaseTransitions.spendAll, List.nil_append] using
      Checked.sequence (Checked.spent stillConsumed) (phased ▸ tailChecked)
  have spentSource := PlannedModeSource.skippedSpent (owner := owner) (answerType := answerType)
    (caller := caller) tailSource
  obtain ⟨callerRequirements, callerSource, callerAnnotation, callerChecked⟩ :=
    closeSource.append_checked_generated spentSource
      (by simpa only [List.append_nil] using closeChecked) spentChecked
  obtain ⟨requirements, rebuilt, generatedAnnotation, checked⟩ :=
    savedSource.append_checked_generated callerSource
      (by simpa only [List.append_nil] using savedChecked) callerChecked
  obtain ⟨continuing, continuingRow, continuingAnnotation, retainedPath, cleanupPath,
    continuingCheck, continuingBound⟩ := caller_pending_annotation_generated aligned pendingBalance
      (by simpa only [List.append_nil] using frontChecked)
      (by simpa only [List.append_nil] using closeChecked) tailChecked retainedChecked
      frontBound closeBound tailBound retainedBound
  have savedAtRoot : Checked (annotateDisposalStore entries) [] before
      (annotateDisposals (savedAnnotated.prepend
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail))))) savedAnnotatedRow := by
    rw [disposal_prepend]
    exact RecursiveRequirements.checked_prepend_iff.mpr (by simpa only [List.append_nil] using savedAnnotatedCheck)
  have same : (resumeDemand ++ (closeDemand ++ tailDemand)).Perm (resumeDemand ++ pendingDemand) :=
    ((aligned.symm.append_right tailDemand).trans pendingBalance.symm).append_left resumeDemand
  let annotatedNext := Requirements.choice requirements
    (.sequence (savedAnnotated.prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))) continuing) same
  refine ⟨aligned, _, requirements, annotatedNext, _, _, rebuilt, checked, ?_,
    .alternatives .original same, Checked.choice checked (Checked.sequence savedAtRoot continuingCheck), ?_,
    .no (by simpa only [List.append_nil] using RequirementPath.second retainedPath),
    .no (by simpa only [List.append_nil] using RequirementPath.second cleanupPath),
