/-- Exact retained source and its structural certificate establish lexical
continuation access, including dormant captures, without administrative usage
or an ownership-demand alignment premise. -/
theorem RecordPendingRows.ticket_access
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints outsideScope} {outside : Context external}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (checked : SourceAdmission.Pending outward actions budget phases world installations
      context outside input.mode output.mode)
    (outsideSource : SourceDependencyCapture.Realizes tables families outsideScope outsideStack) :
    LexicalUnwind.TicketAccess stack input.mode output.mode (activeTickets outsideStack) := by
  have inputMode : input.erase.mode = input.mode := by cases input <;> rfl
  have outputMode : output.erase.mode = output.mode := by cases output <;> rfl
  have compiled : ReturnHints.Recursive.Pending outward actions phases world hints external
      input.erase.mode output.erase.mode := by
    simpa only [inputMode, outputMode] using checked.compile.1
  have access := SourceTicketAccess.mode_pending_access source.erase rows.forget.source.matching compiled
  simpa only [inputMode, outputMode, SourceTicketAccess.active_realizes outsideSource] using access

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.ticket_access

namespace Ash.OneShot.ScopedExecution
open ScopedExpressions

/-- A ready resume's actual value operand has no continuation demand. The
existing value-use transport retains its checked value body and caller scope. -/
theorem resume_operand_code_demand
    (checked : CodeDemand policy tickets scope (.resume binder value) demand)
    (isValue : value.IsValue) :
    CodeDemand policy tickets scope value [] := by
  cases checked with
  | idle scopeKnown used => cases used
  | consume known used => cases used with
    | resume permission operand =>
        exact .idle (.bound known) (value_use_transport isValue operand _ .available)

end Ash.OneShot.ScopedExecution

namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Resume preserves current-value ticket access from the actual operand and
an independently reconstructed successor-stack access proof. No MachineUse,
StackUse, regional demand balance or legacy root check is required. -/
theorem resume_value_machine_ticket_access
    (before : MachineTicketAccess policy tickets (.eval ⟨.resume binder value, scope, beforeStack⟩))
    (closed : ClosedValue value)
    (after : TicketAccess afterStack .ordinary .ordinary []) :
    MachineTicketAccess policy tickets (.eval ⟨value, scope, afterStack⟩) := by
  obtain ⟨demand, code, _visible, _stack⟩ := before
  exact ⟨[], resume_operand_code_demand code closed.1, List.nil_subset _, after⟩

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.ScopedExecution.resume_operand_code_demand
