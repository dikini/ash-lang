import SourcePlainSuffixTransport
import SourceScheduledCleanupInsertion
import SourceScheduledCallbackRoutes
import SourceContextualCapture
import SourcePlannedSourceReduction
import SourceDeclarationPolicyTransport

namespace Ash.OneShot

/-- Contract and captured-scope entries refer only to historically issued tickets.
The maps retain consumed entries; scalar callable records have a separate lifetime. -/
structure CaptureMetadataHistory (contracts : Nat → Option α) (annotations : Nat → Option β)
    (issued : List Owner) : Prop where
  contractIssued : ∀ owner value, contracts owner = some value → Owner.ticket owner ∈ issued
  annotationIssued : ∀ owner value, annotations owner = some value → Owner.ticket owner ∈ issued

theorem CaptureMetadataHistory.empty :
    CaptureMetadataHistory (fun _ => (none : Option α)) (fun _ => (none : Option β)) issued := by
  constructor <;> intro owner value known <;> cases known

theorem CaptureMetadataHistory.mono
    (history : CaptureMetadataHistory contracts annotations issued) (larger : issued ⊆ nextIssued) :
    CaptureMetadataHistory contracts annotations nextIssued :=
  ⟨fun owner value known => larger (history.contractIssued owner value known),
   fun owner value known => larger (history.annotationIssued owner value known)⟩

/-- One actual allocation installs both entries at the same newly issued identity. -/
theorem CaptureMetadataHistory.insert
    {contracts : Nat → Option α} {annotations : Nat → Option β}
    (history : CaptureMetadataHistory contracts annotations issued) (owner : Nat) (contract : α) (annotation : β) :
    CaptureMetadataHistory
      (fun other => if other = owner then some contract else contracts other)
      (fun other => if other = owner then some annotation else annotations other)
      (issued ++ [Owner.ticket owner]) := by
  constructor
  · intro other value known
    by_cases same : other = owner
    · subst other; exact List.mem_append_right _ List.mem_cons_self
    · exact List.mem_append_left _ (history.contractIssued other value (by simpa only [if_neg same] using known))
  · intro other value known
    by_cases same : other = owner
    · subst other; exact List.mem_append_right _ List.mem_cons_self
    · exact List.mem_append_left _ (history.annotationIssued other value (by simpa only [if_neg same] using known))

/-- Historical allocation freshness supplies both map-absence facts. -/
theorem CaptureMetadataHistory.fresh_none
    (history : CaptureMetadataHistory contracts annotations issued)
    (fresh : Owner.ticket owner ∉ issued) : contracts owner = none ∧ annotations owner = none := by
  constructor
  · cases known : contracts owner with
    | none => rfl
    | some value => exact False.elim (fresh (history.contractIssued owner value known))
  · cases known : annotations owner with
    | none => rfl
    | some value => exact False.elim (fresh (history.annotationIssued owner value known))

theorem CaptureMetadataHistory.allocated_fresh
    (history : CaptureMetadataHistory contracts annotations issued)
    (fresh : (issued ++ [Owner.ticket owner]).Nodup) : contracts owner = none ∧ annotations owner = none := by
  apply history.fresh_none
  intro member
  exact (List.nodup_append.mp fresh).2.2 _ member _ List.mem_cons_self rfl

end Ash.OneShot
#print axioms Ash.OneShot.CaptureMetadataHistory.empty
#print axioms Ash.OneShot.CaptureMetadataHistory.mono
#print axioms Ash.OneShot.CaptureMetadataHistory.insert
#print axioms Ash.OneShot.CaptureMetadataHistory.fresh_none
#print axioms Ash.OneShot.CaptureMetadataHistory.allocated_fresh


namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Historical allocation covers every retained continuation marker, including
dormant and spent markers which do not contribute to current ownership. -/
def TicketHistory (state : RunState) : Prop :=
  ∀ owner, state.machine.stack.erase.ticketNames.count owner ≤ state.issued.count (.ticket owner)

theorem Advance.ticket_name_bound (step : Advance before after discharged) (owner : Nat) :
    after.erase.ticketNames.count owner ≤ before.erase.ticketNames.count owner := by
  cases step <;>
    simp [Stack.erase, ExecFrame.erase, PlainData.erase, HandlerData.erase, CloseItem.frame,
      erase_append, Control.ticketNames, List.count_append, List.count_cons] <;> omega

/-- Ordinary transitions reuse the existing name bound. Lexical unwinding
only removes markers or moves the same captured names onto the active stack. -/
theorem Transition.ticket_name_bound (step : Transition before after created discharged) (owner : Nat) :
    after.stack.erase.ticketNames.count owner ≤
      before.stack.erase.ticketNames.count owner + created.count (.ticket owner) := by
  cases step with
  | evaluate raw allowed => exact (raw_step_name_bounds raw owner 0).1
  | advance localStep => simpa only [Machine.stack, List.count_nil, Nat.add_zero] using localStep.ticket_name_bound owner
  | startCleanup | finishCleanup | discard | finishClose | retireValue | closeValue =>
      simp [Machine.stack, Stack.erase, ExecFrame.erase, ActionData.erase, closeFrame,
        erase_append, Control.ticketNames, List.count_append, List.count_cons] <;> omega

theorem Event.ticket_history (event : Event before after) (history : TicketHistory before) :
    TicketHistory after := by
  cases event with
  | step transition fresh =>
      intro owner
      exact Nat.le_trans (transition.ticket_name_bound owner) (by
        simpa only [List.count_append] using Nat.add_le_add_right (history owner) _)

theorem TicketHistory.fresh_absent (history : TicketHistory state)
    (fresh : Owner.ticket owner ∉ state.issued) : owner ∉ state.machine.stack.erase.ticketNames := by
  have bound := history owner
  have absent : state.issued.count (.ticket owner) = 0 := List.count_eq_zero.mpr fresh
  exact List.count_eq_zero.mp (Nat.eq_zero_of_le_zero (absent ▸ bound))

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.LexicalUnwind.Advance.ticket_name_bound
#print axioms Ash.OneShot.LexicalUnwind.Transition.ticket_name_bound
#print axioms Ash.OneShot.LexicalUnwind.Event.ticket_history
#print axioms Ash.OneShot.LexicalUnwind.TicketHistory.fresh_absent


/-! Preserve source callback interfaces while inserting one actual cleanup.
The new structural judgment checks only the inserted callback's finite operation
requirements at registration. It contains no Local, Pending or Valid premise. -/
namespace Ash.OneShot.SourceScheduledCleanupInterfaces
open SourceDependencyCapture (Scope)
open SourceContextualHints (Hints Requirement checkRequirements)
open SourceRetainedPlans (Forest)
open SourceDeclarationPlans (Plan)
open SourceScheduledCleanupInsertion (Insertion Split Registered)
open SourceScheduledNeutral (OwnerCut)
open SourceScheduledCallbackInterfaces (Interfaces Declared)
open SourceScheduledCallbackRoutes (Covered normalCheck)
open SourceScheduledAdaptationCompilation (RequestFootprint)
open SourceRecursiveRoutes (Closing)

/-- A source registration derivation follows the active insertion path. Only
its leaf checks the callback's operation requirements in the actual suffix. -/
inductive Supplied (needs : List Instance) {dependencies : SourceDependencyAnnotations.Dependencies}
    (callback : Plan dependencies) (required : List Requirement) (outside : Scope) :
    {first second : Scope} → {beforeHints : Hints first} → {afterHints : Hints second} →
    Forest beforeHints → Forest afterHints → Prop where
  | here {hints : Hints scope} {before : Forest hints}
      (supplied : checkRequirements (scope.append outside) required = true) :
      Supplied needs callback required outside before (.cleanup (needs := needs) callback before)
  | plain : Supplied needs callback required outside before after →
      Supplied needs callback required outside (.plain plan before) (.plain plan after)
  | handler : Supplied needs callback required outside before after →
      Supplied needs callback required outside
        (.handler (effect := effect) (table := table) (families := families) (required := handlerRequired) before)
        (.handler (effect := effect) (table := table) (families := families) (required := handlerRequired) after)
  | cell : Supplied needs callback required outside before after →
      Supplied needs callback required outside (.cell (identity := identity) before) (.cell (identity := identity) after)
  | cleanup : Supplied needs callback required outside before after →
      Supplied needs callback required outside (.cleanup (needs := otherNeeds) plan before) (.cleanup (needs := otherNeeds) plan after)
  | running : Supplied needs callback required outside before after →
      Supplied needs callback required outside (.running before) (.running after)
  | live : Supplied needs callback required outside before after →
      Supplied needs callback required outside (.live (owner := owner) saved before) (.live (owner := owner) saved after)
  | spent : Supplied needs callback required outside before after →
      Supplied needs callback required outside (.spent (owner := owner) before) (.spent (owner := owner) after)

theorem Supplied.erase (supplied : Supplied needs callback required outside before after) :
    Insertion needs callback before after := by
  induction supplied with
  | here supplied => exact .here
  | plain next ih => exact .plain ih
  | handler next ih => exact .handler ih
  | cell next ih => exact .cell ih
  | cleanup next ih => exact .cleanup ih
  | running next ih => exact .running ih
  | live next ih => exact .live ih
  | spent next ih => exact .spent ih

theorem Supplied.prefix (front : Forest hints)
    (supplied : Supplied needs callback required outside before after) :
    Supplied needs callback required outside (front.append before) (front.append after) := by
  induction front with
  | nil => exact supplied
  | plain plan rest ih => exact .plain ih
  | handler rest ih => exact .handler ih
  | cell rest ih => exact .cell ih
  | cleanup plan rest ih => exact .cleanup ih
  | running rest ih => exact .running ih
  | live saved rest ihSaved ihRest => exact .live ihRest
  | spent rest ih => exact .spent ih

theorem Supplied.suffix {hints : Hints scope} (tail : Forest hints)
    (supplied : Supplied needs callback required (scope.append outside) before after) :
    Supplied needs callback required outside (before.append tail) (after.append tail) := by
  induction supplied with
  | here checked => exact .here (by simpa only [SourceDependencyChecks.scope_append_assoc] using checked)
  | plain next ih => exact .plain ih
  | handler next ih => exact .handler ih
  | cell next ih => exact .cell ih
  | cleanup next ih => exact .cleanup ih
  | running next ih => exact .running ih
  | live next ih => exact .live ih
  | spent next ih => exact .spent ih

private theorem running_requirements (scope : Scope) :
    checkRequirements (.running scope) required = checkRequirements scope required := by
  simp only [checkRequirements, SourceHandlerRequirements.capability_prepend
    (first := .running scope) (second := scope) (effect := _) (operation := _) rfl]


/-- Callback normal checks depend only on operation capabilities of their
outside receiver, not on neutral protection or owner-history bookkeeping. -/
theorem normal_congr {first second : Scope} {hints : Hints scope} {forest : Forest hints}
    (interfaces : Interfaces forest)
    (same : ∀ effect operation, SourceContextualHints.checkCapability first effect operation =
      SourceContextualHints.checkCapability second effect operation) :
    normalCheck interfaces first = normalCheck interfaces second := by
  induction interfaces generalizing first second with
  | nil => rfl
  | plain next ih | handler next ih | cell next ih | running next ih | spent next ih => exact ih same
  | cleanup rest required footprint next ih =>
      dsimp only [normalCheck]
      rw [running_requirements, running_requirements]
      simp only [checkRequirements, SourceHandlerRequirements.capability_append, same, ih same]
  | live rest saved next ihSaved ihRest =>
      dsimp only [normalCheck]
      rw [ihRest same]
      apply congrArg (fun left => left && normalCheck next second)
      apply ihSaved
      intro effect operation
      simp only [SourceHandlerRequirements.capability_append, same]

theorem normal_running {hints : Hints scope} {forest : Forest hints}
    (interfaces : Interfaces forest) (outside : Scope) :
    normalCheck interfaces outside = normalCheck interfaces (.running outside) :=
  normal_congr interfaces (fun effect operation => (SourceHandlerRequirements.capability_prepend
    (first := .running outside) (second := outside) (effect := effect) (operation := operation) rfl).symm)


/-- Existing callbacks retain their original operation checks when the new
cleanup is in their receiving suffix. The actual plans and interfaces are reused. -/
theorem normal_receiver {hints : Hints scope} {forest : Forest hints}
    (interfaces : Interfaces forest)
    {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    (changed : Insertion needs callback before after) :
    normalCheck interfaces first = normalCheck interfaces second :=
  normal_congr interfaces (fun _ _ => changed.capability)


/-- Generate the complete new callback-interface annotation. Existing source
requirements and coverage are retained; the only new check is the registration
leaf of Supplied, together with the callback's own structural source evidence. -/
theorem Supplied.callbacks {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    {outsideHints : Hints outsideScope} (outside : Forest outsideHints)
    (supplied : Supplied needs callback required outsideScope before after)
    (footprint : RequestFootprint callback required)
    (source : SourceScheduledSourceInterfaces.Declared world (SourcePlanSignatures.signature callback))
    (included : ∀ request ∈ required, request.1 ∈ needs)
    (interfaces : Interfaces before) (declared : Declared world interfaces)
    (covered : Covered interfaces) (normal : normalCheck interfaces outsideScope = true) :
    ∃ next : Interfaces after, Declared world next ∧ Covered next ∧ normalCheck next outsideScope = true := by
  induction supplied with
  | here checked =>
      exact ⟨.cleanup _ required footprint interfaces, .cleanup source declared, .cleanup included covered,
        Bool.and_eq_true_iff.mpr ⟨by simpa only [running_requirements] using checked, normal⟩⟩
  | plain supplied ih => cases interfaces with | plain next =>
      cases declared with | plain declared => cases covered with | plain covered =>
        obtain ⟨next, declared, covered, normal⟩ := ih next declared covered normal
        exact ⟨.plain next, .plain declared, .plain covered, normal⟩
  | handler supplied ih => cases interfaces with | handler next =>
      cases declared with | handler declared => cases covered with | handler covered =>
        obtain ⟨next, declared, covered, normal⟩ := ih next declared covered normal
        exact ⟨.handler next, .handler declared, .handler covered, normal⟩
  | cell supplied ih => cases interfaces with | cell next =>
      cases declared with | cell declared => cases covered with | cell covered =>
        obtain ⟨next, declared, covered, normal⟩ := ih next declared covered normal
        exact ⟨.cell next, .cell declared, .cell covered, normal⟩
  | cleanup supplied ih => cases interfaces with | cleanup rest oldRequired oldFootprint next =>
      cases declared with | cleanup oldSource declared => cases covered with | cleanup oldIncluded covered =>
        obtain ⟨checked, normal⟩ := Bool.and_eq_true_iff.mp normal
        obtain ⟨next, declared, covered, normal⟩ := ih next declared covered normal
        refine ⟨.cleanup _ oldRequired oldFootprint next, .cleanup oldSource declared, .cleanup oldIncluded covered,
          Bool.and_eq_true_iff.mpr ⟨?_, normal⟩⟩
        rw [← (Insertion.running (supplied.erase.suffix outside)).requirements]
        exact checked
  | running supplied ih => cases interfaces with | running next =>
      cases declared with | running declared => cases covered with | running covered =>
        obtain ⟨next, declared, covered, normal⟩ := ih next declared covered normal
        exact ⟨.running next, .running declared, .running covered, normal⟩
  | live supplied ih => cases interfaces with | live rest saved next =>
      cases declared with | live savedDeclared declared => cases covered with | live savedCovered covered =>
        obtain ⟨checked, normal⟩ := Bool.and_eq_true_iff.mp normal
        obtain ⟨next, declared, covered, normal⟩ := ih next declared covered normal
        refine ⟨.live _ saved next, .live savedDeclared declared, .live savedCovered covered,
          Bool.and_eq_true_iff.mpr ⟨?_, normal⟩⟩
        rw [← normal_receiver saved (supplied.erase.suffix outside)]
        exact checked
  | spent supplied ih => cases interfaces with | spent next =>
      cases declared with | spent declared => cases covered with | spent covered =>
        obtain ⟨next, declared, covered, normal⟩ := ih next declared covered normal
        exact ⟨.spent next, .spent declared, .spent covered, normal⟩

/-- A permitted disposal transports the inserted callback's registration check
through closing. Only the existing route guard and declared effect coverage are
used; no destination operation check or callback schedule is assumed. -/
theorem Supplied.forClosing {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    (supplied : Supplied needs callback required outside before after)
    (included : ∀ request ∈ required, request.1 ∈ needs)
    (routes : Closing outward second.shape [] []) :
    Supplied needs callback required outside before.forClosing after.forClosing := by
  induction supplied with
  | here checked =>
      cases routes with
      | cleanup routed tail =>
        apply Supplied.here
        apply List.all_eq_true.mpr
        intro request member
        obtain ⟨target, before, after⟩ := routed request.1 (included request member)
        have same := SourceScheduledCallbackRoutes.capability_same_routes
          (first := _) (second := Scope.forClosing _) (outside := outside) (operation := request.2)
          (by simpa only [List.append_nil] using before)
          (by simpa only [SourceScheduledCallbackRoutes.closing_normal, List.append_nil] using after)
        exact same ▸ List.all_eq_true.mp checked request member
  | plain supplied ih => cases routes with | plain tail => exact ih tail
  | handler supplied ih => cases routes with | handler tail => exact ih tail
  | cell supplied ih => cases routes with | cell tail => exact .cell (ih tail)
  | cleanup supplied ih => cases routes with | cleanup routed tail => exact .cleanup (ih tail)
  | running supplied ih => cases routes with | plain tail => exact .running (ih tail)
  | live supplied ih => cases routes with | live inside tail => exact (Supplied.running (ih tail)).prefix _
  | spent supplied ih => cases routes with | spent tail => exact ih tail

/-- Equivalent outside operation capabilities preserve the registration leaf.
This covers the running and spent bookkeeping introduced by recomposition. -/
theorem Supplied.receiver
    (supplied : Supplied needs callback required first before after)
    (same : ∀ effect operation, SourceContextualHints.checkCapability first effect operation =
      SourceContextualHints.checkCapability second effect operation) :
    Supplied needs callback required second before after := by
  induction supplied with
  | here checked =>
      apply Supplied.here
      apply List.all_eq_true.mpr
      intro request member
      have accepted := List.all_eq_true.mp checked request member
      simpa only [SourceHandlerRequirements.capability_append, ← same] using accepted
  | plain next ih => exact .plain ih
  | handler next ih => exact .handler ih
  | cell next ih => exact .cell ih
  | cleanup next ih => exact .cleanup ih
  | running next ih => exact .running ih
  | live next ih => exact .live ih
  | spent next ih => exact .spent ih

/-- Split registration evidence follows the callback's actual location. An
inside registration receives the waiting suffix; an outside registration does
not add callback code to the saved forest. -/
inductive Separation (needs : List Instance) {dependencies : SourceDependencyAnnotations.Dependencies}
    (callback : Plan dependencies) (required : List Requirement) (outside : Scope) :
    {first tail second nextTail : Scope} → {firstHints : Hints first} → {tailHints : Hints tail} →
    {secondHints : Hints second} → {nextTailHints : Hints nextTail} →
    Forest firstHints → Forest tailHints → Forest secondHints → Forest nextTailHints → Prop where
  | inside {tailHints : Hints tailScope} {tail : Forest tailHints}
      (supplied : Supplied needs callback required (tailScope.append outside) before after) :
      Separation needs callback required outside before tail after tail
  | outside (supplied : Supplied needs callback required outside before after) :
      Separation needs callback required outside saved before saved after

theorem Separation.erase {outside : Scope} (separated : Separation needs callback required outside saved waiting nextSaved nextWaiting) :
    Split needs callback saved waiting nextSaved nextWaiting := by
  cases separated with
  | inside supplied => exact .inside supplied.erase
  | outside supplied => exact .outside supplied.erase

/-- Reuse the actual cut induction while carrying the registration check.
At the insertion leaf, source scope reconstruction supplies the exact suffix. -/
theorem Supplied.cut {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    {savedHints : Hints captured} {waitingHints : Hints tail}
    {saved : Forest savedHints} {waiting : Forest waitingHints}
    (changed : Supplied needs callback required outside before after)
    (cut : SourceScheduledNeutral.Cut effect operation contract modes before saved waiting) :
    ∃ nextCaptured nextTail, ∃ nextSavedHints : Hints nextCaptured, ∃ nextWaitingHints : Hints nextTail,
      ∃ nextSaved : Forest nextSavedHints, ∃ nextWaiting : Forest nextWaitingHints,
        SourceScheduledNeutral.Cut effect operation contract modes after nextSaved nextWaiting ∧
        Separation needs callback required outside saved waiting nextSaved nextWaiting := by
  induction changed generalizing captured tail with
  | here checked =>
      exact ⟨_, _, _, _, _, _, .cleanup cut, .inside (.here
        (by simpa only [cut.erase.reconstruct_scope, SourceDependencyChecks.scope_append_assoc] using checked))⟩
  | plain changed ih => cases cut with
    | plain next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .plain nextCut, .inside (.plain inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .plain nextCut, .outside inserted⟩
  | handler changed ih => cases cut with
    | hit known declared => exact ⟨_, _, _, _, _, _, .hit known declared, .outside changed⟩
    | handler different next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .handler different nextCut, .inside (.handler inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .handler different nextCut, .outside inserted⟩
  | cell changed ih => cases cut with
    | cell different next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .cell different nextCut, .inside (.cell inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .cell different nextCut, .outside inserted⟩
  | cleanup changed ih => cases cut with
    | cleanup next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .cleanup nextCut, .inside (.cleanup inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .cleanup nextCut, .outside inserted⟩
  | running changed ih => cases cut with
    | running next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .running nextCut, .inside (.running inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .running nextCut, .outside inserted⟩
  | live changed ih => cases cut with
    | live next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .live nextCut, .inside (.live inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .live nextCut, .outside inserted⟩
  | spent changed ih => cases cut with
    | spent next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .spent nextCut, .inside (.spent inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .spent nextCut, .outside inserted⟩

/-- Owner decomposition changes no active operation interpretation: lookup
skips the dormant saved forest both before and after consumption. -/
theorem owner_requirements
    {wholeHints : Hints wholeScope} {frontHints : Hints frontScope}
    {savedHints : Hints savedScope} {tailHints : Hints tailScope}
    {whole : Forest wholeHints} {front : Forest frontHints} {saved : Forest savedHints} {tail : Forest tailHints}
    (cut : OwnerCut owner whole front saved tail) :
    checkRequirements (wholeScope.append outside) required =
      checkRequirements (frontScope.append (tailScope.append outside)) required := by
  rw [(SourceContextualInvocationHints.selected_cut cut.found).reconstruct,
    SourceDependencyChecks.scope_append_assoc]
  simp only [Scope.append, checkRequirements, SourceHandlerRequirements.capability_append,
    SourceHandlerRequirements.capability_prepend
      (first := .live owner savedScope (tailScope.append outside)) (second := tailScope.append outside)
      (effect := _) (operation := _) rfl]

/-- Keep the selected owner's exact saved source and split registration evidence
between its caller and waiting suffix, reusing the owner-cut induction. -/
theorem Supplied.owner_cut {frontHints : Hints frontScope} {savedHints : Hints savedScope} {tailHints : Hints tailScope}
    {front : Forest frontHints} {saved : Forest savedHints} {tail : Forest tailHints}
    (changed : Supplied needs callback required outside before after) (cut : SourceScheduledNeutral.OwnerCut owner before front saved tail) :
    ∃ nextFrontScope nextTailScope, ∃ nextFrontHints : Hints nextFrontScope, ∃ nextTailHints : Hints nextTailScope,
    ∃ nextFront : Forest nextFrontHints, ∃ nextTail : Forest nextTailHints,
      SourceScheduledNeutral.OwnerCut owner after nextFront saved nextTail ∧ Separation needs callback required outside front tail nextFront nextTail := by
  induction changed generalizing frontScope tailScope with
  | here checked => exact ⟨_, _, _, _, _, _, .cleanup cut, .inside (.here ((owner_requirements cut) ▸ checked))⟩
  | plain changed ih => cases cut with
    | plain next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .plain nextCut, .inside (.plain inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .plain nextCut, .outside inserted⟩
  | handler changed ih => cases cut with
    | handler next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .handler nextCut, .inside (.handler inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .handler nextCut, .outside inserted⟩
  | cell changed ih => cases cut with
    | cell next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .cell nextCut, .inside (.cell inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .cell nextCut, .outside inserted⟩
  | cleanup changed ih => cases cut with
    | cleanup next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .cleanup nextCut, .inside (.cleanup inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .cleanup nextCut, .outside inserted⟩
  | running changed ih => cases cut with
    | running next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .running nextCut, .inside (.running inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .running nextCut, .outside inserted⟩
  | live changed ih => cases cut with
    | hit => exact ⟨_, _, _, _, _, _, .hit, .outside changed⟩
    | live different next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .live different nextCut, .inside (.live inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .live different nextCut, .outside inserted⟩
  | spent changed ih => cases cut with
    | spent next =>
        obtain ⟨_, _, _, _, _, _, nextCut, pieces⟩ := ih next
        cases pieces with
        | inside inserted => exact ⟨_, _, _, _, _, _, .spent nextCut, .inside (.spent inserted)⟩
        | outside inserted => exact ⟨_, _, _, _, _, _, .spent nextCut, .outside inserted⟩

/-- Closing the saved piece preserves registration evidence using its own
route guard. The waiting piece gains only the existing running bookkeeping. -/
theorem Separation.forClosing {outside : Scope}
    {nextSavedHints : Hints nextSavedScope} {nextSaved : Forest nextSavedHints}
    (separated : Separation needs callback required outside saved waiting nextSaved nextWaiting)
    (included : ∀ request ∈ required, request.1 ∈ needs)
    (routes : Closing outward nextSavedScope.shape [] []) :
    Separation needs callback required outside saved.forClosing (.running waiting)
      nextSaved.forClosing (.running nextWaiting) := by
  cases separated with
  | inside supplied =>
      apply Separation.inside
      apply (supplied.forClosing included routes).receiver
      intro effect operation
      exact (SourceHandlerRequirements.capability_prepend
        (first := .running _) (second := _) (effect := effect) (operation := operation) rfl).symm
  | outside supplied => exact .outside (.running supplied)

theorem Separation.spent_append {outside : Scope}
    (separated : Separation needs callback required outside front tail nextFront nextTail) :
    Supplied needs callback required outside (front.append (.spent (owner := owner) tail))
      (nextFront.append (.spent (owner := owner) nextTail)) := by
  cases separated with
  | inside supplied =>
      apply Supplied.suffix
      apply supplied.receiver
      intro effect operation
      exact (SourceHandlerRequirements.capability_prepend
        (first := .spent owner _) (second := _) (effect := effect) (operation := operation) rfl).symm
  | outside supplied => exact (Supplied.spent supplied).prefix _

theorem Separation.resumed {outside : Scope}
    (separated : Separation needs callback required outside front tail nextFront nextTail) (saved : Forest hints) :
    Supplied needs callback required outside (saved.append (front.append (.spent (owner := owner) tail)))
      (saved.append (nextFront.append (.spent (owner := owner) nextTail))) :=
  separated.spent_append.prefix saved

theorem Separation.disposed {outside : Scope}
    (separated : Separation needs callback required outside front tail nextFront nextTail) (saved : Forest hints) :
    Supplied needs callback required outside (saved.forClosing.append (.running (front.append (.spent (owner := owner) tail))))
      (saved.forClosing.append (.running (nextFront.append (.spent (owner := owner) nextTail)))) :=
  (Supplied.running separated.spent_append).prefix saved.forClosing

/-- Preserve callback source declarations, coverage and all normal checks in
the selected saved piece. Outside insertion changes only its receiving suffix. -/
theorem Separation.callbacks
    {savedHints : Hints savedScope} {waitingHints : Hints waitingScope}
    {nextSavedHints : Hints nextSavedScope} {nextWaitingHints : Hints nextWaitingScope}
    {saved : Forest savedHints} {waiting : Forest waitingHints}
    {nextSaved : Forest nextSavedHints} {nextWaiting : Forest nextWaitingHints}
    {outsideHints : Hints outsideScope} (outside : Forest outsideHints)
    (separated : Separation needs callback required outsideScope saved waiting nextSaved nextWaiting)
    (footprint : RequestFootprint callback required)
    (source : SourceScheduledSourceInterfaces.Declared world (SourcePlanSignatures.signature callback))
    (included : ∀ request ∈ required, request.1 ∈ needs)
    (interfaces : Interfaces saved) (declared : Declared world interfaces)
    (covered : Covered interfaces) (normal : normalCheck interfaces (waitingScope.append outsideScope) = true) :
    ∃ next : Interfaces nextSaved, Declared world next ∧ Covered next ∧
      normalCheck next (nextWaitingScope.append outsideScope) = true := by
  cases separated with
  | inside supplied => exact supplied.callbacks (waiting.append outside) footprint source included interfaces declared covered normal
  | outside supplied =>
      exact ⟨interfaces, declared, covered, (normal_receiver interfaces (supplied.erase.suffix outside)) ▸ normal⟩

/-- Generate the closing annotation after insertion and splitting. The only
new closing input is the primitive route judgment for the selected saved scope;
all callback source interfaces and operation checks come from the original side. -/
theorem Separation.closing_annotation
    [declarations : SourceScheduledCapabilityAnnotations.DeclarationPolicy]
    (legacy : ∀ {clauses families required} {plans : SourceDeclarationPlans.ClausePlans clauses families},
      SourcePlannedRecipeDeclarations.Declarations required plans → declarations.accepts required plans)
    {savedHints : Hints savedScope} {waitingHints : Hints waitingScope}
    {nextSavedHints : Hints nextSavedScope} {nextWaitingHints : Hints nextWaitingScope}
    {saved : Forest savedHints} {waiting : Forest waitingHints}
    {nextSaved : Forest nextSavedHints} {nextWaiting : Forest nextWaitingHints}
    {outsideHints : Hints outsideScope} (outside : Forest outsideHints)
    (separated : Separation needs callback required outsideScope saved waiting nextSaved nextWaiting)
    (footprint : RequestFootprint callback required)
    (source : SourceScheduledSourceInterfaces.Declared world (SourcePlanSignatures.signature callback))
    (included : ∀ request ∈ required, request.1 ∈ needs)
    (interfaces : Interfaces saved) (declared : Declared world interfaces)
    (covered : Covered interfaces) (normal : normalCheck interfaces (waitingScope.append outsideScope) = true)
    (routes : Closing outward nextSavedScope.shape [] []) :
    ∃ annotation : SourceScheduledCapabilityAnnotations.Retained world nextSaved.forClosing (nextWaiting.append outside),
      annotation.Valid outward actions phases := by
  obtain ⟨next, nextDeclared, nextCovered, nextNormal⟩ :=
    separated.callbacks outside footprint source included interfaces declared covered normal
  exact SourceScheduledCallbackRoutes.closing_annotation legacy next nextDeclared nextCovered routes nextNormal


theorem Insertion.held {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    (changed : Insertion needs callback before after) : first.held = second.held := by
  induction changed <;> simp_all [Scope.held]

theorem Insertion.pending_within {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    (changed : Insertion needs callback before after)
    (bounded : SourceDependencyOwners.PendingWithin world owned first) :
    SourceDependencyOwners.PendingWithin world owned second := by
  obtain ⟨front, tail, firstSame, secondSame⟩ := changed.location
  rw [firstSame] at bounded
  rw [secondSame]
  exact SourceCleanupClosingInsertion.pending_within front bounded

/-- Cleanup insertion preserves selected modes and permissions. Only the
closing-route judgment for a disposing capture is new. Owner bounds transfer
separately, without supplying or changing any continuation right. -/
theorem Separation.capture_guard
    {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    {savedHints : Hints savedScope} {waitingHints : Hints waitingScope}
    {nextSavedHints : Hints nextSavedScope} {nextWaitingHints : Hints nextWaitingScope}
    {saved : Forest savedHints} {waiting : Forest waitingHints}
    {nextSaved : Forest nextSavedHints} {nextWaiting : Forest nextWaitingHints}
    (oldCut : SourceScheduledNeutral.Cut effect operation contract modes before saved waiting)
    (nextCut : SourceScheduledNeutral.Cut effect operation contract modes after nextSaved nextWaiting)
    (separated : Separation needs callback required outsideScope saved waiting nextSaved nextWaiting)
    (guarded : SourceDependencyCapture.checkCapture outward first effect operation = true)
    (routes : contract.dispose = true → Closing outward nextSavedScope.shape [] []) :
    SourceDependencyCapture.checkCapture outward second effect operation = true := by
  have held : savedScope.held = nextSavedScope.held := by
    cases separated with
    | inside supplied => exact Insertion.held supplied.erase
    | outside supplied => rfl
  apply SourceDependencyCapture.check_capture_iff.mpr
  cases SourceDependencyCapture.check_capture_iff.mp guarded with
  | builtin found => cases Option.some.inj (oldCut.erase.lookup.symm.trans found)
  | handler found permission row body closing =>
      cases Option.some.inj (oldCut.erase.lookup.symm.trans found)
      exact .handler nextCut.erase.lookup (held ▸ permission) (held ▸ row) (held ▸ body) routes

theorem Separation.pending_within
    {savedHints : Hints savedScope} {waitingHints : Hints waitingScope}
    {nextSavedHints : Hints nextSavedScope} {nextWaitingHints : Hints nextWaitingScope}
    {saved : Forest savedHints} {waiting : Forest waitingHints}
    {nextSaved : Forest nextSavedHints} {nextWaiting : Forest nextWaitingHints}
    (separated : Separation needs callback required outsideScope saved waiting nextSaved nextWaiting)
    (bounded : SourceDependencyOwners.PendingWithin world (SourceDependencyOwners.owners savedScope) savedScope) :
    SourceDependencyOwners.PendingWithin world (SourceDependencyOwners.owners nextSavedScope) nextSavedScope := by
  cases separated with
  | inside supplied =>
      rw [← supplied.erase.owners]
      exact Insertion.pending_within supplied.erase bounded
  | outside supplied => exact bounded

/-- The selected-request branch of cleanup transport generates a new validated
annotation from original source interfaces. It derives normal callback checks,
owner bounds, protection and selected-mode checks. The required new finite route
condition is explicit; a successful target request or closing schedule is not. -/
theorem Separation.request_annotation
    [declarations : SourceScheduledCapabilityAnnotations.DeclarationPolicy]
    (legacy : ∀ {clauses families required} {plans : SourceDeclarationPlans.ClausePlans clauses families},
      SourcePlannedRecipeDeclarations.Declarations required plans → declarations.accepts required plans)
    {beforeHints : Hints first} {afterHints : Hints second}
    {before : Forest beforeHints} {after : Forest afterHints}
    {savedHints : Hints savedScope} {waitingHints : Hints waitingScope}
    {nextSavedHints : Hints nextSavedScope} {nextWaitingHints : Hints nextWaitingScope}
    {saved : Forest savedHints} {waiting : Forest waitingHints}
    {nextSaved : Forest nextSavedHints} {nextWaiting : Forest nextWaitingHints}
    (oldCut : SourceScheduledNeutral.Cut effect operation contract modes before saved waiting)
    (nextCut : SourceScheduledNeutral.Cut effect operation contract modes after nextSaved nextWaiting)
    (separated : Separation needs callback required .nil saved waiting nextSaved nextWaiting)
    (footprint : RequestFootprint callback required)
    (source : SourceScheduledSourceInterfaces.Declared world (SourcePlanSignatures.signature callback))
    (included : ∀ request ∈ required, request.1 ∈ needs)
    (interfaces : Interfaces saved) (declared : Declared world interfaces) (covered : Covered interfaces)
    (normal : normalCheck interfaces waitingScope = true)
    (guarded : SourceDependencyCapture.checkCapture outward first effect operation = true)
    (bounded : contract.dispose = true → SourceDependencyOwners.PendingWithin world
      (SourceDependencyOwners.owners savedScope) savedScope)
    (routes : contract.dispose = true → Closing outward nextSavedScope.shape [] []) :
    ∃ annotation : SourceScheduledCapabilityAnnotations.Code world
      (.request (effect := effect) (operation := operation)) after,
      annotation.Valid outward actions phases := by
  obtain ⟨next, nextDeclared, nextCovered, nextNormal⟩ := separated.callbacks .nil footprint source included
    interfaces declared covered (by simpa only [SourceDependencyProjection.scope_append_nil] using normal)
  apply SourceScheduledCallbackRoutes.request_annotation legacy nextCut next nextDeclared nextCovered
    (separated.capture_guard oldCut nextCut guarded routes)
    (fun disposes => separated.pending_within (bounded disposes))
  intro _
  rw [← normal_running]
  simpa only [SourceDependencyProjection.scope_append_nil] using nextNormal

namespace Examples
open SourceCleanupClosingInsertion.Examples

/-- Generate the selected request after registering an effectful cleanup. The
old saved source has no callback; the new source interfaces and closing schedule
are produced by the transport theorem, rather than supplied by this example. -/
theorem inserted_request_generated :
    ∃ annotation : SourceScheduledCapabilityAnnotations.Code [4]
      (.request (effect := disposingEffect) (operation := 0))
      (.cleanup (needs := [callbackEffect])
        (.request (effect := callbackEffect) (operation := 0)) retainedForest),
      annotation.Valid [] actions phases := by
  apply Separation.request_annotation (fun checked => checked)
    (SourceScheduledNeutral.Cut.cell (by decide) (.hit rfl rfl))
    (.cleanup (.cell (by decide) (.hit rfl rfl)))
    (.inside (.here rfl)) .request .request
    (by intro request member; cases List.mem_singleton.mp member; exact List.mem_cons_self)
    (.cell (.handler .nil)) (.cell (.handler .nil)) (.cell (.handler .nil))
    rfl rfl (fun _ => .cell (.handler .nil))
  intro _
  exact SourceDependencyCapture.check_closing_iff.mp rfl

/-- Registration alone cannot admit a later disposal. Reuse the removed-handler
counterexample: its original operation check passes, but closing loses the
interpretation required by the newly registered callback. -/
theorem registration_does_not_grant_disposal :
    Supplied [callbackEffect] (.request (effect := callbackEffect) (operation := 0)) [(callbackEffect, 0)]
      .nil removedForest (.cleanup (needs := [callbackEffect]) (.request (effect := callbackEffect) (operation := 0)) removedForest) ∧
      SourceDependencyCapture.checkCapture []
        (.cleanup [callbackEffect] (.request callbackEffect 0) removedReceiver) disposingEffect 0 = false :=
  ⟨.here rfl, available_callback_rejected.2.2⟩

/-- Insertion preserves a pre-existing dormant effectful callback and discards
its unrelated plain owner invocation only when constructing the closing forest.
This establishes callback generation, not admission of the whole normal state. -/
theorem dormant_callbacks_preserved :
    ∃ annotation : SourceScheduledCapabilityAnnotations.Retained [4]
      (Forest.cleanup (needs := [callbackEffect]) (.request (effect := callbackEffect) (operation := 0))
        SourceScheduledCallbackRoutes.Examples.dormant).forClosing
      SourceScheduledCallbackRoutes.Examples.waiting,
      annotation.Valid [SourceDependencyCapture.Examples.effectF] actions phases := by
  let registered : Supplied [callbackEffect] (.request (effect := callbackEffect) (operation := 0)) [(callbackEffect, 0)]
      (.handler SourceDependencyCapture.Examples.effectF
        SourceDependencyCapture.Examples.resumeTable SourceDependencyCapture.Examples.resumeDependencies .nil)
      SourceScheduledCallbackRoutes.Examples.dormant
      (.cleanup (needs := [callbackEffect]) (.request (effect := callbackEffect) (operation := 0)) SourceScheduledCallbackRoutes.Examples.dormant) := .here rfl
  obtain ⟨next, declared, covered, normal⟩ := registered.callbacks SourceScheduledCallbackRoutes.Examples.waiting
    .request .request
    (by intro request member; cases List.mem_singleton.mp member; exact List.mem_cons_self)
    SourceScheduledCallbackRoutes.Examples.dormantInterface
    (.live (.plain (.cleanup .request .nil)) (.cell .nil))
    (.live (.plain (.cleanup (by intro request member; cases List.mem_singleton.mp member; exact List.mem_cons_self) .nil)) (.cell .nil)) rfl
  apply SourceScheduledCallbackRoutes.closing_annotation (fun checked => checked) next declared covered _ normal
  exact SourceDependencyCapture.check_closing_iff.mp (by decide)

end Examples

