theorem Auth.ready_discard_accounting
    {current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.discard binder) result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows current resultRows rows)
    (resolved : runtimeScope.resolve binder = some owner)
    (checked : Accounting.Run world installations rows context (root : Requirements demandRoot)) :
    Accounting.Run world installations (Rows.invoke (key := ⟨owner, .dispose⟩)) context root := by
