  · intro impossible; cases impossible
  · intro impossible; cases impossible
  · exact RequestBudget.nonconsuming rfl rfl
  · exact .selected (.spent .here) .ordinary
  · exact .spent .here
  · rfl
  · exact .spent (.handler .nil)
