open SourcePlanSignatures (clauseSignatures)
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Registry installation preserves the exact authenticated clause-row witness
when constructing the physical handler frame. -/
theorem FrameRows.handler_install
    (data : HandlerData)
    {plans : ClausePlans data.clauses clauseDependencies}
    {declarationRows : ClauseRows (clauseSignatures plans)}
    {hints : ReturnHints scope} (tail : Context hints)
    {declarations : SourcePlannedSources.Declarations operations policy contracts world (fun _ => none)
      residual data.effectInst answer data.clauses table plans}
    (authenticated : AuthDeclarations operations policy ports owners emptyRows answerRows declarations declarationRows)
    (scopeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports data.scope)
    (annotation : answer.erase.erase.port = ScopedPorts.eraseType data.answer)
    (clauses : ScopedPorts.ClausesTyped operations.erase.erase.ports world
      SourceDependencyAnnotations.Environment.empty.erase.ports data.effectInst answer.erase.erase.port residual data.clauses)
    (coverage : ScopedPorts.Covers operations.erase.erase.ports data.effectInst data.clauses)
    (unique : (ScopedTyping.clauseKeys data.clauses).Nodup)
    (recipes : declarationPolicy.accepts outward needed plans)
    (capabilities : ClausesUse policy data.clauses)
    (modes : SourceTemplates.ClauseModes data.clauses table)
    (certified : SourcePlannedChecks.CertifiedClauses (evidence := declarationPolicy) outward world plans)
    (tableInstalled : tables data = table)
    (familiesInstalled : families data = clauseDependencies)
    (requiredInstalled : required data = needed) :
    ∃ decorate, ∃ frame : CertifiedFrame (evidence := declarationPolicy.accepts outward)
      operations policy contracts tables families required outward world (.handler data)
      answer answer [] (.request [] []) (.handler data.effectInst table clauseDependencies) decorate
      (data.effectInst :: residual) residual,
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        frame answerRows answerRows tail (.handler (effect := data.effectInst) (table := table) data.activation declarationRows tail) := by
  subst table
  subst clauseDependencies
  subst needed
  exact ⟨_, _, FrameRows.handler authenticated (scopeKnown := scopeKnown)
    (annotation := annotation) (clauses := clauses) (coverage := coverage) (unique := unique)
    (recipes := recipes) (capabilities := capabilities) (modes := modes) (certified := certified)⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.FrameRows.handler_install

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDeclarationPlans (Plan ClausePlans)
open SourcePlanSignatures (signature clauseSignatures)
open SourcePlannedChecks (Certified)
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)

/-- Handler installation retains the actual authenticated body and clause rows.
This source connection does not assume the legacy installation-forest check. -/
theorem Admitted.install_handler
    {plans : ClausePlans priorArms clauseDependencies} {bodyPlan : Plan bodyDependencies}
    {declarationSignature : SourcePlanSignatures.ClauseSignatures clauseDependencies}
    {declarationRows : ClauseRows declarationSignature} {bodyRows : Rows (signature bodyPlan)}
    {hints : ReturnHints receiving} {context : Context hints}
    (current : Admitted operations policy contracts ports owners (fun _ => none) emptyRows
      world history allowed outward runtimeScope actions phases budget tables families context stack
      (.handle (Instantiation.freezeEffect effect) code arms) result currentDemand currentRequirements
      (.handler (effect := effect) (table := table) needed declarationSignature (signature bodyPlan)) resultRows
      (.handler declarationRows bodyRows))
    (certified : Certified (evidence := declarationPolicy) outward world
      (.handler (effect := effect) (table := table) needed plans bodyPlan))
    (signatureSame : clauseSignatures plans = declarationSignature)
    (scopeTyped : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value result) output pendingDemand pendingRequirements receiving)
    (coherent : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      pending (.value resultRows) outputRows context)
    (pendingBudget : PendingBudget budget phases world history context .nil .ordinary output.mode)
    (installed : stack.erase.activations ⊆ history) :
    ∃ handler : HandlerData, ∃ nextTables nextFamilies nextRequired residual,
    ∃ bodyRequirements : Requirements currentDemand, ∃ nextRequirements : Requirements pendingDemand,
    ∃ nextPending : PlannedModeSource operations policy contracts nextTables nextFamilies nextRequired outward actions world
      (.push (.handler handler) stack) (.value result) output pendingDemand nextRequirements
      (.handler effect table clauseDependencies receiving),
      handler.activation ∉ history ∧ handler.scope = runtimeScope ∧ handler.effectInst = effect ∧ handler.clauses = arms ∧
      nextTables handler = table ∧ nextFamilies handler = clauseDependencies ∧ nextRequired handler = needed ∧
      (∀ old, old.activation ∈ stack.erase.activations →
        tables old = nextTables old ∧ families old = nextFamilies old ∧ required old = nextRequired old) ∧
      currentRequirements = bodyRequirements.prepend [.ordinary (.handler effect 0 table)] ∧
      nextRequirements = .sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack nextTables stack)) pendingRequirements ∧
      Admitted operations policy contracts ports owners (fun _ => none) emptyRows
        world (history ++ [handler.activation]) (effect :: residual) outward runtimeScope actions phases budget
        nextTables nextFamilies (.handler (effect := effect) (table := table) handler.activation declarationRows context) (.push (.handler handler) stack)
        code result currentDemand bodyRequirements (signature bodyPlan) resultRows bodyRows ∧
      Certified (evidence := declarationPolicy) outward world bodyPlan ∧
      PendingRows operations policy contracts nextTables nextFamilies nextRequired outward actions world ports owners emptyRows
        nextPending (.value resultRows) outputRows (.handler (effect := effect) (table := table) handler.activation declarationRows context) ∧
      PendingBudget budget phases world (history ++ [handler.activation])
        (.handler (effect := effect) (table := table) handler.activation declarationRows context) .nil .ordinary output.mode ∧
      RawStep ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩
        ⟨code, runtimeScope, .push (.handler handler) stack⟩ [] [] := by
  rcases current with ⟨source, authenticated, localCheck, cleanupBudget, contextSource⟩
  generalize frozen : Instantiation.freezeEffect effect = syntaxEffect at source authenticated
  cases authenticated with
  | handler bodyAuth declarationsAuth =>
    rename_i residual admitted capabilities unique bodyReq coverage clauses modes actual actualRows declarations body
    cases certified with | handler recipes clausesCertified bodyCertified =>
      have actualRecipes := ClauseDeclarations.signature_congr recipes signatureSame
      have actualCertified := certified_clause_signatures clausesCertified signatureSame
      obtain ⟨activation, fresh⟩ := ScopedTyping.fresh_world_name history
      let handler : HandlerData := ⟨activation, effect, arms, runtimeScope,
        ScopedPorts.embedPort result.erase.erase.port, ScopedPorts.clauses_have_ticket_barrier clauses⟩
      let nextTables := RecursiveHandlerTables.register tables activation table
      let nextFamilies : SourceDependencyFrames.Families := fun old => if old.activation = activation then clauseDependencies else families old
      let nextRequired : SourceContextualRechecking.Required := fun old => if old.activation = activation then needed else required old
      have tableInstalled : nextTables handler = table := RecursiveHandlerTables.registered_lookup rfl
      have familiesInstalled : nextFamilies handler = clauseDependencies := by simp [nextFamilies, handler]
      have requiredInstalled : nextRequired handler = needed := by simp [nextRequired, handler]
      have tablesAgree : ∀ old, old.activation ∈ stack.erase.activations → tables old = nextTables old :=
        RecursiveHandlerTables.register_agrees (fun member => fresh (installed member))
      have familiesAgree : ∀ old, old.activation ∈ stack.erase.activations → families old = nextFamilies old := by
        intro old member
        have different : old.activation ≠ activation := fun same => fresh (same ▸ installed member)
        simp [nextFamilies, different]
      have requiredAgree : ∀ old, old.activation ∈ stack.erase.activations → required old = nextRequired old := by
        intro old member
        have different : old.activation ≠ activation := fun same => fresh (same ▸ installed member)
        simp [nextRequired, different]
      have moved := coherent.registries tablesAgree familiesAgree requiredAgree
      obtain ⟨decorate, frame, frameRows⟩ := FrameRows.handler_install
        handler context declarationsAuth scopeTyped
        (by simp only [handler, ScopedPorts.erase_embed_port]) clauses coverage unique actualRecipes capabilities modes actualCertified
        tableInstalled familiesInstalled requiredInstalled
      have nextCoherent := PendingRows.push (ModeFrameRows.ordinary frameRows) moved
      cases localCheck with | handler bodyChecked =>
        cases cleanupBudget with | handler bodyBudget =>
          have bodyHistory : activation :: history ⊆ history ++ [activation] := by
            intro name member
            rcases List.mem_cons.mp member with same | old
            · exact same ▸ List.mem_append_right _ List.mem_cons_self
            · exact List.mem_append_left _ old
          refine ⟨handler, nextTables, nextFamilies, nextRequired, residual, bodyReq, _, _,
            fresh, rfl, rfl, rfl, tableInstalled, familiesInstalled, requiredInstalled,
            (fun old member => ⟨tablesAgree old member, familiesAgree old member, requiredAgree old member⟩),
            rfl, rfl, ?_, bodyCertified, nextCoherent, ?_, .enterHandler handler code stack⟩
          · exact ⟨body, bodyAuth, bodyChecked, (bodyBudget activation fresh).installations_mono bodyHistory,
              nextCoherent.source⟩
          · exact .handler (pendingBudget.installations_mono (List.subset_append_left _ _))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.install_handler

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements evaluate evaluateFuel)
open OwnerPhaseTransitions (spend spendAll)
private def stripSpent (freshOwner : Nat) (context : OwnerPhases.Context) : OwnerPhases.Context :=
  context.filter (fun entry => entry != .spent freshOwner)

private theorem stripSpent_append (first second : OwnerPhases.Context) :
    stripSpent freshOwner (first ++ second) = stripSpent freshOwner first ++ stripSpent freshOwner second := List.filter_append first second

private theorem export_append (first second : OwnerPhases.Context) phases raw :
    OwnerSource.exportAt (first ++ second) phases raw =
      (OwnerSource.exportAt first phases raw).bind (OwnerSource.exportAt second phases) := by
  simp only [OwnerSource.exportAt, OwnerPhaseTransitions.project_append, residual_append]
  cases residualize (OwnerPhaseTransitions.project first phases) raw <;> rfl

private theorem export_stripSpent freshOwner (context : OwnerPhases.Context) phases raw :
    OwnerSource.exportAt (stripSpent freshOwner context) phases raw = OwnerSource.exportAt context phases raw := by
  induction context generalizing raw with
  | nil => rfl
  | cons entry rest ih =>
      by_cases plain : entry = .spent freshOwner
      · subst entry
        simpa only [stripSpent, List.filter_cons, bne_self_eq_false, Bool.false_eq_true, if_false,
          OwnerSource.exportAt, OwnerPhaseTransitions.project] using ih (raw := raw)
      · have same : stripSpent freshOwner (entry :: rest) = entry :: stripSpent freshOwner rest := by simp [stripSpent, plain]
        rw [same]
        change OwnerSource.exportAt ([entry] ++ stripSpent freshOwner rest) phases raw = OwnerSource.exportAt ([entry] ++ rest) phases raw
        rw [export_append, export_append]
        cases OwnerSource.exportAt [entry] phases raw <;> simp only [Option.bind_none, Option.bind_some, ih]

private theorem export_strip_congr (same : stripSpent freshOwner first = stripSpent freshOwner second) phases raw :
    OwnerSource.exportAt first phases raw = OwnerSource.exportAt second phases raw := by
  exact (export_stripSpent freshOwner first phases raw).symm.trans
    ((congrArg (fun context => OwnerSource.exportAt context phases raw) same).trans
      (export_stripSpent freshOwner second phases raw))

private theorem empty_evaluateFuel_congr (requirements : Requirements demand)
    (same : stripSpent freshOwner first = stripSpent freshOwner second) fuel phases :
    evaluateFuel fuel [] first phases requirements = evaluateFuel fuel [] second phases requirements := by
  induction requirements generalizing phases with
  | request nearer raw =>
      simp only [evaluateFuel]
      exact export_strip_congr (freshOwner := freshOwner) (first := nearer ++ first) (second := nearer ++ second)
        (by simp only [stripSpent_append, same]) phases raw
  | retire | spent => simp only [evaluateFuel]
  | invoke key demand nearer => cases fuel <;> simp only [evaluateFuel, RecursiveRequirements.lookup]
  | sequence left right ihLeft ihRight => simp only [evaluateFuel, ihLeft, ihRight]
  | emitAfter body nearer raw ih =>
      simp only [evaluateFuel, ih]
      rw [export_strip_congr (freshOwner := freshOwner) (first := nearer ++ first) (second := nearer ++ second)
        (by simp only [stripSpent_append, same])]
  | choice left right aligned ihLeft ihRight => simp only [evaluateFuel, ihLeft, ihRight]

private theorem empty_evaluate_congr (requirements : Requirements demand)
    (same : stripSpent freshOwner first = stripSpent freshOwner second) phases :
    evaluate [] first phases requirements = evaluate [] second phases requirements :=
  empty_evaluateFuel_congr requirements same _ phases


private theorem empty_request : evaluate [] receiving phases (.request nearer raw) =
    OwnerSource.exportAt (nearer ++ receiving) phases raw := by
  simp only [evaluate, evaluateFuel]

private inductive MetaSpent (freshOwner : Nat) : {firstScope secondScope : SourceDependencyCapture.Scope} →
    CleanupHints.Metadata firstScope → CleanupHints.Metadata secondScope → Prop where
  | same (metadata) : MetaSpent freshOwner metadata metadata
  | add (related : MetaSpent freshOwner first second) : MetaSpent freshOwner first (.spent (owner := freshOwner) second)
  | plain (related : MetaSpent freshOwner first second) : MetaSpent freshOwner (.plain (dependencies := dependencies) first) (.plain (dependencies := dependencies) second)
  | handler (related : MetaSpent freshOwner first second) : MetaSpent freshOwner
      (.handler (effect := effect) (table := table) (families := families) activation first) (.handler (effect := effect) (table := table) (families := families) activation second)
  | cell (related : MetaSpent freshOwner first second) : MetaSpent freshOwner (.cell (identity := identity) first) (.cell (identity := identity) second)
  | cleanup (related : MetaSpent freshOwner first second) : MetaSpent freshOwner
      (.cleanup (needs := needs) (callback := callback) latent first) (.cleanup (needs := needs) (callback := callback) latent second)
  | retiring (related : MetaSpent freshOwner first second) : MetaSpent freshOwner (.retiring owner first) (.retiring owner second)
  | live (saved : CleanupHints.Metadata savedScope) (related : MetaSpent freshOwner first second) :
      MetaSpent freshOwner (.live (owner := owner) saved first) (.live (owner := owner) saved second)
  | spent (related : MetaSpent freshOwner first second) : MetaSpent freshOwner (.spent (owner := owner) first) (.spent (owner := owner) second)

private theorem MetaSpent.contexts (related : MetaSpent freshOwner first second) :
    stripSpent freshOwner first.context = stripSpent freshOwner second.context := by
  induction related <;> simp_all [CleanupHints.Metadata.context, stripSpent, List.filter_cons]


/-- Proof-only insertion of one consumed owner's spent markers on the active
lexical spine. Actual row decorations and saved contexts are retained. -/
inductive SpentHistory (freshOwner : Nat) : {firstScope secondScope : SourceDependencyCapture.Scope} →
    {firstHints : ReturnHints firstScope} → {secondHints : ReturnHints secondScope} →
    Context firstHints → Context secondHints → Prop where
  | same (context) : SpentHistory freshOwner context context
  | add (related : SpentHistory freshOwner first second) : SpentHistory freshOwner first (.spent (owner := freshOwner) second)
  | plain (rows : Rows checking) (related : SpentHistory freshOwner first second) : SpentHistory freshOwner (.plain rows first) (.plain rows second)
  | handler (rows : ClauseRows declarations) (related : SpentHistory freshOwner first second) : SpentHistory freshOwner
      (.handler (effect := effect) (table := table) activation rows first)
      (.handler (effect := effect) (table := table) activation rows second)
  | cell (related : SpentHistory freshOwner first second) : SpentHistory freshOwner (.cell (identity := identity) first) (.cell (identity := identity) second)
  | cleanup (rows : Rows checking) (related : SpentHistory freshOwner first second) : SpentHistory freshOwner
      (.cleanup (needs := needs) latent rows first) (.cleanup (needs := needs) latent rows second)
  | normal (related : SpentHistory freshOwner first second) : SpentHistory freshOwner (.normal first) (.normal second)
  | unwinding (related : SpentHistory freshOwner first second) : SpentHistory freshOwner (.unwinding first) (.unwinding second)
  | closing (related : SpentHistory freshOwner first second) : SpentHistory freshOwner (.closing first) (.closing second)
  | retiring (related : SpentHistory freshOwner first second) : SpentHistory freshOwner (.retiring owner first) (.retiring owner second)
  | live (saved : Context savedHints) (related : SpentHistory freshOwner first second) :
      SpentHistory freshOwner (.live (resumeDemand := resumeDemand) (owner := owner) saved first) (.live (resumeDemand := resumeDemand) (owner := owner) saved second)
  | spent (related : SpentHistory freshOwner first second) : SpentHistory freshOwner (.spent (owner := owner) first) (.spent (owner := owner) second)


theorem SpentHistory.hints {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : SpentHistory freshOwner first second) :
    SourceDependencyNeutral.Lexical.Recursive.History firstHints secondHints := by
  induction related with
  | same => exact .refl
  | add related ih => exact .history ih
  | plain rows related ih => exact .plain ih
  | handler rows related ih => exact .handler ih
  | cell related ih => exact .cell ih
  | cleanup rows related ih => exact .cleanup ih
  | normal related ih | unwinding related ih | closing related ih | retiring related ih => exact .running ih
  | live saved related ih => exact .live ih
  | spent related ih => exact .spent ih

private theorem SpentHistory.contexts (related : SpentHistory freshOwner first second) :
    stripSpent freshOwner first.context = stripSpent freshOwner second.context := by
  induction related <;> simp_all [Context.context, stripSpent, List.filter_cons]

theorem SpentHistory.prefix (front : Context prefixHints) (related : SpentHistory freshOwner first second) :
    SpentHistory freshOwner (front.append first) (front.append second) := by
  induction front with
  | nil => exact related
  | plain rows tail ih => exact .plain rows ih
  | handler activation rows tail ih => exact .handler rows ih
  | cell tail ih => exact .cell ih
  | cleanup latent rows tail ih => exact .cleanup rows ih
  | normal tail ih => exact .normal ih
  | unwinding tail ih => exact .unwinding ih
  | closing tail ih => exact .closing ih
  | retiring owner tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live saved ihTail
  | spent tail ih => exact .spent ih

theorem SpentHistory.append (first : SpentHistory freshOwner a b) (second : SpentHistory freshOwner c d) :
    SpentHistory freshOwner (a.append c) (b.append d) := by
  induction first with
  | same context => exact second.prefix context
  | add related ih => exact .add ih
  | plain rows related ih => exact .plain rows ih
  | handler rows related ih => exact .handler rows ih
  | cell related ih => exact .cell ih
  | cleanup rows related ih => exact .cleanup rows ih
  | normal related ih => exact .normal ih
  | unwinding related ih => exact .unwinding ih
  | closing related ih => exact .closing ih
  | retiring related ih => exact .retiring ih
  | live saved related ih => exact .live saved ih
  | spent related ih => exact .spent ih

theorem SpentHistory.callback (related : SpentHistory freshOwner first second) (mode : LexicalUnwind.UseMode) :
    SpentHistory freshOwner (first.callback mode) (second.callback mode) := by
  cases mode
  · exact .normal related
  · exact .unwinding related

private theorem MetaSpent.evaluates (related : MetaSpent freshOwner first second)
    (same : stripSpent freshOwner left = stripSpent freshOwner right)
    (consumed : phases freshOwner = .consumed) :
    evaluate [] left phases first.closing.2 = evaluate [] right phases second.closing.2 := by
  induction related generalizing left right phases with
  | same metadata => exact empty_evaluate_congr _ same phases
  | add related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_spent, consumed, if_true, spendAll,
        RecursiveRecomposition.merge_empty_left]
      exact ih same consumed
  | plain related ih | handler related ih | cell related ih => exact ih same consumed
  | @cleanup _ first _ second needs callback latent related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence, empty_request, spendAll]
      rw [ih same consumed, export_strip_congr (freshOwner := freshOwner)
        (first := first.context ++ left) (second := second.context ++ right)
        (by simp only [stripSpent_append, related.contexts, same])]
  | retiring related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveClosing.evaluate_retire, spendAll]
      rw [ih same (RecursiveTransport.phases_spend_later _ consumed)]
  | spent related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_spent, spendAll]
      rw [ih same consumed]
  | @live savedScope _ first _ second owner saved related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRequirements.evaluate_prepend, RecursiveClosing.evaluate_retire, spendAll]
      rw [ih same (RecursiveTransport.phases_spend_later _ (RecursiveTransport.phases_spendAll_later _ consumed))]
      have eqCtx : stripSpent freshOwner ((.ordinary (.barrier true) :: first.context) ++ left) =
          stripSpent freshOwner ((.ordinary (.barrier true) :: second.context) ++ right) := by
        change .ordinary (.barrier true) :: stripSpent freshOwner (first.context ++ left) =
          .ordinary (.barrier true) :: stripSpent freshOwner (second.context ++ right)
        rw [stripSpent_append, stripSpent_append, related.contexts, same]
      rw [empty_evaluate_congr saved.closing.2 eqCtx]

private theorem MetaSpent.checked (related : MetaSpent freshOwner first second)
    (same : stripSpent freshOwner left = stripSpent freshOwner right)
    (consumed : phases freshOwner = .consumed)
    (checked : first.check left phases budget = true) : second.check right phases budget = true := by
  simpa only [CleanupHints.Metadata.check, related.evaluates same consumed] using checked
private theorem SpentHistory.metadata {metadata : CleanupHints.Metadata firstScope}
    {firstHints : ReturnHints firstScope} {first : Context firstHints} (related : SpentHistory freshOwner first second) (found : first.closing? = some metadata) :
    ∃ next, second.closing? = some next ∧ MetaSpent freshOwner metadata next := by
  induction related with
  | same context => exact ⟨metadata, found, .same _⟩
  | add related ih =>
      obtain ⟨next, nextFound, nextRelated⟩ := ih found
      exact ⟨.spent (owner := freshOwner) next, by simp only [Context.closing?, nextFound, Option.map_some], .add nextRelated⟩
  | plain rows related ih | handler rows related ih | cell related ih
  | cleanup rows related ih | retiring related ih | spent related ih =>
      simp only [Context.closing?] at found ⊢
      obtain ⟨actual, previous, equality⟩ := Option.map_eq_some_iff.mp found
      subst metadata
      obtain ⟨next, nextFound, nextRelated⟩ := ih previous
      simp only [nextFound, Option.map_some]
      refine ⟨_, rfl, ?_⟩
      first | exact .plain nextRelated | exact .handler nextRelated | exact .cell nextRelated
            | exact .cleanup nextRelated | exact .retiring nextRelated | exact .spent nextRelated
  | normal related ih | unwinding related ih | closing related ih => cases found
  | @live _ _ _ _ first _ _ second _ resumeDemand saved related ih =>
      cases savedFound : saved.closing? with
      | none => simp [Context.closing?, savedFound] at found
      | some savedMetadata =>
          simp only [Context.closing?, savedFound] at found ⊢
          cases previous : first.closing? with
          | none => simp [previous] at found
          | some actual =>
              simp [previous] at found
              subst metadata
              obtain ⟨next, nextFound, nextRelated⟩ := ih previous
              exact ⟨.live savedMetadata next, by simp [nextFound], .live _ nextRelated⟩

private inductive SelectedSpent (freshOwner : Nat) : Option Selection → Option Selection → Prop where
  | none : SelectedSpent freshOwner none none
  | builtin : SelectedSpent freshOwner (some (.builtin identity)) (some (.builtin identity))
  | handler (capture : SpentHistory freshOwner first.context second.context) (tail : SpentHistory freshOwner firstTail.context secondTail.context) :
      SelectedSpent freshOwner (some (.handler first firstTail contract modes)) (some (.handler second secondTail contract modes))

private theorem SelectedSpent.same (selected : Option Selection) : SelectedSpent freshOwner selected selected := by
  cases selected with
  | none => exact .none
  | some selected => cases selected with
    | builtin => exact .builtin
    | handler => exact .handler (.same _) (.same _)

private theorem SelectedSpent.prepend (related : SelectedSpent freshOwner first second)
    (frame nextFrame : Packed → Packed)
    (congruent : ∀ left right, SpentHistory freshOwner left.context right.context → SpentHistory freshOwner (frame left).context (nextFrame right).context) :
    SelectedSpent freshOwner (first.map (.prepend frame)) (second.map (.prepend nextFrame)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (congruent _ _ capture) tail

private theorem SelectedSpent.add (related : SelectedSpent freshOwner first second) :
    SelectedSpent freshOwner first (second.map (.prepend fun captured => (Context.spent (owner := freshOwner) captured.context).pack)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (.add capture) tail

private theorem SpentHistory.selected (related : SpentHistory freshOwner first second) effect operation :
    SelectedSpent freshOwner (select effect operation first) (select effect operation second) := by
  induction related with
  | same context => exact .same _
  | add related ih => exact ih.add
  | plain rows related ih => exact ih.prepend _ _ (fun _ _ h => .plain rows h)
  | handler rows related ih =>
      simp only [select]
      split
      · split
        · exact .handler (.same _) related
        · exact .none
      · exact ih.prepend _ _ (fun _ _ h => .handler rows h)
  | cell related ih =>
      simp only [select]
      split
      · exact .builtin
      · exact ih.prepend _ _ (fun _ _ h => .cell h)
  | cleanup rows related ih => exact ih.prepend _ _ (fun _ _ h => .cleanup rows h)
  | normal related ih => exact ih.prepend _ _ (fun _ _ h => .normal h)
  | unwinding related ih => exact ih.prepend _ _ (fun _ _ h => .unwinding h)
  | closing related ih => exact ih.prepend _ _ (fun _ _ h => .closing h)
  | retiring related ih => exact ih.prepend _ _ (fun _ _ h => .retiring h)
  | live saved related ih => exact ih.prepend _ _ (fun _ _ h => .live saved h)
  | spent related ih => exact ih.prepend _ _ (fun _ _ h => .spent h)

theorem SpentHistory.requestBudget (related : SpentHistory freshOwner first second)
    (checked : RequestBudget budget phases effect operation first)
    (consumed : phases freshOwner = .consumed) :
    RequestBudget budget phases effect operation second := by
  have selected := related.selected effect operation
  unfold RequestBudget at checked ⊢
  generalize select effect operation first = left at selected checked
  generalize select effect operation second = right at selected ⊢
  cases selected with
  | none | builtin => trivial
  | handler capture tail =>
      intro consuming
      obtain ⟨metadata, found, normal, protectedCheck⟩ := checked consuming
      obtain ⟨next, nextFound, nextRelated⟩ := capture.metadata found
      refine ⟨next, nextFound, nextRelated.checked tail.contexts consumed normal, nextRelated.checked ?_ consumed protectedCheck⟩
      change .ordinary (.barrier true) :: stripSpent freshOwner _ = .ordinary (.barrier true) :: stripSpent freshOwner _
      rw [tail.contexts]


theorem SpentHistory.builtin (related : SpentHistory freshOwner first second)
    (found : select effect operation first = some (.builtin identity)) :
    select effect operation second = some (.builtin identity) := by
  have transformed := related.selected effect operation
  rw [found] at transformed
  generalize select effect operation second = selected at transformed ⊢
  cases transformed
  rfl

theorem SpentHistory.cut
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {captured : Context capturedHints} {tail : Context tailHints}
    (related : SpentHistory freshOwner first second)
    (cut : Cut effect operation first captured tail contract modes) :
    ∃ nextCapturedScope nextTailScope,
    ∃ nextCapturedHints : ReturnHints nextCapturedScope, ∃ nextTailHints : ReturnHints nextTailScope,
    ∃ nextCaptured : Context nextCapturedHints, ∃ nextTail : Context nextTailHints,
      Cut effect operation second nextCaptured nextTail contract modes ∧
      SpentHistory freshOwner captured nextCaptured ∧ SpentHistory freshOwner tail nextTail := by
  have transformed := related.selected effect operation
  rw [cut] at transformed
  generalize found : select effect operation second = selected at transformed
  cases transformed with
  | handler captureHistory tailHistory =>
      exact ⟨_, _, _, _, _, _, found, captureHistory, tailHistory⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport.SpentHistory.hints
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport.SpentHistory.append
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport.SpentHistory.callback
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport.SpentHistory.builtin
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport.SpentHistory.cut
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport.SpentHistory.requestBudget

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport.SpentHistory.prefix

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)
open SpentTransport (SpentHistory)

/-- Already-consumed history changes neither source rows nor their cleanup
budget at the corresponding decorated lexical receiver. -/
theorem Budgeted.history
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (checked : Budgeted budget phases world installations rows first)
    (related : SpentHistory freshOwner first second)
    (consumed : phases freshOwner = .consumed) :
    Budgeted budget phases world installations rows second := by
  induction checked generalizing secondScope secondHints second with
  | pure => exact .pure
  | request checked => exact .request (related.requestBudget checked consumed)
  | invoke => exact .invoke
  | sequence left right ihLeft ihRight => exact .sequence (ihLeft (.plain _ related)) (ihRight related)
  | choice left right ihLeft ihRight => exact .choice (ihLeft related) (ihRight related)
  | handler body ih => exact .handler (fun activation fresh => ih activation fresh (.handler _ related))
  | cleanup body callback ihBody ihCallback => exact .cleanup (ihBody (.cleanup _ related)) (ihCallback (.normal related))
  | resource body ih => exact .resource (fun identity fresh => ih identity fresh (.cell related))

/-- Existing pending budget checks survive spent-history insertion in their
external receiver, including saved branches and their retirement marker. -/
theorem PendingBudget.outside_history
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (checked : PendingBudget budget phases world installations context first before after)
    (related : SpentHistory freshOwner first second)
    (consumed : phases freshOwner = .consumed) :
    PendingBudget budget phases world installations context second before after := by
  induction checked generalizing secondScope secondHints second with
  | nil => exact .nil
  | plain code tail ih => exact .plain (code.history (related.prefix _) consumed) (ih related)
  | skipped tail ih => exact .skipped (ih related)
  | handler tail ih => exact .handler (ih related)
  | cell tail ih => exact .cell (ih related)
  | cleanup callback tail ih => exact .cleanup (callback.history ((related.prefix _).callback _) consumed) (ih related)
  | normal tail ih => exact .normal (ih related)
  | unwinding tail ih => exact .unwinding (ih related)
  | closing tail ih => exact .closing (ih related)
  | retiring tail ih => exact .retiring (ih related)
  | live saved tail ihSaved ihTail => exact .live (ihSaved (related.prefix _)) (ihTail related)
  | opening saved tail ihSaved ihTail => exact .opening (ihSaved (.retiring (related.prefix _))) (ihTail related)
  | spent tail ih => exact .spent (ih related)

/-- Reuse existing budget evidence after spent-history insertion on both the
active pending spine and its external receiver. Saved captures remain literal. -/
theorem PendingBudget.history
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    {outsideHints : ReturnHints outsideScope} {nextOutsideHints : ReturnHints nextOutsideScope}
    {outside : Context outsideHints} {nextOutside : Context nextOutsideHints}
    (checked : PendingBudget budget phases world installations first outside before after)
    (related : SpentHistory freshOwner first second)
    (outsideHistory : SpentHistory freshOwner outside nextOutside)
    (consumed : phases freshOwner = .consumed) :
    PendingBudget budget phases world installations second nextOutside before after := by
  induction related generalizing before after with
  | same context => exact checked.outside_history outsideHistory consumed
  | add related ih => exact .spent (ih checked)
  | plain rows related ih => cases checked with
    | plain code tail => exact .plain (code.history (related.append outsideHistory) consumed) (ih tail)
    | skipped tail => exact .skipped (ih tail)
  | handler rows related ih => cases checked with | handler tail => exact .handler (ih tail)
  | cell related ih => cases checked with | cell tail => exact .cell (ih tail)
  | cleanup rows related ih => cases checked with
    | cleanup callback tail => exact .cleanup (callback.history ((related.append outsideHistory).callback _) consumed) (ih tail)
  | normal related ih => cases checked with | normal tail => exact .normal (ih tail)
  | unwinding related ih => cases checked with | unwinding tail => exact .unwinding (ih tail)
  | closing related ih => cases checked with | closing tail => exact .closing (ih tail)
  | retiring related ih => cases checked with | retiring tail => exact .retiring (ih tail)
  | live saved related ih => cases checked with
    | live captured tail => exact .live (captured.outside_history (related.append outsideHistory) consumed) (ih tail)
    | opening captured tail => exact .opening (captured.outside_history (.retiring (related.append outsideHistory)) consumed) (ih tail)
  | spent related ih => cases checked with | spent tail => exact .spent (ih tail)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
