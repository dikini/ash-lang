namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Resource-world growth preserves the same row data, decorated receiver and
cleanup budget. The resource rule restricts its existing fresh-name family. -/
theorem Budgeted.world_weaken
    (checked : Budgeted budget phases world installations rows context)
    (larger : world ⊆ nextWorld) :
    Budgeted budget phases nextWorld installations rows context := by
  induction checked generalizing nextWorld with
  | pure => exact .pure
  | request checked => exact .request checked
  | invoke => exact .invoke
  | sequence first second ihFirst ihSecond => exact .sequence (ihFirst larger) (ihSecond larger)
  | choice first second ihFirst ihSecond => exact .choice (ihFirst larger) (ihSecond larger)
  | handler body ih => exact .handler (fun activation fresh => ih activation fresh larger)
  | cleanup body callback ihBody ihCallback => exact .cleanup (ihBody larger) (ihCallback larger)
  | resource body ih =>
      exact .resource (fun identity fresh => ih identity (fun member => fresh (larger member))
        (ScopedExpressions.append_subset larger (List.Subset.refl _)))

/-- Typed context transport retains the actual installed identities, callback
latent rows and physical stack, reusing existing source transports. -/
theorem Context.Source.world_weaken
    {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack)
    (larger : world ⊆ nextWorld) :
    Context.Source operations policy contracts tables families nextWorld context stack := by
  induction source with
  | nil => exact .nil
  | plain tail ih => exact .plain ih
  | handler declaration tail ih =>
      exact .handler (declaration.transport (fun _ _ known => known) larger) ih
  | cell tail ih => exact .cell ih
  | cleanup callback tail ih =>
      exact .cleanup (SourceDependencyAnnotations.expression_world_weaken callback larger) ih
  | normal tail ih => exact .normal ih
  | unwinding tail ih => exact .unwinding ih
  | closing tail ih => exact .closing ih
  | retiring tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | spent tail ih => exact .spent ih

/-- The existing pending traversal carries the same budget certificates and
return modes into the larger resource world. -/
theorem PendingBudget.world_weaken
    (checked : PendingBudget budget phases world installations context outside initial finalMode)
    (larger : world ⊆ nextWorld) :
    PendingBudget budget phases nextWorld installations context outside initial finalMode := by
  induction checked with
  | nil => exact .nil
  | plain code tail ih => exact .plain (code.world_weaken larger) ih
  | skipped tail ih => exact .skipped ih
  | handler tail ih => exact .handler ih
  | cell tail ih => exact .cell ih
  | cleanup callback tail ih => exact .cleanup (callback.world_weaken larger) ih
  | normal tail ih => exact .normal ih
  | unwinding tail ih => exact .unwinding ih
  | closing tail ih => exact .closing ih
  | retiring tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | opening saved tail ihSaved ihTail => exact .opening ihSaved ihTail
  | spent tail ih => exact .spent ih

/-- World weakening preserves all current-source admission fields. Phase and
permission transport reuse the existing recursive Local theorem unchanged. -/
theorem Admitted.world_weaken
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack code result demand requirements checking resultRows rows)
    (larger : world ⊆ nextWorld) :
    Admitted operations policy contracts ports owners environment environmentRows nextWorld installations allowed outward
      runtimeScope actions phases budget tables families context stack code result demand requirements checking resultRows rows :=
  ⟨SourcePlannedSources.expression_world_weaken checked.source larger,
    checked.authenticated.world_weaken larger,
    SourceDependencySchemes.Lexical.Recursive.local_transport checked.capabilities
      (fun _ known => known) (fun _ _ known => known) larger,
    checked.cleanupBudget.world_weaken larger, checked.contextSource.world_weaken larger⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Budgeted.world_weaken
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.world_weaken
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingBudget.world_weaken
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.world_weaken

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlannedTyping (Operations Contracts)
open SourcePlanSignatures (signature)
open SourceDeclarationPlans (Plan)
open RecursiveRequirements (Requirements evaluate)

/-- The existing rich cleanup sources and callback certificates, retained at
their exact contextual decoration. This relation adds no execution checks. -/
inductive Context.PlannedClosing (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (actions : Syntax.UsageTickets) (world : List Nat) :
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} → Context hints → Stack → Prop where
  | nil : Context.PlannedClosing operations policy contracts tables families required outward actions world .nil .nil
  | plain (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world rest stack) :
      Context.PlannedClosing operations policy contracts tables families required outward actions world
        (.plain rows rest) (.push (.plain data) stack)
  | handler
      (declaration : CertifiedFrame (evidence := declarationPolicy.accepts outward)
        operations policy contracts tables families required outward world (.handler data) answer answer [] (.request [] [])
        (.handler data.effectInst (tables data) (families data)) decorate (data.effectInst :: residual) residual)
      (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world rest stack) :
      Context.PlannedClosing operations policy contracts tables families required outward actions world
        (.handler (effect := data.effectInst) (table := tables data) (families := families data) data.activation rows rest)
        (.push (.handler data) stack)
  | cell (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world rest stack) :
      Context.PlannedClosing operations policy contracts tables families required outward actions world
        (.cell (identity := identity) rest) (.push (.cell identity payload caller answer) stack)
  | cleanup {callbackPlan : Plan dependencies} {rows : Rows (signature callbackPlan)}
      (callback : SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) []
        action.action (.function .unit .unit action.requests latent (signature callbackPlan)))
      (certified : SourcePlannedChecks.Certified (evidence := declarationPolicy) outward world callbackPlan)
      (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world rest stack) :
      Context.PlannedClosing operations policy contracts tables families required outward actions world
        (.cleanup (needs := action.requests) latent rows rest) (.push (.armed action) stack)
  | retiring (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world rest stack) :
      Context.PlannedClosing operations policy contracts tables families required outward actions world
        (.retiring owner rest) (.push (.retiring owner) stack)
  | live (saved : Context.PlannedClosing operations policy contracts tables families required outward actions world captured savedStack)
      (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world rest stack) :
      Context.PlannedClosing operations policy contracts tables families required outward actions world
        (.live (resumeDemand := resumeDemand) (owner := owner) captured rest) (.live owner input answer savedStack caller stack)
  | spent (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world rest stack) :
      Context.PlannedClosing operations policy contracts tables families required outward actions world
        (.spent (owner := owner) rest) (.spent owner answer caller stack)

theorem Context.PlannedClosing.source {hints : ReturnHints scope} {context : Context hints}
    (source : Context.PlannedClosing operations policy contracts tables families required outward actions world context stack) :
    Context.Source operations.erase policy contracts.erase tables families world context stack := by
  induction source with
  | nil => exact .nil
  | plain tail ih => exact .plain ih
  | handler declaration tail ih => exact .handler declaration.source.erase ih
  | cell tail ih => exact .cell ih
  | cleanup callback certified tail ih => exact .cleanup (SourcePlannedSources.expression_erase callback) ih
  | retiring tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | spent tail ih => exact .spent ih

/-- Structural closing evidence contains only projectable return forms. -/
theorem Context.PlannedClosing.projection {hints : ReturnHints scope} {context : Context hints}
    (source : Context.PlannedClosing operations policy contracts tables families required outward actions world context stack) :
    ∃ metadata, context.closing? = some metadata := by
  induction source with
  | nil => exact ⟨.nil, rfl⟩
  | plain tail ih | handler declaration tail ih | cell tail ih
  | cleanup callback certified tail ih | retiring tail ih | spent tail ih =>
      obtain ⟨metadata, found⟩ := ih
      simp only [Context.closing?, found, Option.map_some]
      exact ⟨_, rfl⟩
  | live saved tail ihSaved ihTail =>
      obtain ⟨savedMetadata, savedFound⟩ := ihSaved
      obtain ⟨tailMetadata, tailFound⟩ := ihTail
      simp [Context.closing?, savedFound, tailFound]

/-- The paired rich source uses exactly the cleanup requirements computed from
this context, rather than another typing witness for the same physical stack. -/
theorem Context.PlannedClosing.planned {hints : ReturnHints scope} {context : Context hints}
    (source : Context.PlannedClosing operations policy contracts tables families required outward actions world context stack)
    (found : context.closing? = some metadata) :
    PlannedUnwindSource operations policy contracts tables families required outward actions world stack
      metadata.closing.1 metadata.closing.2 scope := by
  induction source with
  | nil => cases found; exact .paired .nil .nil (by intros; rfl)
  | plain tail ih | handler declaration tail ih | cell tail ih
  | cleanup callback certified tail ih | retiring tail ih | spent tail ih =>
      simp only [Context.closing?, Option.map_eq_some_iff] at found
      obtain ⟨actual, same, equal⟩ := found
      subst metadata
      cases ih same with
      | paired planned erased evaluates =>
          first
          | refine .paired (.push .skipped planned) (.plain erased) ?_
          | refine .paired (.push (.handler declaration) planned) (.handler declaration.source.erase erased) ?_
          | refine .paired (.push .cell planned) (.cell erased) ?_
          | refine .paired (.push (.cleanup callback certified) planned)
              (by simpa only [CleanupHints.Metadata.closing,
                (Context.closing?_sound _ same).2, tail.source.context_eq] using
                (SourceDependencyFrames.UnwindSource.cleanup (SourcePlannedSources.expression_erase callback) erased)) ?_
          | refine .paired (.push .retiring planned) (.retiring erased) ?_
          | refine .paired (.skippedSpent planned) (.spent erased) ?_
          all_goals
            intro store receiving phases
            simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
              RecursiveRecomposition.evaluate_empty, OwnerPhaseTransitions.spendAll,
              RecursiveRecomposition.merge_empty_left, Requirements.prepend, List.nil_append,
              RecursiveClosing.evaluate_retire, evaluates,
              (Context.closing?_sound _ same).2, tail.source.context_eq]
  | @live savedScope savedHints captured savedStack restScope restHints rest stack owner resumeDemand input answer caller saved tail ihSaved ihTail =>
      cases savedSame : captured.closing? with
      | none => simp [Context.closing?, savedSame] at found
      | some savedMetadata =>
          cases tailSame : rest.closing? with
          | none => simp [Context.closing?, savedSame, tailSame] at found
          | some tailMetadata =>
              simp [Context.closing?, savedSame, tailSame] at found
              subst metadata
              cases ihSaved savedSame with
              | paired savedPlanned savedErased savedEvaluates =>
                cases ihTail tailSame with
                | paired tailPlanned tailErased tailEvaluates =>
                  refine .paired (.opening savedPlanned tailPlanned) ?_ ?_
                  · simpa only [CleanupHints.Metadata.closing,
                      (Context.closing?_sound _ tailSame).2, tail.source.context_eq,
                      OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase,
                      CloseItem.frame, ProtectionContexts.frameProtected] using
                      (SourceDependencyFrames.UnwindSource.live (owner := owner) (input := input) (answer := answer)
                        (caller := caller) savedErased tailErased)
                  · intro store receiving phases
                    simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
                      RecursiveRequirements.evaluate_prepend, OwnerPhaseTransitions.spendAll,
                      RecursiveClosing.evaluate_retire, savedEvaluates, tailEvaluates,
                      (Context.closing?_sound _ tailSame).2, tail.source.context_eq,
                      OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase,
                      CloseItem.frame, ProtectionContexts.frameProtected]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.PlannedClosing.source
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.PlannedClosing.projection
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.PlannedClosing.planned

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open RecursiveRequirements (Requirements Checked)

/-- The actual consuming source request constructs all three generated capture
paths from its retained budget certificate. Normal capture annotation and
physical ownership premises remain the existing independently checked facets. -/
theorem Admitted.capture_annotation
    {operandSignature : Signature operandDependencies} {operandRows : Rows operandSignature}
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (admitted : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families whole stack
      (.perform (Instantiation.freezeEffect effect) operation operand) result demand requirements
      (.sequence operandSignature (.request (effect := effect) (operation := operation))) resultRows
      (.sequence operandRows (.request (effect := effect) (operation := operation))))
    (cut : Cut effect operation whole captured tail contract modes)
    (consuming : contract.dispose = true) :
    ∃ capStack tailStack, ∃ metadata : CleanupHints.Metadata captureScope,
      stack = capStack.append tailStack ∧ captured.closing? = some metadata ∧
      CleanupHints.Agreement operations.erase policy contracts.erase tables families world metadata capStack
        metadata.closing.1 metadata.closing.2 ∧
      ∀ resumeDemand (normalRequirements annotated : Requirements resumeDemand) entries normalRow,
        resumeDemand.Perm (ownedTickets capStack) →
        (ownedTickets capStack).Nodup →
        (∀ owner ∈ ownedTickets capStack, phases owner = .available) →
        RowAnnotation normalRequirements annotated →
        Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tailStack) phases
          (annotateDisposals annotated) normalRow → normalRow ⊆ budget →
        ∃ combined : Requirements resumeDemand, ∃ row,
          RowAnnotation normalRequirements (annotateDisposals combined) ∧
          RequirementPath (annotateDisposals annotated) (annotateDisposals combined) [] ∧
          RequirementPath metadata.closing.2 (annotateDisposals combined) [] ∧
          RequirementPath (metadata.closing.2.prepend [.ordinary (.barrier true)]) (annotateDisposals combined) [] ∧
          Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tailStack) phases
            (annotateDisposals combined) row ∧ row ⊆ budget := by
  obtain ⟨capStack, tailStack, metadata, decomposition, projected, agreed, ordinary, protectedCheck⟩ :=
    admitted.request_effects cut consuming
  refine ⟨capStack, tailStack, metadata, decomposition, projected, agreed, ?_⟩
  intro resumeDemand normalRequirements annotated entries normalRow balance unique ready normal checked bounded
  exact capture_annotation_from_effects agreed.source.template balance unique ready normal checked bounded ordinary protectedCheck

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.capture_annotation

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open RecursiveRequirements (Requirements Checked)

/-- Capture retains the same rich cleanup source as the generated annotation.
The pending rich source and physical cut are independent structural premises;
cleanup effect checks come from the actual admitted request. -/
theorem Admitted.capture_planned_annotation
    {operandSignature : Signature operandDependencies} {operandRows : Rows operandSignature}
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (admitted : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families whole stack
      (.perform (Instantiation.freezeEffect effect) operation operand) result demand requirements
      (.sequence operandSignature (.request (effect := effect) (operation := operation))) resultRows
      (.sequence operandRows (.request (effect := effect) (operation := operation))))
    (cut : Cut effect operation whole captured tail contract modes)
    (consuming : contract.dispose = true)
    (decomposition : stack = capStack.append tailStack)
    (planned : Context.PlannedClosing operations policy contracts tables families required outward actions world captured capStack)
    (tailSource : Context.Source operations.erase policy contracts.erase tables families world tail tailStack)
    (balance : resumeDemand.Perm (ownedTickets capStack))
    (unique : (ownedTickets capStack).Nodup)
    (ready : ∀ owner ∈ ownedTickets capStack, phases owner = .available)
    (normal : RowAnnotation (normalRequirements : Requirements resumeDemand) annotated)
    (checked : Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tailStack) phases
      (annotateDisposals annotated) normalRow)
    (bounded : normalRow ⊆ budget) :
    ∃ metadata : CleanupHints.Metadata captureScope,
      stack = capStack.append tailStack ∧ captured.closing? = some metadata ∧
      PlannedUnwindSource operations policy contracts tables families required outward actions world capStack
        metadata.closing.1 metadata.closing.2 captureScope ∧
      ∃ combined : Requirements resumeDemand, ∃ row,
        RowAnnotation normalRequirements (annotateDisposals combined) ∧
        RequirementPath (annotateDisposals annotated) (annotateDisposals combined) [] ∧
        RequirementPath metadata.closing.2 (annotateDisposals combined) [] ∧
        RequirementPath (metadata.closing.2.prepend [.ordinary (.barrier true)]) (annotateDisposals combined) [] ∧
        Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tailStack) phases
          (annotateDisposals combined) row ∧ row ⊆ budget := by
  cases admitted.cleanupBudget with
  | sequence operandBudget requestBudget =>
    cases requestBudget with
    | request retained =>
      obtain ⟨metadata, projected, ordinary, protectedCheck⟩ := retained.consuming cut consuming
      have agreed := planned.source.closing_agreement projected
      refine ⟨metadata, decomposition, projected, planned.planned projected, ?_⟩
      apply agreed.capture_annotation balance unique ready normal checked bounded
      · simpa only [tailSource.context_eq] using ordinary
      · simpa only [tailSource.context_eq] using protectedCheck

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.capture_planned_annotation

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (Signature signature)
open RecursiveRequirements (Requirements)

/-- Registration retains the rich callback witness that authenticated this
site's latent row. Existing plan certification and the previous closing context
supply the remaining data; no independent callback agreement is assumed. -/
theorem Admitted.register_planned_cleanup
    {callbackSignature : Signature callbackDependencies} {callbackRows : Rows callbackSignature}
    {bodySignature : Signature bodyDependencies} {bodyRows : Rows bodySignature}
    {callbackPlan : Plan callbackBodyDependencies} {callbackBodyRows : Rows (signature callbackPlan)}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (.cleanup action.action body) result demand requirements
      (.sequence callbackSignature (.cleanup (needs := action.requests) (signature callbackPlan) bodySignature)) resultRows
      (.sequence callbackRows (.cleanup (needs := action.requests) latent callbackBodyRows bodyRows)))
    (closed : ClosedValue action.action)
    (certified : SourcePlannedChecks.Certified (evidence := declarationPolicy) outward world callbackPlan)
    (tail : Context.PlannedClosing operations policy contracts tables families required outward actions world context stack) :
    Context.PlannedClosing operations policy contracts tables families required outward actions world
      (.cleanup (needs := action.requests) latent callbackBodyRows context) (.push (.armed action) stack) ∧
    ∃ bodyDemand, ∃ bodyRequirements : Requirements bodyDemand,
      Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
        runtimeScope actions phases budget tables families (.cleanup (needs := action.requests) latent callbackBodyRows context)
        (.push (.armed action) stack) body result bodyDemand bodyRequirements bodySignature resultRows bodyRows ∧
      Budgeted budget phases world installations callbackBodyRows (.normal context) := by
  have registered : Context.PlannedClosing operations policy contracts tables families required outward actions world
      (.cleanup (needs := action.requests) latent callbackBodyRows context) (.push (.armed action) stack) := by
    cases checked.authenticated with
    | cleanup callbackAuth bodyAuth =>
      rename_i bodySource callbackSource
      have callbackSummary := SourcePlannedSources.Values.closed_environment
        (SourcePlannedSources.Values.change_allowed
          (SourcePlannedSources.Values.summary callbackSource closed.1) closed.1 []) closed
        (fun _ => none)
      exact .cleanup callbackSummary certified tail
  exact ⟨registered, checked.cleanup_body closed⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.register_planned_cleanup

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Allocation extends the existing typed closing witness without selecting
another callback typing or changing its contextual metadata. The usage
extension is retained at this interface; closing source contains no use lookup. -/
theorem Context.PlannedClosing.transport
    {hints : ReturnHints scope} {context : Context hints}
    (source : Context.PlannedClosing operations policy contracts tables families required outward actions world context stack)
    (extension : contracts.Extends nextContracts)
    (_permissions : Syntax.UsageExtension actions nextActions) :
    Context.PlannedClosing operations policy nextContracts tables families required outward nextActions world context stack := by
  induction source with
  | nil => exact .nil
  | plain tail ih => exact .plain ih
  | handler declaration tail ih => exact .handler (declaration.transport extension) ih
  | cell tail ih => exact .cell ih
  | cleanup callback certified tail ih =>
      exact .cleanup (SourcePlannedSources.expression_extension callback extension) certified ih
  | retiring tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | spent tail ih => exact .spent ih

/-- Resource-world growth retains every stored source signature and latent
row, reusing the existing rich source and certificate weakening lemmas. -/
theorem Context.PlannedClosing.world_weaken
    {hints : ReturnHints scope} {context : Context hints}
    (source : Context.PlannedClosing operations policy contracts tables families required outward actions world context stack)
    (larger : world ⊆ nextWorld) :
    Context.PlannedClosing operations policy contracts tables families required outward actions nextWorld context stack := by
  induction source with
  | nil => exact .nil
  | plain tail ih => exact .plain ih
  | handler declaration tail ih => exact .handler (declaration.world_weaken larger) ih
  | cell tail ih => exact .cell ih
  | cleanup callback certified tail ih =>
      exact .cleanup (SourcePlannedSources.expression_world_weaken callback larger)
        (certified_world_weaken certified larger) ih
  | retiring tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | spent tail ih => exact .spent ih

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.PlannedClosing.transport
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.PlannedClosing.world_weaken

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Recomposition keeps each rich callback witness at its original decoration.
It performs no receiving-context or budget inference. -/
theorem Context.PlannedClosing.append
    {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {head : Context first} {tail : Context second}
    (captured : Context.PlannedClosing operations policy contracts tables families required outward actions world head capStack)
    (remaining : Context.PlannedClosing operations policy contracts tables families required outward actions world tail tailStack) :
    Context.PlannedClosing operations policy contracts tables families required outward actions world
      (head.append tail) (capStack.append tailStack) := by
  induction captured with
  | nil => exact remaining
  | plain rest ih => exact .plain ih
  | handler declaration rest ih => exact .handler declaration ih
  | cell rest ih => exact .cell ih
  | cleanup callback certified rest ih => exact .cleanup callback certified ih
  | retiring rest ih => exact .retiring ih
  | live saved rest ihSaved ihRest => exact .live saved ihRest
  | spent rest ih => exact .spent ih

/-- An exact decorated split extracts the same rich witnesses from both pieces.
No equality between separately chosen callback typings is assumed. -/
theorem Context.PlannedClosing.append_split
    {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (head : Context first) (tail : Context second)
    (source : Context.PlannedClosing operations policy contracts tables families required outward actions world
      (head.append tail) stack) :
    ∃ captured rest, stack = captured.append rest ∧
      Context.PlannedClosing operations policy contracts tables families required outward actions world head captured ∧
      Context.PlannedClosing operations policy contracts tables families required outward actions world tail rest := by
  induction head generalizing stack with
  | nil => exact ⟨.nil, stack, rfl, .nil, source⟩
  | plain rows rest ih =>
      cases source with
      | plain restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .plain capturedSource, tailSource⟩
  | handler activation rows rest ih =>
      cases source with
      | handler declaration restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .handler declaration capturedSource, tailSource⟩
  | cell rest ih =>
      cases source with
      | cell restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .cell capturedSource, tailSource⟩
  | cleanup latent rows rest ih =>
      cases source with
      | cleanup callback certified restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .cleanup callback certified capturedSource, tailSource⟩
  | normal rest ih | unwinding rest ih | closing rest ih => cases source
  | retiring owner rest ih =>
      cases source with
      | retiring restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .retiring capturedSource, tailSource⟩
  | live saved rest ihSaved ihRest =>
      cases source with
      | live savedSource restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ihRest restSource
          subst_vars
          exact ⟨_, _, rfl, .live savedSource capturedSource, tailSource⟩
  | spent rest ih =>
      cases source with
      | spent restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .spent capturedSource, tailSource⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.PlannedClosing.append
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.PlannedClosing.append_split

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Value Environment Operations Contracts)
open SourcePlanSignatures (Signature)

/-- A waiting expression context retains the same authenticated value and body
rows as its existing rich context derivation. The hole is typed independently. -/
inductive AuthContext (operations : Operations) (policy : Syntax.TicketPolicy)
    (ports : OperationRows operations) :
    {contracts : Contracts} → ContractRows contracts →
    {world : List Nat} → {environment : Environment} → EnvironmentRows environment →
    {allowed : List Instance} → {scope : Execution.Scope} →
    {position : ScopedExecution.Context} → {input output : Value} →
    {demand : List Nat} → {requirements : Requirements demand} →
    {dependencies : SourceDependencyAnnotations.Dependencies} → {checking : Signature dependencies} →
    SourcePlannedSources.Context operations policy contracts world environment allowed scope
      position input output demand requirements checking →
    ValueRows input → ValueRows output → Rows checking → Prop where
  | pairLeft
      (right : Auth operations policy ports owners environmentRows rightSource outputRows rightRows) :
      AuthContext operations policy ports owners environmentRows (.pairLeft rightSource)
        inputRows (.pair inputRows outputRows) rightRows
  | pairRight
      (left : Auth operations policy ports owners environmentRows leftSource inputRows .pure) :
      AuthContext operations policy ports owners environmentRows (.pairRight leftSource)
        outputRows (.pair inputRows outputRows) .pure
  | appFunction
      (argument : Auth operations policy ports owners environmentRows argumentSource inputRows argumentRows) :
      AuthContext operations policy ports owners environmentRows (.appFunction argumentSource admitted)
        (.function inputRows outputRows bodyRows) outputRows (.sequence argumentRows bodyRows)
  | appArgument
      (function : Auth operations policy ports owners environmentRows functionSource
        (.function inputRows outputRows bodyRows) .pure) :
      AuthContext operations policy ports owners environmentRows (.appArgument functionSource admitted)
        inputRows outputRows bodyRows
  | bind {environment : Environment} {environmentRows : EnvironmentRows environment}
      {input : Value} {inputRows : ValueRows input}
      {bodySource : SourcePlannedSources.Expression operations policy contracts world allowed scope
        (environment.extend parameter input) code output demand requirements checking}
      (body : Auth operations policy ports owners (environmentRows.extend parameter inputRows)
        bodySource outputRows bodyRows) :
      AuthContext operations policy ports owners environmentRows (.bind bodySource) inputRows outputRows bodyRows
  | branch
      (yes : Auth operations policy ports owners environmentRows yesSource outputRows yesRows)
      (no : Auth operations policy ports owners environmentRows noSource outputRows noRows) :
      AuthContext operations policy ports owners environmentRows (.branch yesSource noSource same)
        .boolean outputRows (.choice yesRows noRows)
  | perform {known : operations effect operation = some (input, output)} :
      AuthContext operations policy ports owners environmentRows (.perform known admitted formed)
        (ports effect operation input output known).1 (ports effect operation input output known).2 .request
  | resume {contracts : Contracts} {owners : ContractRows contracts} {known : contracts owner = some contract} :
      AuthContext operations policy ports owners environmentRows (.resume known resolved permission admitted formed)
        (owners owner contract known).1 (owners owner contract known).2 .invoke
  | cleanup
      (body : Auth operations policy ports owners environmentRows bodySource outputRows bodyRows) :
      AuthContext operations policy ports owners environmentRows (.cleanup (latent := latent) bodySource admitted)
        (.function .unit .unit callbackRows) outputRows (.cleanup latent callbackRows bodyRows)
  | resource {code : Code}
      {bodyRequirements : Nat → Requirements demand}
      {bodyDependencies : Nat → SourceDependencyAnnotations.Dependencies}
      {bodySignatures : ∀ identity, Signature (bodyDependencies identity)}
      {bodyRows : ∀ identity, Rows (bodySignatures identity)}
      {bodySource : ∀ identity, identity ∉ world → SourcePlannedSources.Expression operations policy contracts
        (world ++ [identity]) (.cell identity :: residual) scope environment
        (code.instantiate (Instantiation.Environment.empty.bind binder identity)) output demand
        (bodyRequirements identity) (bodySignatures identity)}
      {outward : Requirements demand}
      {hidden : ∀ identity, identity ∉ world → ResourceRequirements.Hides identity (bodyRequirements identity) outward}
      (body : ∀ identity (fresh : identity ∉ world),
        Auth operations policy ports owners environmentRows (bodySource identity fresh) outputRows (bodyRows identity)) :
      AuthContext operations policy ports owners environmentRows (.resource bodySource formed effectsBound admitted hidden)
        .integer outputRows (.resource bodyRows)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveContexts (evaluate_request)
open SourcePlanSignatures (Signature)

/-- Authentication cannot assign a cleanup context a latent row different
from the rich function type of its hole. -/
theorem AuthContext.cleanup_latent
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {callback : Signature callbackDependencies} {checking : Signature bodyDependencies}
    {callbackRows : Rows callback} {bodyRows : Rows checking}
    {source : SourcePlannedSources.Context operations policy contracts world environment allowed scope
      (.cleanup body) (.function .unit .unit requests latent callback) output demand requirements
      (.cleanup (needs := requests) callback checking)}
    (checked : AuthContext operations policy ports owners environmentRows source
      (.function .unit .unit callbackRows) outputRows (.cleanup stored callbackRows bodyRows)) :
    stored = latent := by
  cases checked
  rfl

/-- A silent immediate signature changes scope without changing any latent
body witness or decoration, as in the existing rich pure-scope proof. -/
theorem Auth.pure_scope
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements (checking : Signature dependencies)) valueRows rows)
    (silent : dependencies = .pure) (next : Execution.Scope) :
    Auth operations policy ports owners environmentRows
      (SourcePlannedSources.pure_scope source silent next) valueRows rows := by
  induction checked using Auth.rec
      (motive_2 := fun {_} _ {_ _ _ _} _ {_ _} _ {_ _ _} _ _ _ => True)
      (motive_3 := fun {_} _ {_ _} _ {_ _ _ _} _ {_} _ {_} _ {_ _ _ _ _ _ _ _} _ _ _ => True)
      (motive_4 := fun {_} _ {_ _} _ {_ _ _} _ {_ _ _ _} _ _ _ => True) with
  | unit => exact .unit
  | boolean => exact .boolean
  | integer => exact .integer
  | reference => exact Auth.reference (issued := by assumption)
  | «variable» => exact Auth.variable (known := by assumption) (formed := by assumption)
  | lambda body captured ih => exact Auth.lambda body captured (outward := by assumption) (formed := by assumption) (latentBound := by assumption)
  | purePair left right ihLeft ihRight => exact .purePair (ihLeft rfl) (ihRight rfl)
  | pair | app | bind | branch | perform | handler | resume | discard | cleanup | resource => cases silent
  | typed | unavailable | available | nil | cons => trivial

/-- Plugging an authenticated hole retains the exact waiting-code decorations.
The ordinary and generated requirement equations use the existing composition
laws; no independent typing of the reconstructed expression is selected. -/
theorem AuthContext.plug
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (contextAuth : AuthContext operations policy ports owners environmentRows
      (context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
        position input output restDemand rest checking) inputRows outputRows contextRows)
    (childAuth : Auth operations policy ports owners environmentRows
      (child : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code input childDemand current childChecking) inputRows childRows) :
    ∃ (combined : Requirements (childDemand ++ restDemand)) (dependencies : SourceDependencyAnnotations.Dependencies)
      (resultChecking : Signature dependencies),
      ∃ resultRows : Rows resultChecking,
      ∃ source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        (position.plug code) output (childDemand ++ restDemand) combined resultChecking,
      Auth operations policy ports owners environmentRows source outputRows resultRows ∧
      ∀ store receiving before,
        (evaluate store receiving before combined =
          merge (evaluate store receiving before current) (evaluate store receiving (spendAll before childDemand) rest)) ∧
        evaluate store receiving before (annotateDisposals combined) =
          merge (evaluate store receiving before (annotateDisposals current))
            (evaluate store receiving (spendAll before childDemand) (annotateDisposals rest)) := by
  cases contextAuth with
  | pairLeft right =>
      exact ⟨_, _, _, _, _, .pair childAuth right,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | pairRight left =>
      rw [List.append_nil]
      refine ⟨_, _, _, _, _, .pair (left.pure_scope rfl _) childAuth, ?_⟩
      intro store receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty, spendAll,
        RecursiveRecomposition.merge_empty_left, RecursiveRecomposition.merge_empty_right]
  | appFunction argument =>
      refine ⟨_, _, _, _, _, Auth.app childAuth argument (admitted := by assumption), ?_⟩
      intro store receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence, PhaseRechecking.spendAll_append, merge_assoc]
  | appArgument function =>
      rw [List.append_nil]
      refine ⟨_, _, _, _, _, Auth.app (function.pure_scope rfl _) childAuth (admitted := by assumption), ?_⟩
      intro store receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty,
        spendAll, List.nil_append, RecursiveRecomposition.merge_empty_left, evaluate_request]
  | bind body =>
      exact ⟨_, _, _, _, _, .bind childAuth body,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | branch yes no =>
      exact ⟨_, _, _, _, _, Auth.branch childAuth yes no (same := by assumption),
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | perform =>
      rw [List.append_nil]
      refine ⟨_, _, _, _, _, Auth.perform childAuth (known := by assumption) (admitted := by assumption) (formed := by assumption), ?_⟩
      intro store receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, evaluate_request, List.nil_append]
  | resume =>
      exact ⟨_, _, _, _, _, Auth.resume childAuth (known := by assumption) (resolved := by assumption)
        (permission := by assumption) (admitted := by assumption) (formed := by assumption),
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | cleanup body =>
      refine ⟨_, _, _, _, _, Auth.cleanup childAuth body (admitted := by assumption), ?_⟩
      intro store receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence, PhaseRechecking.spendAll_append, merge_assoc]
  | resource body =>
      exact ⟨_, _, _, _, _, Auth.resource childAuth body (formed := by assumption) (effectsBound := by assumption)
        (admitted := by assumption) (hidden := by assumption),
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.pure_scope
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.AuthContext.plug

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.AuthContext.cleanup_latent

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveContexts (evaluate_request)
open SourcePlannedTyping (Value)
open SourcePlanSignatures (Signature)
open SourcePlannedSources (FocusSignature)

/-- Decompose the actual authenticated source at its actual evaluation focus.
The child and retained context share one intermediate value decoration, and
both requirement equations use those same coherent source witnesses. -/
theorem Auth.focus_decompose
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      whole output demand requirements checking}
    (checked : Auth operations policy ports owners environmentRows source outputRows rows)
    (focus : Focus whole child position) :
    ∃ (input : Value) (childDemand restDemand : List Nat) (current : Requirements childDemand) (rest : Requirements restDemand)
      (childDependencies restDependencies : SourceDependencyAnnotations.Dependencies)
      (childSignature : Signature childDependencies) (restSignature : Signature restDependencies),
      ∃ (inputRows : ValueRows input) (childRows : Rows childSignature) (contextRows : Rows restSignature),
      ∃ (childSource : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        child input childDemand current childSignature)
        (context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
          position input output restDemand rest restSignature),
      Auth operations policy ports owners environmentRows childSource inputRows childRows ∧
      AuthContext operations policy ports owners environmentRows context inputRows outputRows contextRows ∧
      FocusSignature checking childSignature restSignature ∧ demand = childDemand ++ restDemand ∧
      ∀ store receiving before,
        (evaluate store receiving before requirements =
          merge (evaluate store receiving before current) (evaluate store receiving (spendAll before childDemand) rest)) ∧
        evaluate store receiving before (annotateDisposals requirements) =
          merge (evaluate store receiving before (annotateDisposals current))
            (evaluate store receiving (spendAll before childDemand) (annotateDisposals rest)) := by
  cases checked with
  | unit | boolean | integer | reference | «variable» | lambda | handler | discard => cases focus
  | purePair left right => cases focus with
    | pairLeft =>
        refine ⟨_, [], [], _, _, _, _, _, _, _, _, _, _, _, left, .pairLeft right, .pure, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRecomposition.evaluate_empty, merge, List.nil_append]
    | pairRight isValue notValue =>
        refine ⟨_, [], [], _, _, _, _, _, _, _, _, _, _, _, right, .pairRight (left.value_summary isValue), .pure, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRecomposition.evaluate_empty, merge, List.nil_append]
  | pair left right => cases focus with
    | pairLeft => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, left, .pairLeft right, .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
    | pairRight isValue notValue =>
        rename_i leftSource rightSource
        have empty := SourceTemplates.expression_value_demand
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase leftSource))) isValue
        subst_vars
        refine ⟨_, _, [], _, _, _, _, _, _, _, _, _, _, _, right, .pairRight (left.value_summary isValue), .pairRight, by simp, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence,
          SourcePlannedSources.template_value_disposals (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase leftSource))) isValue,
          RecursiveRecomposition.value_evaluation (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase leftSource))) isValue,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left, RecursiveRecomposition.merge_empty_right]
  | app function argument => cases focus with
    | appFunction =>
        refine ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, function, AuthContext.appFunction argument (admitted := by assumption), .sequence, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence, PhaseRechecking.spendAll_append, merge_assoc]
    | appArgument isValue notValue =>
        rename_i functionSource argumentSource
        have empty := SourceTemplates.expression_value_demand
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase functionSource))) isValue
        subst_vars
        refine ⟨_, _, [], _, _, _, _, _, _, _, _, _, _, _, argument,
          AuthContext.appArgument (function.value_summary isValue) (admitted := by assumption), .appArgument, by simp, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence,
          SourcePlannedSources.template_value_disposals (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase functionSource))) isValue,
          RecursiveRecomposition.value_evaluation (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase functionSource))) isValue,
          spendAll, List.nil_append, RecursiveRecomposition.merge_empty_left, evaluate_request]
  | bind initializer body => cases focus with
    | bind => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, initializer, .bind body, .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | branch condition yes no => cases focus with
    | branch => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, condition, AuthContext.branch yes no (same := by assumption), .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | perform operand => cases focus with
    | perform =>
        refine ⟨_, _, [], _, _, _, _, _, _, _, _, _, _, _, operand,
          AuthContext.perform (known := by assumption) (admitted := by assumption) (formed := by assumption), .sequence, by simp, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, evaluate_request, List.nil_append]
  | resource initializer body => cases focus with
    | resource notValue => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, initializer,
        AuthContext.resource body (formed := by assumption) (effectsBound := by assumption) (admitted := by assumption) (hidden := by assumption),
        .sequence, rfl, fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | resume operand => cases focus with
    | resume => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, operand,
        AuthContext.resume (known := by assumption) (resolved := by assumption) (permission := by assumption)
          (admitted := by assumption) (formed := by assumption), .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | cleanup callback body => cases focus with
    | cleanup =>
        refine ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, callback,
          AuthContext.cleanup body (admitted := by assumption), .sequence, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence, PhaseRechecking.spendAll_append, merge_assoc]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.focus_decompose

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (Scope)
open SourcePlannedTyping (Operations Contracts Value)
open SourcePlannedSources (ValueSummary)
open SourceDeclarationPlans (Plan ClausePlans)
open SourcePlanSignatures (Signature signature clauseSignatures)
open SourcePlannedFrames (Decoration)
open SourcePlannedChecks (Certified)
open RecursiveRequirements (Requirements)

/-- Decoration of an existing certified frame. Callback and declaration
metadata are authenticated by the same witnesses used in that frame's
constructor, including ordinary pending expression contexts. -/
inductive FrameRows (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance) (world : List Nat)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none)) :
    {entry : ExecFrame} → {input output : Value} → {demand : List Nat} → {requirements : Requirements demand} →
    {layer : SourceDependencyCapture.Scope → SourceDependencyCapture.Scope} → {decorate : Decoration layer} →
    {incoming outgoing : List Instance} →
    CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world
      entry input output demand requirements layer decorate incoming outgoing →
    ValueRows input → ValueRows output →
    {restScope : SourceDependencyCapture.Scope} → {rest : ReturnHints restScope} → Context rest →
    {hints : ReturnHints (layer restScope)} → Context hints → Prop where
  | plain {plan : Plan dependencies} {rows : Rows (signature plan)} {data : PlainData}
      {source : SourcePlannedSources.Context operations policy contracts world (fun _ => none) allowed data.scope data.context
        input output demand requirements (signature plan)}
      {scopeKnown : ScopedPorts.EffectScope contracts.erase.erase.ports data.scope ticket}
      {inputAnnotation : input.erase.erase.port = ScopedPorts.eraseType data.input}
      {outputAnnotation : output.erase.erase.port = ScopedPorts.eraseType data.output}
      {certified : Certified (evidence := declarationPolicy) outward world plan}
      {rest : ReturnHints restScope} {tail : Context rest}
      {inputRows : ValueRows input} {outputRows : ValueRows output}
      (authenticated : AuthContext operations policy ports owners emptyRows source inputRows outputRows rows) :
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.plain source scopeKnown inputAnnotation outputAnnotation certified) inputRows outputRows tail (.plain rows tail)
  | handler {data : HandlerData} {plans : ClausePlans data.clauses (families data)}
      {declarationRows : ClauseRows (clauseSignatures plans)} {answerRows : ValueRows answer}
      {scopeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports data.scope}
      {annotation : answer.erase.erase.port = ScopedPorts.eraseType data.answer}
      {clauses : ScopedPorts.ClausesTyped operations.erase.erase.ports world
        SourceDependencyAnnotations.Environment.empty.erase.ports data.effectInst answer.erase.erase.port residual data.clauses}
      {coverage : ScopedPorts.Covers operations.erase.erase.ports data.effectInst data.clauses}
      {unique : (ScopedTyping.clauseKeys data.clauses).Nodup}
      {declarations : SourcePlannedSources.Declarations operations policy contracts world (fun _ => none)
        residual data.effectInst answer data.clauses (tables data) plans}
      {recipes : declarationPolicy.accepts outward (required data) plans}
      {capabilities : ClausesUse policy data.clauses}
      {modes : SourceTemplates.ClauseModes data.clauses (tables data)}
      {certified : SourcePlannedChecks.CertifiedClauses (evidence := declarationPolicy) outward world plans}
      {rest : ReturnHints restScope} {tail : Context rest}
      (authenticated : AuthDeclarations operations policy ports owners emptyRows answerRows declarations declarationRows) :
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.handler scopeKnown annotation clauses coverage unique declarations recipes capabilities modes certified)
        answerRows answerRows tail (.handler data.activation declarationRows tail)
  | cell {result : Value} {resultRows : ValueRows result} {scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types caller}
      {noEscape : identity ∉ (ScopedPorts.eraseType answer).resources}
      {annotation : result.erase.erase.port = ScopedPorts.eraseType answer}
      {interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world
        (.cell identity payload caller answer) incoming outgoing}
      {rest : ReturnHints restScope} {tail : Context rest} :
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.cell scopeKnown noEscape annotation interface) resultRows resultRows tail (.cell tail)
  | armed {result : Value} {resultRows : ValueRows result} {action : ActionData} {callbackPlan : Plan dependencies} {bodyRows : Rows (signature callbackPlan)}
      {scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types action.scope}
      {callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action
        (.function .unit .unit action.requests latent (signature callbackPlan))}
      {annotation : result.erase.erase.port = ScopedPorts.eraseType action.answer}
      {interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world
        (.armed action) incoming outgoing}
      {certified : Certified (evidence := declarationPolicy) outward world callbackPlan}
      {rest : ReturnHints restScope} {tail : Context rest}
      (authenticated : Auth operations policy ports owners emptyRows callback (.function .unit .unit bodyRows) .pure) :
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.armed scopeKnown callback annotation interface certified) resultRows resultRows tail (.cleanup latent bodyRows tail)
  | running {action : ActionData} {callbackPlan : Plan dependencies} {bodyRows : Rows (signature callbackPlan)}
      {savedRows : ValueRows result}
      {scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types action.scope}
      {callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action
        (.function .unit .unit action.requests latent (signature callbackPlan))}
      {saved : ValueSummary operations policy contracts world (fun _ => none) [] value result}
      {annotation : result.erase.erase.port = ScopedPorts.eraseType action.answer}
      {interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world
        (.running action value closed) incoming outgoing}
      {rest : ReturnHints restScope} {tail : Context rest}
      (callbackAuth : Auth operations policy ports owners emptyRows callback (.function .unit .unit bodyRows) .pure)
      (savedAuth : Auth operations policy ports owners emptyRows saved savedRows .pure) :
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.running scopeKnown callback saved annotation interface) .unit savedRows tail (.normal tail)
  | closing {scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types caller}
      {interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world
        (.closing identity caller) incoming outgoing}
      {rest : ReturnHints restScope} {tail : Context rest} :
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.closing scopeKnown interface) .unit .unit tail (.closing tail)
  | retiring {known : contracts owner = some contract}
      {interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world
        (.retiring owner) incoming outgoing}
      {rest : ReturnHints restScope} {tail : Context rest} :
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.retiring known interface) .unit .unit tail (.retiring owner tail)

/-- Value metadata at the existing execution mode; unwind carries no value. -/
inductive ModeRowsValue : PlannedModeValue → Type where
  | value (rows : ValueRows value) : ModeRowsValue (.value value)
  | unwind : ModeRowsValue .unwind

/-- A saved continuation returns its owner's exact answer metadata, or unwinds. -/
inductive ModeRowsValue.Answer {answer : Value} (rows : ValueRows answer) :
    {boundary : PlannedModeValue} → ModeRowsValue boundary → Prop where
  | value : ModeRowsValue.Answer rows (.value rows)
  | unwind : ModeRowsValue.Answer rows .unwind

/-- Decorate the existing mode-specific frame, retaining all return markers
and coherent input/output value metadata. -/
inductive ModeFrameRows (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance) (world : List Nat)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none)) :
    {entry : ExecFrame} → {input output : PlannedModeValue} → {demand : List Nat} → {requirements : Requirements demand} →
    {layer : SourceDependencyCapture.Scope → SourceDependencyCapture.Scope} →
    PlannedModeFrame operations policy contracts tables families required outward world
      entry input output demand requirements layer → ModeRowsValue input → ModeRowsValue output →
    {restScope : SourceDependencyCapture.Scope} → {rest : ReturnHints restScope} → Context rest →
    {hints : ReturnHints (layer restScope)} → Context hints → Prop where
  | ordinary
      (authenticated : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        frame inputRows outputRows tail decorated) :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.ordinary frame) (.value inputRows) (.value outputRows) tail decorated
  | unwinding {action : ActionData} {callbackPlan : Plan dependencies} {bodyRows : Rows (signature callbackPlan)}
      {callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action
        (.function .unit .unit action.requests latent (signature callbackPlan))}
      {certified : Certified (evidence := declarationPolicy) outward world callbackPlan}
      {rest : ReturnHints restScope} {tail : Context rest}
      (authenticated : Auth operations policy ports owners emptyRows callback (.function .unit .unit bodyRows) .pure) :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.unwinding callback certified) (.value .unit) .unwind tail (.unwinding tail)
  | closing {inputRows : ModeRowsValue input}
      {scopeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller}
      {rest : ReturnHints restScope} {tail : Context rest} :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.closing (input := input) (identity := identity) scopeKnown) inputRows (.value .unit) tail (.closing tail)
  | retiring {inputRows : ModeRowsValue input} {rest : ReturnHints restScope} {tail : Context rest} :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.retiring (owner := owner) (input := input)) inputRows inputRows tail (.retiring owner tail)
  | skipped {checking : Signature dependencies} {rows : Rows checking}
      {rest : ReturnHints restScope} {tail : Context rest} :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.skipped (data := data) (dependencies := dependencies)) .unwind .unwind tail (.plain rows tail)
  | handler {data : HandlerData} {answerRows : ValueRows answer}
      {decorate : Decoration (.handler data.effectInst (tables data) (families data))}
      {frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world
        (.handler data) answer answer [] (.request [] [])
        (.handler data.effectInst (tables data) (families data)) decorate (data.effectInst :: residual) residual}
      {rest : ReturnHints restScope} {tail : Context rest}
      {hints : ReturnHints (.handler data.effectInst (tables data) (families data) restScope)} {decorated : Context hints}
      (authenticated : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        frame answerRows answerRows tail decorated) :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.handler frame) .unwind .unwind tail decorated
  | cell {rest : ReturnHints restScope} {tail : Context rest} :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.cell (identity := identity) (payload := payload) (caller := caller) (answer := answer)) .unwind .unwind tail (.cell tail)
  | cleanup {action : ActionData} {callbackPlan : Plan dependencies} {bodyRows : Rows (signature callbackPlan)}
      {callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action
        (.function .unit .unit action.requests latent (signature callbackPlan))}
      {certified : Certified (evidence := declarationPolicy) outward world callbackPlan}
      {rest : ReturnHints restScope} {tail : Context rest}
      (authenticated : Auth operations policy ports owners emptyRows callback (.function .unit .unit bodyRows) .pure) :
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        (.cleanup callback certified) .unwind .unwind tail (.cleanup latent bodyRows tail)

/-- Coherent context metadata refines the existing planned source derivation.
Adjacent frames share their exact intermediate metadata. Saved continuations
use their owner's decorated interface and share their return metadata with the
tail. Running stacks remain valid without whole-stack closing evidence. -/
inductive PendingRows (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance)
    (actions : Syntax.UsageTickets) (world : List Nat)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none)) :
    {stack : Stack} → {input output : PlannedModeValue} → {demand : List Nat} → {requirements : Requirements demand} →
    {scope : SourceDependencyCapture.Scope} →
    PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope → ModeRowsValue input → ModeRowsValue output →
    {hints : ReturnHints scope} → Context hints → Prop where
  | nil {rows : ModeRowsValue input} :
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        (.nil (input := input)) rows rows .nil
  | push
      (head : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        frame inputRows middleRows rest decorated)
      (tail : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        source middleRows outputRows rest) :
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        (.push frame source) inputRows outputRows decorated
  | live {known : contracts owner = some contract} {actionKnown : actions owner = some rights}
      {inputAnnotation : contract.input.erase.erase.port = ScopedPorts.eraseType inputType}
      {answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType}
      {callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller}
      {held : contract.held = ProtectionContexts.protectedMode captured.erase}
      {saved : PlannedModeSource operations policy contracts tables families required outward actions world
        captured (.value contract.input) boundary contract.resumeDemand body savedScope}
      {answer : boundary = .value contract.answer ∨ boundary = .unwind}
      {source : PlannedModeSource operations policy contracts tables families required outward actions world
        stack boundary output demand requirements restScope}
      {boundaryRows : ModeRowsValue boundary}
      (answerRows : ModeRowsValue.Answer (owners owner contract known).2 boundaryRows)
      (inside : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        saved (.value (owners owner contract known).1) boundaryRows capturedContext)
      (tail : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        source boundaryRows outputRows rest) :
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        (.live known actionKnown inputAnnotation answerAnnotation callerScope held saved answer source)
        (.value (owners owner contract known).2) outputRows (.live (resumeDemand := resumeDemand) capturedContext rest)
  | opening
      {saved : PlannedModeSource operations policy contracts tables families required outward actions world
        captured .unwind .unwind savedDemand savedRequirements savedScope}
      {source : PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind output tailDemand tailRequirements restScope}
      (inside : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        saved .unwind .unwind capturedContext)
      (tail : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        source .unwind outputRows rest) :
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        (.opening (owner := owner) (input := input) (answer := answer) (caller := caller) saved source)
        .unwind outputRows (.live (resumeDemand := resumeDemand) capturedContext rest)
  | spent {known : contracts owner = some contract}
      {annotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType}
      {callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller}
      {source : PlannedModeSource operations policy contracts tables families required outward actions world
        stack (.value contract.answer) output demand requirements restScope}
      (tail : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        source (.value (owners owner contract known).2) outputRows rest) :
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        (.spent known annotation callerScope source) (.value (owners owner contract known).2) outputRows (.spent rest)
  | skippedSpent
      (tail : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        source .unwind outputRows rest) :
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        (.skippedSpent (owner := owner) (answerType := answerType) (caller := caller) source) .unwind outputRows (.spent rest)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.FrameRows.rec
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ModeFrameRows.rec
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.rec

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Erasure keeps callback latent rows and installed handler identities fixed. -/
theorem FrameRows.source
    {frame : CertifiedFrame (evidence := declarationPolicy.accepts outward)
      operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing}
    (rows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (remaining : Context.Source operations.erase policy contracts.erase tables families world tail stack) :
    Context.Source operations.erase policy contracts.erase tables families world decorated (.push entry stack) := by
  have erased := frame.source.erase
  cases rows with
  | plain authenticated => exact .plain remaining
  | handler authenticated => exact .handler erased remaining
  | cell => exact .cell remaining
  | armed authenticated => exact .cleanup (SourcePlannedSources.expression_erase (by assumption)) remaining
  | running callback saved => exact .normal remaining
  | closing => exact .closing remaining
  | retiring => exact .retiring remaining

/-- A successfully projectable decorated frame retains its original rich
closing witness, with no fresh callback typing choice. -/
theorem FrameRows.planned_closing
    {frame : CertifiedFrame (evidence := declarationPolicy.accepts outward)
      operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing}
    (rows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (remaining : Context.PlannedClosing operations policy contracts tables families required outward actions world tail stack)
    (projected : decorated.closing? = some metadata) :
    Context.PlannedClosing operations policy contracts tables families required outward actions world decorated (.push entry stack) := by
  have original := frame
  cases rows with
  | plain authenticated => exact .plain remaining
  | handler authenticated => exact .handler original remaining
  | cell => exact .cell remaining
  | armed authenticated => exact .cleanup (by assumption) (by assumption) remaining
  | running callback saved | closing => cases projected
  | retiring => exact .retiring remaining

theorem FrameRows.closing_tail
    (rows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (projected : decorated.closing? = some metadata) :
    ∃ remaining, tail.closing? = some remaining := by
  cases rows <;> simp only [Context.closing?, Option.map_eq_some_iff] at projected
  all_goals first
  | obtain ⟨remaining, found, _⟩ := projected; exact ⟨remaining, found⟩
  | cases projected

theorem ModeFrameRows.source
    {frame : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer}
    (rows : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (remaining : Context.Source operations.erase policy contracts.erase tables families world tail stack) :
    Context.Source operations.erase policy contracts.erase tables families world decorated (.push entry stack) := by
  cases rows with
  | ordinary checked | handler checked => exact checked.source remaining
  | unwinding checked => exact .unwinding remaining
  | closing => exact .closing remaining
  | retiring => exact .retiring remaining
  | skipped => exact .plain remaining
  | cell => exact .cell remaining
  | cleanup checked => exact .cleanup (SourcePlannedSources.expression_erase (by assumption)) remaining

theorem ModeFrameRows.planned_closing
    {frame : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer}
    (rows : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (remaining : Context.PlannedClosing operations policy contracts tables families required outward actions world tail stack)
    (projected : decorated.closing? = some metadata) :
    Context.PlannedClosing operations policy contracts tables families required outward actions world decorated (.push entry stack) := by
  cases rows with
  | ordinary checked | handler checked => exact checked.planned_closing remaining projected
  | unwinding checked | closing => cases projected
  | retiring => exact .retiring remaining
  | skipped => exact .plain remaining
  | cell => exact .cell remaining
  | cleanup checked => exact .cleanup (by assumption) (by assumption) remaining

theorem ModeFrameRows.closing_tail
    (rows : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (projected : decorated.closing? = some metadata) :
    ∃ remaining, tail.closing? = some remaining := by
  cases rows with
  | ordinary checked | handler checked => exact checked.closing_tail projected
  | _ =>
      simp only [Context.closing?, Option.map_eq_some_iff] at projected
      first
      | obtain ⟨remaining, found, _⟩ := projected; exact ⟨remaining, found⟩
      | cases projected

theorem PendingRows.source
    {source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope}
    (rows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context) :
    Context.Source operations.erase policy contracts.erase tables families world context stack := by
  induction rows with
  | nil => exact .nil
  | push head tail ih => exact head.source ih
  | live aligned saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | opening saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | spent tail ih | skippedSpent tail ih => exact .spent ih

private theorem live_closing_parts
    {savedHints : ReturnHints savedScope} {tailHints : ReturnHints tailScope}
    {saved : Context savedHints} {tail : Context tailHints}
    (found : (Context.live (resumeDemand := resumeDemand) (owner := owner) saved tail).closing? = some metadata) :
    (∃ savedMetadata, saved.closing? = some savedMetadata) ∧
      ∃ tailMetadata, tail.closing? = some tailMetadata := by
  cases savedSame : saved.closing? with
  | none => simp [Context.closing?, savedSame] at found
  | some savedMetadata =>
      cases tailSame : tail.closing? with
      | none => simp [Context.closing?, savedSame, tailSame] at found
      | some tailMetadata => exact ⟨⟨savedMetadata, rfl⟩, ⟨tailMetadata, rfl⟩⟩

/-- Projectable pending contexts retain the exact rich callback witnesses that
were authenticated in their frame constructors. -/
theorem PendingRows.planned_closing
    {source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope}
    (rows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (found : context.closing? = some metadata) :
    Context.PlannedClosing operations policy contracts tables families required outward actions world context stack := by
  induction rows with
  | nil => exact .nil
  | push head tail ih =>
      obtain ⟨tailMetadata, tailFound⟩ := head.closing_tail found
      exact head.planned_closing (ih tailFound) found
  | live aligned saved tail ihSaved ihTail =>
      obtain ⟨⟨savedMetadata, savedFound⟩, ⟨tailMetadata, tailFound⟩⟩ := live_closing_parts found
      exact .live (ihSaved savedFound) (ihTail tailFound)
  | opening saved tail ihSaved ihTail =>
      obtain ⟨⟨savedMetadata, savedFound⟩, ⟨tailMetadata, tailFound⟩⟩ := live_closing_parts found
      exact .live (ihSaved savedFound) (ihTail tailFound)
  | spent tail ih | skippedSpent tail ih =>
      simp only [Context.closing?, Option.map_eq_some_iff] at found
      obtain ⟨tailMetadata, tailFound, _⟩ := found
      exact .spent (ih tailFound)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.source
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.planned_closing

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SelectedRequirements
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyCapture (Scope Realizes select chosen lookupDependencies modeDependencies)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open SourceContextualHints (Requirement checkRequirements)
open OwnerPhaseTransitions (Phases spend introduce)

/-- Check a finite list at the exact selected handler's actual receiving tail.
This checks no other installed or dormant declaration. -/
def checkSelectedRequirements (effect : Instance) (operation : Nat)
    (scope : SourceDependencyCapture.Scope) (needed : List Requirement) : Bool :=
  match select effect operation scope with
  | some (.handler _ tail _ _) => checkRequirements tail needed
  | _ => false

/-- Factor the existing capture-interface proof: its primitive continuation
and Pending conclusions do not use whole-forest compatibility. -/
theorem capture_primitive_interface {hints : ReturnHints wholeScope}
    (cut : HandlerCut requested whole capture tail handler)
    (matching : ReturnHints.Matches tables families hints whole)
    (retained : Pending outward actions phases world hints .nil .ordinary finalMode)
    (request : Local outward actions phases world (.request requested operation) hints)
    (modes : SourceTemplates.ClauseModes handler.clauses (tables handler))
    (selected : ClauseAt operation handler.clauses parameter binder code)
    (offeredKnown : lookup operation (tables handler) = some offered)
    (fresh : actions owner = none) (consumed : phases owner = .consumed) :
    ∃ capturedScope tailScope, ∃ capturedHints : ReturnHints capturedScope,
    ∃ tailHints : ReturnHints tailScope, ∃ family,
      wholeScope = capturedScope.append tailScope ∧
      (lookupDependencies operation (families handler)).bind (modeDependencies capturedScope.held) = some family ∧
      ReturnHints.Matches tables families (.live (owner := owner) capturedHints tailHints)
        (.live owner input answer capture caller tail) ∧
      (code.requiredActions.resume = true →
        Local outward (actions.insert owner code.requiredActions) (introduce phases owner) world
          (.invoke ⟨owner, .resume⟩) (.live (owner := owner) capturedHints tailHints)) ∧
      (code.requiredActions.dispose = true →
        Local outward (actions.insert owner code.requiredActions) (introduce phases owner) world
          (.invoke ⟨owner, .dispose⟩) (.live (owner := owner) capturedHints tailHints)) ∧
      Pending outward (actions.insert owner code.requiredActions) (introduce phases owner) world
        (.live (owner := owner) capturedHints tailHints) .nil .ordinary finalMode ∧
      (∀ needed, checkSelectedRequirements requested operation wholeScope needed =
        checkRequirements tailScope needed) := by
  obtain ⟨capturedScope, tailScope, saved, waiting, sameScope, selection⟩ :=
    matching.erases.cut cut
  obtain ⟨localCapture, localTail, capHints, tailHints, middle, localScope, localHints,
    capMatched, tailMatched, capChecked, tailChecked⟩ := retained.handler_cut matching cut
  obtain ⟨rfl, rfl⟩ := saved.append_scopes_unique capMatched.erases (sameScope.symm.trans localScope)
  have guard := request.request_guard
  obtain ⟨alternatives, selectedScope⟩ : ∃ alternatives,
      select requested operation wholeScope = some (.handler capturedScope tailScope offered alternatives) := by
    cases found : lookupDependencies operation (families handler) with
    | none =>
      have missing : select requested operation wholeScope = none := by
        simpa only [chosen, offeredKnown, found] using selection operation
      cases guard with
      | builtin actual | handler actual => rw [missing] at actual; cases actual
    | some alternatives => exact ⟨alternatives, by simpa only [chosen, offeredKnown, found] using selection operation⟩
  obtain ⟨family, familyKnown⟩ : ∃ family,
      (lookupDependencies operation (families handler)).bind (modeDependencies capturedScope.held) = some family := by
    cases guard with
    | builtin actual => cases Option.some.inj (selectedScope.symm.trans actual)
    | handler actual permitted row body =>
      cases Option.some.inj (selectedScope.symm.trans actual)
      cases found : lookupDependencies operation (families handler) with
      | none =>
        have impossible := (selection operation).symm.trans selectedScope
        simp only [chosen, offeredKnown, found] at impossible
        cases impossible
      | some actualModes =>
        have equal := (selection operation).symm.trans selectedScope
        simp only [chosen, offeredKnown, found] at equal
        cases Option.some.inj equal
        exact ⟨_, by simpa only [found, Option.bind_some] using body⟩
  have permissions := Syntax.fresh_usage_insert_extends (rights := code.requiredActions) fresh
  have oldRetained : Pending outward (actions.insert owner code.requiredActions) phases world
      (.live (owner := owner) capHints tailHints) .nil .ordinary finalMode :=
    .live (SourceDependencySchemes.Lexical.Recursive.pending_transport capChecked
      (fun _ ready => ready) permissions (List.Subset.refl _))
      (SourceDependencySchemes.Lexical.Recursive.pending_transport tailChecked
        (fun _ ready => ready) permissions (List.Subset.refl _))
  have phaseSame := OwnerCaptureContracts.spend_introduced (owner := owner) consumed
  have consumedRetained : Pending outward (actions.insert owner code.requiredActions)
      (spend (introduce phases owner) owner) world (.live (owner := owner) capHints tailHints) .nil .ordinary finalMode :=
    phaseSame.symm ▸ oldRetained
  have known : (actions.insert owner code.requiredActions) owner = some code.requiredActions := by simp [Syntax.UsageTickets.insert]
  have ready : introduce phases owner owner = .available := by simp [introduce]
  have resumeLocal := fun permission => SourceDependencyNeutral.Lexical.Recursive.resume_clause_from_retained
    known permission ready consumedRetained
  have disposeLocal : code.requiredActions.dispose = true → Local outward (actions.insert owner code.requiredActions)
      (introduce phases owner) world (.invoke ⟨owner, .dispose⟩) (.live (owner := owner) capHints tailHints) := by
    intro permission
    obtain ⟨actual, declared, permitted⟩ := SourceTemplates.selected_clause_mode selected modes
    cases Option.some.inj (offeredKnown.symm.trans declared)
    have disposes := permitted permission
    apply SourceDependencyNeutral.Lexical.Recursive.dispose_clause_from_retained known permission ready
      (guard.disposing_unprotected selectedScope disposes) consumedRetained
    rw [phaseSame]
    cases request with
    | request guard callbacks bounded =>
      exact SourceDependencySchemes.Lexical.Recursive.pending_transport
        (callbacks capHints tailHints _ _ localHints selectedScope disposes)
        (fun _ ready => ready) permissions (List.Subset.refl _)
  exact ⟨_, _, capHints, tailHints, family, sameScope, familyKnown, .live capMatched tailMatched,
    resumeLocal, disposeLocal,
    SourceDependencySchemes.Lexical.Recursive.pending_transport oldRetained
      SourceDependencySchemes.introduce_extends (fun _ _ known => known) (List.Subset.refl _),
    fun needed => by simp only [checkSelectedRequirements, selectedScope]⟩

/-- The actual selected source recipe exposes its own finite requirements.
Only this selected mode's list is needed; other operations and stored handlers
are not premises of this compilation result. -/
theorem capture_selected_compiler {hints : ReturnHints wholeScope}
    (cut : HandlerCut requested whole capture tail handler)
    (matching : ReturnHints.Matches tables families hints whole)
    (retained : Pending outward actions phases world hints .nil .ordinary finalMode)
    (request : Local outward actions phases world (.request requested operation) hints)
    (declarations : ClauseDeclarations outward handler.clauses (families handler) required)
    (modes : SourceTemplates.ClauseModes handler.clauses (tables handler))
    (selected : ClauseAt operation handler.clauses parameter binder code)
    (offeredKnown : lookup operation (tables handler) = some offered)
    (fresh : actions owner = none) (consumed : phases owner = .consumed) :
    ∃ capturedScope tailScope, ∃ capturedHints : ReturnHints capturedScope,
    ∃ tailHints : ReturnHints tailScope, ∃ family needed,
      wholeScope = capturedScope.append tailScope ∧
      (lookupDependencies operation (families handler)).bind (modeDependencies capturedScope.held) = some family ∧
      ReturnHints.Matches tables families (.live (owner := owner) capturedHints tailHints)
        (.live owner input answer capture caller tail) ∧
      ClauseRecipe outward code.requiredActions needed family ∧ needed ⊆ required ∧
      (∀ requestedRequirements, checkSelectedRequirements requested operation wholeScope requestedRequirements =
        checkRequirements tailScope requestedRequirements) ∧
      (checkSelectedRequirements requested operation wholeScope needed = true →
        Local outward (actions.insert owner code.requiredActions) (introduce phases owner) world
          (family owner) (.live (owner := owner) capturedHints tailHints)) ∧
      Pending outward (actions.insert owner code.requiredActions) (introduce phases owner) world
        (.live (owner := owner) capturedHints tailHints) .nil .ordinary finalMode := by
  obtain ⟨capturedScope, tailScope, capturedHints, tailHints, family, sameScope, familyKnown,
    matched, resumeLocal, disposeLocal, nextPending, selectedCheck⟩ :=
    capture_primitive_interface (input := input) (answer := answer) cut matching retained request
      modes selected offeredKnown fresh consumed
  obtain ⟨needed, recipe, included⟩ := declarations.selected selected familyKnown
  refine ⟨_, _, capturedHints, tailHints, family, needed, sameScope, familyKnown, matched,
    recipe, included, selectedCheck, ?_, nextPending⟩
  intro checked
  exact recipe.compile ((selectedCheck needed) ▸ checked) resumeLocal disposeLocal

/-- A handler-wide finite annotation is a convenient sufficient input, while
the compiler above exposes the smaller selected-mode requirement list. This
wrapper still assumes no whole forest or successor-clause check. -/
theorem capture_selected_declaration {hints : ReturnHints wholeScope}
    (cut : HandlerCut requested whole capture tail handler)
    (matching : ReturnHints.Matches tables families hints whole)
    (retained : Pending outward actions phases world hints .nil .ordinary finalMode)
    (request : Local outward actions phases world (.request requested operation) hints)
    (declarations : ClauseDeclarations outward handler.clauses (families handler) required)
    (supplied : checkSelectedRequirements requested operation wholeScope required = true)
    (modes : SourceTemplates.ClauseModes handler.clauses (tables handler))
    (selected : ClauseAt operation handler.clauses parameter binder code)
    (offeredKnown : lookup operation (tables handler) = some offered)
    (fresh : actions owner = none) (consumed : phases owner = .consumed) :
    ∃ capturedScope tailScope, ∃ capturedHints : ReturnHints capturedScope,
    ∃ tailHints : ReturnHints tailScope, ∃ family,
      wholeScope = capturedScope.append tailScope ∧
      (lookupDependencies operation (families handler)).bind (modeDependencies capturedScope.held) = some family ∧
      ReturnHints.Matches tables families (.live (owner := owner) capturedHints tailHints)
        (.live owner input answer capture caller tail) ∧
      Local outward (actions.insert owner code.requiredActions) (introduce phases owner) world
        (family owner) (.live (owner := owner) capturedHints tailHints) ∧
      Pending outward (actions.insert owner code.requiredActions) (introduce phases owner) world
        (.live (owner := owner) capturedHints tailHints) .nil .ordinary finalMode := by
  obtain ⟨capturedScope, tailScope, capturedHints, tailHints, family, needed, sameScope,
    familyKnown, matched, recipe, included, selectedCheck, compile, nextPending⟩ :=
    capture_selected_compiler (input := input) (answer := answer) cut matching retained request
      declarations modes selected offeredKnown fresh consumed
  refine ⟨_, _, capturedHints, tailHints, family, sameScope, familyKnown, matched, compile ?_, nextPending⟩
  rw [selectedCheck]
  exact SourceContextualRequirements.check_requirements_subset included ((selectedCheck required) ▸ supplied)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SelectedRequirements
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SelectedRequirements.capture_primitive_interface

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SelectedRequirements.capture_selected_compiler
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SelectedRequirements.capture_selected_declaration

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Recover the rich cleanup evidence of an exact, projectable decorated
prefix from the original retained source. The suffix may contain running
return markers; no whole-stack closing premise is required. -/
theorem PendingRows.closing_prefix
    {whole : ReturnHints scope} {context : Context whole}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context) :
    ∀ {firstScope secondScope} {first : ReturnHints firstScope} {second : ReturnHints secondScope}
      (head : Context first) (tail : Context second),
      context.pack = (head.append tail).pack →
      ∀ {metadata}, head.closing? = some metadata →
    ∃ captured rest, stack = captured.append rest ∧
      Context.PlannedClosing operations policy contracts tables families required outward actions world head captured ∧
      Context.Source operations.erase policy contracts.erase tables families world tail rest := by
  induction rows with
  | nil =>
      intro firstScope secondScope first second head tail same metadata found
      cases head <;> cases same
      exact ⟨.nil, .nil, rfl, .nil, .nil⟩
  | push frame remaining ih =>
      have whole := frame.source remaining.source
      cases frame with
      | ordinary checked | handler checked =>
          cases checked
          all_goals
            intro firstScope secondScope first second head tail same metadata found
            cases head <;> cases same
            all_goals first
            | exact ⟨.nil, _, rfl, .nil, whole⟩
            | cases found
            | simp only [Context.closing?, Option.map_eq_some_iff] at found
              obtain ⟨tailMetadata, tailFound, _⟩ := found
              obtain ⟨captured, outside, equal, inside, restSource⟩ := ih _ _ rfl tailFound
              subst_vars
              first
              | exact ⟨_, _, rfl, .plain inside, restSource⟩
              | exact ⟨_, _, rfl, .handler (by constructor <;> assumption) inside, restSource⟩
              | exact ⟨_, _, rfl, .cell inside, restSource⟩
              | exact ⟨_, _, rfl, .cleanup (by assumption) (by assumption) inside, restSource⟩
              | exact ⟨_, _, rfl, .retiring inside, restSource⟩
      | unwinding checked | closing | retiring | skipped | cell | cleanup checked =>
          intro firstScope secondScope first second head tail same metadata found
          cases head <;> cases same
          all_goals first
          | exact ⟨.nil, _, rfl, .nil, whole⟩
          | cases found
          | simp only [Context.closing?, Option.map_eq_some_iff] at found
            obtain ⟨tailMetadata, tailFound, _⟩ := found
            obtain ⟨captured, outside, equal, inside, restSource⟩ := ih _ _ rfl tailFound
            subst_vars
            first
            | exact ⟨_, _, rfl, .plain inside, restSource⟩
            | exact ⟨_, _, rfl, .cell inside, restSource⟩
            | exact ⟨_, _, rfl, .cleanup (by assumption) (by assumption) inside, restSource⟩
            | exact ⟨_, _, rfl, .retiring inside, restSource⟩
  | live aligned saved remaining ihSaved ihTail | opening saved remaining ihSaved ihTail =>
      intro firstScope secondScope first second head tail same metadata found
      cases head <;> cases same
      · exact ⟨.nil, _, rfl, .nil, .live saved.source remaining.source⟩
      · obtain ⟨⟨savedMetadata, savedFound⟩, ⟨tailMetadata, tailFound⟩⟩ := live_closing_parts found
        obtain ⟨captured, outside, equal, inside, restSource⟩ := ihTail _ _ rfl tailFound
        subst_vars
        exact ⟨_, _, rfl, .live (saved.planned_closing savedFound) inside, restSource⟩
  | spent remaining ih | skippedSpent remaining ih =>
      intro firstScope secondScope first second head tail same metadata found
      cases head <;> cases same
      · exact ⟨.nil, _, rfl, .nil, .spent remaining.source⟩
      · simp only [Context.closing?, Option.map_eq_some_iff] at found
        obtain ⟨tailMetadata, tailFound, _⟩ := found
        obtain ⟨captured, outside, equal, inside, restSource⟩ := ih _ _ rfl tailFound
        subst_vars
        exact ⟨_, _, rfl, .spent inside, restSource⟩

/-- The actual nearest-handler cut inherits cleanup evidence from the whole
pending stack; it does not supply a newly chosen callback/source witness. -/
theorem PendingRows.cut_closing
    {whole : ReturnHints scope} {context : Context whole}
    {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {head : Context first} {tail : Context second}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (cut : Cut effect operation context head tail contract modes)
    (found : head.closing? = some metadata) :
    ∃ captured rest, stack = captured.append rest ∧
      Context.PlannedClosing operations policy contracts tables families required outward actions world head captured ∧
      Context.Source operations.erase policy contracts.erase tables families world tail rest :=
  rows.closing_prefix head tail cut.decomposition found

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.closing_prefix

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.cut_closing

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open RecursiveRequirements (Requirements Checked)

/-- The actual request and coherent whole pending state supply capture's rich
cleanup witness and all generated paths. The remaining receiver may contain
active callbacks; only the captured prefix must project to cleanup metadata. -/
theorem Admitted.capture_from_pending
    {operandSignature : Signature operandDependencies} {operandRows : Rows operandSignature}
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    {pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value result) output pendingDemand pendingRequirements wholeScope}
    (admitted : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families whole stack
      (.perform (Instantiation.freezeEffect effect) operation operand) result demand requirements
      (.sequence operandSignature (.request (effect := effect) (operation := operation))) resultRows
      (.sequence operandRows (.request (effect := effect) (operation := operation))))
    (coherent : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      pending (.value resultRows) outputRows whole)
    (cut : Cut effect operation whole captured tail contract modes)
    (consuming : contract.dispose = true) :
    ∃ capStack tailStack, ∃ metadata : CleanupHints.Metadata captureScope,
      stack = capStack.append tailStack ∧ captured.closing? = some metadata ∧
      PlannedUnwindSource operations policy contracts tables families required outward actions world capStack
        metadata.closing.1 metadata.closing.2 captureScope ∧
      ∀ resumeDemand (normalRequirements annotated : Requirements resumeDemand) entries normalRow,
        resumeDemand.Perm (ownedTickets capStack) →
        (ownedTickets capStack).Nodup →
        (∀ owner ∈ ownedTickets capStack, phases owner = .available) →
        RowAnnotation normalRequirements annotated →
        Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tailStack) phases
          (annotateDisposals annotated) normalRow → normalRow ⊆ budget →
        ∃ combined : Requirements resumeDemand, ∃ row,
          RowAnnotation normalRequirements (annotateDisposals combined) ∧
          RequirementPath (annotateDisposals annotated) (annotateDisposals combined) [] ∧
          RequirementPath metadata.closing.2 (annotateDisposals combined) [] ∧
          RequirementPath (metadata.closing.2.prepend [.ordinary (.barrier true)]) (annotateDisposals combined) [] ∧
          Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tailStack) phases
            (annotateDisposals combined) row ∧ row ⊆ budget := by
  cases admitted.cleanupBudget with
  | sequence operandBudget requestBudget =>
    cases requestBudget with
    | request retained =>
      obtain ⟨metadata, projected, ordinary, protectedCheck⟩ := retained.consuming cut consuming
      obtain ⟨capStack, tailStack, decomposition, planned, tailSource⟩ :=
        coherent.closing_prefix captured tail cut.decomposition projected
      have agreed := planned.source.closing_agreement projected
      obtain ⟨ordinaryEffects, protectedEffects⟩ := agreed.effects_pair ordinary protectedCheck
      refine ⟨capStack, tailStack, metadata, decomposition, projected, planned.planned projected, ?_⟩
      intro resumeDemand normalRequirements annotated entries normalRow balance unique ready normal checked bounded
      apply capture_annotation_from_effects agreed.source.template balance unique ready normal checked bounded
      · simpa only [tailSource.context_eq] using ordinaryEffects
      · simpa only [tailSource.context_eq, List.singleton_append] using protectedEffects

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.capture_from_pending

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open SourcePlannedTyping (Operations Contracts Value)
open SourcePlanSignatures (Signature)

private theorem pending_body_world
    (source : SourcePlannedSources.Body operations policy contracts world allowed scope environment code value header checking)
    (larger : world ⊆ nextWorld) :
    SourcePlannedSources.Body operations policy contracts nextWorld allowed scope environment code value header checking := by
  cases source with
  | typed expression rows closingRows => exact .typed (SourcePlannedSources.expression_world_weaken expression larger) rows closingRows

private theorem pending_offer_world
    (source : SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
      resumeEffects closeEffects code held disposes row plans)
    (larger : world ⊆ nextWorld) :
    SourcePlannedSources.Offer operations policy contracts nextWorld environment allowed parameter binder argument input answer
      resumeEffects closeEffects code held disposes row plans := by
  cases source with
  | unavailable => exact .unavailable
  | available resumeInterface closeInterface family =>
      exact .available resumeInterface closeInterface
        (fun owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance =>
          pending_body_world (family owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance) larger)

private theorem auth_body_pending_world
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {answerRows : ValueRows answer} {rows : Rows checking}
    (checked : AuthBody operations policy ports owners environmentRows answerRows
      (source : SourcePlannedSources.Body operations policy contracts world allowed scope environment code answer header checking) rows)
    (larger : world ⊆ nextWorld) :
    AuthBody operations policy ports owners environmentRows answerRows (pending_body_world source larger) rows := by
  cases checked with
  | typed body => exact .typed (body.world_weaken larger) (rows := by assumption) (closingRows := by assumption)

private theorem auth_offer_pending_world
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {argumentRows : ValueRows argument} {inputRows : ValueRows input} {answerRows : ValueRows answer}
    {rows : ModeRows (SourcePlanSignatures.modeSignatures plans)}
    (checked : AuthOffer operations policy ports owners environmentRows argumentRows inputRows answerRows
      (source : SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
        resumeEffects closeEffects code held disposes row plans) rows)
    (larger : world ⊆ nextWorld) :
    AuthOffer operations policy ports owners environmentRows argumentRows inputRows answerRows (pending_offer_world source larger) rows := by
  cases checked with
  | unavailable => exact .unavailable
  | available body =>
      exact .available (fun owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance =>
        auth_body_pending_world (body owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance) larger)
        (resumeInterface := by assumption) (closeInterface := by assumption)

/-- Clause metadata reuses expression world weakening at the authenticated
body leaves; no expression-authentication induction is repeated here. -/
theorem AuthDeclarations.world_weaken
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {plans : SourceDeclarationPlans.ClausePlans clauses families}
    {answerRows : ValueRows answer} {rows : ClauseRows (SourcePlanSignatures.clauseSignatures plans)}
    {source : SourcePlannedSources.Declarations operations policy contracts world environment allowed effect answer clauses table plans}
    (checked : AuthDeclarations operations policy ports owners environmentRows answerRows source rows)
    (larger : world ⊆ nextWorld) :
    AuthDeclarations operations policy ports owners environmentRows answerRows
      (declarations_world_weaken (plans := plans) source larger) rows := by
  induction clauses using Clauses.rec (motive_1 := fun _ => True) generalizing table families with
  | nil => cases checked; exact .nil
  | cons operation parameter binder code rest ihCode ihRest =>
      cases checked with
      | cons ordinary protectedMode rest support =>
        exact .cons (auth_offer_pending_world ordinary larger) (auth_offer_pending_world protectedMode larger)
          (ihRest rest) support (known := by assumption)
  | _ => trivial

/-- Context weakening preserves the same hole/output metadata and waiting rows. -/
theorem AuthContext.world_weaken
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : AuthContext operations policy ports owners environmentRows
      (source : SourcePlannedSources.Context operations policy contracts world environment allowed scope
        position input output demand requirements checking) inputRows outputRows rows)
    (larger : world ⊆ nextWorld) :
    AuthContext operations policy ports owners environmentRows
      (context_world_weaken source larger) inputRows outputRows rows := by
  cases checked with
  | pairLeft right => exact .pairLeft (right.world_weaken larger)
  | pairRight left => exact .pairRight (left.world_weaken larger)
  | appFunction argument => exact .appFunction (argument.world_weaken larger) (admitted := by assumption)
  | appArgument function => exact .appArgument (function.world_weaken larger) (admitted := by assumption)
  | bind body => exact .bind (body.world_weaken larger)
  | branch yes no => exact .branch (yes.world_weaken larger) (no.world_weaken larger) (same := by assumption)
  | perform =>
      exact .perform (known := by assumption) (admitted := by assumption)
        (formed := ScopedPorts.in_world_mono (by assumption) larger)
  | resume =>
      exact .resume (known := by assumption) (resolved := by assumption) (permission := by assumption)
        (admitted := by assumption) (formed := ScopedPorts.in_world_mono (by assumption) larger)
  | cleanup body => exact .cleanup (body.world_weaken larger) (admitted := by assumption)
  | resource body =>
      exact .resource (fun identity fresh => (body identity (fun member => fresh (larger member))).world_weaken
        (ScopedExpressions.append_subset larger (List.Subset.refl _)))
        (formed := ScopedPorts.in_world_mono (by assumption) larger)
        (effectsBound := List.Subset.trans (by assumption) larger) (admitted := by assumption)
        (hidden := fun identity fresh => by apply_assumption; exact fun member => fresh (larger member))

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
