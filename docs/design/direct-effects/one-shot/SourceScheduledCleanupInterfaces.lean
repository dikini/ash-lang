/-- Reindex only by equality of the complete decorated receiving context. -/
theorem Code.reindex_context {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {context : Context first} {next : Context second}
    (checked : Code outward actions budget phases world installations rows context) (same : context.pack = next.pack) :
    Code outward actions budget phases world installations rows next := by
  change Code outward actions budget phases world installations rows context.pack.context at checked
  rw [same] at checked
  exact checked

/-- Reindex only the external suffix, retaining every pending scope and mode. -/
theorem Pending.reindex_outside {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {outside : Context first} {next : Context second}
    (checked : Pending outward actions budget phases world installations context outside before after)
    (same : outside.pack = next.pack) : Pending outward actions budget phases world installations context next before after := by
  change Pending outward actions budget phases world installations context outside.pack.context before after at checked
  rw [same] at checked
  exact checked

/-- Recomposition preserves the actual lexical receiver used by every source
check, including saved continuations and their retirement boundary. -/
theorem Pending.append {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {external : ReturnHints externalScope} {head : Context first} {tail : Context second} {outside : Context external}
    (inside : Pending outward actions budget phases world installations head (tail.append outside) before middle)
    (remaining : Pending outward actions budget phases world installations tail outside middle after) :
    Pending outward actions budget phases world installations (head.append tail) outside before after := by
  induction head generalizing before middle after with
  | nil => cases inside; exact remaining
  | plain rows rest ih => cases inside with
    | plain code next => exact .plain (code.reindex_context (rest.append_assoc_pack tail outside).symm) (ih next remaining)
    | skipped next => exact .skipped (ih next remaining)
  | handler activation rows rest ih => cases inside with
    | handler next => exact .handler (ih next remaining)
  | cell rest ih => cases inside with
    | cell next => exact .cell (ih next remaining)
  | cleanup latent rows rest ih => cases inside with
    | cleanup callback next =>
        exact .cleanup
          (callback.reindex_context (congrArg (fun p : Packed => (p.context.callback before).pack)
          (rest.append_assoc_pack tail outside).symm)) (ih next remaining)
  | normal rest ih => cases inside with
    | normal next => exact .normal (ih next remaining)
  | unwinding rest ih => cases inside with
    | unwinding next => exact .unwinding (ih next remaining)
  | closing rest ih => cases inside with
    | closing next => exact .closing (ih next remaining)
  | retiring owner rest ih => cases inside with
    | retiring next => exact .retiring (ih next remaining)
  | live saved rest ihSaved ihRest => cases inside with
    | live captured next =>
        exact .live
          (captured.reindex_outside (rest.append_assoc_pack tail outside).symm) (ihRest next remaining)
    | opening captured next =>
        exact .opening
          (captured.reindex_outside (congrArg (fun p : Packed => (Context.retiring _ p.context).pack)
          (rest.append_assoc_pack tail outside).symm)) (ihRest next remaining)
  | spent rest ih => cases inside with
    | spent next => exact .spent (ih next remaining)

/-- Splitting at an exact decorated boundary produces the intermediate return
mode and retains existing checks at their original lexical receiver. -/
theorem Pending.split {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {external : ReturnHints externalScope} {head : Context first} {tail : Context second} {outside : Context external}
    (checked : Pending outward actions budget phases world installations (head.append tail) outside before after) :
    ∃ middle : UseMode,
      Pending outward actions budget phases world installations head (tail.append outside) before middle ∧
      Pending outward actions budget phases world installations tail outside middle after := by
  induction head generalizing before after with
  | nil => exact ⟨before, .nil, checked⟩
  | plain rows rest ih => cases checked with
    | plain code next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .plain (code.reindex_context (rest.append_assoc_pack tail outside)) inside, remaining⟩
    | skipped next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .skipped inside, remaining⟩
  | handler activation rows rest ih => cases checked with
    | handler next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .handler inside, remaining⟩
  | cell rest ih => cases checked with
    | cell next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .cell inside, remaining⟩
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .cleanup
            (callback.reindex_context (congrArg (fun p : Packed => (p.context.callback before).pack)
            (rest.append_assoc_pack tail outside))) inside, remaining⟩
  | normal rest ih => cases checked with
    | normal next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .normal inside, remaining⟩
  | unwinding rest ih => cases checked with
    | unwinding next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .unwinding inside, remaining⟩
  | closing rest ih => cases checked with
    | closing next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .closing inside, remaining⟩
  | retiring owner rest ih => cases checked with
    | retiring next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .retiring inside, remaining⟩
  | live saved rest ihSaved ihRest => cases checked with
    | live captured next =>
        obtain ⟨middle, inside, remaining⟩ := ihRest next
        exact ⟨middle, .live (captured.reindex_outside (rest.append_assoc_pack tail outside)) inside, remaining⟩
    | opening captured next =>
        obtain ⟨middle, inside, remaining⟩ := ihRest next
        exact ⟨middle, .opening
            (captured.reindex_outside (congrArg (fun p : Packed => (Context.retiring _ p.context).pack)
            (rest.append_assoc_pack tail outside))) inside, remaining⟩
  | spent rest ih => cases checked with
    | spent next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .spent inside, remaining⟩

/-- Reindex the complete pending context, retaining its exact external receiver. -/
theorem Pending.reindex_context {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {context : Context first} {next : Context second}
    (checked : Pending outward actions budget phases world installations context outside before after)
    (same : context.pack = next.pack) :
    Pending outward actions budget phases world installations next outside before after := by
  change Pending outward actions budget phases world installations context.pack.context outside before after at checked
  rw [same] at checked
  exact checked

/-- A selected cut splits existing source evidence at its exact decorated
boundary; the captured computation retains its original lexical tail. -/
theorem Pending.at_cut
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (checked : Pending outward actions budget phases world installations whole .nil .ordinary finalMode)
    (cut : Cut effect operation whole captured tail contract modes) :
    ∃ middle : UseMode,
      Pending outward actions budget phases world installations captured tail .ordinary middle ∧
      Pending outward actions budget phases world installations tail .nil middle finalMode := by
  obtain ⟨middle, inside, remaining⟩ := (checked.reindex_context cut.decomposition).split
  exact ⟨middle, inside.reindex_outside tail.append_nil_pack, remaining⟩

/-- A disposing request exposes its existing callback source at the very same
selected capture and lexical closing receiver. -/
theorem Code.callbacks_at_cut
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (checked : Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole)
    (cut : Cut effect operation whole captured tail contract modes)
    (disposing : contract.dispose = true) :
    Pending outward actions budget phases world installations captured (.closing tail) .unwind .unwind := by
  cases checked with
  | builtin found =>
      have incompatible := found.symm.trans cut
      cases incompatible
  | request actualCut guarded callbacks ownerBound cleanupBudget selected terminal rights retained body =>
      obtain ⟨sameCapture, sameTail, sameContract, sameModes⟩ := actualCut.unique cut
      cases sameContract
      exact ((callbacks disposing).reindex_context sameCapture).reindex_outside
        (congrArg (fun packed : Packed => (Context.closing packed.context).pack) sameTail)

