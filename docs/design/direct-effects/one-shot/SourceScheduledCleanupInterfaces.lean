    (captured := Context.spent (owner := owner) inherited) (tail := Context.nil) (contract := ordinary)
    (modes := (some (fun owner => .invoke ⟨owner, .resume⟩), none)) (cut := rfl)
    (bodyRows := fun owner => Rows.invoke (key := ⟨owner, .resume⟩))
    (declarationRows := declarations) (rights := ⟨true, false⟩)
