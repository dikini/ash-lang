namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourcePlannedTyping (Value Environment Operations Contract Contracts)
open SourceDeclarationPlans (Plan ModePlans ClausePlans)
open SourcePlanSignatures (Signature signature modeSignatures clauseSignatures substituteClauses substitution_signature)

/-- Retarget only the signature index along the established closed-substitution
identity. The row decoration itself is retained. -/
def ClauseRows.substitute {plans : ClausePlans clauses families}
    (rows : ClauseRows (clauseSignatures plans)) (name : Nat) (value : Code) (isValue : value.IsValue) :
    ClauseRows (clauseSignatures (substituteClauses plans name value)) :=
  (substitution_signature plans (name := name) isValue).symm ▸ rows

theorem ClauseRows.substitute_heq {plans : ClausePlans clauses families}
    (rows : ClauseRows (clauseSignatures plans)) (name : Nat) (value : Code) (isValue : value.IsValue) :
    HEq (rows.substitute name value isValue) rows := by
  exact eqRec_heq _ _

/-- Reuse an established signature identity while retaining the same row data. -/
private theorem Auth.signature_transport
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {first second : Signature dependencies} {firstRows : Rows first} {secondRows : Rows second}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      code value demand requirements first}
    (checked : Auth operations policy ports owners environmentRows source valueRows firstRows)
    (same : first = second) (aligned : HEq firstRows secondRows) :
    ∃ next : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      code value demand requirements second,
      Auth operations policy ports owners environmentRows next valueRows secondRows := by
  cases same
  cases eq_of_heq aligned
  exact ⟨source, checked⟩

private theorem AuthDeclarations.rows_transport
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {plans : ClausePlans clauses families}
    {rows nextRows : ClauseRows (clauseSignatures plans)}
    {source : SourcePlannedSources.Declarations operations policy contracts world environment allowed requested answer clauses table plans}
    (checked : AuthDeclarations operations policy ports owners environmentRows answerRows source rows)
    (aligned : HEq rows nextRows) :
    AuthDeclarations operations policy ports owners environmentRows answerRows source nextRows := by
  cases eq_of_heq aligned
  exact checked

private theorem Auth.environment_cast
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment} {nextRows : EnvironmentRows nextEnvironment}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (same : environment = nextEnvironment) (metadata : (same ▸ environmentRows) = nextRows) :
    Auth operations policy ports owners nextRows
      (SourcePlannedSources.expression_environment_congr source (fun name _ => congrFun same name)) valueRows rows := by
  cases same
  cases metadata
  exact checked

private theorem Auth.code_transport
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      code value demand requirements checking}
    (checked : Auth operations policy ports owners environmentRows source valueRows rows)
    (same : code = nextCode) :
    ∃ next : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      nextCode value demand requirements checking,
      Auth operations policy ports owners environmentRows next valueRows rows := by
  cases same
  exact ⟨source, checked⟩

private theorem AuthBody.transport
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment} {nextRows : EnvironmentRows nextEnvironment}
    {source : SourcePlannedSources.Body operations policy contracts world allowed scope environment
      code value header checking}
    (checked : AuthBody operations policy ports owners environmentRows valueRows source rows)
    (same : environment = nextEnvironment) (metadata : (same ▸ environmentRows) = nextRows)
    (codeSame : code = nextCode) :
    ∃ next : SourcePlannedSources.Body operations policy contracts world allowed scope nextEnvironment
      nextCode value header checking,
      AuthBody operations policy ports owners nextRows valueRows next rows := by
  cases same
  cases metadata
  cases codeSame
  exact ⟨source, checked⟩

private theorem source_body_substitution_at
    (source : SourcePlannedSources.Body operations policy contracts world allowed scope sourceEnvironment
      code result header checking)
    (same : sourceEnvironment = environment.extend name input)
    (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input)
    (closed : ClosedValue value) :
    SourcePlannedSources.Body operations policy contracts world allowed scope environment
      (code.subst name value) result header checking := by
  cases same
  cases source with
  | typed expression rows closingRows =>
      exact .typed (SourcePlannedSources.substitution expression replacement closed) rows closingRows


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourceDeclarationPlans (Plan ModePlans ClausePlans)
open SourcePlanSignatures (Signature ModeSignatures ClauseSignatures signature modeSignatures clauseSignatures substituteClauses substitution_signature)

@[simp] theorem ClauseRows.substitute_nil (name : Nat) (value : Code) (isValue : value.IsValue) :
    ClauseRows.substitute (plans := ClausePlans.nil) ClauseRows.nil name value isValue = .nil := rfl

/-- Clause constructors preserve their decorations across an explicit stable
signature equality; heterogeneous equality changes only the index. -/
theorem ClauseRows.cons_heq {supportBound : List Nat}
    {first second : ClauseSignatures families} (same : first = second)
    {firstRows : ClauseRows first} {secondRows : ClauseRows second} (aligned : HEq firstRows secondRows)
    (rightsSame : firstRights = secondRights)
    (ordinaryRows : ModeRows ordinary) (protectedRows : ModeRows protectedMode) :
    HEq (ClauseRows.cons (supportBound := supportBound) (operation := operation) (rights := firstRights) ordinaryRows protectedRows firstRows)
      (ClauseRows.cons (supportBound := supportBound) (operation := operation) (rights := secondRights) ordinaryRows protectedRows secondRows) := by
  cases same
  cases rightsSame
  cases eq_of_heq aligned
  rfl

/-- A substituted declaration cons uses exactly the existing decorations.
Only its tail index and syntactic body's required-actions index are transported. -/
theorem ClauseRows.substitute_cons_heq {supportBound : List Nat}
    {ordinaryPlan : ModePlans ordinary} {protectedPlan : ModePlans protectedMode}
    {restPlan : ClausePlans clauses families}
    (ordinaryRows : ModeRows (modeSignatures ordinaryPlan))
    (protectedRows : ModeRows (modeSignatures protectedPlan))
    (restRows : ClauseRows (clauseSignatures restPlan))
    (name parameter binder operation : Nat) (body value : Code) (isValue : value.IsValue) :
    HEq (ClauseRows.cons (supportBound := supportBound) (operation := operation)
        (rights := (if name = parameter then body else body.subst name value).requiredActions)
        ordinaryRows protectedRows (restRows.substitute name value isValue))
      (ClauseRows.substitute (plans := ClausePlans.cons (operation := operation) (parameter := parameter)
        (binder := binder) (body := body) ordinaryPlan protectedPlan restPlan)
        (ClauseRows.cons (supportBound := supportBound) (operation := operation) (rights := body.requiredActions)
          ordinaryRows protectedRows restRows) name value isValue) := by
  have rights : (if name = parameter then body else body.subst name value).requiredActions = body.requiredActions := by
    split
    · rfl
    · exact Code.substitution_required_actions body name isValue
  exact (ClauseRows.cons_heq (substitution_signature restPlan (name := name) isValue)
    (restRows.substitute_heq name value isValue) rights ordinaryRows protectedRows).trans
      (ClauseRows.substitute_heq (plans := ClausePlans.cons (operation := operation)
        (parameter := parameter) (binder := binder) (body := body) ordinaryPlan protectedPlan restPlan)
        _ name value isValue).symm

/-- A handler's row decoration transports along exactly the same clause
signature equality already used by its source typing. -/
theorem Rows.handler_heq
    {first second : ClauseSignatures families} (same : first = second)
    {firstRows : ClauseRows first} {secondRows : ClauseRows second} (aligned : HEq firstRows secondRows)
    (bodyRows : Rows body) :
    HEq (Rows.handler (effect := effect) (table := table) (required := required) firstRows bodyRows)
      (Rows.handler (effect := effect) (table := table) (required := required) secondRows bodyRows) := by
  cases same
  cases eq_of_heq aligned
  rfl

theorem Rows.handler_substitute_heq
    {plans : ClausePlans clauses families} (declarations : ClauseRows (clauseSignatures plans))
    (bodyRows : Rows body) (name : Nat) (value : Code) (isValue : value.IsValue) :
    HEq (Rows.handler (effect := effect) (table := table) (required := required)
        (declarations.substitute name value isValue) bodyRows)
      (Rows.handler (effect := effect) (table := table) (required := required) declarations bodyRows) :=
  Rows.handler_heq (substitution_signature plans (name := name) isValue)
    (declarations.substitute_heq name value isValue) bodyRows

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
