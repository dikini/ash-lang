theorem FrameRows.contract_extension
    {frame : CertifiedFrame (evidence := declarationPolicy.accepts outward)
      operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing}
    (checked : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (extension : contracts.Extends nextContracts) (nextOwners : ContractRows nextContracts)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    FrameRows operations policy nextContracts tables families required outward world ports nextOwners emptyRows
      (frame.transport extension) inputRows outputRows tail decorated := by
  have portExtension := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension (erased_extension extension))
  have typeExtension := ScopedPorts.effect_extension_has_type_extension portExtension
  cases checked with
  | plain authenticated =>
      exact .plain (authenticated.contract_extension extension nextOwners compatible)
        (scopeKnown := ScopedPorts.effect_scope_extension (by assumption) portExtension)
        (inputAnnotation := by assumption) (outputAnnotation := by assumption) (certified := by assumption)
  | handler authenticated =>
      exact .handler (authenticated.contract_extension extension nextOwners compatible)
        (scopeKnown := ScopedPorts.effect_scope_known_extension (by assumption) portExtension)
        (annotation := by assumption) (clauses := by assumption) (coverage := by assumption)
        (unique := by assumption) (recipes := by assumption) (capabilities := by assumption)
        (modes := by assumption) (certified := by assumption)
  | cell =>
      exact .cell (scopeKnown := ScopedPorts.scope_known_extension (by assumption) typeExtension)
        (noEscape := by assumption) (annotation := by assumption)
        (interface := ScopedPorts.effect_frame_extension (by assumption) portExtension)
  | armed authenticated =>
      exact .armed (authenticated.contract_extension extension nextOwners compatible)
        (scopeKnown := ScopedPorts.scope_known_extension (by assumption) typeExtension)
        (annotation := by assumption) (interface := ScopedPorts.effect_frame_extension (by assumption) portExtension)
        (certified := by assumption)
  | running callback saved =>
      exact .running (callback.contract_extension extension nextOwners compatible)
        (saved.contract_extension extension nextOwners compatible)
        (scopeKnown := ScopedPorts.scope_known_extension (by assumption) typeExtension)
        (annotation := by assumption) (interface := ScopedPorts.effect_frame_extension (by assumption) portExtension)
  | closing =>
      exact .closing (scopeKnown := ScopedPorts.scope_known_extension (by assumption) typeExtension)
        (interface := ScopedPorts.effect_frame_extension (by assumption) portExtension)
  | retiring =>
      exact .retiring (known := extension _ _ (by assumption))
        (interface := ScopedPorts.effect_frame_extension (by assumption) portExtension)

theorem ModeFrameRows.contract_extension
    {frame : PlannedModeFrame operations policy contracts tables families required outward world
      entry input output demand requirements layer}
    (checked : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (extension : contracts.Extends nextContracts) (nextOwners : ContractRows nextContracts)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    ModeFrameRows operations policy nextContracts tables families required outward world ports nextOwners emptyRows
      (frame.transport extension) inputRows outputRows tail decorated := by
  have portExtension := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension (erased_extension extension))
  cases checked with
  | ordinary authenticated => exact .ordinary (authenticated.contract_extension extension nextOwners compatible)
  | handler authenticated => exact .handler (authenticated.contract_extension extension nextOwners compatible)
  | unwinding authenticated => exact .unwinding (authenticated.contract_extension extension nextOwners compatible) (certified := by assumption)
  | cleanup authenticated => exact .cleanup (authenticated.contract_extension extension nextOwners compatible) (certified := by assumption)
  | closing => exact .closing (scopeKnown := ScopedPorts.effect_scope_known_extension (by assumption) portExtension)
  | retiring => exact .retiring
  | skipped => exact .skipped
  | cell => exact .cell

theorem RecordPendingRows.contract_extension
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      source inputRows outputRows context)
    (extension : contracts.Extends nextContracts) (permissions : Syntax.UsageExtension actions nextActions)
    (nextOwners : ContractRows nextContracts)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    RecordPendingRows operations policy nextContracts tables families required outward nextActions world ports nextOwners emptyRows resumes
      (source.transport extension permissions) inputRows outputRows context := by
  have portExtension := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension (erased_extension extension))
  induction checked with
  | nil => exact .nil
  | push head tail ih => exact .push (head.contract_extension extension nextOwners compatible) ih
  | live answerRows agreement inside tail ihInside ihTail =>
      have same := compatible _ _ (by assumption)
      have nextInside := ihInside
      rw [← same] at nextInside answerRows
      simpa only [same] using (RecordPendingRows.live answerRows agreement nextInside ihTail
        (known := extension _ _ (by assumption)) (actionKnown := permissions _ _ (by assumption))
        (inputAnnotation := by assumption) (answerAnnotation := by assumption)
        (callerScope := ScopedPorts.effect_scope_known_extension (by assumption) portExtension)
        (held := by assumption) (answer := by assumption))
  | opening answerRows agreement ordinary inside tail ihOrdinary ihInside ihTail =>
      have same := compatible _ _ (by assumption)
      have nextOrdinary := ihOrdinary
      rw [← same] at nextOrdinary answerRows
      exact .opening answerRows agreement nextOrdinary ihInside ihTail
        (known := extension _ _ (by assumption)) (actionKnown := permissions _ _ (by assumption))
        (inputAnnotation := by assumption) (answerAnnotation := by assumption)
        (callerScope := ScopedPorts.effect_scope_known_extension (by assumption) portExtension)
        (held := by assumption) (answer := by assumption)
  | spent tail ih =>
      have same := compatible _ _ (by assumption)
      have nextTail := ih
      rw [← same] at nextTail
      simpa only [same] using (RecordPendingRows.spent nextTail
        (known := extension _ _ (by assumption)) (annotation := by assumption)
        (callerScope := ScopedPorts.effect_scope_known_extension (by assumption) portExtension))
  | skippedSpent tail ih => exact .skippedSpent ih

/-- Fresh capture preserves all prior saved-source records and decorations.
The fresh owner's two endpoint decorations are explicit; no current or successor
ownership check is required for this source transport. -/
theorem RecordPendingRows.contract_insert
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      source inputRows outputRows context)
    (fresh : contracts owner = none) (freshAction : actions owner = none)
    (newInput : ValueRows contract.input) (newAnswer : ValueRows contract.answer) :
    RecordPendingRows operations policy (contracts.insert owner contract) tables families required outward
      (actions.insert owner rights) world ports (owners.insert owner newInput newAnswer) emptyRows resumes
      (source.transport (SourcePlannedTyping.insert_extends contracts fresh)
        (Syntax.fresh_usage_insert_extends freshAction)) inputRows outputRows context :=
  checked.contract_extension (SourcePlannedTyping.insert_extends contracts fresh)
    (Syntax.fresh_usage_insert_extends freshAction) (owners.insert owner newInput newAnswer)
    (ContractRows.compatible_fresh_insert owners fresh newInput newAnswer)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
