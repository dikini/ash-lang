/-- Finishing an unwind delimiter resumes its actual ordinary caller. The
executable root and its finite check come directly from the closing Wait. -/
theorem ExecutableSource.finish_unwind_close
    (before : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.unwind runtimeScope (.push (.closing identity caller) tail))) :
    ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.eval ⟨.unit, caller, tail⟩) := by
  cases before with
  | unwind pending coherent certificate waiting bound annotation checked bounded pendingResource =>
    cases coherent with
    | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
        restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest =>
      cases head with
      | closing =>
        have scopeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller := by assumption
        cases certificate with | closing tailCertificate =>
          have tailResource := pendingResource
          cases tailResource with | closing tailResource =>
            cases waiting with | closing callerWaiting =>
              cases bound with | running tailBound =>
                let site : ExecutionSite ambient operations policy contracts tables families required outward actions
                    (available (ownedTickets tail)) world installations resumes budget ports owners emptyRows output outputRows :=
                  { expression := .unit, runtimeScope := caller, stack := tail,
                    result := .unit, resultRows := .unit, allowed := [],
                    dependencies := .pure, plan := .pure, rows := .pure,
                    sourceDemand := [], sourceRequirements := .request [] [],
                    receiving := restScope, hints := restHints, context := restContext,
                    current := SourceAdmission.Admitted.of_source .unit .unit .pure rest.forget.source,
                    certified := .pure (evidence := declarationPolicy), scopeTyped := scopeKnown,
                    pendingDemand := restDemand, pendingRequirements := restRequirements,
                    pending := restSource, coherent := rest, retained := tailCertificate, currentResource := .pure,
                    retainedResource := tailResource.reproof }
                exact .eval site rfl (.contextual (.pure callerWaiting)) tailBound annotation checked bounded

/-- The same finishClose event retains all corrected common-state fields.
No successor source, interpretation, or finite check is an input. -/
theorem ExecutableState.finish_unwind_close
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope (.push (.closing identity caller) tail), issued, completed⟩, actions⟩) :
    LexicalUnwind.Event
      ⟨.unwind runtimeScope (.push (.closing identity caller) tail), issued, completed⟩
      ⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩, actions⟩ := by
  have event : LexicalUnwind.Event
      ⟨.unwind runtimeScope (.push (.closing identity caller) tail), issued, completed⟩
      ⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩ := by
    simpa only [List.append_nil, List.singleton_append] using
      (LexicalUnwind.Event.step
        (before := ⟨.unwind runtimeScope (.push (.closing identity caller) tail), issued, completed⟩)
        (.finishClose) (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
  have resources : LexicalUnwind.MachineAccess ambient (.eval ⟨.unit, caller, tail⟩) := by
    cases state.resources with
    | unwind supported => cases supported with
      | push frame rest ambient next access =>
        exact .eval ⟨next, by simp [Code.dependencies, Syntax.resourceDependencies]⟩
  refine ⟨event, state.source.finish_unwind_close, ?_, ?_, state.storeAnnotation,
    LexicalUnwind.event_preserves_ledger event state.ledger, state.registry, resources,
    state.activations, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
        cases located with | push rest => exact .resume rest known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
        cases located with | push rest => exact .dispose rest held recorded source

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
