    nextDisposals, nextStore, allocationOrigin, allocationStore, closingLookup, guarded, rest⟩ :=
    finish capAnnotated tailAnnotated capAnnotation tailAnnotation splitCheck suppliedDemand suppliedRequirements suppliedSource cleanupPath
  refine ⟨capRow, tailRow, branchBound, closingDemand, closingRow, closingBalance, noClosing,
    nextDisposals, nextStore, allocationOrigin, closingLookup, ?_, rest⟩
  intro protectedPath
  obtain ⟨interface, clauseDemand, clauseRequirements, clauseRow, expression, checked, bounded, joined⟩ := guarded protectedPath
