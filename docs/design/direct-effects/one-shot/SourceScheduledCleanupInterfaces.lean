#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.certified_world_weaken
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CertifiedFrame.world_weaken
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeFrame.world_weaken
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.world_weaken
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
