theorem RecordPendingRows.discard_execution_owned
    {contract : SourcePlannedTyping.Contract} {known : contracts owner = some contract}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value .unit) middle frontDemand frontRequirements frontScope}
    {savedSource : PlannedModeSource operations policy contracts tables families required outward actions world
      captured savedInput savedOutput savedDemand savedRequirements capturedScope}
    {tailSource : PlannedModeSource operations policy contracts tables families required outward actions world
      tail middle output tailDemand tailRequirements tailScope}
    (frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes frontSource (.value .unit) middleRows frontContext)
    (savedRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes savedSource savedInputRows savedOutputRows capturedContext)
    (tailRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes tailSource middleRows outputRows tailContext)
    (answerRows : ModeRowsValue.Answer (owners owner contract known).2 middleRows)
    (answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType)
    (callerKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller)
    (capturedClosing : capturedContext.closing? = some metadata)
    (runtimeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
    (identity : Nat)
    (records : ∀ key body, (key, body) ∈ (resumes : RecursiveRequirements.Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : RecursiveRequirements.Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (storeAnnotation : SourceDependencyAnnotations.StoreAnnotation (resumes ++ disposals) annotatedStore)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (checked : Checked (annotateDisposalStore annotatedStore) receiving
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      (annotateDisposals (discardExecutionRoot tables owner front tail answerType caller metadata.closing.2
        frontRequirements (.sequence (.spent owner) tailRequirements))) row) :
    ∃ requirements : Requirements (metadata.closing.1 ++ (frontDemand ++ tailDemand)),
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answerType caller tail)))) .unwind output
      (metadata.closing.1 ++ (frontDemand ++ tailDemand)) requirements
      (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) source .unwind outputRows
        (capturedContext.append (.closing (frontContext.append (.spent (owner := owner) tailContext)))) ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) receiving
        (available (ownedTickets (captured.append (.push (.closing identity runtimeScope)
          (front.append (.spent owner answerType caller tail)))))) (annotateDisposals requirements) row ∧
      (metadata.closing.1 ++ (frontDemand ++ tailDemand)).Perm
        (ownedTickets (captured.append (.push (.closing identity runtimeScope)
          (front.append (.spent owner answerType caller tail))))) ∧
      (owner :: (metadata.closing.1 ++ (frontDemand ++ tailDemand))).Perm
        (ownedTickets (front.append (.live owner inputType answerType captured caller tail))) := by
  obtain ⟨requirements, source, nextRows, nextCheck⟩ :=
    frontRows.discard_execution_checked savedRows tailRows answerRows answerAnnotation callerKnown capturedClosing runtimeKnown identity checked
  have phaseSame := OwnerPhaseTransitions.trace_result (OwnerPhaseTransitions.resume_phase_trace unique)
  change available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) =
    OwnerPhaseTransitions.spend
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) owner at phaseSame
  have physical : ownedTickets (captured.append (.push (.closing identity runtimeScope)
      (front.append (.spent owner answerType caller tail)))) =
      ownedTickets (captured.append (front.append (.spent owner answerType caller tail))) := by
    simp only [owned_tickets_append, ownedTickets]
  rw [← phaseSame, ← physical] at nextCheck
  have nextUnique := (List.nodup_cons.mp (OwnerPhaseTransitions.resume_owned_permutation.nodup unique)).2
  rw [← physical] at nextUnique
  have nextRecords := planned_resume_records_discard (identity := identity) (runtimeScope := runtimeScope) records
  have nextClosing := planned_unwind_records_discard (identity := identity) (runtimeScope := runtimeScope) closing
  obtain ⟨_, normalCheck, _⟩ := (disposal_annotation requirements).checked nextCheck
  obtain ⟨_, originalCheck, _⟩ := (annotated_disposal_store (storeAnnotation.remove_owner owner)).checked normalCheck
  rw [RecursiveConsumption.remove_owner_append] at originalCheck
  have balance := SourceDependencySchemes.Lexical.mode_stack_ownership_balance source.erase
    (fun key body member => (nextRecords key body member).erase)
    (fun key body member => (nextClosing key body member).erase) nextUnique originalCheck
  refine ⟨requirements, source, nextRows, nextCheck, balance, ?_⟩
  rw [physical] at balance
  exact (balance.cons owner).trans OwnerPhaseTransitions.resume_owned_permutation.symm

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.discard_execution_owned

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
