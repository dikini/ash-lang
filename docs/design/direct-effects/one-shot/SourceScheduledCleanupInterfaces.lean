private theorem DeepPureHistory.contexts (related : DeepPureHistory first second) :
    stripPlain first.context = stripPlain second.context := by
  induction related with
  | live saved related ihSaved ih =>
      simp [Context.context, stripPlain, saved.held]
      exact ih
  | _ => simp_all [Context.context, stripPlain]

private theorem DeepPureHistory.metadata {metadata : CleanupHints.Metadata firstScope}
    {firstHints : ReturnHints firstScope} {first : Context firstHints}
    (related : DeepPureHistory first second) (found : first.closing? = some metadata) :
    ∃ next, second.closing? = some next ∧ MetaPlain metadata next := by
  induction related with
  | same context => exact ⟨metadata, found, .same _⟩
  | add related ih =>
      obtain ⟨next, nextFound, nextRelated⟩ := ih found
      exact ⟨.plain next, by simp only [Context.closing?, nextFound, Option.map_some], .add nextRelated⟩
  | plain rows related ih | handler rows related ih | cell related ih
  | cleanup rows related ih | retiring related ih | spent related ih =>
      simp only [Context.closing?] at found ⊢
      obtain ⟨actual, previous, equality⟩ := Option.map_eq_some_iff.mp found
      subst metadata
      obtain ⟨next, nextFound, nextRelated⟩ := ih previous
      simp only [nextFound, Option.map_some]
      refine ⟨_, rfl, ?_⟩
      first | exact .plain nextRelated | exact .handler nextRelated | exact .cell nextRelated
            | exact .cleanup nextRelated | exact .retiring nextRelated | exact .spent nextRelated
  | normal related ih | unwinding related ih | closing related ih => cases found
  | @live oldScope oldHints oldSaved nextScope nextHints nextSaved firstScope firstHints first secondScope secondHints second owner resumeDemand saved related ihSaved ih =>
      cases savedFound : oldSaved.closing? with
      | none => simp [Context.closing?, savedFound] at found
      | some savedMetadata =>
          simp only [Context.closing?, savedFound] at found
          cases previous : first.closing? with
          | none => simp [previous] at found
          | some actual =>
              simp [previous] at found
              subst metadata
              obtain ⟨nextSavedMetadata, nextSavedFound, nextSavedRelated⟩ := ihSaved savedFound
              obtain ⟨next, nextFound, nextRelated⟩ := ih previous
              exact ⟨.live nextSavedMetadata next, by simp [Context.closing?, nextSavedFound, nextFound],
                .live nextSavedRelated nextRelated⟩

theorem DeepPureHistory.closing_exists
    {metadata : CleanupHints.Metadata firstScope}
    (related : DeepPureHistory first second) (found : first.closing? = some metadata) :
    ∃ next, second.closing? = some next := by
  obtain ⟨next, found, _⟩ := related.metadata found
  exact ⟨next, found⟩

theorem DeepPureHistory.requestBudget (related : DeepPureHistory first second)
    (cut : Cut effect operation first captured tail contract modes)
    (checked : RequestBudget budget phases effect operation first) :
    RequestBudget budget phases effect operation second := by
  obtain ⟨_, _, _, _, nextCaptured, nextTail, nextCut, inside, outside⟩ := related.cut cut
  unfold RequestBudget
  rw [nextCut]
  intro consuming
  obtain ⟨metadata, found, normal, protectedCheck⟩ := checked.consuming cut consuming
  obtain ⟨next, nextFound, metadataRelated⟩ := inside.metadata found
  refine ⟨next, nextFound, metadataRelated.checked outside.contexts normal, metadataRelated.checked ?_ protectedCheck⟩
  change .ordinary (.barrier true) :: stripPlain _ = .ordinary (.barrier true) :: stripPlain _
  rw [outside.contexts]
  rfl

theorem DeepPureHistory.owners
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepPureHistory first second) :
    SourceDependencyOwners.owners firstScope = SourceDependencyOwners.owners secondScope := by
  induction related <;> simp_all [SourceDependencyOwners.owners]

theorem DeepPureHistory.pendingWithin
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepPureHistory first second)
    (checked : SourceDependencyOwners.PendingWithin world owned firstScope) :
    SourceDependencyOwners.PendingWithin world owned secondScope := by
  induction related with
  | same context => exact checked
  | add related ih => exact .plain .pure (ih checked)
  | plain rows related ih => cases checked with | plain code rest => exact .plain code (ih rest)
  | handler rows related ih => cases checked with | handler rest => exact .handler (ih rest)
  | cell related ih => cases checked with | cell rest => exact .cell (ih rest)
  | cleanup rows related ih => cases checked with | cleanup rest => exact .cleanup (ih rest)
  | normal related ih | unwinding related ih | closing related ih | retiring related ih =>
    cases checked with | running rest => exact .running (ih rest)
  | live saved rest ihSaved ihRest => cases checked with | live inside outside => exact .live (ihSaved inside) (ihRest outside)
  | spent related ih => cases checked with | spent rest => exact .spent (ih rest)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AccountingTransport

