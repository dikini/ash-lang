/-- The recomposed expression uses the predecessor's exact waiting certificate;
only pure operands are added. -/
theorem PlugRows.source_certificate
    (shape : PlugRows previous next)
    (checked : Contextual.SourceAdmission.Code outward actions budget phases world installations previous receiver) :
    Contextual.SourceAdmission.Code outward actions budget phases world installations next receiver := by
  cases shape with
  | pure => exact .pure
  | single => exact .sequence .pure checked
  | double => exact .sequence .pure (.sequence .pure checked)

theorem AuthContext.plug_value_source_certificate
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {plan : Plan dependencies} {hints : ReturnHints receivingScope}
    {receiver : Contextual.Context hints} {checking : Signature dependencies}
    {contextRows : Rows checking}
    {context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
      position input output demand requirements checking}
    {child : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input}
    {inputRows : ValueRows input} {outputRows : ValueRows output}
    (same : signature plan = checking)
    (contextAuth : AuthContext operations policy ports owners environmentRows context inputRows outputRows contextRows)
    (childAuth : Auth operations policy ports owners environmentRows child inputRows .pure)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (waiting : Contextual.SourceAdmission.Code outward actions budget phases world installations contextRows receiver) :
    ∃ combined : Requirements demand, ∃ nextDependencies, ∃ nextPlan : Plan nextDependencies,
    ∃ nextRows : Rows (signature nextPlan),
    ∃ source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (position.plug value) output demand combined (signature nextPlan),
      Auth operations policy ports owners environmentRows source outputRows nextRows ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      Contextual.SourceAdmission.Code outward actions budget phases world installations nextRows receiver ∧
      ∀ entries receiving before,
        (evaluate entries receiving before combined = evaluate entries receiving before requirements) ∧
        evaluate entries receiving before (annotateDisposals combined) =
          evaluate entries receiving before (annotateDisposals requirements) := by
  obtain ⟨combined, nextDependencies, nextPlan, nextRows, source, authenticated, certified, localCheck, cleanupBudget, shape, evaluation⟩ :=
    contextAuth.plug_value_rows same childAuth certified waiting.compile.1 waiting.compile.2
  exact ⟨combined, nextDependencies, nextPlan, nextRows, source, authenticated, certified,
    shape.source_certificate waiting, evaluation⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
