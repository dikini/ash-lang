      Bool.true_and] using finite

/-- Cleanup registration extends the lifetime ledger by the same installed
identity used by the source and row proofs. The source obligations needed for
future abandonment remain separate from this common-state connection. -/
theorem JoinedState.register_cleanup
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.cleanup callback body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
