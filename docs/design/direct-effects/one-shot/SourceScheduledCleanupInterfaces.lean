namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints (Matches)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available spend spendAll Trace)

/-- A single generated requirement/store check supplies the protected-disposal
path. There is no separate cleanup-path premise at the invocation site. -/
theorem discard_planned_segments_generated
    {recordedRequirements : Requirements contract.closeDemand}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.discard binder) .unit (owner :: contract.closeDemand) (.invoke ⟨owner, .dispose⟩ contract.closeDemand [])
      (.invoke (key := ⟨owner, .dispose⟩)))
    (known : contracts owner = some contract)
    (resolved : runtimeScope.resolve binder = some owner)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output pendingDemand pendingRequirements scope)
    {hints : ReturnHints scope}
    (matching : Matches tables families hints (front.append (.live owner inputType answerType captured caller tail)))
    (localCheck : Local outward actions
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) world
      (.invoke ⟨owner, .dispose⟩) hints)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (found : RecursiveRequirements.lookup ⟨owner, .dispose⟩ disposals = some ⟨contract.closeDemand, recordedRequirements⟩)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation
      (.sequence ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand []).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) pendingRequirements)
      annotatedRoot)
    (certificate : Checked (annotateDisposalStore annotatedStore) []
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) (annotateDisposals annotatedRoot) certificateRow)
    (usage : LexicalUnwind.MachineUse policy actions (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (resources : LexicalUnwind.MachineAccess ambient (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (frontBound : InternalUses (ownedTickets front ++ ownedTickets tail) front.erase.pending)
    (internal : InternalUses captured.erase.liveTickets captured.erase.pending)
    (tailBound : InternalUses (ownedTickets tail) tail.erase.pending) :
    let nextStack := captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail)))
    let after := available (ownedTickets nextStack)
    LexicalUnwind.UseTransition (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩)
      (.unwind runtimeScope nextStack) [.close identity] [.ticket owner] ∧
    LexicalUnwind.MachineUse policy actions (.unwind runtimeScope nextStack) ∧
    LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope nextStack) ∧
    LexicalUnwind.MachineAccess ambient (.unwind runtimeScope nextStack) ∧
    StoreAnnotation (RecursiveTransport.removeOwner owner (resumes ++ disposals))
      (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) ∧
    ∃ nextScope, ∃ nextHints : ReturnHints nextScope,
    ∃ requirements annotatedNext : Requirements (contract.closeDemand ++ pendingDemand), ∃ row annotatedRow,
      PlannedModeSource operations policy contracts tables families required outward actions world nextStack
        .unwind output (contract.closeDemand ++ pendingDemand) requirements nextScope ∧
      Matches tables families nextHints nextStack ∧
      Pending outward actions after world nextHints .nil .unwind output.mode ∧
      Bound annotations nextScope ∧
      RowAnnotation requirements annotatedNext ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) [] after requirements row ∧ row ⊆ certificateRow ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) [] after annotatedNext annotatedRow ∧ annotatedRow ⊆ certificateRow ∧
      (∃ retained : Requirements pendingDemand,
        RowAnnotation pendingRequirements retained ∧
        RequirementPath retained (annotateDisposals annotatedRoot) (owner :: contract.closeDemand) ∧
        RequirementPath retained annotatedNext contract.closeDemand) ∧
      (∃ savedAnnotated : Requirements contract.closeDemand,
        RowAnnotation recordedRequirements savedAnnotated ∧
        RequirementPath (savedAnnotated.prepend (OwnerPhases.ofStack tables
          (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) annotatedNext []) ∧
      Trace (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) [owner] after ∧
      (ownedTickets nextStack).Nodup ∧
      (contract.closeDemand ++ pendingDemand).Perm (ownedTickets nextStack) ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner disposals →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) := by
  have protectedPath : RequirementPath
      ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) (annotateDisposals annotatedRoot) [] := by
    exact annotated_disposal_path annotation (.first .here)
  simpa only [disposal_store_remove_owner] using (discard_planned_segments current known resolved source matching localCheck records closing found bound unique
    (annotated_disposal_store storeAnnotation) (annotated_disposals annotation) certificate protectedPath
    usage tickets resources frontBound internal tailBound)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.discard_planned_segments_generated

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.DisposalExamples
open ProtectionContracts ProtectionResiduals
open ProtectionResiduals.Examples (afterCompletion disposableF demandE)
open RecursiveRequirements (Requirements Store evaluate)

/-- The existing closing-delimiter counterexample now fails the generated
invocation check, although its old unprotected invocation succeeds. -/
theorem closing_boundary_rejected :
    let cleanup : Requirements [] := .request [.ordinary afterCompletion] (qualify true demandE)
    let entries : Store := [(⟨7, .dispose⟩, ⟨[], cleanup⟩)]
    let receiving : OwnerPhases.Context := [.live 7 false, .ordinary disposableF]
    let invocation : Requirements [7] := .invoke ⟨7, .dispose⟩ [] []
    evaluate entries receiving (OwnerPhaseTransitions.available [7]) invocation = some [] ∧
      evaluate (annotateDisposalStore entries) receiving (OwnerPhaseTransitions.available [7])
        (annotateDisposals invocation) = none := by
  dsimp only
  simp [annotateDisposalStore, annotateDisposals, evaluate, RecursiveRequirements.evaluateFuel,
    RecursiveRequirements.lookup] <;> decide

/-- A resuming interpretation for the exported effect accepts the same cleanup
across the closing delimiter. The generated check does not forbid delegation. -/
theorem closing_boundary_accepted :
    let cleanup : Requirements [] := .request [.ordinary afterCompletion] (qualify true demandE)
    let entries : Store := [(⟨7, .dispose⟩, ⟨[], cleanup⟩)]
    let receiving : OwnerPhases.Context := [.live 7 false,
      .ordinary (.handler ProtectionResiduals.Examples.effectF 22 [(0, ⟨false, some [], some []⟩)])]
    let invocation : Requirements [7] := .invoke ⟨7, .dispose⟩ [] []
    evaluate (annotateDisposalStore entries) receiving (OwnerPhaseTransitions.available [7])
      (annotateDisposals invocation) = some [] := by
  dsimp only
  simp [annotateDisposalStore, annotateDisposals, evaluate, RecursiveRequirements.evaluateFuel,
    RecursiveRequirements.lookup] <;> decide
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.DisposalExamples
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.DisposalExamples.closing_boundary_rejected
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.DisposalExamples.closing_boundary_accepted


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (spend spendAll)

/-- The extra branch is built at the capture's source annotation using the
already established equality of cleanup and resume ownership demands. -/
theorem protected_capture_annotation
    (normal : RowAnnotation (requirements : Requirements resumeDemand) annotated)
    (same : resumeDemand.Perm closeDemand)
    {closingRequirements : Requirements closeDemand} :
    let combined := Requirements.choice (.choice annotated closingRequirements same)
      (closingRequirements.prepend [.ordinary (.barrier true)]) same
    RowAnnotation (requirements : Requirements resumeDemand) combined ∧
    RequirementPath closingRequirements combined [] ∧
    RequirementPath (closingRequirements.prepend [.ordinary (.barrier true)]) combined [] ∧
    RequirementPath annotated combined [] := by
  exact ⟨.alternatives (.alternatives normal same) same, .yes (.no .here), .no .here, .yes (.yes .here)⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.protected_interface_from_record
