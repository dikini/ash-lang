  exact Accounting.Run.resume (front := Context.plain currentRows Context.nil)
    (captured := capturedContext) (tail := tailContext) (.plain .hit)
    (.unwinding (.skipped (.spent (.opening (.retiring (.closing .nil))))))

theorem programRun : Accounting.Run [] [] programRows parentContext bindRoot :=
  .sequence childRun

theorem childRoot : ExecutionRoot operations policy contracts tables families required [] actions
    (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] resumes [] ports owners emptyRows
    (.value .unit) (.value .unit) childSite bindRoot :=
  .contextual childRun

theorem parentRoot : ExecutionRoot operations policy contracts tables families required [] actions
    (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] resumes [] ports owners emptyRows
    (.value .unit) (.value .unit) site bindRoot :=
  .contextual programRun

theorem bindRootChecked : RecursiveRequirements.Checked (annotateDisposalStore resumes) []
    (OwnerPhaseTransitions.available (ownedTickets parentStack)) (annotateDisposals bindRoot) [] := by
  apply RecursiveRequirements.evaluate_sound
  simp [bindRoot, empty, parentStack, captured, tail, ownedTickets, annotateDisposals,
    RecursiveRequirements.evaluate, RecursiveRequirements.evaluateFuel, PhaseRechecking.checkOwners, OwnerPhaseTransitions.available,
    OwnerPhaseTransitions.spendAll, OwnerPhaseTransitions.spend, OwnerSource.exportAt,
    ProtectionResiduals.residual_empty, ProtectionResiduals.merge]


theorem bind_focus_checked :
    ∃ next : ExecutionSite [] operations policy contracts tables families required [] actions
        (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] resumes [] ports owners emptyRows
        (.value .unit) (.value .unit),
    ∃ plain : PlainData,
      plain.context = .bind 10 (.resume 9 .unit) ∧ plain.scope = site.runtimeScope ∧
      next.expression = .resume 9 .unit ∧ next.runtimeScope = site.runtimeScope ∧
      next.stack = .push (.plain plain) site.stack ∧
      ExecutionRoot operations policy contracts tables families required [] actions
        (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] resumes [] ports owners emptyRows
        (.value .unit) (.value .unit) next bindRoot ∧
      RecursiveRequirements.Checked (annotateDisposalStore resumes) []
        (OwnerPhaseTransitions.available (ownedTickets parentStack)) (annotateDisposals bindRoot) [] ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [] :=
  parentRoot.bind_focus bindFocus bindRootChecked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBindResumeExample
