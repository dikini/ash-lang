namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlannedTyping (Operations Contracts Value)
theorem focus_rows
    (split : FocusRows wholeRows childRows restRows)
    {admitted : SourceAdmission.Code outward actions budget phases world installations wholeRows context}
    (checked : CodeChecked ambient outward admitted) :
    CodeChecked ambient outward (split.source_certificate admitted).1 ∧
      CodeChecked ambient outward (split.source_certificate admitted).2 := by
  cases split with
  | pure => exact ⟨.pure, .pure⟩
  | sequence => cases checked with | sequence first second => exact ⟨first, second⟩
  | pairRight _ => cases checked with | sequence first second => exact ⟨second.plain_pure, .pure⟩
  | appArgument _ => cases checked with | sequence function rest =>
      cases rest with | sequence argument body => exact ⟨argument, body⟩


theorem plug_rows
    (shape : PlugRows previous next)
    {admitted : SourceAdmission.Code outward actions budget phases world installations previous receiver}
    (checked : CodeChecked ambient outward admitted) :
    CodeChecked ambient outward (shape.source_certificate admitted) := by
  cases shape with
  | pure => exact .pure
  | single => exact .sequence .pure checked
  | double => exact .sequence .pure (.sequence .pure checked)


theorem CodeChecked.silent
    (silent : dependencies.Silent) {checking : SourcePlanSignatures.Signature dependencies}
    {rows : Rows checking} {hints : ReturnHints scope} {context : Context hints}
    (admitted : SourceAdmission.Code outward actions budget phases world installations rows context) :
    CodeChecked ambient outward admitted := by
  induction silent generalizing scope with
  | pure => cases rows; exact .pure
  | sequence left right ihLeft ihRight =>
    cases rows with | sequence firstRows secondRows =>
      cases admitted with | sequence first second => exact .sequence (ihLeft first) (ihRight second)


theorem PendingChecked.phases
    {phases nextPhases : OwnerPhaseTransitions.Phases}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) (same : phases = nextPhases) :
    PendingChecked ambient outward (same ▸ admitted) := by
  cases same
  exact checked


theorem checked_resume_origin
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows source resultRows rows)
    (expression : code = .resume binder operand)
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) :
    ∃ owner contract, ∃ known : contracts owner = some contract,
      runtimeScope.resolve binder = some owner ∧ result = contract.answer ∧
      HEq resultRows (owners owner contract known).2 ∧
      ∃ primitive : SourceAdmission.Code outward actions budget phases world installations (Rows.invoke (key := ⟨owner, .resume⟩)) context,
        CodeChecked ambient outward primitive := by
  cases expression
  cases authenticated with
  | resume operandChecked =>
    rename_i operandDemand operandRequirements dependencies operandSignature actualOwner actualContract operandRows
      actualKnown _formed _admitted _permission actualResolved operandSource
    cases checked with | sequence operand primitive =>
      exact ⟨actualOwner, actualContract, actualKnown, actualResolved, rfl, HEq.rfl, _, primitive⟩



theorem checked_request_origin
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows source resultRows rows)
    (expression : code = .perform effect operation operand)
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) :
    ∃ requested input, ∃ known : operations requested operation = some (input, result),
      effect = Instantiation.freezeEffect requested ∧
      HEq resultRows (ports requested operation input result known).2 ∧
      ∃ primitive : SourceAdmission.Code outward actions budget phases world installations (Rows.request (effect := requested) (operation := operation)) context,
        CodeChecked ambient outward primitive := by
  cases expression
  cases authenticated with
  | perform operandChecked =>
    rename_i operandSource
    cases checked with | sequence operand primitive =>
      exact ⟨_, _, by assumption, rfl, HEq.rfl, _, primitive⟩


open OwnerPhaseTransitions (spend)

theorem checked_discard_primitive
    {current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.discard binder) result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows current resultRows rows)
    (resolved : runtimeScope.resolve binder = some owner)
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) :
    CodeChecked ambient outward (SourceAdmission.Code.ready_discard authenticated resolved admitted) := by
  cases authenticated with
  | discard =>
    rename_i actual
    cases Option.some.inj (actual.symm.trans resolved)
    exact checked


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport

