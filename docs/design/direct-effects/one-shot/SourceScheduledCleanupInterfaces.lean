namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceContextualRechecking (checkForest checkFrame)

/-- A non-handler frame changes no installed declaration check. This single
identity supplies both push and pop transport; composing two instances also
handles replacing an armed cleanup frame with its actual return marker. -/
theorem check_forest_nonhandler
    (frame : SourceDependencyCapture.Frame tables families layer entry)
    (nonhandler : ∀ handler, entry ≠ .handler handler) :
    checkForest required (.push entry tail) (layer restScope) outside =
      checkForest required tail restScope outside := by
  rw [SourceContextualRechecking.check_forest_push frame]
  have neutral : checkFrame required entry (restScope.append outside) = true := by
    cases frame <;> first | rfl | exact False.elim (nonhandler _ rfl)
  simp only [neutral, Bool.true_and]

/-- A builtin cell update changes only its payload. The actual recursive scope
and every installed declaration check, including dormant captures, are retained. -/
theorem cell_update_check_forest {hints : ReturnHints scope}
    (update : CellUpdate identity old new before after)
    (matching : ReturnHints.Matches tables families hints before) :
    checkForest required before scope outside = checkForest required after scope outside := by
  induction update generalizing scope with
  | hit => cases matching with
    | cell tail => rfl
    | running frame tail => cases frame
  | push miss next ih => cases matching with
    | plain tail => simp only [checkForest, ih tail]
    | handler tail => simp only [checkForest, ih tail]
    | cell tail => simp only [checkForest, ih tail]
    | cleanup tail => simp only [checkForest, ih tail]
    | running frame tail => simp only [checkForest, ih tail]
  | live next ih => cases matching with
    | live saved tail => simp only [checkForest, ih tail]
  | spent next ih => cases matching with
    | spent tail => exact ih tail

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.check_forest_nonhandler
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.cell_update_check_forest

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport
open ScopedExpressions ScopedExecution
open SourcePlannedTyping (Operations Contracts Value Environment)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements)
open ScopedPorts.Support (Env evaluate empty extend)

/-- Finite support checking follows actual lexical dependencies. Variable
entries use independently annotated value support, never the result port. -/
inductive Bounds (environment : Env) : List Syntax.Dependency → List Nat → Prop where
  | nil : Bounds environment [] bound
  | resource (present : identity ∈ bound) (rest : Bounds environment dependencies bound) :
      Bounds environment (.resource identity :: dependencies) bound
  | «variable» (included : environment name ⊆ bound) (rest : Bounds environment dependencies bound) :
      Bounds environment (.variable name :: dependencies) bound
  | ticket (rest : Bounds environment dependencies bound) :
      Bounds environment (.ticket owner :: dependencies) bound

/-- Structural support checking agrees with the existing lexical evaluator. -/
theorem bounds_iff : Bounds environment dependencies bound ↔ evaluate environment dependencies ⊆ bound := by
  constructor
  · intro checked
    induction checked with
    | nil => exact List.nil_subset _
    | resource present rest ih => simpa only [evaluate, List.flatMap_cons, List.singleton_append, List.cons_subset] using And.intro present ih
    | «variable» included rest ih => exact List.append_subset.mpr ⟨included, ih⟩
    | ticket rest ih => exact ih
  · intro included
    induction dependencies with
    | nil => exact .nil
    | cons dependency rest ih => cases dependency with
      | resource identity =>
          have split : identity ∈ bound ∧ evaluate environment rest ⊆ bound := by
            simpa only [evaluate, List.flatMap_cons, List.singleton_append, List.cons_subset] using included
          exact .resource split.1 (ih split.2)
      | «variable» name =>
          have split : environment name ⊆ bound ∧ evaluate environment rest ⊆ bound := List.append_subset.mp included
          exact .variable split.1 (ih split.2)
      | ticket owner => exact .ticket (ih included)

/-- Only the finitely referenced environment entries participate in checking. -/
instance boundsDecidable (environment : Env) (dependencies : List Syntax.Dependency) (bound : List Nat) :
    Decidable (Bounds environment dependencies bound) :=
  decidable_of_iff (evaluate environment dependencies ⊆ bound) bounds_iff.symm

/-- Every lexical dependency list has a constructible finite annotation. -/
theorem Bounds.canonical (environment : Env) (dependencies : List Syntax.Dependency) :
    Bounds environment dependencies (evaluate environment dependencies) :=
  bounds_iff.mpr (List.Subset.refl _)

/-- The structural annotation bounds actual captured resource identities. -/
theorem Bounds.resources (checked : Bounds environment dependencies bound) :
    Syntax.resourceDependencies dependencies ⊆ bound := by
  induction checked with
  | nil => exact List.nil_subset _
  | resource present rest ih => simpa only [Syntax.resourceDependencies, List.filterMap_cons, List.cons_subset] using And.intro present ih
  | «variable» included rest ih => exact ih
  | ticket rest ih => exact ih

/-- A source term and its support derivation share the actual code and lexical
value environment. Lambda bodies and internal handlers remain in the original
rich derivation; this annotation does not replace them with a port summary. -/
structure Expression (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (world : List Nat) (allowed : List Instance) (scope : Execution.Scope) (environment : Environment)
    (supportEnvironment : Env) (code : Code) (value : Value) (demand : List Nat)
    (requirements : Requirements demand) {dependencies : SourceDependencyAnnotations.Dependencies}
    (checking : Signature dependencies) (bound : List Nat) : Prop where
  source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
    code value demand requirements checking
  support : Bounds supportEnvironment code.dependencies bound

/-- Construct the annotation by evaluating source dependencies under the
lexical support environment; no runtime support premise is supplied. -/
theorem Expression.annotate
    (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      code value demand requirements checking) (supportEnvironment : Env) :
    Expression operations policy contracts world allowed scope environment supportEnvironment
      code value demand requirements checking (evaluate supportEnvironment code.dependencies) :=
  ⟨source, Bounds.canonical _ _⟩

/-- The same value substitution updates typing and support environments. The
support proof reuses the existing closed-substitution bound for arbitrary code. -/
theorem Expression.substitution
    (body : Expression operations policy contracts world allowed scope (environment.extend name input)
      (extend supportEnvironment name valueBound) code output demand requirements checking bodyBound)
    (replacement : Expression operations policy contracts world allowed .none environment replacementEnvironment
      value input [] (.request [] []) .pure valueBound)
    (closed : ClosedValue value) :
    Expression operations policy contracts world allowed scope environment supportEnvironment
      (code.subst name value) output demand requirements checking bodyBound := by
  refine ⟨SourcePlannedSources.substitution body.source replacement.source closed, ?_⟩
  apply bounds_iff.mpr
  exact (ScopedPorts.Support.substitution_support_bound code name closed replacement.support.resources).trans
    (bounds_iff.mp body.support)

/-- Infer the substituted source's finite bound from the lexical environment,
the actual body and the actual replacement. Neither a body-support premise nor
a replacement-support premise is required. Unused parameters add no support. -/
theorem Expression.annotate_substitution
    (body : SourcePlannedSources.Expression operations policy contracts world allowed scope (environment.extend name input)
      code output demand requirements checking)
    (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input)
    (closed : ClosedValue value) (supportEnvironment : Env) :
    Expression operations policy contracts world allowed scope environment supportEnvironment
      (code.subst name value) output demand requirements checking
      (evaluate (extend supportEnvironment name (Syntax.resourceDependencies value.dependencies)) code.dependencies) := by
  have supportedValue : Expression operations policy contracts world allowed .none environment empty
      value input [] (.request [] []) .pure (Syntax.resourceDependencies value.dependencies) := by
    simpa only [ScopedPorts.Support.empty_evaluation] using Expression.annotate replacement empty
  exact Expression.substitution (Expression.annotate body _) supportedValue closed

/-- Shrinking a lexical value's annotated support preserves a checked bound.
This transports existing source annotations when an environment entry is refined. -/
theorem Bounds.environment_refine
    (checked : Bounds environment dependencies bound)
    (refined : ∀ name, nextEnvironment name ⊆ environment name) :
    Bounds nextEnvironment dependencies bound := by
  induction checked with
  | nil => exact .nil
  | resource present rest ih => exact .resource present ih
  | «variable» included rest ih => exact .variable ((refined _).trans included) ih
  | ticket rest ih => exact .ticket ih

/-- A closed value's canonical annotation is its actual retained support,
independent of unrelated environment entries or its declared result port. -/
theorem closed_value_support (closed : ClosedValue value) :
    evaluate supportEnvironment value.dependencies = Syntax.resourceDependencies value.dependencies := by
  rw [← ScopedPorts.Support.empty_evaluation]
  apply ScopedPorts.Support.evaluation_congr
  intro name present
  exact False.elim (ScopedTyping.closedValue_no_variable closed present)

/-- A finite outward-boundary check supplies capture's actual operand premise. -/
theorem Expression.capture_support {receiving : SourceDependencyCapture.Scope}
    (source : Expression operations policy contracts world allowed scope environment supportEnvironment
      code value demand requirements checking bound)
    (boundary : bound ⊆ receiving.visibleResources ++ ambient) :
    Syntax.resourceDependencies code.dependencies ⊆ receiving.visibleResources ++ ambient :=
  source.support.resources.trans boundary

/-- Excluding the released identity from the structural annotation supplies
release safety for values and closures alike. -/
theorem Expression.release_support
    (source : Expression operations policy contracts world allowed scope environment supportEnvironment
      code value demand requirements checking bound)
    (excluded : identity ∉ bound) : identity ∉ Syntax.resourceDependencies code.dependencies :=
  ScopedPorts.Support.result_excludes_resource source.support.resources excluded

/-- Reuse the established escaping-closure counterexample: a structural source
annotation cannot hide a captured cell merely because the function port is empty. -/
theorem escaping_closure_rejected :
    ¬ (Bounds supportEnvironment (ScopedSignatureGap.Examples.payload (.activation 0)).dependencies bound ∧ 0 ∉ bound) := by
  rintro ⟨supported, excluded⟩
  exact SourceDependencyNeutral.Lexical.escaping_closure_has_no_release_bound
    ⟨bound, supported.resources, excluded⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.bounds_iff
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.Bounds.canonical
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.Bounds.resources
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.Expression.annotate
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.Expression.substitution
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.closed_value_support
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.Expression.capture_support
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport.Expression.release_support

