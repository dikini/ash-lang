  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    obtain ⟨nextInput, frameDemand, tailDemand, nextRequirements, tailRequirements,
      nextDependencies, nextPlan, restDependencies, restScope, boundary, restHints,
      nextAnnotated, nextRow, scopeSame, nextScope, empty, demandSame, nextSource,
      nextCertified, nextPending, nextAnnotation, rawPath, generatedPath, nextChecked,
      included, nextLocal, nextRetained, nextMatching, nextBound, nextResumes,
      nextDisposals, raw, transition, owners, nextUse, nextTickets, nextResources⟩ :=
      plug_planned_generated current pending closed retained matching bound annotation checked
        state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨plain.context.plug value, plain.scope, tail⟩, issued, completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, (fun key body member => nextResumes key body (state.resumeRecords key body member)),
      (fun key body member => nextDisposals key body (state.unwindRecords key body member)),
