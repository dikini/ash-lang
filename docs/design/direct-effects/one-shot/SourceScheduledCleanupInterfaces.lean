/-- The four ordinary computation reductions select these exact row subtrees. -/
inductive ComputationRows : {firstDependencies : SourceDependencyAnnotations.Dependencies} →
    {firstSignature : Signature firstDependencies} → Rows firstSignature →
    {secondDependencies : SourceDependencyAnnotations.Dependencies} →
    {secondSignature : Signature secondDependencies} → Rows secondSignature → Prop where
  | binding : ComputationRows (.sequence initialRows bodyRows) bodyRows
  | application : ComputationRows (.sequence functionRows (.sequence argumentRows bodyRows)) bodyRows
  | trueBranch : ComputationRows (.sequence conditionRows (.choice yesRows noRows)) yesRows
  | falseBranch : ComputationRows (.sequence conditionRows (.choice yesRows noRows)) noRows

/-- The selected row subtree is indexed by the actual reducing expression. -/
inductive ComputationSelection : Code →
    {firstDependencies : SourceDependencyAnnotations.Dependencies} →
    {firstSignature : Signature firstDependencies} → Rows firstSignature →
    {secondDependencies : SourceDependencyAnnotations.Dependencies} →
    {secondSignature : Signature secondDependencies} → Rows secondSignature → Prop where
  | binding : ComputationSelection (.bind parameter value body) (.sequence initialRows bodyRows) bodyRows
  | application : ComputationSelection (.app (.lambda parameter body) value)
      (.sequence functionRows (.sequence argumentRows bodyRows)) bodyRows
  | trueBranch : ComputationSelection (.branch (.boolean true) yes no)
      (.sequence conditionRows (.choice yesRows noRows)) yesRows
  | falseBranch : ComputationSelection (.branch (.boolean false) yes no)
      (.sequence conditionRows (.choice yesRows noRows)) noRows

theorem ComputationSelection.forget (selected : ComputationSelection code rows nextRows) :
    ComputationRows rows nextRows := by
  cases selected with
  | binding => exact .binding
  | application => exact .application
  | trueBranch => exact .trueBranch
  | falseBranch => exact .falseBranch


/-- The established computation theorem additionally exposes its exact
selected row subtree, so stronger source evidence can reuse the same proof. -/
theorem Admitted.computation_selected_rows
    {plan : Plan dependencies} {rows : Rows (signature plan)}
    (admitted : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack code result demand requirements
      (signature plan) resultRows rows)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (ready : Ready code)
    (step : RawStep ⟨code, runtimeScope, stack⟩ after created completed) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand, ∃ nextDependencies,
    ∃ nextPlan : Plan nextDependencies, ∃ nextRows : Rows (signature nextPlan), ∃ nextTicket,
      Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
        after.scope actions phases budget tables families context after.stack after.expression result nextDemand nextRequirements
        (signature nextPlan) resultRows nextRows ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      ScopedPorts.EffectScope contracts.erase.erase.ports after.scope nextTicket ∧
      demand.Perm nextDemand ∧ after.stack = stack ∧ created = [] ∧ completed = [] ∧
      (∀ entries receiving before row, Checked entries receiving before requirements row →
        ∃ nextRow, Checked entries receiving before nextRequirements nextRow ∧ nextRow ⊆ row) ∧
      (∀ entries receiving before row, Checked entries receiving before (annotateDisposals requirements) row →
        ∃ nextRow, Checked entries receiving before (annotateDisposals nextRequirements) nextRow ∧ nextRow ⊆ row) ∧
      ComputationSelection code rows nextRows := by
  cases step with
  | focus plain focus tail => exact False.elim (ready_not_focus ready focus)
  | plug plain value closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveHandler handler value closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveCell identity payload answer savedScope scope value closed tail => exact False.elim (ready_not_value ready closed.1)
  | startCleanup action saved closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveClause owner answer value closed scope caller tail => exact False.elim (ready_not_value ready closed.1)
  | bind parameter value body scope tail closed environmentReady =>
      cases plan with
      | sequence initialPlan bodyPlan =>
          rcases admitted with ⟨source, authenticated, capabilities, cleanupBudget, contextSource⟩
          cases authenticated with
          | bind initializer bodyAuth =>
              have empty := SourceTemplates.expression_value_demand
                (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
                  (SourcePlannedSources.expression_erase (by assumption)))) closed.1
              subst_vars
              cases certified with | sequence initialCertified bodyCertified =>
                cases capabilities with | sequence initialLocal bodyLocal =>
                  cases cleanupBudget with | sequence initialBudget bodyBudget =>
                    have replaced := bodyAuth.substitution (initializer.value_summary closed.1) closed
                    refine ⟨_, _, _, bodyPlan, _, _,
                      ⟨_, replaced, bodyLocal, bodyBudget, contextSource⟩,
                      bodyCertified, scopeTyped, .refl _, rfl, rfl, rfl, ?_, ?_, .binding⟩
                    all_goals
                      intro entries receiving before row rowChecked
                      obtain ⟨firstRow, secondRow, firstCheck, secondCheck, rfl⟩ :=
                        RecursiveRequirements.checked_sequence_parts rowChecked
                      exact ⟨secondRow, secondCheck, List.subset_append_right _ _⟩
      | pure | request | invoke | choice | handler | cleanup | resource => cases admitted.source
  | beta parameter body value scope tail closed closureReady =>
      cases plan with
      | sequence functionPlan remaining => cases remaining with
        | sequence argumentPlan bodyPlan =>
            cases rows with | sequence functionRows remainingRows =>
              cases remainingRows with | sequence argumentRows bodyRows =>
                obtain ⟨reduced, next, evaluation⟩ := admitted.beta_expression closed
                cases certified with | sequence functionCertified remainingCertified =>
                  cases remainingCertified with | sequence argumentCertified bodyCertified =>
                    refine ⟨_, reduced, _, bodyPlan, bodyRows, _, next, bodyCertified, .none,
                      .refl _, rfl, rfl, rfl, ?_, ?_, .application⟩
                    · intro entries receiving before row rowChecked
                      exact ⟨row, RecursiveRequirements.evaluate_sound
                        ((evaluation entries receiving before).trans (RecursiveRequirements.checked_complete rowChecked)),
                        List.Subset.refl _⟩
                    · intro entries receiving before row rowChecked
                      obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation _).checked rowChecked
                      obtain ⟨outwardRow, derived⟩ := RecursiveOutward.expression_outward
                        (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
                          (SourcePlannedSources.expression_erase next.source))) rfl
                      refine ⟨normalRow, ?_, normalBound⟩
                      rw [outward_disposals derived]
                      exact RecursiveRequirements.evaluate_sound
                        ((evaluation entries receiving before).trans (RecursiveRequirements.checked_complete normalCheck))
        | pure | request | invoke | choice | handler | cleanup | resource => cases admitted.source
      | pure | request | invoke | choice | handler | cleanup | resource => cases admitted.source
  | ifTrue yes no scope tail | ifFalse yes no scope tail =>
      cases plan with
      | sequence conditionPlan remaining => cases remaining with
        | choice yesPlan noPlan =>
            rcases admitted with ⟨source, authenticated, capabilities, cleanupBudget, contextSource⟩
            cases authenticated with
            | branch condition yesAuth noAuth =>
              have empty := SourceTemplates.expression_value_demand (code := .boolean _)
                (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
                  (SourcePlannedSources.expression_erase (by assumption)))) (by trivial)
              subst_vars
              cases certified with | sequence conditionCertified branchesCertified =>
                cases branchesCertified with | choice yesCertified noCertified =>
                  cases capabilities with | sequence conditionLocal branchesLocal =>
                    cases branchesLocal with | choice yesLocal noLocal =>
                      cases cleanupBudget with | sequence conditionBudget branchesBudget =>
                        cases branchesBudget with | choice yesBudget noBudget =>
                          first
                          | refine ⟨_, _, _, yesPlan, _, _, ⟨_, yesAuth, yesLocal, yesBudget, contextSource⟩,
                              yesCertified, scopeTyped, .refl _, rfl, rfl, rfl, ?_, ?_, .trueBranch⟩
                          | refine ⟨_, _, _, noPlan, _, _, ⟨_, noAuth, noLocal, noBudget, contextSource⟩,
                              noCertified, scopeTyped, (by assumption), rfl, rfl, rfl, ?_, ?_, .falseBranch⟩
                          all_goals
                            intro entries receiving before row rowChecked
                            obtain ⟨conditionRow, branchesRow, conditionCheck, branchesCheck, rfl⟩ :=
                              RecursiveRequirements.checked_sequence_parts rowChecked
                            cases branchesCheck with | choice yesCheck noCheck =>
                              first
                              | exact ⟨_, yesCheck, (List.subset_append_left _ _).trans (List.subset_append_right _ _)⟩
                              | exact ⟨_, noCheck, (List.subset_append_right _ _).trans (List.subset_append_right _ _)⟩
        | pure | request | invoke | sequence | handler | cleanup | resource => cases admitted.source
      | pure | request | invoke | choice | handler | cleanup | resource => cases admitted.source
  | enterHandler | enterCell | enterCleanup | finishCleanup | capture | resume | discard | finishClose | retire | readCell | writeCell => cases ready



theorem Admitted.computation_rows
    {plan : Plan dependencies} {rows : Rows (signature plan)}
    (admitted : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack code result demand requirements
      (signature plan) resultRows rows)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (ready : Ready code)
    (step : RawStep ⟨code, runtimeScope, stack⟩ after created completed) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand, ∃ nextDependencies,
    ∃ nextPlan : Plan nextDependencies, ∃ nextRows : Rows (signature nextPlan), ∃ nextTicket,
      Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
        after.scope actions phases budget tables families context after.stack after.expression result nextDemand nextRequirements
        (signature nextPlan) resultRows nextRows ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      ScopedPorts.EffectScope contracts.erase.erase.ports after.scope nextTicket ∧
      demand.Perm nextDemand ∧ after.stack = stack ∧ created = [] ∧ completed = [] ∧
      (∀ entries receiving before row, Checked entries receiving before requirements row →
        ∃ nextRow, Checked entries receiving before nextRequirements nextRow ∧ nextRow ⊆ row) ∧
      (∀ entries receiving before row, Checked entries receiving before (annotateDisposals requirements) row →
        ∃ nextRow, Checked entries receiving before (annotateDisposals nextRequirements) nextRow ∧ nextRow ⊆ row) ∧
      ComputationRows rows nextRows := by
  obtain ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
    next, nextCertified, nextScope, demands, stackSame, createdSame, completedSame,
    normalTransfer, generatedTransfer, selected⟩ :=
    admitted.computation_selected_rows certified scopeTyped ready step
  exact ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
    next, nextCertified, nextScope, demands, stackSame, createdSame, completedSame,
    normalTransfer, generatedTransfer, selected.forget⟩

theorem Admitted.computation
    {plan : Plan dependencies} {rows : Rows (signature plan)}
    (admitted : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack code result demand requirements
      (signature plan) resultRows rows)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (ready : Ready code)
    (step : RawStep ⟨code, runtimeScope, stack⟩ after created completed) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand, ∃ nextDependencies,
    ∃ nextPlan : Plan nextDependencies, ∃ nextRows : Rows (signature nextPlan), ∃ nextTicket,
      Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
        after.scope actions phases budget tables families context after.stack after.expression result nextDemand nextRequirements
        (signature nextPlan) resultRows nextRows ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      ScopedPorts.EffectScope contracts.erase.erase.ports after.scope nextTicket ∧
      demand.Perm nextDemand ∧ after.stack = stack ∧ created = [] ∧ completed = [] ∧
      (∀ entries receiving before row, Checked entries receiving before requirements row →
        ∃ nextRow, Checked entries receiving before nextRequirements nextRow ∧ nextRow ⊆ row) ∧
      (∀ entries receiving before row, Checked entries receiving before (annotateDisposals requirements) row →
        ∃ nextRow, Checked entries receiving before (annotateDisposals nextRequirements) nextRow ∧ nextRow ⊆ row) := by
  obtain ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
    next, nextCertified, nextScope, demands, stackSame, createdSame, completedSame,
    normalTransfer, generatedTransfer, selected⟩ :=
    admitted.computation_rows certified scopeTyped ready step
  exact ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
    next, nextCertified, nextScope, demands, stackSame, createdSame, completedSame,
