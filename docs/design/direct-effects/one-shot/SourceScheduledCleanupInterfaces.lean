namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)

/-- The existing outward-row derivation has no direct continuation invocation.
Internal handler clauses retain their separate source admission obligations. -/
theorem outward_disposals (source : RecursiveOutward.Outward requirements row) :
    annotateDisposals requirements = requirements := by
  induction source with
  | request => rfl
  | sequence first second ihFirst ihSecond => simp only [annotateDisposals, ihFirst, ihSecond]
  | emitAfter body ih => simp only [annotateDisposals, ih]
  | choice first second ihFirst ihSecond => simp only [annotateDisposals, ihFirst, ihSecond]

/-- Calling a source-typed closed lambda retains its generated certificate.
Reuse beta substitution and outward extraction; no callback-body rechecking
premise or new ownership argument is needed. -/
theorem beta_generated_annotated
    (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (.app (.lambda parameter body) value) result demand requirements
      (.sequence functionSignature (.sequence argumentSignature bodySignature)))
    (closed : ClosedValue value)
    (annotation : RowAnnotation requirements annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) row) :
    ∃ reduced annotatedNext : Requirements demand, ∃ nextRow,
      SourcePlannedSources.Expression operations policy contracts world allowed .none environment
        (body.subst parameter value) result demand reduced bodySignature ∧
      RowAnnotation reduced annotatedNext ∧
      Checked entries receiving before (annotateDisposals annotatedNext) nextRow ∧ nextRow ⊆ row ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals annotatedNext) [] := by
  obtain ⟨reduced, nextSource, evaluation⟩ := SourcePlannedSources.beta_expression source closed
  obtain ⟨normalRow, normalCheck, within⟩ := (annotated_disposals annotation).checked checked
  obtain ⟨outward, derived⟩ := RecursiveOutward.expression_outward
    (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
      (SourcePlannedSources.expression_erase nextSource))) rfl
  have nextChecked : Checked entries receiving before (annotateDisposals reduced) normalRow := by
    rw [outward_disposals derived]
    exact RecursiveRequirements.evaluate_sound
      ((evaluation entries receiving before).trans (RecursiveRequirements.checked_complete normalCheck))
  exact ⟨reduced, .choice reduced annotated (.refl _), normalRow ++ row, nextSource,
    .alternatives .original (.refl _), .choice nextChecked checked,
    List.append_subset.mpr ⟨within, List.Subset.refl _⟩, .no .here⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.outward_disposals
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.beta_generated_annotated

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Store Checked)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open OwnerPhaseTransitions (spend spendAll)

/-- Value binding consumes no owner before the substituted body. Focus its
existing generated check and retain the entire predecessor annotation. -/
theorem bind_generated_annotated
    (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (.bind parameter value body) result demand requirements (.sequence initialSignature bodySignature))
    (closed : ClosedValue value)
    (annotation : RowAnnotation requirements annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) row) :
    ∃ reduced annotatedNext : Requirements demand, ∃ nextRow,
      SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        (body.subst parameter value) result demand reduced bodySignature ∧
      RowAnnotation reduced annotatedNext ∧
      Checked entries receiving before (annotateDisposals annotatedNext) nextRow ∧ nextRow ⊆ row ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals annotatedNext) [] := by
  cases source with
  | bind initializer body =>
      have empty := SourceTemplates.expression_value_demand
        (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
          (SourcePlannedSources.expression_erase initializer))) closed.1
      subst_vars
      have nextSource := SourcePlannedSources.substitution body (SourcePlannedSources.Values.summary initializer closed.1) closed
      obtain ⟨focused, focusedAnnotation, generatedAnnotation, path⟩ := disposal_source_focus annotation
        (RequirementPath.second .here)
      obtain ⟨focusedRow, focusedCheck, focusedBound⟩ := path.checked checked
      obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map focusedAnnotation).checked focusedCheck
      exact ⟨_, .choice _ annotated (.refl _), normalRow ++ row, nextSource,
        .alternatives .original (.refl _), .choice normalCheck checked,
        List.append_subset.mpr ⟨normalBound.trans focusedBound, List.Subset.refl _⟩, .no .here⟩

/-- Map the same authenticated record annotations, preserving keys and demands. -/
theorem disposal_store_annotation_map (annotation : StoreAnnotation normal annotated) :
    StoreAnnotation (annotateDisposalStore normal) (annotateDisposalStore annotated) := by
  induction annotation with
  | nil => exact .nil
  | cons head tail ih => exact .cons (disposal_annotation_map head) ih

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open RecursiveRequirements (Requirements Store Checked evaluate)
open OwnerPhaseTransitions (spend spendAll)

/-- Reuse resumption's existing row and store transport at generated source
requirements. Exact lookup identifies the generated copy of the original saved
annotation, retaining its complete subtree rather than only its normal row. -/
theorem resume_fragment_rows_generated {front captured tail : Stack}
    {contract : SourceDependencyAnnotations.Contract}
    {recordedRequirements : Requirements contract.resumeDemand}
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recordedRequirements⟩)
    (invocation : Checked (annotateDisposalStore annotatedStore)
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))
      before (.invoke ⟨owner, .resume⟩ contract.resumeDemand []) resumeRow)
    (pending : Checked (annotateDisposalStore annotatedStore) [] (spendAll before (owner :: contract.resumeDemand))
      (annotateDisposals pendingRequirements) pendingRow)
    {frontDemand tailDemand : List Nat}
    {frontRequirements : Requirements frontDemand} {tailRequirements : Requirements tailDemand}
    (evaluation : ∀ store receiving phases,
      evaluate store receiving phases (annotateDisposals pendingRequirements) =
        merge (evaluate store (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail) ++ receiving)
          phases (annotateDisposals frontRequirements))
          (evaluate store receiving (spendAll phases frontDemand) (annotateDisposals (.sequence (.spent owner) tailRequirements)))) :
    ∃ frontRow tailRow savedRow, ∃ savedAnnotated : Requirements contract.resumeDemand,
      RowAnnotation recordedRequirements savedAnnotated ∧ savedRow ⊆ resumeRow ∧
      pendingRow = frontRow ++ tailRow ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))
        (spend before owner) (annotateDisposals recordedRequirements) savedRow ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))
        (spend before owner) (annotateDisposals savedAnnotated) resumeRow ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
        (OwnerPhases.ofStack tables (.spent owner answerType caller tail))
        (spendAll (spend before owner) contract.resumeDemand) (annotateDisposals frontRequirements) frontRow ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) []
        (spendAll (spendAll (spend before owner) contract.resumeDemand) frontDemand)
        (annotateDisposals tailRequirements) tailRow := by
  have fullFound := RecursiveRecords.lookup_append (second := disposals) found
  have mapped : StoreAnnotation (annotateDisposalStore (resumes ++ disposals) ++ []) (annotateDisposalStore annotatedStore) := by
    simpa only [List.append_nil] using disposal_store_annotation_map storeAnnotation
  obtain ⟨frontRow, tailRow, savedRow, generatedSaved, generatedAnnotation, savedBound,
    rowSame, savedCheck, generatedSavedCheck, frontCheck, tailCheck⟩ :=
    SourceDependencySchemes.Lexical.resume_fragment_rows (contract := contract) mapped
      (disposal_store_lookup fullFound) invocation pending evaluation
  obtain ⟨savedAnnotated, savedFound, savedAnnotation⟩ := storeAnnotation.lookup_annotated fullFound
  obtain ⟨body, selectedContext, actual, ready, selection, bodyChecked⟩ :=
    RecursiveRequirements.checked_invocation invocation
  have same := Option.some.inj (actual.symm.trans (disposal_store_lookup savedFound))
  have bodySame := eq_of_heq (Sigma.mk.inj same).2
  subst body
  have consumed : spend before owner owner = .consumed := OwnerPhaseTransitions.spend_self before owner
  have contexts : RecursiveTransport.normalize (spend before owner)
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail))) =
      RecursiveTransport.normalize (spend before owner)
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail))) := by
    simpa only [List.append_nil] using (RecursiveRecomposition.normalize_replaced
      (front := front) (capture := captured) (tail := tail) (input := inputType) (answer := answerType)
      (caller := caller) (tables := tables) (receiving := []) consumed)
  have retainedCheck := RecursiveTransport.checked_transport bodyChecked
    (RecursiveTransport.remove_consumed_agrees consumed) (by simpa only [List.nil_append] using contexts)
  simp only [disposal_store_remove_owner]
  exact ⟨frontRow, tailRow, savedRow, savedAnnotated, savedAnnotation, savedBound,
    rowSame, savedCheck, retainedCheck, frontCheck, tailCheck⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts Contract Value)
open SourcePlannedFrames (Families DependencyScope)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store evaluate)
open OwnerPhaseTransitions (spend spendAll)
/-- Extract actual source fragments and their generated checks from a generated
predecessor invocation and pending check. The exact saved source comes from its
authenticated record; no reentered-source or fragment-check premise is added. -/
theorem resume_planned_fragments_generated {contract : SourcePlannedTyping.Contract}
    {recordedRequirements : Requirements contract.resumeDemand}
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value contract.answer) output pendingDemand pendingRequirements scope)
    (known : contracts owner = some contract)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recordedRequirements⟩)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (invocation : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore)
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))
      before (.invoke ⟨owner, .resume⟩ contract.resumeDemand []) resumeRow)
    (pending : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) [] (spendAll before (owner :: contract.resumeDemand))
      (annotateDisposals pendingRequirements) pendingRow) :
    ∃ (boundary : PlannedModeValue) (frontDemand tailDemand : List Nat),
    ∃ frontRequirements : Requirements frontDemand, ∃ tailRequirements : Requirements tailDemand,
    ∃ frontScope capturedScope tailScope frontRow tailRow savedRow,
    ∃ savedAnnotated : Requirements contract.resumeDemand,
      RowAnnotation recordedRequirements savedAnnotated ∧ savedRow ⊆ resumeRow ∧
      PlannedModeSource operations policy contracts tables families required outward actions world front
        (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured
        (.value contract.input) boundary contract.resumeDemand recordedRequirements capturedScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail
        boundary output tailDemand tailRequirements tailScope ∧
      (boundary = .value contract.answer ∨ boundary = .unwind) ∧
      contract.input.erase.erase.port = ScopedPorts.eraseType inputType ∧
      contract.answer.erase.erase.port = ScopedPorts.eraseType answerType ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      contract.held = ProtectionContexts.protectedMode captured.erase ∧
      scope = frontScope.append (.live owner capturedScope tailScope) ∧
      pendingDemand = frontDemand ++ tailDemand ∧ pendingRow = frontRow ++ tailRow ∧
      Bound annotations (capturedScope.append (frontScope.append (.spent owner tailScope))) ∧
      RecursiveRequirements.Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))
        (spend before owner) (annotateDisposals recordedRequirements) savedRow ∧
      RecursiveRequirements.Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))
        (spend before owner) (annotateDisposals savedAnnotated) resumeRow ∧
      RecursiveRequirements.Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
        (OwnerPhases.ofStack tables (.spent owner answerType caller tail))
        (spendAll (spend before owner) contract.resumeDemand) (annotateDisposals frontRequirements) frontRow ∧
      RecursiveRequirements.Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) []
        (spendAll (spendAll (spend before owner) contract.resumeDemand) frontDemand)
        (annotateDisposals tailRequirements) tailRow := by
  have invoked : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) [] before
      (.invoke ⟨owner, .resume⟩ contract.resumeDemand
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) resumeRow := by
    change RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) [] before
      ((Requirements.invoke ⟨owner, .resume⟩ contract.resumeDemand []).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) resumeRow
    apply RecursiveRequirements.checked_prepend_iff.mpr
    simpa only [List.append_nil] using invocation
  obtain ⟨normalPendingRow, normalPending, pendingBound⟩ := (disposal_annotation pendingRequirements).checked pending
  obtain ⟨boundary, frontDemand, tailDemand, frontRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontSource, savedSource, tailSource, returns,
    inputAnnotation, answerAnnotation, callerScope, held, scopeSame, demandSame, nextBound, evaluation, generatedEvaluation⟩ :=
    extract_planned_recorded_resume_disposals source known (RecursiveRequirements.Checked.sequence invoked normalPending) records found bound unique
  obtain ⟨frontRow, tailRow, savedRow, savedAnnotated,
    savedAnnotation, savedBound, rowSame, savedChecked, savedAnnotatedCheck, frontChecked, tailChecked⟩ :=
    resume_fragment_rows_generated (contract := contract.erase) storeAnnotation found invocation pending generatedEvaluation
  exact ⟨boundary, frontDemand, tailDemand, frontRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontRow, tailRow, savedRow, savedAnnotated,
    savedAnnotation, savedBound, frontSource, savedSource, tailSource,
    returns, inputAnnotation, answerAnnotation, callerScope, held, scopeSame, demandSame, rowSame,
    nextBound, savedChecked, savedAnnotatedCheck, frontChecked, tailChecked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

