namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (spendAll)

/-- Generate captured cleanup and keep the caller behind its closing boundary.
The caller may itself return ordinarily or unwind; the selected capture is
retired only once in either case. -/
theorem RecordPendingRows.discard_recompose
    {contract : SourcePlannedTyping.Contract} {known : contracts owner = some contract}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value .unit) middle frontDemand frontRequirements frontScope}
    {savedSource : PlannedModeSource operations policy contracts tables families required outward actions world
      captured savedInput savedOutput savedDemand savedRequirements capturedScope}
    {tailSource : PlannedModeSource operations policy contracts tables families required outward actions world
      tail middle output tailDemand tailRequirements tailScope}
    (frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes frontSource (.value .unit) middleRows frontContext)
    (savedRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes savedSource savedInputRows savedOutputRows capturedContext)
    (tailRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes tailSource middleRows outputRows tailContext)
    (answerRows : ModeRowsValue.Answer (owners owner contract known).2 middleRows)
    (answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType)
    (callerKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller)
    (closing : capturedContext.closing? = some metadata)
    (runtimeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
    (identity : Nat) :
    ∃ requirements : Requirements (metadata.closing.1 ++ (frontDemand ++ tailDemand)),
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answerType caller tail)))) .unwind output
      (metadata.closing.1 ++ (frontDemand ++ tailDemand)) requirements
      (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) source .unwind outputRows
        (capturedContext.append (.closing (frontContext.append (.spent (owner := owner) tailContext)))) ∧
      metadata.closing.1.Perm (ownedTickets captured) ∧
      ∀ entries receiving phases,
        evaluate entries receiving phases (annotateDisposals requirements) =
          merge (evaluate entries (OwnerPhases.ofStack tables (.push (.closing identity runtimeScope)
            (front.append (.spent owner answerType caller tail))) ++ receiving) phases metadata.closing.2)
            (merge (evaluate entries (OwnerPhases.ofStack tables (.spent owner answerType caller tail) ++ receiving)
              (spendAll phases metadata.closing.1) (annotateDisposals frontRequirements))
              (evaluate entries receiving (spendAll (spendAll phases metadata.closing.1) frontDemand)
                (annotateDisposals (.sequence (.spent owner) tailRequirements)))) := by
  obtain ⟨spentSource, spentRows⟩ :
      ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
          (.spent owner answerType caller tail) middle output tailDemand
          (.sequence (.spent owner) tailRequirements) (.spent owner tailScope),
        RecordPendingRows operations policy contracts tables families required outward actions world
          ports owners emptyRows resumes source middleRows outputRows (.spent (owner := owner) tailContext) := by
    cases answerRows with
    | value => exact ⟨.spent known answerAnnotation callerKnown tailSource, .spent (known := known) (annotation := answerAnnotation) (callerScope := callerKnown) tailRows⟩
    | unwind => exact ⟨.skippedSpent tailSource, .skippedSpent tailRows⟩
  obtain ⟨closeRequirements, closeSource, closeRows, unchanged, ownership, closeEvaluation⟩ :=
    savedRows.closing_rich closing
  obtain ⟨waitingRequirements, waitingSource, waitingRows, waitingEval, waitingGenerated⟩ :=
    (frontRows.remove_records owner).append_disposals (spentRows.remove_records owner)
  have closingRows := RecordPendingRows.push
    (ModeFrameRows.closing (identity := identity) (input := .unwind) (inputRows := .unwind)
      (scopeKnown := runtimeKnown)) waitingRows
  obtain ⟨requirements, source, rows, evaluation, generated⟩ :=
    (closeRows.remove_records owner).append_disposals closingRows
  refine ⟨requirements, source, rows, ownership, ?_⟩
  intro entries receiving phases
  rw [generated, closeEvaluation]
  simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
    RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty,
    spendAll, RecursiveRecomposition.merge_empty_left, waitingGenerated]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.discard_recompose

