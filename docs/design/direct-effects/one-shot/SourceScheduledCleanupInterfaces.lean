/-- Returning from a consumed operation clause restores the exact saved caller.
The rich value type and latent bodies survive; immediate value checks normalize
to the pure plan, and the whole old generated certificate remains retained. -/
theorem leave_clause_planned_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      value input currentDemand currentRequirements (signature plan))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.spent owner answer caller tail) (.value input) output pendingDemand pendingRequirements dependencyScope)
    (closed : ClosedValue value)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints (.spent owner answer caller tail))
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.spent owner answer caller tail))) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (unique : (ownedTickets (.spent owner answer caller tail)).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩)) :
    ∃ nextScope, ∃ nextRequirements : Requirements pendingDemand,
    ∃ nextHints : ReturnHints nextScope, ∃ nextAnnotated : Requirements ([] ++ pendingDemand), ∃ nextRow,
