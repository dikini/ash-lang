/-- Recompose actual rich ordinary-return fragments, retaining every surviving
saved-source agreement after consuming the selected continuation. -/
theorem RecordPendingRows.resume_recompose_ordinary
    {contract : SourcePlannedTyping.Contract}
    {known : contracts owner = some contract}
    {recorded : Requirements contract.resumeDemand}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope}
    {liveSource : PlannedModeSource operations policy contracts tables families required outward actions world
      (.live owner inputType answerType captured caller tail) liveInput output
      tailDemand liveRequirements (.live owner capturedScope tailScope)}
    (frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes frontSource (.value (owners owner contract known).2)
        (.value (owners owner contract known).2) frontContext)
    (liveRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes liveSource liveInputRows outputRows
        (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (ordinaryInput : liveInput = .value contract.answer)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recorded⟩)
    (ordinary : LexicalUnwind.returnMode captured .ordinary = .ordinary) :
    ∃ requirements : Requirements (contract.resumeDemand ++ (frontDemand ++ tailDemand)),
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
      (contract.resumeDemand ++ (frontDemand ++ tailDemand)) requirements
      (capturedScope.append (frontScope.append (.spent owner tailScope))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) source
        (.value (owners owner contract known).1) outputRows
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) ∧
      ∀ entries receiving phases,
        evaluate entries receiving phases (annotateDisposals requirements) =
          merge (evaluate entries (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)) ++ receiving)
            phases (annotateDisposals recorded))
            (merge (evaluate entries (OwnerPhases.ofStack tables (.spent owner answerType caller tail) ++ receiving)
              (spendAll phases contract.resumeDemand) (annotateDisposals frontRequirements))
              (evaluate entries receiving (spendAll (spendAll phases contract.resumeDemand) frontDemand)
                (annotateDisposals liveRequirements))) := by
  cases liveRows with
  | live answerRows agreement inside tailRows =>
      have sameContract := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      rename_i contract rights boundary body answer boundaryRows actualKnown actionKnown
        inputAnnotation answerAnnotation held callerScope tailRequirements saved tailSource
      have returnMode := saved.return_mode
      rcases answer with same | same
      · subst_vars
        cases answerRows
        have sameRecorded := agreement.requirements_eq found
        subst recorded
        have spentRows := RecordPendingRows.spent (owner := owner) (answerType := answerType)
          (known := known) (annotation := by assumption) (callerScope := by assumption)
          (tailRows.remove_records owner)
        obtain ⟨callerRequirements, callerSource, callerRows, callerEval, callerGenerated⟩ :=
          (frontRows.remove_records owner).append_disposals spentRows
        obtain ⟨requirements, source, rows, evaluation, generated⟩ :=
          (inside.remove_records owner).append_disposals callerRows
        refine ⟨requirements, source, rows, ?_⟩
        intro entries receiving phases
        rw [generated, callerGenerated]
      · subst_vars
        change LexicalUnwind.returnMode captured .ordinary = .unwind at returnMode
        rw [ordinary] at returnMode
        cases returnMode
  | opening answerRows agreement ordinarySaved inside tailRows => cases ordinaryInput

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_recompose_ordinary

