/-- Discard exposes the exact abandoned continuation, with its lexical close
boundary, and the check after spending the selected owner. -/
theorem Accounting.Run.dispose_accounting
    {hints : ReturnHints scope} {context : Context hints}
    (run : Accounting.Run world installations (Rows.invoke (key := ⟨owner, .dispose⟩)) context (root : Requirements demand))
    (checked : Checked (annotateDisposalStore entries) receiving phases (annotateDisposals root) row) :
    ∃ front captured tail : Packed, ∃ resumeDemand : List Nat,
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand,
      context.pack = (front.context.append
        (.live (owner := owner) (resumeDemand := resumeDemand) captured.context tail.context)).pack ∧
      OwnerCut owner scope ⟨front.scope, captured.scope, tail.scope⟩ ∧
      demand = owner :: nextDemand ∧
      Accounting.Wait world installations (captured.context.append
        (.closing (front.context.append (.spent (owner := owner) tail.context)))) .unwind nextRoot ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner entries)) receiving
        (spend phases owner) (annotateDisposals nextRoot) row := by
  cases run with
  | dispose located abandoned =>
    exact ⟨⟨_, _, _⟩, ⟨_, _, _⟩, ⟨_, _, _⟩, _, _, _, rfl, located, rfl,
      abandoned, retire_prefix_checked checked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.dispose_accounting


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)
