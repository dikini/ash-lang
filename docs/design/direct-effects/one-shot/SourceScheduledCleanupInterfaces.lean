/-- Bind, beta, and both boolean branches preserve the rich current source and
all generated whole-state facets in one actual computation step. The unchanged
stack retains its exact saved records; the complete prior row annotation is
retained, including alternatives not selected by this computation. -/
theorem computation_planned_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      code input currentDemand currentRequirements (signature plan))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value input) output pendingDemand pendingRequirements dependencyScope)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (ready : Ready code)
    (step : RawStep ⟨code, runtimeScope, stack⟩ after [] [])
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints stack)
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨code, runtimeScope, stack⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨code, runtimeScope, stack⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨code, runtimeScope, stack⟩)) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand,
    ∃ nextDependencies, ∃ nextPlan : Plan nextDependencies, ∃ nextTicket,
    ∃ nextAnnotated : Requirements (nextDemand ++ pendingDemand), ∃ nextRow,
      SourcePlannedSources.Expression operations policy contracts world allowed after.scope (fun _ => none)
        after.expression input nextDemand nextRequirements (signature nextPlan) ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      ScopedPorts.EffectScope contracts.erase.erase.ports after.scope nextTicket ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        after.stack (.value input) output pendingDemand pendingRequirements dependencyScope ∧
      currentDemand.Perm nextDemand ∧ after.stack = stack ∧
      RowAnnotation
        (.sequence (nextRequirements.prepend (OwnerPhases.ofStack tables after.stack)) pendingRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world nextDependencies hints ∧
      Pending outward actions phases world hints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families hints after.stack ∧ Bound annotations dependencyScope ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world stack key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world after.stack key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world stack key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world after.stack key body) ∧
      RawStep ⟨code, runtimeScope, stack⟩ after [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨code, runtimeScope, stack⟩) (.eval after) [] [] ∧
      ownedTickets after.stack = ownedTickets stack ∧
      LexicalUnwind.MachineUse policy actions (.eval after) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval after) ∧
      LexicalUnwind.MachineAccess ambient (.eval after) := by
  obtain ⟨nextDemand, nextReq, nextDep, nextPlan, nextTicket, nextSource, nextCertified, nextLocal,
    nextScope, demandSame, stackSame, _, _, transfer⟩ :=
    computation_source_generated current scopeTyped certified checked ready step
  obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked rowChecked
  simp only [annotateDisposals, disposal_prepend] at normalCheck
  obtain ⟨currentRow, pendingRow, currentCheck, pendingCheck, normalSame⟩ :=
    RecursiveRequirements.checked_sequence_parts normalCheck
  obtain ⟨nextCurrentRow, nextCurrentCheck, nextWithin⟩ := transfer entries
    (OwnerPhases.ofStack tables stack ++ receiving) before currentRow
    (RecursiveRequirements.checked_prepend_iff.mp currentCheck)
  let nextRoot := Requirements.sequence (nextReq.prepend (OwnerPhases.ofStack tables after.stack)) pendingRequirements
  have nextNormal : Checked entries receiving before (annotateDisposals nextRoot) (nextCurrentRow ++ pendingRow) := by
    simp only [nextRoot, annotateDisposals, disposal_prepend, stackSame]
    exact .sequence (RecursiveRequirements.checked_prepend_iff.mpr nextCurrentCheck)
      (by simpa only [PhaseRechecking.spendAll_permutation demandSame] using pendingCheck)
  have nextBound : nextCurrentRow ++ pendingRow ⊆ row := by
    apply List.Subset.trans (List.append_subset.mpr ⟨nextWithin.trans (List.subset_append_left _ _), List.subset_append_right _ _⟩)
    simpa only [normalSame] using within
  have aligned : (nextDemand ++ pendingDemand).Perm (currentDemand ++ pendingDemand) :=
    demandSame.symm.append_right _
  have head : LexicalUnwind.computationHead code := by cases ready <;> trivial
  have nextUse := LexicalUnwind.raw_computation_machine_use step head (by intro owner member; cases member) usage
  have nextTickets := LexicalUnwind.raw_computation_machine_ticket_access step head
    (by intro owner member; cases member) usage ticketAccess
  have accessChecks : AccessChecks ⟨code, runtimeScope, stack⟩ ambient :=
    ScopedPortJoint.ordinary_access_checks (RecursiveExpressions.ready_not_value ready)
      (by intro requested operation operand; cases ready <;> simp)
      (by intro binder; cases ready <;> simp)
  refine ⟨nextDemand, nextReq, nextDep, nextPlan, nextTicket,
    .choice nextRoot annotated aligned, (nextCurrentRow ++ pendingRow) ++ row,
    nextSource, nextCertified, nextScope, by simpa only [stackSame] using pending,
    demandSame, stackSame, .alternatives .original aligned, .no .here, .no .here,
    .choice nextNormal rowChecked, List.append_subset.mpr ⟨nextBound, List.Subset.refl _⟩,
    nextLocal, retained, by simpa only [stackSame] using matching, annotationBound,
    by intro key body record; simpa only [stackSame] using record,
    by intro key body record; simpa only [stackSame] using record, step, .evaluate step head,
    congrArg ownedTickets stackSame, ?_, ?_, ?_⟩
  · simpa only [ScopedExecution.advanceUsageTickets] using nextUse
  · simpa only [ScopedExecution.advanceUsageTickets] using nextTickets
  · cases resourceAccess with | eval supported => exact .eval (raw_step_preserves_access step supported accessChecks)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.computation_planned_generated

