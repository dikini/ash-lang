/-- Runtime freshness excludes every retained ticket marker, not just live ownership. -/
theorem ExecutableState.fresh_ticket_absent
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows run)
    (fresh : Owner.ticket owner ∉ run.execution.issued) :
    owner ∉ run.execution.machine.stack.erase.ticketNames :=
  state.ticketHistory.fresh_absent fresh

/-- The actual allocation check supplies the freshness used by a request binder. -/
theorem ExecutableState.allocated_ticket_absent
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows run)
    (fresh : (run.execution.issued ++ [Owner.ticket owner]).Nodup) :
    owner ∉ run.execution.machine.stack.erase.ticketNames := by
  apply state.fresh_ticket_absent
  intro member
  exact (List.nodup_append.mp fresh).2.2 _ member _ List.mem_cons_self rfl

/-- Transfer physical freshness to the literal source context used by accounting. -/
theorem ExecutableState.allocated_context_ticket_absent
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows run)
    {hints : ReturnHints scope} {context : Context hints}
    (coherent : Context.Source operations.erase policy contracts.erase tables families world context run.execution.machine.stack)
    (fresh : (run.execution.issued ++ [Owner.ticket owner]).Nodup) :
    owner ∉ context.ticketNames := by
  rw [coherent.ticketNames_eq]
  exact state.allocated_ticket_absent fresh

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
