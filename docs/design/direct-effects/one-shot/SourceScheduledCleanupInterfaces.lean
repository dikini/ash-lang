open Contextual
theorem FocusRows.source_certificate
    (split : FocusRows wholeRows childRows restRows)
    (checked : SourceAdmission.Code outward actions budget phases world installations wholeRows context) :
    SourceAdmission.Code outward actions budget phases world installations childRows (.plain restRows context) ∧
      SourceAdmission.Code outward actions budget phases world installations restRows context := by
  cases split with
  | pure => exact ⟨.pure, .pure⟩
  | sequence =>
      cases checked with
      | sequence first second => exact ⟨first, second⟩
  | pairRight _ =>
      cases checked with
      | sequence first second => exact ⟨second.plain_pure, .pure⟩
  | appArgument _ =>
      cases checked with
      | sequence function rest =>
          cases rest with
          | sequence argument body => exact ⟨argument, body⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

