namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Examples
open ScopedExpressions ScopedExecution ProtectionContracts
open SourcePlannedTyping (Operations Contracts Value Environment)
open SourcePlannedSources (Expression)
open RecursiveRequirements (Requirements)
open SourcePlanSignatures (Signature)

def callbackEffect : Instance := .user 73 []
def callbackRow : Footprint := [⟨callbackEffect, 0, false⟩]
def operations : Operations := fun _ _ => some (.unit, .unit)
def contracts : Contracts := fun _ => none
def environment : Environment := fun _ => none
def policy : Syntax.TicketPolicy := fun _ => ⟨true, true⟩

def operationRows : OperationRows operations := by
  intro effect operation input output known
  cases known
  exact ⟨.unit, .unit⟩

def contractRows : ContractRows contracts := by
  intro owner contract known
  cases known

def environmentRows : EnvironmentRows environment := by
  intro name value known
  cases known

def noRequirements : Requirements [] := .request [] []
def callbackSignature : Signature (.sequence .pure (.request callbackEffect 0)) :=
  .sequence .pure .request

def callbackType : Value := .function .unit .unit [callbackEffect] callbackRow callbackSignature

def callback : Code := .lambda 1 (.perform (Instantiation.freezeEffect callbackEffect) 0 .unit)
def program : Code := .bind 0 callback (.cleanup (.variable 0) (.integer 17))
def cleanupRequirements : Requirements [] :=
  .emitAfter (.sequence noRequirements noRequirements) [] (qualify true callbackRow)
def programRequirements : Requirements [] := .sequence noRequirements cleanupRequirements

def programSignature : Signature (.sequence .pure (.sequence .pure (.cleanup [callbackEffect]
    (.sequence .pure (.request callbackEffect 0)) .pure))) :=
  .sequence .pure (.sequence .pure (.cleanup callbackSignature .pure))

theorem callback_body_source : Expression operations policy contracts [] [callbackEffect] .none
    (environment.extend 1 .unit) (.perform (Instantiation.freezeEffect callbackEffect) 0 .unit)
    .unit [] (.emitAfter noRequirements [] callbackRow) callbackSignature :=
  .perform rfl List.mem_cons_self .unit
    (by simp [Value.erase, SourceDependencyAnnotations.Value.erase, ScopedPorts.InWorld,
      CoherentSourceTypes.Value.port, ScopedPorts.Port.resources])

theorem callback_source : Expression operations policy contracts [] [callbackEffect] .none environment
    callback callbackType [] noRequirements .pure := by
  apply Expression.lambda (body := callback_body_source)
  · exact .emitAfter (layers := []) (.request (layers := []))
  · simp [Value.erase, SourceDependencyAnnotations.Value.erase, ScopedPorts.InWorld,
      CoherentSourceTypes.Value.port, ScopedPorts.Port.resources, callbackEffect, Instance.resources]
  · intro request member
    cases List.mem_singleton.mp member
    exact List.mem_cons_self

theorem callback_variable_source : Expression operations policy contracts [] [callbackEffect] .none
    (environment.extend 0 callbackType) (.variable 0) callbackType [] noRequirements .pure :=
  .variable rfl
    (by simp [callbackType, Value.erase, SourceDependencyAnnotations.Value.erase, ScopedPorts.InWorld,
      CoherentSourceTypes.Value.port, ScopedPorts.Port.resources, callbackEffect, Instance.resources])

theorem cleanup_source : Expression operations policy contracts [] [callbackEffect] .none
    (environment.extend 0 callbackType) (.cleanup (.variable 0) (.integer 17)) .integer []
    cleanupRequirements (.sequence .pure (.cleanup (needs := [callbackEffect]) callbackSignature .pure)) :=
  .cleanup callback_variable_source .integer (List.Subset.refl _)

theorem program_source : Expression operations policy contracts [] [callbackEffect] .none environment
    program .integer [] programRequirements programSignature := by
  exact .bind callback_source cleanup_source

def callbackMetadata : ValueRows callbackType := .function .unit .unit (.sequence .pure .request)
def programMetadata : Rows programSignature :=
  .sequence .pure (.sequence .pure (.cleanup callbackRow (.sequence .pure .request) .pure))

/-- The callback arrives through the ordinary variable environment. Its
nonempty latent row is authenticated by the actual rich lambda/operation source,
then retained through bind and cleanup without any source/admission premise. -/
theorem program_authenticated : Auth operations policy operationRows contractRows environmentRows
    program_source .integer programMetadata := by
  apply Auth.bind (initializer := callback_source) (body := cleanup_source) (inputRows := callbackMetadata)
  · apply Auth.lambda (body := callback_body_source)
      (outward := .emitAfter (layers := []) (.request (layers := [])))
      (formed := by simp [Value.erase, SourceDependencyAnnotations.Value.erase, ScopedPorts.InWorld,
        CoherentSourceTypes.Value.port, ScopedPorts.Port.resources, callbackEffect, Instance.resources])
      (latentBound := by intro request member; cases List.mem_singleton.mp member; exact List.mem_cons_self)
    apply Auth.perform (known := show operations callbackEffect 0 = some (.unit, .unit) from rfl)
      (operand := Expression.unit) (admitted := List.mem_cons_self)
      (formed := by simp [Value.erase, SourceDependencyAnnotations.Value.erase, ScopedPorts.InWorld,
        CoherentSourceTypes.Value.port, ScopedPorts.Port.resources])
    exact Auth.unit
    · simp [LambdaPortCaptureSupport.captures, Code.dependencies,
        callbackEffect, Instance.resources, Syntax.without,
        LambdaPortCaptureSupport.portSupport, ScopedPorts.Support.evaluate, Value.erase,
        SourceDependencyAnnotations.Value.erase, CoherentSourceTypes.Value.port, ScopedPorts.Port.resources]
  · apply Auth.cleanup (callback := callback_variable_source) (body := Expression.integer)
      (admitted := List.Subset.refl _)
    · exact Auth.variable
        (known := show (environment.extend 0 callbackType) 0 = some callbackType from rfl)
        (formed := by simp [callbackType, Value.erase, SourceDependencyAnnotations.Value.erase, ScopedPorts.InWorld,
          CoherentSourceTypes.Value.port, ScopedPorts.Port.resources, callbackEffect, Instance.resources])
    · exact Auth.integer

/-- This example has no free ordinary variable, resource name or ticket. -/
theorem program_closed : program.freeNames = [] ∧ program.dependencies = [] := by
  decide

theorem callback_row_nonempty : callbackRow ≠ [] := by decide

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Examples

