/-- Focus preserves the strengthened common state. Source, pending metadata,
budgets and generated root checks use one shared source decomposition. -/
theorem RetainedState.focus
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨whole, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (position : Focus whole child evaluationContext) :
    ∃ plain : PlainData, plain.context = evaluationContext ∧ plain.scope = runtimeScope ∧
      RetainedState operations policy contracts tables families required outward annotations world ambient history
        resumes disposals annotatedStore budget ports owners emptyRows output outputRows
        ⟨⟨.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩, issued, completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i hints context resultRows
    obtain ⟨ticket, typed⟩ := scopeTyped
    obtain ⟨plain, input, childDemand, restDemand, childRequirements, restRequirements, childDependencies, restDependencies,
      childPlan, restPlan, inputRows, childRows, restRows, contextSame, scopeSame, sameDemand,
      nextCurrent, nextCertified, ⟨nextPending, nextCoherent⟩, nextBudget, raw, restCheck, evaluation⟩ :=
      SourceAdmission.Admitted.focus_retained_details ⟨current, currentCertificate⟩ certified coherent.forget pendingCertificate typed position
    have nextRecorded := coherent.prepend_plain nextCoherent rfl
    obtain ⟨nextAnnotated, nextRow, nextAnnotation, rawPath, generatedPath, nextCheck, included⟩ :=
      focus_root_annotation plain sameDemand (fun entries receiving before => (evaluation entries receiving before).2)
        annotation checked
    have transition : LexicalUnwind.UseTransition (.eval ⟨whole, runtimeScope, stack⟩)
        (.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩) [] [] :=
      .evaluate raw (LexicalUnwind.focus_computation_head position)
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨whole, runtimeScope, stack⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩, issued, completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨whole, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    have restAtNil : Local outward actions (OwnerPhaseTransitions.available (ownedTickets stack)) world restDependencies
        (hints.append .nil) := by
      change Local outward actions (OwnerPhaseTransitions.available (ownedTickets stack)) world restDependencies
        (context.append .nil).pack.hints
      rw [context.append_nil_pack]
      exact restCheck.compile.1
    refine ⟨plain, contextSame, scopeSame, ?_⟩
    refine ⟨?_, ?_, ?_, state.storeAnnotation, event.preserves state.lifetime, ?_, ?_, state.activations, state.issuedResources⟩
    · apply RetainedSource.eval nextCurrent.previous nextCertified ⟨ticket, typed⟩ nextPending nextRecorded nextBudget.compile.2
        (.plain restAtNil retained) (.plain bound) ?_ nextAnnotation
        nextCheck (included.trans bounded) nextCurrent.certificate nextBudget
      simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
        Bool.true_and] using finite
    · intro key body member
      cases state.resumeRecords key body member with
      | resume located known recorded source answer => exact .resume (.push located) known recorded source answer
    · intro key body member
      cases state.unwindRecords key body member with
      | dispose located held recorded source => exact .dispose (.push located) held recorded source
    · simpa only [scopeSame] using LexicalUnwind.focus_machine_ticket_access plain
        (by simpa only [contextSame] using position) (by simpa only [scopeSame] using state.tickets)
    · cases state.resources with
      | eval supported => exact .eval (ScopedExecution.raw_step_preserves_access raw supported (ScopedPortJoint.focus_access_checks position))

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
