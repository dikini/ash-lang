theorem PendingChecked.pure_frame
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) :
    PendingChecked ambient outward admitted.pure_frame := by
  cases before
  · exact .plain .pure checked
  · exact .skipped checked

theorem CodeChecked.deep_pure_history
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : DeepPureHistory context next) :
    CodeChecked ambient outward (admitted.deep_pure_history changed) := by
  refine (CodeChecked.rec
    (motive_1 := fun {actions budget phases world installations dependencies checking rows scope hints context} admitted _ =>
      ∀ {nextScope} {nextHints : ReturnHints nextScope} (next : Context nextHints),
      ∀ changed : DeepPureHistory context next,
        CodeChecked ambient outward (admitted.deep_pure_history changed))
    (motive_2 := fun {actions budget phases world installations scope outsideScope hints external context outside before after} admitted _ =>
      ∀ {nextScope nextOutside} {nextHints : ReturnHints nextScope} {nextExternal : ReturnHints nextOutside}
        (next : Context nextHints) (nextOutside : Context nextExternal),
      ∀ changed : DeepPureHistory context next, ∀ outsideChanged : DeepPureHistory outside nextOutside,
        PendingChecked ambient outward (admitted.deep_pure_history changed outsideChanged))
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    (t := checked)) next changed
  · intros; exact .pure
  · intros
    rename_i found nextScope nextHints next changed
    exact .builtin (found := changed.builtin found)
  · intros
    rename_i cut callbacks guarded ownerBound cleanupBudget family bodies bodyRows declarations declarationRows terminal requiredRights selected retained body
      cleanup waiting clauses ihCallbacks ihRetained ihBody nextScope nextHints next changed
    obtain ⟨_, _, nextCapturedHints, nextTailHints, nextCaptured, nextTail, nextCut, inside, outside, nextSelected⟩ := selected.deep_cut changed cut
    let nextRequest := (SourceAdmission.Code.request cut guarded callbacks ownerBound cleanupBudget selected terminal requiredRights retained body).deep_pure_history changed
    obtain ⟨nextGuarded, nextOwnerBound, nextBudget, nextRetained⟩ := request_parameters nextRequest nextCut
    refine CodeChecked.request (cut := nextCut) (guarded := nextGuarded)
      (ownerBound := nextOwnerBound) (cleanupBudget := nextBudget)
      (selected := nextSelected) (terminal := terminal.deep_at_cut inside nextCut) (requiredRights := requiredRights)
      (callbacks := fun disposing => nextRequest.callbacks_at_cut nextCut disposing) (retained := nextRetained)
      (body := fun owner demand fresh absent => nextRequest.capture_body_with_rights nextCut nextSelected
        (terminal.deep_at_cut inside nextCut) requiredRights fresh absent demand) ?_ ?_ ?_
    · intro disposing
      exact ihCallbacks disposing nextCaptured (.closing nextTail) inside (.closing outside)
    · have kept := ihRetained next Context.nil changed (.same _)
      exact kept.output_mode (changed.return_mode .ordinary)
    · intro owner demand fresh names
      apply ihBody owner demand fresh (by simpa only [changed.ticketNames] using names)
      exact .live inside outside
  · intros
    rename_i located known available permission resumeBudget restored resourceNext ih nextScope nextHints next changed
    rename_i frontScope capturedScope tailScope owner actionsNow rights phaseNow budgetNow worldNow installationsNow resumeDemand frontHints capturedHints tailHints front captured tail
    obtain ⟨nextFront, nextCaptured, nextTail, same, frontChanged, capturedChanged, tailChanged⟩ := changed.decompose_live front captured tail rfl
    have nextLocated := frontChanged.owner_cut capturedChanged tailChanged located
    have expansion := capturedChanged.append (frontChanged.append (DeepPureHistory.spent (owner := owner) tailChanged))
    have transported := ih _ .nil expansion (.same _)
    have modes := (frontChanged.append (DeepPureHistory.live (owner := owner) (resumeDemand := resumeDemand) capturedChanged tailChanged)).return_mode .ordinary
    have transported := transported.output_mode modes
    have shape := ResumeShape.deep frontChanged resumeBudget
    rw [capturedChanged.return_mode .ordinary] at shape
    exact (CodeChecked.resume (resumeDemand := resumeDemand) (front := nextFront.context) (captured := nextCaptured.context) (tail := nextTail.context)
      (located := nextLocated) (known := known) (permission := permission) (available := available) (resumeShape := shape) transported).reindex_context same.symm
  · intros
    rename_i located known available permission unprotected abandoned waiting resourceCleanup resourceCaller ihAbandoned ihWaiting nextScope nextHints next changed
    rename_i frontScope capturedScope tailScope owner actionsNow rights phaseNow budgetNow worldNow installationsNow resumeDemand frontHints capturedHints tailHints front captured tail
    obtain ⟨nextFront, nextCaptured, nextTail, same, frontChanged, capturedChanged, tailChanged⟩ := changed.decompose_live front captured tail rfl
    have nextLocated := frontChanged.owner_cut capturedChanged tailChanged located
    have outside := frontChanged.append (DeepPureHistory.spent (owner := owner) tailChanged)
    have nextAbandoned := ihAbandoned _ _ capturedChanged (.closing outside)
    have nextWaiting := ihWaiting _ .nil outside (.same _)
    have modes := (frontChanged.append (DeepPureHistory.live (owner := owner) (resumeDemand := resumeDemand) capturedChanged tailChanged)).return_mode .ordinary
    have nextWaiting := nextWaiting.output_mode modes
    exact (CodeChecked.dispose (resumeDemand := resumeDemand) (front := nextFront.context) (captured := nextCaptured.context) (tail := nextTail.context)
      (located := nextLocated) (known := known) (permission := permission) (available := available)
      (unprotected := capturedChanged.held ▸ unprotected) nextAbandoned nextWaiting).reindex_context same.symm
  · intros
    rename_i first second left right ihFirst ihSecond nextScope nextHints next changed
    exact .choice (ihFirst next changed) (ihSecond next changed)
  · intros
    rename_i body callback inside closing ihBody ihCallback nextScope nextHints next changed
    exact .cleanup (ihBody (.cleanup _ _ next) (.cleanup _ changed))
      (ihCallback (.normal next) (.normal changed))
  · intros
    rename_i body inside ih nextScope nextHints next changed
    exact .resource (fun identity fresh => ih identity fresh (.cell next) (.cell changed))
  · intros
    rename_i first second left right ihFirst ihSecond nextScope nextHints next changed
    exact .sequence (ihFirst (.plain _ next) (.plain _ changed)) (ihSecond next changed)
  · intros
    rename_i body supported inside ih nextScope nextHints next changed
    exact .handler (by simpa only [← changed.visible_resources] using supported) (fun activation fresh => ih activation fresh (.handler activation _ next) (.handler _ changed))
  · intros
    rename_i nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .nil
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .plain (ihCode _ (DeepPureHistory.append (by first | exact .same _ | assumption) outsideChanged))
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .skipped (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .handler (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .cell (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .cleanup (ihCode _ ((DeepPureHistory.append (by first | exact .same _ | assumption) outsideChanged).callback _))
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .normal (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .unwinding (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .closing (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .retiring (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .live (ihCode _ _ (by first | exact .same _ | assumption) (DeepPureHistory.append (by first | exact .same _ | assumption) outsideChanged))
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .opening (ihCode _ _ (by first | exact .same _ | assumption) (.retiring (DeepPureHistory.append (by first | exact .same _ | assumption) outsideChanged)))
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact PendingChecked.pure_frame (ihHistory history))
      | exact .spent (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged)


theorem PendingChecked.outside_deep_pure_history
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints externalScope} {outside : Context external}
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted)
    (changed : DeepPureHistory outside next) :
    PendingChecked ambient outward (admitted.outside_deep_pure_history changed) := by
  induction context generalizing externalScope nextScope before after with
  | nil => cases checked; exact .nil
  | plain rows rest ih => cases checked with
    | plain code tail => exact .plain (code.deep_pure_history (changed.prefix rest)) (ih tail changed)
    | skipped tail => exact .skipped (ih tail changed)
  | handler activation rows rest ih => cases checked with
    | handler tail => exact .handler (ih tail changed)
  | cell rest ih => cases checked with
    | cell tail => exact .cell (ih tail changed)
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback tail => exact .cleanup (callback.deep_pure_history ((changed.prefix rest).callback _)) (ih tail changed)
  | normal rest ih => cases checked with
    | normal tail => exact .normal (ih tail changed)
  | unwinding rest ih => cases checked with
    | unwinding tail => exact .unwinding (ih tail changed)
  | closing rest ih => cases checked with
    | closing tail => exact .closing (ih tail changed)
  | retiring owner rest ih => cases checked with
    | retiring tail => exact .retiring (ih tail changed)
  | live saved rest ihSaved ihRest => cases checked with
    | live captured tail => exact .live (ihSaved captured (changed.prefix rest)) (ihRest tail changed)
    | opening captured tail => exact .opening (ihSaved captured (.retiring (changed.prefix rest))) (ihRest tail changed)
  | spent rest ih => cases checked with
    | spent tail => exact .spent (ih tail changed)

theorem PendingChecked.deep_pure_history
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints externalScope} {outside : Context external}
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    {nextExternal : ReturnHints nextOutsideScope} {nextOutside : Context nextExternal}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted)
    (changed : DeepPureHistory context next) (outsideChanged : DeepPureHistory outside nextOutside) :
    PendingChecked ambient outward (admitted.deep_pure_history changed outsideChanged) := by
  induction changed generalizing externalScope nextOutsideScope before after with
  | same context => exact checked.outside_deep_pure_history outsideChanged
  | add changed ih => exact (ih checked outsideChanged).pure_frame
  | plain rows changed ih => cases checked with
    | plain code rest => exact .plain (code.deep_pure_history (changed.append outsideChanged)) (ih rest outsideChanged)
    | skipped rest => exact .skipped (ih rest outsideChanged)
  | handler rows changed ih => cases checked with | handler rest => exact .handler (ih rest outsideChanged)
  | cell changed ih => cases checked with | cell rest => exact .cell (ih rest outsideChanged)
  | cleanup rows changed ih => cases checked with
    | cleanup callback rest => exact .cleanup (callback.deep_pure_history ((changed.append outsideChanged).callback _)) (ih rest outsideChanged)
  | normal changed ih => cases checked with | normal rest => exact .normal (ih rest outsideChanged)
  | unwinding changed ih => cases checked with | unwinding rest => exact .unwinding (ih rest outsideChanged)
  | closing changed ih => cases checked with | closing rest => exact .closing (ih rest outsideChanged)
  | retiring changed ih => cases checked with | retiring rest => exact .retiring (ih rest outsideChanged)
  | live saved changed ihSaved ih => cases checked with
    | live inside rest => exact .live (ihSaved inside (changed.append outsideChanged)) (ih rest outsideChanged)
    | opening inside rest => exact .opening (ihSaved inside (.retiring (changed.append outsideChanged))) (ih rest outsideChanged)
  | spent changed ih => cases checked with | spent rest => exact .spent (ih rest outsideChanged)

open DeepSpentTransport
open OwnerPhaseTransitions (spend)

theorem CodeChecked.deep_history
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : DeepSpentHistory freshOwner context next) (consumed : phases freshOwner = .consumed) :
    CodeChecked ambient outward (admitted.deep_history changed consumed) := by
  refine (CodeChecked.rec
    (motive_1 := fun {actions budget phases world installations dependencies checking rows scope hints context} admitted _ =>
      ∀ {nextScope} {nextHints : ReturnHints nextScope} (next : Context nextHints),
      ∀ changed : DeepSpentHistory freshOwner context next, ∀ consumed : phases freshOwner = .consumed,
        CodeChecked ambient outward (admitted.deep_history changed consumed))
    (motive_2 := fun {actions budget phases world installations scope outsideScope hints external context outside before after} admitted _ =>
      ∀ {nextScope nextOutside} {nextHints : ReturnHints nextScope} {nextExternal : ReturnHints nextOutside}
        (next : Context nextHints) (nextOutside : Context nextExternal),
      ∀ changed : DeepSpentHistory freshOwner context next, ∀ outsideChanged : DeepSpentHistory freshOwner outside nextOutside,
      ∀ consumed : phases freshOwner = .consumed,
        PendingChecked ambient outward (admitted.deep_history changed outsideChanged consumed))
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    (t := checked)) next changed consumed
  · intros; exact .pure
  · intros
    rename_i found nextScope nextHints next changed consumed
    exact .builtin (found := changed.builtin found)
  · intros
    rename_i cut callbacks guarded ownerBound cleanupBudget family bodies bodyRows declarations declarationRows terminal requiredRights selected retained body
      cleanup waiting clauses ihCallbacks ihRetained ihBody nextScope nextHints next changed consumed
    obtain ⟨_, _, nextCapturedHints, nextTailHints, nextCaptured, nextTail, nextCut, inside, outside⟩ := changed.cut cut
    have nextSelected := inside.selected_at_cut selected nextCut
    have nextTerminal := inside.terminal_at_cut terminal nextCut
    let nextRequest := (SourceAdmission.Code.request cut guarded callbacks ownerBound cleanupBudget selected terminal requiredRights retained body).deep_history changed consumed
    obtain ⟨nextGuarded, nextOwnerBound, nextBudget, nextRetained⟩ := request_parameters nextRequest nextCut
    refine CodeChecked.request (cut := nextCut) (guarded := nextGuarded)
      (ownerBound := nextOwnerBound) (cleanupBudget := nextBudget)
      (selected := by simpa only [← inside.held] using nextSelected) (terminal := nextTerminal) (requiredRights := requiredRights)
      (callbacks := fun disposing => nextRequest.callbacks_at_cut nextCut disposing) (retained := nextRetained)
      (body := fun owner demand fresh absent => nextRequest.capture_body_with_rights nextCut
        (by simpa only [← inside.held] using nextSelected) nextTerminal requiredRights fresh absent demand) ?_ ?_ ?_
    · intro disposing
      exact ihCallbacks disposing nextCaptured (.closing nextTail) inside (.closing outside) consumed
    · exact (ihRetained next .nil changed (.same _) consumed).output_mode (changed.return_mode .ordinary)
    · intro owner resumeDemand fresh absent
      have oldAbsent := fun member => absent (changed.ticketNames_subset member)
      have names := congrArg (fun packed : Packed => packed.context.ticketNames) nextCut.decomposition
      change next.ticketNames = (nextCaptured.append nextTail).ticketNames at names
      rw [Context.append_ticketNames] at names
      have absentRegions : owner ∉ nextCaptured.ticketNames ∧ owner ∉ nextTail.ticketNames := by
        rw [names] at absent
        exact ⟨fun member => absent (List.mem_append_left _ member),
          fun member => absent (List.mem_append_right _ member)⟩
      by_cases sameOwner : owner = freshOwner
      · subst owner
        have sameCapture := inside.eq_of_absent absentRegions.1
        have sameTail := outside.eq_of_absent absentRegions.2
        cases sameCapture
        cases sameTail
        exact clauses freshOwner resumeDemand fresh oldAbsent
      · exact ihBody owner resumeDemand fresh oldAbsent _ (.live inside outside)
          (by simp [OwnerPhaseTransitions.introduce, (show freshOwner ≠ owner from fun same => sameOwner same.symm), consumed])
  · intros
    rename_i located known available permission resumeBudget restored resourceNext ih nextScope nextHints next changed consumed
    rename_i frontScope capturedScope tailScope owner actionsNow rights phaseNow budgetNow worldNow installationsNow resumeDemand frontHints capturedHints tailHints front captured tail
    obtain ⟨nextFront, nextCaptured, nextTail, same, frontChanged, capturedChanged, tailChanged⟩ := changed.decompose_live front captured tail rfl
    have nextLocated := frontChanged.owner_cut capturedChanged tailChanged located
    have expansion := capturedChanged.append (frontChanged.append (DeepSpentHistory.spent (owner := owner) tailChanged))
    have remainsConsumed : spend phaseNow owner freshOwner = .consumed := by simp [spend, consumed]
    have transported := ih _ .nil expansion (.same _) remainsConsumed
    have modes := (frontChanged.append (DeepSpentHistory.live (owner := owner) (resumeDemand := resumeDemand) capturedChanged tailChanged)).return_mode .ordinary
    have transported := transported.output_mode modes
    exact (CodeChecked.resume (resumeDemand := resumeDemand) (front := nextFront.context) (captured := nextCaptured.context) (tail := nextTail.context)
      (located := nextLocated) (known := known) (permission := permission) (available := available)
      (resumeShape := by simpa only [← capturedChanged.return_mode] using frontChanged.resume_shape resumeBudget) transported).reindex_context same.symm
  · intros
    rename_i located known available permission unprotected abandoned waiting resourceCleanup resourceCaller ihAbandoned ihWaiting nextScope nextHints next changed consumed
    rename_i frontScope capturedScope tailScope owner actionsNow rights phaseNow budgetNow worldNow installationsNow resumeDemand frontHints capturedHints tailHints front captured tail
    obtain ⟨nextFront, nextCaptured, nextTail, same, frontChanged, capturedChanged, tailChanged⟩ := changed.decompose_live front captured tail rfl
    have nextLocated := frontChanged.owner_cut capturedChanged tailChanged located
    have outside := frontChanged.append (DeepSpentHistory.spent (owner := owner) tailChanged)
    have remainsConsumed : spend phaseNow owner freshOwner = .consumed := by simp [spend, consumed]
    have nextAbandoned := ihAbandoned _ _ capturedChanged (.closing outside) remainsConsumed
    have nextWaiting := ihWaiting _ .nil outside (.same _) remainsConsumed
    have modes := (frontChanged.append (DeepSpentHistory.live (owner := owner) (resumeDemand := resumeDemand) capturedChanged tailChanged)).return_mode .ordinary
    have nextWaiting := nextWaiting.output_mode modes
    exact (CodeChecked.dispose (resumeDemand := resumeDemand) (front := nextFront.context) (captured := nextCaptured.context) (tail := nextTail.context)
      (located := nextLocated) (known := known) (permission := permission) (available := available)
      (unprotected := capturedChanged.held ▸ unprotected) nextAbandoned nextWaiting).reindex_context same.symm
  · intros
    rename_i first second left right ihFirst ihSecond nextScope nextHints next changed consumed
    exact .choice (ihFirst next changed consumed) (ihSecond next changed consumed)
  · intros
    rename_i body callback inside closing ihBody ihCallback nextScope nextHints next changed consumed
    exact .cleanup (ihBody (.cleanup _ _ next) (.cleanup _ changed) consumed)
      (ihCallback (.normal next) (.normal changed) consumed)
  · intros
    rename_i body inside ih nextScope nextHints next changed consumed
    exact .resource (fun identity fresh => ih identity fresh (.cell next) (.cell changed) consumed)
  · intros
    rename_i first second left right ihFirst ihSecond nextScope nextHints next changed consumed
    exact .sequence (ihFirst (.plain _ next) (.plain _ changed) consumed) (ihSecond next changed consumed)
  · intros
    rename_i body supported inside ih nextScope nextHints next changed consumed
    exact .handler (by simpa only [← changed.visible_resources] using supported) (fun activation fresh => ih activation fresh (.handler activation _ next) (.handler _ changed) consumed)
  · intros
    rename_i nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .nil
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .plain (ihCode _ (DeepSpentHistory.append (by first | exact .same _ | assumption) outsideChanged) consumed)
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .skipped (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .handler (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .cell (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .cleanup (ihCode _ ((DeepSpentHistory.append (by first | exact .same _ | assumption) outsideChanged).callback _) consumed)
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .normal (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .unwinding (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .closing (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .retiring (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .live (ihCode _ _ (by first | exact .same _ | assumption) (DeepSpentHistory.append (by first | exact .same _ | assumption) outsideChanged) consumed)
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i code tail body waiting ihCode ihTail nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .opening (ihCode _ _ (by first | exact .same _ | assumption) (.retiring (DeepSpentHistory.append (by first | exact .same _ | assumption) outsideChanged)) consumed)
          (ihTail _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
  · intros
    rename_i tail waiting ih nextScope nextOutside nextHints nextExternal next nextOutside changed outsideChanged consumed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact .spent (ihHistory history))
      | exact .spent (ih _ nextOutside (by first | exact .same _ | assumption) outsideChanged consumed)
theorem PendingChecked.deep_outside_history
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints externalScope} {outside : Context external}
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted)
    (changed : DeepSpentHistory freshOwner outside next) (consumed : phases freshOwner = .consumed) :
    PendingChecked ambient outward (admitted.deep_outside_history changed consumed) := by
  induction context generalizing externalScope nextScope before after with
  | nil => cases checked; exact .nil
  | plain rows rest ih => cases checked with
    | plain code tail => exact .plain (code.deep_history (changed.prefix rest) consumed) (ih tail changed)
    | skipped tail => exact .skipped (ih tail changed)
  | handler activation rows rest ih => cases checked with
    | handler tail => exact .handler (ih tail changed)
  | cell rest ih => cases checked with
    | cell tail => exact .cell (ih tail changed)
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback tail => exact .cleanup (callback.deep_history ((changed.prefix rest).callback _) consumed) (ih tail changed)
  | normal rest ih => cases checked with
    | normal tail => exact .normal (ih tail changed)
  | unwinding rest ih => cases checked with
    | unwinding tail => exact .unwinding (ih tail changed)
  | closing rest ih => cases checked with
    | closing tail => exact .closing (ih tail changed)
  | retiring owner rest ih => cases checked with
    | retiring tail => exact .retiring (ih tail changed)
  | live saved rest ihSaved ihRest => cases checked with
    | live captured tail => exact .live (ihSaved captured (changed.prefix rest)) (ihRest tail changed)
    | opening captured tail => exact .opening (ihSaved captured (.retiring (changed.prefix rest))) (ihRest tail changed)
  | spent rest ih => cases checked with
    | spent tail => exact .spent (ih tail changed)

theorem PendingChecked.deep_history
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    {outsideHints : ReturnHints outsideScope} {nextOutsideHints : ReturnHints nextOutsideScope}
    {outside : Context outsideHints} {nextOutside : Context nextOutsideHints}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations first outside before after}
    (checked : PendingChecked ambient outward admitted)
    (related : DeepSpentHistory freshOwner first second)
    (outsideHistory : DeepSpentHistory freshOwner outside nextOutside)
    (consumed : phases freshOwner = .consumed) :
    PendingChecked ambient outward (admitted.deep_history related outsideHistory consumed) := by
  induction related generalizing outsideScope nextOutsideScope before after with
  | same context => exact checked.deep_outside_history outsideHistory consumed
  | add related ih => exact .spent (ih checked outsideHistory)
  | plain rows related ih => cases checked with
    | plain code tail => exact .plain (code.deep_history (related.append outsideHistory) consumed) (ih tail outsideHistory)
    | skipped tail => exact .skipped (ih tail outsideHistory)
  | handler rows related ih => cases checked with | handler tail => exact .handler (ih tail outsideHistory)
  | cell related ih => cases checked with | cell tail => exact .cell (ih tail outsideHistory)
  | cleanup rows related ih => cases checked with
    | cleanup callback tail => exact .cleanup (callback.deep_history ((related.append outsideHistory).callback _) consumed) (ih tail outsideHistory)
  | normal related ih => cases checked with | normal tail => exact .normal (ih tail outsideHistory)
  | unwinding related ih => cases checked with | unwinding tail => exact .unwinding (ih tail outsideHistory)
  | closing related ih => cases checked with | closing tail => exact .closing (ih tail outsideHistory)
  | retiring related ih => cases checked with | retiring tail => exact .retiring (ih tail outsideHistory)
  | live saved related ihSaved ih => cases checked with
    | live captured tail => exact .live (ihSaved captured (related.append outsideHistory)) (ih tail outsideHistory)
    | opening captured tail => exact .opening (ihSaved captured (.retiring (related.append outsideHistory))) (ih tail outsideHistory)
  | spent related ih => cases checked with | spent tail => exact .spent (ih tail outsideHistory)

/-- Closed substitution, including latent higher-order bodies, retains the
same resource certificate as the established source substitution theorem. -/
theorem admitted_substitution
    (admitted : SourceAdmission.Admitted operations policy contracts ports owners (environment.extend name input)
      (environmentRows.extend name inputRows) world installations allowed outward runtimeScope actions phases budget
      tables families context stack code result demand requirements checking resultRows rows)
    (checked : CodeChecked ambient outward admitted.certificate)
    (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input)
    (replacementChecked : Auth operations policy ports owners environmentRows replacement inputRows .pure)
    (closed : ClosedValue value) :
    CodeChecked ambient outward (admitted.substitution replacement replacementChecked closed).certificate := checked

/-- Recompose the checked retained source at its exact decorated boundary. -/
theorem PendingChecked.append {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {external : ReturnHints externalScope} {head : Context first} {tail : Context second} {outside : Context external}
    {inside : SourceAdmission.Pending outward actions budget phases world installations head (tail.append outside) before middle}
    {remaining : SourceAdmission.Pending outward actions budget phases world installations tail outside middle after}
    (firstChecked : PendingChecked ambient outward inside) (lastChecked : PendingChecked ambient outward remaining) :
    PendingChecked ambient outward (inside.append remaining) := by
  induction head generalizing before middle after with
  | nil => cases firstChecked; exact lastChecked
  | plain rows rest ih => cases firstChecked with
    | plain code next => exact .plain (code.reindex_context (rest.append_assoc_pack tail outside).symm) (ih next lastChecked)
    | skipped next => exact .skipped (ih next lastChecked)
  | handler activation rows rest ih => cases firstChecked with
    | handler next => exact .handler (ih next lastChecked)
  | cell rest ih => cases firstChecked with
    | cell next => exact .cell (ih next lastChecked)
  | cleanup latent rows rest ih => cases firstChecked with
    | cleanup callback next =>
        exact .cleanup
          (callback.reindex_context (congrArg (fun p : Packed => (p.context.callback before).pack)
          (rest.append_assoc_pack tail outside).symm)) (ih next lastChecked)
  | normal rest ih => cases firstChecked with
    | normal next => exact .normal (ih next lastChecked)
  | unwinding rest ih => cases firstChecked with
    | unwinding next => exact .unwinding (ih next lastChecked)
  | closing rest ih => cases firstChecked with
    | closing next => exact .closing (ih next lastChecked)
  | retiring owner rest ih => cases firstChecked with
    | retiring next => exact .retiring (ih next lastChecked)
  | live saved rest ihSaved ihRest => cases firstChecked with
    | live captured next =>
        exact .live
          (captured.reindex_outside (rest.append_assoc_pack tail outside).symm) (ihRest next lastChecked)
    | opening captured next =>
        exact .opening
          (captured.reindex_outside (congrArg (fun p : Packed => (Context.retiring _ p.context).pack)
          (rest.append_assoc_pack tail outside).symm)) (ihRest next lastChecked)
  | spent rest ih => cases firstChecked with
    | spent next => exact .spent (ih next lastChecked)

theorem PendingChecked.split
    {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {external : ReturnHints externalScope} {head : Context first} {tail : Context second} {outside : Context external}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations (head.append tail) outside before after}
    (checked : PendingChecked ambient outward admitted) :
    ∃ middle : UseMode,
      ∃ inside : SourceAdmission.Pending outward actions budget phases world installations head (tail.append outside) before middle,
      ∃ remaining : SourceAdmission.Pending outward actions budget phases world installations tail outside middle after,
        PendingChecked ambient outward inside ∧ PendingChecked ambient outward remaining := by
  induction head generalizing before after with
  | nil => exact ⟨before, .nil, _, .nil, checked⟩
  | plain rows rest ih => cases checked with
    | plain code next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .plain (code.reindex_context (rest.append_assoc_pack tail outside)) inside, remaining⟩
    | skipped next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .skipped inside, remaining⟩
  | handler activation rows rest ih => cases checked with
    | handler next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .handler inside, remaining⟩
  | cell rest ih => cases checked with
    | cell next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .cell inside, remaining⟩
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .cleanup
        (callback.reindex_context (congrArg (fun p : Packed => (p.context.callback before).pack)
          (rest.append_assoc_pack tail outside))) inside, remaining⟩
  | normal rest ih => cases checked with
    | normal next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .normal inside, remaining⟩
  | unwinding rest ih => cases checked with
    | unwinding next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .unwinding inside, remaining⟩
  | closing rest ih => cases checked with
    | closing next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .closing inside, remaining⟩
  | retiring owner rest ih => cases checked with
    | retiring next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .retiring inside, remaining⟩
  | live saved rest ihSaved ihRest => cases checked with
    | live captured next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ihRest next
      exact ⟨middle, _, _, .live (captured.reindex_outside (rest.append_assoc_pack tail outside)) inside, remaining⟩
    | opening captured next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ihRest next
      exact ⟨middle, _, _, .opening
        (captured.reindex_outside (congrArg (fun p : Packed => (Context.retiring _ p.context).pack)
          (rest.append_assoc_pack tail outside))) inside, remaining⟩
  | spent rest ih => cases checked with
    | spent next =>
      obtain ⟨middle, _, _, inside, remaining⟩ := ih next
      exact ⟨middle, _, _, .spent inside, remaining⟩

/-- A real handler cut selects the same checked captured and tail source. -/
theorem PendingChecked.at_cut
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations whole .nil .ordinary finalMode}
    (checked : PendingChecked ambient outward admitted)
    (cut : Cut effect operation whole captured tail contract modes) :
    ∃ middle : UseMode,
      ∃ inside : SourceAdmission.Pending outward actions budget phases world installations captured tail .ordinary middle,
      ∃ remaining : SourceAdmission.Pending outward actions budget phases world installations tail .nil middle finalMode,
        PendingChecked ambient outward inside ∧ PendingChecked ambient outward remaining := by
  obtain ⟨middle, _, _, inside, remaining⟩ := (checked.reindex_context cut.decomposition).split
  exact ⟨middle, _, _, inside.reindex_outside tail.append_nil_pack, remaining⟩

/-- A disposing request retains its resource-checked callbacks at the same cut. -/
theorem CodeChecked.callbacks_at_cut
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole}
    (checked : CodeChecked ambient outward admitted)
    (cut : Cut effect operation whole captured tail contract modes)
    (disposing : contract.dispose = true) :
    PendingChecked ambient outward (admitted.callbacks_at_cut cut disposing) := by
  cases checked with
  | builtin =>
    rename_i found
    have incompatible := found.symm.trans cut
    cases incompatible
  | request cleanup waiting clauses =>
    rename_i actualCut cleanupBudget
    obtain ⟨sameCapture, sameTail, sameContract, sameModes⟩ := actualCut.unique cut
    cases sameContract
    exact ((cleanup disposing).reindex_context sameCapture).reindex_outside
      (congrArg (fun packed : Packed => (Context.closing packed.context).pack) sameTail)

/-- Selected clause admission retains the same resource proof and declared
rights for the allocated owner, using existing cut and row uniqueness. -/
theorem CodeChecked.capture_body_with_rights
    {wholeHints : ReturnHints wholeScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context capturedHints} {tail : Context tailHints}
    {family : Nat → Dependencies} {bodies : ∀ owner, Signature (family owner)}
    {bodyRows : ∀ owner, Rows (bodies owner)}
    {declarations : ClauseSignatures declarationFamilies} {declarationRows : ClauseRows declarations}
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole}
    (checked : CodeChecked ambient outward admitted)
    (cut : Cut effect operation whole captured tail contract modes)
    (selected : CapturedClauseRows effect operation capturedScope.held captured bodyRows)
    (terminal : TerminalHandler effect activation declarationRows captured)
    (requiredRights : SourceAdmission.rightsAt operation declarations = some rights)
    (fresh : actions owner = none) (absent : owner ∉ whole.ticketNames)
    (resumeDemand : List Nat) :
    CodeChecked ambient outward
      (admitted.capture_body_with_rights cut selected terminal requiredRights fresh absent resumeDemand) := by
  cases checked with
  | builtin =>
    rename_i found
    have incompatible := found.symm.trans cut
    cases incompatible
  | request cleanup waiting clauses =>
    rename_i actualFamily actualBodies actualBodyRows actualDeclarations actualDeclarationRows ownerBound callbacks actualTerminal actualRights actualSelected guarded retained body actualCut cleanupBudget
    obtain ⟨sameCapture, sameTail, _, _⟩ := actualCut.unique cut
    cases sameCapture
    cases sameTail
    obtain ⟨sameFamily, sameBodies, sameRows⟩ := actualSelected.unique selected
    cases sameFamily
    cases sameBodies
    cases sameRows
    obtain ⟨_, _, sameDeclarations, sameSignatures, sameDeclarationRows⟩ := actualTerminal.unique terminal
    cases sameDeclarations
    cases sameSignatures
    cases sameDeclarationRows
    have rightsSame := Option.some.inj (actualRights.symm.trans requiredRights)
    cases rightsSame
    exact clauses owner resumeDemand fresh absent

/-- Resume inversion retains the resource evidence for the actual restored
source, with no equality to a separately inferred contract demand. -/
theorem CodeChecked.resume_parts
    {hints : ReturnHints scope} {context : Context hints}
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .resume⟩)) context}
    (checked : CodeChecked ambient outward admitted) :
    ∃ front captured tail : Packed, ∃ resumeDemand : List Nat, ∃ rights : Syntax.OneShotRights,
      context.pack = (front.context.append
        (.live (owner := owner) (resumeDemand := resumeDemand) captured.context tail.context)).pack ∧
      SourceDependencyCapture.OwnerCut owner scope ⟨front.scope, captured.scope, tail.scope⟩ ∧
      actions owner = some rights ∧ rights.resume = true ∧ phases owner = .available ∧
      ResumeShape (captured.hints.returnMode .ordinary) front.context = true ∧
      ∃ restored : SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations
        (captured.context.append (front.context.append (.spent (owner := owner) tail.context)))
        .nil .ordinary (hints.returnMode .ordinary), PendingChecked ambient outward restored := by
  cases checked with
  | resume next =>
    exact ⟨⟨_, _, _⟩, ⟨_, _, _⟩, ⟨_, _, _⟩, _, _, rfl,
      by assumption, by assumption, by assumption, by assumption, by assumption, _, next⟩

/-- Discard inversion retains both resource-checked source premises at their
actual closing and ordinary receivers. -/
theorem CodeChecked.dispose_parts
    {hints : ReturnHints scope} {context : Context hints}
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .dispose⟩)) context}
    (checked : CodeChecked ambient outward admitted) :
    ∃ front captured tail : Packed, ∃ resumeDemand : List Nat, ∃ rights : Syntax.OneShotRights,
      context.pack = (front.context.append
        (.live (owner := owner) (resumeDemand := resumeDemand) captured.context tail.context)).pack ∧
      SourceDependencyCapture.OwnerCut owner scope ⟨front.scope, captured.scope, tail.scope⟩ ∧
      actions owner = some rights ∧ rights.dispose = true ∧ phases owner = .available ∧
      captured.scope.held = false ∧
      ∃ abandoned : SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations captured.context
        (.closing (front.context.append (.spent (owner := owner) tail.context))) .unwind .unwind,
      ∃ waiting : SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations
        (front.context.append (.spent (owner := owner) tail.context)) .nil .ordinary
        (hints.returnMode .ordinary), PendingChecked ambient outward abandoned ∧ PendingChecked ambient outward waiting := by
  cases checked with
  | dispose cleanup caller =>
    exact ⟨⟨_, _, _⟩, ⟨_, _, _⟩, ⟨_, _, _⟩, _, _, rfl,
      by assumption, by assumption, by assumption, by assumption, by assumption, _, _, cleanup, caller⟩

/-- Enlarging the explicit ambient allowance preserves structural admission. -/
theorem CodeChecked.ambient_mono
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) (larger : ambient ⊆ nextAmbient) :
    CodeChecked nextAmbient outward admitted := by
  apply CodeChecked.rec
    (motive_1 := fun {_ _ _ _ _ _ _ _ _ _ _} admitted _ => CodeChecked nextAmbient outward admitted)
    (motive_2 := fun {_ _ _ _ _ _ _ _ _ _ _ _ _} admitted _ => PendingChecked nextAmbient outward admitted)
    (t := checked)
  · intros; exact .pure
  · intros; exact .builtin (found := by assumption)
  · intros
    rename_i ihCleanup ihWaiting ihClauses
    exact .request (cut := by assumption) (guarded := by assumption)
      (ownerBound := by assumption) (cleanupBudget := by assumption)
      (selected := by assumption) (terminal := by assumption) (requiredRights := by assumption)
      ihCleanup ihWaiting ihClauses
  · intros
    rename_i ih
    exact .resume (located := by assumption) (known := by assumption) (available := by assumption)
      (permission := by assumption) (resumeShape := by assumption) ih
  · intros
    rename_i ihCleanup ihCaller
    exact .dispose (located := by assumption) (known := by assumption) (available := by assumption)
      (permission := by assumption) (unprotected := by assumption) ihCleanup ihCaller
  · intros; exact .choice (by assumption) (by assumption)
  · intros; exact .cleanup (by assumption) (by assumption)
  · intros; exact .resource (by assumption)
  · intros; exact .sequence (by assumption) (by assumption)
  · intros
    rename_i body supported inside ih
    apply CodeChecked.handler ?_ ih
    intro resource member
    rcases List.mem_append.mp (supported member) with visible | old
    · exact List.mem_append_left _ visible
    · exact List.mem_append_right _ (larger old)
  · intros; exact .nil
  · intros; exact .plain (by assumption) (by assumption)
  · intros; exact .skipped (by assumption)
  · intros; exact .handler (by assumption)
  · intros; exact .cell (by assumption)
  · intros; exact .cleanup (by assumption) (by assumption)
  · intros; exact .normal (by assumption)
  · intros; exact .unwinding (by assumption)
  · intros; exact .closing (by assumption)
  · intros; exact .retiring (by assumption)
  · intros; exact .live (by assumption) (by assumption)
  · intros; exact .opening (by assumption) (by assumption)
  · intros; exact .spent (by assumption)

theorem PendingChecked.ambient_mono
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) (larger : ambient ⊆ nextAmbient) :
    PendingChecked nextAmbient outward admitted := by
  induction context generalizing outsideScope before after with
  | nil => cases checked; exact .nil
  | plain rows rest ih => cases checked with
    | plain code tail => exact .plain (code.ambient_mono larger) (ih tail)
    | skipped tail => exact .skipped (ih tail)
  | handler activation rows rest ih => cases checked with
    | handler tail => exact .handler (ih tail)
  | cell rest ih => cases checked with
    | cell tail => exact .cell (ih tail)
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback tail => exact .cleanup (callback.ambient_mono larger) (ih tail)
  | normal rest ih => cases checked with
    | normal tail => exact .normal (ih tail)
  | unwinding rest ih => cases checked with
    | unwinding tail => exact .unwinding (ih tail)
  | closing rest ih => cases checked with
    | closing tail => exact .closing (ih tail)
  | retiring owner rest ih => cases checked with
    | retiring tail => exact .retiring (ih tail)
  | live saved rest ihSaved ihRest => cases checked with
    | live captured tail => exact .live (ihSaved captured) (ihRest tail)
    | opening captured tail => exact .opening (ihSaved captured) (ihRest tail)
  | spent rest ih => cases checked with
    | spent tail => exact .spent (ih tail)

/-- Focus retains both the child certificate and the waiting suffix. -/
theorem CodeChecked.sequence_parts
    {admitted : SourceAdmission.Code outward actions budget phases world installations (.sequence firstRows secondRows) context}
    (checked : CodeChecked ambient outward admitted) :
    ∃ first : SourceAdmission.Code outward actions budget phases world installations firstRows (.plain secondRows context),
    ∃ second : SourceAdmission.Code outward actions budget phases world installations secondRows context,
      CodeChecked ambient outward first ∧ CodeChecked ambient outward second := by
  cases checked with | sequence first second => exact ⟨_, _, first, second⟩

/-- Registration retains its body and lexical callback without rebuilding
resource evidence from a coarser effect row. -/
theorem CodeChecked.cleanup_parts
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (.cleanup (needs := needs) latent callbackRows bodyRows) context}
    (checked : CodeChecked ambient outward admitted) :
    ∃ body : SourceAdmission.Code outward actions budget phases world installations bodyRows
      (.cleanup (needs := needs) latent callbackRows context),
    ∃ callback : SourceAdmission.Code outward actions budget phases world installations callbackRows (.normal context),
      CodeChecked ambient outward body ∧ CodeChecked ambient outward callback := by
  cases checked with | cleanup inside closing => exact ⟨_, _, inside, closing⟩

/-- Installation selects the already checked body at the actual fresh identity. -/
theorem CodeChecked.handler_body
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (.handler (effect := effect) (table := table) (required := required) declarations bodyRows) context}
    (checked : CodeChecked ambient outward admitted) (fresh : activation ∉ installations) :
    ∃ body : SourceAdmission.Code outward actions budget phases world (activation :: installations) bodyRows
      (.handler (effect := effect) (table := table) activation declarations context),
      CodeChecked ambient outward body := by
  cases checked with | handler supported inside => exact ⟨_, inside activation fresh⟩

/-- Resource allocation selects the already checked body for the fresh cell. -/
theorem CodeChecked.resource_body
    {admitted : SourceAdmission.Code outward actions budget phases world installations (.resource bodyRows) context}
    (checked : CodeChecked ambient outward admitted) (fresh : identity ∉ world) :
    ∃ body : SourceAdmission.Code outward actions budget phases (world ++ [identity]) installations
      (bodyRows identity) (.cell (identity := identity) context), CodeChecked ambient outward body := by
  cases checked with | resource inside => exact ⟨_, inside identity fresh⟩

/-- Discard builds the same closing traversal from its two checked premises. -/
theorem CodeChecked.discard_pending_at
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .dispose⟩))
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail))}
    (checked : CodeChecked ambient outward admitted)
    (located : SourceDependencyCapture.OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩) :
    PendingChecked ambient outward (admitted.discard_pending_at located).2 := by
  obtain ⟨⟨_, _, actualFront⟩, ⟨_, _, actualCaptured⟩, ⟨_, _, actualTail⟩,
    actualDemand, rights, same, actualLocated, known, permission, available, unprotected,
    abandoned, waiting, cleanup, caller⟩ := checked.dispose_parts
  obtain ⟨frontSame, capturedSame, tailSame, demandSame⟩ :=
    owner_cut_context_parts front captured tail actualFront actualCaptured actualTail located actualLocated same
  cases frontSame
  cases capturedSame
  cases tailSame
  cases demandSame
  have closingWaiting := PendingChecked.closing (mode := .unwind) caller
  exact (cleanup.reindex_outside (Context.closing (front.append (.spent (owner := owner) tail))).append_nil_pack.symm).append closingWaiting

theorem CodeChecked.world_weaken
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) (larger : world ⊆ nextWorld) :
    CodeChecked ambient outward (admitted.world_weaken larger) :=
  checked.mono _ _ larger (List.Subset.refl _)

theorem CodeChecked.installations_mono
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) (larger : installations ⊆ nextInstallations) :
    CodeChecked ambient outward (admitted.installations_mono larger) :=
  checked.mono _ _ (List.Subset.refl _) larger

theorem PendingChecked.world_weaken
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) (larger : world ⊆ nextWorld) :
    PendingChecked ambient outward (admitted.world_weaken larger) :=
  checked.mono larger (List.Subset.refl _)

theorem PendingChecked.installations_mono
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) (larger : installations ⊆ nextInstallations) :
    PendingChecked ambient outward (admitted.installations_mono larger) :=
  checked.mono (List.Subset.refl _) larger

theorem CodeChecked.history
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : SpentTransport.SpentHistory freshOwner context next)
    (consumed : phases freshOwner = .consumed) :
    CodeChecked ambient outward (admitted.history changed consumed) :=
  checked.deep_history (.of_shallow changed) consumed

theorem PendingChecked.outside_history
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints externalScope} {outside : Context external}
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted)
    (changed : SpentTransport.SpentHistory freshOwner outside next)
    (consumed : phases freshOwner = .consumed) :
    PendingChecked ambient outward (admitted.outside_history changed consumed) :=
  checked.deep_outside_history (.of_shallow changed) consumed

theorem CodeChecked.pure_history
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : PureTransport.PureHistory context next) :
    CodeChecked ambient outward (admitted.pure_history changed) :=
  checked.deep_pure_history (.of_shallow changed)

theorem PendingChecked.outside_pure_history
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints externalScope} {outside : Context external}
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted)
    (changed : PureTransport.PureHistory outside next) :
    PendingChecked ambient outward (admitted.outside_pure_history changed) :=
  checked.outside_deep_pure_history (.of_shallow changed)

theorem CodeChecked.plain_pure
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) : CodeChecked ambient outward admitted.plain_pure :=
  checked.pure_history (.add (.same _))

