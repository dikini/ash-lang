  have distinct : owner ∉ ownedTickets tail ∧ (ownedTickets tail).Nodup := List.nodup_cons.mp unique
  refine ⟨nextDemand, nextRequirements, nextScope, _, tailAnnotated, nextRoot, tailRow, rfl, rfl, rfl,
    SourcePlannedSources.Values.change_context (SourcePlannedSources.Values.summary current closed.1) closed.1 allowed runtimeScope,
    Certified.pure (evidence := declarationPolicy), rest, tailAnnotation,
    .sequence .original tailAnnotation, tailPath, disposal_subtree_path tailPath,
    .second .here, disposal_subtree_path (.second .here), nextCheck, within,
