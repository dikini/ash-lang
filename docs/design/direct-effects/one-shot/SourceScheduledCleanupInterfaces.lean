/-- The same ready-site operand is admitted as a value without executable
owner demand, retaining the exact higher-order input metadata. -/
theorem ReadyResumeSite.operand_summary
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyResumeSite site) :
    ∃ summary : SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) []
        view.operand view.contract.input,
      Auth operations policy ports owners emptyRows summary (owners view.owner view.contract view.known).1 .pure :=
  site.current.previous.authenticated.resume_operand_summary view.expression view.resolved view.known view.closed

