/-- A found resume entry agrees with this exact saved requirement index.
This imposes no record-totality condition and compares no source proofs. -/
def ResumeBodyAgreement (resumes : Store) (owner : Nat) (demand : List Nat)
    (requirements : Requirements demand) : Prop :=
  ∀ body, RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some body →
    body = ⟨demand, requirements⟩

/-- Once the indexed demands agree, the existing dependent template equality
identifies the actual requirement body. -/
theorem ResumeBodyAgreement.requirements_eq
    (agreed : ResumeBodyAgreement resumes owner demand saved)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨demand, recorded⟩) :
    recorded = saved :=
  eq_of_heq (Sigma.mk.inj (agreed _ found)).2

/-- Capture inserts exactly the requirement body of its chosen saved source. -/
theorem ResumeBodyAgreement.capture (saved : Requirements demand) (resumes : Store) :
    ResumeBodyAgreement ((⟨owner, .resume⟩, ⟨demand, saved⟩) :: resumes) owner demand saved := by
  intro body found
  exact (Option.some.inj (by simpa only [RecursiveRequirements.lookup, if_true] using found)).symm

/-- Existing lookup transport is sufficient to retain this local agreement. -/
theorem ResumeBodyAgreement.lookup_congr
    (agreed : ResumeBodyAgreement resumes owner demand saved)
    (same : RecursiveRequirements.lookup ⟨owner, .resume⟩ next =
      RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes) :
    ResumeBodyAgreement next owner demand saved := by
  intro body found
  exact agreed body (same.symm.trans found)

/-- Removing another owner's records preserves the same saved requirement body. -/
theorem ResumeBodyAgreement.remove_other
    (agreed : ResumeBodyAgreement resumes owner demand saved) (different : owner ≠ removed) :
    ResumeBodyAgreement (RecursiveTransport.removeOwner removed resumes) owner demand saved :=
  agreed.lookup_congr (RecursiveTransport.lookup_remove_other different)

/-- A fresh owner's record does not change any surviving owner's agreement. -/
theorem ResumeBodyAgreement.insert_other
    (agreed : ResumeBodyAgreement resumes owner demand saved) (different : owner ≠ added) :
    ResumeBodyAgreement ((⟨added, mode⟩, body) :: resumes) owner demand saved :=
  agreed.lookup_congr (RecursiveCapture.lookup_insert_other different)

/-- The actual saved source's row witness authenticates the selected stored
source once lookup agreement has identified their requirement indices. -/
theorem CleanupRows.Contextual.PendingRows.selected_recorded_resume
    {contract : Contract} {savedRequirements recordedRequirements : Requirements contract.resumeDemand}
    {inputRows : ModeRowsValue (.value contract.input)} {boundaryRows : ModeRowsValue boundary}
    {hints : ReturnHints selected.captured} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world captured
      (.value contract.input) boundary contract.resumeDemand savedRequirements selected.captured}
    (coherent : PendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows source inputRows boundaryRows context)
    (agreed : ResumeBodyAgreement resumes owner contract.resumeDemand savedRequirements)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world root key body)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes =
      some ⟨contract.resumeDemand, recordedRequirements⟩)
    (bound : Bound annotations receiving)
    (cut : OwnerCut owner receiving selected)
    (located : SourceTemplates.CapturedIn owner captured root)
    (unique : (ownedTickets root).Nodup)
    (known : contracts owner = some contract)
    (returns : boundary = .value contract.answer ∨ boundary = .unwind) :
    PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      (selected_planned_resume_source records found bound cut located unique known source.return_mode returns)
      inputRows boundaryRows context := by
  have same := agreed.requirements_eq found
  subst recordedRequirements
  exact coherent

/-- The existing capture allocator returns agreement for the same saved source
whose requirement body it records. No source witness is chosen independently. -/
theorem capture_planned_resume_records_agreement {contract : SourcePlannedTyping.Contract}
    {requirements : Requirements contract.resumeDemand}
    (cut : HandlerCut requested whole captured tail handler)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world captured
      (.value contract.input) boundary contract.resumeDemand requirements capturedScope)
    (returns : boundary = .value contract.answer ∨ boundary = .unwind)
    (known : nextContracts owner = some contract)
    (scopeSame : receiving = capturedScope.append tailScope)
    (bound : Bound annotations receiving) (fresh : annotations owner = none)
    (records : ∀ key body, (key, body) ∈ (entries : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world whole key body)
    (extension : contracts.Extends nextContracts) (permissions : Syntax.UsageExtension actions nextActions) :
    let nextAnnotations := fun other => if other = owner then some capturedScope else annotations other
    Bound nextAnnotations (.live owner capturedScope tailScope) ∧
    (∀ key body, (key, body) ∈ ((⟨owner, .resume⟩, ⟨contract.resumeDemand, requirements⟩) :: entries) →
      PlannedResumeAnnotated operations policy nextContracts tables families required outward nextActions nextAnnotations world
        (.live owner input answer captured caller tail) key body) ∧
    ResumeBodyAgreement ((⟨owner, .resume⟩, ⟨contract.resumeDemand, requirements⟩) :: entries)
      owner contract.resumeDemand requirements := by
  obtain ⟨nextBound, nextRecords⟩ := capture_planned_resume_records
    (input := input) (answer := answer) (caller := caller)
    cut source returns known scopeSame bound fresh records extension permissions
  exact ⟨nextBound, nextRecords, ResumeBodyAgreement.capture requirements entries⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
