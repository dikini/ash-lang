/-- Append an outside context without changing a frame's authenticated source
or its intermediate value metadata. -/
theorem FrameRows.append_context
    {frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world
      entry input output demand requirements layer decorate incoming outgoing}
    {rest : ReturnHints restScope} {tail : Context rest}
    {hints : ReturnHints (layer restScope)} {decorated : Context hints}
    (rows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    {outsideHints : ReturnHints outsideScope} (outside : Context outsideHints) :
    ∃ nextHints : ReturnHints (layer (restScope.append outsideScope)), ∃ next : Context nextHints,
      FrameRows operations policy contracts tables families required outward world ports owners emptyRows
        frame inputRows outputRows (tail.append outside) next ∧
      next.pack = (decorated.append outside).pack := by
  cases rows <;> refine ⟨_, _, ?_, rfl⟩
  all_goals constructor <;> assumption

theorem ModeFrameRows.append_context
    {frame : PlannedModeFrame operations policy contracts tables families required outward world
      entry input output demand requirements layer}
    {rest : ReturnHints restScope} {tail : Context rest}
    {hints : ReturnHints (layer restScope)} {decorated : Context hints}
    (rows : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    {outsideHints : ReturnHints outsideScope} (outside : Context outsideHints) :
    ∃ nextHints : ReturnHints (layer (restScope.append outsideScope)), ∃ next : Context nextHints,
      ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        frame inputRows outputRows (tail.append outside) next ∧
      next.pack = (decorated.append outside).pack := by
  cases rows with
  | ordinary authenticated =>
      obtain ⟨nextHints, next, nextRows, same⟩ := authenticated.append_context outside
      exact ⟨nextHints, next, .ordinary nextRows, same⟩
  | handler authenticated =>
      obtain ⟨nextHints, next, nextRows, same⟩ := authenticated.append_context outside
      exact ⟨nextHints, next, .handler nextRows, same⟩
  | unwinding authenticated => exact ⟨_, _, .unwinding (certified := by assumption) authenticated, rfl⟩
  | closing => exact ⟨_, _, .closing (scopeKnown := by assumption), rfl⟩
  | retiring => exact ⟨_, _, .retiring, rfl⟩
  | skipped => exact ⟨_, _, .skipped, rfl⟩
  | cell => exact ⟨_, _, .cell, rfl⟩
  | cleanup authenticated => exact ⟨_, _, .cleanup (certified := by assumption) authenticated, rfl⟩

/-- Recompose retained source derivations using one shared intermediate value
decoration. Both requirement evaluations come from the same rebuilt source. -/
theorem PendingRows.append_disposals
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {firstContext : Context firstHints} {secondContext : Context secondHints}
    {first : PlannedModeSource operations policy contracts tables families required outward actions world front input middle
      firstDemand firstRequirements firstScope}
    {second : PlannedModeSource operations policy contracts tables families required outward actions world tail middle output
      secondDemand secondRequirements secondScope}
    (firstRows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      first inputRows middleRows firstContext)
    (secondRows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      second middleRows outputRows secondContext) :
    ∃ combined : Requirements (firstDemand ++ secondDemand),
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world (front.append tail) input output
        (firstDemand ++ secondDemand) combined (firstScope.append secondScope),
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        source inputRows outputRows (firstContext.append secondContext) ∧
      (∀ store receiving phases,
        evaluate store receiving phases combined =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals combined) =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  induction firstRows generalizing output secondDemand secondRequirements secondScope tail with
  | nil => exact ⟨secondRequirements, second, secondRows,
      by intros; simp only [evaluate_empty, spendAll, merge_empty_left],
      by intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]⟩
  | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
      restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest ih =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ih secondRows
      obtain ⟨nextHints, next, nextRows, same⟩ := head.append_context secondContext
      rw [List.append_assoc]
      have rebuiltRows := PendingRows.push nextRows joinedRows
      have packaged : ∃ combined : Requirements (frameDemand ++ (restDemand ++ secondDemand)), ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
          (.push entry (restStack.append tail)) frameInput output _ combined next.pack.scope,
          PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
            source inRows outputRows next.pack.context ∧
          (∀ store receiving phases,
            evaluate store receiving phases combined =
              merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases
                (.sequence (frameRequirements.prepend (OwnerPhases.ofStack tables restStack)) restRequirements))
                (evaluate store receiving (spendAll phases (frameDemand ++ restDemand)) secondRequirements)) ∧
          (∀ store receiving phases,
            evaluate store receiving phases (annotateDisposals combined) =
              merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases
                (annotateDisposals (.sequence (frameRequirements.prepend (OwnerPhases.ofStack tables restStack)) restRequirements)))
                (evaluate store receiving (spendAll phases (frameDemand ++ restDemand)) (annotateDisposals secondRequirements))) := by
        refine ⟨_, _, rebuiltRows, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, List.append_assoc, generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
      rw [same] at packaged
      exact packaged
  | live aligned saved rest ihSaved ihRest =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ihRest secondRows
      refine ⟨_, _, .live (actionKnown := by assumption) (inputAnnotation := by assumption) (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption) (answer := by assumption) aligned saved joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | opening saved rest ihSaved ihRest =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ihRest secondRows
      rw [List.append_assoc, List.append_assoc]
      refine ⟨_, _, .opening saved joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, evaluation,
          PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
      · intro store receiving phases
        simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, generatedEvaluation,
          PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
  | spent rest ih =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ih secondRows
      refine ⟨_, _, .spent (annotation := by assumption) (callerScope := by assumption) joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | skippedSpent rest ih =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ih secondRows
      refine ⟨_, _, .skippedSpent joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

