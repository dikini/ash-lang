/-- Cell payload changes retain every common-state component on the same
physical update. Public read/write rules below authenticate their builtin replies. -/
private theorem joined_cell_reply
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
        runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩)
    (selected : CellUpdate identity old new beforeStack afterStack)
    (isValue : operand.IsValue)
    (response : ∀ allowed argument result, operations (.cell identity) operation = some (argument, result) →
      SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) allowed reply result)
    (step : RawStep ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
      runtimeScope, beforeStack⟩ ⟨reply, runtimeScope, afterStack⟩ [] []) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨reply, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    obtain ⟨nextAnnotated, nextRow, empty, nextSource, nextCertified, nextPending,
      nextAnnotation, rawPath, generatedPath, nextChecked, included, nextLocal,
      nextRetained, nextMatching, nextBound, nextResumes, nextDisposals, raw,
      transition, owners, nextUse, nextTickets, nextResources⟩ :=
      cell_reply_planned_generated current pending retained matching bound annotation checked
        state.lifetime.2.2 state.tickets state.resources selected isValue (response _) step
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
          runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨reply, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
            runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, (fun key body member => nextResumes key body (state.resumeRecords key body member)),
      (fun key body member => nextDisposals key body (state.unwindRecords key body member)),
      state.storeAnnotation, event.preserves state.lifetime, nextTickets, nextResources, ?_, state.issuedResources⟩
    · exact JoinedSource.eval nextSource nextCertified scopeTyped nextPending
        (by simpa only [owners] using nextLocal) (by simpa only [owners] using nextRetained)
        nextMatching nextBound ((cell_update_check_forest selected matching).symm.trans finite)
        nextAnnotation (by simpa only [owners] using nextChecked) (included.trans bounded)
    · simpa only [LexicalUnwind.Machine.stack, cell_update_erases selected] using state.activations

/-- Reading the selected builtin cell preserves the complete common state.
The builtin operation signature remains an explicit predecessor premise. -/
theorem JoinedState.read_cell
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)),
        runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩)
    (builtin : operations.erase.erase.ports (.cell identity) 0 = some (.reference identity, .integer))
    (selected : CellUpdate identity payload payload beforeStack afterStack) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.integer payload, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  apply joined_cell_reply state selected (by trivial) ?_
    (.readCell identity payload runtimeScope beforeStack afterStack selected)
  intro allowed argument result known
  have answer := (Prod.mk.inj (Option.some.inj (builtin.symm.trans (CoherentSourceTypes.port_lookup
    (SourceDependencyAnnotations.operation_erase (SourcePlannedSources.operation_erase known)))))).2
  cases result <;> cases answer
  exact .integer

/-- Writing changes only the selected cell payload; the common stores,
annotations, source scopes, owner phases and ledgers remain aligned. -/
theorem JoinedState.write_cell
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 1
        (.pair (.resourceRef (.activation identity)) (.integer new)), runtimeScope, beforeStack⟩,
        issued, completed⟩, actions⟩)
    (builtin : operations.erase.erase.ports (.cell identity) 1 = some (.product (.reference identity) .integer, .unit))
    (selected : CellUpdate identity old new beforeStack afterStack) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.unit, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  apply joined_cell_reply state selected (by trivial) ?_
    (.writeCell identity old new runtimeScope beforeStack afterStack selected)
  intro allowed argument result known
  have answer := (Prod.mk.inj (Option.some.inj (builtin.symm.trans (CoherentSourceTypes.port_lookup
    (SourceDependencyAnnotations.operation_erase (SourcePlannedSources.operation_erase known)))))).2
  cases result <;> cases answer
  exact .unit
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

