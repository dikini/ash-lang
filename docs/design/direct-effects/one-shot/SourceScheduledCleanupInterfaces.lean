open OwnerPhaseTransitions (spend spendAll)

/-- The checked resume record already checks its retained cleanup alternatives.
An exact stored disposal body and its protected path supply the additional
interface field; no checked successor or cleanup-success premise is required. -/
theorem protected_interface_from_record
    (interface : ClauseRowAdmission.Interface owner contract disposes entries tail before requestRow)
    (resumeFound : RecursiveRequirements.lookup ⟨owner, .resume⟩ entries = some ⟨contract.resumeDemand, resumeRequirements⟩)
    (covered : disposes = true → ∃ closingDemand, ∃ closingRequirements : Requirements closingDemand,
      RecursiveRequirements.lookup ⟨owner, .dispose⟩ entries = some ⟨closingDemand, closingRequirements⟩ ∧
      RequirementPath (closingRequirements.prepend [.ordinary (.barrier true)]) resumeRequirements []) :
    ProtectedClauseInterface owner contract disposes entries tail before requestRow := by
  refine ⟨interface, ?_⟩
  intro permitted
  obtain ⟨closingDemand, closingRequirements, closeFound, path⟩ := covered permitted
  obtain ⟨normalRow, normalAvailable⟩ := interface.available permitted
  obtain ⟨ordinary, ordinaryWaiting, ordinaryFound, closingReady, ordinarySelection, ordinaryChecked⟩ :=
    RecursiveRequirements.checked_invocation (interface.closing permitted normalRow normalAvailable)
  have sameClosing := Option.some.inj (closeFound.symm.trans ordinaryFound)
  obtain ⟨sameDemand, sameClosingBody⟩ := Sigma.mk.inj sameClosing
  cases sameDemand
  cases eq_of_heq sameClosingBody
  obtain ⟨body, waiting, actual, ready, selection, checked⟩ :=
    RecursiveRequirements.checked_invocation interface.resume
  have same := Option.some.inj (actual.symm.trans resumeFound)
  have sameBody := eq_of_heq (Sigma.mk.inj same).2
  subst body
  obtain ⟨row, closingChecked, bounded⟩ := path.checked checked
  have closingAtBoundary : Checked entries
      ([.ordinary (.barrier true)] ++ (.live owner contract.held :: tail))
      (spend before owner) ordinary row := by
    simpa only [List.nil_append, spendAll] using RecursiveRequirements.checked_prepend_iff.mp closingChecked
  exact ⟨row, .invoke ordinaryFound closingReady (.ordinary .hit) closingAtBoundary,
    bounded.trans (List.subset_append_right _ _)⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

