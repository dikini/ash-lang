/-- Two zero-demand prefixes may be removed while retaining the exact waiting
annotation and the old certificate as an alternative. -/
theorem value_marker_root_annotation
    {current marker : Requirements []} {pending : Requirements demand}
    (annotation : RowAnnotation (.sequence current (.sequence marker pending)) annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) row)
    (receivingContext : OwnerPhases.Context) :
    ∃ nextAnnotated : Requirements ([] ++ demand), ∃ nextRow,
      RowAnnotation (.sequence ((Requirements.request [] []).prepend receivingContext) pending) nextAnnotated ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row := by
  obtain ⟨tailAnnotated, tailAnnotation, tailPath⟩ := annotation.focus
    (RequirementPath.second (RequirementPath.second (.here)))
  obtain ⟨tailRow, tailChecked, within⟩ := (disposal_subtree_path tailPath).checked checked
  simp only [spendAll, List.nil_append] at tailChecked within tailPath
  let nextRoot := Requirements.sequence ((Requirements.request [] []).prepend receivingContext) tailAnnotated
  have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) tailRow := by
    change Checked entries receiving before (.sequence (.request receivingContext []) (annotateDisposals tailAnnotated)) ([] ++ tailRow)
    exact .sequence (.request (by simp [OwnerSource.exportAt, residual_empty])) tailChecked
  exact ⟨.choice nextRoot annotated (.refl _), tailRow ++ row,
    .alternatives (.sequence .original tailAnnotation) (.refl _), .choice nextCheck checked,
    List.append_subset.mpr ⟨within, List.Subset.refl _⟩⟩


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
