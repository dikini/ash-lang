namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local)
open SourceDependencyCapture (lookupDependencies modeDependencies)
open SourceContextualHints (checkRequirements)

/-- Join rich declaration typing and structural admission at the same exact
clause/mode lookup. The compiled dependency family is the one authenticated by
the source derivation, including its higher-order parameter environment. -/
theorem selected_typed_clause
    (source : SourceDependencyAnnotations.Declarations operations policy contracts world environment allowed requested answer clauses table families)
    (recipes : ClauseDeclarations outward clauses families required)
    (selected : ClauseAt operation clauses parameter binder code)
    (found : lookup operation table = some offered)
    {captured : ReturnHints capturedScope} {tail : ReturnHints tailScope}
    (available : offered.row capturedScope.held = some row)
    (supplied : checkRequirements tailScope required = true)
    (resume : code.requiredActions.resume = true → Local outward actions phases world (.invoke ⟨owner, .resume⟩)
      (.live (owner := owner) captured tail))
    (dispose : code.requiredActions.dispose = true → Local outward actions phases world (.invoke ⟨owner, .dispose⟩)
      (.live (owner := owner) captured tail)) :
    ∃ argument input resumeEffects closeEffects family,
      operations requested operation = some (argument, input) ∧
      (code.requiredActions.resume = true → resumeEffects = allowed) ∧
      (code.requiredActions.dispose = true → closeEffects = allowed) ∧
      (lookupDependencies operation families).bind (modeDependencies capturedScope.held) = some family ∧
      Local outward actions phases world (family owner) (.live (owner := owner) captured tail) ∧
      ∀ freshOwner (contract : SourceDependencyAnnotations.Contract), contracts freshOwner = none →
        contract.input = input → contract.answer = answer →
        contract.resumeEffects = resumeEffects → contract.closeEffects = closeEffects →
        contract.held = capturedScope.held → contract.closeDemand.Perm contract.resumeDemand →
        SourceDependencyAnnotations.Body operations policy (contracts.insert freshOwner contract) world allowed (.ticket binder freshOwner)
          (environment.extend parameter argument) code answer ⟨freshOwner, contract.erase, offered.dispose, row⟩ (family freshOwner) := by
  obtain ⟨argument, input, resumeEffects, closeEffects, family, signature, resuming, closing, located, body⟩ :=
    SourceDependencyCapture.selected_body source selected found available
  obtain ⟨needed, recipe, included⟩ := recipes.selected selected located
  exact ⟨argument, input, resumeEffects, closeEffects, family, signature, resuming, closing, located,
    recipe.compile (SourceContextualRequirements.check_requirements_subset included supplied) resume dispose, body⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.selected_typed_clause

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution
open SourceDeclarationPlans (Plan ModePlans ClausePlans)
open SourcePlanSignatures (Signature signature clauseSignatures)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local)
open SourcePlannedChecks (Certified CertifiedModes CertifiedClauses)
open SourcePlannedSources (Expression ValueSummary)
open RecursiveRequirements (Requirements evaluate)

/-- Stable signatures retain exactly the clause rights inspected by structural
admission. Actual source typing authenticates the replacement raw clauses. -/
theorem ClauseDeclarations.signature_congr {first : ClausePlans before families} {second : ClausePlans after families}
    (recipes : ClauseDeclarations outward before families required)
    (same : clauseSignatures first = clauseSignatures second) :
    ClauseDeclarations outward after families required := by
  induction recipes generalizing after with
  | nil => cases first; cases second; exact .nil
  | cons ordinary protectedMode rest ih =>
      cases first with
      | cons firstOrdinary firstProtected firstRest =>
          cases second with
          | cons secondOrdinary secondProtected secondRest =>
              obtain ⟨actions, _, _, tail⟩ := SourcePlanSignatures.ClauseSignatures.cons.inj same
              exact .cons (actions ▸ ordinary) (actions ▸ protectedMode) (ih tail)

/-- Use the existing recursive declaration-certification judgment with the
current lexical clause annotations. This does not select an old execution rule. -/
@[instance_reducible] def declarationPolicy : SourcePlannedChecks.DeclarationPolicy where
  accepts := fun outward required {clauses families} _ => ClauseDeclarations outward clauses families required

theorem certified_from_existing
    (checked : Certified outward world plan) :
    Certified (evidence := declarationPolicy) outward world plan :=
  (SourceDeclarationPolicyTransport.certified_all SourcePlannedChecks.contextualPolicy declarationPolicy outward
    (fun declarations => ClauseDeclarations.of_existing declarations)).1 world plan checked

theorem certified_signature (checked : Certified (evidence := declarationPolicy) outward world first)
    (same : signature first = signature second) :
    Certified (evidence := declarationPolicy) outward world second :=
  SourcePlanSignatureChecking.certified_policy_congr (evidence := declarationPolicy)
    (fun declarations same => ClauseDeclarations.signature_congr declarations same) checked same

theorem certified_clause_signatures {first : ClausePlans before families} {second : ClausePlans after families}
    (checked : CertifiedClauses (evidence := declarationPolicy) outward world first)
    (same : clauseSignatures first = clauseSignatures second) :
    CertifiedClauses (evidence := declarationPolicy) outward world second :=
  SourcePlanSignatureChecking.certified_clauses_policy_congr (evidence := declarationPolicy)
    (fun declarations same => ClauseDeclarations.signature_congr declarations same) checked same

/-- Recover the actual raw handler clauses from the rich synchronized source
proof and carry the same structural declaration certification to that witness.
No new declaration or future-handler check is assumed after substitution. -/
theorem actual_source_handler {plans : ClausePlans before families}
    (source : Expression operations policy contracts world allowed scope environment
      (.handle (Instantiation.freezeEffect effect) code arms) answer demand requirements
      (signature (.handler (effect := effect) (table := table) required plans bodyPlan)))
    (certified : Certified (evidence := declarationPolicy) outward world
      (.handler (effect := effect) (table := table) required plans bodyPlan)) :
    ∃ residual, ∃ bodyRequirements : Requirements demand, ∃ actual : ClausePlans arms families,
      Expression operations policy contracts world (effect :: residual) scope environment code answer demand bodyRequirements
        (signature bodyPlan) ∧
      SourcePlannedSources.Declarations operations policy contracts world environment residual effect answer arms table actual ∧
      clauseSignatures actual = clauseSignatures plans ∧
      ClauseDeclarations outward arms families required ∧
      CertifiedClauses (evidence := declarationPolicy) outward world actual ∧
      Certified (evidence := declarationPolicy) outward world bodyPlan := by
  obtain ⟨residual, bodyRequirements, actual, body, declarations, same, requirementsSame⟩ :=
    SourcePlannedSources.handler_body source
  cases certified with
  | handler recipes certifiedClauses certifiedBody =>
      exact ⟨residual, bodyRequirements, actual, body, declarations, same,
        ClauseDeclarations.signature_congr recipes same.symm,
        certified_clause_signatures certifiedClauses same.symm, certifiedBody⟩

/-- The actual lexical handler-entry step obtains stored declarations from
rich source typing and the existing recursive certification. The successor's
body, declaration and retained dependency checks are all derived. This theorem
covers these source facets, not the separate row/store/usage/support invariant. -/
theorem source_handler_install {hints : ReturnHints receiving}
    {plans : ClausePlans before (families handler)} {bodyPlan : Plan bodyDependencies}
    (source : Expression operations policy contracts world allowed handler.scope environment
      (.handle (Instantiation.freezeEffect handler.effectInst) code handler.clauses) answer demand requirements
      (signature (.handler (effect := handler.effectInst) (table := tables handler) (required handler) plans bodyPlan)))
    (certified : Certified (evidence := declarationPolicy) outward world
      (.handler (effect := handler.effectInst) (table := tables handler) (required handler) plans bodyPlan))
    (checked : Local outward actions phases world
      (.handler handler.effectInst (tables handler) (families handler) bodyDependencies) hints)
    (supplied : SourceContextualHints.checkRequirements receiving (required handler) = true)
    (matching : ReturnHints.Matches tables families hints stack)
    (retained : SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward actions phases world hints .nil .ordinary finalMode)
    (stored : ∀ installed ∈ SourceContextualRechecking.handlers stack,
      ClauseDeclarations outward installed.clauses (families installed) (required installed))
    (finite : SourceContextualRechecking.checkForest required stack receiving .nil = true) :
    ∃ residual, ∃ bodyRequirements : Requirements demand, ∃ actual : ClausePlans handler.clauses (families handler),
      Expression operations policy contracts world (handler.effectInst :: residual) handler.scope environment
        code answer demand bodyRequirements (signature bodyPlan) ∧
      SourcePlannedSources.Declarations operations policy contracts world environment residual handler.effectInst answer
        handler.clauses (tables handler) actual ∧
      CertifiedClauses (evidence := declarationPolicy) outward world actual ∧
      Certified (evidence := declarationPolicy) outward world bodyPlan ∧
      Local outward actions phases world bodyDependencies
        (.handler (effect := handler.effectInst) (table := tables handler) (families := families handler) hints) ∧
      ReturnHints.Matches tables families
        (.handler (effect := handler.effectInst) (table := tables handler) (families := families handler) hints)
        (.push (.handler handler) stack) ∧
      SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward actions phases world
        (.handler (effect := handler.effectInst) (table := tables handler) (families := families handler) hints)
        .nil .ordinary finalMode ∧
      (∀ installed ∈ SourceContextualRechecking.handlers (.push (.handler handler) stack),
        ClauseDeclarations outward installed.clauses (families installed) (required installed)) ∧
      SourceContextualRechecking.checkForest required (.push (.handler handler) stack)
        (.handler handler.effectInst (tables handler) (families handler) receiving) .nil = true ∧
      LexicalUnwind.UseTransition
        (.eval ⟨.handle (Instantiation.freezeEffect handler.effectInst) code handler.clauses, handler.scope, stack⟩)
        (.eval ⟨code, handler.scope, .push (.handler handler) stack⟩) [] [] := by
  obtain ⟨residual, bodyRequirements, actual, body, typedClauses, same, declarations, certifiedClauses, certifiedBody⟩ :=
    actual_source_handler source certified
  obtain ⟨matched, pending, storedNext, finiteNext⟩ :=
    declarations.install supplied matching retained stored finite
  cases checked with
  | handler checkedBody =>
      exact ⟨residual, bodyRequirements, actual, body, typedClauses, certifiedClauses, certifiedBody, checkedBody,
        matched, pending, storedNext, finiteNext, .evaluate (.enterHandler handler code stack) trivial⟩

/-- Bind preserves rich source typing, all latent declaration certification,
and the recursive lexical execution check. Substitution is the existing proof. -/
theorem bind_preserves
    {initialPlan : Plan initialDependencies} {bodyPlan : Plan bodyDependencies}
    (source : Expression operations policy contracts world allowed scope environment (.bind parameter value body)
      result demand requirements (signature (.sequence initialPlan bodyPlan)))
    (certified : Certified (evidence := declarationPolicy) outward world (.sequence initialPlan bodyPlan))
    (checked : Local outward actions phases world (.sequence initialDependencies bodyDependencies) hints)
    (closed : ClosedValue value) :
    ∃ reduced, Expression operations policy contracts world allowed scope environment (body.subst parameter value)
      result demand reduced (signature bodyPlan) ∧
      Certified (evidence := declarationPolicy) outward world bodyPlan ∧
      Local outward actions phases world bodyDependencies hints ∧
      ∀ store receiving before, evaluate store receiving before reduced = evaluate store receiving before requirements := by
  obtain ⟨reduced, next, evaluation⟩ := SourcePlannedSources.bind_expression source closed
  cases certified with
  | sequence first second => cases checked with
    | sequence initial body => exact ⟨reduced, next, second, body, evaluation⟩

/-- Beta reduction exposes the signature stored in the function type. It keeps
both declaration evidence and the recursive check for that exact body, including
when the substituted value is itself a function. -/
theorem beta_preserves
    {functionPlan : Plan functionDependencies} {argumentPlan : Plan argumentDependencies} {bodyPlan : Plan bodyDependencies}
    (source : Expression operations policy contracts world allowed scope environment (.app (.lambda parameter body) value)
      result demand requirements (signature (.sequence functionPlan (.sequence argumentPlan bodyPlan))))
    (certified : Certified (evidence := declarationPolicy) outward world (.sequence functionPlan (.sequence argumentPlan bodyPlan)))
    (checked : Local outward actions phases world (.sequence functionDependencies (.sequence argumentDependencies bodyDependencies)) hints)
    (closed : ClosedValue value) :
    ∃ reduced, Expression operations policy contracts world allowed .none environment (body.subst parameter value)
      result demand reduced (signature bodyPlan) ∧
      Certified (evidence := declarationPolicy) outward world bodyPlan ∧
      Local outward actions phases world bodyDependencies hints ∧
      ∀ store receiving before, evaluate store receiving before reduced = evaluate store receiving before requirements := by
  obtain ⟨reduced, next, evaluation⟩ := SourcePlannedSources.beta_expression source closed
  cases certified with
  | sequence function rest => cases rest with
    | sequence argument body => cases checked with
      | sequence function rest => cases rest with
        | sequence argument checkedBody => exact ⟨reduced, next, body, checkedBody, evaluation⟩

namespace CertificationExamples
local instance : SourcePlannedChecks.DeclarationPolicy := declarationPolicy
open SourceDependencyAnnotations.Examples (effectE effectF allowed policy cleanupBody cleanupDependencies
  noRequirements invokedRequirements functionCode boundProgram)
open SourcePlannedTyping.Examples (operations contracts environment cleanupSignature)
open SourceRequestFootprints (Footprint)

def cleanupPlan : Plan cleanupDependencies :=
  .sequence .pure (.cleanup (.sequence .pure .request) (.sequence .pure .request))
def invokedPlan := Plan.sequence .pure (.sequence .pure cleanupPlan)
def boundPlan := Plan.sequence .pure invokedPlan

def table : List (Nat × ProtectionContracts.ClauseContract) := [(0, ⟨false, some [], some []⟩)]
def families : SourceDependencyAnnotations.ClauseDependencies :=
  [(0, some (fun owner => .invoke ⟨owner, .resume⟩), some (fun owner => .invoke ⟨owner, .resume⟩))]
def receiving := SourceDependencyCapture.Scope.handler effectE table families (.handler effectF table families .nil)
def hints : ReturnHints receiving := .handler (.handler .nil)

theorem bound_certified : Certified (evidence := declarationPolicy) [] [] boundPlan :=
  .sequence .pure (.sequence .pure (.sequence .pure
    (.sequence .pure (.cleanup (.sequence .pure .request) (.sequence .pure .request)))))

theorem bound_checked : Local [] (fun _ => none) (OwnerPhaseTransitions.available []) []
    (.sequence .pure (.sequence .pure (.sequence .pure cleanupDependencies))) hints := by
  apply SourceScheduledAdaptationCompilation.Lexical.Recursive.compile_footprint
    (checking := signature boundPlan)
    (required := [(effectF, 0), (effectE, 0)])
  · exact .sequence .pure (.sequence .pure (.sequence .pure
      (.sequence .pure (.cleanup (.sequence .pure .request) (.sequence .pure .request)))))
  · decide

/-- The existing effectful-cleanup function passes through binding and beta
reduction with synchronized rich source typing, lexical Local, and all latent
declaration certification retained. Neither successor check is an input. -/
theorem higher_order_cleanup : ∃ first second,
    Expression operations policy contracts [] allowed .none environment (.app functionCode .unit) .unit [] first
      (signature invokedPlan) ∧
    Expression operations policy contracts [] allowed .none environment cleanupBody .unit [] second
      (signature cleanupPlan) ∧
    Certified (evidence := declarationPolicy) [] [] cleanupPlan ∧
    Local [] (fun _ => none) (OwnerPhaseTransitions.available []) [] cleanupDependencies hints ∧
    ∀ store receiving before,
      evaluate store receiving before first = evaluate store receiving before (.sequence noRequirements invokedRequirements) ∧
      evaluate store receiving before second = evaluate store receiving before first := by
  obtain ⟨first, next, declarations, checked, bindEvaluation⟩ :=
    bind_preserves (initialPlan := .pure) (bodyPlan := invokedPlan)
      SourcePlannedSources.Examples.bound_source bound_certified bound_checked
      SourceDependencyAnnotations.Examples.annotated_function_closed
  obtain ⟨second, finalSource, certified, localCheck, betaEvaluation⟩ :=
    beta_preserves (functionPlan := .pure) (argumentPlan := .pure) (bodyPlan := cleanupPlan)
      next declarations checked CallableProtection.Examples.unit_closed
  exact ⟨first, second, next, finalSource, certified, localCheck,
    fun store receiving before => ⟨bindEvaluation store receiving before, betaEvaluation store receiving before⟩⟩

def openCode : Code :=
  .cleanup (.lambda 5 (.perform (.cell (.activation 42)) 1 (.variable 17))) (.resume 9 .unit)
def openClauses : Clauses := .cons 0 1 9 openCode .nil
def clausePlan (owner : Nat) : Plan (DeclarationExamples.family owner) :=
  .sequence .pure (.cleanup (.sequence .pure .request) (.sequence .pure .invoke))
def plans : ClausePlans openClauses [(0, some DeclarationExamples.family, some DeclarationExamples.family)] :=
  .cons (.available clausePlan) (.available clausePlan) .nil

theorem open_declarations : ClauseDeclarations [] openClauses
    [(0, some DeclarationExamples.family, some DeclarationExamples.family)] [(.cell 42, 1), (.cell 42, 1)] :=
  ClauseDeclarations.cons (body := openCode) (.available DeclarationExamples.recipe) (.available DeclarationExamples.recipe) .nil

theorem clauses_certified : CertifiedClauses (evidence := declarationPolicy) [] [42] plans :=
  .cons (.available (fun _ => .sequence .pure (.cleanup (.sequence .pure .request) (.sequence .pure .invoke))))
    (.available (fun _ => .sequence .pure (.cleanup (.sequence .pure .request) (.sequence .pure .invoke)))) .nil

/-- Substitution changes the literal callback code in the handler clause. The
existing signature law transports its source certification, not code equality. -/
theorem changed_clause_certification :
    openClauses.subst 17 (.integer 0) ≠ openClauses ∧
    Certified (evidence := declarationPolicy) [] [42]
      (.handler (effect := .user 103 []) (table := DeclarationExamples.tables DeclarationExamples.handler)
        [(.cell 42, 1), (.cell 42, 1)]
        (SourcePlanSignatures.substituteClauses plans 17 (.integer 0)) .pure) := by
  constructor
  · intro same
    cases same
  · apply certified_signature
      (first := .handler (effect := .user 103 []) (table := DeclarationExamples.tables DeclarationExamples.handler)
        [(.cell 42, 1), (.cell 42, 1)] plans .pure)
    · exact .handler open_declarations clauses_certified .pure
    · simp only [signature, SourcePlanSignatures.substitution_signature (name := 17) (value := .integer 0) plans trivial]

end CertificationExamples

