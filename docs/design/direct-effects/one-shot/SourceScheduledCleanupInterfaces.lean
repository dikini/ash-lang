namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourcePlannedTyping (Operations Contracts)
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Store)

/-- The actual coherent pending source retains record agreement. Opening keeps
its ordinary authenticated saved view as well as its unwind view, with the same
physical capture and decorated context. No phase-indexed Code is stored here. -/
inductive RecordPendingRows (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance)
    (actions : Syntax.UsageTickets) (world : List Nat)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none)) (resumes : RecursiveRequirements.Store) :
    {stack : Stack} → {input output : PlannedModeValue} → {demand : List Nat} → {requirements : Requirements demand} →
    {scope : SourceDependencyCapture.Scope} →
    PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope → ModeRowsValue input → ModeRowsValue output →
    {hints : ReturnHints scope} → Context hints → Prop where
  | nil {rows : ModeRowsValue input} :
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        (.nil (input := input)) rows rows .nil
  | push
      (head : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
        frame inputRows middleRows rest decorated)
      (tail : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        source middleRows outputRows rest) :
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        (.push frame source) inputRows outputRows decorated
  | live {known : contracts owner = some contract} {actionKnown : actions owner = some rights}
      {inputAnnotation : contract.input.erase.erase.port = ScopedPorts.eraseType inputType}
      {answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType}
      {callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller}
      {held : contract.held = ProtectionContexts.protectedMode captured.erase}
      {saved : PlannedModeSource operations policy contracts tables families required outward actions world
        captured (.value contract.input) boundary contract.resumeDemand body savedScope}
      {answer : boundary = .value contract.answer ∨ boundary = .unwind}
      {source : PlannedModeSource operations policy contracts tables families required outward actions world
        stack boundary output demand requirements restScope}
      {boundaryRows : ModeRowsValue boundary}
      (answerRows : ModeRowsValue.Answer (owners owner contract known).2 boundaryRows)
      (agreement : ResumeBodyAgreement resumes owner contract.resumeDemand body)
      (inside : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        saved (.value (owners owner contract known).1) boundaryRows capturedContext)
      (tail : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        source boundaryRows outputRows rest) :
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        (.live known actionKnown inputAnnotation answerAnnotation callerScope held saved answer source)
        (.value (owners owner contract known).2) outputRows (.live (resumeDemand := contract.resumeDemand) capturedContext rest)
  | opening
      {known : contracts owner = some contract} {actionKnown : actions owner = some rights}
      {inputAnnotation : contract.input.erase.erase.port = ScopedPorts.eraseType inputType}
      {answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType}
      {callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller}
      {held : contract.held = ProtectionContexts.protectedMode captured.erase}
      {ordinarySource : PlannedModeSource operations policy contracts tables families required outward actions world
        captured (.value contract.input) boundary contract.resumeDemand ordinaryRequirements savedScope}
      {answer : boundary = .value contract.answer ∨ boundary = .unwind}
      {boundaryRows : ModeRowsValue boundary}
      {saved : PlannedModeSource operations policy contracts tables families required outward actions world
        captured .unwind .unwind savedDemand savedRequirements savedScope}
      {source : PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind output tailDemand tailRequirements restScope}
      (answerRows : ModeRowsValue.Answer (owners owner contract known).2 boundaryRows)
      (agreement : ResumeBodyAgreement resumes owner contract.resumeDemand ordinaryRequirements)
      (ordinary : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        ordinarySource (.value (owners owner contract known).1) boundaryRows capturedContext)
      (inside : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        saved .unwind .unwind capturedContext)
      (tail : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        source .unwind outputRows rest) :
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        (.opening (owner := owner) (input := inputType) (answer := answerType) (caller := caller) saved source)
        .unwind outputRows (.live (resumeDemand := contract.resumeDemand) capturedContext rest)
  | spent {known : contracts owner = some contract}
      {annotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType}
      {callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller}
      {source : PlannedModeSource operations policy contracts tables families required outward actions world
        stack (.value contract.answer) output demand requirements restScope}
      (tail : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        source (.value (owners owner contract known).2) outputRows rest) :
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        (.spent known annotation callerScope source) (.value (owners owner contract known).2) outputRows (.spent rest)
  | skippedSpent
      (tail : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        source .unwind outputRows rest) :
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        (.skippedSpent (owner := owner) (answerType := answerType) (caller := caller) source) .unwind outputRows (.spent rest)

/-- Forget only record agreement and the extra ordinary source view at opening. -/
theorem RecordPendingRows.forget
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context) :
    PendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows source inputRows outputRows context := by
  induction checked with
  | nil => exact .nil
  | push head tail ih => exact .push head ih
  | live answerRows agreement inside tail ihInside ihTail =>
      exact .live answerRows ihInside ihTail (known := by assumption) (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption) (callerScope := by assumption)
        (held := by assumption) (answer := by assumption)
  | opening answerRows agreement ordinary inside tail ihOrdinary ihInside ihTail => exact .opening ihInside ihTail
  | spent tail ih => exact .spent ih (known := by assumption) (annotation := by assumption) (callerScope := by assumption)
  | skippedSpent tail ih => exact .skippedSpent ih

private theorem resume_agreement_transport
    (agreement : ResumeBodyAgreement resumes owner demand requirements)
    (changed : RecursiveRequirements.lookup ⟨owner, .resume⟩ next = none ∨
      RecursiveRequirements.lookup ⟨owner, .resume⟩ next = RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes) :
    ResumeBodyAgreement next owner demand requirements := by
  rcases changed with absent | same
  · intro body found
    rw [absent] at found
    contradiction
  · exact agreement.lookup_congr same

/-- A record may disappear; any surviving lookup must retain its exact body. -/
theorem RecordPendingRows.store_transport
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (lookups : ∀ owner, owner ∈ ownedTickets stack →
      RecursiveRequirements.lookup ⟨owner, .resume⟩ next = none ∨
      RecursiveRequirements.lookup ⟨owner, .resume⟩ next = RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes) :
    RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows next source inputRows outputRows context := by
  induction checked with
  | nil => exact .nil
  | @push entry _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ head tail ih =>
      apply RecordPendingRows.push head
      apply ih
      intro owner member
      apply lookups owner
      cases entry <;> simp_all [ownedTickets]
  | live answerRows agreement inside tail ihInside ihTail =>
      have nextAgreement := resume_agreement_transport agreement (lookups _ (by simp [ownedTickets]))
      apply RecordPendingRows.live answerRows nextAgreement
        (known := by assumption) (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption)
        (callerScope := by assumption) (held := by assumption) (answer := by assumption)
      · apply ihInside
        intro owner member
        exact lookups owner (by simp [ownedTickets, member])
      · apply ihTail
        intro owner member
        exact lookups owner (by simp [ownedTickets, member])
  | opening answerRows agreement ordinary inside tail ihOrdinary ihInside ihTail =>
      have nextAgreement := resume_agreement_transport agreement (lookups _ (by simp [ownedTickets]))
      apply RecordPendingRows.opening answerRows nextAgreement
        (known := by assumption) (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption)
        (callerScope := by assumption) (held := by assumption) (answer := by assumption)
      · apply ihOrdinary
        intro owner member
        exact lookups owner (by simp [ownedTickets, member])
      · apply ihInside
        intro owner member
        exact lookups owner (by simp [ownedTickets, member])
      · apply ihTail
        intro owner member
        exact lookups owner (by simp [ownedTickets, member])
  | spent tail ih =>
      exact .spent (ih lookups) (known := by assumption) (annotation := by assumption)
        (callerScope := by assumption)
  | skippedSpent tail ih => exact .skippedSpent (ih lookups)

/-- Growing the identity world preserves both authenticated saved views. -/
theorem RecordPendingRows.world_weaken
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (larger : world ⊆ nextWorld) :
    RecordPendingRows operations policy contracts tables families required outward actions nextWorld
      ports owners emptyRows resumes (source.world_weaken larger) inputRows outputRows context := by
  induction checked with
  | nil => exact .nil
  | push head tail ih => exact .push (head.world_weaken larger) ih
  | live answerRows agreement inside tail ihInside ihTail =>
      exact .live answerRows agreement ihInside ihTail (known := by assumption) (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption) (callerScope := by assumption)
        (held := by assumption) (answer := by assumption)
  | opening answerRows agreement ordinary inside tail ihOrdinary ihInside ihTail =>
      exact .opening answerRows agreement ihOrdinary ihInside ihTail
        (known := by assumption) (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption) (callerScope := by assumption)
        (held := by assumption) (answer := by assumption)
  | spent tail ih => exact .spent ih (known := by assumption) (annotation := by assumption) (callerScope := by assumption)
  | skippedSpent tail ih => exact .skippedSpent ih

/-- Removing any owner's records preserves agreement for every surviving lookup. -/
theorem RecordPendingRows.remove_records
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context) (removed : Nat) :
    RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows (RecursiveTransport.removeOwner removed resumes) source inputRows outputRows context := by
  apply checked.store_transport
  intro owner _member
  by_cases same : owner = removed
  · subst owner
    exact Or.inl RecursiveTransport.lookup_remove_self
  · exact Or.inr (RecursiveTransport.lookup_remove_other same)

/-- A fresh physical owner cannot replace a record required by an existing saved source. -/
theorem RecordPendingRows.insert_fresh_record
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (fresh : added ∉ ownedTickets stack) (mode : RecursiveRequirements.Mode)
    (body : RecursiveRequirements.Template) :
    RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows ((⟨added, mode⟩, body) :: resumes) source inputRows outputRows context := by
  apply checked.store_transport
  intro owner member
  apply Or.inr
  apply RecursiveCapture.lookup_insert_other
  intro same
  exact fresh (same ▸ member)

theorem RecordPendingRows.cell_update
    {hints : ReturnHints dependencyScope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      before input output demand requirements dependencyScope}
    (update : CellUpdate identity old new before after)
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      source inputRows outputRows context) :
    RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      (source.cell_update update) inputRows outputRows context := by
  induction update generalizing input demand requirements dependencyScope with
  | hit => cases rows with
    | push head rest => cases head with
      | ordinary head => cases head with
        | cell =>
            rename_i interface
            cases interface with
            | cell scopeTyped excluded =>
                rename_i residual resultRows scopeKnown noEscape annotation source
                exact .push (.ordinary (.cell (scopeKnown := by assumption) (noEscape := by assumption)
                  (annotation := by assumption) (interface := .cell (residual := residual) scopeTyped excluded))) rest
      | cell => exact .push .cell rest
  | push miss next ih => cases rows with
    | push head rest =>
        simpa only [RecursiveCells.update_context next] using RecordPendingRows.push head (ih rest)
  | live next ih => cases rows with
    | live aligned agreement saved rest =>
        exact .live (actionKnown := by assumption) (inputAnnotation := by assumption)
          (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption)
          (answer := by assumption) aligned agreement saved (ih rest)
    | opening aligned agreement ordinary saved rest =>
        have same := RecursiveCells.update_context (tables := tables) next
        simpa only [OwnerPhases.ofStack, same] using RecordPendingRows.opening aligned agreement ordinary saved (ih rest)
          (known := by assumption) (actionKnown := by assumption)
          (inputAnnotation := by assumption) (answerAnnotation := by assumption)
          (callerScope := by assumption) (held := by assumption) (answer := by assumption)
  | spent next ih => cases rows with
    | spent rest =>
        exact .spent (annotation := by assumption) (callerScope := by assumption) (ih rest)
    | skippedSpent rest => exact .skippedSpent (ih rest)

theorem RecordPendingRows.registries
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      source inputRows outputRows context)
    (tableAgree : ∀ handler, handler.activation ∈ stack.erase.activations → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ stack.erase.activations → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ stack.erase.activations → required handler = nextRequired handler) :
    RecordPendingRows operations policy contracts nextTables nextFamilies nextRequired outward actions world ports owners emptyRows resumes
      (source.registries tableAgree familyAgree requiredAgree) inputRows outputRows context := by
  induction checked with
  | nil => exact .nil
  | push head tail ih =>
      have next := fun handler member => tableAgree handler (List.mem_append_right _ member)
      have same := RecursiveHandlerTables.context_congr next
      obtain ⟨_, moved⟩ := head.registries
        (fun handler member => tableAgree handler (List.mem_append_left _ member))
        (fun handler member => familyAgree handler (List.mem_append_left _ member))
        (fun handler member => requiredAgree handler (List.mem_append_left _ member))
      have remaining := ih next (fun handler member => familyAgree handler (List.mem_append_right _ member))
        (fun handler member => requiredAgree handler (List.mem_append_right _ member))
      simpa only [same] using RecordPendingRows.push moved remaining
  | live answerRows agreement inside tail ihInside ihTail =>
      exact .live answerRows agreement
        (ihInside (fun handler member => tableAgree handler (List.mem_append_left _ member))
          (fun handler member => familyAgree handler (List.mem_append_left _ member))
          (fun handler member => requiredAgree handler (List.mem_append_left _ member)))
        (ihTail (fun handler member => tableAgree handler (List.mem_append_right _ member))
          (fun handler member => familyAgree handler (List.mem_append_right _ member))
          (fun handler member => requiredAgree handler (List.mem_append_right _ member)))
        (known := by assumption) (actionKnown := by assumption) (inputAnnotation := by assumption)
        (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption) (answer := by assumption)
  | opening answerRows agreement ordinary inside tail ihOrdinary ihInside ihTail =>
      have next := fun handler member => tableAgree handler (List.mem_append_right _ member)
      have remaining := ihTail next (fun handler member => familyAgree handler (List.mem_append_right _ member))
        (fun handler member => requiredAgree handler (List.mem_append_right _ member))
      have saved := ihInside (fun handler member => tableAgree handler (List.mem_append_left _ member))
        (fun handler member => familyAgree handler (List.mem_append_left _ member))
        (fun handler member => requiredAgree handler (List.mem_append_left _ member))
      have original := ihOrdinary (fun handler member => tableAgree handler (List.mem_append_left _ member))
        (fun handler member => familyAgree handler (List.mem_append_left _ member))
        (fun handler member => requiredAgree handler (List.mem_append_left _ member))
      have same := RecursiveHandlerTables.context_congr next
      simpa only [OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase, same] using
        RecordPendingRows.opening answerRows agreement original saved remaining
          (known := by assumption) (actionKnown := by assumption)
          (inputAnnotation := by assumption) (answerAnnotation := by assumption)
          (callerScope := by assumption) (held := by assumption) (answer := by assumption)
  | spent tail ih =>
      exact .spent (ih tableAgree familyAgree requiredAgree) (known := by assumption)
        (annotation := by assumption) (callerScope := by assumption)
  | skippedSpent tail ih => exact .skippedSpent (ih tableAgree familyAgree requiredAgree)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.forget
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.store_transport
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.world_weaken
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.remove_records
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.insert_fresh_record
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.cell_update
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.registries


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveRecomposition (evaluate_empty evaluate_spent merge_empty_left)

theorem RecordPendingRows.append_disposals
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {firstContext : Context firstHints} {secondContext : Context secondHints}
    {first : PlannedModeSource operations policy contracts tables families required outward actions world front input middle
      firstDemand firstRequirements firstScope}
    {second : PlannedModeSource operations policy contracts tables families required outward actions world tail middle output
      secondDemand secondRequirements secondScope}
    (firstRows : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      first inputRows middleRows firstContext)
    (secondRows : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      second middleRows outputRows secondContext) :
    ∃ combined : Requirements (firstDemand ++ secondDemand),
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world (front.append tail) input output
        (firstDemand ++ secondDemand) combined (firstScope.append secondScope),
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        source inputRows outputRows (firstContext.append secondContext) ∧
      (∀ store receiving phases,
        evaluate store receiving phases combined =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals combined) =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  induction firstRows generalizing output secondDemand secondRequirements secondScope tail with
  | nil => exact ⟨secondRequirements, second, secondRows,
      by intros; simp only [evaluate_empty, spendAll, merge_empty_left],
      by intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]⟩
  | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
      restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest ih =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ih secondRows
      obtain ⟨nextHints, next, nextRows, same⟩ := head.append_context secondContext
      rw [List.append_assoc]
      have rebuiltRows := RecordPendingRows.push nextRows joinedRows
      have packaged : ∃ combined : Requirements (frameDemand ++ (restDemand ++ secondDemand)), ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
          (.push entry (restStack.append tail)) frameInput output _ combined next.pack.scope,
          RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
            source inRows outputRows next.pack.context ∧
          (∀ store receiving phases,
            evaluate store receiving phases combined =
              merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases
                (.sequence (frameRequirements.prepend (OwnerPhases.ofStack tables restStack)) restRequirements))
                (evaluate store receiving (spendAll phases (frameDemand ++ restDemand)) secondRequirements)) ∧
          (∀ store receiving phases,
            evaluate store receiving phases (annotateDisposals combined) =
              merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases
                (annotateDisposals (.sequence (frameRequirements.prepend (OwnerPhases.ofStack tables restStack)) restRequirements)))
                (evaluate store receiving (spendAll phases (frameDemand ++ restDemand)) (annotateDisposals secondRequirements))) := by
        refine ⟨_, _, rebuiltRows, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, List.append_assoc, generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
      rw [same] at packaged
      exact packaged
  | live aligned agreement saved rest ihSaved ihRest =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ihRest secondRows
      refine ⟨_, _, .live (actionKnown := by assumption) (inputAnnotation := by assumption) (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption) (answer := by assumption) aligned agreement saved joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | opening aligned agreement ordinary saved rest ihOrdinary ihSaved ihRest =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ihRest secondRows
      rw [List.append_assoc, List.append_assoc]
      refine ⟨_, _, .opening (known := by assumption) (actionKnown := by assumption) (inputAnnotation := by assumption) (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption) (answer := by assumption) aligned agreement ordinary saved joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, evaluation,
          PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
      · intro store receiving phases
        simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, generatedEvaluation,
          PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
  | spent rest ih =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ih secondRows
      refine ⟨_, _, .spent (annotation := by assumption) (callerScope := by assumption) joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | skippedSpent rest ih =>
      obtain ⟨combined, source, joinedRows, evaluation, generatedEvaluation⟩ := ih secondRows
      refine ⟨_, _, .skippedSpent joinedRows, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.append_disposals


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveRecomposition (evaluate_empty evaluate_spent merge_empty_left)

/-- Splitting exact decorated contexts retains one shared mode and its value
metadata, and both ordinary and generated requirement evaluations. -/
theorem RecordPendingRows.split_disposals
    {whole : ReturnHints scope} {context : Context whole}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      source inputRows outputRows context) :
    ∀ {firstScope secondScope} {first : ReturnHints firstScope} {second : ReturnHints secondScope}
      (head : Context first) (tail : Context second),
      context.pack = (head.append tail).pack →
    ∃ captured rest, ∃ middle, ∃ middleRows : ModeRowsValue middle,
    ∃ firstDemand secondDemand, ∃ firstRequirements : Requirements firstDemand,
    ∃ secondRequirements : Requirements secondDemand,
    ∃ firstSource : PlannedModeSource operations policy contracts tables families required outward actions world
      captured input middle firstDemand firstRequirements firstScope,
    ∃ secondSource : PlannedModeSource operations policy contracts tables families required outward actions world
      rest middle output secondDemand secondRequirements secondScope,
      stack = captured.append rest ∧
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        firstSource inputRows middleRows head ∧
      RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        secondSource middleRows outputRows tail ∧
      demand = firstDemand ++ secondDemand ∧
      (∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables rest ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals requirements) =
          merge (evaluate store (OwnerPhases.ofStack tables rest ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  induction rows with
  | nil =>
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      refine ⟨.nil, .nil, _, _, [], [], .request [] [], .request [] [], .nil, .nil, rfl, .nil, .nil, rfl, ?_, ?_⟩
      all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
  | push frame remaining ih =>
      have full := RecordPendingRows.push frame remaining
      cases frame with
      | ordinary checked | handler checked =>
          cases checked
          all_goals
            intro firstScope secondScope first second head tail same
            cases head <;> cases same
            all_goals first
            | solve
              | refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
                all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
            | obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
                firstRequirements, secondRequirements, firstSource, secondSource,
                equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
              subst_vars
              refine ⟨_, outside, middle, middleRows, _, secondDemand, _, secondRequirements, .push (by first | exact .ordinary (by constructor <;> assumption) | exact .handler (by constructor <;> assumption)) firstSource, secondSource,
                rfl, .push (frame := by first | exact .ordinary (by constructor <;> assumption) | exact .handler (by constructor <;> assumption)) ?_ inside, restRows, ?_, ?_, ?_⟩
              · first
                | exact .ordinary (by constructor <;> assumption)
                | exact .handler (by constructor <;> assumption)
              · simp only [List.append_assoc]
              · intro store receiving phases
                simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
                  OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
              · intro store receiving phases
                simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                  RecursiveRequirements.evaluate_prepend, OwnerPhases.stack_append, List.append_assoc,
                  generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
      | unwinding checked | closing | retiring | skipped | cell | cleanup checked =>
          intro firstScope secondScope first second head tail same
          cases head <;> cases same
          all_goals first
          | solve
            | refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
              all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
          | obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
              firstRequirements, secondRequirements, firstSource, secondSource,
              equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
            subst_vars
            refine ⟨_, outside, middle, middleRows, _, secondDemand, _, secondRequirements, .push (by constructor <;> assumption) firstSource, secondSource,
              rfl, .push (frame := by constructor <;> assumption) ?_ inside, restRows, ?_, ?_, ?_⟩
            · constructor <;> assumption
            · simp only [List.append_assoc]
            · intro store receiving phases
              simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
                OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
            · intro store receiving phases
              simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                RecursiveRequirements.evaluate_prepend, OwnerPhases.stack_append, List.append_assoc,
                generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
  | live aligned agreement saved remaining ihSaved ihTail =>
      have full := RecordPendingRows.live (actionKnown := by assumption) (inputAnnotation := by assumption)
        (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption)
        (answer := by assumption) aligned agreement saved remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ihTail _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, firstDemand, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .live (actionKnown := by assumption) (inputAnnotation := by assumption)
            (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption)
            (answer := by assumption) aligned agreement saved inside, restRows, rfl, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | opening aligned agreement ordinary saved remaining ihOrdinary ihSaved ihTail =>
      have full := RecordPendingRows.opening (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption)
        (callerScope := by assumption) (held := by assumption) (answer := by assumption)
        aligned agreement ordinary saved remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ihTail _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, _, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .opening (actionKnown := by assumption) (inputAnnotation := by assumption)
            (answerAnnotation := by assumption) (callerScope := by assumption)
            (held := by assumption) (answer := by assumption) aligned agreement ordinary saved inside, restRows, ?_, ?_, ?_⟩
        · simp only [List.append_assoc]
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, evaluation,
            PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
        · intro store receiving phases
          simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, generatedEvaluation,
            PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
  | spent remaining ih =>
      have full := RecordPendingRows.spent (annotation := by assumption) (callerScope := by assumption) remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, firstDemand, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .spent (annotation := by assumption) (callerScope := by assumption) inside, restRows, rfl, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | skippedSpent remaining ih =>
      rename_i owner answerType caller
      have full := RecordPendingRows.skippedSpent (owner := owner) (answerType := answerType) (caller := caller) remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, firstDemand, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .skippedSpent inside, restRows, rfl, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.split_disposals


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)

/-- Either pending mode retains the ordinary source belonging to the selected
resume record. Opening cannot replace that source with its unwind requirements. -/
theorem RecordPendingRows.resume_source
    {contract : SourcePlannedTyping.Contract}
    {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {capturedContext : Context capturedHints} {tailContext : Context tailHints}
    {recorded : Requirements contract.resumeDemand}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.live owner inputType answerType capture caller tail) input output demand requirements
      (.live owner capturedScope tailScope)}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (known : contracts owner = some contract)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recorded⟩) :
    ∃ boundary, ∃ saved : PlannedModeSource operations policy contracts tables families required outward actions world
      capture (.value contract.input) boundary contract.resumeDemand recorded capturedScope,
    ∃ boundaryRows : ModeRowsValue boundary,
      (boundary = .value contract.answer ∨ boundary = .unwind) ∧
      ModeRowsValue.Answer (owners owner contract known).2 boundaryRows ∧
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows resumes saved (.value (owners owner contract known).1) boundaryRows capturedContext := by
  cases rows with
  | live answerRows agreement inside tail =>
      have sameContract : _ := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      have same := agreement.requirements_eq found
      subst recorded
      exact ⟨_, _, _, by assumption, answerRows, inside⟩
  | opening answerRows agreement ordinary inside tail =>
      have sameContract : _ := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      have same := agreement.requirements_eq found
      subst recorded
      exact ⟨_, _, _, by assumption, answerRows, ordinary⟩


/-- The rich context determines the physical live boundary, so its stored
ordinary source is available without a separate runtime shape premise. -/
theorem RecordPendingRows.resume_source_head
    {contract : SourcePlannedTyping.Contract}
    {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {capturedContext : Context capturedHints} {tailContext : Context tailHints}
    {recorded : Requirements contract.resumeDemand}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements (.live owner capturedScope tailScope)}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (known : contracts owner = some contract)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recorded⟩) :
    ∃ inputType answerType capture caller tail,
      stack = .live owner inputType answerType capture caller tail ∧
      ∃ boundary, ∃ saved : PlannedModeSource operations policy contracts tables families required outward actions world
        capture (.value contract.input) boundary contract.resumeDemand recorded capturedScope,
      ∃ boundaryRows : ModeRowsValue boundary,
        (boundary = .value contract.answer ∨ boundary = .unwind) ∧
        ModeRowsValue.Answer (owners owner contract known).2 boundaryRows ∧
        RecordPendingRows operations policy contracts tables families required outward actions world
          ports owners emptyRows resumes saved (.value (owners owner contract known).1) boundaryRows capturedContext := by
  have physical := rows.forget.source
  cases physical with
  | live captured tail =>
      exact ⟨_, _, _, _, _, rfl, rows.resume_source known found⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_source

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_source_head


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

theorem Context.Source.closing_exists_of_unwind_prefix
    {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack)
    (scopes : LexicalUnwind.UnwindPrefix stack) :
    ∃ metadata, context.closing? = some metadata := by
  induction source with
  | nil => exact ⟨.nil, rfl⟩
  | plain tail ih | handler declaration tail ih | cell tail ih
  | cleanup callback tail ih | retiring tail ih | spent tail ih =>
      cases scopes
      rename_i next
      obtain ⟨metadata, same⟩ := ih next
      simp only [Context.closing?, same, Option.map_some]
      exact ⟨_, rfl⟩
  | normal tail ih | unwinding tail ih | closing tail ih => cases scopes
  | live saved tail ihSaved ihTail =>
      cases scopes with
      | live inside outside =>
          obtain ⟨savedMetadata, savedSame⟩ := ihSaved inside
          obtain ⟨tailMetadata, tailSame⟩ := ihTail outside
          simp [Context.closing?, savedSame, tailSame]


theorem Context.Source.closing_agreement_of_reentry
    {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context front)
    (reentry : SourceDependencyOwners.ReentrySource operations policy contracts world front captured tail .unwind) :
    ∃ metadata, context.closing? = some metadata ∧
      CleanupHints.Agreement operations policy contracts tables families world metadata front
        metadata.closing.1 metadata.closing.2 := by
  cases reentry with
  | unwind scopes frontSource savedSource tailSource =>
      obtain ⟨metadata, found⟩ := source.closing_exists_of_unwind_prefix scopes
      exact ⟨metadata, found, source.closing_agreement found⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.closing_exists_of_unwind_prefix

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.closing_agreement_of_reentry


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)

/-- Construct a fresh caller alternative from the exact cleanup metadata.
The existing normal check supplies its ownership trace; no retained path in an
older root is required. This lemma does not originate the finite metadata check. -/
theorem caller_annotation_from_metadata
    (agreed : CleanupHints.Agreement operations policy contracts tables families world
      metadata stack closeDemand closingRequirements)
    (aligned : demand.Perm closeDemand)
    (annotation : RowAnnotation (normal : Requirements demand) annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) normalRow)
    (bounded : normalRow ⊆ budget)
    (closing : metadata.check receiving before budget = true) :
    ∃ combined : Requirements demand, ∃ row,
      RowAnnotation normal combined ∧
      RequirementPath annotated combined [] ∧
      RequirementPath closingRequirements combined [] ∧
      Checked entries receiving before (annotateDisposals combined) row ∧ row ⊆ budget := by
  have trace := OwnerPhaseTransitions.trace_permutation (RecursiveRequirements.checked_trace checked) aligned
  obtain ⟨closingRow, closingChecked, closingBound⟩ := (agreed.effects closing).checked (store := entries) trace
  have unchanged := (unwind_template_disposals agreed.source.template).2
  refine ⟨.choice annotated closingRequirements aligned, normalRow ++ closingRow,
    .alternatives annotation aligned, .yes .here, .no .here, ?_,
    List.append_subset.mpr ⟨bounded, closingBound⟩⟩
  simpa only [annotateDisposals, unchanged] using Checked.choice checked closingChecked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.caller_annotation_from_metadata

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open OwnerPhaseTransitions (spend spendAll)

/-- The resume-site scalar premise supplies precisely the missing caller
alternative, reusing the existing ownership and annotation construction. -/
theorem ResumeBudget.caller_annotation
    (budgeted : ResumeBudget budget before owner resumeDemand .unwind front tail = true)
    (found : front.closing? = some metadata)
    (agreed : CleanupHints.Agreement operations policy contracts tables families world
      metadata stack closeDemand closingRequirements)
    (aligned : demand.Perm closeDemand)
    (annotation : RowAnnotation (normal : Requirements demand) annotated)
    (checked : Checked entries (Context.spent (owner := owner) tail).context
      (spendAll (spend before owner) resumeDemand) (annotateDisposals annotated) normalRow)
    (bounded : normalRow ⊆ budget) :
    ∃ combined : Requirements demand, ∃ row,
      RowAnnotation normal combined ∧
      RequirementPath annotated combined [] ∧
      RequirementPath closingRequirements combined [] ∧
      Checked entries (Context.spent (owner := owner) tail).context
        (spendAll (spend before owner) resumeDemand) (annotateDisposals combined) row ∧ row ⊆ budget := by
  obtain ⟨actual, projected, closing⟩ := ResumeBudget.unwind_iff.mp budgeted
  have same : actual = metadata := Option.some.inj (projected.symm.trans found)
  subst actual
  exact caller_annotation_from_metadata agreed aligned annotation checked bounded closing

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
