namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyAnnotations (Dependencies)
open SourcePlanSignatures (Signature ClauseSignatures)

/-- Selection preserves the exact row family, not just its dependency index. -/
theorem ClauseRows.Selected.unique
    {family nextFamily : Nat → Dependencies}
    {bodies : ∀ owner, Signature (family owner)} {nextBodies : ∀ owner, Signature (nextFamily owner)}
    {firstRows : ∀ owner, Rows (bodies owner)} {secondRows : ∀ owner, Rows (nextBodies owner)}
    (first : ClauseRows.Selected operation held declarations firstRows)
    (second : ClauseRows.Selected operation held declarations secondRows) :
    family = nextFamily ∧ HEq bodies nextBodies ∧ HEq firstRows secondRows := by
  induction first with
  | ordinary => cases second with
    | ordinary => exact ⟨rfl, HEq.rfl, HEq.rfl⟩
    | pass different next => exact False.elim (different rfl)
  | protectedMode => cases second with
    | protectedMode => exact ⟨rfl, HEq.rfl, HEq.rfl⟩
    | pass different next => exact False.elim (different rfl)
  | pass different next ih => cases second with
    | ordinary => exact False.elim (different rfl)
    | protectedMode => exact False.elim (different rfl)
    | pass other rest => exact ih rest

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyAnnotations (Dependencies)
open SourcePlanSignatures (Signature ClauseSignatures)
open SourceDependencyChecks.Lexical (ReturnHints)

/-- The designated handler is terminal on the active captured spine. Dormant
saved contexts are retained but never traversed to locate this handler. -/
inductive TerminalHandler (effect : Instance) (activation : Nat)
    {declarations : ClauseSignatures families} (rows : ClauseRows declarations) :
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} → Context hints → Prop where
  | here : TerminalHandler effect activation rows
      (.handler (effect := effect) (table := table) activation rows .nil)
  | plain (found : TerminalHandler effect activation rows tail) :
      TerminalHandler effect activation rows (.plain waiting tail)
  | handler (found : TerminalHandler effect activation rows tail) :
      TerminalHandler effect activation rows (.handler (effect := other) (table := table) next outerRows tail)
  | cell (found : TerminalHandler effect activation rows tail) :
      TerminalHandler effect activation rows (.cell (identity := identity) tail)
  | cleanup (found : TerminalHandler effect activation rows tail) :
      TerminalHandler effect activation rows (.cleanup (needs := needs) latent callback tail)
  | normal (found : TerminalHandler effect activation rows tail) : TerminalHandler effect activation rows (.normal tail)
  | unwinding (found : TerminalHandler effect activation rows tail) : TerminalHandler effect activation rows (.unwinding tail)
  | closing (found : TerminalHandler effect activation rows tail) : TerminalHandler effect activation rows (.closing tail)
  | retiring (found : TerminalHandler effect activation rows tail) : TerminalHandler effect activation rows (.retiring owner tail)
  | live (found : TerminalHandler effect activation rows tail) :
      TerminalHandler effect activation rows (.live (owner := owner) (resumeDemand := resumeDemand) saved tail)
  | spent (found : TerminalHandler effect activation rows tail) :
      TerminalHandler effect activation rows (.spent (owner := owner) tail)

theorem TerminalHandler.not_nil (found : TerminalHandler effect activation rows Context.nil) : False := by
  cases found

/-- Any actual prefix, including live dormant captures, retains the terminal
handler's identity and exact row decorations. -/
theorem TerminalHandler.prefix (front : Context hints)
    (found : TerminalHandler effect activation rows tail) :
    TerminalHandler effect activation rows (front.append tail) := by
  induction front with
  | nil => exact found
  | plain waiting rest ih => exact .plain ih
  | handler next declarations rest ih => exact .handler ih
  | cell rest ih => exact .cell ih
  | cleanup latent callback rest ih => exact .cleanup ih
  | normal rest ih => exact .normal ih
  | unwinding rest ih => exact .unwinding ih
  | closing rest ih => exact .closing ih
  | retiring owner rest ih => exact .retiring ih
  | live saved rest ihSaved ihRest => exact .live ihRest
  | spent rest ih => exact .spent ih

/-- The terminal active handler determines its exact retained row decoration. -/
theorem TerminalHandler.unique
    {declarations : ClauseSignatures families} {nextDeclarations : ClauseSignatures nextFamilies}
    {rows : ClauseRows declarations} {nextRows : ClauseRows nextDeclarations}
    (first : TerminalHandler effect activation rows context)
    (second : TerminalHandler nextEffect nextActivation nextRows context) :
    effect = nextEffect ∧ activation = nextActivation ∧ families = nextFamilies ∧
      HEq declarations nextDeclarations ∧ HEq rows nextRows := by
  induction first with
  | here => cases second with
    | here => exact ⟨rfl, rfl, rfl, HEq.rfl, HEq.rfl⟩
    | handler remaining => exact False.elim remaining.not_nil
  | plain first ih => cases second with | plain rest => exact ih rest
  | handler first ih => cases second with
    | here => exact False.elim first.not_nil
    | handler rest => exact ih rest
  | cell first ih => cases second with | cell rest => exact ih rest
  | cleanup first ih => cases second with | cleanup rest => exact ih rest
  | normal first ih => cases second with | normal rest => exact ih rest
  | unwinding first ih => cases second with | unwinding rest => exact ih rest
  | closing first ih => cases second with | closing rest => exact ih rest
  | retiring first ih => cases second with | retiring rest => exact ih rest
  | live first ih => cases second with | live rest => exact ih rest
  | spent first ih => cases second with | spent rest => exact ih rest

/-- A request's selected row family belongs to this actual captured handler. -/
inductive CapturedClauseRows (effect : Instance) (operation : Nat) (held : Bool) :
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} → Context hints →
    {family : Nat → Dependencies} → {bodies : ∀ owner, Signature (family owner)} →
    (∀ owner, Rows (bodies owner)) → Prop where
  | selected (terminal : TerminalHandler effect activation declarations captured)
      (chosen : ClauseRows.Selected operation held declarations bodyRows) :
      CapturedClauseRows effect operation held captured bodyRows

/-- Construction from the exact terminal decomposition and authenticated
selection requires no modification of Selection or Cut. -/
theorem CapturedClauseRows.at_terminal (front : Context hints)
    (chosen : ClauseRows.Selected operation held declarations bodyRows) :
    CapturedClauseRows effect operation held
      (front.append (.handler (effect := effect) (table := table) activation declarations .nil)) bodyRows :=
  .selected (TerminalHandler.here.prefix front) chosen

/-- An independently authenticated lookup at the same terminal handler yields
this exact selected family. -/
theorem CapturedClauseRows.unique
    {family nextFamily : Nat → Dependencies}
    {bodies : ∀ owner, Signature (family owner)} {nextBodies : ∀ owner, Signature (nextFamily owner)}
    {firstRows : ∀ owner, Rows (bodies owner)} {secondRows : ∀ owner, Rows (nextBodies owner)}
    (first : CapturedClauseRows effect operation held context firstRows)
    (second : CapturedClauseRows effect operation held context secondRows) :
    family = nextFamily ∧ HEq bodies nextBodies ∧ HEq firstRows secondRows := by
  cases first with
  | selected firstTerminal firstSelected =>
    cases second with
    | selected secondTerminal secondSelected =>
      obtain ⟨_, _, familiesSame, declarationsSame, rowsSame⟩ := firstTerminal.unique secondTerminal
      cases familiesSame
      cases declarationsSame
      cases rowsSame
      exact firstSelected.unique secondSelected

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
