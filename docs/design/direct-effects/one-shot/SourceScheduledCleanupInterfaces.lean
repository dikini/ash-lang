theorem Auth.value_context
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (isValue : code.IsValue) (nextAllowed : List Instance) (nextScope : Execution.Scope) :
    Auth operations policy ports owners environmentRows
      (SourcePlannedSources.Values.change_context source isValue nextAllowed nextScope) valueRows rows := by
  induction checked using Auth.rec
      (motive_2 := fun {_} _ {_ _ _ _} _ {_ _} _ {_ _ _} _ _ _ => True)
      (motive_3 := fun {_} _ {_ _} _ {_ _ _ _} _ {_} _ {_} _ {_ _ _ _ _ _ _ _} _ _ _ => True)
      (motive_4 := fun {_} _ {_ _} _ {_ _ _} _ {_ _ _ _} _ _ _ => True) with
  | unit => exact .unit
  | boolean => exact .boolean
  | integer => exact .integer
  | reference => exact Auth.reference (issued := by assumption)
  | lambda body captured ih => exact Auth.lambda body captured (outward := by assumption) (formed := by assumption) (latentBound := by assumption)
  | purePair left right ihLeft ihRight => exact .purePair (ihLeft isValue.1) (ihRight isValue.2)
  | pair left right ihLeft ihRight => exact .pair (ihLeft isValue.1) (ihRight isValue.2)
  | «variable» | app | bind | branch | perform | handler | resume | discard | cleanup | resource => cases isValue
  | typed | unavailable | available | nil | cons => trivial

/-- Value normalization changes only the immediate computation annotation;
argument, result and latent-body decorations remain exactly the same. -/
theorem Auth.value_summary
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (isValue : code.IsValue) :
    Auth operations policy ports owners environmentRows
      (SourcePlannedSources.Values.summary source isValue) valueRows .pure := by
  induction checked using Auth.rec
      (motive_2 := fun {_} _ {_ _ _ _} _ {_ _} _ {_ _ _} _ _ _ => True)
      (motive_3 := fun {_} _ {_ _} _ {_ _ _ _} _ {_} _ {_} _ {_ _ _ _ _ _ _ _} _ _ _ => True)
      (motive_4 := fun {_} _ {_ _} _ {_ _ _} _ {_ _ _ _} _ _ _ => True) with
  | unit => exact .unit
  | boolean => exact .boolean
  | integer => exact .integer
  | reference => exact Auth.reference (issued := by assumption)
  | lambda body captured ih => exact Auth.lambda body captured (outward := by assumption) (formed := by assumption) (latentBound := by assumption)
  | purePair left right ihLeft ihRight | pair left right ihLeft ihRight =>
      exact .purePair (ihLeft isValue.1) (ihRight isValue.2)
  | «variable» | app | bind | branch | perform | handler | resume | discard | cleanup | resource => cases isValue
  | typed | unavailable | available | nil | cons => trivial
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

