/-- Actual expression focus retains authenticated source and pending metadata,
with cleanup budgets inherited from the predecessor's structural admission. -/
theorem Admitted.focus_retained_rows
    {plan : Plan dependencies} {rows : Rows (signature plan)} {resultRows : ValueRows result}
    {hints : ReturnHints receiving} {context : Context hints}
    {pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value result) output pendingDemand pendingRequirements receiving}
    (admitted : Admitted operations policy contracts ports owners (fun _ => none) emptyRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack whole result demand requirements (signature plan) resultRows rows)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (coherent : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      pending (.value resultRows) outputRows context)
    (pendingBudget : PendingBudget budget phases world installations context .nil .ordinary output.mode)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (focus : Focus whole child position) :
    ∃ (plain : PlainData) (input : Value) (childDemand restDemand : List Nat)
      (childRequirements : Requirements childDemand) (restRequirements : Requirements restDemand)
      (childDependencies restDependencies : SourceDependencyAnnotations.Dependencies)
      (childPlan : Plan childDependencies) (restPlan : Plan restDependencies)
      (inputRows : ValueRows input) (childRows : Rows (signature childPlan)) (restRows : Rows (signature restPlan)),
      plain.context = position ∧ plain.scope = runtimeScope ∧ demand = childDemand ++ restDemand ∧
      Admitted operations policy contracts ports owners (fun _ => none) emptyRows world installations allowed outward
        runtimeScope actions phases budget tables families (.plain restRows context) (.push (.plain plain) stack)
        child input childDemand childRequirements (signature childPlan) inputRows childRows ∧
      Certified (evidence := declarationPolicy) outward world childPlan ∧
      (∃ nextPending : PlannedModeSource operations policy contracts tables families required outward actions world
        (.push (.plain plain) stack) (.value input) output (restDemand ++ pendingDemand)
        (.sequence (restRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements)
        (.plain restDependencies receiving),
        PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
          nextPending (.value inputRows) outputRows (.plain restRows context)) ∧
      PendingBudget budget phases world installations (.plain restRows context) .nil .ordinary output.mode ∧
      RawStep ⟨whole, runtimeScope, stack⟩ ⟨child, runtimeScope, .push (.plain plain) stack⟩ [] [] ∧
      FocusRows rows childRows restRows ∧
      Local outward actions phases world restDependencies hints ∧
      ∀ entries receiving before,
        (evaluate entries receiving before requirements =
          merge (evaluate entries receiving before childRequirements)
            (evaluate entries receiving (spendAll before childDemand) restRequirements)) ∧
        evaluate entries receiving before (annotateDisposals requirements) =
          merge (evaluate entries receiving before (annotateDisposals childRequirements))
            (evaluate entries receiving (spendAll before childDemand) (annotateDisposals restRequirements)) := by
  obtain ⟨input, childDemand, restDemand, childRequirements, restRequirements, childDependencies, restDependencies,
    childSignature, restSignature, inputRows, childRows, restRows, childSource, sourceContext,
    childAuth, contextAuth, split, rowSplit, sameDemand, evaluation⟩ := admitted.authenticated.focus_decompose_rows focus
  obtain ⟨childPlan, restPlan, childSame, restSame, childCertified, restCertified, childCheck, restCheck⟩ :=
    focus_signature_checks split rfl certified admitted.capabilities
  cases childSame
  cases restSame
  obtain ⟨childBudget, restBudget⟩ := rowSplit.budgeted admitted.cleanupBudget
  obtain ⟨plain, contextSame, scopeSame, inputAnnotation, outputAnnotation⟩ := RecursiveContexts.prepare_plain
    (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase admitted.source)))
    focus scopeTyped input.erase.erase
  have actualContext : SourcePlannedSources.Context operations policy contracts world (fun _ => none) allowed
      plain.scope plain.context input result restDemand restRequirements (signature restPlan) :=
    by simpa only [contextSame, scopeSame] using sourceContext
  have actualAuth : AuthContext operations policy ports owners emptyRows actualContext inputRows resultRows restRows :=
    by simpa only [contextSame, scopeSame] using contextAuth
  have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required
      outward world (.plain plain) input result restDemand restRequirements (.plain restDependencies)
      (fun rest => .plain rest) allowed allowed :=
    .plain actualContext (by simpa only [scopeSame] using scopeTyped) inputAnnotation outputAnnotation restCertified
  have frameRows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows resultRows context (.plain restRows context) :=
    .plain (scopeKnown := by simpa only [scopeSame] using scopeTyped)
      (inputAnnotation := inputAnnotation) (outputAnnotation := outputAnnotation) (certified := restCertified) actualAuth
  have restAtNil : Budgeted budget phases world installations restRows (context.append .nil) := by
    change Budgeted budget phases world installations restRows (context.append .nil).pack.context
    rw [context.append_nil_pack]
    exact restBudget
  refine ⟨plain, input, childDemand, restDemand, childRequirements, restRequirements, childDependencies, restDependencies,
    childPlan, restPlan, inputRows, childRows, restRows, contextSame, scopeSame, sameDemand,
    ⟨childSource, childAuth, childCheck, childBudget, .plain admitted.contextSource⟩,
    childCertified, ⟨_, .push (.ordinary frameRows) coherent⟩, .plain restAtNil pendingBudget, ?_, rowSplit, restCheck, evaluation⟩
  simpa only [scopeSame] using RawStep.focus plain (by simpa only [contextSame] using focus) stack


