theorem RecordPendingRows.resume_physical_ordinary
    {contract : SourcePlannedTyping.Contract} {known : contracts owner = some contract}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value contract.answer) middle frontDemand frontRequirements frontScope}
    {liveSource : PlannedModeSource operations policy contracts tables families required outward actions world
      (.live owner inputType answerType captured caller tail) middle output
      liveDemand liveRequirements (.live owner capturedScope tailScope)}
    (frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes frontSource (.value (owners owner contract known).2) middleRows frontContext)
    (liveRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes liveSource middleRows outputRows
        (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (ordinary : LexicalUnwind.returnMode captured .ordinary = .ordinary) :
    ∃ demand, ∃ requirements : Requirements demand,
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
      demand requirements (capturedScope.append (frontScope.append (.spent owner tailScope))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) source
        (.value (owners owner contract known).1) outputRows
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) := by
  cases liveRows with
  | live answerRows agreement inside tailRows =>
      have sameContract := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      cases answerRows with
      | value =>
          have spentRows := RecordPendingRows.spent (owner := owner) (answerType := answerType)
            (known := known) (annotation := by assumption) (callerScope := by assumption)
            (tailRows.remove_records owner)
          obtain ⟨_, _, waiting, _, _⟩ := (frontRows.remove_records owner).append_disposals spentRows
          obtain ⟨requirements, source, rows, _, _⟩ := (inside.remove_records owner).append_disposals waiting
          exact ⟨_, requirements, source, rows⟩
      | unwind =>
          have returned := record_return_mode inside
          simp only [PlannedModeValue.mode] at returned
          rw [ordinary] at returned
          cases returned
  | opening answerRows agreement original inside tailRows =>
      have sameContract := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      cases answerRows with
      | value =>
          have spentRows := RecordPendingRows.skippedSpent (owner := owner) (answerType := answerType)
            (caller := caller) (tailRows.remove_records owner)
          obtain ⟨_, _, waiting, _, _⟩ := (frontRows.remove_records owner).append_disposals spentRows
          obtain ⟨requirements, source, rows, _, _⟩ := (original.remove_records owner).append_disposals waiting
          exact ⟨_, requirements, source, rows⟩
      | unwind =>
          have returned := record_return_mode original
          simp only [PlannedModeValue.mode] at returned
          rw [ordinary] at returned
          cases returned

theorem RecordPendingRows.resume_physical_unwind
    {contract : SourcePlannedTyping.Contract} {known : contracts owner = some contract}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value contract.answer) middle frontDemand frontRequirements frontScope}
    {liveSource : PlannedModeSource operations policy contracts tables families required outward actions world
      (.live owner inputType answerType captured caller tail) middle output
      liveDemand liveRequirements (.live owner capturedScope tailScope)}
    (frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes frontSource (.value (owners owner contract known).2) middleRows frontContext)
    (liveRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes liveSource middleRows outputRows
        (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (closing : frontContext.closing? = some metadata)
    (unwinding : LexicalUnwind.returnMode captured .ordinary = .unwind) :
    ∃ demand, ∃ requirements : Requirements demand,
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
      demand requirements (capturedScope.append (frontScope.append (.spent owner tailScope))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) source
        (.value (owners owner contract known).1) outputRows
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) := by
  obtain ⟨_, _, closeRows, _, _, _⟩ := frontRows.closing_rich closing
  cases liveRows with
  | live answerRows agreement inside tailRows =>
      have sameContract := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      cases answerRows with
      | value =>
          have returned := record_return_mode inside
          simp only [PlannedModeValue.mode] at returned
          rw [unwinding] at returned
          cases returned
      | unwind =>
          have spentRows := RecordPendingRows.skippedSpent (owner := owner) (answerType := answerType)
            (caller := caller) (tailRows.remove_records owner)
          obtain ⟨_, _, waiting, _, _⟩ := (closeRows.remove_records owner).append_disposals spentRows
          obtain ⟨requirements, source, rows, _, _⟩ := (inside.remove_records owner).append_disposals waiting
          exact ⟨_, requirements, source, rows⟩
  | opening answerRows agreement original inside tailRows =>
      have sameContract := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      cases answerRows with
      | value =>
          have returned := record_return_mode original
          simp only [PlannedModeValue.mode] at returned
          rw [unwinding] at returned
          cases returned
      | unwind =>
          have spentRows := RecordPendingRows.skippedSpent (owner := owner) (answerType := answerType)
            (caller := caller) (tailRows.remove_records owner)
          obtain ⟨_, _, waiting, _, _⟩ := (closeRows.remove_records owner).append_disposals spentRows
          obtain ⟨requirements, source, rows, _, _⟩ := (original.remove_records owner).append_disposals waiting
          exact ⟨_, requirements, source, rows⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
