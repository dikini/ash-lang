namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (evaluate)
open OwnerPhaseTransitions (spendAll)
open SpentTransport
private def stripSpent (freshOwner : Nat) (context : OwnerPhases.Context) : OwnerPhases.Context :=
  context.filter (fun entry => entry != .spent freshOwner)
private theorem stripSpent_append (first second : OwnerPhases.Context) :
    stripSpent freshOwner (first ++ second) = stripSpent freshOwner first ++ stripSpent freshOwner second :=
  List.filter_append first second
private theorem export_strip_congr
    (same : stripSpent freshOwner first = stripSpent freshOwner second) phases raw :
    OwnerSource.exportAt first phases raw = OwnerSource.exportAt second phases raw :=
  SpentTransport.export_strip_congr same phases raw
private theorem empty_evaluate_congr (requirements : RecursiveRequirements.Requirements demand)
    (same : stripSpent freshOwner first = stripSpent freshOwner second) phases :
    evaluate [] first phases requirements = evaluate [] second phases requirements :=
  SpentTransport.empty_evaluate_congr requirements same phases
private theorem empty_request : evaluate [] receiving phases (.request nearer raw) =
    OwnerSource.exportAt (nearer ++ receiving) phases raw :=
  SpentTransport.empty_request (receiving := receiving) (phases := phases) (nearer := nearer) (raw := raw)

private inductive DeepMetaSpent (freshOwner : Nat) : {firstScope secondScope : SourceDependencyCapture.Scope} →
    CleanupHints.Metadata firstScope → CleanupHints.Metadata secondScope → Prop where
  | same (metadata) : DeepMetaSpent freshOwner metadata metadata
  | add (related : DeepMetaSpent freshOwner first second) : DeepMetaSpent freshOwner first (.spent (owner := freshOwner) second)
  | plain (related : DeepMetaSpent freshOwner first second) : DeepMetaSpent freshOwner (.plain (dependencies := dependencies) first) (.plain (dependencies := dependencies) second)
  | handler (related : DeepMetaSpent freshOwner first second) : DeepMetaSpent freshOwner
      (.handler (effect := effect) (table := table) (families := families) activation first) (.handler (effect := effect) (table := table) (families := families) activation second)
  | cell (related : DeepMetaSpent freshOwner first second) : DeepMetaSpent freshOwner (.cell (identity := identity) first) (.cell (identity := identity) second)
  | cleanup (related : DeepMetaSpent freshOwner first second) : DeepMetaSpent freshOwner
      (.cleanup (needs := needs) (callback := callback) latent first) (.cleanup (needs := needs) (callback := callback) latent second)
  | retiring (related : DeepMetaSpent freshOwner first second) : DeepMetaSpent freshOwner (.retiring owner first) (.retiring owner second)
  | live (saved : DeepMetaSpent freshOwner oldSaved nextSaved) (related : DeepMetaSpent freshOwner first second) :
      DeepMetaSpent freshOwner (.live (owner := owner) oldSaved first) (.live (owner := owner) nextSaved second)
  | spent (related : DeepMetaSpent freshOwner first second) : DeepMetaSpent freshOwner (.spent (owner := owner) first) (.spent (owner := owner) second)

private theorem DeepMetaSpent.held
    {first : CleanupHints.Metadata firstScope} {second : CleanupHints.Metadata secondScope}
    (related : DeepMetaSpent freshOwner first second) : firstScope.held = secondScope.held := by
  induction related <;> simp_all [SourceDependencyCapture.Scope.held]

private theorem DeepMetaSpent.contexts (related : DeepMetaSpent freshOwner first second) :
    stripSpent freshOwner first.context = stripSpent freshOwner second.context := by
  induction related <;> simp_all [CleanupHints.Metadata.context, stripSpent, List.filter_cons]
  exact DeepMetaSpent.held (by assumption)


private theorem DeepMetaSpent.demand (related : DeepMetaSpent freshOwner first second) :
    first.closing.1 = second.closing.1 := by
  induction related <;> simp_all [CleanupHints.Metadata.closing]

private theorem DeepSpentHistory.contexts (related : DeepSpentHistory freshOwner first second) :
    stripSpent freshOwner first.context = stripSpent freshOwner second.context := by
  induction related <;> simp_all [Context.context, stripSpent, List.filter_cons]
  exact DeepSpentHistory.held (by assumption)

private theorem DeepMetaSpent.evaluates (related : DeepMetaSpent freshOwner first second)
    (same : stripSpent freshOwner left = stripSpent freshOwner right)
    (consumed : phases freshOwner = .consumed) :
    evaluate [] left phases first.closing.2 = evaluate [] right phases second.closing.2 := by
  induction related generalizing left right phases with
  | same metadata => exact empty_evaluate_congr _ same phases
  | add related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_spent, consumed, if_true, spendAll,
        RecursiveRecomposition.merge_empty_left]
      exact ih same consumed
  | plain related ih | handler related ih | cell related ih => exact ih same consumed
  | @cleanup _ first _ second needs callback latent related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence, empty_request, spendAll]
      rw [ih same consumed, export_strip_congr (freshOwner := freshOwner)
        (first := first.context ++ left) (second := second.context ++ right)
        (by simp only [stripSpent_append, related.contexts, same])]
  | retiring related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveClosing.evaluate_retire, spendAll]
      rw [ih same (RecursiveTransport.phases_spend_later _ consumed)]
  | spent related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_spent, spendAll]
      rw [ih same consumed]
  | @live savedScope oldSaved nextSavedScope nextSaved _ first _ second owner saved related ihSaved ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRequirements.evaluate_prepend, RecursiveClosing.evaluate_retire, spendAll]
      have spentSame := congrArg (spendAll phases) saved.demand
      rw [spentSame]
      rw [ih same (RecursiveTransport.phases_spend_later _ (RecursiveTransport.phases_spendAll_later _ consumed))]
      have eqCtx : stripSpent freshOwner ((.ordinary (.barrier true) :: first.context) ++ left) =
          stripSpent freshOwner ((.ordinary (.barrier true) :: second.context) ++ right) := by
        change .ordinary (.barrier true) :: stripSpent freshOwner (first.context ++ left) =
          .ordinary (.barrier true) :: stripSpent freshOwner (second.context ++ right)
        rw [stripSpent_append, stripSpent_append, related.contexts, same]
      rw [ihSaved eqCtx consumed]

private theorem DeepMetaSpent.checked (related : DeepMetaSpent freshOwner first second)
    (same : stripSpent freshOwner left = stripSpent freshOwner right)
    (consumed : phases freshOwner = .consumed)
    (checked : first.check left phases budget = true) : second.check right phases budget = true := by
  simpa only [CleanupHints.Metadata.check, related.evaluates same consumed] using checked
private theorem DeepSpentHistory.metadata {metadata : CleanupHints.Metadata firstScope}
    {firstHints : ReturnHints firstScope} {first : Context firstHints} (related : DeepSpentHistory freshOwner first second) (found : first.closing? = some metadata) :
    ∃ next, second.closing? = some next ∧ DeepMetaSpent freshOwner metadata next := by
  induction related with
  | same context => exact ⟨metadata, found, .same _⟩
  | add related ih =>
      obtain ⟨next, nextFound, nextRelated⟩ := ih found
      exact ⟨.spent (owner := freshOwner) next, by simp only [Context.closing?, nextFound, Option.map_some], .add nextRelated⟩
  | plain rows related ih | handler rows related ih | cell related ih
  | cleanup rows related ih | retiring related ih | spent related ih =>
      simp only [Context.closing?] at found ⊢
      obtain ⟨actual, previous, equality⟩ := Option.map_eq_some_iff.mp found
      subst metadata
      obtain ⟨next, nextFound, nextRelated⟩ := ih previous
      simp only [nextFound, Option.map_some]
      refine ⟨_, rfl, ?_⟩
      first | exact .plain nextRelated | exact .handler nextRelated | exact .cell nextRelated
            | exact .cleanup nextRelated | exact .retiring nextRelated | exact .spent nextRelated
  | normal related ih | unwinding related ih | closing related ih => cases found
  | @live oldSavedScope oldSavedHints oldSaved nextSavedScope nextSavedHints nextSaved
      firstScope firstHints first secondScope secondHints second owner resumeDemand saved related ihSaved ih =>
      cases savedFound : oldSaved.closing? with
      | none => simp [Context.closing?, savedFound] at found
      | some savedMetadata =>
          cases previous : first.closing? with
          | none => simp [Context.closing?, savedFound, previous] at found
          | some actual =>
              simp [Context.closing?, savedFound, previous] at found
              subst metadata
              obtain ⟨newSaved, newSavedFound, newSavedRelated⟩ := ihSaved savedFound
              obtain ⟨next, nextFound, nextRelated⟩ := ih previous
              exact ⟨.live newSaved next, by simp [Context.closing?, newSavedFound, nextFound],
                .live newSavedRelated nextRelated⟩
theorem DeepSpentHistory.requestBudget (related : DeepSpentHistory freshOwner first second)
    (checked : RequestBudget budget phases effect operation first)
    (consumed : phases freshOwner = .consumed) :
    RequestBudget budget phases effect operation second := by
  have selected := related.selected effect operation
  unfold RequestBudget at checked ⊢
  generalize select effect operation first = left at selected checked
  generalize select effect operation second = right at selected ⊢
  cases selected with
  | none | builtin => trivial
  | handler capture tail =>
      intro consuming
      obtain ⟨metadata, found, normal, protectedCheck⟩ := checked consuming
      obtain ⟨next, nextFound, nextRelated⟩ := capture.metadata found
      refine ⟨next, nextFound, nextRelated.checked tail.contexts consumed normal, nextRelated.checked ?_ consumed protectedCheck⟩
      change .ordinary (.barrier true) :: stripSpent freshOwner _ = .ordinary (.barrier true) :: stripSpent freshOwner _
      rw [tail.contexts]


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.requestBudget

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyOwners (PendingWithin owners)

theorem DeepSpentHistory.owners
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepSpentHistory freshOwner first second) : owners firstScope = owners secondScope := by
  induction related <;> simp_all [SourceDependencyOwners.owners]

theorem DeepSpentHistory.pending_owners
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepSpentHistory freshOwner first second)
    (bounded : PendingWithin world available firstScope) : PendingWithin world available secondScope := by
  induction related with
  | same => exact bounded
  | add related ih => exact .spent (ih bounded)
  | plain rows related ih => cases bounded with | plain code tail => exact .plain code (ih tail)
  | handler rows related ih => cases bounded with | handler tail => exact .handler (ih tail)
  | cell related ih => cases bounded with | cell tail => exact .cell (ih tail)
  | cleanup rows related ih => cases bounded with | cleanup tail => exact .cleanup (ih tail)
  | normal related ih | unwinding related ih | closing related ih | retiring related ih =>
    cases bounded with | running tail => exact .running (ih tail)
  | live saved tail ihSaved ihTail => cases bounded with
    | live inside outside => exact .live (ihSaved inside) (ihTail outside)
  | spent related ih => cases bounded with | spent tail => exact .spent (ih tail)

theorem DeepSpentHistory.ticketNames_subset
    (related : DeepSpentHistory freshOwner first second) : first.ticketNames ⊆ second.ticketNames := by
  induction related with
  | same => exact List.Subset.refl _
  | add related ih => exact fun _ member => List.mem_cons_of_mem _ (ih member)
  | plain rows related ih | cell related ih | cleanup rows related ih | normal related ih
  | unwinding related ih | closing related ih => exact ih
  | handler rows related ih => exact ih
  | retiring related ih | spent related ih => exact List.cons_subset_cons _ ih
  | live saved tail ihSaved ihTail => exact List.cons_subset_cons _ (List.append_subset.mpr
      ⟨fun _ member => List.mem_append_left _ (ihSaved member),
       fun _ member => List.mem_append_right _ (ihTail member)⟩)

theorem DeepSpentHistory.eq_of_absent
    (related : DeepSpentHistory freshOwner first second) (absent : freshOwner ∉ second.ticketNames) :
    first.pack = second.pack := by
  induction related with
  | same => rfl
  | add related ih => exact False.elim (absent List.mem_cons_self)
  | plain rows related ih | handler rows related ih | cell related ih | cleanup rows related ih
  | normal related ih | unwinding related ih | closing related ih =>
    have same := ih absent
    cases same
    rfl
  | retiring related ih | spent related ih =>
    have same := ih (fun member => absent (List.mem_cons_of_mem _ member))
    cases same
    rfl
  | live saved tail ihSaved ihTail =>
    have savedEq := ihSaved (fun member => absent (List.mem_cons_of_mem _ (List.mem_append_left _ member)))
    have tailEq := ihTail (fun member => absent (List.mem_cons_of_mem _ (List.mem_append_right _ member)))
    cases savedEq
    cases tailEq
    rfl

theorem DeepSpentHistory.resume_shape
    (related : DeepSpentHistory freshOwner front nextFront) (shape : ResumeShape mode front = true) :
    ResumeShape mode nextFront = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
    obtain ⟨metadata, found⟩ := ResumeShape.unwind_iff.mp shape
    obtain ⟨next, nextFound, _⟩ := related.metadata found
    exact ResumeShape.unwind_iff.mpr ⟨next, nextFound⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.owners
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.pending_owners
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.ticketNames_subset
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.eq_of_absent
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.resume_shape

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport
open SourceDependencyChecks.Lexical (ReturnHints)
private theorem deep_spent_nil_backward (changed : DeepSpentHistory freshOwner first Context.nil) :
    first.pack = Context.nil.pack := by
  cases changed with | same => rfl

/-- Spent-marker insertion does not create a terminal handler. The reverse direction
is valid even when insertion extends the old handler's tail. -/
theorem DeepSpentHistory.terminal_backward
    (changed : DeepSpentHistory freshOwner first second)
    (terminal : TerminalHandler effect activation rows second) :
    TerminalHandler effect activation rows first := by
  induction changed with
  | same context => exact terminal
  | add changed ih => cases terminal with | spent found => exact ih found
  | plain waiting changed ih => cases terminal with | plain found => exact .plain (ih found)
  | handler declarations changed ih => cases terminal with
    | here =>
        have same := deep_spent_nil_backward changed
        cases same
        exact .here
    | handler found => exact .handler (ih found)
  | cell changed ih => cases terminal with | cell found => exact .cell (ih found)
  | cleanup callback changed ih => cases terminal with | cleanup found => exact .cleanup (ih found)
  | normal changed ih => cases terminal with | normal found => exact .normal (ih found)
  | unwinding changed ih => cases terminal with | unwinding found => exact .unwinding (ih found)
  | closing changed ih => cases terminal with | closing found => exact .closing (ih found)
  | retiring changed ih => cases terminal with | retiring found => exact .retiring (ih found)
  | live saved changed ihSaved ih => cases terminal with | live found => exact .live (ih found)
  | spent changed ih => cases terminal with | spent found => exact .spent (ih found)


theorem DeepSpentHistory.terminal_at_cut
    (changed : DeepSpentHistory freshOwner captured nextCaptured)
    (terminal : TerminalHandler effect activation declarationRows captured)
    (nextCut : Cut effect operation nextWhole nextCaptured nextTail contract modes) :
    TerminalHandler effect activation declarationRows nextCaptured := by
  obtain ⟨nextActivation, families, declarations, rows, actual⟩ := nextCut.terminal_handler
  have previous := changed.terminal_backward actual
  obtain ⟨_, activationEq, familiesEq, declarationsEq, rowsEq⟩ := terminal.unique previous
  cases activationEq
  cases familiesEq
  cases declarationsEq
  cases rowsEq
  exact actual

theorem DeepSpentHistory.selected_at_cut {held : Bool}
    (changed : DeepSpentHistory freshOwner captured nextCaptured)
    (selected : CapturedClauseRows effect operation held captured bodyRows)
    (nextCut : Cut effect operation nextWhole nextCaptured nextTail contract modes) :
    CapturedClauseRows effect operation held nextCaptured bodyRows := by
  cases selected with
  | selected terminal chosen => exact .selected (changed.terminal_at_cut terminal nextCut) chosen

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.terminal_backward
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.terminal_at_cut
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport.DeepSpentHistory.selected_at_cut

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open SourceDependencyChecks.Lexical (ReturnHints)
open DeepSpentTransport
open OwnerPhaseTransitions (spend)


theorem Code.deep_history
    (checked : Code outward actions budget phases world installations rows context)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : DeepSpentHistory freshOwner context next) (consumed : phases freshOwner = .consumed) :
    Code outward actions budget phases world installations rows next := by
  refine (Code.rec
    (motive_1 := fun actions budget phases world installations {dependencies checking} rows {scope hints} context _ =>
      ∀ {nextScope} {nextHints : ReturnHints nextScope} (next : Context nextHints),
      DeepSpentHistory freshOwner context next → phases freshOwner = .consumed →
        Code outward actions budget phases world installations rows next)
    (motive_2 := fun actions budget phases world installations {scope outsideScope hints external} context outside before after _ =>
      ∀ {nextScope nextOutside} {nextHints : ReturnHints nextScope} {nextExternal : ReturnHints nextOutside}
        (next : Context nextHints) (nextOutside : Context nextExternal),
      DeepSpentHistory freshOwner context next → DeepSpentHistory freshOwner outside nextOutside →
      phases freshOwner = .consumed →
        Pending outward actions budget phases world installations next nextOutside before after)
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    (t := checked)) next changed consumed
  · intros; exact .pure
  · intros
    rename_i found nextScope nextHints next changed consumed
    exact .builtin (changed.builtin found)
  · intros
    rename_i cut guarded callbacks ownerBound cleanupBudget family bodies bodyRows declarations declarationRows
      selected terminal requiredRights retained body
      ihCallbacks ihRetained ihBody nextScope nextHints next changed consumed
    obtain ⟨_, _, nextCapturedHints, nextTailHints, nextCaptured, nextTail, nextCut, inside, outside⟩ := changed.cut cut
    apply Code.request nextCut
    · cases guarded with
      | builtin found => cases Option.some.inj (cut.select_sound.symm.trans found)
      | handler found permission row modeBody =>
        cases Option.some.inj (cut.select_sound.symm.trans found)
        exact .handler nextCut.select_sound (inside.held ▸ permission)
          (inside.held ▸ row) (inside.held ▸ modeBody)
    · intro disposing
      exact ihCallbacks disposing nextCaptured (.closing nextTail) inside (.closing outside) consumed
    · intro disposing
      have bounded := inside.pending_owners (ownerBound disposing)
      rw [inside.owners] at bounded
      exact bounded
    · exact changed.requestBudget cleanupBudget consumed
    · simpa only [← inside.held] using inside.selected_at_cut selected nextCut
    · exact inside.terminal_at_cut terminal nextCut
    · exact requiredRights
    · have moved := ihRetained next .nil changed (.same _) consumed
      rw [changed.return_mode] at moved
      exact moved
    · intro owner resumeDemand fresh absent
      have oldAbsent := fun member => absent (changed.ticketNames_subset member)
      have names := congrArg (fun packed : Packed => packed.context.ticketNames) nextCut.decomposition
      change next.ticketNames = (nextCaptured.append nextTail).ticketNames at names
      rw [Context.append_ticketNames] at names
