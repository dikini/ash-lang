/-- Construct the actual clause-entry site from the selected declaration and
the same captured source split. All current and pending certificates originate
in the predecessor; the result contains no independently supplied successor. -/
theorem InstallationSupport.checked_capture_clause
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    {family : Nat → SourceDependencyAnnotations.Dependencies}
    {bodies : ∀ owner, Signature (family owner)} {bodyRows : ∀ owner, Rows (bodies owner)}
    {declarations : SourcePlanSignatures.ClauseSignatures declarationFamilies}
    {declarationRows : ClauseRows declarations}
    (split : CaptureSourceAt site captured tail)
    (selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
    (terminal : TerminalHandler effect activation declarationRows captured)
    (requiredRights : SourceAdmission.rightsAt operation declarations = some rights)
    (expression : site.expression = .perform (Instantiation.freezeEffect effect) operation operand)
    (cut : Cut effect operation site.context captured tail contract modes)
    (fresh : actions owner = none) (absent : owner ∉ site.context.ticketNames) :
    CodeChecked ambient outward
      (split.compile_clause_from_request selected terminal requiredRights expression cut fresh absent) := by
  obtain ⟨requested, argument, known, effectEq, _rows, request, requestChecked⟩ :=
    checked_request_origin site.current.previous.authenticated expression site.currentResource
  have realization : Instantiation.EffectRealizes Instantiation.Environment.empty
      (Instantiation.freezeEffect effect) requested := by
    rw [effectEq]
    exact Instantiation.frozen_effect_realizes _ _
  have same := Instantiation.frozen_effect_cannot_change realization
  subst requested
  exact requestChecked.capture_body_with_rights cut selected terminal requiredRights fresh absent split.savedDemand


theorem CaptureSourceAt.successor_site
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    {family : Nat → Dependencies} {bodies : ∀ owner, Signature (family owner)}
    {bodyRows : ∀ owner, Rows (bodies owner)}
    (split : CaptureSourceAt site captured tail)
    (selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
    (expression : site.expression = .perform (Instantiation.freezeEffect effect) operation operand)
    (closed : ClosedValue operand)
    (owner : Nat) (fresh : contracts owner = none)
    (cut : Cut effect operation site.context captured tail selectedContract modes)
    (freshActions : actions owner = none) (absent : owner ∉ site.context.ticketNames)
    (resumeRow : Footprint) (closeRow : Option Footprint) :
    ∃ frontStack : Stack, ∃ handler : HandlerData, ∃ answer residual parameter binder code offered row,
    ∃ answerRows : ValueRows answer, ∃ resumeEffects closeEffects,
    let allocated : Contract :=
      ⟨site.result, answer, captureScope.held, split.savedDemand, resumeRow,
        split.savedDemand, closeRow, resumeEffects, closeEffects⟩
    ∃ next : ExecutionSite ambient operations policy (contracts.insert owner allocated) tables families required outward
      (actions.insert owner code.requiredActions) (OwnerPhaseTransitions.introduce phases owner) world installations
      ((⟨owner, .resume⟩, ⟨split.savedDemand, split.savedRequirements⟩) :: resumes)
      budget ports (owners.insert owner site.resultRows answerRows) emptyRows output outputRows,
      split.capturedStack = frontStack.append (.push (.handler handler) .nil) ∧
      handler.effectInst = effect ∧
      ModeRowsValue.Answer answerRows split.boundaryRows ∧
      ClauseAt operation handler.clauses parameter binder code ∧
      ClosedExcept parameter code ∧
      lookup operation (tables handler) = some offered ∧ offered.row captureScope.held = some row ∧
      (code.requiredActions.resume = true → resumeEffects = residual) ∧
      (code.requiredActions.dispose = true → closeEffects = residual) ∧
      next.expression = code.subst parameter operand ∧ next.runtimeScope = .ticket binder owner ∧
      next.stack = .live owner (ScopedPorts.embedPort site.result.erase.erase.port) handler.answer
        split.capturedStack handler.scope split.tailStack ∧
      next.result = answer ∧ next.allowed = residual ∧
      next.context.pack = (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail).pack ∧
      next.dependencies = family owner ∧
      HEq (SourcePlanSignatures.signature next.plan) (bodies owner) ∧
      HEq next.rows (bodyRows owner) := by
  obtain ⟨frontStack, handler, answer, residual, parameter, binder, code, offered, row,
    answerRows, nextFamily, plans, selectedRows, resumeEffects, closeEffects,
    declarationPlans, declarationRows, declarations,
    stackEq, effectEq, answerAnnotation, answerMode, callerScope, certified, located, ready, found, offeredRow,
    _selectedActual, rowsSame, _declarationsAuth, _terminal, _requiredRights, certificate,
    resumeInterface, closeInterface, source, bodyAuth⟩ :=
    split.selected_body selected expression closed owner fresh cut freshActions absent resumeRow closeRow
  let allocated : Contract :=
    ⟨site.result, answer, captureScope.held, split.savedDemand, resumeRow,
      split.savedDemand, closeRow, resumeEffects, closeEffects⟩
  have freshOwned : owner ∉ ownedTickets site.stack := by
    intro member
    exact absent (site.context.owned_subset_ticketNames
      (site.coherent.forget.source.owned_permutation.mem_iff.mpr member))
  obtain ⟨nextPending, nextCoherent⟩ :=
    split.capture_live (rights := code.requiredActions) fresh freshActions freshOwned answerRows
      answerMode answerAnnotation callerScope resumeRow split.savedDemand closeRow resumeEffects closeEffects
  have retained : SourceAdmission.Pending outward (actions.insert owner code.requiredActions) budget
      (OwnerPhaseTransitions.introduce phases owner) world installations
      (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail)
      .nil .ordinary output.mode := by
    exact split.pending_live (rights := code.requiredActions) cut freshActions absent
  have known : (contracts.insert owner allocated).erase.erase.ports owner = some allocated.erase.erase.ports := by
    simp [CoherentSourceTypes.Owners.Contracts.ports, SourceDependencyAnnotations.Contracts.erase,
      SourcePlannedTyping.Contracts.erase, SourcePlannedTyping.Contracts.insert]
  cases bodyAuth with
  | typed authenticated =>
    rename_i bodyDemand bodyRequirements _ _ bodySource
    let next : ExecutionSite ambient operations policy (contracts.insert owner allocated) tables families required outward
        (actions.insert owner code.requiredActions) (OwnerPhaseTransitions.introduce phases owner) world installations
        ((⟨owner, .resume⟩, ⟨split.savedDemand, split.savedRequirements⟩) :: resumes)
        budget ports (owners.insert owner site.resultRows answerRows) emptyRows output outputRows :=
      { expression := code.subst parameter operand, runtimeScope := .ticket binder owner,
        stack := .live owner (ScopedPorts.embedPort site.result.erase.erase.port) handler.answer
          split.capturedStack handler.scope split.tailStack,
        result := answer, resultRows := answerRows, allowed := residual,
        dependencies := nextFamily owner, plan := plans owner, rows := selectedRows owner,
        sourceDemand := bodyDemand, sourceRequirements := bodyRequirements,
        receiving := .live owner captureScope tailScope,
        hints := .live (owner := owner) captureHints tailHints,
        context := Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail,
        current := SourceAdmission.Admitted.of_source bodySource authenticated certificate nextCoherent.forget.source,
        certified := certified, scopeTyped := ⟨_, .bound known⟩,
        pendingDemand := split.tailDemand,
        pendingRequirements := .sequence (.spent owner) split.tailRequirements,
        pending := nextPending, coherent := nextCoherent, retained := retained,
        currentResource := checked_capture_clause split _selectedActual _terminal _requiredRights expression cut freshActions absent,
        retainedResource := capture_pending_live (rights := code.requiredActions) split site.retainedResource cut freshActions absent }
    refine ⟨frontStack, handler, answer, residual, parameter, binder, code, offered, row,
      answerRows, resumeEffects, closeEffects, next,
      stackEq, effectEq, answerMode, located, ready, found, offeredRow, resumeInterface, closeInterface,
      rfl, rfl, rfl, rfl, rfl, rfl, ?_⟩
    obtain ⟨familySame, bodiesSame, _⟩ := selected.unique _selectedActual
    cases familySame
    cases eq_of_heq bodiesSame
    exact ⟨rfl, HEq.rfl, HEq.symm (heq_of_eq (congrFun (eq_of_heq rowsSame) owner))⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CaptureSourceAt.successor_site

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)

theorem Run.capture_reindex
    {first : Signature firstDependencies} {second : Signature secondDependencies}
    {firstRows : Rows first} {secondRows : Rows second}
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {firstContext : Context firstHints} {secondContext : Context secondHints}
    (run : Run world installations secondRows secondContext root)
    (dependencies : firstDependencies = secondDependencies)
    (signatures : HEq first second) (rows : HEq firstRows secondRows)
    (context : firstContext.pack = secondContext.pack) :
    Run world installations firstRows firstContext root := by
  cases dependencies
  cases eq_of_heq signatures
  cases eq_of_heq rows
  change Run world installations firstRows firstContext.pack.context root
  rw [context]
  exact run

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourcePlannedTyping (Contract)
open SourcePlanSignatures (Signature)
open SourceDependencyAnnotations (Dependencies)
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (available introduce)

/-- Construct the actual clause-entry site from the selected declaration and
the same captured source split. All current and pending certificates originate
in the predecessor; the result contains no independently supplied successor. -/
theorem CaptureSourceAt.successor_root
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    {family : Nat → Dependencies} {bodies : ∀ owner, Signature (family owner)}
    {bodyRows : ∀ owner, Rows (bodies owner)}
    (split : CaptureSourceAt site captured tail)
    (selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
    (expression : site.expression = .perform (Instantiation.freezeEffect effect) operation operand)
    (closed : ClosedValue operand)
    (owner : Nat) (fresh : contracts owner = none)
    (cut : Cut effect operation site.context captured tail selectedContract modes)
    (freshActions : actions owner = none) (absent : owner ∉ site.context.ticketNames)
    (resumeRow : Footprint) (closeRow : Option Footprint)
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (phaseAgreement : phases = available site.context.owned)
    (unique : site.context.owned.Nodup)
    (checked : Checked store receiving phases (annotateDisposals root) budgetRow) :
    ∃ frontStack : Stack, ∃ handler : HandlerData, ∃ answer residual parameter binder code offered row,
    ∃ answerRows : ValueRows answer, ∃ resumeEffects closeEffects,
    let allocated : Contract :=
      ⟨site.result, answer, captureScope.held, split.savedDemand, resumeRow,
        split.savedDemand, closeRow, resumeEffects, closeEffects⟩
    ∃ next : ExecutionSite ambient operations policy (contracts.insert owner allocated) tables families required outward
      (actions.insert owner code.requiredActions) (OwnerPhaseTransitions.introduce phases owner) world installations
      ((⟨owner, .resume⟩, ⟨split.savedDemand, split.savedRequirements⟩) :: resumes)
      budget ports (owners.insert owner site.resultRows answerRows) emptyRows output outputRows,
      split.capturedStack = frontStack.append (.push (.handler handler) .nil) ∧
      handler.effectInst = effect ∧
      ModeRowsValue.Answer answerRows split.boundaryRows ∧
      ClauseAt operation handler.clauses parameter binder code ∧
      ClosedExcept parameter code ∧
      lookup operation (tables handler) = some offered ∧ offered.row captureScope.held = some row ∧
      (code.requiredActions.resume = true → resumeEffects = residual) ∧
      (code.requiredActions.dispose = true → closeEffects = residual) ∧
      next.expression = code.subst parameter operand ∧ next.runtimeScope = .ticket binder owner ∧
      next.stack = .live owner (ScopedPorts.embedPort site.result.erase.erase.port) handler.answer
        split.capturedStack handler.scope split.tailStack ∧
      next.result = answer ∧ next.allowed = residual ∧
      next.context.pack = (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail).pack ∧
      next.dependencies = family owner ∧
      HEq (SourcePlanSignatures.signature next.plan) (bodies owner) ∧
      HEq next.rows (bodyRows owner) ∧
      ∃ nextDemand, ∃ nextRoot : Requirements nextDemand,
        ExecutionRoot operations policy (contracts.insert owner allocated) tables families required outward
          (actions.insert owner code.requiredActions) (introduce phases owner) world installations
          ((⟨owner, .resume⟩, ⟨split.savedDemand, split.savedRequirements⟩) :: resumes)
          budget ports (owners.insert owner site.resultRows answerRows) emptyRows output outputRows next nextRoot ∧
        Checked nextStore nextReceiving (introduce phases owner) (annotateDisposals nextRoot) budgetRow ∧
        nextDemand.Perm (owner :: demand) := by
  obtain ⟨frontStack, handler, answer, residual, parameter, binder, code, offered, row,
    answerRows, resumeEffects, closeEffects, next,
    stackEq, effectEq, answerMode, located, ready, found, offeredRow, resumeInterface, closeInterface,
    expressionEq, runtimeScopeEq, nextStackEq, resultEq, allowedEq, contextEq,
    dependenciesEq, signatureEq, rowsEq⟩ :=
    split.successor_site selected expression closed owner fresh cut freshActions absent resumeRow closeRow
  obtain ⟨nextDemand, nextRoot, interpreted, nextChecked, demandEq⟩ :=
    ExecutionSite.request_checked_body (nextStore := nextStore) (nextReceiving := nextReceiving)
      rooted expression closed.1 cut selected owner split.savedDemand absent unique (phaseAgreement ▸ checked)
  have ownedEq : site.context.owned = captured.owned ++ tail.owned := by
    have same := congrArg (fun packed : Packed => packed.context.owned) cut.decomposition
    exact same.trans (Context.append_owned captured tail)
  have nextPhase : available (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail).owned =
      introduce phases owner := by
    calc
      _ = introduce (available (captured.owned ++ tail.owned)) owner := by
        funext other
        by_cases same : other = owner <;>
          simp [available, introduce, Context.owned, same, or_comm]
      _ = introduce phases owner := congrArg (fun p => introduce p owner)
        (phaseAgreement.trans (congrArg available ownedEq)).symm
  rw [nextPhase] at nextChecked
  have actualRun : Accounting.Run world installations next.rows next.context nextRoot := by
    apply Accounting.Run.capture_reindex interpreted dependenciesEq signatureEq rowsEq contextEq
  exact ⟨frontStack, handler, answer, residual, parameter, binder, code, offered, row,
    answerRows, resumeEffects, closeEffects, next,
    stackEq, effectEq, answerMode, located, ready, found, offeredRow, resumeInterface, closeInterface,
    expressionEq, runtimeScopeEq, nextStackEq, resultEq, allowedEq, contextEq,
    dependenciesEq, signatureEq, rowsEq, nextDemand, nextRoot, .contextual actualRun, nextChecked, demandEq⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
