/-- Compilation preserves the pending source's actual return mode. -/
theorem Pending.return_mode
    {hints : ReturnHints scope} {external : ReturnHints externalScope}
    {context : Context hints} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside before after) :
    hints.returnMode before = after :=
  checked.compile.1.return_mode

/-- An unprotected captured source retains its ordinary return mode. -/
theorem Pending.ordinary_of_unprotected
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Pending outward actions budget phases world installations context outside .ordinary middle)
    (unprotected : scope.held = false) : middle = .ordinary :=
  checked.return_mode.symm.trans
    (SourceDependencyNeutral.Lexical.Recursive.return_mode_unprotected hints unprotected .ordinary)

/-- Derive own-discard source evidence from the actual request, retained source
and lexical cut. The fresh owner's spent marker is transported structurally;
no successor source check or unproved transport law is assumed. -/
theorem Code.own_discard_at_cut
    {resumeDemand : List Nat}
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (request : Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole)
    (retained : Pending outward actions budget phases world installations whole .nil .ordinary finalMode)
    (cut : Cut effect operation whole captured tail contract modes)
    (fresh : actions owner = none) (consumed : phases owner = .consumed)
    (permission : rights.dispose = true) (disposing : contract.dispose = true) :
    Code outward (actions.insert owner rights) budget (introduce phases owner) world installations
      (Rows.invoke (key := ⟨owner, .dispose⟩)) (.live (owner := owner) (resumeDemand := resumeDemand) captured tail) := by
  have unprotected := request.compile.1.request_guard.disposing_unprotected cut.select_sound disposing
  obtain ⟨middle, saved, waiting⟩ := retained.at_cut cut
  have middleSame := saved.ordinary_of_unprotected unprotected
  cases middleSame
  have callbacks := request.callbacks_at_cut cut disposing
  have extension := Syntax.fresh_usage_insert_extends (rights := rights) fresh
  have abandoned := (callbacks.permissions extension).outside_history (.closing (.add (.same _))) consumed
  have nextWaiting := waiting.permissions extension
  have mode : (ReturnHints.live (owner := owner) captureHints tailHints).returnMode .ordinary = finalMode := by
    simp only [ReturnHints.returnMode, saved.return_mode]
    exact waiting.return_mode
  have phaseSame := OwnerCaptureContracts.spend_introduced (owner := owner) consumed
  apply Code.dispose (front := .nil) .hit
    (by simp [Syntax.UsageTickets.insert]) permission (by simp [introduce]) unprotected
  · simpa only [phaseSame, Context.append, ReturnHints.append, SourceDependencyCapture.Scope.append] using abandoned
  · change Pending outward (actions.insert owner rights) budget (spend (introduce phases owner) owner)
      world installations (.spent (owner := owner) tail) .nil .ordinary
      ((ReturnHints.live (owner := owner) captureHints tailHints).returnMode .ordinary)
    rw [phaseSame, mode]
    exact .spent nextWaiting

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
