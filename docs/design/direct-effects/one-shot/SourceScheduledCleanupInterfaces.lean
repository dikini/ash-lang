theorem ResumeShape.deep (related : DeepPureHistory first second)
    (checked : ResumeShape mode first = true) : ResumeShape mode second = true := by
  cases mode
  · rfl
  · obtain ⟨metadata, found⟩ := ResumeShape.unwind_iff.mp checked
    exact ResumeShape.unwind_iff.mpr (related.closing_exists found)

theorem TerminalHandler.deep_at_cut
    (terminal : TerminalHandler effect activation declarations captured)
    (changed : DeepPureHistory captured nextCaptured)
    (nextCut : Cut effect operation nextWhole nextCaptured nextTail contract modes) :
    TerminalHandler effect activation declarations nextCaptured := by
  obtain ⟨nextActivation, families, signatures, rows, nextTerminal⟩ := nextCut.terminal_handler
  have previous := nextTerminal.deep_backward changed
  obtain ⟨_, activationSame, familiesSame, declarationsSame, rowsSame⟩ := terminal.unique previous
  cases familiesSame
  cases declarationsSame
  cases rowsSame
  cases activationSame
  exact nextTerminal

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

