    ∃ action : ActionData,
      action.identity = identity ∧ action.action = callback ∧ action.scope = runtimeScope ∧
      JoinedState operations policy contracts tables families required outward annotations world ambient history
        resumes disposals annotatedStore budget output
        ⟨⟨.eval ⟨body, runtimeScope, .push (.armed action) stack⟩,
          issued ++ [Owner.cleanup identity], completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    obtain ⟨ticket, typed⟩ := scopeTyped
    obtain ⟨action, bodyDemand, bodyRequirements, nextRequirements, bodyDependencies,
      callbackDependencies, bodyPlan, nextAnnotated, nextRow, identitySame, actionSame,
      scopeSame, demandSame, nextSource, nextCertified, nextPending, nextAnnotation,
      rawPath, generatedPath, nextChecked, included, nextLocal, nextRetained,
      nextMatching, nextBound, nextResumes, nextDisposals, raw, transition,
      owners, nextUse, nextTickets, nextResources⟩ :=
      register_cleanup_planned_generated current pending typed isValue identity certified localCheck retained
        matching bound annotation checked state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨.cleanup callback body, runtimeScope, stack⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨body, runtimeScope, .push (.armed action) stack⟩,
          issued ++ [Owner.cleanup identity], completed⟩, actions⟩ := by
      simpa only [List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨.cleanup callback body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
          transition fresh)
    refine ⟨action, identitySame, actionSame, scopeSame, ?_⟩
    refine ⟨?_, (fun key stored member => nextResumes key stored (state.resumeRecords key stored member)),
      (fun key stored member => nextDisposals key stored (state.unwindRecords key stored member)),
      state.storeAnnotation, event.preserves state.lifetime, nextTickets, nextResources,
      state.activations, ?_⟩
    · apply JoinedSource.eval nextSource nextCertified ⟨ticket, typed⟩ nextPending nextLocal nextRetained
        nextMatching nextBound ?_ nextAnnotation nextChecked (included.trans bounded)
      simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
        Bool.true_and] using finite
    · simpa only [ScopedTyping.resourceWorld, List.filterMap_append, List.filterMap_cons,
        List.filterMap_nil, List.append_nil] using state.issuedResources
