namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.SourceSupport
open ScopedExpressions ScopedExecution
open SourcePlannedTyping (Operations Contracts Value Environment)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements)

/-- A finite result observer is independent of the resource world needed to
execute the expression. In particular, a resource body may use its new cell
while its returned value is bounded by the earlier world. This is a sufficient
source annotation; an unresolved result requires a stronger callable/clause
contract rather than treating unknown support as empty. -/
structure Returns
    (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (world : List Nat) (allowed : List Instance) (scope : Execution.Scope)
    (environment : Environment) (supportEnvironment : ResultSummaries.Environment)
    (resultWorld : List Nat) (code : Code) (value : Value)
    (demand : List Nat) (requirements : Requirements demand)
    {dependencies : SourceDependencyAnnotations.Dependencies}
    (checking : Signature dependencies) : Prop where
  source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
    code value demand requirements checking
  result : TemplateSupport.check supportEnvironment resultWorld code = true

/-- A source resource check is made on the unopened template, once. Fresh
opening constructs the rich body and its old-world result bound together. No
assumption about the resources retained by a future runtime value is used. -/
theorem resource_result_entry
    (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (.resource binder initializer body) output demand requirements checking)
    (resultChecked : TemplateSupport.check supportEnvironment world body = true)
    (fresh : identity ∉ world) :
    ∃ residual bodyDemand, ∃ (bodyRequirements : Requirements bodyDemand),
    ∃ (bodyDependencies : SourceDependencyAnnotations.Dependencies),
    ∃ (bodyChecking : Signature bodyDependencies),
      Returns operations policy contracts (world ++ [identity]) (.cell identity :: residual) scope environment
        supportEnvironment world (body.instantiate (Instantiation.Environment.empty.bind binder identity))
        output bodyDemand bodyRequirements bodyChecking := by
  cases source with
  | resource initial opened formed effectsBound admitted hidden =>
      exact ⟨_, _, _, _, _, opened identity fresh,
        (TemplateSupport.check_fresh_opening body fresh).trans resultChecked⟩

/-- Rich substitution and the already proved finite template substitution
share the same closed replacement. The ordinary binding check examines actual
closure storage; it does not approximate that storage by a function port. -/
theorem resource_result_substitution
    (source : SourcePlannedSources.Expression operations policy contracts world allowed scope
      (environment.extend name input) (.resource binder (.integer payload) body)
      output demand requirements checking)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports scope ticket)
    (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input)
    (closed : ClosedValue value)
    (resultChecked : TemplateSupport.check supportEnvironment world body = true)
    (bindingChecked : DeclaredReturnAdmission.checkBinding supportEnvironment name value = true) :
    SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (.resource binder (.integer payload) (body.subst name value)) output demand requirements checking ∧
    TemplateSupport.check supportEnvironment world (body.subst name value) = true := by
  have resourceClosed := ScopedPorts.typed_resource_closed
    (SourceTemplates.expression_ports (DeclaredSources.expression_erase
      (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase source))) scopeTyped)
  exact ⟨SourcePlannedSources.substitution source replacement closed,
    TemplateSubstitution.checked_replacements_preserve_check resultChecked resourceClosed
      (.cons closed ((DeclaredReturnAdmission.check_binding_iff closed).mp bindingChecked) .nil)⟩

/-- An actual return discharges the local release obligation from the retained
source result annotation. No exclusion premise is required for the value. -/
theorem Returns.value_excludes
    (checked : Returns operations policy contracts world allowed scope environment supportEnvironment
      resultWorld value output demand requirements checking)
    (closed : ClosedValue value) (fresh : identity ∉ resultWorld) :
    identity ∉ Syntax.resourceDependencies value.dependencies := by
  obtain ⟨resources, known, included⟩ :=
    (TemplateSupport.source_bound_runtime_iff closed.2.1).mp
      (TemplateSupport.check_iff_source_bound.mp checked.result)
  rw [ResultSummaries.closed_value_storage_sound closed] at known
  cases known
  exact fun member => fresh (included member)

/-- The result check survives a strict bind contraction. This reuses the
existing symbolic substitution correspondence and does not inspect or limit a
replacement's latent function body. -/
theorem result_check_bind
    (checked : TemplateSupport.check supportEnvironment resultWorld (.bind name value body) = true)
    (closed : ClosedValue value) (bodyClosed : body.ResourceClosed) :
    TemplateSupport.check supportEnvironment resultWorld (body.subst name value) = true := by
  have wholeClosed : (Code.bind name value body).ResourceClosed :=
    List.append_eq_nil_iff.mpr ⟨closed.2.1, bodyClosed⟩
  obtain ⟨resources, known, included⟩ :=
    (TemplateSupport.source_bound_runtime_iff wholeClosed).mp
      (TemplateSupport.check_iff_source_bound.mp checked)
  apply TemplateSupport.check_iff_source_bound.mpr
  apply (TemplateSupport.source_bound_runtime_iff
    (Code.subst_resource_closed body value name bodyClosed closed.2.1)).mpr
  exact ⟨resources, (ResultSummaries.bind_summary_correspondence name body closed).storage.support.symm.trans known,
    included⟩

/-- The joint source/result annotation follows the actual rich bind reduct,
with its original requirement evaluation. Closedness of the suffix is derived
from source typing rather than supplied as a successor obligation. -/
theorem Returns.bind
    (checked : Returns operations policy contracts world allowed scope environment supportEnvironment
      resultWorld (.bind name value body) output demand requirements (.sequence initialChecking bodyChecking))
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports scope ticket)
    (closed : ClosedValue value) :
    ∃ reduced, Returns operations policy contracts world allowed scope environment supportEnvironment
      resultWorld (body.subst name value) output demand reduced bodyChecking ∧
      ∀ store receiving before, RecursiveRequirements.evaluate store receiving before reduced =
        RecursiveRequirements.evaluate store receiving before requirements := by
  have wholeClosed := ScopedPorts.typed_resource_closed
    (SourceTemplates.expression_ports (DeclaredSources.expression_erase
      (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase checked.source))) scopeTyped)
  obtain ⟨reduced, source, evaluation⟩ := SourcePlannedSources.bind_expression checked.source closed
  exact ⟨reduced, ⟨source, result_check_bind checked.result closed
    (List.append_eq_nil_iff.mp wholeClosed).2⟩, evaluation⟩

namespace ResultExamples
/-- The bound concerns the result: a local cell operation can precede an
integer return, even though the complete body's resource support is nonempty. -/
theorem cell_use_then_integer :
    TemplateSupport.check supportEnvironment world
      (.bind 0 (.perform (.cell (.bound 4)) 0 .unit) (.integer 17)) = true := rfl

/-- Arbitrary internal handler work remains admissible when its result is
ignored. This is also valid when that work contains callbacks or applications. -/
theorem ignored_work_then_integer (work : Code) :
    TemplateSupport.check supportEnvironment world (.bind name work (.integer 17)) = true := rfl

/-- A returned function may contain arbitrary closed internal handler work.
Its stored lexical resources, not its latent result port, determine this check. -/
theorem resource_free_handler_closure :
    TemplateSupport.check supportEnvironment world
      (.lambda 0 (.handle (.user 9 []) (.integer 17) .nil)) = true := rfl

/-- Existing outer resources can remain in a returned closure. -/
theorem outer_capture (member : retained ∈ world) :
    TemplateSupport.check supportEnvironment world
      (.lambda 0 (.bind 1 (.resourceRef (.activation retained)) (.integer 17))) = true := by
  simpa [TemplateSupport.check, TemplateSupport.infer, TemplateSupport.captured,
    TemplateSupport.atom, TemplateSupport.merge, TemplateDependencies.dependencies,
    TemplateDependencies.without, TemplateSupport.available] using member

/-- The same lexical check rejects capturing the cell whose scope is ending. -/
theorem local_capture_rejected :
    TemplateSupport.check supportEnvironment world
      (.lambda 0 (.bind 1 (.resourceRef (.bound 4)) (.integer 17))) = false := rfl
end ResultExamples
