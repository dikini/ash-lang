namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourcePlannedTyping (Value)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open SourcePlannedChecks (Certified)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Pending)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available)

/-- The common source evidence retains exact current and pending decorations.
Its phases and installation history are those of the actual machine. Current
and pending structural certificates share the exact authenticated rows and
receiving context in each constructor. The coherent pending source also retains
agreement with the actual resume store, including its ordinary saved view while
unwinding. The old forest and store checks remain explicit until their source
origins are discharged; this is not a complete initial-admission theorem. -/
inductive RetainedSource
    (operations : SourcePlannedTyping.Operations) (policy : Syntax.TicketPolicy)
    (contracts : SourcePlannedTyping.Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (actions : Syntax.UsageTickets)
    (annotations : Nat → Option SourceDependencyCapture.Scope)
    (world installations : List Nat) (resumes annotatedStore : Store) (budget : Footprint)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none))
    (output : PlannedModeValue) (outputRows : ModeRowsValue output) :
    LexicalUnwind.Machine → Prop where
  | eval {plan : Plan dependencies} {rows : Rows (signature plan)}
      {hints : ReturnHints receiving} {context : Context hints} {resultRows : ValueRows result}
      (current : Admitted operations policy contracts ports owners (fun _ => none) emptyRows
        world installations allowed outward runtimeScope actions (available (ownedTickets stack)) budget tables families
        context stack code result currentDemand currentRequirements (signature plan) resultRows rows)
      (certified : Certified (evidence := declarationPolicy) outward world plan)
      (scopeTyped : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
      (pending : PlannedModeSource operations policy contracts tables families required outward actions world
        stack (.value result) output pendingDemand pendingRequirements receiving)
      (coherent : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        pending (.value resultRows) outputRows context)
      (pendingBudget : PendingBudget budget (available (ownedTickets stack)) world installations context .nil .ordinary output.mode)
      (retained : Pending outward actions (available (ownedTickets stack)) world hints .nil .ordinary output.mode)
      (bound : Bound annotations receiving)
      (finite : SourceContextualRechecking.checkForest required stack receiving .nil = true)
      (annotation : RowAnnotation
        (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
      (checked : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
        (annotateDisposals annotated) row)
      (bounded : row ⊆ budget)
      (currentCertificate : SourceAdmission.Code outward actions budget (available (ownedTickets stack))
        world installations rows context)
      (pendingCertificate : SourceAdmission.Pending outward actions budget (available (ownedTickets stack))
        world installations context .nil .ordinary output.mode) :
      RetainedSource operations policy contracts tables families required outward actions annotations world installations resumes annotatedStore budget
        ports owners emptyRows output outputRows (.eval ⟨code, runtimeScope, stack⟩)
  | unwind {hints : ReturnHints receiving} {context : Context hints}
      (pending : PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind output demand requirements receiving)
      (coherent : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
        pending .unwind outputRows context)
      (pendingBudget : PendingBudget budget (available (ownedTickets stack)) world installations context .nil .unwind output.mode)
      (retained : Pending outward actions (available (ownedTickets stack)) world hints .nil .unwind output.mode)
      (bound : Bound annotations receiving)
      (finite : SourceContextualRechecking.checkForest required stack receiving .nil = true)
      (annotation : RowAnnotation requirements annotated)
      (checked : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
        (annotateDisposals annotated) row)
      (bounded : row ⊆ budget)
      (pendingCertificate : SourceAdmission.Pending outward actions budget (available (ownedTickets stack))
        world installations context .nil .unwind output.mode) :
      RetainedSource operations policy contracts tables families required outward actions annotations world installations resumes annotatedStore budget
        ports owners emptyRows output outputRows (.unwind runtimeScope stack)

theorem RetainedSource.joined
    (source : RetainedSource operations policy contracts tables families required outward actions annotations world installations
      resumes annotatedStore budget ports owners emptyRows output outputRows machine) :
    JoinedSource operations policy contracts tables families required outward actions annotations world annotatedStore budget output machine := by
  cases source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
      exact .eval current.source certified scopeTyped pending current.capabilities retained coherent.forget.source.matching
        bound finite annotation checked bounded
  | unwind pending coherent pendingBudget retained bound finite annotation checked bounded pendingCertificate =>
      exact .unwind pending retained coherent.forget.source.matching bound finite annotation checked bounded

/-- The common machine keeps the retained source judgment and the existing
ownership, store, resource and installation-history fields. -/
structure RetainedState
    (operations : SourcePlannedTyping.Operations) (policy : Syntax.TicketPolicy)
    (contracts : SourcePlannedTyping.Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (annotations : Nat → Option SourceDependencyCapture.Scope)
    (world ambient history : List Nat) (resumes disposals annotatedStore : Store) (budget : Footprint)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none))
    (output : PlannedModeValue) (outputRows : ModeRowsValue output) (run : LexicalUnwind.UseRunState) : Prop where
  source : RetainedSource operations policy contracts tables families required outward run.tickets annotations world history
    resumes annotatedStore budget ports owners emptyRows output outputRows run.execution.machine
  resumeRecords : ∀ key body, (key, body) ∈ resumes →
    PlannedResumeAnnotated operations policy contracts tables families required outward run.tickets annotations world run.execution.machine.stack key body
  unwindRecords : ∀ key body, (key, body) ∈ disposals →
    PlannedUnwindAnnotated operations policy contracts tables families required outward run.tickets annotations world run.execution.machine.stack key body
  storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore
  lifetime : LexicalUnwind.UseRunInvariant policy run
  tickets : LexicalUnwind.MachineTicketAccess policy run.tickets run.execution.machine
  resources : LexicalUnwind.MachineAccess ambient run.execution.machine
  activations : run.execution.machine.stack.erase.activations ⊆ history
  issuedResources : ScopedTyping.resourceWorld run.execution.issued ⊆ world

theorem RetainedState.joined
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows run) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output run :=
  ⟨state.source.joined, state.resumeRecords, state.unwindRecords, state.storeAnnotation,
    state.lifetime, state.tickets, state.resources, state.activations, state.issuedResources⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RetainedSource.joined
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RetainedState.joined



namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)
set_option maxRecDepth 4096
set_option maxHeartbeats 800000

private def Context.outerTail {hints : ReturnHints scope} (context : Context hints) : Packed :=
  match context with
  | .nil => Context.nil.pack
  | .plain _ rest | .handler _ _ rest | .cell rest | .cleanup _ _ rest
  | .normal rest | .unwinding rest | .closing rest | .retiring _ rest
  | .live _ rest | .spent rest => rest.pack

private def Packed.outerTail (packed : Packed) : Packed := packed.context.outerTail

private theorem ModeFrameRows.outerTail
    (rows : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated) : decorated.pack.outerTail = tail.pack := by
  cases rows <;> first
  | rfl
  | (rename_i authenticated; cases authenticated <;> rfl)

/-- Reauthenticate a new pending derivation of the same physical stack and
exact decorated context, retaining the old ordinary record witnesses. -/
theorem RecordPendingRows.reauthenticate_pack
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (old : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context) :
    ∀ {nextScope} {nextHints : ReturnHints nextScope} {nextContext : Context nextHints}
      {nextInput nextOutput nextDemand nextRequirements}
      {next : PlannedModeSource operations policy contracts tables families required outward actions world
        stack nextInput nextOutput nextDemand nextRequirements nextScope}
      {nextInputRows : ModeRowsValue nextInput} {nextOutputRows : ModeRowsValue nextOutput},
      PendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows next nextInputRows nextOutputRows nextContext →
      context.pack = nextContext.pack →
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows resumes next nextInputRows nextOutputRows nextContext := by
  induction old with
  | nil => intros; rename_i newRows same; cases newRows; exact .nil
  | push head tail ih =>
      intros; rename_i newRows same
      cases newRows with
      | push newHead newTail =>
          have tails := head.outerTail.symm.trans ((congrArg Packed.outerTail same).trans newHead.outerTail)
          exact .push newHead (ih newTail tails)
  | live answerRows agreement inside tail ihInside ihTail =>
      rename_i owner contract rights inputType answerType caller captured boundary body savedScope stack output demand requirements restScope savedHints capturedContext outputRows restHints rest known actionKnown inputAnnotation answerAnnotation callerScope held saved answer tailSource boundaryRows
      intros; rename_i newRows same
      cases newRows with
      | live newAnswerRows newInside newTail =>
          cases same
          rename_i nextOutput nextDemand nextOutputRows newContract newRights newBoundary newBody newAnswer newBoundaryRows newKnown newActionKnown newInputAnnotation newAnswerAnnotation newHeld newCallerScope newRequirements newSaved newSource
          have sameContract := Option.some.inj (known.symm.trans newKnown)
          subst newContract
          have modeSame := saved.return_mode.symm.trans newSaved.return_mode
          cases answerRows <;> cases newAnswerRows
          all_goals first
          | solve | cases modeSame
          | exact .live (known := known) (actionKnown := actionKnown)
              (inputAnnotation := inputAnnotation) (answerAnnotation := answerAnnotation)
              (callerScope := callerScope) (held := held) (answer := answer)
              (by constructor) agreement inside (ihTail newTail rfl)
      | opening newInside newTail =>
          cases same
          exact .opening (known := known) (actionKnown := actionKnown)
            (inputAnnotation := inputAnnotation) (answerAnnotation := answerAnnotation)
            (callerScope := callerScope) (held := held) (answer := answer)
            answerRows agreement inside (ihInside newInside rfl) (ihTail newTail rfl)
  | opening answerRows agreement ordinary inside tail ihOrdinary ihInside ihTail =>
      rename_i owner contract rights inputType answerType caller captured boundary ordinaryRequirements savedScope savedDemand savedRequirements stack output tailDemand tailRequirements restScope savedHints capturedContext outputRows restHints rest known actionKnown inputAnnotation answerAnnotation callerScope held ordinarySource answer boundaryRows saved tailSource
      intros; rename_i newRows same
      cases newRows with
      | live newAnswerRows newInside newTail =>
          cases same
          rename_i nextOutput nextDemand nextOutputRows newContract newRights newBoundary newBody newAnswer newBoundaryRows newKnown newActionKnown newInputAnnotation newAnswerAnnotation newHeld newCallerScope newRequirements newSaved newSource
          have sameContract := Option.some.inj (known.symm.trans newKnown)
          subst newContract
          have modeSame := ordinarySource.return_mode.symm.trans newSaved.return_mode
          cases answerRows <;> cases newAnswerRows
          all_goals first
          | solve | cases modeSame
          | exact .live (known := known) (actionKnown := actionKnown)
              (inputAnnotation := inputAnnotation) (answerAnnotation := answerAnnotation)
              (callerScope := callerScope) (held := held) (answer := answer)
              (by constructor) agreement ordinary (ihTail newTail rfl)
      | opening newInside newTail =>
          cases same
          exact .opening (known := by assumption) (actionKnown := by assumption)
            (inputAnnotation := by assumption) (answerAnnotation := by assumption)
            (callerScope := by assumption) (held := by assumption) (answer := by assumption)
            answerRows agreement ordinary (ihInside newInside rfl) (ihTail newTail rfl)
  | spent tail ih =>
      intros; rename_i newRows same
      cases newRows with
      | spent newTail => cases same; exact .spent (ih newTail rfl) (known := by assumption) (annotation := by assumption) (callerScope := by assumption)
      | skippedSpent newTail => cases same; exact .skippedSpent (ih newTail rfl)
  | skippedSpent tail ih =>
      intros; rename_i newRows same
      cases newRows with
      | spent newTail => cases same; exact .spent (ih newTail rfl) (known := by assumption) (annotation := by assumption) (callerScope := by assumption)
      | skippedSpent newTail => cases same; exact .skippedSpent (ih newTail rfl)

/-- Literal-context specialization; input/output modes, value rows and
requirement demands may differ between the two source views. -/
theorem RecordPendingRows.reauthenticate
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    {next : PlannedModeSource operations policy contracts tables families required outward actions world
      stack nextInput nextOutput nextDemand nextRequirements scope}
    (old : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (newRows : PendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows next nextInputRows nextOutputRows context) :
    RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes next nextInputRows nextOutputRows context :=
  old.reauthenticate_pack newRows rfl

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

