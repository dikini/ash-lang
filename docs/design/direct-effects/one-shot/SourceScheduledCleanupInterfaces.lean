        UnwindRecords operations.erase policy (contracts.erase.insert owner contract) tables world nextStack nextDisposals ∧
        PlannedModeSource operations policy (contracts.insert owner (SourcePlannedSources.refineContract contract input answer)) tables families required outward
          (actions.insert owner code.requiredActions) world nextStack (.value answer) output tailDemand
          (.sequence (.spent owner) tailReq) (.live owner capScope tailScope) ∧
        (∃ nextHints : SourceDependencyChecks.Lexical.ReturnHints (.live owner capScope tailScope),
