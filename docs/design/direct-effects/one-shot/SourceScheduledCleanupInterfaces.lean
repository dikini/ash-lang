namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Value)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (Signature signature)
open SourcePlannedChecks (Certified)
open SourceDependencyAnnotations (Dependencies RowAnnotation RequirementPath)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (spendAll)

/-- Focus selects the actual subplans of the certified source. The independent
recursive capability check follows the same split, including the pure waiting
frame required by a right-pair focus. -/
theorem focus_signature_checks
    {whole : Signature wholeDependencies} {child : Signature childDependencies} {rest : Signature restDependencies}
    (split : SourcePlannedSources.FocusSignature whole child rest)
    {plan : Plan wholeDependencies} (same : signature plan = whole)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world wholeDependencies hints) :
    ∃ childPlan : Plan childDependencies, ∃ restPlan : Plan restDependencies,
      signature childPlan = child ∧ signature restPlan = rest ∧
      Certified (evidence := declarationPolicy) outward world childPlan ∧
      Certified (evidence := declarationPolicy) outward world restPlan ∧
      Local outward actions phases world childDependencies (.plain (dependencies := restDependencies) hints) ∧
      Local outward actions phases world restDependencies hints := by
  cases split with
  | pure => cases plan; exact ⟨.pure, .pure, rfl, rfl, Certified.pure (evidence := declarationPolicy), Certified.pure (evidence := declarationPolicy), .pure, .pure⟩
  | sequence => cases plan with
    | sequence first second =>
      obtain ⟨firstSame, secondSame⟩ := Signature.sequence.inj same
      cases certified with | sequence firstCert secondCert =>
        cases checked with | sequence firstCheck secondCheck =>
          exact ⟨first, second, firstSame, secondSame, firstCert, secondCert, firstCheck, secondCheck⟩
  | pairRight => cases plan with
    | sequence first second =>
      obtain ⟨firstSame, secondSame⟩ := Signature.sequence.inj same
      cases certified with | sequence firstCert secondCert =>
        cases checked with | sequence firstCheck secondCheck =>
          exact ⟨second, .pure, secondSame, rfl, secondCert, Certified.pure (evidence := declarationPolicy),
            SourceDependencyNeutral.Lexical.Recursive.local_history secondCheck (.pureFrame .refl), .pure⟩
  | appArgument => cases plan with
    | sequence function remaining => cases remaining with
      | sequence argument body =>
        obtain ⟨functionSame, remainingSame⟩ := Signature.sequence.inj same
        obtain ⟨argumentSame, bodySame⟩ := Signature.sequence.inj remainingSame
        cases certified with | sequence functionCert remainingCert =>
          cases remainingCert with | sequence argumentCert bodyCert =>
            cases checked with | sequence functionCheck remainingCheck =>
              cases remainingCheck with | sequence argumentCheck bodyCheck =>
                exact ⟨argument, body, argumentSame, bodySame, argumentCert, bodyCert, argumentCheck, bodyCheck⟩

/-- Rebuild focus's root check from an already chosen source decomposition.
The previous annotation survives as a choice branch, retaining both path kinds. -/
theorem focus_root_annotation
    (plain : PlainData)
    {currentRequirements : Requirements currentDemand}
    {childRequirements : Requirements childDemand}
    {restRequirements : Requirements restDemand}
    {pendingRequirements : Requirements pendingDemand}
    (sameDemand : currentDemand = childDemand ++ restDemand)
    (evaluation : ∀ entries receiving before,
      evaluate entries receiving before (annotateDisposals currentRequirements) =
        merge (evaluate entries receiving before (annotateDisposals childRequirements))
          (evaluate entries receiving (spendAll before childDemand) (annotateDisposals restRequirements)))
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row) :
    let nextRequirements := Requirements.sequence
      (restRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements
    let nextRoot := Requirements.sequence
      (childRequirements.prepend (OwnerPhases.ofStack tables (.push (.plain plain) stack))) nextRequirements
    ∃ nextAnnotated : Requirements (childDemand ++ (restDemand ++ pendingDemand)), ∃ nextRow,
      RowAnnotation nextRoot nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row := by
  let nextRequirements := Requirements.sequence
    (restRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements
  let nextRoot := Requirements.sequence
    (childRequirements.prepend (OwnerPhases.ofStack tables (.push (.plain plain) stack))) nextRequirements
  have generated : ∀ entries receiving before, evaluate entries receiving before (annotateDisposals nextRoot) =
      evaluate entries receiving before (annotateDisposals
        (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements)) := by
    intro entries receiving before
    simp only [nextRoot, nextRequirements, annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
      RecursiveRequirements.evaluate_prepend, evaluation, sameDemand,
      PhaseRechecking.spendAll_append, RecursiveContexts.plain_context, List.cons_append,
      RecursiveContexts.evaluate_plain, merge_assoc]
  obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked rowChecked
  have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) normalRow :=
    RecursiveRequirements.evaluate_sound ((generated entries receiving before).trans (RecursiveRequirements.checked_complete normalCheck))
  have aligned : (childDemand ++ (restDemand ++ pendingDemand)).Perm (currentDemand ++ pendingDemand) := by
    simp only [sameDemand, List.append_assoc]
    exact .refl _
  exact ⟨.choice nextRoot annotated aligned, normalRow ++ row,
    .alternatives .original aligned, .no .here, .no .here, .choice nextCheck rowChecked,
    List.append_subset.mpr ⟨within, List.Subset.refl _⟩⟩

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.focus_root_annotation

/-- One actual focus step carries rich source, declaration certification,
recursive lexical checks, generated root rows and ownership/access together.
The complete prior annotation remains an exact raw and generated subtree. -/
theorem focus_planned_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      whole input currentDemand currentRequirements (signature plan))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value input) output pendingDemand pendingRequirements dependencyScope)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (position : Focus whole child context)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints stack)
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨whole, runtimeScope, stack⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨whole, runtimeScope, stack⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨whole, runtimeScope, stack⟩)) :
    ∃ (plain : PlainData) (nextInput : Value) (childDemand restDemand : List Nat),
    ∃ childRequirements : Requirements childDemand,
    ∃ nextRequirements : Requirements (restDemand ++ pendingDemand),
    ∃ childDependencies restDependencies, ∃ childPlan : Plan childDependencies,
    ∃ nextAnnotated : Requirements (childDemand ++ (restDemand ++ pendingDemand)), ∃ nextRow,
      plain.context = context ∧ plain.scope = runtimeScope ∧
      SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
        child nextInput childDemand childRequirements (signature childPlan) ∧
      Certified (evidence := declarationPolicy) outward world childPlan ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        (.push (.plain plain) stack) (.value nextInput) output (restDemand ++ pendingDemand)
        nextRequirements (.plain restDependencies dependencyScope) ∧
      currentDemand = childDemand ++ restDemand ∧
      RowAnnotation
        (.sequence (childRequirements.prepend (OwnerPhases.ofStack tables (.push (.plain plain) stack))) nextRequirements)
        nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world childDependencies (.plain (dependencies := restDependencies) hints) ∧
      Pending outward actions phases world (.plain (dependencies := restDependencies) hints) .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families (.plain (dependencies := restDependencies) hints) (.push (.plain plain) stack) ∧
      Bound annotations (.plain restDependencies dependencyScope) ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world stack key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
          (.push (.plain plain) stack) key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world stack key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
          (.push (.plain plain) stack) key body) ∧
      RawStep ⟨whole, runtimeScope, stack⟩ ⟨child, runtimeScope, .push (.plain plain) stack⟩ [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨whole, runtimeScope, stack⟩)
        (.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩) [] [] ∧
      ownedTickets (.push (.plain plain) stack) = ownedTickets stack ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩) := by
  obtain ⟨nextInput, childDemand, restDemand, childReq, restReq, childDep, restDep,
    childSignature, restSignature, childSource, sourceContext, split, sameDemand, evaluation⟩ :=
    SourcePlannedSources.focus_decompose_disposals current position
  obtain ⟨childPlan, restPlan, childSame, restSame, childCertified, restCertified, childCheck, restCheck⟩ :=
    focus_signature_checks split rfl certified checked
  obtain ⟨plain, contextSame, scopeSame, inputAnnotation, outputAnnotation⟩ := RecursiveContexts.prepare_plain
    (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase current)))
    position scopeTyped nextInput.erase.erase
  have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required
      outward world (.plain plain) nextInput input restDemand restReq (.plain restDep) (fun rest => .plain rest) allowed allowed :=
    .plain (by simpa only [contextSame, scopeSame, restSame] using sourceContext)
      (by simpa only [scopeSame] using scopeTyped) inputAnnotation outputAnnotation restCertified
  let nextReq := Requirements.sequence (restReq.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements
  obtain ⟨nextAnnotated, nextRow, nextAnnotation, rawPath, generatedPath, nextChecked, included⟩ :=
    focus_root_annotation plain sameDemand (fun entries receiving before => (evaluation entries receiving before).2)
      annotation rowChecked
  have step : RawStep ⟨whole, runtimeScope, stack⟩ ⟨child, runtimeScope, .push (.plain plain) stack⟩ [] [] := by
    simpa only [scopeSame] using RawStep.focus plain (by simpa only [contextSame] using position) stack
  have nextUse := LexicalUnwind.focus_machine_use plain (by simpa only [contextSame] using position)
    (by simpa only [scopeSame] using usage)
  have nextTickets := LexicalUnwind.focus_machine_ticket_access plain (by simpa only [contextSame] using position)
    (by simpa only [scopeSame] using ticketAccess)
  refine ⟨plain, nextInput, childDemand, restDemand, childReq, nextReq, childDep, restDep, childPlan,
    nextAnnotated, nextRow, contextSame, scopeSame,
    by simpa only [childSame] using childSource, childCertified, .push (.ordinary frame) pending,
    sameDemand, nextAnnotation, rawPath, generatedPath, nextChecked, included, childCheck,
    .plain (restCheck.reindex_scope (SourceDependencyProjection.scope_append_nil _).symm (return_hints_append_nil hints).symm) retained,
    .plain matching, .plain annotationBound, ?_, ?_, step, .evaluate step (LexicalUnwind.focus_computation_head position),
    rfl, by simpa only [scopeSame] using nextUse, by simpa only [scopeSame] using nextTickets, ?_⟩
  · intro key body record
    cases record with | resume located known recorded source answer =>
      exact .resume (.push located) known recorded source answer
  · intro key body record
    cases record with | dispose located held recorded source =>
      exact .dispose (.push located) held recorded source
  · cases resourceAccess with
    | eval supported => exact .eval (ScopedExecution.raw_step_preserves_access step supported (ScopedPortJoint.focus_access_checks position))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.focus_signature_checks
