/-- Inserting a builtin can discharge requests, so coverage is preserved even
when its name occurs in the old row. Exact row equality needs a freshness side
condition; the effect upper bound does not. -/
theorem export_insert_builtin_covered
    (exported : OwnerSource.exportAt (front ++ receiving) before raw = some row) (identity : Nat) :
    ∃ nextRow, OwnerSource.exportAt (front ++ .ordinary (.builtin identity) :: receiving) before raw = some nextRow ∧
      nextRow ⊆ row := by
  simp only [OwnerSource.exportAt, OwnerPhaseTransitions.project_append, residual_append] at exported ⊢
  cases prefixRow : residualize (OwnerPhaseTransitions.project front before) raw with
  | none => simp only [prefixRow] at exported; cases exported
  | some exposed =>
      have rest : residualize (OwnerPhaseTransitions.project receiving before) exposed = some row := by
        simpa only [prefixRow] using exported
      have covered : CallableProtection.outsideCell identity exposed ⊆ exposed := fun _ member => (List.mem_filter.mp member).1
      obtain ⟨nextRow, checked, included⟩ := UniformClauseBounds.residual_coverage covered rest
      exact ⟨nextRow, by simpa only [prefixRow, OwnerPhaseTransitions.project, residual_builtin] using checked, included⟩

/-- Reuse the finite checked-derivation induction, including authenticated
stored invocation bodies. Only their result rows become smaller. -/
theorem checked_insert_builtin_covered
    (checked : Checked store original before requirements row)
    (split : original = front ++ receiving) (identity : Nat) :
    ∃ nextRow, Checked store (front ++ .ordinary (.builtin identity) :: receiving) before requirements nextRow ∧
      nextRow ⊆ row := by
  induction checked generalizing front receiving with
  | request exported =>
      obtain ⟨nextRow, preserved, included⟩ := export_insert_builtin_covered (front := _ ++ front) (receiving := receiving)
        (by simpa only [split, List.append_assoc] using exported) identity
      exact ⟨nextRow, .request (by simpa only [List.append_assoc] using preserved), included⟩
  | retire ready => exact ⟨[], .retire ready, List.Subset.refl _⟩
  | spent consumed => exact ⟨[], .spent consumed, List.Subset.refl _⟩
  | invoke known ready selection next ih =>
      rename_i key demand body phases nearer current waiting output
      obtain ⟨nextRow, preserved, included⟩ := ih (front := nearer ++ front) (receiving := receiving)
        (by simp only [split, List.append_assoc])
      obtain ⟨waiting, selected⟩ := ResourceRequirements.selection_insert_builtin (identity := identity)
        (front := _ ++ front) (receiving := receiving) (by simpa only [split, List.append_assoc] using selection)
      exact ⟨nextRow, .invoke known ready (by simpa only [List.append_assoc] using selected)
        (by simpa only [List.append_assoc] using preserved), included⟩
  | sequence first second ihFirst ihSecond =>
      obtain ⟨left, first, leftBound⟩ := ihFirst split
      obtain ⟨right, second, rightBound⟩ := ihSecond split
      exact ⟨left ++ right, .sequence first second,
        List.append_subset.mpr ⟨leftBound.trans (List.subset_append_left _ _), rightBound.trans (List.subset_append_right _ _)⟩⟩
  | emitAfter body exported ih =>
      obtain ⟨left, first, leftBound⟩ := ih split
      obtain ⟨right, second, rightBound⟩ := export_insert_builtin_covered (front := _ ++ front) (receiving := receiving)
        (by simpa only [split, List.append_assoc] using exported) identity
      exact ⟨left ++ right, .emitAfter first (by simpa only [List.append_assoc] using second),
        List.append_subset.mpr ⟨leftBound.trans (List.subset_append_left _ _), rightBound.trans (List.subset_append_right _ _)⟩⟩
  | choice first second ihFirst ihSecond =>
      obtain ⟨left, first, leftBound⟩ := ihFirst split
      obtain ⟨right, second, rightBound⟩ := ihSecond split
      exact ⟨left ++ right, .choice first second,
        List.append_subset.mpr ⟨leftBound.trans (List.subset_append_left _ _), rightBound.trans (List.subset_append_right _ _)⟩⟩

/-- Local resource opening requires no additional row-name exclusion when the
existing effect bound is preserved by inclusion rather than exact equality. -/
theorem checked_open_resource_covered
    (checked : Checked store receiving before closed row)
    (hidden : ResourceRequirements.Hides identity opened closed) :
    ∃ nextRow, Checked store (.ordinary (.builtin identity) :: receiving) before opened nextRow ∧ nextRow ⊆ row := by
  obtain ⟨nextRow, preserved, included⟩ := checked_insert_builtin_covered checked (front := []) (receiving := receiving) rfl identity
  refine ⟨nextRow, RecursiveRequirements.evaluate_sound ?_, included⟩
  rw [ResourceRequirements.evaluate_hidden hidden]
  exact RecursiveRequirements.checked_complete preserved

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
