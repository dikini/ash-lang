/-- Physical source ownership derives the absence needed by structural
certificate transport when the retirement marker is removed. -/
private theorem pending_certificate_retire_from_source
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (coherent : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (certificate : SourceAdmission.Pending outward actions budget (available (owner :: ownedTickets stack)) world history
      context .nil inputMode outputMode)
    (absent : owner ∉ ownedTickets stack) :
    SourceAdmission.Pending outward actions budget (available (ownedTickets stack)) world history
      context .nil inputMode outputMode := by
  have decoratedAbsent : owner ∉ (context.append .nil).owned := by
    simp only [Context.append_owned, Context.owned, List.append_nil]
    exact fun member => absent (coherent.source.owned_subset member)
  simpa only [OwnerPhaseTransitions.spend_available_cons absent] using certificate.spend_absent decoratedAbsent

/-- Leaving a consumed clause restores its caller with the same rich value
metadata and the unchanged pending budget. -/
theorem RetainedState.leave_clause
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, caller, tail⟩, issued, completed⟩, actions⟩ := by
  have operational := state.joined.leave_clause closed
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    have empty := SourceTemplates.expression_value_demand
      (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
        (SourcePlannedSources.expression_erase current.source))) closed.1
    cases empty
    cases coherent with
    | spent remaining =>
      rename_i contract restScope restHints restContext known annotationType callerKnown tailRequirements suffix
      cases retained with | spent remainingLocal =>
        cases pendingBudget with | spent remainingBudget =>
          cases pendingCertificate with | spent remainingCertificate =>
            cases bound with | spent restBound =>
              obtain ⟨nextAnnotated, nextRow, nextAnnotation, nextChecked, included⟩ :=
                value_marker_root_annotation annotation checked (OwnerPhases.ofStack tables tail)
              have nextAuth := (current.authenticated.value_summary closed.1).value_context closed.1 allowed caller
              have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows world history
                  allowed outward caller actions (available (ownedTickets tail)) budget tables families
                  restContext tail value contract.answer [] (.request [] []) (signature Plan.pure)
                  (owners owner contract known).2 .pure :=
                ⟨_, nextAuth, .pure, .pure, remaining.forget.source⟩
              refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
              apply RetainedSource.eval nextCurrent (Certified.pure (evidence := declarationPolicy)) callerKnown
                suffix remaining remainingBudget remainingLocal restBound ?_ nextAnnotation nextChecked (included.trans bounded) .pure remainingCertificate
              simpa only [SourceContextualRechecking.checkForest] using finite

/-- The closing delimiter restores Unit and keeps the exact suffix source and
metadata. This covers the general closeValue rule and raw Unit subcase. -/
