/-- Source authentication exposes the primitive request certificate retained
by its sequencing rule. It does not reconstruct source checks from ownership. -/
theorem Auth.request_certificate
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows source resultRows rows)
    (expression : code = .perform effect operation operand)
    (checked : SourceAdmission.Code outward actions budget phases world installations rows context) :
    ∃ requested, effect = Instantiation.freezeEffect requested ∧
      SourceAdmission.Code outward actions budget phases world installations
        (Rows.request (effect := requested) (operation := operation)) context := by
  cases expression
  cases authenticated with
  | perform operandChecked =>
    cases checked with
    | sequence operandCertificate request => exact ⟨_, rfl, request⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
