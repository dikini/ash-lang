/-- Administrative unwinding keeps the exact retained source and metadata. -/
theorem RetainedState.advance
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope before, issued, completed⟩, actions⟩)
    (step : LexicalUnwind.Advance before after discharged) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      (unwindStore before resumes) (unwindStore before disposals) (unwindStore before annotatedStore)
      budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope after, issued, discharged ++ completed⟩, actions⟩ := by
  have operational := state.joined.advance step
  have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
  cases state.source with
  | unwind pending coherent pendingBudget retained bound finite annotation checked bounded pendingCertificate =>
    rename_i receiving demand requirements annotated row hints context
    obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked checked
    cases step with
    | plain =>
      cases coherent with
      | push head rest => cases head with
        | skipped =>
          cases pendingBudget with | skipped tailBudget =>
            cases pendingCertificate with | skipped tailCertificate =>
              cases retained with | skipped tailRetained =>
                cases bound with | plain tailBound =>
                  have tailCheck := RecursiveRequirements.evaluate_sound (by
                    simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                      RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty, spendAll,
                      RecursiveRecomposition.merge_empty_left] using RecursiveRequirements.checked_complete normalCheck)
                  refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                    operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
                  exact RetainedSource.unwind (annotated := .choice _ annotated (.refl _)) (by assumption) rest tailBudget tailRetained tailBound finite
                    (.alternatives .original (.refl _)) (.choice tailCheck checked)
                    ((List.append_subset.mpr ⟨normalBound, List.Subset.refl _⟩).trans bounded) tailCertificate
    | handler =>
      cases coherent with
      | push head rest => cases head with
        | handler frameRows =>
          cases frameRows with
          | handler authenticated =>
            cases pendingBudget with | handler tailBudget =>
              cases pendingCertificate with | handler tailCertificate =>
                cases retained with | handler tailRetained =>
                  cases bound with | handler tailBound =>
                    have tailCheck := RecursiveRequirements.evaluate_sound (by
                      simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                        RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty, spendAll,
                        RecursiveRecomposition.merge_empty_left] using RecursiveRequirements.checked_complete normalCheck)
                    refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                      operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
                    apply RetainedSource.unwind (annotated := .choice _ annotated (.refl _)) (by assumption) rest tailBudget tailRetained tailBound ?_
