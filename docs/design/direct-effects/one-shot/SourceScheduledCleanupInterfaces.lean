open SourceDeclarationPlans (Plan ClausePlans)
open SourcePlanSignatures (signature clauseSignatures)
open SourcePlannedRecipeDeclarations (Selected)
open SourcePlannedTyping (Contract)

/-- Selection in the actual retained row decorations follows the same clause
order and ordinary/protected mode as selection in the retained clause plans. -/
inductive ClauseRows.Selected (operation : Nat) : (held : Bool) →
    {families : SourceDependencyAnnotations.ClauseDependencies} →
    {declarations : SourcePlanSignatures.ClauseSignatures families} → ClauseRows declarations →
    {family : Nat → Dependencies} → {bodies : ∀ owner, SourcePlanSignatures.Signature (family owner)} →
    (∀ owner, Rows (bodies owner)) → Prop where
  | ordinary {supportBound : List Nat} : ClauseRows.Selected operation false
      (.cons (supportBound := supportBound) (operation := operation) (rights := rights) (.available bodyRows) protectedRows restRows) bodyRows
  | protectedMode {supportBound : List Nat} : ClauseRows.Selected operation true
      (.cons (supportBound := supportBound) (operation := operation) (rights := rights) ordinaryRows (.available bodyRows) restRows) bodyRows
  | pass {supportBound : List Nat} (different : operation ≠ other)
      (next : ClauseRows.Selected operation held restRows bodyRows) :
      ClauseRows.Selected operation held
        (.cons (supportBound := supportBound) (operation := other) (rights := rights) ordinaryRows protectedRows restRows) bodyRows

/-- Clause lookup retains the actual authenticated source body and all its
row decorations for each fresh owner; higher-order operation endpoints come
from the same declared operation metadata. -/
theorem AuthDeclarations.selected
    {plans : ClausePlans clauses families}
    {declarationRows : ClauseRows (clauseSignatures plans)}
    {source : SourcePlannedSources.Declarations operations policy contracts world environment allowed requested answer clauses table plans}
    (authenticated : AuthDeclarations operations policy ports owners environmentRows answerRows source declarationRows)
    (selected : ClauseAt operation clauses parameter binder code)
    (found : lookup operation table = some offered)
    (available : offered.row held = some row) :
    ∃ argument input resumeEffects closeEffects, ∃ (family : Nat → Dependencies) (bodies : ∀ owner, Plan (family owner)),
    ∃ known : operations requested operation = some (argument, input),
    ∃ bodyRows : ∀ owner, Rows (signature (bodies owner)),
    ∃ body : ∀ owner (contract : Contract), contracts owner = none →
        contract.input = input → contract.answer = answer →
        contract.resumeEffects = resumeEffects → contract.closeEffects = closeEffects →
        contract.held = held → contract.closeDemand.Perm contract.resumeDemand →
        SourcePlannedSources.Body operations policy (contracts.insert owner contract) world allowed (.ticket binder owner)
          (environment.extend parameter argument) code answer ⟨owner, contract.erase.erase, offered.dispose, row⟩
          (signature (bodies owner)),
      (code.requiredActions.resume = true → resumeEffects = allowed) ∧
      (code.requiredActions.dispose = true → closeEffects = allowed) ∧
      Selected operation held plans parameter binder code bodies ∧
      ClauseRows.Selected operation held declarationRows bodyRows ∧
      ∀ owner (contract : Contract) (fresh : contracts owner = none)
          (inputSame : contract.input = input) (answerSame : contract.answer = answer)
          (resumeSame : contract.resumeEffects = resumeEffects) (closeSame : contract.closeEffects = closeEffects)
          (heldSame : contract.held = held) (demands : contract.closeDemand.Perm contract.resumeDemand),
        AuthBody operations policy ports
          (owners.insert owner (inputSame.symm ▸ (ports requested operation argument input known).2)
            (answerSame.symm ▸ answerRows))
          (environmentRows.extend parameter (ports requested operation argument input known).1) answerRows
          (body owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands) (bodyRows owner) := by
  induction selected generalizing table families with
  | hit => cases authenticated with
    | cons ordinary protectedMode rest support =>
      simp only [lookup, if_true] at found
      cases Option.some.inj found
      cases held with
      | false =>
        simp [ClauseContract.row] at available
        cases available
        cases ordinary with
        | available bodyChecked =>
          exact ⟨_, _, _, _, _, _, _, _, _, by assumption, by assumption, .ordinary, .ordinary, bodyChecked⟩
      | true =>
        simp [ClauseContract.row] at available
        cases available
        cases protectedMode with
        | available bodyChecked =>
          exact ⟨_, _, _, _, _, _, _, _, _, by assumption, by assumption, .protectedMode, .protectedMode, bodyChecked⟩
  | pass different next ih => cases authenticated with
    | cons ordinary protectedMode rest support =>
      obtain ⟨argument, input, resumeEffects, closeEffects, family, bodies, known, bodyRows, body,
        resumeInterface, closeInterface, chosen, located, bodyChecked⟩ :=
        ih rest (by simpa only [lookup, if_neg different] using found)
      exact ⟨argument, input, resumeEffects, closeEffects, family, bodies, known, bodyRows, body,
        resumeInterface, closeInterface, .pass different chosen, .pass different located, bodyChecked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.AuthDeclarations.selected

