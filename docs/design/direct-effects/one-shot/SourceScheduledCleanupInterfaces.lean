namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution
open SourceDependencyChecks.Lexical (ReturnHints)

/-- All retained continuation names, including dormant captures and spent markers. -/
def Context.ticketNames {hints : ReturnHints scope} (context : Context hints) : List Nat :=
  match context with
  | .nil => []
  | .plain _ rest | .handler _ _ rest | .cell rest | .cleanup _ _ rest
  | .normal rest | .unwinding rest | .closing rest => rest.ticketNames
  | .retiring owner rest | .spent (owner := owner) rest => owner :: rest.ticketNames
  | .live (owner := owner) saved rest => owner :: (saved.ticketNames ++ rest.ticketNames)

theorem Context.append_ticketNames {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (head : Context first) (tail : Context second) :
    (head.append tail).ticketNames = head.ticketNames ++ tail.ticketNames := by
  induction head <;> simp_all [Context.append, Context.ticketNames, List.append_assoc] <;> rfl

theorem Context.owned_subset_ticketNames {hints : ReturnHints scope} (context : Context hints) :
    context.owned ⊆ context.ticketNames := by
  induction context with
  | nil => simp [Context.owned]
  | plain rows tail ih | handler activation rows tail ih | cell tail ih
  | cleanup latent rows tail ih | normal tail ih | unwinding tail ih | closing tail ih => exact ih
  | retiring owner tail ih => exact List.cons_subset_cons _ ih
  | spent tail ih => exact fun _ member => List.mem_cons_of_mem _ (ih member)
  | live saved tail ihSaved ihTail =>
      intro name member
      simp only [Context.owned, List.mem_append, List.mem_cons] at member
      rcases member with savedMember | same | tailMember
      · exact List.mem_cons_of_mem _ (List.mem_append_left _ (ihSaved savedMember))
      · exact List.mem_cons.mpr (Or.inl same)
      · exact List.mem_cons_of_mem _ (List.mem_append_right _ (ihTail tailMember))

theorem Context.Source.ticketNames_eq {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack) :
    context.ticketNames = stack.erase.ticketNames := by
  induction source <;>
    simp_all [Context.ticketNames, Stack.erase, ExecFrame.erase, PlainData.erase,
      HandlerData.erase, ActionData.erase, CloseItem.frame, closeFrame, Control.ticketNames]


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.owned_subset_ticketNames
