namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyAnnotations (RowAnnotation)
open RecursiveRequirements (Checked)

/-- Source inversion connects the additional interface check to the actual
richly typed discard clause, retaining its exact requirement derivation. -/
theorem protected_discard_source_checked
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.discard binder) result demand requirements signature)
    (known : contracts owner = some contract)
    (resolved : runtimeScope.resolve binder = some owner)
    (interface : ProtectedClauseInterface owner contract.erase.erase true entries tail before requestRow) :
    ∃ row, RowAnnotation requirements (annotateDisposals requirements) ∧
      Checked entries (.live owner contract.held :: tail) before (annotateDisposals requirements) row ∧
      row ⊆ requestRow ++ contract.resumeRow := by
  cases source with
  | discard actual actualResolved permission unprotected admitted =>
    cases Option.some.inj (actualResolved.symm.trans resolved)
    cases Option.some.inj (actual.symm.trans known)
    obtain ⟨row, checked, bounded⟩ := interface.discard_checked
    exact ⟨row, disposal_annotation _, checked, bounded⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.protected_discard_source_checked

