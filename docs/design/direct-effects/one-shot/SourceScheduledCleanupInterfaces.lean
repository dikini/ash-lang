/-- The exact lexical discard installation and its authenticated source pieces.
The cleanup metadata is the projection of the selected captured context. -/
structure ReadyDiscardSite
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows) where
  owner : Nat
  binder : Nat
  expression : site.expression = .discard binder
  resolved : site.runtimeScope.resolve binder = some owner
  contract : SourcePlannedTyping.Contract
  known : contracts owner = some contract
  result : site.result = .unit
  front : Stack
  captured : Stack
  tail : Stack
  inputType : Ty
  answerType : Ty
  caller : Scope
  stack : site.stack = front.append (.live owner inputType answerType captured caller tail)
  frontScope : SourceDependencyCapture.Scope
  capturedScope : SourceDependencyCapture.Scope
  tailScope : SourceDependencyCapture.Scope
  frontHints : ReturnHints frontScope
  capturedHints : ReturnHints capturedScope
  tailHints : ReturnHints tailScope
  frontContext : Context frontHints
  capturedContext : Context capturedHints
  tailContext : Context tailHints
  context : site.context.pack = (frontContext.append
    (.live (owner := owner) (resumeDemand := contract.resumeDemand) capturedContext tailContext)).pack
  located : SourceDependencyCapture.OwnerCut owner
    (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩
  middle : PlannedModeValue
  middleRows : ModeRowsValue middle
  answerRows : ModeRowsValue.Answer (owners owner contract known).2 middleRows
  answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType
  callerKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller
  frontDemand : List Nat
  tailDemand : List Nat
  frontRequirements : Requirements frontDemand
  tailRequirements : Requirements tailDemand
  boundary : PlannedModeValue
  boundaryRows : ModeRowsValue boundary
  savedRequirements : Requirements contract.resumeDemand
  frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
    front (.value .unit) middle frontDemand frontRequirements frontScope
  savedSource : PlannedModeSource operations policy contracts tables families required outward actions world
    captured (.value contract.input) boundary contract.resumeDemand savedRequirements capturedScope
  tailSource : PlannedModeSource operations policy contracts tables families required outward actions world
    tail middle output tailDemand tailRequirements tailScope
  frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes frontSource (.value .unit) middleRows frontContext
  savedRows : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes savedSource (.value (owners owner contract known).1) boundaryRows capturedContext
  tailRows : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes tailSource middleRows outputRows tailContext
  metadata : CleanupHints.Metadata capturedScope
  closing : capturedContext.closing? = some metadata

/-- The primitive supplies unprotected capture and the actual unwind certificate. -/
theorem ReadyDiscardSite.certificate
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyDiscardSite site) :
    view.capturedScope.held = false ∧
    SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases view.owner) world installations
      (view.capturedContext.append (.closing (view.frontContext.append (.spent (owner := view.owner) view.tailContext))))
      .nil .unwind output.mode := by
  have current := site.current
  rw [view.expression] at current
  have primitive := SourceAdmission.Code.ready_discard current.previous.authenticated view.resolved current.certificate
  exact (primitive.reindex_context view.context).discard_pending_at_mode view.located
    (site.retained.reindex_context view.context)

theorem ReadyDiscardSite.unprotected
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyDiscardSite site) : ProtectionContexts.protectedMode view.captured.erase = false := by
  have held := view.certificate.1
  exact view.savedRows.forget.source.matching.erases.held.symm.trans held

/-- A discard root uses captured cleanup and the ordinary caller; it does not
execute the abandoned captured expressions. -/
def ReadyDiscardSite.root
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyDiscardSite site) :
    Requirements (view.owner :: (view.metadata.closing.1 ++ (view.frontDemand ++ view.tailDemand))) :=
  discardExecutionRoot tables view.owner view.front view.tail view.answerType view.caller
    view.metadata.closing.2 view.frontRequirements (.sequence (.spent view.owner) view.tailRequirements)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ReadyDiscardSite.certificate
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ReadyDiscardSite.unprotected

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)

theorem Auth.discard_origin_parts
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (.discard binder) result demand requirements checking}
    (auth : Auth operations policy ports owners environmentRows source resultRows rows) :
    ∃ owner contract, contracts owner = some contract ∧ scope.resolve binder = some owner ∧
      result = .unit ∧ HEq resultRows ValueRows.unit := by
  cases auth with
  | discard => exact ⟨_, _, by assumption, by assumption, rfl, HEq.rfl⟩

private theorem record_return_mode
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context) :
    LexicalUnwind.returnMode stack input.mode = output.mode := by
  have _ := rows
  exact source.return_mode

theorem RecordPendingRows.unit_input
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value input) output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source (.value inputRows) outputRows context)
    (equal : input = .unit) (rowsEqual : HEq inputRows ValueRows.unit) :
    ∃ nextSource : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value .unit) output demand requirements scope,
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows resumes nextSource (.value .unit) outputRows context := by
  cases equal
  cases eq_of_heq rowsEqual
  exact ⟨source, rows⟩

theorem ExecutionSite.discard_origin
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (expression : site.expression = .discard binder) : Nonempty (ReadyDiscardSite site) := by
  have current := site.current
  rw [expression] at current
  obtain ⟨owner, contract, known, resolved, result, resultRows⟩ := Auth.discard_origin_parts current.previous.authenticated
  have primitive := SourceAdmission.Code.ready_discard current.previous.authenticated resolved current.certificate
  obtain ⟨⟨frontScope, frontHints, frontContext⟩, ⟨capturedScope, capturedHints, capturedContext⟩,
    ⟨tailScope, tailHints, tailContext⟩, resumeDemand, rights, same, located, actionKnown,
    permission, available, unprotected, abandoned, waiting⟩ := primitive.dispose_parts
  have scopeSame := congrArg Packed.scope same
  have cut : SourceDependencyCapture.OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩ :=
    by
      change site.receiving = frontScope.append (.live owner capturedScope tailScope) at scopeSame
      exact scopeSame ▸ located
  obtain ⟨front, live, middle, middleRows, frontDemand, liveDemand, frontRequirements, liveRequirements,
    frontSource, liveSource, stack, frontRows, liveRows, _⟩ :=
    site.coherent.split_disposals frontContext
      (.live (owner := owner) (resumeDemand := resumeDemand) capturedContext tailContext) same
  have physical := liveRows.forget.source
  cases physical with
  | live capturedPhysical tailPhysical =>
      cases liveRows with
      | live aligned agreement saved tail =>
          obtain ⟨frontUnitSource, frontUnitRows⟩ := frontRows.unit_input result resultRows
          have physicalUnprotected := saved.forget.source.matching.erases.held.symm.trans unprotected
          have unwindPrefix :=  LexicalUnwind.unprotected_unwind_prefix physicalUnprotected
          obtain ⟨metadata, closing⟩ := saved.forget.source.closing_exists_of_unwind_prefix unwindPrefix
          cases aligned with
          | value =>
              refine ⟨{
                owner := owner, binder := binder, expression := expression, resolved := resolved,
                contract := _, known := by assumption, result := result,
                front := front, captured := _, tail := _, inputType := _, answerType := _, caller := _, stack := stack,
                frontScope := frontScope, capturedScope := capturedScope, tailScope := tailScope,
                frontHints := frontHints, capturedHints := capturedHints, tailHints := tailHints,
                frontContext := frontContext, capturedContext := capturedContext, tailContext := tailContext,
                context := same, located := cut, middle := _, middleRows := _, answerRows := .value,
                answerAnnotation := by assumption, callerKnown := by assumption,
                frontDemand := frontDemand, tailDemand := _, frontRequirements := frontRequirements, tailRequirements := _,
                boundary := _, boundaryRows := _, savedRequirements := _,
                frontSource := frontUnitSource, savedSource := _, tailSource := _,
                frontRows := frontUnitRows, savedRows := saved, tailRows := tail,
                metadata := metadata, closing := closing }⟩
          | unwind =>
              have returned := record_return_mode saved
              rw [LexicalUnwind.unwind_prefix_return_mode unwindPrefix] at returned
              cases returned
      | opening aligned agreement ordinary saved tail =>
          obtain ⟨frontUnitSource, frontUnitRows⟩ := frontRows.unit_input result resultRows
          have physicalUnprotected := ordinary.forget.source.matching.erases.held.symm.trans unprotected
          have unwindPrefix :=  LexicalUnwind.unprotected_unwind_prefix physicalUnprotected
          obtain ⟨metadata, closing⟩ := ordinary.forget.source.closing_exists_of_unwind_prefix unwindPrefix
          refine ⟨{
            owner := owner, binder := binder, expression := expression, resolved := resolved,
            contract := _, known := by assumption, result := result,
            front := front, captured := _, tail := _, inputType := _, answerType := _, caller := _, stack := stack,
            frontScope := frontScope, capturedScope := capturedScope, tailScope := tailScope,
            frontHints := frontHints, capturedHints := capturedHints, tailHints := tailHints,
            frontContext := frontContext, capturedContext := capturedContext, tailContext := tailContext,
            context := same, located := cut, middle := .unwind, middleRows := .unwind, answerRows := .unwind,
            answerAnnotation := by assumption, callerKnown := by assumption,
            frontDemand := frontDemand, tailDemand := _, frontRequirements := frontRequirements, tailRequirements := _,
            boundary := _, boundaryRows := _, savedRequirements := _,
            frontSource := frontUnitSource, savedSource := _, tailSource := _,
            frontRows := frontUnitRows, savedRows := ordinary, tailRows := tail,
            metadata := metadata, closing := closing }⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Auth.discard_origin_parts
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.unit_input
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.discard_origin

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)

/-- Structural descent selects a literal Boolean's actual source branch. -/
inductive BranchSelection : Code → Code → Prop where
  | yes : BranchSelection (.branch (.boolean true) yes no) yes
  | no : BranchSelection (.branch (.boolean false) yes no) no

theorem BranchSelection.ready (selected : BranchSelection whole child) : RecursiveExpressions.Ready whole := by
  cases selected <;> exact .branch

theorem BranchSelection.step (selected : BranchSelection whole child) (scope : Scope) (stack : Stack) :
    RawStep ⟨whole, scope, stack⟩ ⟨child, scope, stack⟩ [] [] := by
  cases selected
  · exact .ifTrue _ _ _ _
  · exact .ifFalse _ _ _ _

theorem BranchSelection.functional (first : BranchSelection whole child) (second : BranchSelection whole other) :
    child = other := by cases first <;> cases second <;> rfl

/-- The selected child retains the identical lexical receiver and pending source.
Only the actual syntactic branch and its authenticated row subtree change. -/
def ExecutionSite.BranchSelected
    (site next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows) : Prop :=
  BranchSelection site.expression next.expression ∧
  next.runtimeScope = site.runtimeScope ∧ next.stack = site.stack ∧
  next.context.pack = site.context.pack ∧ ComputationSelection site.expression site.rows next.rows ∧
  HEq next.pending site.pending ∧ HEq next.resultRows site.resultRows

/-- Existing authenticated computation and row selection construct the branch
site. No executable-root check or successor admission is supplied. -/
theorem ExecutionSite.select_branch
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (selected : BranchSelection site.expression child) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
      site.BranchSelected next ∧ next.expression = child := by
  obtain ⟨ticket, scopeTyped⟩ := site.scopeTyped
  obtain ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
    nextCurrent, nextCertified, nextScope, _demands, _stack, _created, _completed,
    _normalTransfer, _generatedTransfer, selection⟩ :=
    site.current.previous.computation_selected_rows site.certified scopeTyped selected.ready
      (selected.step site.runtimeScope site.stack)
  let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows :=
    { expression := child, runtimeScope := site.runtimeScope, stack := site.stack,
      result := site.result, resultRows := site.resultRows, allowed := site.allowed,
      dependencies := nextDependencies, plan := nextPlan, rows := nextRows,
      sourceDemand := nextDemand, sourceRequirements := nextRequirements,
      receiving := site.receiving, hints := site.hints, context := site.context,
      current := ⟨nextCurrent, site.current.certificate.computation_rows selection.forget⟩,
      certified := nextCertified, scopeTyped := ⟨nextTicket, nextScope⟩,
      pendingDemand := site.pendingDemand, pendingRequirements := site.pendingRequirements,
      pending := site.pending, coherent := site.coherent, retained := site.retained,
      currentResource := site.currentResource.computation_rows selection.forget, retainedResource := site.retainedResource }
  exact ⟨next, ⟨selected, rfl, rfl, rfl, selection, HEq.rfl, HEq.rfl⟩, rfl⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.select_branch

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)
open PureTransport

theorem Wait.pure_frame (waiting : Wait world installations context mode root) :
    Wait world installations (.plain .pure context) mode root := by
  cases mode with
  | ordinary => exact .plain (.pure waiting)
  | unwind => exact .skipped waiting

open AccountingTransport

theorem Run.deep_pure_history {root : Requirements demand} (run : Run world installations rows context root)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : DeepPureHistory context next) : Run world installations rows next root := by
  induction run using Run.rec
      (motive_2 := fun world installations {_} {_} context mode {demand} root _ =>
        ∀ {nextScope} {nextHints : ReturnHints nextScope} (next : Context nextHints),
          DeepPureHistory context next → Wait world installations next mode root)
      generalizing nextScope with
  | pure waiting ih => exact .pure (ih next changed)
  | builtin found waiting ih => exact .builtin (changed.builtin found) (ih next changed)
  | request cut selected body binding ih =>
    obtain ⟨_, _, _, _, nextCaptured, nextTail, nextCut, capturedChanged, tailChanged, nextSelected⟩ :=
      selected.deep_cut changed cut
    exact .request nextCut nextSelected
      (fun owner demand fresh => ih owner demand (by simpa only [changed.ticketNames] using fresh)
        (.live capturedChanged tailChanged))
      (fun owner demand fresh => binding owner demand (by simpa only [changed.ticketNames] using fresh))
  | sequence first ih => exact .sequence (ih (.plain _ changed))
  | installHandler body ih => exact .installHandler (fun activation fresh => ih activation fresh (.handler _ changed))
  | installResource body ih => exact .installResource (fun identity fresh => ih identity fresh (.cell changed))
  | installCleanup body ih => exact .installCleanup (ih (.cleanup _ changed))
  | choice left right same ihLeft ihRight => exact .choice (ihLeft changed) (ihRight changed) same
  | @resume frontScope savedScope tailScope owner world installations remaining root resumeDemand frontHints savedHints tailHints front saved tail located restored ih =>
    obtain ⟨nextFront, nextCaptured, nextTail, same, frontChanged, capturedChanged, tailChanged⟩ := changed.decompose_live front saved tail rfl
    have expansion := capturedChanged.append (frontChanged.append (DeepPureHistory.spent (owner := owner) tailChanged))
    have transported := ih _ expansion
    have result := Run.resume (resumeDemand := resumeDemand) (front := nextFront.context) (captured := nextCaptured.context) (tail := nextTail.context)
      (frontChanged.owner_cut capturedChanged tailChanged located) transported
    change Run world installations _ next.pack.context _
    rw [same]
    exact result
  | @dispose frontScope savedScope tailScope owner world installations remaining root resumeDemand frontHints savedHints tailHints front saved tail located abandoned ih =>
    obtain ⟨nextFront, nextCaptured, nextTail, same, frontChanged, capturedChanged, tailChanged⟩ := changed.decompose_live front saved tail rfl
    have expansion := capturedChanged.append (.closing (frontChanged.append (DeepPureHistory.spent (owner := owner) tailChanged)))
    have transported := ih _ expansion
    have result := Run.dispose (resumeDemand := resumeDemand) (front := nextFront.context)
      (captured := nextCaptured.context) (tail := nextTail.context)
      (frontChanged.owner_cut capturedChanged tailChanged located) transported
    change Run world installations _ next.pack.context _
    rw [same]
    exact result
  | nil =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .nil
  | plain code ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .plain (ih (by first | exact .same _ | assumption))
  | skipped tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .skipped (ih _ (by first | exact .same _ | assumption))
  | handler tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .handler (ih _ (by first | exact .same _ | assumption))
  | cell tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .cell (ih _ (by first | exact .same _ | assumption))
  | cleanup callback ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | (apply Wait.cleanup; apply ih; apply DeepPureHistory.callback; first | exact .same _ | assumption)
  | normal tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .normal (ih _ (by first | exact .same _ | assumption))
  | unwinding tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .unwinding (ih _ (by first | exact .same _ | assumption))
  | closing tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .closing (ih _ (by first | exact .same _ | assumption))
  | retiring tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .retiring (ih _ (by first | exact .same _ | assumption))
  | live tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .live (ih _ (.same _))
      | (rename_i savedChanged tailChanged
         have moved := ih _ tailChanged
         rw [savedChanged.return_mode .ordinary] at moved
         exact .live moved)
  | opening captured ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .opening (ih _ ((by first | exact .same _ | assumption : DeepPureHistory _ _).append (.retiring (by first | exact .same _ | assumption))))
  | spent tail ih =>
    rename_i nextScope nextHints next changed
    induction next <;> cases changed
    all_goals first
      | (rename_i ihHistory history; exact Wait.pure_frame (ihHistory history))
      | exact .spent (ih _ (by first | exact .same _ | assumption))

theorem Wait.deep_pure_history {root : Requirements demand} (waiting : Wait world installations context mode root)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : DeepPureHistory context next) : Wait world installations next mode root := by
  cases mode with
  | ordinary =>
    have result := (Run.pure waiting).deep_pure_history changed
    cases result with | pure result => exact result
  | unwind =>
    have result := (Run.pure (.unwinding waiting)).deep_pure_history (.unwinding changed)
    cases result with | pure result => cases result with | unwinding result => exact result


/-- The original source transport API is an instance of the deeper accounting relation. -/
theorem Run.pure_history {root : Requirements demand} (run : Run world installations rows context root)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : PureHistory context next) : Run world installations rows next root :=
  run.deep_pure_history (DeepPureHistory.of_shallow changed)

theorem Wait.pure_history {root : Requirements demand} (waiting : Wait world installations context mode root)
    {nextHints : ReturnHints nextScope} {next : Context nextHints}
    (changed : PureHistory context next) : Wait world installations next mode root :=
  waiting.deep_pure_history (DeepPureHistory.of_shallow changed)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.pure_history
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Wait.pure_history
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open RecursiveRequirements (Requirements)

/-- Source focus carries silence for exactly the two removed value prefixes. -/
theorem Run.focus_rows {root : Requirements demand}
    (run : Run world installations rows context root) (split : FocusRows rows childRows restRows) :
    Run world installations childRows (.plain restRows context) root := by
  cases split with
  | pure => exact run.pure_history (.add (.same _))
  | sequence => cases run with | sequence child => exact child
  | pairRight silent =>
    exact ((silent_prefix_iff silent _ _).mp run).pure_history (.add (.same _))
  | appArgument silent =>
    have remaining := (silent_prefix_iff silent _ _).mp run
    cases remaining with | sequence child => exact child

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.focus_rows
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport ProtectionResiduals
open RecursiveRequirements (Requirements evaluate)
open SourcePlanSignatures (Signature signature)
open SourceDeclarationPlans (Plan)
open SourcePlannedChecks (Certified)
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Plugging adds only silent immediate rows, preserving the whole receiver interpretation. -/
theorem PlugRows.accounting_iff
    (shape : PlugRows previous next)
    {receiver : Contextual.Context hints} {root : Requirements demand} :
    Contextual.Accounting.Run world installations next receiver root ↔ Contextual.Accounting.Run world installations previous receiver root := by
  cases shape with
  | pure => exact Iff.rfl
  | single => exact Contextual.Accounting.silent_prefix_iff .pure Rows.pure _
  | double =>
      exact (Contextual.Accounting.silent_prefix_iff .pure Rows.pure _).trans
        (Contextual.Accounting.silent_prefix_iff .pure Rows.pure _)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.PlugRows.accounting_iff

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlannedTyping (Operations Contracts Value)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open RecursiveRequirements (Requirements)

/-- Plug a returned value into its actual authenticated plain frame, retaining
that frame's exact suffix source and structural continuation certificate. -/
theorem ExecutionSite.plug
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (value : site.expression.IsValue)
    (stackEq : site.stack = .push (.plain plain) tail) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
      next.expression = plain.context.plug site.expression ∧
      next.runtimeScope = plain.scope ∧ next.stack = tail ∧
      ∃ waitingDependencies, ∃ waitingPlan : Plan waitingDependencies,
      ∃ waitingRows : Rows (signature waitingPlan),
        site.context.pack = (Context.plain waitingRows next.context).pack ∧
        PlugRows waitingRows next.rows := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at stackEq value ⊢
  subst stack
  cases coherent with
  | push frame tailCoherent =>
    cases frame with
    | ordinary frameRows =>
      cases frameRows with
      | plain contextAuth =>
        cases retained with
        | plain waitingCertificate tailCertificate =>
          rename_i frameDemand frameRequirements restScope restHints restContext tailDemand tailRequirements
            nextInput boundary nextInputRows pendingTail frameDependencies frameTicket framePlan frameRows frameCertified
            frameScope inputAnnotation outputAnnotation frameSource
          have childAuth := (current.previous.authenticated.value_summary value).value_context value boundary .none
          obtain ⟨combined, nextDependencies, nextPlan, nextRows, nextSource, nextAuth, nextCertified,
            _nextLocal, _nextBudget, shape, _evaluation⟩ :=
            AuthContext.plug_value_rows rfl contextAuth childAuth frameCertified
              (waitingCertificate.reindex_context restContext.append_nil_pack).compile.1
              (waitingCertificate.reindex_context restContext.append_nil_pack).compile.2
          have nextCertificate := shape.source_certificate
            (waitingCertificate.reindex_context restContext.append_nil_pack)
          let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
              resumes budget ports owners emptyRows output outputRows :=
            { expression := plain.context.plug expression, runtimeScope := plain.scope, stack := tail,
              result := nextInput, resultRows := nextInputRows, allowed := boundary,
              dependencies := nextDependencies, plan := nextPlan, rows := nextRows,
              sourceDemand := frameDemand, sourceRequirements := combined,
              receiving := restScope, hints := restHints, context := restContext,
              current := SourceAdmission.Admitted.of_source nextSource nextAuth nextCertificate tailCoherent.forget.source,
              certified := nextCertified, scopeTyped := ⟨frameTicket, frameScope⟩,
              pendingDemand := tailDemand, pendingRequirements := tailRequirements,
              pending := pendingTail, coherent := tailCoherent, retained := tailCertificate, currentResource := by
                cases retainedResource with | plain waitingResource _ =>
                  exact plug_rows shape (waitingResource.reindex_context restContext.append_nil_pack),
                  retainedResource := by cases retainedResource <;> assumption }
          exact ⟨next, rfl, rfl, rfl, _, framePlan, frameRows, rfl, shape⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.plug

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)

/-- Ordinary value plugging preserves the exact contextual accounting root
and constructs its actual authenticated successor, from predecessor evidence. -/
theorem ExecutionSite.plug_accounting
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (closed : ClosedValue site.expression)
    (stackEq : site.stack = .push (.plain plain) tail)
    (waiting : Accounting.Wait world installations site.context .ordinary (root : Requirements demand)) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows,
      next.expression = plain.context.plug site.expression ∧
      next.runtimeScope = plain.scope ∧ next.stack = tail ∧
      Accounting.Run world installations next.rows next.context root ∧
      (∀ annotations, SourceDependencySchemes.Closing.Bound annotations site.receiving → SourceDependencySchemes.Closing.Bound annotations next.receiving) ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [] := by
  obtain ⟨next, expressionEq, scopeEq, nextStackEq, dependencies, plan, rows, contextEq, shape⟩ :=
    site.plug closed.1 stackEq
  have transfer : ∀ annotations, SourceDependencySchemes.Closing.Bound annotations site.receiving → SourceDependencySchemes.Closing.Bound annotations next.receiving := by
    intro annotations bound
    have same := congrArg Packed.scope contextEq
    change site.receiving = .plain _ next.receiving at same
    rw [same] at bound
    cases bound with | plain rest => exact rest
  change Accounting.Wait world installations site.context.pack.context .ordinary root at waiting
  rw [contextEq] at waiting
  cases waiting with
  | plain interpreted =>
      refine ⟨next, expressionEq, scopeEq, nextStackEq, shape.accounting_iff.mpr interpreted, transfer, ?_⟩
      rw [stackEq, expressionEq, scopeEq, nextStackEq]
      exact .plug plain site.expression closed site.runtimeScope tail

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.plug_accounting

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)

/-- Actual ordinary computation selects its existing body rows. Silent values
reuse one prefix law; Boolean selection projects the existing choice check. -/
theorem Run.computation_selected {root : Requirements demand}
    {checking : SourcePlanSignatures.Signature dependencies} {rows : Rows checking}
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result sourceDemand sourceRequirements checking)
    (ready : RecursiveExpressions.Ready code)
    (selected : ComputationSelection code rows nextRows)
    (run : Run world installations rows context root)
    (checked : Checked store receiving phases (annotateDisposals root) row) :
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand, ∃ nextRow,
      Run world installations nextRows context nextRoot ∧ demand.Perm nextDemand ∧
      Checked store receiving phases (annotateDisposals nextRoot) nextRow ∧ nextRow ⊆ row := by
  cases selected with
  | binding =>
    cases ready with
    | bind isValue =>
      exact ⟨_, root, row, (bind_iff source isValue _ _).mp run, .refl _, checked, List.Subset.refl _⟩
  | application =>
    cases ready with
    | app isValue =>
      exact ⟨_, root, row, (beta_iff source isValue _ _ _).mp run, .refl _, checked, List.Subset.refl _⟩
  | trueBranch =>
    cases source with
    | branch condition yes no same =>
      have branchRun := (silent_prefix_iff (SourceDependencyAnnotations.value_silent
        (SourcePlannedSources.expression_erase condition) trivial) _ _).mp run
      cases branchRun with
      | choice left right same =>
        cases checked with
        | choice leftCheck rightCheck =>
          exact ⟨_, _, _, left, .refl _, leftCheck, List.subset_append_left _ _⟩
  | falseBranch =>
    cases source with
    | branch condition yes no same =>
      have branchRun := (silent_prefix_iff (SourceDependencyAnnotations.value_silent
        (SourcePlannedSources.expression_erase condition) trivial) _ _).mp run
      cases branchRun with
      | choice left right same =>
        cases checked with
        | choice leftCheck rightCheck =>
          exact ⟨_, _, _, right, same, rightCheck, List.subset_append_right _ _⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.computation_selected

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)

/-- One existing computation proof constructs the next authenticated site;
contextual accounting selects the same body rows and retains its finite check. -/
theorem ExecutionSite.computation_accounting
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (ready : RecursiveExpressions.Ready site.expression)
    (step : RawStep ⟨site.expression, site.runtimeScope, site.stack⟩ after created completed)
    (run : Accounting.Run world installations site.rows site.context (root : Requirements demand))
    (checked : Checked entries receivingContext phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows,
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand, ∃ nextRow,
      next.expression = after.expression ∧ next.runtimeScope = after.scope ∧ next.stack = after.stack ∧
      next.context.pack = site.context.pack ∧
      Accounting.Run world installations next.rows next.context nextRoot ∧ demand.Perm nextDemand ∧
      Checked entries receivingContext phases (annotateDisposals nextRoot) nextRow ∧ nextRow ⊆ row ∧
      created = [] ∧ completed = [] := by
  obtain ⟨ticket, scopeTyped⟩ := site.scopeTyped
  obtain ⟨sourceDemand, sourceRequirements, dependencies, plan, rows, nextTicket,
    current, certified, nextScope, _demands, stackSame, createdSame, completedSame,
    _normalTransfer, _generatedTransfer, selected⟩ :=
    site.current.previous.computation_selected_rows site.certified scopeTyped ready step
  obtain ⟨nextDemand, nextRoot, nextRow, interpreted, sameDemand, nextChecked, bounded⟩ :=
    run.computation_selected site.current.previous.source ready selected checked
  let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows :=
    { expression := after.expression, runtimeScope := after.scope, stack := site.stack,
      result := site.result, resultRows := site.resultRows, allowed := site.allowed,
      dependencies := dependencies, plan := plan, rows := rows,
      sourceDemand := sourceDemand, sourceRequirements := sourceRequirements,
      receiving := site.receiving, hints := site.hints, context := site.context,
      current := ⟨by simpa only [stackSame] using current,
        site.current.certificate.computation_rows selected.forget⟩,
      certified := certified, scopeTyped := ⟨nextTicket, nextScope⟩,
      pendingDemand := site.pendingDemand, pendingRequirements := site.pendingRequirements,
      pending := site.pending, coherent := site.coherent, retained := site.retained,
      currentResource := site.currentResource.computation_rows selected.forget, retainedResource := site.retainedResource }
  exact ⟨next, nextDemand, nextRoot, nextRow, rfl, rfl, stackSame.symm, rfl,
    interpreted, sameDemand, nextChecked, bounded, createdSame, completedSame⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.computation_accounting





namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlannedTyping (Operations Contracts Value)
open RecursiveRequirements (Requirements)

/-- Execution roots interpret actual source rows and their lexical continuation.
Focus and branch selection retain the selected child; scalar pending requirements alone never admit execution. -/
inductive ExecutionRoot (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (actions : Syntax.UsageTickets)
    (phases : OwnerPhaseTransitions.Phases) (world installations : List Nat)
    (resumes : RecursiveRequirements.Store) (budget : Footprint)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none))
    (output : PlannedModeValue) (outputRows : ModeRowsValue output) :
    ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows → {demand : List Nat} → Requirements demand → Prop where
  | contextual (interpreted : Accounting.Run world installations site.rows site.context root) :
      ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows site root
  | branch (selected : ExecutionSite.BranchSelected site next)
      (inside : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows next root) :
      ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows site root
  | focus (focused : ExecutionSite.Focused site next child position)
      (inside : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows next root) :
      ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows site root

/-- A returned value uses the same execution interpretation as every other
expression; its silent source rows expose the actual pending continuation. -/
theorem ExecutionRoot.contextualValue
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (value : site.expression.IsValue)
    (waiting : Accounting.Wait world installations site.context .ordinary (root : Requirements demand)) :
    ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site root :=
  .contextual ((Accounting.value_iff site.current.previous.source value site.rows).mpr waiting)

/-- Every admitted returned value retains the interpretation of its actual
pending context. This is an inversion result, not an additional source premise. -/
theorem ExecutionRoot.value_wait
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (value : site.expression.IsValue) : Accounting.Wait world installations site.context .ordinary root := by
  cases rooted with
  | contextual interpreted => exact (Accounting.value_iff site.current.previous.source value site.rows).mp interpreted
  | branch selected inside => exact False.elim (RecursiveExpressions.ready_not_value selected.1.ready value)
  | focus focused inside => exact False.elim (ScopedPorts.focus_is_not_value focused.1 value)

/-- The operational focus relation chooses a unique child and context. This is
independent of source-typing witness choices. -/
private theorem execution_focus_unique (first : Focus whole child position)
    (second : Focus whole other otherPosition) : child = other ∧ position = otherPosition := by
  cases first <;> cases second <;> first | exact ⟨rfl, rfl⟩ | contradiction

/-- Bind is the sequencing instance of the general structural focus rule. -/
theorem ExecutionRoot.bind
    {site next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (focused : ExecutionSite.Focused site next child (.bind parameter suffix))
    (inside : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows next (root : Requirements demand)) :
    ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site root := .focus focused inside

/-- Every admitted focus keeps the same executable root and its check. Source
and pending metadata come from the retained actual decomposition. -/
theorem ExecutionRoot.focus_step
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (focus : Focus site.expression child position)
    (checked : RecursiveRequirements.Checked entries receiving phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows,
      site.Focused next child position ∧
      ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows next root ∧
      RecursiveRequirements.Checked entries receiving phases (annotateDisposals root) row := by
  cases rooted with
  | contextual interpreted =>
      obtain ⟨next, focused⟩ := site.focus focus
      obtain ⟨plain, _position, _scope, _expression, _nextScope, _stack, _raw,
        restDependencies, restPlan, restRows, split, contextSame, _certificate⟩ := focused.2
      have nextRun : Accounting.Run world installations next.rows next.context root := by
        change Accounting.Run world installations next.rows next.context.pack.context root
        rw [contextSame]
        exact interpreted.focus_rows split
      exact ⟨next, focused, .contextual nextRun, checked⟩
  | branch selected inside => exact False.elim (RecursiveExpressions.ready_not_focus selected.1.ready focus)
  | focus focused inside =>
      obtain ⟨sameChild, samePosition⟩ := execution_focus_unique focused.1 focus
      cases sameChild
      cases samePosition
      exact ⟨_, focused, inside, checked⟩

/-- Bind-entry specialization exposing the actual raw step and lexical frame. -/
theorem ExecutionRoot.bind_focus
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (focus : Focus site.expression child (.bind parameter suffix))
    (checked : RecursiveRequirements.Checked entries receiving phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows,
    ∃ plain : PlainData,
      plain.context = .bind parameter suffix ∧ plain.scope = site.runtimeScope ∧
      next.expression = child ∧ next.runtimeScope = site.runtimeScope ∧
      next.stack = .push (.plain plain) site.stack ∧
      ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows next root ∧
      RecursiveRequirements.Checked entries receiving phases (annotateDisposals root) row ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [] := by
  obtain ⟨next, ⟨_, plain, position, scope, expression, runtime, stack, raw, _⟩, rooted, checked⟩ :=
    rooted.focus_step focus checked
  exact ⟨next, plain, position, scope, expression, runtime, stack, rooted, checked, raw⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.bind
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.contextualValue
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.value_wait
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.focus_step
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.bind_focus

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)

/-- The finite execution-root derivation accounts for the physical owners, also
under nested evaluation focus. Focus only relocates records; the resume leaf reuses
actual-mode source reconstruction and ownership preservation. -/
theorem ExecutionRoot.ownership
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand)) :
    (∀ key body, (key, body) ∈ (resumes : RecursiveRequirements.Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world site.stack key body) →
    (∀ key body, (key, body) ∈ (disposals : RecursiveRequirements.Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world site.stack key body) →
    SourceDependencyAnnotations.StoreAnnotation (resumes ++ disposals) annotatedStore →
    (ownedTickets site.stack).Nodup →
    RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) receiving
      (OwnerPhaseTransitions.available (ownedTickets site.stack)) (annotateDisposals root) row →
    demand.Perm (ownedTickets site.stack) := by
  induction rooted with
  | contextual interpreted =>
      rename_i currentSite
      intro records closing storeAnnotation unique checked
      exact interpreted.stack_owned currentSite.coherent.forget.source unique (disposal_annotation _) checked
  | branch selected inside ih =>
      intro records closing storeAnnotation unique checked
      simpa only [selected.2.2.1] using ih
        (by simpa only [selected.2.2.1] using records)
        (by simpa only [selected.2.2.1] using closing) storeAnnotation
        (by simpa only [selected.2.2.1] using unique)
        (by simpa only [selected.2.2.1] using checked)
  | focus focused inside ih =>
      rename_i currentSite nextSite child position currentDemand currentRoot
      intro records closing storeAnnotation unique checked
      obtain ⟨_focus, plain, _position, _scope, _expression, _runtime, stack, _raw, _decomposition⟩ := focused
      have ownersSame : ownedTickets nextSite.stack = ownedTickets currentSite.stack := by
        rw [stack]
        rfl
      have nextRecords : ∀ key body, (key, body) ∈ resumes →
          PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
            nextSite.stack key body := by
        rw [stack]
        intro key body member
        cases records key body member with
        | resume located known recorded source answer => exact .resume (.push located) known recorded source answer
      have nextClosing : ∀ key body, (key, body) ∈ disposals →
          PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
            nextSite.stack key body := by
        rw [stack]
        intro key body member
        cases closing key body member with
        | dispose located held recorded source => exact .dispose (.push located) held recorded source
      have nextUnique : (ownedTickets nextSite.stack).Nodup := by simpa only [ownersSame] using unique
      have nextChecked : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) receiving
          (OwnerPhaseTransitions.available (ownedTickets nextSite.stack)) (annotateDisposals currentRoot) row := by
        simpa only [ownersSame] using checked
      simpa only [ownersSame] using ih nextRecords nextClosing storeAnnotation nextUnique nextChecked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.ownership

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedResumeExample
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourcePlannedTyping (Operations Contracts Contract)
open RecursiveRequirements (Requirements)
open SourcePlanSignatures (Signature)

def rights : Syntax.OneShotRights := ⟨true, true⟩
def policy : Syntax.TicketPolicy := fun _ => rights
def actions : Syntax.UsageTickets := fun _ => some rights
def operations : Operations := fun _ _ => none
def contract (owner : Nat) : Contract := ⟨.unit, .unit, owner == 0, [], [], [], some [], [], []⟩
def contracts : Contracts := fun owner => some (contract owner)
def tables : CallableProtectionFrames.Tables := fun _ => []
def families : SourceDependencyFrames.Families := fun _ => .nil
def required : SourceContextualRechecking.Required := fun _ => []
def ports : OperationRows operations := by intro _ _ _ _ known; cases known
def owners : ContractRows contracts := by
  intro owner actual known
  cases Option.some.inj known
  exact ⟨.unit, .unit⟩
def emptyRows : EnvironmentRows (fun _ => none) := by intro _ _ known; cases known

def action : ActionData := ⟨7, .lambda 9 .unit, by exact ⟨trivial, rfl, by simp [Code.dependencies]⟩, .none, .unit, []⟩
def frontData : PlainData := ⟨.resume 5, .ticket 5 1, .unit, .unit, [1], rfl⟩
def front : Stack := .push (.plain frontData) .nil
def captured : Stack := .push (.unwinding action) .nil
def tail : Stack := .live 1 .unit .unit .nil .none (.push (.closing 0 .none) .nil)
def whole : Stack := front.append (.live 0 .unit .unit captured .none tail)
def frontContext := Context.plain (Rows.invoke (key := ⟨1, .resume⟩)) Context.nil
def capturedContext := Context.unwinding Context.nil
def tailContext := Context.live (owner := 1) (resumeDemand := []) Context.nil (Context.closing Context.nil)

def empty : Requirements [] := .request [] []
def savedReq : Requirements [] := .sequence (empty.prepend []) empty
def frontReq : Requirements [1] := .sequence ((Requirements.invoke ⟨1, .resume⟩ [] []).prepend []) empty
def tailReq : Requirements [1] := .sequence (empty.prepend (OwnerPhases.ofStack tables (.push (.retiring 1) (.push (.closing 0 .none) .nil))))
  (.sequence (.retire 1) (.sequence (empty.prepend []) empty))
def liveReq : Requirements [1] := .sequence (.spent 0) tailReq
def resumes : RecursiveRequirements.Store := [(⟨0, .resume⟩, ⟨[], savedReq⟩)]
def disposals : RecursiveRequirements.Store := []
def annotations : Nat → Option SourceDependencyCapture.Scope := fun owner => if owner = 0 then some (.running .nil) else some .nil

abbrev Source := PlannedModeSource operations policy contracts tables families required [] actions []
abbrev Rich {stack input output demand requirements scope}
    (source : Source stack input output demand requirements scope)
    (inputRows : ModeRowsValue input) (outputRows : ModeRowsValue output)
    {hints : SourceDependencyChecks.Lexical.ReturnHints scope} (context : Context hints) : Prop :=
  RecordPendingRows operations policy contracts tables families required [] actions [] ports owners emptyRows resumes
    source inputRows outputRows context

theorem callbackSource : SourcePlannedSources.ValueSummary operations policy contracts [] (fun _ => none) []
    action.action (.function .unit .unit [] [] (.pure)) :=
  .lambda .unit (.request (layers := [])) (by intro x member; cases member) (by simp)

theorem callbackAuth : Auth operations policy ports owners emptyRows callbackSource (.function .unit .unit .pure) .pure :=
  .lambda .unit (by exact List.nil_subset _) (outward := .request (layers := [])) (formed := by intro x member; cases member) (latentBound := by simp)

theorem pureCertified : SourcePlannedChecks.Certified (evidence := declarationPolicy) [] [] SourceDeclarationPlans.Plan.pure := .pure (evidence := declarationPolicy)

theorem savedSource : Source captured (.value .unit) .unwind [] savedReq (.running .nil) :=
  .push (.unwinding callbackSource pureCertified) .nil

theorem savedRows : Rich savedSource (.value .unit) .unwind capturedContext :=
  .push (.unwinding (callbackPlan := .pure) (certified := pureCertified) callbackAuth) .nil

theorem closingSource : Source (.push (.closing 0 .none) .nil) .unwind (.value .unit) []
    (.sequence (empty.prepend []) empty) (.running .nil) :=
  .push (.closing ⟨.none, .none⟩) .nil

theorem closingRows : Rich closingSource .unwind (.value .unit) (Context.closing Context.nil) :=
  .push (.closing (scopeKnown := ⟨.none, .none⟩)) .nil

theorem tailSource : Source tail .unwind (.value .unit) [1] tailReq (.live 1 .nil (.running .nil)) :=
  .opening .nil closingSource

theorem tailRows : Rich tailSource .unwind (.value .unit) tailContext := by
  apply RecordPendingRows.opening (known := show contracts 1 = some (contract 1) from rfl)
    (actionKnown := show actions 1 = some rights from rfl)
    (inputAnnotation := rfl) (answerAnnotation := rfl) (callerScope := ⟨.none, .none⟩)
    (held := rfl) (ordinarySource := show Source .nil (.value .unit) (.value .unit) [] empty .nil from .nil)
    (saved := show Source .nil .unwind .unwind [] empty .nil from .nil)
    (source := closingSource) (answer := Or.inl rfl)
    (boundaryRows := .value .unit)
  · exact .value
  · intro body found
    simp [resumes, RecursiveRequirements.lookup] at found
  · exact .nil
  · exact .nil
  · exact closingRows

theorem liveSource : Source (.live 0 .unit .unit captured .none tail) (.value .unit) (.value .unit) [1]
    liveReq (.live 0 (.running .nil) (.live 1 .nil (.running .nil))) :=
  .live rfl rfl rfl rfl ⟨.none, .none⟩ rfl savedSource (Or.inr rfl) tailSource

theorem liveRows : Rich liveSource (.value .unit) (.value .unit)
    (.live (owner := 0) (resumeDemand := []) capturedContext tailContext) := by
  apply RecordPendingRows.live (known := show contracts 0 = some (contract 0) from rfl)
    (actionKnown := show actions 0 = some rights from rfl)
    (inputAnnotation := rfl) (answerAnnotation := rfl) (callerScope := ⟨.none, .none⟩)
    (held := rfl) (answer := Or.inr rfl)
  · exact .unwind
  · exact ResumeBodyAgreement.capture savedReq []
  · exact savedRows
  · exact tailRows

theorem callerSource : SourcePlannedSources.Context operations policy contracts [] (fun _ => none) [] frontData.scope frontData.context
    .unit .unit [1] (.invoke ⟨1, .resume⟩ [] []) (.invoke (key := ⟨1, .resume⟩)) :=
  .resume (show contracts 1 = some (contract 1) from rfl) rfl rfl (by simp [contract]) (by intro x member; cases member)

theorem callerAuth : AuthContext operations policy ports owners emptyRows callerSource .unit .unit .invoke :=
  .resume (known := show contracts 1 = some (contract 1) from rfl) (resolved := rfl) (permission := rfl)
    (admitted := by simp [contract]) (formed := by intro x member; cases member)

theorem callerCertified : SourcePlannedChecks.Certified (evidence := declarationPolicy) [] []
    (SourceDeclarationPlans.Plan.invoke (key := ⟨1, .resume⟩)) := .invoke (evidence := declarationPolicy)

theorem frontSource : Source front (.value .unit) (.value .unit) [1] frontReq (.plain (.invoke ⟨1, .resume⟩) .nil) :=
  .push (.ordinary (.plain callerSource (.bound rfl) rfl rfl callerCertified)) .nil

theorem frontRows : Rich frontSource (.value .unit) (.value .unit) frontContext :=
  .push (.ordinary (.plain (scopeKnown := .bound rfl) (inputAnnotation := rfl) (outputAnnotation := rfl)
    (certified := callerCertified) callerAuth)) .nil

def executableRoot : Requirements [0, 1] :=
  resumeExecutionRoot tables 0 front tail .unit .none savedReq empty liveReq

theorem execution : ResumeExecution tables 0 front captured tail .unit .none frontContext
    savedReq frontReq liveReq executableRoot :=
  .unwind (metadata := .plain .nil) rfl rfl

theorem rootChecked : RecursiveRequirements.Checked (annotateDisposalStore resumes) []
    (OwnerPhaseTransitions.available (ownedTickets whole)) (annotateDisposals executableRoot) [] := by
  apply RecursiveRequirements.evaluate_sound
  simp [executableRoot, resumeExecutionRoot, resumeExecutionBody, savedReq, liveReq, tailReq, empty,
    whole, front, captured, tail, ownedTickets, Stack.append, annotateDisposals, RecursiveRequirements.evaluate,
    RecursiveRequirements.evaluateFuel, RecursiveRequirements.Requirements.prepend, PhaseRechecking.checkOwners,
    OwnerPhaseTransitions.available, OwnerPhaseTransitions.spendAll, OwnerPhaseTransitions.spend,
    OwnerSource.exportAt, ProtectionResiduals.residual_empty, ProtectionResiduals.merge]

theorem resumeRecords : ∀ key body, (key, body) ∈ resumes →
    PlannedResumeAnnotated operations policy contracts tables families required [] actions annotations [] whole key body := by
  intro key body member
  have same := List.mem_singleton.mp member
  cases Prod.mk.inj same with
  | intro keySame bodySame =>
    cases keySame
    cases bodySame
    exact .resume (.push .here) (show contracts 0 = some (contract 0) from rfl) rfl savedSource (Or.inr rfl)

theorem disposalRecords : ∀ key body, (key, body) ∈ disposals →
    PlannedUnwindAnnotated operations policy contracts tables families required [] actions annotations [] whole key body := by
  intro key body member
  cases member

theorem storesAnnotated : SourceDependencyAnnotations.StoreAnnotation (resumes ++ disposals) resumes :=
  .cons .original .nil

def afterStack : Stack := captured.append (front.append (.spent 0 .unit .none tail))
def afterContext := capturedContext.append (frontContext.append (.spent (owner := 0) tailContext))

theorem authenticated_resume_owned :
    ∃ demand, ∃ requirements : Requirements demand,
    ∃ source : Source afterStack (.value .unit) (.value .unit) demand requirements
      (.running (.plain (.invoke ⟨1, .resume⟩) (.spent 0 (.live 1 .nil (.running .nil))))),
      RecordPendingRows operations policy contracts tables families required [] actions [] ports owners emptyRows
        (RecursiveTransport.removeOwner 0 resumes) source (.value .unit) (.value .unit) afterContext ∧
      RecursiveRequirements.Checked (annotateDisposalStore (RecursiveTransport.removeOwner 0 resumes)) []
        (OwnerPhaseTransitions.available (ownedTickets afterStack)) (annotateDisposals requirements) [] ∧
      demand.Perm (ownedTickets afterStack) ∧ [0, 1].Perm (ownedTickets whole) := by
  exact RecordPendingRows.resume_execution_owned
    (contract := contract 0) (known := rfl) (recorded := savedReq)
    (frontSource := frontSource) (liveSource := liveSource) (frontContext := frontContext)
    (capturedContext := capturedContext) (tailContext := tailContext)
    frontRows liveRows rfl rfl execution resumeRecords disposalRecords
    storesAnnotated (by decide) rootChecked


def currentRows := Rows.sequence .pure (Rows.invoke (key := ⟨0, .resume⟩))
def wholeContext := frontContext.append (.live (owner := 0) (resumeDemand := []) capturedContext tailContext)

