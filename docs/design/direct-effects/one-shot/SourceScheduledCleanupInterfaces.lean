namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked evaluate)
open SourceDependencyAnnotations (Dependencies RowAnnotation RequirementPath)
open SourcePlannedTyping (Value)
open SourcePlanSignatures (Signature)
open OwnerPhaseTransitions (spendAll)

/-- Decompose the actual source and check its generated split, retaining the
whole predecessor annotation. Both views use the same source witnesses. -/
theorem focus_generated_annotated
    (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      whole output demand requirements checking)
    (focus : Focus whole child position)
    (annotation : RowAnnotation requirements annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) row) :
    ∃ (input : Value) (childDemand restDemand : List Nat),
    ∃ current : Requirements childDemand, ∃ rest : Requirements restDemand,
    ∃ childDependencies restDependencies,
    ∃ childSignature : Signature childDependencies, ∃ restSignature : Signature restDependencies,
      SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        child input childDemand current childSignature ∧
      SourcePlannedSources.Context operations policy contracts world environment allowed scope
        position input output restDemand rest restSignature ∧
      SourcePlannedSources.FocusSignature checking childSignature restSignature ∧
      demand = childDemand ++ restDemand ∧
      ∃ nextAnnotated : Requirements (childDemand ++ restDemand), ∃ nextRow,
        RowAnnotation (.sequence current rest) nextAnnotated ∧
        RequirementPath annotated nextAnnotated [] ∧
        RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
        Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row := by
  obtain ⟨input, childDemand, restDemand, current, rest, childDependencies, restDependencies,
    childSignature, restSignature, childSource, context, split, same, evaluation⟩ :=
    SourcePlannedSources.focus_decompose_disposals source focus
  obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked checked
  have splitCheck : Checked entries receiving before (annotateDisposals (.sequence current rest)) normalRow := by
    apply RecursiveRequirements.evaluate_sound
    simpa only [annotateDisposals, RecursiveRequirements.evaluate_sequence] using
      (evaluation entries receiving before).2.symm.trans (RecursiveRequirements.checked_complete normalCheck)
  have aligned : (childDemand ++ restDemand).Perm demand := by rw [same]
  exact ⟨input, childDemand, restDemand, current, rest, childDependencies, restDependencies,
    childSignature, restSignature, childSource, context, split, same,
    .choice (.sequence current rest) annotated aligned, normalRow ++ row,
    .alternatives .original aligned, .no .here, .no .here, .choice splitCheck checked,
    List.append_subset.mpr ⟨within, List.Subset.refl _⟩⟩

/-- Rebuild the actual rich source from its typed evaluation context and child.
Generated checks compose in order and the entire previous certificate survives. -/
theorem plug_generated_annotated
    (context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
      position input output restDemand rest checking)
    (child : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      code input childDemand current childChecking)
    (annotation : RowAnnotation (.sequence current rest) annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) row) :
    ∃ combined : Requirements (childDemand ++ restDemand), ∃ dependencies,
    ∃ checking : Signature dependencies,
      SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        (position.plug code) output (childDemand ++ restDemand) combined checking ∧
      ∃ nextAnnotated : Requirements (childDemand ++ restDemand), ∃ nextRow,
        RowAnnotation combined nextAnnotated ∧ RequirementPath annotated nextAnnotated [] ∧
        RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
        Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row := by
  obtain ⟨combined, dependencies, checking, source, evaluation⟩ :=
    SourcePlannedSources.context_plug_disposals context child
  obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked checked
  have nextCheck : Checked entries receiving before (annotateDisposals combined) normalRow := by
    apply RecursiveRequirements.evaluate_sound
    rw [(evaluation entries receiving before).2]
    simpa only [annotateDisposals, RecursiveRequirements.evaluate_sequence] using
      RecursiveRequirements.checked_complete normalCheck
  exact ⟨combined, dependencies, checking, source,
    .choice combined annotated (.refl _), normalRow ++ row,
    .alternatives .original (.refl _), .no .here, .no .here, .choice nextCheck checked,
    List.append_subset.mpr ⟨within, List.Subset.refl _⟩⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
