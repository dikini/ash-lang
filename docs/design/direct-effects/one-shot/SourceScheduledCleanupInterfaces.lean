namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements)

/-- The two fragments of one actual retained source. The saved demand and
requirements belong to the same source witness used by the clause binder;
no independently chosen demand or ownership equation is stored here. -/
structure CaptureSourceAt
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    (captured : Context captureHints) (tail : Context tailHints) where
  capturedStack : Stack
  tailStack : Stack
  boundary : PlannedModeValue
  boundaryRows : ModeRowsValue boundary
  savedDemand : List Nat
  tailDemand : List Nat
  savedRequirements : Requirements savedDemand
  tailRequirements : Requirements tailDemand
  savedSource : PlannedModeSource operations policy contracts tables families required outward actions world
    capturedStack (.value site.result) boundary savedDemand savedRequirements captureScope
  tailSource : PlannedModeSource operations policy contracts tables families required outward actions world
    tailStack boundary output tailDemand tailRequirements tailScope
  savedRows : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes savedSource (.value site.resultRows) boundaryRows captured
  tailRows : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes tailSource boundaryRows outputRows tail
  stackSplit : site.stack = capturedStack.append tailStack
  demandSplit : site.pendingDemand = savedDemand ++ tailDemand

/-- Reuse rich-source splitting at the exact lexical cut. Captured source
annotation and endpoint metadata are selected together. -/
theorem ExecutionSite.capture_source
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (cut : Cut effect operation site.context captured tail contract modes) :
    Nonempty (CaptureSourceAt site captured tail) := by
  obtain ⟨capturedStack, tailStack, boundary, boundaryRows, savedDemand, tailDemand,
    savedRequirements, tailRequirements, savedSource, tailSource, stackSplit,
    savedRows, tailRows, demandSplit, _evaluation, _annotatedEvaluation⟩ :=
    site.coherent.split_disposals captured tail cut.decomposition
  exact ⟨⟨capturedStack, tailStack, boundary, boundaryRows, savedDemand, tailDemand,
    savedRequirements, tailRequirements, savedSource, tailSource, savedRows, tailRows,
    stackSplit, demandSplit⟩⟩

/-- The existing finite clause schema compiles with the demand of this exact
captured source. It checks selected clause syntax, not a supplied successor
state, and does not quantify over unrelated demand annotations. -/
theorem CaptureSourceAt.compile_clause
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    {family : Nat → SourceDependencyAnnotations.Dependencies}
    {bodies : ∀ owner, Signature (family owner)} {bodyRows : ∀ owner, Rows (bodies owner)}
    (split : CaptureSourceAt site captured tail)
    (_selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
    (schema : SourceAdmission.ClauseSchema outward actions budget phases world installations owner rights
      contract split.savedDemand captured tail (bodyRows owner)
      (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail))
    (expression : site.expression = .perform (Instantiation.freezeEffect effect) operation operand)
    (cut : Cut effect operation site.context captured tail contract modes)
    (fresh : actions owner = none) (consumed : phases owner = .consumed) :
    SourceAdmission.Code outward (actions.insert owner rights) budget
      (OwnerPhaseTransitions.introduce phases owner) world installations (bodyRows owner)
      (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail) := by
  obtain ⟨requested, effectEq, request⟩ :=
    site.current.previous.authenticated.request_certificate expression site.current.certificate
  have realization : Instantiation.EffectRealizes Instantiation.Environment.empty
      (Instantiation.freezeEffect effect) requested := by
    rw [effectEq]
    exact Instantiation.frozen_effect_realizes _ _
  have same := Instantiation.frozen_effect_cannot_change realization
  subst requested
  exact schema.compile_at_cut request site.retained cut fresh consumed

/-- A resumptive clause with a value prefix supplies its finite source schema
for this actual capture. General clause admission still has to retain such
schemas for all supported source forms. -/
theorem CaptureSourceAt.own_resume_clause
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    (split : CaptureSourceAt site captured tail)
    (selected : CapturedClauseRows effect operation captureScope.held captured
      (fun owner => Rows.sequence Rows.pure (Rows.invoke (key := ⟨owner, .resume⟩))))
    (expression : site.expression = .perform (Instantiation.freezeEffect effect) operation operand)
    (cut : Cut effect operation site.context captured tail contract modes)
    (fresh : actions owner = none) (consumed : phases owner = .consumed)
    (permission : rights.resume = true) :
    SourceAdmission.Code outward (actions.insert owner rights) budget
      (OwnerPhaseTransitions.introduce phases owner) world installations
      (Rows.sequence Rows.pure (Rows.invoke (key := ⟨owner, .resume⟩)))
      (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail) :=
  split.compile_clause selected (.sequence .pure (.ownResume permission)) expression cut fresh consumed

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.capture_source
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CaptureSourceAt.compile_clause
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CaptureSourceAt.own_resume_clause

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open SourcePlannedChecks (Certified)
open RecursiveRequirements (Requirements)
open OwnerPhaseTransitions (available)

theorem ExecutionSite.leave_clause
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (closed : ClosedValue site.expression)
    (stackEq : site.stack = .spent owner answer caller tail)
    (waiting : Accounting.Wait world installations site.context .ordinary (root : Requirements demand)) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
      next.expression = site.expression ∧ next.runtimeScope = caller ∧ next.stack = tail ∧
      (∃ nextRoot : Requirements demand, root = .sequence (.spent owner) nextRoot ∧
        Accounting.Wait world installations next.context .ordinary nextRoot) ∧
      (∀ annotations, SourceDependencySchemes.Closing.Bound annotations site.receiving →
        SourceDependencySchemes.Closing.Bound annotations next.receiving) := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at stackEq closed waiting ⊢
  subst stack
  cases coherent with
  | spent remaining =>
    rename_i contract restScope restHints restContext known annotationType callerKnown tailRequirements suffix
    cases retained with | spent tailCertificate =>
      cases waiting with | spent tailWaiting =>
        have returned := (current.previous.authenticated.value_summary closed.1).value_context closed.1 [] caller
        let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
            resumes budget ports owners emptyRows output outputRows :=
          { expression := expression, runtimeScope := caller, stack := tail,
            result := contract.answer, resultRows := (owners owner contract known).2, allowed := [],
            dependencies := .pure, plan := .pure, rows := .pure,
            sourceDemand := [], sourceRequirements := .request [] [],
            receiving := restScope, hints := restHints, context := restContext,
            current := SourceAdmission.Admitted.of_source _ returned .pure remaining.forget.source,
            certified := Certified.pure (evidence := declarationPolicy), scopeTyped := callerKnown,
            pendingDemand := pendingDemand, pendingRequirements := tailRequirements,
            pending := suffix, coherent := remaining, retained := tailCertificate, currentResource := .pure,
                  retainedResource := by cases retainedResource <;> assumption }
        refine ⟨next, rfl, rfl, rfl, ⟨_, rfl, tailWaiting⟩, ?_⟩
        intro annotations bounded
        cases bounded with | spent rest => exact rest

theorem ExecutionSite.leave_handler
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (closed : ClosedValue site.expression)
    (stackEq : site.stack = .push (.handler handler) tail)
    (waiting : Accounting.Wait world installations site.context .ordinary (root : Requirements demand)) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
      next.expression = site.expression ∧ next.runtimeScope = handler.scope ∧ next.stack = tail ∧
      Accounting.Wait world installations next.context .ordinary root ∧
      (∀ annotations, SourceDependencySchemes.Closing.Bound annotations site.receiving →
        SourceDependencySchemes.Closing.Bound annotations next.receiving) := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at stackEq closed waiting ⊢
  subst stack
  cases coherent with
  | push head remaining =>
    cases head with
    | ordinary frame =>
      cases frame with
      | handler authenticated =>
        cases retained with | handler tailCertificate =>
          cases waiting with | handler tailWaiting =>
            rename_i restScope restHints restContext tailDemand tailRequirements residual plans declarationRows
              scopeKnown coverage unique recipes capabilities modes clauseCertified valueAnnotation suffix clauses declarations
            have returned := (current.previous.authenticated.value_summary closed.1).value_context closed.1 [] handler.scope
            let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
                resumes budget ports owners emptyRows output outputRows :=
              { expression := expression, runtimeScope := handler.scope, stack := tail,
                result := result, resultRows := resultRows, allowed := [],
                dependencies := .pure, plan := .pure, rows := .pure,
                sourceDemand := [], sourceRequirements := .request [] [],
                receiving := restScope, hints := restHints, context := restContext,
                current := SourceAdmission.Admitted.of_source _ returned .pure remaining.forget.source,
                certified := Certified.pure (evidence := declarationPolicy), scopeTyped := scopeKnown,
                pendingDemand := tailDemand, pendingRequirements := tailRequirements,
                pending := suffix, coherent := remaining, retained := tailCertificate, currentResource := .pure,
                  retainedResource := by cases retainedResource <;> assumption }
            refine ⟨next, rfl, rfl, rfl, tailWaiting, ?_⟩
            intro annotations bounded
            cases bounded with | handler rest => exact rest

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open OwnerPhaseTransitions (available)

theorem ExecutableState.leave_handler
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    LexicalUnwind.Event
      ⟨.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩, issued, completed⟩
      ⟨.eval ⟨value, handler.scope, tail⟩, issued, completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, handler.scope, tail⟩, issued, completed⟩, actions⟩ := by
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.eval ⟨value, handler.scope, tail⟩) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩ = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
        obtain ⟨expression, _runtime, stackSame⟩ := ScopedExecution.Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
        have closedSite : ClosedValue site.expression := by simpa only [← expression] using closed
        obtain ⟨next, expressionSame, scopeSame, nextStack, waiting, nextBound⟩ :=
          site.leave_handler closedSite stackSame.symm (rooted.value_wait closedSite.1)
        have ownersSame : ownedTickets next.stack = ownedTickets site.stack := by
          rw [nextStack, ← stackSame]
          rfl
        have nextPhase := phaseAgreement.trans (congrArg available ownersSame.symm)
        have certified := ExecutableSource.eval next nextPhase (.contextualValue (by rw [expressionSame]; exact closedSite.1) waiting)
          (nextBound annotations bound) annotation checked bounded
        simpa only [expressionSame, scopeSame, nextStack, ← expression] using certified
    | unwind => cases machineEq
  have checks : AccessChecks ⟨value, runtimeScope, .push (.handler handler) tail⟩ ambient := by
    constructor
    · intro identity payload answer savedScope current returned rest same closed
      cases same
    · intro requested operation operand current stack cap outside handler same cut operandClosed
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
    · intro binder owner current caller input answer front cap outside plan same resolve built
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
  obtain ⟨event, ledger, registry, resources⟩ :=
    LexicalUnwind.value_step_ledger_resources
      (RawStep.leaveHandler handler value closed runtimeScope tail) closed.1 checks state.ledger state.registry state.resources
  simp only [List.nil_append] at event ledger
  refine ⟨event, nextSource, ?_, ?_, state.storeAnnotation, ledger, registry, resources, ?_, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
        cases located with
        | push rest => exact .resume rest known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
        cases located with
        | push rest => exact .dispose rest held recorded source
  · intro activation member
    exact state.activations (List.mem_cons_of_mem _ member)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.leave_handler

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open OwnerPhaseTransitions (available)

theorem ExecutableState.leave_clause
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    LexicalUnwind.Event
      ⟨.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩, issued, completed⟩
      ⟨.eval ⟨value, caller, tail⟩, issued, completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, caller, tail⟩, issued, completed⟩, actions⟩ := by
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.eval ⟨value, caller, tail⟩) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩ = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
        obtain ⟨expression, _runtime, stackSame⟩ := ScopedExecution.Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
        have closedSite : ClosedValue site.expression := by simpa only [← expression] using closed
        obtain ⟨next, expressionSame, scopeSame, nextStack, ⟨nextRoot, rootSame, waiting⟩, nextBound⟩ :=
          site.leave_clause closedSite stackSame.symm (rooted.value_wait closedSite.1)
        have ownersSame : ownedTickets next.stack = ownedTickets site.stack := by
          rw [nextStack, ← stackSame]
          rfl
        have nextPhase := phaseAgreement.trans (congrArg available ownersSame.symm)
        rw [rootSame] at annotation
        obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked checked
        obtain ⟨_, tailRow, _, tailCheck, rowSame⟩ := RecursiveRequirements.checked_sequence_parts normalCheck
        have tailBoundRow := (rowSame ▸ List.subset_append_right _ _).trans normalBound
        have certified := ExecutableSource.eval next nextPhase (.contextualValue (by rw [expressionSame]; exact closedSite.1) waiting)
          (nextBound annotations bound) .original tailCheck (tailBoundRow.trans bounded)
        simpa only [expressionSame, scopeSame, nextStack, ← expression] using certified
    | unwind => cases machineEq
  have checks : AccessChecks ⟨value, runtimeScope, .spent owner answer caller tail⟩ ambient := by
    constructor
    · intro identity payload answer savedScope current returned rest same closed
      cases same
    · intro requested operation operand current stack cap outside handler same cut operandClosed
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
    · intro binder owner current caller input answer front cap outside plan same resolve built
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
  obtain ⟨event, ledger, registry, resources⟩ :=
    LexicalUnwind.value_step_ledger_resources
      (RawStep.leaveClause owner answer value closed runtimeScope caller tail) closed.1 checks state.ledger state.registry state.resources
  simp only [List.nil_append] at event ledger
  refine ⟨event, nextSource, ?_, ?_, state.storeAnnotation, ledger, registry, resources, ?_, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
        cases located with
        | spent rest => exact .resume rest known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
        cases located with
        | spent rest => exact .dispose rest held recorded source
  · exact state.activations

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
