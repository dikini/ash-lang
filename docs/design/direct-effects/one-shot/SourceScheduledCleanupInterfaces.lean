/-- Local providers discharge their own requests; the remaining finite list is
checked at the enclosing declaration's receiving suffix. -/
def externalRequirements (provided : List Nat) (required : List Requirement) : List Requirement :=
  outwardRequirements (providerScope provided .nil) required

private theorem provided_of_not_reaches
    (blocked : reaches effect (providerScope provided .nil) = false) :
    ∃ identity ∈ provided, effect = .cell identity := by
  induction provided with
  | nil => cases blocked
  | cons identity rest ih =>
      simp only [providerScope, reaches] at blocked
      split at blocked
      next same => exact ⟨identity, List.mem_cons_self, same⟩
      next different =>
        obtain ⟨id, member, same⟩ := ih blocked
        exact ⟨id, List.mem_cons_of_mem _ member, same⟩

theorem provider_requirements
    (supplied : checkRequirements scope (externalRequirements provided required) = true) :
    checkRequirements (providerScope provided scope) required = true := by
  apply SourceContextualRequirements.check_requirements_iff.mpr
  intro request member
  by_cases passed : reaches request.1 (providerScope provided .nil) = true
  · exact SourceContextualRequirements.provider_capability provided
      (SourceContextualRequirements.check_requirements_iff.mp supplied request (List.mem_filter.mpr ⟨member, passed⟩))
  · obtain ⟨identity, present, same⟩ := provided_of_not_reaches (Bool.eq_false_iff.mpr passed)
    rw [same]
    exact SourceContextualRequirements.provider_member present

/-- Structural annotations extend the established consuming recipes. Prefixes
and callbacks carry existing request footprints; no constructor accepts Local,
Pending, or a proof about successful future execution. -/
inductive ClauseRecipe (outward : List Instance) (rights : Syntax.OneShotRights) :
    List Requirement → (Nat → Dependencies) → (provided : List Nat := []) → Prop where
  | existing (recipe : SourceContextualRequirements.Recipe outward rights required family provided) :
      ClauseRecipe outward rights required family provided
  | sequence {checking : Signature initialCode}
      (initial : Footprint checking needed) (body : ClauseRecipe outward rights required family provided) :
      ClauseRecipe outward rights (externalRequirements provided needed ++ required)
        (fun owner => .sequence initialCode (family owner)) provided
  | cleanup {checking : Signature callbackCode}
      (callback : Footprint checking needed) (body : ClauseRecipe outward rights required family provided) :
      ClauseRecipe outward rights (externalRequirements provided needed ++ required)
        (fun owner => .cleanup needs callbackCode (family owner)) provided
  | resource {family : Nat → Nat → Dependencies}
      (body : ∀ identity, ClauseRecipe outward rights required (fun owner => family owner identity) (identity :: provided)) :
      ClauseRecipe outward rights required (fun owner => .resource (family owner)) provided
  | suffix {checking : Signature suffixCode}
      (body : ClauseRecipe outward rights required family provided)
      (continuation : Footprint checking needed) :
      ClauseRecipe outward rights (required ++ externalRequirements provided needed)
        (fun owner => .sequence (family owner) suffixCode) provided
  | choice (left : ClauseRecipe outward rights firstRequired first provided)
      (right : ClauseRecipe outward rights secondRequired second provided) :
      ClauseRecipe outward rights (firstRequired ++ secondRequired)
        (fun owner => .choice (first owner) (second owner)) provided

/-- Compile complete consuming clauses, including effectful cleanup nested
inside resources and branches. The primitive interface stays independent. -/
theorem ClauseRecipe.compile {captured : ReturnHints capturedScope} {tail : ReturnHints tailScope}
    (recipe : ClauseRecipe outward rights required family provided)
    (supplied : checkRequirements tailScope required = true)
    (resume : rights.resume = true → Local outward actions phases world (.invoke ⟨owner, .resume⟩)
      (.live (owner := owner) captured tail))
    (dispose : rights.dispose = true → Local outward actions phases world (.invoke ⟨owner, .dispose⟩)
      (.live (owner := owner) captured tail)) :
    Local outward actions phases world (family owner) (providerHints provided (.live (owner := owner) captured tail)) := by
  induction recipe generalizing world with
  | existing original =>
      exact SourceContextualRequirements.Lexical.Recursive.compile_recipe_providers original
        (SourceContextualRequirements.check_requirements_iff.mp supplied) resume dispose
  | sequence initial body ih =>
      simp only [checkRequirements, List.all_append, Bool.and_eq_true] at supplied
      apply Local.sequence
      · apply compile_footprint initial
        apply SourceScheduledAdaptationCompilation.requirements_prefix (front := .plain _ .nil) (fun _ => rfl)
        apply provider_requirements
        exact SourceScheduledAdaptationCompilation.requirements_prefix (front := .live owner capturedScope .nil)
          (fun _ => rfl) supplied.1
      · exact ih supplied.2 resume dispose
  | cleanup callback body ih =>
      simp only [checkRequirements, List.all_append, Bool.and_eq_true] at supplied
      apply cleanup_admission callback _ (ih supplied.2 resume dispose)
      apply provider_requirements
      exact SourceScheduledAdaptationCompilation.requirements_prefix (front := .live owner capturedScope .nil)
        (fun _ => rfl) supplied.1
  | resource body ih =>
      apply Local.resource
      intro identity fresh
      exact ih identity supplied
        (fun permission => SourceDependencySchemes.Lexical.Recursive.local_transport (resume permission)
          (fun _ ready => ready) (fun _ _ known => known) (List.subset_append_left _ _))
        (fun permission => SourceDependencySchemes.Lexical.Recursive.local_transport (dispose permission)
          (fun _ ready => ready) (fun _ _ known => known) (List.subset_append_left _ _))
  | suffix body continuation ih =>
      simp only [checkRequirements, List.all_append, Bool.and_eq_true] at supplied
      apply SourcePlainSuffixTransport.plain_suffix_admission continuation
      · apply provider_requirements
        exact SourceScheduledAdaptationCompilation.requirements_prefix
          (front := .live owner capturedScope .nil) (fun _ => rfl) supplied.2
      · exact ih supplied.1 resume dispose
  | choice left right ihLeft ihRight =>
      simp only [checkRequirements, List.all_append, Bool.and_eq_true] at supplied
      exact .choice (ihLeft supplied.1 resume dispose) (ihRight supplied.2 resume dispose)

inductive DeclarationModes (outward : List Instance) (rights : Syntax.OneShotRights) :
    List Requirement → Option (Nat → Dependencies) → Prop where
  | unavailable : DeclarationModes outward rights [] none
  | available (recipe : ClauseRecipe outward rights required family) :
      DeclarationModes outward rights required (some family)

/-- Both offered modes retain the actual clause's action rights. These are
source annotations; raw code/dependency authentication remains independent. -/
inductive ClauseDeclarations (outward : List Instance) :
    Clauses → ClauseDependencies → List Requirement → Prop where
  | nil : ClauseDeclarations outward .nil [] []
  | cons (ordinary : DeclarationModes outward body.requiredActions ordinaryRequired ordinaryFamily)
      (protectedMode : DeclarationModes outward body.requiredActions protectedRequired protectedFamily)
      (rest : ClauseDeclarations outward clauses families restRequired) :
      ClauseDeclarations outward (.cons operation parameter binder body clauses)
        ((operation, ordinaryFamily, protectedFamily) :: families)
        (ordinaryRequired ++ protectedRequired ++ restRequired)

theorem DeclarationModes.of_existing
    (source : SourceContextualRequirements.ModeRecipe outward rights required family) :
    DeclarationModes outward rights required family := by
  cases source with
  | unavailable => exact .unavailable
  | available recipe => exact .available (.existing recipe)

theorem ClauseDeclarations.of_existing
    (source : SourceContextualRequirements.DeclarationRecipes outward clauses families required) :
    ClauseDeclarations outward clauses families required := by
  induction source with
  | nil => exact .nil
  | cons ordinary protectedMode rest ih => exact .cons (.of_existing ordinary) (.of_existing protectedMode) ih

theorem DeclarationModes.selected (recipe : DeclarationModes outward rights required alternative)
    (found : alternative = some family) : ClauseRecipe outward rights required family := by
  subst alternative
  cases recipe with | available body => exact body

theorem ClauseDeclarations.selected (recipes : ClauseDeclarations outward clauses families required)
    (selected : ClauseAt operation clauses parameter binder code)
    (found : (lookupDependencies operation families).bind (modeDependencies held) = some family) :
    ∃ needed, ClauseRecipe outward code.requiredActions needed family ∧ needed ⊆ required := by
  induction selected generalizing families required with
  | hit => cases recipes with
    | cons ordinary protectedMode rest =>
      simp only [lookupDependencies, if_true, Option.bind_some] at found
      cases held with
      | false => exact ⟨_, ordinary.selected found,
          fun _ member => List.mem_append_left _ (List.mem_append_left _ member)⟩
      | true => exact ⟨_, protectedMode.selected found,
          fun _ member => List.mem_append_left _ (List.mem_append_right _ member)⟩
  | pass different next ih => cases recipes with
    | cons ordinary protectedMode rest =>
      obtain ⟨needed, recipe, included⟩ := ih rest
        (by simpa only [lookupDependencies, if_neg different] using found)
      exact ⟨needed, recipe, fun _ member => List.mem_append_right _ (included member)⟩

theorem ClauseDeclarations.substitution (recipes : ClauseDeclarations outward clauses families required)
    (value : replacement.IsValue) (name : Nat) :
    ClauseDeclarations outward (clauses.subst name replacement) families required := by
  induction recipes with
  | nil => exact .nil
  | cons ordinary protectedMode rest ih =>
      simp only [Clauses.subst]
      split
      · exact .cons ordinary protectedMode ih
      · exact .cons
          (by simpa only [Code.substitution_required_actions _ name value] using ordinary)
          (by simpa only [Code.substitution_required_actions _ name value] using protectedMode) ih

theorem ClauseDeclarations.instantiation (recipes : ClauseDeclarations outward clauses families required)
    (environment : Instantiation.Environment) :
    ClauseDeclarations outward (clauses.instantiate environment) families required := by
  induction recipes with
  | nil => exact .nil
  | cons ordinary protectedMode rest ih =>
      exact .cons
        (by simpa only [Code.instantiation_required_actions] using ordinary)
        (by simpa only [Code.instantiation_required_actions] using protectedMode) ih

/-- Store source declarations at installation using their finite lexical
requirements. No future selected-clause check is provided. -/
theorem ClauseDeclarations.install {hints : ReturnHints scope}
    (declarations : ClauseDeclarations outward handler.clauses (families handler) (required handler))
    (supplied : checkRequirements scope (required handler) = true)
    (matching : ReturnHints.Matches tables families hints stack)
    (retained : Pending outward actions phases world hints .nil mode finalMode)
    (stored : ∀ installed ∈ handlers stack,
      ClauseDeclarations outward installed.clauses (families installed) (required installed))
    (checked : checkForest required stack scope .nil = true) :
    ReturnHints.Matches tables families
      (.handler (effect := handler.effectInst) (table := tables handler) (families := families handler) hints)
      (.push (.handler handler) stack) ∧
    Pending outward actions phases world
      (.handler (effect := handler.effectInst) (table := tables handler) (families := families handler) hints)
      .nil mode finalMode ∧
    (∀ installed ∈ handlers (.push (.handler handler) stack),
      ClauseDeclarations outward installed.clauses (families installed) (required installed)) ∧
    checkForest required (.push (.handler handler) stack)
      (.handler handler.effectInst (tables handler) (families handler) scope) .nil = true := by
  refine ⟨.handler matching, .handler retained, ?_, ?_⟩
  · intro installed member
    simp only [handlers, SourceContextualRechecking.frameHandlers, List.cons_append, List.nil_append,
      List.mem_cons] at member
    rcases member with rfl | member
    · exact declarations
    · exact stored installed member
  · simpa only [checkForest, SourceContextualRechecking.checkFrame,
      SourceDependencyProjection.scope_append_nil, checked, Bool.and_true] using supplied

/-- Actual capture selects and compiles the stored structural clause, including
its effectful cleanup. It preserves the same declaration evidence and finite
scope checks; no selected-body or primitive-successor check is assumed. -/
theorem capture_declared_clause {hints : ReturnHints wholeScope}
    (cut : HandlerCut requested whole capture tail handler)
    (matching : ReturnHints.Matches tables families hints whole)
    (retained : Pending outward actions phases world hints .nil .ordinary finalMode)
    (request : Local outward actions phases world (.request requested operation) hints)
    (recipes : ∀ installed ∈ handlers whole,
      ClauseDeclarations outward installed.clauses (families installed) (required installed))
    (checked : checkForest required whole wholeScope .nil = true)
    (modes : SourceTemplates.ClauseModes handler.clauses (tables handler))
    (selected : ClauseAt operation handler.clauses parameter binder code)
    (offeredKnown : lookup operation (tables handler) = some offered)
    (fresh : actions owner = none) (consumed : phases owner = .consumed) :
    ∃ capturedScope tailScope, ∃ capturedHints : ReturnHints capturedScope,
    ∃ tailHints : ReturnHints tailScope, ∃ family,
      wholeScope = capturedScope.append tailScope ∧
      (lookupDependencies operation (families handler)).bind (modeDependencies capturedScope.held) = some family ∧
      ReturnHints.Matches tables families (.live (owner := owner) capturedHints tailHints)
        (.live owner input answer capture caller tail) ∧
      Local outward (actions.insert owner code.requiredActions) (introduce phases owner) world
        (family owner) (.live (owner := owner) capturedHints tailHints) ∧
      Pending outward (actions.insert owner code.requiredActions) (introduce phases owner) world
        (.live (owner := owner) capturedHints tailHints) .nil .ordinary finalMode ∧
      checkForest required (.live owner input answer capture caller tail) (.live owner capturedScope tailScope) .nil = true ∧
      (∀ installed ∈ handlers (.live owner input answer capture caller tail),
        ClauseDeclarations outward installed.clauses (families installed) (required installed)) := by
  obtain ⟨capturedScope, tailScope, capturedHints, tailHints, family, sameScope, familyKnown,
    matched, resumeLocal, disposeLocal, nextPending, supplied, forestChecked⟩ :=
    SourceContextualCapture.Lexical.Recursive.capture_clause_interface cut matching retained request checked modes selected offeredKnown fresh consumed
  obtain ⟨needed, recipe, included⟩ :=
    (recipes handler (SourceContextualCapture.Lexical.Recursive.handler_member cut)).selected selected familyKnown
  refine ⟨_, _, capturedHints, tailHints, family, sameScope, familyKnown, matched,
    recipe.compile (SourceContextualRequirements.check_requirements_subset included supplied) resumeLocal disposeLocal,
    nextPending, forestChecked, ?_⟩
  intro installed member
  apply recipes installed
  rw [handler_cut_reconstructs cut, SourceContextualRechecking.handlers_append]
  exact member

namespace DeclarationExamples

def callback : Dependencies := .sequence .pure (.request (.cell 42) 1)
def family (owner : Nat) : Dependencies :=
  .sequence .pure (.cleanup [.cell 42] callback (.sequence .pure (.invoke ⟨owner, .resume⟩)))
def code : Code := .cleanup (.lambda 5 (.perform (.cell (.activation 42)) 1 (.integer 0))) (.resume 9 .unit)
def clauses : Clauses := .cons 0 1 9 code .nil

def handler : HandlerData := ⟨102, .user 103 [], clauses, .none, .unit, by decide⟩
def tables : CallableProtectionFrames.Tables := fun _ => [(0, ⟨false, some [], some []⟩)]
def families : SourceDependencyCapture.Families := fun _ => [(0, some family, some family)]
def required : SourceContextualRechecking.Required := fun _ => [(.cell 42, 1), (.cell 42, 1)]
def receiver := Stack.push (.cell 42 0 .none .unit) .nil
def captured := Stack.push (.handler handler) .nil

theorem recipe : ClauseRecipe [] code.requiredActions [(.cell 42, 1)] family := by
  apply ClauseRecipe.sequence (checking := .pure) Footprint.pure
  apply ClauseRecipe.cleanup (provided := []) (required := []) (callbackCode := callback)
    (checking := .sequence .pure .request) (.sequence .pure Footprint.request)
  exact .existing (.silent (.resume rfl) .pure)

theorem declarations : ClauseDeclarations [] handler.clauses (families handler) (required handler) :=
  .cons (.available recipe) (.available recipe) .nil

/-- The finite installation check and stored source declarations feed actual
capture. The selected effectful-cleanup clause is compiled without supplying
its Local judgment or the primitive successor checks. This tests the dependency
facet; raw source/dependency typing remains an independent obligation. -/
theorem installed_cleanup_clause_captured :
    ∃ hints : ReturnHints (.live 7
      (.handler handler.effectInst (tables handler) (families handler) .nil) (.cell 42 .nil)),
      ReturnHints.Matches tables families hints (.live 7 .unit .unit captured .none receiver) ∧
      Local [] (Syntax.UsageTickets.insert (fun _ => none) 7 code.requiredActions)
        (introduce (fun _ => .consumed) 7) [42] (family 7) hints ∧
      Pending [] (Syntax.UsageTickets.insert (fun _ => none) 7 code.requiredActions)
        (introduce (fun _ => .consumed) 7) [42] hints .nil .ordinary .ordinary := by
  have installed := ClauseDeclarations.install (tables := tables) (hints := .cell .nil)
    (stack := receiver) (actions := fun _ => none) (phases := fun _ => .consumed) (world := [42])
    (mode := .ordinary) (finalMode := .ordinary) declarations (by decide)
    (.cell .nil) (.cell .nil) (by intro installed member; cases member) rfl
  have request : Local [] (fun _ => none) (fun _ => .consumed) [42]
      (.request handler.effectInst 0) (.handler (table := tables handler) (families := families handler) (.cell .nil)) :=
    SourceContextualRequirements.Lexical.Recursive.request_checked
      (SourceContextualRequirements.check_requirements_iff.mp
        (show checkRequirements (.handler handler.effectInst (tables handler) (families handler) (.cell 42 .nil))
          [(handler.effectInst, 0)] = true from by decide) _ List.mem_cons_self)
  have modes : SourceTemplates.ClauseModes handler.clauses (tables handler) :=
    .cons (by intro impossible; cases impossible) .nil
  obtain ⟨capturedScope, tailScope, capturedHints, tailHints, selectedFamily, sameScope,
    familyKnown, matched, checked, pending, finite, stored⟩ :=
    capture_declared_clause (owner := 7) (input := .unit) (answer := .unit) (caller := .none)
      (HandlerCut.hit handler receiver rfl) installed.1 installed.2.1 request
      installed.2.2.1 installed.2.2.2 modes ClauseAt.hit rfl rfl rfl
  cases matched with
  | live saved waiting =>
      cases saved with
      | handler empty =>
          cases empty
          cases waiting with
          | cell empty =>
              cases empty
              have equal : family = selectedFamily := Option.some.inj familyKnown
              cases equal
              exact ⟨_, .live (.handler .nil) (.cell .nil), checked, pending⟩
          | running marker tail => cases marker
      | running marker tail => cases marker

/-- A cleanup can use the provider allocated around it. That local requirement
is removed from the declaration's outer interface, not demanded from its caller. -/
theorem local_resource_cleanup_recipe : ClauseRecipe [] ⟨true, false⟩ []
    (fun owner => .resource (fun identity =>
      .cleanup [.cell identity] (.request (.cell identity) 1) (.invoke ⟨owner, .resume⟩))) := by
  apply ClauseRecipe.resource
  intro identity
  have body := ClauseRecipe.cleanup (outward := []) (needs := [.cell identity]) (provided := [identity])
    (callbackCode := .request (.cell identity) 1)
    (checking := .request) Footprint.request
    (ClauseRecipe.existing (SourceContextualRequirements.Recipe.resume (rights := ⟨true, false⟩) rfl))
  simpa only [externalRequirements, outwardRequirements, providerScope, reaches,
    if_true, List.filter_cons, List.filter_nil, Bool.false_eq_true, ↓reduceIte, List.nil_append] using body

end DeclarationExamples

