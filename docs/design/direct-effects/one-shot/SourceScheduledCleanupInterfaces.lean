/-- A returned value reconstructs the exact authenticated waiting context and
preserves the strengthened common state and its physical ownership evidence. -/
theorem RetainedState.plug
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨plain.context.plug value, plain.scope, tail⟩, issued, completed⟩, actions⟩ := by
  have operational := state.joined.plug closed
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    have template := DeclaredSources.expression_erase
      (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase current.source))
    have empty := SourceTemplates.expression_value_demand template closed.1
    subst currentDemand
    cases coherent with
    | push frame tailCoherent =>
      cases frame with
      | ordinary frameRows =>
        cases frameRows with
        | plain contextAuth =>
          cases pendingBudget with
          | plain waiting tailBudget =>
            cases retained with
            | plain waitingLocal tailLocal =>
              cases bound with
              | plain bound =>
                rename_i frameDemand frameRequirements restScope restHints restContext tailDemand tailRequirements
                  nextInput boundary nextInputRows pendingTail frameDependencies frameTicket framePlan frameRows frameCertified
                  frameScope inputAnnotation outputAnnotation frameSource
                cases pendingCertificate with
                | plain waitingCertificate tailCertificate =>
                  have childAuth := (current.authenticated.value_summary closed.1).value_context closed.1 boundary .none
                  have waitingBudget := waiting.reindex_context restContext.append_nil_pack
                  change Local outward actions (available (ownedTickets (.push (.plain plain) tail))) world frameDependencies
                    (restContext.append .nil).pack.hints at waitingLocal
                  rw [restContext.append_nil_pack] at waitingLocal
                  obtain ⟨combined, nextDependencies, nextPlan, nextRows, nextSource, nextAuth, nextCertified,
                    nextCertificate, evaluation⟩ :=
                    AuthContext.plug_value_source_certificate rfl contextAuth childAuth frameCertified
                      (waitingCertificate.reindex_context restContext.append_nil_pack)
                  have silent : ∀ entries receiving before,
                      evaluate entries receiving before (annotateDisposals currentRequirements) = some [] := by
                    intros
                    rw [SourcePlannedSources.template_value_disposals template closed.1]
                    exact RecursiveRecomposition.value_evaluation template closed.1
                  obtain ⟨nextAnnotated, nextRow, nextAnnotation, rawPath, generatedPath, nextChecked, included⟩ :=
                    plug_root_annotation plain silent (fun entries receiving before => (evaluation entries receiving before).2)
                      annotation checked
                  refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                    operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
                  apply RetainedSource.eval (stack := tail) ⟨nextSource, nextAuth, nextCertificate.compile.1, nextCertificate.compile.2, tailCoherent.forget.source⟩
                    nextCertified ⟨frameTicket, frameScope⟩ pendingTail tailCoherent tailBudget tailLocal bound ?_
                    nextAnnotation nextChecked (included.trans bounded) nextCertificate tailCertificate
                  simpa only [Context.pack, SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame, Bool.true_and] using finite

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RetainedState.plug



