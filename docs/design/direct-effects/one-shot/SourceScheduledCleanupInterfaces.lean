    storeAnnotation capAnnotation (fun held => (suppliedSource held).template) allocationStore
  have rawAnnotation : StoreAnnotation
      (((⟨owner, .resume⟩, ⟨capDemand, capReq⟩) :: resumes) ++ nextDisposals) baseStore := by
    rw [allocationOrigin]
    exact baseAnnotation
  clear allocationStore
  subst actualStore
  refine ⟨capRow, tailRow, branchBound, closingDemand, closingRow, closingBalance, noClosing,
    nextDisposals, baseStore, allocationOrigin, closingLookup, ?_, rawAnnotation, baseResumeLookup,
    nextBound, sourceStore, nextResumes, nextClosing, closingRecords, nextSource, nextLocal,
    .sequence .original tailAnnotation, nextUse, nextTickets, nextResources, rawStep, ownedSame,
    nextUnique, afterBalance, phaseSame, capChecked, tailChecked, resumeChecked, interface⟩
  intro protectedPath
  have generatedProtected : offered.dispose = true →
      RequirementPath (suppliedRequirements.prepend [.ordinary (.barrier true)]) (annotateDisposals capAnnotated) [] := by
    intro permitted
    simpa only [disposal_prepend, unchanged permitted] using disposal_subtree_path (protectedPath permitted)
  obtain ⟨protectedInterface, clauseDemand, clauseRequirements, clauseRow, expression,
    clauseChecked, clauseBound, clauseBalance, oldWholeAnnotation, wholeChecked, wholeBound, wholeBalance⟩ := guarded generatedProtected
  refine ⟨protectedInterface, clauseDemand, clauseRequirements, clauseRow, expression,
    clauseChecked, clauseBound, clauseBalance,
    .sequence .original (.sequence .original tailAnnotation), ?_, wholeBound, wholeBalance⟩
  simpa only [annotateDisposals, disposal_prepend] using wholeChecked

