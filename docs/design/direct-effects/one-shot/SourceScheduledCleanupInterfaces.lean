/-- One authenticated expression and its actual retained source, with resource
admission for those same witnesses and a fixed ambient allowance. Executable
root requirements remain separate from the syntax's scalar requirements. -/
structure ExecutionSite (ambient : List Nat) (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (actions : Syntax.UsageTickets)
    (phases : OwnerPhaseTransitions.Phases) (world installations : List Nat)
    (resumes : RecursiveRequirements.Store) (budget : Footprint)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none))
    (output : PlannedModeValue) (outputRows : ModeRowsValue output) where
  expression : Code
  runtimeScope : Scope
  stack : Stack
  result : Value
  resultRows : ValueRows result
  allowed : List Instance
  dependencies : Dependencies
  plan : Plan dependencies
  rows : Rows (signature plan)
  sourceDemand : List Nat
  sourceRequirements : Requirements sourceDemand
  receiving : SourceDependencyCapture.Scope
  hints : ReturnHints receiving
  context : Context hints
  current : SourceAdmission.Admitted operations policy contracts ports owners (fun _ => none) emptyRows
    world installations allowed outward runtimeScope actions phases budget tables families context stack
    expression result sourceDemand sourceRequirements (signature plan) resultRows rows
  certified : Certified (evidence := declarationPolicy) outward world plan
  scopeTyped : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope
  pendingDemand : List Nat
  pendingRequirements : Requirements pendingDemand
  pending : PlannedModeSource operations policy contracts tables families required outward actions world
    stack (.value result) output pendingDemand pendingRequirements receiving
  coherent : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes pending (.value resultRows) outputRows context
  retained : SourceAdmission.Pending outward actions budget phases world installations
    context .nil .ordinary output.mode
  currentResource : InstallationSupport.CodeChecked ambient outward current.certificate
  retainedResource : InstallationSupport.PendingChecked ambient outward retained

open InstallationSupport

/-- An actual authenticated focus decomposition. The retained witness carries
its lexical frame and row split, so clients need not identify separately chosen
source proofs. -/
def ExecutionSite.Focused
    (site next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (child : Code) (position : ScopedExecution.Context) : Prop :=
  Focus site.expression child position ∧
  ∃ plain : PlainData,
    plain.context = position ∧ plain.scope = site.runtimeScope ∧
    next.expression = child ∧ next.runtimeScope = site.runtimeScope ∧
    next.stack = .push (.plain plain) site.stack ∧
    RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
      ⟨next.expression, next.runtimeScope, next.stack⟩ [] [] ∧
    ∃ restDependencies, ∃ restPlan : Plan restDependencies, ∃ restRows : Rows (signature restPlan),
      FocusRows site.rows next.rows restRows ∧
      next.context.pack = (Context.plain restRows site.context).pack ∧
      SourceAdmission.Code outward actions budget phases world installations restRows site.context

/-- Source focus constructs the child and lexical frame together. Executable
requirements are separate from this authenticated syntax decomposition. -/
theorem ExecutionSite.focus
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (focus : Focus site.expression child position) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
      site.Focused next child position := by
  obtain ⟨ticket, typed⟩ := site.scopeTyped
  obtain ⟨plain, input, childDemand, restDemand, childRequirements, restRequirements, childDependencies, restDependencies,
    childPlan, restPlan, inputRows, childRows, restRows, contextSame, scopeSame, _sameDemand,
    nextCurrent, nextCertified, ⟨nextPending, nextCoherent⟩, _nextBudget, raw, split, _restCheck, _evaluation⟩ :=
    site.current.previous.focus_retained_rows site.certified site.coherent.forget site.retained.compile.2 typed focus
  obtain ⟨childCertificate, restCertificate⟩ := split.source_certificate site.current.certificate
  obtain ⟨childResource, restResource⟩ := focus_rows split site.currentResource
  have nextRetained := SourceAdmission.Pending.plain
    (restCertificate.reindex_context site.context.append_nil_pack.symm) site.retained
  let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows :=
    { expression := child, runtimeScope := site.runtimeScope, stack := .push (.plain plain) site.stack,
      result := input, resultRows := inputRows, allowed := site.allowed,
      dependencies := childDependencies, plan := childPlan, rows := childRows,
      sourceDemand := childDemand, sourceRequirements := childRequirements,
      receiving := .plain restDependencies site.receiving, hints := .plain site.hints,
      context := .plain restRows site.context, current := ⟨nextCurrent, childCertificate⟩, certified := nextCertified,
      scopeTyped := ⟨ticket, typed⟩, pendingDemand := restDemand ++ site.pendingDemand,
      pendingRequirements := .sequence (restRequirements.prepend (OwnerPhases.ofStack tables site.stack)) site.pendingRequirements,
      pending := nextPending, coherent := site.coherent.prepend_plain nextCoherent rfl,
      retained := nextRetained, currentResource := childResource,
      retainedResource := .plain (restResource.reindex_context site.context.append_nil_pack.symm) site.retainedResource }
  exact ⟨next, focus, plain, contextSame, scopeSame, rfl, rfl, rfl, raw, _, restPlan, restRows, split, rfl, restCertificate⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.focus

