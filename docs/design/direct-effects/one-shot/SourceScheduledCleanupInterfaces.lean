namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (spendAll)
open SourceDependencyFrames (unwindStore)

/-- Demand includes recursively invoked bodies, so an absent owner cannot be
looked up anywhere in a checked derivation. Its retirement remains independent
of the callable store. -/
theorem checked_remove_undemanded
    (checked : Checked entries receiving before (requirements : Requirements demand) row)
    (absent : owner ∉ demand) :
    Checked (RecursiveTransport.removeOwner owner entries) receiving before requirements row := by
  induction checked with
  | request exported => exact .request exported
  | retire ready => exact .retire ready
  | spent consumed => exact .spent consumed
  | @invoke key demand body phases nearer receiving waiting row known ready selection next ih =>
      have different : key.owner ≠ owner := by
        intro same
        exact absent (same ▸ List.mem_cons_self)
      exact .invoke ((RecursiveTransport.lookup_remove_other different).trans known)
        ready selection (ih (fun member => absent (List.mem_cons_of_mem _ member)))
  | sequence first second ihFirst ihSecond =>
      exact .sequence (ihFirst (fun member => absent (List.mem_append_left _ member)))
        (ihSecond (fun member => absent (List.mem_append_right _ member)))
  | emitAfter body exported ih => exact .emitAfter (ih absent) exported
  | @choice receiving before a first firstRow b second secondRow same checkedFirst checkedSecond ihFirst ihSecond =>
      exact .choice (ihFirst absent) (ihSecond (fun member => absent (same.mem_iff.mpr member)))

/-- Opening a capture keeps its retirement ticket but removes its callable
records. The source's saved demands cannot include that owner: the existing
checked demand is unique and already contains its later retirement. -/
theorem PlannedModeSource.advance_store
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind output demand requirements scope)
    (step : LexicalUnwind.Advance stack after discharged)
    (checked : Checked entries receiving before requirements row) :
    Checked (unwindStore stack entries) receiving before requirements row := by
  cases step with
  | plain | handler | cell | spent | retire => exact checked
  | @live owner input answer captured caller rest => cases source with
    | @opening captured savedDemand savedRequirements savedScope rest output tailDemand tailRequirements restScope owner input answer caller saved tail =>
      obtain ⟨savedRow, closingRow, savedCheck, closingCheck, rfl⟩ :=
        RecursiveRequirements.checked_sequence_parts checked
      obtain ⟨retireRow, tailRow, retireCheck, tailCheck, rfl⟩ :=
        RecursiveRequirements.checked_sequence_parts closingCheck
      have distinct := RecursiveRequirements.checked_once checked
      have absent : owner ∉ savedDemand := by
        intro member
        exact (List.nodup_append.mp distinct).2.2 owner member owner List.mem_cons_self rfl
      have tailConsumed : (spendAll (spendAll before savedDemand) [owner]) owner = .consumed := by
        simp only [spendAll, OwnerPhaseTransitions.spend_self]
      have retireAfter : Checked (RecursiveTransport.removeOwner owner entries) receiving
          (spendAll before savedDemand) (.retire owner) retireRow := by
        apply RecursiveRequirements.evaluate_sound
        simpa only [RecursiveClosing.evaluate_retire] using RecursiveRequirements.checked_complete retireCheck
      exact .sequence (checked_remove_undemanded savedCheck absent)
        (.sequence retireAfter
          (RecursiveTransport.checked_remove_consumed tailCheck tailConsumed))

/-- All six administrative source transitions are checked in the actual
successor store. Callable records disappear when a live capture opens; the
owner phase changes only at its separate retirement step. -/
theorem PlannedModeSource.advance_checked_store
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind output demand requirements scope)
    (step : LexicalUnwind.Advance stack after discharged)
    (checked : Checked entries receiving before requirements row) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world after .unwind output
        nextDemand nextRequirements scope.afterUnwind ∧
      Checked (unwindStore stack entries) receiving
        (spendAll before (discharged.filterMap Syntax.ticketProjection)) nextRequirements row :=
  source.advance_checked step (source.advance_store step checked)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.checked_remove_undemanded
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.advance_store
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.advance_checked_store

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open SourceDependencyCapture (Scope OwnerSelection)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open SourceDependencyOwners (owners)
open SourceScheduledPhaseRestriction (AvailableOn owners_append selected_scope selected_owner resumed_owners)
open OwnerPhaseTransitions (spend)

/-- The recursive judgments observe availability only at lexically live owners.
This is the existing owner-set restriction proof lifted to return-mode hints. -/
theorem recursive_local_restrict
    {hints : ReturnHints scope}
    (source : Local outward actions before world dependencies hints)
    (extension : AvailableOn (owners scope) before after) :
    Local outward actions after world dependencies hints := by
  refine (Local.rec
    (motive_1 := fun before world dependencies scope hints _ => ∀ after,
      AvailableOn (owners scope) before after → Local outward actions after world dependencies hints)
    (motive_2 := fun before world scope outside hints outsideHints initial finalMode _ => ∀ after,
      AvailableOn (owners (scope.append outside)) before after →
        Pending outward actions after world hints outsideHints initial finalMode)
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ (t := source)) after extension
  · intros; exact .pure
  · intros
    rename_i scope hints effect operation phases world guard callbacks bounded ih after extension
    apply Local.request guard _ bounded
    intro capturedScope tailScope captured tail contract modes same found disposes
    apply ih captured tail contract modes same found disposes after
    simpa only [selected_scope found, SourceScheduledPhaseRestriction.owners_append, owners] using extension
  · intros
    rename_i frontScope capturedScope tailScope owner rights phases world front captured tail located known permission available restored ih after extension
    apply Local.resume located known permission (extension _ (selected_owner located) available)
    apply ih (spend after owner)
    apply extension.spend.weaken
    simpa only [OwnerSelection.resumed, SourceScheduledPhaseRestriction.owners_append, owners, List.append_nil] using resumed_owners located
  · intros
    rename_i frontScope capturedScope tailScope owner rights phases world front captured tail located known permission available held callbacks waiting ihCallbacks ihWaiting after extension
    apply Local.dispose located known permission (extension _ (selected_owner located) available) held
    · apply ihCallbacks (spend after owner)
      apply extension.spend.weaken
      simpa only [OwnerSelection.resumed, SourceScheduledPhaseRestriction.owners_append, owners] using resumed_owners located
    · apply ihWaiting (spend after owner)
      apply extension.spend.weaken
      simp only [SourceScheduledPhaseRestriction.owners_append, owners, List.append_nil]
      intro other member
      rcases List.mem_append.mp member with front | tail
      · exact List.mem_append_left _ front
      · exact List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_right _ tail))
  · intros; rename_i first second ihFirst ihSecond after extension
    exact .sequence (ihFirst after extension) (ihSecond after extension)
  · intros; rename_i first second ihFirst ihSecond after extension
    exact .choice (ihFirst after extension) (ihSecond after extension)
  · intros; rename_i body ih after extension
    exact .handler (ih after extension)
  · intros; rename_i body callback ihBody ihCallback after extension
    exact .cleanup (ihBody after extension) (ihCallback after extension)
  · intros; rename_i body ih after extension
    exact .resource (fun identity fresh => ih identity fresh after extension)
  · intros; exact .nil
  · intros; rename_i code tail ihCode ihTail after extension
    exact .plain (ihCode after extension) (ihTail after extension)
  · intros; rename_i tail ih after extension
    exact .skipped (ih after extension)
  · intros; rename_i tail ih after extension
    exact .handler (ih after extension)
  · intros; rename_i tail ih after extension
    exact .cell (ih after extension)
  · intros; rename_i callback tail ihCallback ihTail after extension
    exact .cleanup (ihCallback after extension) (ihTail after extension)
  · intros; rename_i tail ih after extension
    exact .normal (ih after extension)
  · intros; rename_i tail ih after extension
    exact .unwinding (ih after extension)
  · intros; rename_i tail ih after extension
    exact .closing (ih after extension)
  · intros; rename_i tail ih after extension
    exact .retiring (ih after extension)
  · intros; rename_i saved tail ihSaved ihTail after extension
    apply Pending.live
    · apply ihSaved after
      apply extension.weaken
      simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
      exact List.subset_cons_self _ _
    · apply ihTail after
      apply extension.weaken
      simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
      intro name member
      exact List.mem_cons_of_mem _ (List.mem_append_right _ member)
  · intros; rename_i saved tail ihSaved ihTail after extension
    apply Pending.opening
    · apply ihSaved after
      apply extension.weaken
      simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
      exact List.subset_cons_self _ _
    · apply ihTail after
      apply extension.weaken
      simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
      intro name member
      exact List.mem_cons_of_mem _ (List.mem_append_right _ member)
  · intros; rename_i tail ih after extension
    exact .spent (ih after extension)

theorem recursive_pending_restrict
    {hints : ReturnHints scope} {outsideHints : ReturnHints outside}
    (source : Pending outward actions before world hints outsideHints initial finalMode)
    (extension : AvailableOn (owners (scope.append outside)) before after) :
    Pending outward actions after world hints outsideHints initial finalMode := by
  induction hints generalizing outside initial finalMode with
  | nil => cases source; exact .nil
  | plain rest ih => cases source with
    | plain code tail => exact .plain (recursive_local_restrict code extension) (ih tail extension)
    | skipped tail => exact .skipped (ih tail extension)
  | handler rest ih => cases source with | handler tail => exact .handler (ih tail extension)
  | cell rest ih => cases source with | cell tail => exact .cell (ih tail extension)
  | cleanup rest ih => cases source with
    | cleanup callback tail => exact .cleanup (recursive_local_restrict callback extension) (ih tail extension)
  | running kind rest ih => cases source with
    | normal tail => exact .normal (ih tail extension)
    | unwinding tail => exact .unwinding (ih tail extension)
    | closing tail => exact .closing (ih tail extension)
    | retiring tail => exact .retiring (ih tail extension)
  | live saved rest ihSaved ihTail => cases source with
    | live inside tail =>
      apply Pending.live
      · apply ihSaved inside
        apply extension.weaken
        simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
        exact List.subset_cons_self _ _
      · apply ihTail tail
        apply extension.weaken
        simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
        intro name member
        exact List.mem_cons_of_mem _ (List.mem_append_right _ member)
    | opening inside tail =>
      apply Pending.opening
      · apply ihSaved inside
        apply extension.weaken
        simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
        exact List.subset_cons_self _ _
      · apply ihTail tail
        apply extension.weaken
        simp only [Scope.append, owners, SourceScheduledPhaseRestriction.owners_append]
        intro name member
        exact List.mem_cons_of_mem _ (List.mem_append_right _ member)
  | spent rest ih => cases source with | spent tail => exact .spent (ih tail extension)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.recursive_local_restrict
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.recursive_pending_restrict

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyCapture (Scope)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Pending)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open SourceDependencySchemes.Lexical (UnwindAnnotated)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyFrames (unwindStore)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available spendAll)

theorem recursive_pending_advance
    {hints : ReturnHints scope}
    (step : LexicalUnwind.Advance stack after discharged)
    (matching : ReturnHints.Matches tables families hints stack)
    (pending : Pending outward actions phases world hints outside .unwind finalMode) :
    ∃ next : ReturnHints scope.afterUnwind,
      ReturnHints.Matches tables families next after ∧
      Pending outward actions phases world next outside .unwind finalMode := by
  cases step with
  | plain => cases matching with
    | plain tail => cases pending with
      | skipped checked => exact ⟨_, tail, checked⟩
    | running marker tail => cases marker
  | handler => cases matching with
    | handler tail => cases pending with
      | handler checked => exact ⟨_, tail, checked⟩
    | running marker tail => cases marker
  | cell => cases matching with
    | cell tail => cases pending with
      | cell checked => exact ⟨_, tail, checked⟩
    | running marker tail => cases marker
  | spent => cases matching with | spent tail => cases pending with
      | spent checked => exact ⟨_, tail, checked⟩
  | retire => cases matching with | running frame tail => cases frame; cases pending with
      | retiring checked => exact ⟨_, tail, checked⟩
  | live => cases matching with | live saved tail => cases pending with
      | opening inside checked =>
        exact ⟨_, ReturnHints.Matches.append saved (.running .retire tail),
          SourceDependencyNeutral.Lexical.Recursive.pending_join inside (.retiring checked)⟩

theorem planned_forest_advance
    (step : LexicalUnwind.Advance stack after discharged)
    (realized : SourceDependencyCapture.Realizes tables families scope stack)
    (checked : SourceContextualRechecking.checkForest required stack scope outside = true) :
    SourceContextualRechecking.checkForest required after scope.afterUnwind outside = true := by
  cases step with
  | plain => cases realized with | push frame tail => cases frame with | plain => exact checked
  | handler => cases realized with | push frame tail => cases frame with | handler =>
      rw [SourceContextualRechecking.checkForest, Bool.and_eq_true] at checked
      exact checked.2
  | cell => cases realized with | push frame tail => cases frame with | cell => exact checked
  | spent => cases realized with | spent tail => exact checked
  | retire => cases realized with | push frame tail => cases frame with | retiring => exact checked
  | live => cases realized with
    | @live capturedScope captured restScope rest owner input answer caller saved tail =>
      rw [SourceContextualRechecking.checkForest, Bool.and_eq_true] at checked
      obtain ⟨savedCheck, tailCheck⟩ := checked
      dsimp only [Scope.afterUnwind]
      rw [SourceContextualRechecking.Lexical.check_forest_append saved (.push .retiring tail), Bool.and_eq_true]
      refine ⟨?_, tailCheck⟩
      have same : ∀ effect operation,
          SourceContextualHints.checkCapability (restScope.append outside) effect operation =
            SourceContextualHints.checkCapability ((Scope.running restScope).append outside) effect operation := by
        intro effect operation
        exact (SourceHandlerRequirements.capability_prepend (first := .running (restScope.append outside))
          (second := restScope.append outside) (layer := .running) rfl).symm
      exact (SourceContextualRechecking.Lexical.check_forest_outside saved same) ▸ savedCheck


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.recursive_pending_advance
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.planned_forest_advance

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked Store)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open SourceDependencyFrames (unwindStore)
open OwnerPhaseTransitions (spendAll)

/-- Evidence of which source annotations survive an administrative unwind step.
The constructors record paths in the existing static certificates; they do not
schedule cleanup or add a runtime operation. -/
inductive UnwindAnnotationStep : {demand : List Nat} → Requirements demand → Requirements demand →
    List Owner → {nextDemand : List Nat} → Requirements nextDemand → Prop where
  | retained (noTickets : discharged.filterMap Syntax.ticketProjection = [])
      (path : RequirementPath annotated next []) :
      UnwindAnnotationStep normal annotated discharged next
  | retired {tail : Requirements tailDemand} {annotated : Requirements ([owner] ++ tailDemand)}
      (tailAnnotation : RowAnnotation tail annotatedTail)
      (beforePath : RequirementPath annotatedTail annotated [owner])
      (afterPath : RequirementPath annotatedTail next []) :
      UnwindAnnotationStep (.sequence (.retire owner) tail) annotated [.ticket owner] next
  | opened {saved : Requirements savedDemand} {tail : Requirements tailDemand}
      {annotated : Requirements (savedDemand ++ ([owner] ++ tailDemand))}
      (savedAnnotation : RowAnnotation saved annotatedSaved)
      (tailAnnotation : RowAnnotation tail annotatedTail)
      (beforeSaved : RequirementPath annotatedSaved annotated [])
      (beforeTail : RequirementPath annotatedTail annotated (savedDemand ++ [owner]))
      (afterSaved : RequirementPath annotatedSaved next [])
      (afterTail : RequirementPath annotatedTail next (savedDemand ++ [owner])) :
      UnwindAnnotationStep (.sequence saved (.sequence (.retire owner) tail)) annotated [] next

/-- Retirement removes the consumed prefix of the certificate, retaining the
same annotated waiting source at the phase after that owner. -/
theorem retire_annotation_checked
    {tail : Requirements demand}
    (annotation : RowAnnotation (.sequence (.retire owner) tail) annotated)
    (checked : Checked entries receiving before annotated row) :
    ∃ annotatedTail : Requirements demand, ∃ tailRow,
      RowAnnotation tail annotatedTail ∧
      RequirementPath annotatedTail annotated [owner] ∧
      Checked entries receiving (spendAll before [owner]) annotatedTail tailRow ∧
      tailRow ⊆ row := by
  obtain ⟨annotatedTail, tailAnnotation, path⟩ := annotation.focus (RequirementPath.second (.here (selected := tail)))
  obtain ⟨tailRow, tailCheck, within⟩ := path.checked checked
  exact ⟨annotatedTail, tailRow, tailAnnotation, path, tailCheck, within⟩

/-- Saved cleanup and the waiting suffix keep their exact annotated subtrees
when the opened continuation's callable records are removed. -/
theorem open_annotation_checked
    {saved : Requirements savedDemand} {tail : Requirements tailDemand}
    (annotation : RowAnnotation (.sequence saved (.sequence (.retire owner) tail)) annotated)
    (checked : Checked entries receiving before annotated row) :
    ∃ annotatedSaved : Requirements savedDemand, ∃ annotatedTail : Requirements tailDemand,
    ∃ savedRow tailRow,
      RowAnnotation saved annotatedSaved ∧ RowAnnotation tail annotatedTail ∧
      RequirementPath annotatedSaved annotated [] ∧
      RequirementPath annotatedTail annotated (savedDemand ++ [owner]) ∧
      Checked (RecursiveTransport.removeOwner owner entries) receiving before annotatedSaved savedRow ∧
      Checked (RecursiveTransport.removeOwner owner entries) receiving (spendAll before savedDemand) (.retire owner) [] ∧
      Checked (RecursiveTransport.removeOwner owner entries) receiving
        (spendAll (spendAll before savedDemand) [owner]) annotatedTail tailRow ∧
      savedRow ++ tailRow ⊆ row := by
  obtain ⟨annotatedSaved, savedAnnotation, savedPath⟩ := annotation.focus (RequirementPath.first (.here (selected := saved)))
  obtain ⟨annotatedTail, tailAnnotation, tailPath⟩ := annotation.focus
    (RequirementPath.second (RequirementPath.second (.here (selected := tail))))
  obtain ⟨savedRow, savedCheck, savedBound⟩ := savedPath.checked checked
  obtain ⟨tailRow, tailCheck, tailBound⟩ := tailPath.checked checked
  simp only [spendAll] at savedCheck
  simp only [List.append_nil, PhaseRechecking.spendAll_append] at tailCheck tailPath
  have absent : owner ∉ savedDemand := by
    intro member
    exact (List.nodup_append.mp (RecursiveRequirements.checked_once checked)).2.2
      owner member owner List.mem_cons_self rfl
  obtain ⟨normalRow, normalCheck, _⟩ := annotation.checked checked
  obtain ⟨_, _, _, closingCheck, _⟩ := RecursiveRequirements.checked_sequence_parts normalCheck
  obtain ⟨retireRow, _, retireCheck, _, _⟩ := RecursiveRequirements.checked_sequence_parts closingCheck
  have ready : (spendAll before savedDemand) owner = .available := by
    have trace := RecursiveRequirements.checked_trace retireCheck
    cases trace with | cons available tail => exact available
  refine ⟨annotatedSaved, annotatedTail, savedRow, tailRow, savedAnnotation, tailAnnotation,
    savedPath, tailPath, checked_remove_undemanded savedCheck absent, .retire ready, ?_,
    List.append_subset.mpr ⟨savedBound, tailBound⟩⟩
  apply RecursiveTransport.checked_remove_consumed tailCheck
  simp only [spendAll, OwnerPhaseTransitions.spend_self]

theorem PlannedModeSource.advance_annotated_checked
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind output demand requirements scope)
    (step : LexicalUnwind.Advance stack after discharged)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : Checked entries [] before annotatedRoot row) :
    ∃ nextDemand, ∃ nextRequirements annotatedNext : Requirements nextDemand, ∃ nextRow,
      PlannedModeSource operations policy contracts tables families required outward actions world after .unwind output
        nextDemand nextRequirements scope.afterUnwind ∧
      RowAnnotation nextRequirements annotatedNext ∧
      Checked (unwindStore stack entries) [] (spendAll before (discharged.filterMap Syntax.ticketProjection))
        annotatedNext nextRow ∧ nextRow ⊆ row ∧
      UnwindAnnotationStep requirements annotatedRoot discharged annotatedNext := by
  have retained {sourceDemand : List Nat} {original next annotatedRoot : Requirements sourceDemand} {nextRow : Footprint}
      (empty : discharged.filterMap Syntax.ticketProjection = [])
      (annotation : RowAnnotation original annotatedRoot)
      (checked : Checked entries [] before annotatedRoot row)
      (nextCheck : Checked entries [] before next nextRow) (within : nextRow ⊆ row) :
      ∃ annotatedNext : Requirements sourceDemand, ∃ totalRow,
        RowAnnotation next annotatedNext ∧
        Checked entries [] before annotatedNext totalRow ∧ totalRow ⊆ row ∧
        UnwindAnnotationStep original annotatedRoot discharged annotatedNext := by
    refine ⟨.choice next annotatedRoot (.refl _), nextRow ++ row, .alternatives .original (.refl _), ?_,
      List.append_subset.mpr ⟨within, List.Subset.refl _⟩, .retained empty (.no .here)⟩
    exact Checked.choice (same := List.Perm.refl _) nextCheck checked
  obtain ⟨normalRow, normalCheck, normalBound⟩ := annotation.checked checked
  cases step with
  | plain => cases source with | push head tail => cases head with
    | skipped =>
      have tailCheck : Checked entries [] before _ normalRow := RecursiveRequirements.evaluate_sound (by
        simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left] using
          RecursiveRequirements.checked_complete normalCheck)
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck normalBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | handler => cases source with | push head tail => cases head with
    | handler declaration =>
      have tailCheck : Checked entries [] before _ normalRow := RecursiveRequirements.evaluate_sound (by
        simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left] using
          RecursiveRequirements.checked_complete normalCheck)
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck normalBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | cell => cases source with | push head tail => cases head with
    | cell =>
      have tailCheck : Checked entries [] before _ normalRow := RecursiveRequirements.evaluate_sound (by
        simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left] using
          RecursiveRequirements.checked_complete normalCheck)
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck normalBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | spent => cases source with | skippedSpent tail =>
      obtain ⟨_, tailRow, _, tailCheck, rowSame⟩ := RecursiveRequirements.checked_sequence_parts normalCheck
      have tailBound : tailRow ⊆ row := (rowSame ▸ List.subset_append_right _ _).trans normalBound
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck tailBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | retire => cases source with | push head tail => cases head with
    | retiring =>
      obtain ⟨annotatedTail, tailRow, tailAnnotation, path, tailCheck, within⟩ := retire_annotation_checked annotation checked
      exact ⟨_, _, annotatedTail, tailRow, tail, tailAnnotation, tailCheck, within, .retired tailAnnotation path .here⟩
  | @live owner input answer captured caller rest => cases source with
    | @opening captured savedDemand savedRequirements savedScope rest output tailDemand tailRequirements restScope owner input answer caller saved tail =>
      obtain ⟨annotatedSaved, annotatedTail, savedRow, tailRow, savedAnnotation, tailAnnotation,
        savedPath, tailPath, savedCheck, retireCheck, tailCheck, within⟩ := open_annotation_checked annotation checked
      obtain ⟨combined, nextSource, normalEvaluation⟩ := saved.append (PlannedModeSource.push .retiring tail)
      have combinedCheck : Checked (RecursiveTransport.removeOwner owner entries) [] before combined normalRow := by
        apply RecursiveRequirements.evaluate_sound
        rw [normalEvaluation]
        simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          List.append_nil, Requirements.prepend, unwindStore] using
          RecursiveRequirements.checked_complete ((PlannedModeSource.opening (input := input) (answer := answer) (caller := caller) saved tail).advance_store LexicalUnwind.Advance.live normalCheck)
      let retained := Requirements.sequence annotatedSaved (.sequence (.retire owner) annotatedTail)
      have retainedCheck : Checked (RecursiveTransport.removeOwner owner entries) [] before retained (savedRow ++ tailRow) := by
        exact .sequence savedCheck (.sequence retireCheck tailCheck)
      let nextAnnotated := Requirements.choice combined retained (List.Perm.refl _)
      refine ⟨_, combined, nextAnnotated, normalRow ++ (savedRow ++ tailRow), nextSource,
        .alternatives .original (.refl _), .choice combinedCheck retainedCheck,
        List.append_subset.mpr ⟨normalBound, within⟩,
        .opened savedAnnotation tailAnnotation savedPath tailPath (.no (.first .here)) ?_⟩
      exact .no (by simpa only [List.append_nil] using
        (RequirementPath.second (RequirementPath.second (.here (selected := annotatedTail)))))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.retire_annotation_checked
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.open_annotation_checked
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.advance_annotated_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Pending)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open SourceDependencySchemes.Lexical (UnwindAnnotated)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyFrames (unwindStore)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available spendAll)
/-- Administrative preservation retains the exact source annotations exposed
by the structural unwind step, together with the same successor's source,
capabilities, store, ownership and runtime access checks. -/
theorem advance_planned_unwind_annotated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind output demand requirements scope)
    {hints : ReturnHints scope}
    (matching : ReturnHints.Matches tables families hints stack)
    (pending : Pending outward actions (available (ownedTickets stack)) world hints .nil .unwind output.mode)
    (bound : Bound annotations scope)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world stack key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      UnwindAnnotated operations.erase policy contracts.erase tables families annotations world stack key body)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : Checked annotatedStore [] (available (ownedTickets stack)) annotatedRoot certificateRow)
    (finite : SourceContextualRechecking.checkForest required stack scope .nil = true)
    (unique : (ownedTickets stack).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.unwind runtimeScope stack))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope stack))
    (resources : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope stack))
    (step : LexicalUnwind.Advance stack after discharged) :
    ∃ nextDemand, ∃ nextRequirements annotatedNext : Requirements nextDemand,
    ∃ nextHints : ReturnHints scope.afterUnwind, ∃ nextRow,
      PlannedModeSource operations policy contracts tables families required outward actions world after .unwind output
        nextDemand nextRequirements scope.afterUnwind ∧
      ReturnHints.Matches tables families nextHints after ∧
      Pending outward actions (available (ownedTickets after)) world nextHints .nil .unwind output.mode ∧
      Bound annotations scope.afterUnwind ∧
      StoreAnnotation (unwindStore stack resumes ++ unwindStore stack disposals) (unwindStore stack annotatedStore) ∧
      RowAnnotation nextRequirements annotatedNext ∧
      Checked (unwindStore stack annotatedStore) [] (available (ownedTickets after)) annotatedNext nextRow ∧
      UnwindAnnotationStep requirements annotatedRoot discharged annotatedNext ∧
      nextRow ⊆ certificateRow ∧ nextDemand.Perm (ownedTickets after) ∧ (ownedTickets after).Nodup ∧
      SourceContextualRechecking.checkForest required after scope.afterUnwind .nil = true ∧
      (∀ key body, (key, body) ∈ unwindStore stack resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world after key body) ∧
      (∀ key body, (key, body) ∈ unwindStore stack disposals →
        UnwindAnnotated operations.erase policy contracts.erase tables families annotations world after key body) ∧
      LexicalUnwind.UseTransition (.unwind runtimeScope stack) (.unwind runtimeScope after) [] discharged ∧
      LexicalUnwind.MachineUse policy actions (.unwind runtimeScope after) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope after) ∧
      LexicalUnwind.MachineAccess ambient (.unwind runtimeScope after) := by
  obtain ⟨nextUnique, phaseSame⟩ := SourceDependencyFrames.unwind_owner_phases step unique
  obtain ⟨nextDemand, nextRequirements, annotatedNext, nextRow, nextSource, nextAnnotation, nextCheck, nextBound, retained⟩ :=
    source.advance_annotated_checked step annotation checked
  rw [phaseSame] at nextCheck
  obtain ⟨nextHints, nextMatch, nextPending⟩ := recursive_pending_advance step matching pending
  have actualPending : Pending outward actions (available (ownedTickets after)) world
      nextHints .nil .unwind output.mode := by
    apply recursive_pending_restrict nextPending
    simpa only [SourceDependencyProjection.scope_append_nil] using
      SourceConsumingCleanupAdmission.realized_available nextMatch.erases
  have nextStoreAnnotation : StoreAnnotation (unwindStore stack resumes ++ unwindStore stack disposals)
      (unwindStore stack annotatedStore) := by
    rw [← SourceDependencyFrames.unwind_store_combined]
    cases stack <;> first | exact storeAnnotation | exact storeAnnotation.remove_owner _
  have nextRecords := planned_resume_records_advance step records
  have nextClosing := SourceDependencySchemes.Lexical.annotated_records_advance step closing
  obtain ⟨_, normalCheck, _⟩ := nextAnnotation.checked nextCheck
  obtain ⟨_, originalCheck, _⟩ := nextStoreAnnotation.checked normalCheck
  have balance := SourceDependencySchemes.Lexical.mode_stack_ownership_balance nextSource.erase
    (fun key body member => (nextRecords key body member).erase) nextClosing nextUnique originalCheck
  have event : LexicalUnwind.UseTransition (.unwind runtimeScope stack) (.unwind runtimeScope after) [] discharged := .advance step
  refine ⟨nextDemand, nextRequirements, annotatedNext, nextHints, nextRow, nextSource, nextMatch, actualPending,
    SourceDependencySchemes.Lexical.bound_advance step source.realizes bound,
    nextStoreAnnotation, nextAnnotation, nextCheck, retained, nextBound, balance, nextUnique,
    planned_forest_advance step source.realizes finite, nextRecords, nextClosing, event, ?_, ?_, ?_⟩
  · simpa only [LexicalUnwind.advanceUseTickets] using
      event.preserves (by intro owner member; cases member) unique usage
  · simpa only [LexicalUnwind.advanceUseTickets] using
      event.ticket_access (by intro owner member; cases member) unique usage tickets
  · exact LexicalUnwind.transition_access event.erases resources trivial
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.advance_planned_unwind_annotated

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
