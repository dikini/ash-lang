namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open SourceDependencySchemes.Closing (Bound)
open OwnerPhaseTransitions (available)

/-- A ready resource allocation has only its actual contextual interpretation. -/
theorem ExecutionRoot.resource_run
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (expressionEq : site.expression = .resource binder initializer body)
    (isValue : initializer.IsValue) : Accounting.Run world history site.rows site.context root := by
  cases rooted with
  | contextual interpreted => exact interpreted
  | branch chosen inside =>
      have selected := chosen.1
      rw [expressionEq] at selected
      cases selected
  | focus focused inside =>
      have selected := focused.1
      rw [expressionEq] at selected
      cases selected
      contradiction

/-- Fresh resource allocation preserves the same checked continuation ownership. -/
theorem ExecutableState.enter_resource
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.resource binder initializer body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (isValue : initializer.IsValue) (fresh : identity ∉ world) :
    ∃ payload answer, initializer = .integer payload ∧
      LexicalUnwind.Event
        ⟨.eval ⟨.resource binder initializer body, runtimeScope, stack⟩, issued, completed⟩
        ⟨.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩,
          issued ++ [Owner.resource identity], completed⟩ ∧
      ExecutableState operations policy contracts tables families required outward annotations (world ++ [identity]) ambient history
        resumes disposals annotatedStore budget ports owners emptyRows output outputRows
        ⟨⟨.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩,
          issued ++ [Owner.resource identity], completed⟩, actions⟩ := by
  have source := state.source
  dsimp only at source
  generalize machineEq : LexicalUnwind.Machine.eval ⟨.resource binder initializer body, runtimeScope, stack⟩ = machine at source
  cases source with
  | eval site phaseAgreement rooted bound annotation checked bounded =>
      obtain ⟨expressionEq, runtimeEq, stackEq⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
      have interpreted := rooted.resource_run expressionEq.symm isValue
      obtain ⟨payload, answer, next, initialEq, bodyEq, nextScopeEq, nextStackEq, nextRun, nextBound, raw⟩ :=
        site.enter_resource_accounting expressionEq.symm isValue interpreted fresh
      have larger : world ⊆ world ++ [identity] := List.subset_append_left _ _
      have ownedSame : ownedTickets next.stack = ownedTickets site.stack := by rw [nextStackEq]; rfl
      have nextPhase := phaseAgreement.trans (congrArg available ownedSame.symm)
      have transition : LexicalUnwind.Transition
          (.eval ⟨site.expression, site.runtimeScope, site.stack⟩)
          (.eval ⟨next.expression, next.runtimeScope, next.stack⟩) [.resource identity] [] :=
        .evaluate raw (by rw [← expressionEq]; trivial)
      have ownerFresh : Owner.resource identity ∉ issued := fun member =>
        fresh (state.issuedResources (ScopedTyping.mem_resource_world.mpr member))
      have allocation : (issued ++ [Owner.resource identity]).Nodup := by
        apply List.nodup_append.mpr
        refine ⟨state.ledger.2, by simp, ?_⟩
        intro first member second other same
        have singleton := List.mem_singleton.mp other
        subst second
        exact ownerFresh (singleton ▸ member)
      have event : LexicalUnwind.Event
          ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩
          ⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩,
            issued ++ [Owner.resource identity], completed⟩ := by
        simpa only [List.nil_append] using
          (LexicalUnwind.Event.step (before := ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩)
            transition allocation)
      have nextState : ExecutableState operations policy contracts tables families required outward annotations (world ++ [identity]) ambient history
          resumes disposals annotatedStore budget ports owners emptyRows output outputRows
          ⟨⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩,
            issued ++ [Owner.resource identity], completed⟩, actions⟩ := by
        refine ⟨.eval next nextPhase (.contextual nextRun) (nextBound annotations bound) annotation checked bounded,
          ?_, ?_, state.storeAnnotation, ?_, ?_, ?_, ?_, ?_,
          event.ticket_history (by simpa only [← expressionEq, ← runtimeEq, ← stackEq] using state.ticketHistory),
          state.captureMetadata.mono (List.subset_append_left _ _)⟩
        · intro key stored member
          rw [nextStackEq, ← stackEq]
          cases state.resumeRecords key stored member with
          | resume located known recorded source answer =>
              exact .resume (.push located) known recorded (source.world_weaken larger) answer
        · intro key stored member
          rw [nextStackEq, ← stackEq]
          cases state.unwindRecords key stored member with
          | dispose located held recorded source =>
              cases source with | paired planned erased same =>
                exact .dispose (.push located) held recorded (.paired (planned.world_weaken larger)
                  (erased.transport (fun _ _ h => h) larger) same)
        · apply LexicalUnwind.event_preserves_ledger event
          simpa only [← expressionEq, ← runtimeEq, ← stackEq] using state.ledger
        · intro ticket
          simpa using state.registry ticket
        · cases state.resources with
          | eval supported =>
              apply LexicalUnwind.MachineAccess.eval
              apply raw_step_preserves_access raw
              · simpa only [← expressionEq, ← runtimeEq, ← stackEq] using supported
              · rw [← expressionEq]
                exact ScopedPortJoint.ordinary_access_checks (by simp [Code.IsValue]) (by simp) (by simp)
        · rw [nextStackEq, ← stackEq]
          exact state.activations
        · simpa only [ScopedTyping.resource_world_append, ScopedTyping.resourceWorld,
            List.filterMap_append, List.filterMap_cons, List.filterMap_nil] using
            (ScopedExpressions.append_subset state.issuedResources (List.Subset.refl [identity]))
      refine ⟨payload, answer, initialEq, ?_, ?_⟩
      · simpa only [← expressionEq, bodyEq, nextScopeEq, nextStackEq, ← runtimeEq, ← stackEq] using event
      · simpa only [bodyEq, nextScopeEq, nextStackEq, ← runtimeEq, ← stackEq] using nextState
  | unwind => cases machineEq

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
