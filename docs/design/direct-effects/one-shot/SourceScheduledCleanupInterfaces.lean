/-- Starting unwind cleanup executes the installed callback under its protected
boundary and preserves every common-state field. -/
theorem ExecutableState.start_unwind_cleanup
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope (.push (.armed action) tail), issued, completed⟩, actions⟩) :
    LexicalUnwind.Event
      ⟨.unwind runtimeScope (.push (.armed action) tail), issued, completed⟩
      ⟨.eval ⟨.app action.action .unit, .none, .push (.unwinding action) tail⟩, issued, completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.app action.action .unit, .none, .push (.unwinding action) tail⟩,
        issued, completed⟩, actions⟩ := by
  have transition : LexicalUnwind.Transition (.unwind runtimeScope (.push (.armed action) tail))
      (.eval ⟨.app action.action .unit, .none, .push (.unwinding action) tail⟩) [] [] := .startCleanup
  have event : LexicalUnwind.Event
      ⟨.unwind runtimeScope (.push (.armed action) tail), issued, completed⟩
      ⟨.eval ⟨.app action.action .unit, .none, .push (.unwinding action) tail⟩, issued, completed⟩ := by
    simpa only [List.append_nil, List.nil_append] using
      (LexicalUnwind.Event.step (before := ⟨.unwind runtimeScope (.push (.armed action) tail), issued, completed⟩)
        transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
  refine ⟨event, state.source.start_unwind_cleanup, ?_, ?_, state.storeAnnotation,
    LexicalUnwind.event_preserves_ledger event state.ledger, state.registry,
    LexicalUnwind.transition_access transition state.resources trivial,
    state.activations, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
      cases located with | push rest => exact .resume (.push rest) known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
      cases located with | push rest => exact .dispose (.push rest) held recorded source

/-- Callback return completes its cleanup identity and resumes the same
interpreted unwind suffix. -/
theorem ExecutableState.finish_unwind_cleanup
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩, issued, completed⟩, actions⟩) :
    LexicalUnwind.Event
      ⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩, issued, completed⟩
      ⟨.unwind action.scope tail, issued, .cleanup action.identity :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind action.scope tail, issued, .cleanup action.identity :: completed⟩, actions⟩ := by
  have transition : LexicalUnwind.Transition
      (.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩)
      (.unwind action.scope tail) [] [.cleanup action.identity] := .finishCleanup
  have event : LexicalUnwind.Event
      ⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩, issued, completed⟩
      ⟨.unwind action.scope tail, issued, .cleanup action.identity :: completed⟩ := by
    simpa only [List.append_nil, List.singleton_append] using
      (LexicalUnwind.Event.step (before := ⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩, issued, completed⟩)
        transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
  have resources := LexicalUnwind.transition_access transition state.resources (by
    constructor
    · intro identity payload answer savedScope scope value tail impossible
      cases impossible
    · intro requested operation operand scope whole cap tail handler impossible
      cases impossible)
  refine ⟨event, state.source.finish_unwind_cleanup, ?_, ?_, state.storeAnnotation,
    LexicalUnwind.event_preserves_ledger event state.ledger, state.registry, resources,
    state.activations, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
      cases located with | push rest => exact .resume rest known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
      cases located with | push rest => exact .dispose rest held recorded source

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
