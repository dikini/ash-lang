namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Value)
open RecursiveRequirements (Requirements Store Checked evaluate)
open SourceDependencyAnnotations (RowAnnotation)
open OwnerPhaseTransitions (spendAll)

/-- Generation preserves the existing structural annotation relation. An
accepted generated annotation therefore checks its generated source subtree. -/
theorem disposal_annotation_map (annotation : RowAnnotation normal annotated) :
    RowAnnotation (annotateDisposals normal) (annotateDisposals annotated) := by
  induction annotation with
  | original => exact .original
  | alternatives normal same ih => exact .alternatives ih same
  | sequence first second ihFirst ihSecond => exact .sequence ihFirst ihSecond
  | emitAfter body ih => exact .emitAfter ih
  | choice first second ihFirst ihSecond => exact .choice ihFirst ihSecond

/-- A generated whole-source certificate supplies the generated capture and
tail checks at the actual handler cut. Extra root alternatives may remain in
the certificate; extraction uses their structural source annotation and bounds. -/
theorem PlannedModeSource.handler_cut_checked_generated
    (cut : HandlerCut requested whole captured tail handler)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      whole input output demand requirements scope)
    (annotation : RowAnnotation requirements annotated)
    (certificate : Checked (annotateDisposalStore entries) receiving before (annotateDisposals annotated) certificateRow) :
    ∃ (answer : Value) (residual : List Instance) (middle : PlannedModeValue) (firstDemand secondDemand : List Nat),
    ∃ firstRequirements : Requirements firstDemand, ∃ secondRequirements : Requirements secondDemand,
    ∃ firstScope secondScope decorate,
      CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world
        (.handler handler) answer answer [] (.request [] [])
        (.handler handler.effectInst (tables handler) (families handler)) decorate (handler.effectInst :: residual) residual ∧
      (middle = .value answer ∨ middle = .unwind) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured input middle
        firstDemand firstRequirements firstScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail middle output
        secondDemand secondRequirements secondScope ∧
      scope = firstScope.append secondScope ∧ demand = firstDemand ++ secondDemand ∧
      ∃ firstRow secondRow, firstRow ++ secondRow ⊆ certificateRow ∧
        Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tail ++ receiving) before
          (annotateDisposals firstRequirements) firstRow ∧
        Checked (annotateDisposalStore entries) receiving (spendAll before firstDemand)
          (annotateDisposals secondRequirements) secondRow := by
  obtain ⟨answer, residual, middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, decorate, declaration, boundary, first, second, sameScope, sameDemand, ordinary, generated⟩ :=
    source.handler_cut_disposals cut
  obtain ⟨sourceRow, checked, bounded⟩ := (disposal_annotation_map annotation).checked certificate
  obtain ⟨firstRow, secondRow, firstEval, secondEval, rowSame⟩ :=
    PhaseRechecking.merge_split ((generated (annotateDisposalStore entries) receiving before).symm.trans
      (RecursiveRequirements.checked_complete checked))
  refine ⟨answer, residual, middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, decorate, declaration, boundary, first, second, sameScope, sameDemand,
    firstRow, secondRow, ?_, RecursiveRequirements.evaluate_sound firstEval, RecursiveRequirements.evaluate_sound secondEval⟩
  simpa only [rowSame] using bounded
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.disposal_annotation_map
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.handler_cut_checked_generated

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.split_disposals
