namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Split structural source evidence at the exact decorated append boundary. -/
theorem Context.Source.append_split
    {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (head : Context first) (tail : Context second)
    (source : Context.Source operations policy contracts tables families world (head.append tail) stack) :
    ∃ captured rest, stack = captured.append rest ∧
      Context.Source operations policy contracts tables families world head captured ∧
      Context.Source operations policy contracts tables families world tail rest := by
  induction head generalizing stack with
  | nil => exact ⟨.nil, stack, rfl, .nil, source⟩
  | plain rows rest ih =>
      cases source with
      | plain restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .plain capturedSource, tailSource⟩
  | handler activation rows rest ih =>
      cases source with
      | handler declaration restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .handler declaration capturedSource, tailSource⟩
  | cell rest ih =>
      cases source with
      | cell restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .cell capturedSource, tailSource⟩
  | cleanup latent rows rest ih =>
      cases source with
      | cleanup callback restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .cleanup callback capturedSource, tailSource⟩
  | normal rest ih =>
      cases source with
      | normal restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .normal capturedSource, tailSource⟩
  | unwinding rest ih =>
      cases source with
      | unwinding restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .unwinding capturedSource, tailSource⟩
  | closing rest ih =>
      cases source with
      | closing restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .closing capturedSource, tailSource⟩
  | retiring owner rest ih =>
      cases source with
      | retiring restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .retiring capturedSource, tailSource⟩
  | live saved rest ihSaved ihRest =>
      cases source with
      | live savedSource restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ihRest restSource
          subst_vars
          exact ⟨_, _, rfl, .live savedSource capturedSource, tailSource⟩
  | spent rest ih =>
      cases source with
      | spent restSource =>
          obtain ⟨captured, rest, same, capturedSource, tailSource⟩ := ih restSource
          subst_vars
          exact ⟨_, _, rfl, .spent capturedSource, tailSource⟩

/-- Exact decorated lookup yields source evidence for its physical capture and
remaining lexical suffix; no separate agreement premise is required. -/
theorem Context.Source.cut
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (source : Context.Source operations policy contracts tables families world whole stack)
    (cut : Cut effect operation whole captured tail contract modes) :
    ∃ capStack tailStack, stack = capStack.append tailStack ∧
      Context.Source operations policy contracts tables families world captured capStack ∧
      Context.Source operations policy contracts tables families world tail tailStack := by
  have packedSource : Context.Source operations policy contracts tables families world whole.pack.context stack := source
  rw [cut.decomposition] at packedSource
  exact Context.Source.append_split captured tail packedSource

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
