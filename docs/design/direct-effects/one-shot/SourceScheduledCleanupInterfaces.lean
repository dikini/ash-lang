/-- Updating a selected cell payload preserves the exact rich source stack;
its dormant captures, declaration plans and recursive mode boundaries remain. -/
theorem PlannedModeSource.cell_update
    (update : CellUpdate identity old new before after)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      before input output demand requirements dependencyScope) :
    PlannedModeSource operations policy contracts tables families required outward actions world
      after input output demand requirements dependencyScope := by
  induction update generalizing input demand requirements dependencyScope with
  | hit => cases source with
    | push head rest => cases head with
      | ordinary head => cases head with
        | cell scopeKnown noEscape annotation interface => cases interface with
          | cell scopeTyped excluded =>
              rename_i residual
              exact .push (.ordinary (.cell scopeKnown noEscape annotation
                (.cell (residual := residual) scopeTyped excluded))) rest
      | cell => exact .push .cell rest
  | push miss next ih => cases source with
    | push head rest =>
        simpa only [RecursiveCells.update_context next] using PlannedModeSource.push head (ih rest)
  | live next ih => cases source with
    | live known actionKnown inputAnnotation answerAnnotation scope held saved answer rest =>
        exact .live known actionKnown inputAnnotation answerAnnotation scope held saved answer (ih rest)
    | opening saved rest =>
        have same := RecursiveCells.update_context (tables := tables) next
        simpa only [OwnerPhases.ofStack, same] using PlannedModeSource.opening saved (ih rest)
  | spent next ih => cases source with
    | spent known annotation scope rest => exact .spent known annotation scope (ih rest)
    | skippedSpent rest => exact .skippedSpent (ih rest)

/-- Cell writes preserve all recursive lexical hints, including return modes. -/
theorem cell_update_return_hints {hints : ReturnHints dependencyScope}
    (update : CellUpdate identity old new before after)
    (matched : ReturnHints.Matches tables families hints before) :
    ReturnHints.Matches tables families hints after := by
  induction update generalizing dependencyScope with
  | hit => cases matched with
    | cell tail => exact .cell tail
    | running frame tail => cases frame
  | push miss next ih => cases matched with
    | plain tail => exact .plain (ih tail)
    | handler tail => exact .handler (ih tail)
    | cell tail => exact .cell (ih tail)
    | cleanup tail => exact .cleanup (ih tail)
    | running frame tail => exact .running frame (ih tail)
  | live next ih => cases matched with | live saved tail => exact .live saved (ih tail)
  | spent next ih => cases matched with | spent tail => exact .spent (ih tail)

/-- A payload update leaves each actual saved capture at the same location. -/
theorem cell_update_capture_retained
    (update : CellUpdate identity old new before after)
    (located : SourceTemplates.CapturedIn owner captured before) :
    SourceTemplates.CapturedIn owner captured after := by
  induction update with
  | hit => cases located with | push located => exact .push located
  | push miss next ih => cases located with | push located => exact .push (ih located)
  | live next ih => cases located with
    | here => exact .here
    | saved located => exact .saved located
    | tail located => exact .tail (ih located)
  | spent next ih => cases located with | spent located => exact .spent (ih located)

/-- A primitive cell reply drops its completed request and retains the full
previous raw and generated annotation. Reply typing is derived from the actual
operation signature by the two primitive wrappers. -/
theorem cell_reply_planned_generated
    {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.perform (Instantiation.freezeEffect (.cell identity)) operation operand) input currentDemand currentRequirements checking)
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      beforeStack (.value input) output pendingDemand pendingRequirements dependencyScope)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints beforeStack)
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables beforeStack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand, runtimeScope, beforeStack⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand, runtimeScope, beforeStack⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand, runtimeScope, beforeStack⟩))
    (selected : CellUpdate identity old new beforeStack afterStack)
    (isValue : operand.IsValue)
    (response : ∀ argument result, operations (.cell identity) operation = some (argument, result) →
      SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) allowed reply result)
    (step : RawStep ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand, runtimeScope, beforeStack⟩
      ⟨reply, runtimeScope, afterStack⟩ [] []) :
    ∃ nextAnnotated : Requirements pendingDemand, ∃ nextRow,
      currentDemand = [] ∧
      SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
        reply input [] (.request [] []) .pure ∧
      Certified (evidence := declarationPolicy) outward world Plan.pure ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        afterStack (.value input) output pendingDemand pendingRequirements dependencyScope ∧
      RowAnnotation
        (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables afterStack)) pendingRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world .pure hints ∧
      Pending outward actions phases world hints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families hints afterStack ∧ Bound annotations dependencyScope ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world beforeStack key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world afterStack key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world beforeStack key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world afterStack key body) ∧
      RawStep ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand, runtimeScope, beforeStack⟩ ⟨reply, runtimeScope, afterStack⟩ [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand, runtimeScope, beforeStack⟩)
        (.eval ⟨reply, runtimeScope, afterStack⟩) [] [] ∧
      ownedTickets afterStack = ownedTickets beforeStack ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨reply, runtimeScope, afterStack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨reply, runtimeScope, afterStack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨reply, runtimeScope, afterStack⟩) := by
  generalize frozen : Instantiation.freezeEffect (.cell identity) = actualEffect at current
  cases current with | perform known admitted operandSource formed =>
    cases freeze_effect_injective frozen
    have template := DeclaredSources.expression_erase
      (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase operandSource))
    have empty := SourceTemplates.expression_value_demand template isValue
    cases empty
    obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked rowChecked
    obtain ⟨currentRow, pendingRow, currentCheck, pendingCheck, rowSame⟩ :=
      RecursiveRequirements.checked_sequence_parts normalCheck
    have pendingBound : pendingRow ⊆ row := (rowSame ▸ List.subset_append_right _ _).trans normalBound
    let nextRoot := Requirements.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables afterStack)) pendingRequirements
    have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) pendingRow := by
      apply RecursiveRequirements.evaluate_sound
      simpa only [nextRoot, annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
        RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty, spendAll,
        RecursiveRecomposition.merge_empty_left] using RecursiveRequirements.checked_complete pendingCheck
    have used := LexicalUnwind.raw_computation_machine_use step (by trivial) (by intro owner absent; cases absent) usage
    have accessible := LexicalUnwind.raw_computation_machine_ticket_access step (by trivial)
      (by intro owner absent; cases absent) usage ticketAccess
    refine ⟨.choice nextRoot annotated (.refl _), pendingRow ++ row, rfl,
      SourcePlannedSources.summary_expression (response _ _ known) _, Certified.pure (evidence := declarationPolicy),
      pending.cell_update selected, .alternatives .original (.refl _), .no .here, .no .here,
      .choice nextCheck rowChecked, List.append_subset.mpr ⟨pendingBound, List.Subset.refl _⟩,
      .pure, retained, cell_update_return_hints selected matching, annotationBound,
      ?_, ?_, step, .evaluate step (by trivial), (cell_update_owned_tickets selected).symm,
      by simpa only [advanceUsageTickets] using used,
      by simpa only [advanceUsageTickets] using accessible, ?_⟩
    · intro key body record
      cases record with | resume located known recorded source answer =>
        exact .resume (cell_update_capture_retained selected located) known recorded source answer
    · intro key body record
      cases record with | dispose located held recorded source =>
        exact .dispose (cell_update_capture_retained selected located) held recorded source
    · cases resourceAccess with | eval supported =>
        apply LexicalUnwind.MachineAccess.eval
        apply ScopedExecution.raw_step_preserves_access step supported
        constructor
        · intro identity payload answer savedScope current value rest same closed
          have isValue := closed.1
          have expressionSame := congrArg Configuration.expression same
          change Code.perform _ _ _ = value at expressionSame
          rw [← expressionSame] at isValue
          exact False.elim isValue
        · intro requested operation operand current stack cap outside handler same cut closed
          have expressionSame := congrArg Configuration.expression same
          have effectSame := freeze_effect_injective (Code.perform.inj expressionSame).1
          cases effectSame
          cases same
          exact False.elim (cell_update_excludes_handler_cut selected cut)
        · intro binder owner current caller input answer front cap outside plan same resolve built
          cases same

/-- The builtin read preserves the complete one-shot source and generated certificate. -/
theorem read_cell_planned_generated
    (builtin : operations.erase.erase.ports (.cell identity) 0 = some (.reference identity, .integer))
    {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity))) input currentDemand currentRequirements checking)
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      beforeStack (.value input) output pendingDemand pendingRequirements dependencyScope)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints beforeStack)
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables beforeStack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)), runtimeScope, beforeStack⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)), runtimeScope, beforeStack⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)), runtimeScope, beforeStack⟩))
    (selected : CellUpdate identity payload payload beforeStack afterStack) :
    ∃ nextAnnotated : Requirements pendingDemand, ∃ nextRow,
      currentDemand = [] ∧
      SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
        (.integer payload) input [] (.request [] []) .pure ∧
      Certified (evidence := declarationPolicy) outward world Plan.pure ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        afterStack (.value input) output pendingDemand pendingRequirements dependencyScope ∧
      RowAnnotation
        (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables afterStack)) pendingRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world .pure hints ∧
      Pending outward actions phases world hints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families hints afterStack ∧ Bound annotations dependencyScope ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world beforeStack key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world afterStack key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world beforeStack key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world afterStack key body) ∧
      RawStep ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)), runtimeScope, beforeStack⟩ ⟨(.integer payload), runtimeScope, afterStack⟩ [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)), runtimeScope, beforeStack⟩)
        (.eval ⟨(.integer payload), runtimeScope, afterStack⟩) [] [] ∧
      ownedTickets afterStack = ownedTickets beforeStack ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨(.integer payload), runtimeScope, afterStack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨(.integer payload), runtimeScope, afterStack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨(.integer payload), runtimeScope, afterStack⟩) := by
  apply cell_reply_planned_generated current pending retained matching annotationBound annotation rowChecked
    usage ticketAccess resourceAccess selected (by trivial) ?_ (.readCell identity payload runtimeScope beforeStack afterStack selected)
  intro argument result known
  have answer := (Prod.mk.inj (Option.some.inj (builtin.symm.trans (CoherentSourceTypes.port_lookup
    (SourceDependencyAnnotations.operation_erase (SourcePlannedSources.operation_erase known)))))).2
  cases result <;> cases answer
  exact .integer

