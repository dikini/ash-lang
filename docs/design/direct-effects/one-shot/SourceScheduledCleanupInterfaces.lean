namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open OwnerPhaseTransitions (Phases)
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Operations Contracts Environment Value)

/-- Source-directed cleanup-budget admission. Its eight forms follow the
stable signature, so applications check the authenticated latent body rows too.
Continuation permissions and owner accounting remain the existing independent
Local judgment; this judgment adds the contextual cleanup checks. -/
inductive Budgeted (budget : Footprint) (phases : Phases) :
    (world installations : List Nat) → {dependencies : SourceDependencyAnnotations.Dependencies} →
    {checking : Signature dependencies} → Rows checking →
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} → Context hints → Prop where
  | pure : Budgeted budget phases world installations .pure context
  | request (checked : RequestBudget budget phases effect operation context) :
      Budgeted budget phases world installations (Rows.request (effect := effect) (operation := operation)) context
  | invoke : Budgeted budget phases world installations .invoke context
  | sequence
      (first : Budgeted budget phases world installations firstRows (.plain secondRows context))
      (second : Budgeted budget phases world installations secondRows context) :
      Budgeted budget phases world installations (.sequence firstRows secondRows) context
  | choice (left : Budgeted budget phases world installations first context)
      (right : Budgeted budget phases world installations second context) :
      Budgeted budget phases world installations (.choice first second) context
  | handler
      (body : ∀ activation, activation ∉ installations →
        Budgeted budget phases world (activation :: installations) bodyRows
          (.handler (effect := effect) (table := table) activation declarations context)) :
      Budgeted budget phases world installations
        (.handler (effect := effect) (table := table) (required := required) declarations bodyRows) context
  | cleanup
      (body : Budgeted budget phases world installations bodyRows (.cleanup (needs := needs) latent callbackRows context))
      (callback : Budgeted budget phases world installations callbackRows (.normal context)) :
      Budgeted budget phases world installations (.cleanup (needs := needs) latent callbackRows bodyRows) context
  | resource
      (body : ∀ identity, identity ∉ world →
        Budgeted budget phases (world ++ [identity]) installations (bodyRows identity) (.cell (identity := identity) context)) :
      Budgeted budget phases world installations (.resource bodyRows) context

/-- Already established source checks remain valid when the installation
history grows: subsequent source handlers are checked at every still-fresh id. -/
theorem Budgeted.installations_mono
    (checked : Budgeted budget phases world installations rows context)
    (larger : installations ⊆ nextInstallations) :
    Budgeted budget phases world nextInstallations rows context := by
  induction checked generalizing nextInstallations with
  | pure => exact .pure
  | request checked => exact .request checked
  | invoke => exact .invoke
  | sequence first second ihFirst ihSecond => exact .sequence (ihFirst larger) (ihSecond larger)
  | choice left right ihLeft ihRight => exact .choice (ihLeft larger) (ihRight larger)
  | handler body ih =>
      exact .handler (fun activation fresh => ih activation (fun member => fresh (larger member))
        (by
          intro identity member
          rcases List.mem_cons.mp member with same | old
          · exact List.mem_cons.mpr (.inl same)
          · exact List.mem_cons.mpr (.inr (larger old))))
  | cleanup body callback ihBody ihCallback => exact .cleanup (ihBody larger) (ihCallback larger)
  | resource body ih => exact .resource (fun identity fresh => ih identity fresh larger)

/-- Actual current source retains typing authentication, independent capability
checks, contextual budget admission and exact source agreement for its receiving
stack. This is the source facet; pending code, saved records and lifetime
preservation still belong to the full admitted-machine invariant. -/
structure Admitted
    (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (environment : Environment) (environmentRows : EnvironmentRows environment)
    (world installations : List Nat) (allowed outward : List Instance) (runtimeScope : Execution.Scope)
    (actions : Syntax.UsageTickets) (phases : Phases) (budget : Footprint)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    {scope : SourceDependencyCapture.Scope} {hints : ReturnHints scope} (context : Context hints) (stack : Stack)
    (code : Code) (result : Value) (demand : List Nat) (requirements : Requirements demand)
    {dependencies : SourceDependencyAnnotations.Dependencies} (checking : Signature dependencies)
    (resultRows : ValueRows result) (rows : Rows checking) : Prop where
  source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
    code result demand requirements checking
  authenticated : Auth operations policy ports owners environmentRows source resultRows rows
  capabilities : SourceDependencyChecks.Lexical.ReturnHints.Recursive.Local outward actions phases world dependencies hints
  cleanupBudget : Budgeted budget phases world installations rows context
  contextSource : Context.Source operations.erase policy contracts.erase tables families world context stack

/-- Closed substitution changes the code and its ordinary value environment;
the exact contextual budget certificate and actual lexical receiver are retained. -/
theorem Admitted.substitution
    (checked : Admitted operations policy contracts ports owners (environment.extend name input)
      (environmentRows.extend name inputRows) world installations allowed outward runtimeScope actions phases budget
      tables families context stack code result demand requirements checking resultRows rows)
    (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input)
    (replacementChecked : Auth operations policy ports owners environmentRows replacement inputRows .pure)
    (closed : ClosedValue value) :
    Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (code.subst name value) result demand requirements
      checking resultRows rows :=
  ⟨SourcePlannedSources.substitution checked.source replacement closed,
    checked.authenticated.substitution replacementChecked closed,
    checked.capabilities, checked.cleanupBudget, checked.contextSource⟩

/-- Bind consumes its retained suffix admission; no new cleanup checks are
requested of the reduct. -/
theorem Admitted.bind_expression
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (.bind parameter value body) result demand requirements
      (.sequence initialSignature bodySignature) resultRows (.sequence initialRows bodyRows))
    (closed : ClosedValue value) :
    ∃ reduced, Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (body.subst parameter value) result demand reduced
      bodySignature resultRows bodyRows ∧
      ∀ store receiving before, RecursiveRequirements.evaluate store receiving before reduced =
        RecursiveRequirements.evaluate store receiving before requirements := by
  obtain ⟨reduced, source, authenticated, evaluated⟩ := checked.authenticated.bind_expression closed
  cases checked.capabilities with
  | sequence first second =>
    cases checked.cleanupBudget with
    | sequence firstBudget secondBudget =>
      exact ⟨reduced, ⟨source, authenticated, second, secondBudget, checked.contextSource⟩, evaluated⟩

/-- Application consumes the authenticated latent-body admission already
present in its signature, preserving the original effect bound and evaluation. -/
theorem Admitted.beta_expression
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack (.app (.lambda parameter body) value) result demand requirements
      (.sequence functionSignature (.sequence argumentSignature bodySignature)) resultRows
      (.sequence functionRows (.sequence argumentRows bodyRows)))
    (closed : ClosedValue value) :
    ∃ reduced, Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      .none actions phases budget tables families context stack (body.subst parameter value) result demand reduced
      bodySignature resultRows bodyRows ∧
      ∀ store receiving before, RecursiveRequirements.evaluate store receiving before reduced =
        RecursiveRequirements.evaluate store receiving before requirements := by
  obtain ⟨reduced, source, authenticated, evaluated⟩ := checked.authenticated.beta_expression closed
  cases checked.capabilities with
  | sequence functionCheck rest =>
    cases rest with
    | sequence argumentCheck bodyCheck =>
      cases checked.cleanupBudget with
      | sequence functionBudget restBudget =>
        cases restBudget with
        | sequence argumentBudget bodyBudget =>
          exact ⟨reduced, ⟨source, authenticated, bodyCheck, bodyBudget, checked.contextSource⟩, evaluated⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
