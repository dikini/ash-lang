private theorem PendingChecked.parameters
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted)
    (extension : Syntax.UsageExtension actions nextActions) (larger : world ⊆ nextWorld) (installed : installations ⊆ nextInstallations)
    (target : SourceAdmission.Pending outward nextActions nextBudget nextPhases nextWorld nextInstallations context outside before after) :
    PendingChecked ambient outward target := by
  induction context generalizing outsideScope before after with
  | nil => cases checked; exact .nil
  | plain rows rest ih => cases checked with
    | plain code tail => cases target with
      | plain nextCode nextTail => exact .plain (code.parameters _ _ _ _ _ extension larger installed nextCode) (ih tail nextTail)
    | skipped tail => cases target with
      | skipped nextTail => exact .skipped (ih tail nextTail)
  | handler activation rows rest ih => cases checked with
    | handler tail => cases target with
      | handler nextTail => exact .handler (ih tail nextTail)
  | cell rest ih => cases checked with
    | cell tail => cases target with
      | cell nextTail => exact .cell (ih tail nextTail)
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback tail => cases target with
      | cleanup nextCallback nextTail => exact .cleanup (callback.parameters _ _ _ _ _ extension larger installed nextCallback) (ih tail nextTail)
  | normal rest ih => cases checked with
    | normal tail => cases target with
      | normal nextTail => exact .normal (ih tail nextTail)
  | unwinding rest ih => cases checked with
    | unwinding tail => cases target with
      | unwinding nextTail => exact .unwinding (ih tail nextTail)
  | closing rest ih => cases checked with
    | closing tail => cases target with
      | closing nextTail => exact .closing (ih tail nextTail)
  | retiring owner rest ih => cases checked with
    | retiring tail => cases target with
      | retiring nextTail => exact .retiring (ih tail nextTail)
  | live saved rest ihSaved ihRest => cases checked with
    | live captured tail =>
      rename_i oldCaptured oldTail
      cases target with
      | live nextCaptured nextTail =>
        have same := oldCaptured.return_mode.symm.trans nextCaptured.return_mode
        cases same
        exact .live (ihSaved captured nextCaptured) (ihRest tail nextTail)
    | opening captured tail => cases target with
      | opening nextCaptured nextTail => exact .opening (ihSaved captured nextCaptured) (ihRest tail nextTail)
  | spent rest ih => cases checked with
    | spent tail => cases target with
      | spent nextTail => exact .spent (ih tail nextTail)

theorem CodeChecked.mono
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) :
    ∀ nextWorld nextInstallations, ∀ larger : world ⊆ nextWorld, ∀ installed : installations ⊆ nextInstallations,
      CodeChecked ambient outward (admitted.mono nextWorld nextInstallations larger installed) := by
  intro nextWorld nextInstallations larger installed
  exact checked.parameters _ _ _ _ _ (fun _ _ known => known) larger installed
    (admitted.mono nextWorld nextInstallations larger installed)

theorem PendingChecked.mono
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted)
    (larger : world ⊆ nextWorld) (installed : installations ⊆ nextInstallations) :
    PendingChecked ambient outward (admitted.mono nextWorld nextInstallations larger installed) := by
  exact checked.parameters (fun _ _ known => known) larger installed
    (admitted.mono nextWorld nextInstallations larger installed)

