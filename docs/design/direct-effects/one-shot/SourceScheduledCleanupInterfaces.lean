/-- Returning from a normal cleanup restores the saved authenticated value and
its exact suffix metadata; the installed cleanup owner is completed once. -/
theorem RetainedState.finish_normal_cleanup
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩, issued, completed⟩, actions⟩) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, action.scope, tail⟩, issued, .cleanup action.identity :: completed⟩, actions⟩ := by
  have operational := state.joined.finish_normal_cleanup
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    cases plan with
    | pure =>
      rcases current with ⟨currentSource, currentAuth, localCheck, cleanupBudget, contextSource⟩
      cases currentAuth with
      | unit =>
        cases coherent with
        | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
            restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest =>
          cases head with
          | ordinary frameRows =>
            cases frameRows with
            | running callbackAuth savedAuth =>
              rename_i interface
              cases interface with
              | running savedScope callable savedTyped admitted =>
                cases pendingBudget with
                | normal tailBudget =>
                  cases retained with
                  | normal tailRetained =>
                    cases bound with
                    | running tailBound =>
                      have returned := savedAuth.value_context closed.1 [] action.scope
                      have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows
                          world history [] outward action.scope actions (available (ownedTickets tail)) budget tables families
                          restContext tail value _ [] (.request [] []) .pure _ .pure :=
                        ⟨_, returned, .pure, .pure, rest.forget.source⟩
                      let nextRoot := Requirements.sequence
                        ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) restRequirements
                      have generated : ∀ entries receiving before,
                          evaluate entries receiving before (annotateDisposals nextRoot) =
                            evaluate entries receiving before (annotateDisposals
                              (.sequence ((Requirements.request [] []).prepend
                                (OwnerPhases.ofStack tables (.push (.running action value closed) tail)))
                                (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) restRequirements))) := by
                        intro entries receiving before
                        simp only [nextRoot, annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                          RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty,
                          spendAll, RecursiveRecomposition.merge_empty_left]
                      obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked checked
                      have nextCheck : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets tail))
                          (annotateDisposals nextRoot) normalRow :=
                        RecursiveRequirements.evaluate_sound ((generated _ _ _).trans (RecursiveRequirements.checked_complete normalCheck))
                      refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                        operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
                      apply RetainedSource.eval (annotated := .choice nextRoot annotated (.refl _)) nextCurrent (Certified.pure (evidence := declarationPolicy)) savedScope
                        restSource rest tailBudget tailRetained tailBound ?_
