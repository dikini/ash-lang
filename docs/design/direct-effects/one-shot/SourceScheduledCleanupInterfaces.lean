/-- Allocation opens the same authenticated resource body at the fresh identity,
retains its exact result metadata in the cell frame, and transports the suffix
to the extended world. The source hiding proof supplies the generated budget. -/
theorem RetainedState.enter_resource
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.resource binder initializer body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (isValue : initializer.IsValue) (fresh : identity ∉ world) :
    ∃ payload answer, initializer = .integer payload ∧
      RetainedState operations policy contracts tables families required outward annotations (world ++ [identity]) ambient history
        resumes disposals annotatedStore budget ports owners emptyRows output outputRows
        ⟨⟨.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩,
          issued ++ [Owner.resource identity], completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    obtain ⟨ticket, typed⟩ := scopeTyped
    have ready := ScopedPorts.typed_resource_closed
      (SourceTemplates.expression_ports (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
        (SourcePlannedSources.expression_erase current.source))) typed)
    cases plan with
    | sequence initialPlan remainingPlan => cases remainingPlan with
      | resource bodyPlans =>
        rcases current with ⟨source, authenticated, localCheck, cleanupBudget, contextSource⟩
        cases authenticated with
        | resource initialAuth bodyAuth =>
          rename_i bodyDemand initialDemand initialReq residual bodyReq outwardReq effectsBound hidden admitted formed
            initialRows initialSource bodyRows bodySource
          obtain ⟨payload, initialSame⟩ := ScopedPorts.typed_integer_value
            (SourceTemplates.expression_ports (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
              (SourcePlannedSources.expression_erase initialSource))) typed) isValue
          subst initializer
          cases initialPlan with
          | pure =>
            cases initialAuth
            cases certified with | sequence initialCertified bodyCertified =>
              cases bodyCertified with | resource bodyCertified =>
                cases localCheck with | sequence initialChecked bodyChecked =>
                  cases bodyChecked with | resource bodyChecked =>
                    cases cleanupBudget with | sequence initialBudget restBudget =>
                      cases restBudget with | resource bodyBudget =>
                        have larger : world ⊆ world ++ [identity] := List.subset_append_left _ _
                        let answer := ScopedPorts.embedPort result.erase.erase.port
                        have noEscape : identity ∉ (ScopedPorts.eraseType answer).resources := by
                          simpa only [answer, ScopedPorts.erase_embed_port] using (fun member => fresh (formed member))
                        have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward (world ++ [identity])
                            (.cell identity payload runtimeScope answer) result result [] (.request [] []) (.cell identity) (fun rest => .cell rest)
                            (.cell identity :: residual) residual :=
                          .cell ⟨_, ScopedPorts.effect_scope_has_types typed⟩ noEscape
                            (by simp only [answer, ScopedPorts.erase_embed_port]) (.cell ⟨_, typed⟩ noEscape)
                        have frameRows : FrameRows operations policy contracts tables families required outward (world ++ [identity]) ports owners emptyRows
                            frame resultRows resultRows context (.cell (identity := identity) context) :=
                          .cell (scopeKnown := ⟨_, ScopedPorts.effect_scope_has_types typed⟩) (noEscape := noEscape)
                            (annotation := by simp only [answer, ScopedPorts.erase_embed_port]) (interface := .cell ⟨_, typed⟩ noEscape)
                        have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows
                            (world ++ [identity]) history (.cell identity :: residual) outward runtimeScope actions
                            (available (ownedTickets stack)) budget tables families (.cell (identity := identity) context)
                            (.push (.cell identity payload runtimeScope answer) stack)
                            (body.instantiate (Instantiation.Environment.empty.bind binder identity)) result bodyDemand
                            (bodyReq identity) (signature (bodyPlans identity)) resultRows (bodyRows identity) :=
                          ⟨bodySource identity fresh, bodyAuth identity fresh, bodyChecked identity fresh,
                            bodyBudget identity fresh, .cell (contextSource.world_weaken larger)⟩
                        have nextCertificate : SourceAdmission.Code outward actions budget
                            (available (ownedTickets stack)) (world ++ [identity]) history
                            (bodyRows identity) (.cell (identity := identity) context) := by
                          cases currentCertificate with
                          | sequence initial resource =>
                            cases resource with
                            | resource checkedBody => exact checkedBody identity fresh
                        obtain ⟨nextAnnotated, nextRow, nextAnnotation, rawPath, generatedPath, nextCheck, nextWithin⟩ :=
                          resource_root_annotation (OwnerPhases.ofStack tables stack) annotation checked (hidden identity fresh)
                        have raw : RawStep ⟨.resource binder (.integer payload) body, runtimeScope, stack⟩
                            ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
                              .push (.cell identity payload runtimeScope answer) stack⟩ [.resource identity] [] :=
                          .enterCell binder identity payload body runtimeScope answer stack ready
                        have transition : LexicalUnwind.UseTransition (.eval ⟨.resource binder (.integer payload) body, runtimeScope, stack⟩)
                            (.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
                              .push (.cell identity payload runtimeScope answer) stack⟩) [.resource identity] [] := .evaluate raw trivial
                        have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
                        have ownerFresh : Owner.resource identity ∉ issued := fun member =>
                          fresh (state.issuedResources (ScopedTyping.mem_resource_world.mpr member))
                        have allocation : (issued ++ [Owner.resource identity]).Nodup := by
                          apply List.nodup_append.mpr
                          refine ⟨state.lifetime.1.2, by simp, ?_⟩
                          intro first member second other same
                          have singleton := List.mem_singleton.mp other
                          subst second
                          exact ownerFresh (singleton ▸ member)
                        have event : LexicalUnwind.UseEvent policy
                            ⟨⟨.eval ⟨.resource binder (.integer payload) body, runtimeScope, stack⟩, issued, completed⟩, actions⟩
                            ⟨⟨.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
                              .push (.cell identity payload runtimeScope answer) stack⟩,
                              issued ++ [Owner.resource identity], completed⟩, actions⟩ := by
                          simpa only [List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
                            (LexicalUnwind.UseEvent.step
                              (before := ⟨⟨.eval ⟨.resource binder (.integer payload) body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
                              transition allocation)
                        refine ⟨payload, answer, rfl, ?_⟩
                        refine ⟨?_, ?_, ?_, state.storeAnnotation, event.preserves state.lifetime, ?_, ?_, state.activations, ?_⟩
                        · apply RetainedSource.eval (annotated := nextAnnotated) nextCurrent (bodyCertified identity fresh)
                            ⟨ticket, typed⟩ (.push (.ordinary frame) (pending.world_weaken larger))
                            (.push (.ordinary frameRows) (coherent.world_weaken larger))
                            (.cell (pendingBudget.world_weaken larger))
                            (.cell (SourceDependencySchemes.Lexical.Recursive.pending_transport retained (fun _ h => h) (fun _ _ h => h) larger))
                            (.cell bound) ?_ nextAnnotation nextCheck (nextWithin.trans bounded)
                            nextCertificate (.cell (pendingCertificate.world_weaken larger))
                          simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
                            Bool.true_and] using finite
                        · intro key saved member
                          cases state.resumeRecords key saved member with | resume located known recorded source returns =>
                            exact .resume (.push located) known recorded (source.world_weaken larger) returns
                        · intro key saved member
                          cases state.unwindRecords key saved member with | dispose located held recorded source =>
                            cases source with | paired planned erased same =>
                              exact .dispose (.push located) held recorded (.paired (planned.world_weaken larger)
                                (erased.transport (fun _ _ h => h) larger) same)
                        · simpa only [LexicalUnwind.advanceUseTickets, ScopedExecution.advanceUsageTickets] using
                            transition.ticket_access (by intro owner member; simp at member) unique state.lifetime.2.2 state.tickets
                        · apply LexicalUnwind.transition_access transition.erases state.resources
                          constructor
                          · intro other payload' answer' savedScope scope returned rest same returnedClosed
                            cases same
                            cases returnedClosed.1
                          · intro requested operation operand scope whole cap rest handler same cut operandClosed
                            cases same
                        · simpa only [ScopedTyping.resource_world_append, ScopedTyping.resourceWorld,
                            List.filterMap_append, List.filterMap_cons, List.filterMap_nil] using
                            (ScopedExpressions.append_subset state.issuedResources (List.Subset.refl [identity]))
          | request | invoke | sequence | choice | handler | cleanup | resource => cases initialSource
      | pure | request | invoke | sequence | choice | handler | cleanup => cases current.source
    | pure | request | invoke | choice | handler | cleanup | resource => cases current.source
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

