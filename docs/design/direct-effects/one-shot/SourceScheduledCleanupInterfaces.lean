/-- Ordinary computation preserves the strengthened common state. Its current
source and generated root use the same authenticated reduction witness; the
established joint theorem supplies the unchanged operational facets. -/
theorem RetainedState.computation
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval before, issued, completed⟩, actions⟩)
    (ready : Ready before.expression) (step : RawStep before after [] []) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval after, issued, completed⟩, actions⟩ := by
  have operational := state.joined.computation ready step
  rcases before with ⟨code, runtimeScope, stack⟩
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    obtain ⟨ticket, typed⟩ := scopeTyped
    obtain ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
      nextCurrent, nextCertified, nextScopeTyped, demands, stackSame, _, _, normalTransfer, generatedTransfer⟩ :=
      SourceAdmission.Admitted.computation ⟨current, currentCertificate⟩ certified typed ready step
    rcases after with ⟨nextCode, nextScope, nextStack⟩
    change nextStack = stack at stackSame
    subst nextStack
    obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked checked
    simp only [annotateDisposals, disposal_prepend] at normalCheck
    obtain ⟨currentRow, pendingRow, currentCheck, pendingCheck, normalSame⟩ :=
      RecursiveRequirements.checked_sequence_parts normalCheck
    obtain ⟨nextCurrentRow, nextCurrentCheck, nextWithin⟩ := generatedTransfer
      (annotateDisposalStore annotatedStore) (OwnerPhases.ofStack tables stack ++ [])
      (available (ownedTickets stack)) currentRow
      (RecursiveRequirements.checked_prepend_iff.mp currentCheck)
    let nextRoot := Requirements.sequence (nextRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements
    have nextNormal : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
        (annotateDisposals nextRoot) (nextCurrentRow ++ pendingRow) := by
      simp only [nextRoot, annotateDisposals, disposal_prepend]
      exact .sequence (RecursiveRequirements.checked_prepend_iff.mpr nextCurrentCheck)
        (by simpa only [PhaseRechecking.spendAll_permutation demands] using pendingCheck)
    have nextBound : nextCurrentRow ++ pendingRow ⊆ row := by
      apply List.Subset.trans (List.append_subset.mpr
        ⟨nextWithin.trans (List.subset_append_left _ _), List.subset_append_right _ _⟩)
      simpa only [normalSame] using within
    have aligned : (nextDemand ++ pendingDemand).Perm (currentDemand ++ pendingDemand) := demands.symm.append_right _
    have nextAnnotation : SourceDependencyAnnotations.RowAnnotation nextRoot (.choice nextRoot annotated aligned) :=
      .alternatives .original aligned
    refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
      operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
    exact RetainedSource.eval nextCurrent.previous nextCertified ⟨nextTicket, nextScopeTyped⟩ pending coherent pendingBudget retained bound finite
      nextAnnotation (.choice nextNormal checked)
      ((List.append_subset.mpr ⟨nextBound, List.Subset.refl _⟩).trans bounded) nextCurrent.certificate pendingCertificate

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RetainedState.computation



