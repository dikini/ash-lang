/-- Body substitution authenticates the exact existing rich-source substitution
result, retaining both the result metadata and executed-signature rows. -/
theorem AuthBody.substitution
    {source : SourcePlannedSources.Body operations policy contracts world allowed scope
      (environment.extend parameter argument) code answer header checking}
    {payload : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed operand argument}
    (checked : AuthBody operations policy ports owners (environmentRows.extend parameter argumentRows)
      answerRows source bodyRows)
    (payloadChecked : Auth operations policy ports owners environmentRows payload argumentRows .pure)
    (closed : ClosedValue operand) :
    AuthBody operations policy ports owners environmentRows answerRows
      (SourcePlannedCaptureSubstitution.body_substitution source payload closed) bodyRows := by
  cases checked with
  | typed expression => exact .typed (expression.substitution payloadChecked closed) (rows := by assumption) (closingRows := by assumption)

/-- Extending the contract registry at a fresh owner preserves the closed
payload's exact higher-order metadata under the existing payload transport. -/
theorem Auth.fresh_payload
    {payload : SourcePlannedSources.ValueSummary operations policy contracts world environment payloadAllowed operand argument}
    (checked : Auth operations policy ports owners environmentRows payload argumentRows .pure)
    (closed : ClosedValue operand) (fresh : contracts owner = none)
    (inputRows : ValueRows contract.input) (answerRows : ValueRows contract.answer) :
    Auth operations policy ports (owners.insert owner inputRows answerRows) environmentRows
      (SourcePlannedCaptureSubstitution.fresh_payload payload closed fresh (contract := contract) (allowed := allowed))
      argumentRows .pure := by
  have retargeted := checked.value_context closed.1 allowed .none
  exact retargeted.contract_extension (SourcePlannedTyping.insert_extends contracts fresh)
    (owners.insert owner inputRows answerRows) (owners.compatible_fresh_insert fresh inputRows answerRows)

/-- Once the selected offer is instantiated at its actual fresh owner, payload
transport and substitution retain that same body's authentication and rows. -/
theorem AuthBody.fresh_substitution
    {contract : Contract} {inputRows : ValueRows contract.input} {ownerAnswerRows : ValueRows contract.answer}
    {source : SourcePlannedSources.Body operations policy (contracts.insert owner contract) world allowed scope
      (environment.extend parameter argument) code answer header checking}
    {payload : SourcePlannedSources.ValueSummary operations policy contracts world environment payloadAllowed operand argument}
    (checked : AuthBody operations policy ports (owners.insert owner inputRows ownerAnswerRows)
      (environmentRows.extend parameter argumentRows) answerRows source bodyRows)
    (payloadChecked : Auth operations policy ports owners environmentRows payload argumentRows .pure)
    (closed : ClosedValue operand) (fresh : contracts owner = none) :
    AuthBody operations policy ports (owners.insert owner inputRows ownerAnswerRows) environmentRows answerRows
      (SourcePlannedCaptureSubstitution.body_substitution source
        (SourcePlannedCaptureSubstitution.fresh_payload payload closed fresh) closed) bodyRows :=
  checked.substitution (payloadChecked.fresh_payload closed fresh inputRows ownerAnswerRows) closed

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.AuthBody.substitution
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.fresh_payload
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.AuthBody.fresh_substitution

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
