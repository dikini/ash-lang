namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (ClauseSignatures)
open AccountingTransport

private theorem deep_nil_backward (changed : DeepPureHistory first Context.nil) :
    first.pack = Context.nil.pack := by
  cases changed with | same => rfl

/-- Pure insertion does not create a terminal handler. The reverse direction
is valid even when insertion extends the old handler's tail. -/
theorem TerminalHandler.deep_backward
    (changed : DeepPureHistory first second)
    (terminal : TerminalHandler effect activation rows second) :
    TerminalHandler effect activation rows first := by
  induction changed with
  | same context => exact terminal
  | add changed ih => cases terminal with | plain found => exact ih found
  | plain waiting changed ih => cases terminal with | plain found => exact .plain (ih found)
  | handler declarations changed ih => cases terminal with
    | here =>
        have same := deep_nil_backward changed
        cases same
        exact .here
    | handler found => exact .handler (ih found)
  | cell changed ih => cases terminal with | cell found => exact .cell (ih found)
  | cleanup callback changed ih => cases terminal with | cleanup found => exact .cleanup (ih found)
  | normal changed ih => cases terminal with | normal found => exact .normal (ih found)
  | unwinding changed ih => cases terminal with | unwinding found => exact .unwinding (ih found)
  | closing changed ih => cases terminal with | closing found => exact .closing (ih found)
  | retiring changed ih => cases terminal with | retiring found => exact .retiring (ih found)
  | live saved changed ihSaved ih => cases terminal with | live found => exact .live (ih found)
  | spent changed ih => cases terminal with | spent found => exact .spent (ih found)


/-- A transported actual cut recovers terminality; reverse history and
uniqueness retain the original selected family without guessing decorations. -/
theorem CapturedClauseRows.deep_at_cut
    (selected : CapturedClauseRows effect operation held captured bodyRows)
    (changed : DeepPureHistory captured nextCaptured)
    (nextCut : Cut effect operation nextWhole nextCaptured nextTail contract modes) :
    CapturedClauseRows effect operation held nextCaptured bodyRows := by
  cases selected with
  | selected oldTerminal chosen =>
      obtain ⟨activation, families, declarations, rows, terminal⟩ := nextCut.terminal_handler
      have previous := terminal.deep_backward changed
      obtain ⟨_, _, familiesSame, declarationsSame, rowsSame⟩ := oldTerminal.unique previous
      cases familiesSame
      cases declarationsSame
      cases rowsSame
      exact .selected terminal chosen

/-- The actual cut and selected rows transport together, including the
selected ordinary/protected mode. -/
theorem CapturedClauseRows.deep_cut
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {captured : Context capturedHints} {tail : Context tailHints}
    (related : DeepPureHistory first second)
    (cut : Cut effect operation first captured tail contract modes)
    (selected : CapturedClauseRows effect operation capturedScope.held captured bodyRows) :
    ∃ nextCapturedScope nextTailScope,
    ∃ nextCapturedHints : ReturnHints nextCapturedScope, ∃ nextTailHints : ReturnHints nextTailScope,
    ∃ nextCaptured : Context nextCapturedHints, ∃ nextTail : Context nextTailHints,
      Cut effect operation second nextCaptured nextTail contract modes ∧
      DeepPureHistory captured nextCaptured ∧ DeepPureHistory tail nextTail ∧
      CapturedClauseRows effect operation nextCapturedScope.held nextCaptured bodyRows := by
  obtain ⟨nextCapturedScope, nextTailScope, nextCapturedHints, nextTailHints, nextCaptured, nextTail,
    nextCut, capturedHistory, tailHistory⟩ := related.cut cut
  refine ⟨_, _, _, _, nextCaptured, nextTail, nextCut, capturedHistory, tailHistory, ?_⟩
  have moved := selected.deep_at_cut capturedHistory nextCut
  simpa only [capturedHistory.held] using moved

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
