  · intros
    rename_i first second ihFirst ihSecond nextWorld nextInstallations worldLarger installationsLarger
    exact .sequence (ihFirst _ _ worldLarger installationsLarger) (ihSecond _ _ worldLarger installationsLarger)
  · intros
    rename_i left right ihLeft ihRight nextWorld nextInstallations worldLarger installationsLarger
    exact .choice (ihLeft _ _ worldLarger installationsLarger) (ihRight _ _ worldLarger installationsLarger)
  · intros
    rename_i body ih nextWorld nextInstallations worldLarger installationsLarger
    refine .handler (fun activation fresh => ih activation (fun member => fresh (installationsLarger member)) _ _ worldLarger ?_)
    intro identity member
    rcases List.mem_cons.mp member with same | old
    · exact List.mem_cons.mpr (.inl same)
    · exact List.mem_cons.mpr (.inr (installationsLarger old))
  · intros
    rename_i body callback ihBody ihCallback nextWorld nextInstallations worldLarger installationsLarger
    exact .cleanup (ihBody _ _ worldLarger installationsLarger) (ihCallback _ _ worldLarger installationsLarger)
  · intros
    rename_i body ih nextWorld nextInstallations worldLarger installationsLarger
    refine .resource (fun identity fresh => ih identity (fun member => fresh (worldLarger member)) _ _ ?_ installationsLarger)
    intro item member
    rcases List.mem_append.mp member with old | singleton
    · exact List.mem_append.mpr (.inl (worldLarger old))
    · exact List.mem_append.mpr (.inr singleton)
  · intros
    exact .nil
  · intros
    rename_i code tail ihCode ihTail nextWorld nextInstallations worldLarger installationsLarger
    exact .plain (ihCode _ _ worldLarger installationsLarger) (ihTail _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .skipped (ih _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .handler (ih _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .cell (ih _ _ worldLarger installationsLarger)
  · intros
    rename_i callback tail ihCallback ihTail nextWorld nextInstallations worldLarger installationsLarger
    exact .cleanup (ihCallback _ _ worldLarger installationsLarger) (ihTail _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .normal (ih _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .unwinding (ih _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .closing (ih _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .retiring (ih _ _ worldLarger installationsLarger)
  · intros
    rename_i saved tail ihSaved ihTail nextWorld nextInstallations worldLarger installationsLarger
    exact .live (ihSaved _ _ worldLarger installationsLarger) (ihTail _ _ worldLarger installationsLarger)
  · intros
    rename_i saved tail ihSaved ihTail nextWorld nextInstallations worldLarger installationsLarger
    exact .opening (ihSaved _ _ worldLarger installationsLarger) (ihTail _ _ worldLarger installationsLarger)
  · intros
    rename_i tail ih nextWorld nextInstallations worldLarger installationsLarger
    exact .spent (ih _ _ worldLarger installationsLarger)

theorem Code.world_weaken
    {checking : SourcePlanSignatures.Signature dependencies} {rows : Rows checking}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations rows context)
    (larger : world ⊆ nextWorld) :
    Code outward actions budget phases nextWorld installations rows context :=
  checked.mono _ _ larger (List.Subset.refl _)

theorem Code.installations_mono
    {checking : SourcePlanSignatures.Signature dependencies} {rows : Rows checking}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations rows context)
    (larger : installations ⊆ nextInstallations) :
    Code outward actions budget phases world nextInstallations rows context :=
  checked.mono _ _ (List.Subset.refl _) larger

theorem Pending.world_weaken
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside input output)
    (larger : world ⊆ nextWorld) :
    Pending outward actions budget phases nextWorld installations context outside input output :=
  checked.mono _ _ larger (List.Subset.refl _)

theorem Pending.installations_mono
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside input output)
    (larger : installations ⊆ nextInstallations) :
    Pending outward actions budget phases world nextInstallations context outside input output :=
  checked.mono _ _ (List.Subset.refl _) larger

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
