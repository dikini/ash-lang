namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution
open RecursiveExpressions (Ready ready_not_focus ready_not_value)

/-- A ready ordinary reduction uses the existing ordinary operational rules. -/
theorem ready_step_ordinary (ready : Ready before.expression)
    (step : RawStep before after [] []) :
    ScopedPortJoint.OrdinaryStep before after ∧ after.stack = before.stack := by
  cases step with
  | focus plain focus tail => exact False.elim (ready_not_focus ready focus)
  | plug plain value closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveHandler handler value closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | startCleanup action saved closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveClause owner answer value closed scope caller tail => exact False.elim (ready_not_value ready closed.1)
  | bind _ _ _ _ _ closed environment => exact ⟨.bind closed environment, rfl⟩
  | beta _ _ _ _ _ closed closure => exact ⟨.beta closed closure, rfl⟩
  | ifTrue => exact ⟨.ifTrue, rfl⟩
  | ifFalse => exact ⟨.ifFalse, rfl⟩
  | enterHandler | readCell | writeCell => cases ready

/-- The ordinary ticket-demand proofs do not depend on whole-machine accounting. -/
theorem ready_machine_ticket_access (ready : Ready before.expression)
    (step : ScopedPortJoint.OrdinaryStep before after)
    (access : MachineTicketAccess policy tickets (.eval before)) :
    MachineTicketAccess policy tickets (.eval after) := by
  obtain ⟨current, code, visible, pending⟩ := access
  cases step with
  | bind closed environment => exact ⟨current, bind_code_demand code closed.1, visible, pending⟩
  | beta closed closure =>
      obtain ⟨same, nextCode⟩ := beta_code_demand code closed.1
      subst current
      exact ⟨[], nextCode, List.nil_subset _, pending⟩
  | ifTrue => exact ⟨current, (branch_code_demand code).1, visible, pending⟩
  | ifFalse => exact ⟨current, (branch_code_demand code).2, visible, pending⟩
  | read | write => cases ready

/-- Ready ordinary computation preserves the independent lifetime and access fields. -/
theorem ready_computation_ledger_resources
    (ledger : Ledger (RunState.erase ⟨.eval before, issued, completed⟩))
    (history : UsageRegistryHistory tickets issued)
    (resourceAccess : MachineAccess ambient (.eval before))
    (ready : Ready before.expression) (step : RawStep before after [] []) :
    Event ⟨.eval before, issued, completed⟩ ⟨.eval after, issued, completed⟩ ∧
    Ledger (RunState.erase ⟨.eval after, issued, completed⟩) ∧
    UsageRegistryHistory tickets issued ∧
    MachineAccess ambient (.eval after) ∧ after.stack = before.stack := by
  obtain ⟨ordinary, sameStack⟩ := ready_step_ordinary ready step
  have transition : Transition (.eval before) (.eval after) [] [] :=
    .evaluate step (by cases before; cases ready <;> trivial)
  have event : Event ⟨.eval before, issued, completed⟩ ⟨.eval after, issued, completed⟩ := by
    simpa only [List.append_nil, List.nil_append] using
      (Event.step (before := ⟨.eval before, issued, completed⟩) transition
        (by simpa only [List.append_nil, RunState.erase] using ledger.2))
  refine ⟨event, event_preserves_ledger event ledger, history, ?_, sameStack⟩
  cases resourceAccess with
  | eval supported => exact .eval (raw_step_preserves_access step supported
      (ScopedPortJoint.ordinary_step_access_checks ordinary))

theorem ready_computation_operational
    (ledger : Ledger (RunState.erase ⟨.eval before, issued, completed⟩))
    (history : UsageRegistryHistory tickets issued)
    (ticketAccess : MachineTicketAccess policy tickets (.eval before))
    (resourceAccess : MachineAccess ambient (.eval before))
    (ready : Ready before.expression) (step : RawStep before after [] []) :
    Event ⟨.eval before, issued, completed⟩ ⟨.eval after, issued, completed⟩ ∧
    Ledger (RunState.erase ⟨.eval after, issued, completed⟩) ∧
    UsageRegistryHistory tickets issued ∧
    MachineTicketAccess policy tickets (.eval after) ∧
    MachineAccess ambient (.eval after) ∧ after.stack = before.stack := by
  obtain ⟨event, nextLedger, nextHistory, resources, stackSame⟩ :=
    ready_computation_ledger_resources ledger history resourceAccess ready step
  exact ⟨event, nextLedger, nextHistory,
    ready_machine_ticket_access ready (ready_step_ordinary ready step).1 ticketAccess,
    resources, stackSame⟩

end Ash.OneShot.LexicalUnwind

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open SourceDependencySchemes.Closing (Bound)
open OwnerPhaseTransitions (available)

private theorem branch_ordinary_target (selected : BranchSelection code child)
    (step : ScopedPortJoint.OrdinaryStep ⟨code, runtimeScope, stack⟩ after) :
    after = ⟨child, runtimeScope, stack⟩ := by
  cases selected <;> cases step <;> rfl

/-- Ordinary reduction transports the actual admitted root and its finite check. -/
theorem ExecutionRoot.computation_step
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (ready : RecursiveExpressions.Ready site.expression)
    (step : RawStep ⟨site.expression, site.runtimeScope, site.stack⟩ after [] [])
    (checked : Checked entries receiving phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand, ∃ nextRow,
      next.expression = after.expression ∧ next.runtimeScope = after.scope ∧ next.stack = after.stack ∧
      next.context.pack = site.context.pack ∧
      ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows next nextRoot ∧ demand.Perm nextDemand ∧
      Checked entries receiving phases (annotateDisposals nextRoot) nextRow ∧ nextRow ⊆ row := by
  cases rooted with
  | contextual interpreted =>
      obtain ⟨next, nextDemand, nextRoot, nextRow, expression, scope, stack, context,
        nextRun, sameDemand, nextCheck, bounded, _created, _completed⟩ :=
        site.computation_accounting ready step interpreted checked
      exact ⟨next, nextDemand, nextRoot, nextRow, expression, scope, stack, context,
        .contextual nextRun, sameDemand, nextCheck, bounded⟩
  | focus focused inside => exact False.elim (RecursiveExpressions.ready_not_focus ready focused.1)
  | branch chosen inside =>
      rename_i next
      obtain ⟨ordinary, _⟩ := LexicalUnwind.ready_step_ordinary ready step
      obtain ⟨selected, scope, stack, context, _⟩ := chosen
      have target := branch_ordinary_target selected ordinary
      have expression := congrArg Configuration.expression target
      have afterScope := congrArg Configuration.scope target
      have afterStack := congrArg Configuration.stack target
      exact ⟨_, _, _, _, expression.symm, scope.trans afterScope.symm,
        stack.trans afterStack.symm, context, inside, .refl _, checked, List.Subset.refl _⟩

/-- Bind, beta, and both Boolean reductions preserve the corrected common state. -/
theorem ExecutableState.computation
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval before, issued, completed⟩, actions⟩)
    (ready : RecursiveExpressions.Ready before.expression)
    (step : RawStep before after [] []) :
    LexicalUnwind.Event ⟨.eval before, issued, completed⟩ ⟨.eval after, issued, completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval after, issued, completed⟩, actions⟩ := by
  obtain ⟨event, ledger, registry, resources, stackSame⟩ :=
    LexicalUnwind.ready_computation_ledger_resources state.ledger state.registry state.resources ready step
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows (.eval after) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval before = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
        have beforeSame := LexicalUnwind.Machine.eval.inj machineEq
        have actualReady : RecursiveExpressions.Ready site.expression := by simpa only [beforeSame] using ready
        have actualStep : RawStep ⟨site.expression, site.runtimeScope, site.stack⟩ after [] [] := by
          simpa only [beforeSame] using step
        obtain ⟨rootRow, rootCheck, rootIncluded⟩ := (disposal_annotation_map annotation).checked checked
        obtain ⟨next, nextDemand, nextRoot, nextRow, expressionSame, scopeSame, nextStackSame, contextSame,
          nextRooted, _sameDemand, nextChecked, nextIncluded⟩ := rooted.computation_step actualReady actualStep rootCheck
        have oldStack : before.stack = site.stack := congrArg Configuration.stack beforeSame
        have nextPhase := phaseAgreement.trans
          (congrArg available (congrArg ownedTickets (nextStackSame.trans (stackSame.trans oldStack)).symm))
        have nextBound : Bound annotations next.receiving := by
          have same := congrArg Packed.scope contextSame
          change next.receiving = site.receiving at same
          rw [same]
          exact bound
        have certified := ExecutableSource.eval next nextPhase nextRooted nextBound .original nextChecked
          (nextIncluded.trans (rootIncluded.trans bounded))
        simpa only [expressionSame, scopeSame, nextStackSame] using certified
    | unwind => cases machineEq
  refine ⟨event, nextSource, ?_, ?_, state.storeAnnotation, ledger, registry, resources, ?_, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · simpa only [LexicalUnwind.Machine.stack, stackSame] using state.resumeRecords
  · simpa only [LexicalUnwind.Machine.stack, stackSame] using state.unwindRecords
  · simpa only [LexicalUnwind.Machine.stack, stackSame] using state.activations

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.LexicalUnwind.ready_computation_operational
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.computation_step
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.computation

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)

/-- Branch selection retains the chosen root and check; contextual choice may
narrow both to one authenticated alternative. -/
theorem ExecutionRoot.branch_step
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (selected : BranchSelection site.expression child)
    (checked : RecursiveRequirements.Checked entries receiving phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand, ∃ nextRow,
      next.expression = child ∧ next.runtimeScope = site.runtimeScope ∧ next.stack = site.stack ∧
      next.context.pack = site.context.pack ∧
      ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows next nextRoot ∧ demand.Perm nextDemand ∧
      RecursiveRequirements.Checked entries receiving phases (annotateDisposals nextRoot) nextRow ∧ nextRow ⊆ row :=
  rooted.computation_step selected.ready (selected.step site.runtimeScope site.stack) checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.branch_step

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencySchemes.Closing (Bound)
open OwnerPhaseTransitions (available)

/-- Both Boolean reductions preserve the corrected common state. The actual
selected source subtree carries the same executable root, check and budget;
no successor source or access premise is required. -/
theorem ExecutableState.branch_successor
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩, issued, completed⟩, actions⟩) :
    LexicalUnwind.Event
      ⟨.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩, issued, completed⟩
      ⟨.eval ⟨if condition then yes else no, runtimeScope, stack⟩, issued, completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨if condition then yes else no, runtimeScope, stack⟩, issued, completed⟩, actions⟩ := by
  have selected : BranchSelection (.branch (.boolean condition) yes no) (if condition then yes else no) := by
    cases condition
    · exact .no
    · exact .yes
  exact state.computation selected.ready (selected.step runtimeScope stack)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.branch_successor

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBranchResumeExample
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)
open AuthenticatedResumeExample AuthenticatedBindResumeExample

def expression (flag : Bool) : ScopedExpressions.Code := .branch (.boolean flag) program program

def branchPlan := SourceDeclarationPlans.Plan.sequence .pure
  (SourceDeclarationPlans.Plan.choice programPlan programPlan)

def branchRows := Rows.sequence Rows.pure (Rows.choice programRows programRows)
def branchRequirements : Requirements [0, 0] := .sequence empty (.choice programReq programReq (.refl _))

theorem branchSource (flag : Bool) : SourcePlannedSources.Expression operations policy contracts [] [] runtimeScope
    (fun _ => none) (expression flag) .unit [0, 0] branchRequirements (SourcePlanSignatures.signature branchPlan) :=
  .branch .boolean programSource programSource (.refl _)

theorem branchAuth (flag : Bool) : Auth operations policy ports owners emptyRows
    (branchSource flag) .unit branchRows :=
  .branch .boolean programAuth programAuth

theorem branchCertificate : SourceAdmission.Code [] actions []
    (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] branchRows parentContext :=
  .sequence .pure (.choice programCertificate programCertificate)

theorem branchCertified : SourcePlannedChecks.Certified (evidence := declarationPolicy) [] [] branchPlan :=
  .sequence (evidence := declarationPolicy) pureCertified
    (.choice (evidence := declarationPolicy) programCertified programCertified)

def site (flag : Bool) : ExecutionSite [] operations policy contracts tables families required [] actions
    (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] resumes [] ports owners emptyRows
    (.value .unit) (.value .unit) where
  expression := expression flag
  runtimeScope := runtimeScope
  stack := parentStack
  result := .unit
  resultRows := .unit
  allowed := []
  dependencies := _
  plan := branchPlan
  rows := branchRows
  sourceDemand := [0, 0]
  sourceRequirements := branchRequirements
  receiving := _
  hints := _
  context := parentContext
  current := SourceAdmission.Admitted.of_source (branchSource flag) (branchAuth flag)
    branchCertificate liveRows.forget.source
  certified := branchCertified
  scopeTyped := ⟨_, .bound rfl⟩
  pendingDemand := [1]
  pendingRequirements := liveReq
  pending := liveSource
  coherent := liveRows
  retained := pendingCertificate
  currentResource := .sequence .pure (.choice AuthenticatedBindResumeExample.site.currentResource AuthenticatedBindResumeExample.site.currentResource)
  retainedResource := AuthenticatedBindResumeExample.site.retainedResource

theorem selected (flag : Bool) : (site flag).BranchSelected AuthenticatedBindResumeExample.site := by
  cases flag
  · exact ⟨.no, rfl, rfl, rfl, .falseBranch, HEq.rfl, HEq.rfl⟩
  · exact ⟨.yes, rfl, rfl, rfl, .trueBranch, HEq.rfl, HEq.rfl⟩

theorem branchRoot (flag : Bool) : ExecutionRoot operations policy contracts tables families required [] actions
    (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] resumes [] ports owners emptyRows
    (.value .unit) (.value .unit) (site flag) bindRoot :=
  .branch (selected flag) AuthenticatedBindResumeExample.parentRoot

/-- Both literal branches preserve the already checked executable demand [0,1]. -/
theorem branch_checked (flag : Bool) :
    (site flag).BranchSelected AuthenticatedBindResumeExample.site ∧
    ExecutionRoot operations policy contracts tables families required [] actions
      (OwnerPhaseTransitions.available (ownedTickets parentStack)) [] [] resumes [] ports owners emptyRows
      (.value .unit) (.value .unit) (site flag) (bindRoot : Requirements [0, 1]) ∧
    RecursiveRequirements.Checked (annotateDisposalStore resumes) []
      (OwnerPhaseTransitions.available (ownedTickets parentStack)) (annotateDisposals bindRoot) [] ∧
    RawStep ⟨(site flag).expression, (site flag).runtimeScope, (site flag).stack⟩
      ⟨AuthenticatedBindResumeExample.site.expression, AuthenticatedBindResumeExample.site.runtimeScope,
        AuthenticatedBindResumeExample.site.stack⟩ [] [] :=
  ⟨selected flag, branchRoot flag, bindRootChecked, (selected flag).1.step _ _⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBranchResumeExample
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBranchResumeExample.branch_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open RecursiveRequirements (Requirements Checked evaluate)

private theorem local_owner_generated_store
    (binding : RecursiveRequirements.LocalOwner owner before (localRoot : Requirements localDemand)
      (outerRoot : Requirements outerDemand) after) :
    ∀ first second receiving phases,
      evaluate first receiving phases (annotateDisposals outerRoot) =
        evaluate second receiving phases (annotateDisposals outerRoot) := by
  induction binding with
  | empty | retireSelf | spentSelf | retireOther | spentOther => intro storeA storeB receiving phases; simp only [annotateDisposals, evaluate, RecursiveRequirements.evaluateFuel]
  | sequence first second ihFirst ihSecond =>
      intro storeA storeB receiving phases
      simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, ihFirst storeA storeB, ihSecond storeA storeB]
  | choice first second ihFirst ihSecond =>
      intro storeA storeB receiving phases
      simp only [annotateDisposals, RecursiveRequirements.evaluate_choice, ihFirst storeA storeB, ihSecond storeA storeB]

namespace Accounting

/-- Contextual roots use explicit retirement and lexical execution, so their
finite generated check is independent of scalar continuation records. -/
theorem Run.generated_store {root : Requirements demand}
    (run : Run world installations rows context root) :
    ∀ first second receiving phases,
      evaluate first receiving phases (annotateDisposals root) =
        evaluate second receiving phases (annotateDisposals root) := by
  induction run using Run.rec
      (motive_2 := fun world installations {_} {_} context mode {demand} root _ =>
        ∀ first second receiving phases,
          evaluate first receiving phases (annotateDisposals root) =
            evaluate second receiving phases (annotateDisposals root)) with
  | pure waiting ih | builtin found waiting ih | sequence body ih | installCleanup body ih => exact ih
  | request cut selected body binding ih =>
      obtain ⟨owner, fresh⟩ := ScopedTyping.fresh_world_name _
      exact local_owner_generated_store (binding owner [] fresh)
  | installHandler body ih | installResource body ih =>
      obtain ⟨identity, fresh⟩ := ScopedTyping.fresh_world_name _
      exact ih identity fresh
  | choice left right same ihLeft ihRight =>
      intro storeA storeB receiving phases
      simp only [annotateDisposals, RecursiveRequirements.evaluate_choice, ihLeft storeA storeB, ihRight storeA storeB]
  | resume located restored ih | dispose located abandoned ih =>
      intro storeA storeB receiving phases
      simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveClosing.evaluate_retire, ih storeA storeB]
  | nil => rename_i storeA storeB receiving phases; simp only [annotateDisposals, evaluate, RecursiveRequirements.evaluateFuel]
  | plain code ih | skipped tail ih | handler tail ih | cell tail ih | cleanup callback ih
  | normal tail ih | unwinding tail ih | closing tail ih | opening captured ih => exact ih _ _ _ _
  | retiring tail ih =>
      rename_i storeA storeB receiving phases
      simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveClosing.evaluate_retire, ih storeA storeB]
  | live tail ih | spent tail ih =>
      rename_i storeA storeB receiving phases
      simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_spent, ih storeA storeB]

theorem Wait.generated_store {root : Requirements demand}
    (waiting : Wait world installations context mode root) :
    ∀ first second receiving phases,
      evaluate first receiving phases (annotateDisposals root) =
        evaluate second receiving phases (annotateDisposals root) := by
  cases mode with
  | ordinary => exact (Run.pure waiting).generated_store
  | unwind => exact (Run.pure (.unwinding waiting)).generated_store

theorem Wait.check_store {root : Requirements demand}
    (waiting : Wait world installations context mode root)
    (checked : Checked first receiving phases (annotateDisposals root) row) :
    Checked second receiving phases (annotateDisposals root) row :=
  RecursiveRequirements.evaluate_sound
    ((waiting.generated_store first second receiving phases).symm.trans
      (RecursiveRequirements.checked_complete checked))

end Accounting
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.generated_store
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Wait.generated_store
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Wait.check_store


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport ProtectionResiduals
open RecursiveRequirements (Requirements Checked evaluate)
open SourceDependencyAnnotations (RowAnnotation)
open SourceDependencyFrames (unwindStore)
open OwnerPhaseTransitions (available spendAll)

/-- Administrative lexical unwinding preserves the corrected common state. -/
theorem ExecutableState.advance
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope before, issued, completed⟩, actions⟩)
    (step : LexicalUnwind.Advance before after discharged) :
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      (unwindStore before resumes) (unwindStore before disposals) (unwindStore before annotatedStore)
      budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope after, issued, discharged ++ completed⟩, actions⟩ := by
  have unique := owned_tickets_unique (ledger_unique_live state.ledger)
  have event : LexicalUnwind.Event
      ⟨.unwind runtimeScope before, issued, completed⟩
      ⟨.unwind runtimeScope after, issued, discharged ++ completed⟩ := by
    simpa only [List.append_nil] using
      (LexicalUnwind.Event.step (before := ⟨.unwind runtimeScope before, issued, completed⟩)
        (.advance step) (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
  have nextStore : SourceDependencyAnnotations.StoreAnnotation
      (unwindStore before resumes ++ unwindStore before disposals) (unwindStore before annotatedStore) := by
    rw [← SourceDependencyFrames.unwind_store_combined]
    cases before <;> first | exact state.storeAnnotation | exact state.storeAnnotation.remove_owner _
  have nextAccess : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope after) := by
    cases state.resources with
    | unwind supported => exact .unwind (LexicalUnwind.administrative_access step supported)
  refine ⟨?_, planned_resume_records_advance step state.resumeRecords,
    planned_unwind_records_advance step state.unwindRecords, nextStore,
    LexicalUnwind.event_preserves_ledger event state.ledger, state.registry,
    nextAccess,
    (advance_activation_subset step).trans state.activations, state.issuedResources,
    event.ticket_history state.ticketHistory, state.captureMetadata⟩
  cases state.source with
  | unwind pending coherent pendingCertificate waiting bound annotation checked bounded pendingResource =>
    obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked checked
    cases step
    case' plain =>
      cases coherent
      case' push head rest => cases head; cases pendingCertificate; cases bound; cases waiting; cases pendingResource
    case' handler =>
      cases coherent
      case' push head rest =>
        cases head
        case' handler frameRows => cases frameRows; cases pendingCertificate; cases bound; cases waiting; cases pendingResource
    case' cell =>
      cases coherent
      case' push head rest => cases head; cases pendingCertificate; cases bound; cases waiting; cases pendingResource
    case spent =>
      cases coherent with
      | skippedSpent rest =>
        cases pendingCertificate with | spent tailCertificate =>
          cases bound with | spent tailBound =>
            cases waiting with | spent tailWaiting =>
              cases pendingResource with | spent tailResource =>
                obtain ⟨_, tailRow, _, tailCheck, rowSame⟩ := RecursiveRequirements.checked_sequence_parts normalCheck
                have tailBoundRow := (rowSame ▸ List.subset_append_right _ _).trans normalBound
                exact ExecutableSource.unwind (by assumption) rest tailCertificate tailWaiting tailBound
                  .original tailCheck (tailBoundRow.trans bounded) tailResource.reproof
    case retire owner =>
      cases coherent with
      | push head rest => cases head with
        | retiring =>
          cases pendingCertificate with | retiring tailCertificate =>
            cases bound with | running tailBound =>
              cases waiting with | retiring tailWaiting =>
                obtain ⟨annotatedTail, tailRow, tailAnnotation, path, tailCheck, within⟩ :=
                  retire_annotation_checked_generated annotation checked
                have phaseSame := (SourceDependencyFrames.unwind_owner_phases
                  (LexicalUnwind.Advance.retire (owner := owner) (rest := after)) unique).2
                change spendAll (available (ownedTickets (.push (.retiring owner) after))) [owner] =
                  available (ownedTickets after) at phaseSame
                rw [phaseSame] at tailCheck
                cases pendingResource with | retiring tailResource =>
                  have absent := (List.nodup_cons.mp unique).1
                  have decoratedAbsent := fun member => absent (rest.forget.source.owned_subset member)
                  have transferred := tailResource.spend_absent (by
                    simpa only [Context.append_owned, Context.owned, List.append_nil] using decoratedAbsent)
                  have package := Exists.intro _ transferred
                  simp only [ownedTickets, OwnerPhaseTransitions.spend_available_cons absent] at package
                  obtain ⟨nextCertificate, nextResource⟩ := package
                  exact ExecutableSource.unwind (by assumption) rest nextCertificate tailWaiting tailBound
                    tailAnnotation tailCheck (within.trans bounded) nextResource
    case live owner input answer captured caller restStack =>
      cases coherent with
      | opening answerRows agreement ordinary saved rest =>
        rename_i contract rights boundary ordinaryRequirements savedScope savedDemand savedRequirements
          tailDemand tailRequirements restScope savedHints savedContext tailHints tailContext
          returnMode boundaryRows known actionKnown inputAnnotation answerAnnotation held
          ordinarySource savedSource callerScope tailSource
        cases pendingCertificate with | opening savedCertificate tailCertificate =>
          have actualStep := LexicalUnwind.Advance.live (owner := owner) (input := input) (answer := answer)
            (saved := captured) (scope := caller) (rest := restStack)
          have phaseSame := (SourceDependencyFrames.unwind_owner_phases actualStep unique).2
          simp only [List.filterMap_nil, spendAll] at phaseSame
          cases waiting with | opening savedWaiting =>
            obtain ⟨combined, nextSource, nextRows, _normalEvaluation, _generatedEvaluation⟩ :=
              saved.append_disposals (RecordPendingRows.push (ModeFrameRows.retiring (owner := owner)) rest)
            have nextCheck := savedWaiting.check_store (second := annotateDisposalStore
              (RecursiveTransport.removeOwner owner annotatedStore)) normalCheck
            rw [phaseSame] at nextCheck
            have nextCertificate : SourceAdmission.Pending outward actions budget
                (available (ownedTickets (.live owner input answer captured caller restStack))) world history
                (savedContext.append (.retiring owner tailContext)) .nil .unwind output.mode := by
              apply SourceAdmission.Pending.append (middle := .unwind) (tail := .retiring owner tailContext)
              · simpa only [Context.append, SourceDependencyChecks.Lexical.ReturnHints.append,
                  SourceDependencyCapture.Scope.append] using savedCertificate
              · exact .retiring tailCertificate
            have resourcePair : ∃ certificate : SourceAdmission.Pending outward actions budget
                (available (ownedTickets (.live owner input answer captured caller restStack))) world history
                (savedContext.append (.retiring owner tailContext)) .nil .unwind output.mode,
                InstallationSupport.PendingChecked ambient outward certificate := by
              cases pendingResource with | opening savedResource tailResource =>
                exact ⟨nextCertificate, (InstallationSupport.PendingChecked.append savedResource
                  (InstallationSupport.PendingChecked.retiring tailResource)).reproof⟩
            rw [phaseSame] at resourcePair
            obtain ⟨nextCertificate, nextResource⟩ := resourcePair
            have wholeSource := PlannedModeSource.opening (owner := owner) (input := input) (answer := answer)
              (caller := caller) savedSource tailSource
            exact ExecutableSource.unwind nextSource (nextRows.remove_records owner) nextCertificate savedWaiting
              (SourceDependencySchemes.Lexical.bound_advance actualStep wholeSource.realizes bound)
              .original nextCheck (normalBound.trans bounded) nextResource
    -- Plain, handler and cell frames do not alter the actual waiting root.
    all_goals
      apply ExecutableSource.unwind (by assumption) (by assumption) (by assumption) (by assumption) (by assumption)
        .original _ (normalBound.trans bounded) (by assumption)
      simpa only [unwindStore, ownedTickets] using normalCheck

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.advance

