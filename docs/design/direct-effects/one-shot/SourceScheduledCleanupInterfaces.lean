            cases pendingCertificate with | retiring tailCertificate =>
              cases retained with | retiring tailRetained =>
                cases bound with | running tailBound =>
                  obtain ⟨annotatedTail, tailRow, tailAnnotation, path, tailCheck, within⟩ :=
                    retire_annotation_checked_generated annotation checked
                  have phaseSame := (SourceDependencyFrames.unwind_owner_phases
                    (LexicalUnwind.Advance.retire (owner := owner) (rest := after)) unique).2
                  change spendAll (available (ownedTickets (.push (.retiring owner) after))) [owner] =
                    available (ownedTickets after) at phaseSame
                  rw [phaseSame] at tailCheck
                  refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                    operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
                  apply RetainedSource.unwind (by assumption) rest ?_ ?_ tailBound finite
                    tailAnnotation tailCheck (within.trans bounded) ?_
                  · apply pending_budget_retire_from_source rest.forget tailBudget
                    exact (List.nodup_cons.mp unique).1
                  · apply recursive_pending_restrict tailRetained
                    simpa only [SourceDependencyProjection.scope_append_nil] using
                      SourceConsumingCleanupAdmission.realized_available rest.forget.source.matching.erases
                  · apply pending_certificate_retire_from_source rest.forget tailCertificate
                    exact (List.nodup_cons.mp unique).1
    | @live owner input answer captured caller restStack =>
      cases coherent with
      | opening answerRows agreement ordinary saved rest =>
        rename_i contract rights boundary ordinaryRequirements savedScope savedDemand savedRequirements
          tailDemand tailRequirements restScope savedHints savedContext tailHints tailContext
          returnMode boundaryRows known actionKnown inputAnnotation answerAnnotation held
          ordinarySource savedSource callerScope tailSource
        cases pendingBudget with | opening savedBudget tailBudget =>
          cases pendingCertificate with | opening savedCertificate tailCertificate =>
            cases retained with | opening savedRetained tailRetained =>
              have actualStep := LexicalUnwind.Advance.live (owner := owner) (input := input) (answer := answer)
                (saved := captured) (scope := caller) (rest := restStack)
              have phaseSame := (SourceDependencyFrames.unwind_owner_phases actualStep unique).2
              simp only [List.filterMap_nil, spendAll] at phaseSame
              obtain ⟨annotatedSaved, annotatedTail, savedRow, tailRow, savedAnnotation, tailAnnotation,
                savedPath, tailPath, savedCheck, retireCheck, tailCheck, within⟩ := open_annotation_checked_generated annotation checked
              obtain ⟨combined, nextSource, nextRows, normalEvaluation, generatedEvaluation⟩ :=
                saved.append_disposals (RecordPendingRows.push (ModeFrameRows.retiring (owner := owner)) rest)
              obtain ⟨rawSavedRow, rawSavedCheck, savedWithin⟩ := (disposal_annotation_map savedAnnotation).checked savedCheck
              obtain ⟨rawTailRow, rawTailCheck, tailWithin⟩ := (disposal_annotation_map tailAnnotation).checked tailCheck
              have combinedCheck : Checked (RecursiveTransport.removeOwner owner (annotateDisposalStore annotatedStore)) []
                  (available (ownedTickets (.live owner input answer captured caller restStack)))
                  (annotateDisposals combined) (rawSavedRow ++ rawTailRow) := by
                apply RecursiveRequirements.evaluate_sound
                rw [generatedEvaluation]
                have retainedNormal := Checked.sequence rawSavedCheck (Checked.sequence retireCheck rawTailCheck)
                simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                  RecursiveRequirements.evaluate_prepend, List.append_nil, List.nil_append, Requirements.prepend] using
                  RecursiveRequirements.checked_complete retainedNormal
              have combinedBound : rawSavedRow ++ rawTailRow ⊆ row :=
                (ScopedExpressions.append_subset savedWithin tailWithin).trans within
              let preserved := Requirements.sequence annotatedSaved (.sequence (.retire owner) annotatedTail)
              have preservedCheck : Checked (RecursiveTransport.removeOwner owner (annotateDisposalStore annotatedStore)) []
                  (available (ownedTickets (.live owner input answer captured caller restStack)))
                  (annotateDisposals preserved) (savedRow ++ tailRow) :=
                .sequence savedCheck (.sequence retireCheck tailCheck)
              have nextCheck := Checked.choice (same := List.Perm.refl _) combinedCheck preservedCheck
              rw [phaseSame, ← disposal_store_remove_owner] at nextCheck
              have nextBudget := savedBudget.append (PendingBudget.retiring (owner := owner) tailBudget)
              rw [phaseSame] at nextBudget
              have nextCertificate : SourceAdmission.Pending outward actions budget
                  (available (ownedTickets (.live owner input answer captured caller restStack))) world history
                  (savedContext.append (.retiring owner tailContext)) .nil .unwind output.mode := by
                apply SourceAdmission.Pending.append (middle := .unwind) (tail := .retiring owner tailContext)
                · simpa only [Context.append, SourceDependencyChecks.Lexical.ReturnHints.append,
                    SourceDependencyCapture.Scope.append] using savedCertificate
                · exact .retiring tailCertificate
              rw [phaseSame] at nextCertificate
              have nextRetained := SourceDependencyNeutral.Lexical.Recursive.pending_join savedRetained
                (SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending.retiring tailRetained)
              rw [phaseSame] at nextRetained
              have wholeSource := PlannedModeSource.opening (owner := owner) (input := input) (answer := answer)
                (caller := caller) savedSource tailSource
              refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
              exact RetainedSource.unwind (annotated := .choice combined preserved (.refl _)) nextSource (nextRows.remove_records owner) nextBudget
                nextRetained (SourceDependencySchemes.Lexical.bound_advance actualStep wholeSource.realizes bound)
                (planned_forest_advance actualStep wholeSource.realizes finite)
                (.alternatives .original (.refl _)) nextCheck
                ((List.append_subset.mpr ⟨combinedBound, within⟩).trans bounded) nextCertificate

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
