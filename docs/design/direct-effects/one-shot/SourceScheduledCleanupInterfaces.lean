@[simp] theorem EnvironmentRows.extend_same
    (rows : EnvironmentRows environment) (stored : ValueRows value)
    (known : (environment.extend name value) name = some value) :
    (rows.extend name stored) name value known = stored := by
  simp [EnvironmentRows.extend]

@[simp] theorem EnvironmentRows.extend_other
    (rows : EnvironmentRows environment) (stored : ValueRows value)
    (different : other ≠ name) (known : environment other = some result) :
    (rows.extend name stored) other result (by simpa [Environment.extend, different] using known) =
      rows other result known := by
  simp [EnvironmentRows.extend, different]

/-- Transport of environment metadata evaluates at the same value annotation;
proof arguments carry no additional data. -/
theorem EnvironmentRows.transport_apply
    {first second : Environment} (same : first = second) (rows : EnvironmentRows first)
    (known : second name = some value) :
    (same ▸ rows) name value known = rows name value (same.symm ▸ known) := by
  cases same
  rfl

@[simp] theorem EnvironmentRows.extend_shadow
    (rows : EnvironmentRows environment) (first : ValueRows firstValue) (second : ValueRows secondValue) :
    (Environment.extend_shadow environment name firstValue secondValue ▸
      ((rows.extend name first).extend name second)) = rows.extend name second := by
  funext other result known
  rw [EnvironmentRows.transport_apply]
  by_cases same : other = name
  · subst other
    have values : secondValue = result := Option.some.inj (by simpa [Environment.extend] using known)
    subst result
    simp only [EnvironmentRows.extend_same]
  · simp [EnvironmentRows.extend, same]

@[simp] theorem EnvironmentRows.extend_commute
    (rows : EnvironmentRows environment) (first : ValueRows firstValue) (second : ValueRows secondValue)
    (different : firstName ≠ secondName) :
    (Environment.extend_commute environment firstName secondName firstValue secondValue different ▸
      ((rows.extend firstName first).extend secondName second)) =
      (rows.extend secondName second).extend firstName first := by
  funext other result known
  rw [EnvironmentRows.transport_apply]
  by_cases atFirst : other = firstName
  · subst other
    have values : firstValue = result := Option.some.inj (by simpa [Environment.extend] using known)
    subst result
    simp [EnvironmentRows.extend, different]
  · by_cases atSecond : other = secondName
    · subst other
      have values : secondValue = result := Option.some.inj (by simpa [Environment.extend, atFirst] using known)
      subst result
      simp [EnvironmentRows.extend, atFirst]
    · have old : environment other = some result := by
        simpa [Environment.extend, atFirst, atSecond] using known
      simp [EnvironmentRows.extend, atFirst, atSecond]
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

