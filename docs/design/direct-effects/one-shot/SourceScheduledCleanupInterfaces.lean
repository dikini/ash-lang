/-- Preserve the rich disposal records needed by subsequent lexical discards.
The actual allocation and all source/row/ownership witnesses come from the existing
generated capture theorem; the exact allocator equation supplies record identity. -/
theorem capture_planned_allocation_generated_recorded
    {checking : SourcePlanSignatures.Signature currentDependencies}
    (cut : HandlerCut requested whole capture tail handler)
    (current : SourcePlannedSources.Expression operations policy contracts world allowed caller (fun _ => none)
      (.perform (Instantiation.freezeEffect requested) operation operand) input currentDemand currentRequirements checking)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      whole (.value input) output demand requirements wholeScope)
    {returnHints : SourceDependencyChecks.Lexical.ReturnHints wholeScope}
    (hinted : SourceDependencyChecks.Lexical.ReturnHints.Matches tables families returnHints whole)
    (pendingLocal : SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward actions
      (available (ownedTickets whole)) world returnHints .nil .ordinary output.mode)
    (usage : LexicalUnwind.MachineUse policy actions (.eval
      ⟨.perform (Instantiation.freezeEffect requested) operation operand, caller, whole⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval
      ⟨.perform (Instantiation.freezeEffect requested) operation operand, caller, whole⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval
      ⟨.perform (Instantiation.freezeEffect requested) operation operand, caller, whole⟩))
    (operandSupport : Syntax.resourceDependencies operand.dependencies ⊆ operandBound)
    (operandBoundary : match SourceDependencyCapture.select requested operation wholeScope with
      | some (.handler _ receiving _ _) => operandBound ⊆ receiving.visibleResources ++ ambient
      | _ => False)
    (selected : ClauseAt operation handler.clauses parameter binder code)
    (isValue : operand.IsValue)
    (fresh : contracts owner = none) (freshAction : actions owner = none)
    (absent : owner ∉ ownedTickets whole)
    (bound : Bound annotations wholeScope) (freshAnnotation : annotations owner = none)
    (recorded : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world whole key body)
    (closing : UnwindRecords operations.erase policy contracts.erase tables world whole disposals)
    (closingRecorded : ∀ key body, (key, body) ∈ disposals →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world whole key body)
    (unique : (ownedTickets whole).Nodup)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation requirements annotatedRoot)
    (certificate : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) []
      (available (ownedTickets whole)) (annotateDisposals annotatedRoot) certificateRow)
    (currentCheck : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) (OwnerPhases.ofStack tables whole)
      (available (ownedTickets whole)) currentRequirements requestRow)
    (currentLocal : SourceDependencyChecks.Lexical.ReturnHints.Recursive.Local outward actions
      (available (ownedTickets whole)) world currentDependencies returnHints)
    (finite : SourceContextualRechecking.checkForest required whole wholeScope .nil = true) :
    ∃ (answer : Value) (residual : List Instance) (boundary : PlannedModeValue)
      (capDemand tailDemand : List Nat) (capReq : Requirements capDemand) (tailReq : Requirements tailDemand)
      (capScope tailScope : Receiving),
    ∃ plans : ClausePlans handler.clauses (families handler),
    ∃ (resumeEffects closeEffects : List Instance)
      (family : Nat → Dependencies) (offered : ClauseContract) (advertised : Footprint),
    ∃ bodies : ∀ owner, Plan (family owner),
      Selected operation capScope.held plans parameter binder code bodies ∧
      Certified (evidence := declarationPolicy) outward world (bodies owner) ∧
      wholeScope = capScope.append tailScope ∧ demand = capDemand ++ tailDemand ∧
      PlannedModeSource operations policy contracts tables families required outward actions world capture
        (.value input) boundary capDemand capReq capScope ∧
      (boundary.erase = .value answer.erase ∨ boundary.erase = .unwind) ∧
      SourceDependencyFrames.Frame operations.erase policy contracts.erase tables families world (.handler handler) answer.erase answer.erase [] (.request [] [])
        (.handler handler.effectInst (tables handler) (families handler)) (handler.effectInst :: residual) residual ∧
      lookup operation (tables handler) = some offered ∧
      offered.row capScope.held = some advertised ∧
      (SourceDependencyCapture.lookupDependencies operation (families handler)).bind
        (SourceDependencyCapture.modeDependencies capScope.held) = some family ∧
      residualize (CallableProtectionFrames.contextOf tables tail) advertised = some requestRow ∧
      ∃ cutCertificate : Requirements (capDemand ++ tailDemand), ∃ cutRow,
      RowAnnotation (.sequence (capReq.prepend (OwnerPhases.ofStack tables tail)) tailReq) cutCertificate ∧
      RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets whole)) (annotateDisposals cutCertificate) cutRow ∧
      cutRow ⊆ certificateRow ∧
      RequirementPath annotatedRoot cutCertificate [] ∧
      RequirementPath (.sequence (capReq.prepend (OwnerPhases.ofStack tables tail)) tailReq) cutCertificate [] ∧
      ∀ (capAnnotated : Requirements capDemand) (tailAnnotated : Requirements tailDemand),
        RowAnnotation capReq capAnnotated → RowAnnotation tailReq tailAnnotated →
        RequirementPath (.sequence (capAnnotated.prepend (OwnerPhases.ofStack tables tail)) tailAnnotated) cutCertificate [] →
      ∀ suppliedDemand (suppliedRequirements : Requirements suppliedDemand),
        (ProtectionContexts.protectedMode capture.erase = false →
          PlannedUnwindSource operations policy contracts tables families required outward actions world capture suppliedDemand suppliedRequirements capScope) →
        (offered.dispose = true → RequirementPath suppliedRequirements capAnnotated []) →
      ∃ capRow tailRow, capRow ++ tailRow ⊆ certificateRow ∧
      ∃ closingDemand closingRow, closingDemand.Perm capDemand ∧
      (offered.dispose = false → closingRow = none) ∧
      let contract : SourceDependencyAnnotations.Contract := ⟨input.erase, answer.erase, capScope.held, capDemand, capRow,
        closingDemand, closingRow, resumeEffects, closeEffects⟩
      let nextStack := Stack.live owner (ScopedPorts.embedPort input.erase.erase.port) handler.answer capture handler.scope tail
      let nextResumes : Store := (⟨owner, .resume⟩, ⟨capDemand, capReq⟩) :: resumes
      let nextAnnotations := fun other => if other = owner then some capScope else annotations other
      ∃ nextDisposals nextStore : Store,
        nextDisposals = (if ProtectionContexts.protectedMode capture.erase then disposals else
          (⟨owner, .dispose⟩, ⟨suppliedDemand, suppliedRequirements⟩) :: disposals) ∧
        (offered.dispose = true → RecursiveRequirements.lookup ⟨owner, .dispose⟩ (annotateDisposalStore nextStore) =
          some ⟨suppliedDemand, suppliedRequirements⟩) ∧
        ((offered.dispose = true →
          RequirementPath (suppliedRequirements.prepend [.ordinary (.barrier true)]) capAnnotated []) →
          ProtectedClauseInterface owner contract.erase offered.dispose (annotateDisposalStore nextStore)
            (OwnerPhases.ofStack tables tail) (available (ownedTickets nextStack)) requestRow ∧
          ∃ clauseDemand, ∃ clauseRequirements : Requirements clauseDemand, ∃ clauseRow,
            SourcePlannedSources.Expression operations policy
              (contracts.insert owner (SourcePlannedSources.refineContract contract input answer)) world residual
              (.ticket binder owner) (fun _ => none) (code.subst parameter operand) answer
              clauseDemand clauseRequirements (signature (bodies owner)) ∧
            RecursiveRequirements.Checked (annotateDisposalStore nextStore) (OwnerPhases.ofStack tables nextStack)
              (available (ownedTickets nextStack)) (annotateDisposals clauseRequirements) clauseRow ∧
            clauseRow ⊆ requestRow ++ capRow ∧
            clauseDemand.Perm (owner :: capDemand) ∧
            RowAnnotation
              (.sequence (clauseRequirements.prepend (OwnerPhases.ofStack tables nextStack)) (.sequence (.spent owner) tailReq))
              (.sequence (clauseRequirements.prepend (OwnerPhases.ofStack tables nextStack))
                (.sequence (.spent owner) tailAnnotated)) ∧
            RecursiveRequirements.Checked (annotateDisposalStore nextStore) [] (available (ownedTickets nextStack))
              (annotateDisposals (.sequence (clauseRequirements.prepend (OwnerPhases.ofStack tables nextStack))
                (.sequence (.spent owner) tailAnnotated))) (clauseRow ++ tailRow) ∧
            clauseRow ++ tailRow ⊆ requestRow ++ certificateRow ∧
            (clauseDemand ++ tailDemand).Perm (ownedTickets nextStack)) ∧
        StoreAnnotation (nextResumes ++ nextDisposals) nextStore ∧
        RecursiveRequirements.lookup ⟨owner, .resume⟩ nextStore = some ⟨capDemand, capAnnotated⟩ ∧
        Bound nextAnnotations (.live owner capScope tailScope) ∧
        ClauseRowAdmission.SourceStore operations.erase.erase owner contract.erase (annotateDisposalStore nextStore) ∧
        (∀ key body, (key, body) ∈ nextResumes →
          PlannedResumeAnnotated operations policy (contracts.insert owner (SourcePlannedSources.refineContract contract input answer)) tables families required outward
            (actions.insert owner code.requiredActions) nextAnnotations world nextStack key body) ∧
        (∀ key body, (key, body) ∈ nextDisposals →
          PlannedUnwindAnnotated operations policy (contracts.insert owner (SourcePlannedSources.refineContract contract input answer)) tables families required outward
            (actions.insert owner code.requiredActions) nextAnnotations world nextStack key body) ∧
        UnwindRecords operations.erase policy (contracts.erase.insert owner contract) tables world nextStack nextDisposals ∧
        PlannedModeSource operations policy (contracts.insert owner (SourcePlannedSources.refineContract contract input answer)) tables families required outward
          (actions.insert owner code.requiredActions) world nextStack (.value answer) output tailDemand
          (.sequence (.spent owner) tailReq) (.live owner capScope tailScope) ∧
        (∃ nextHints : SourceDependencyChecks.Lexical.ReturnHints (.live owner capScope tailScope),
          SourceDependencyChecks.Lexical.ReturnHints.Matches tables families nextHints nextStack ∧
          SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward (actions.insert owner code.requiredActions)
            (available (ownedTickets nextStack)) world nextHints .nil .ordinary output.mode ∧
          SourceDependencyChecks.Lexical.ReturnHints.Recursive.Local outward (actions.insert owner code.requiredActions)
            (available (ownedTickets nextStack)) world (family owner) nextHints ∧
          SourceContextualRechecking.checkForest required nextStack (.live owner capScope tailScope) .nil = true ∧
          (∀ installed ∈ SourceContextualRechecking.handlers nextStack,
            ClauseDeclarations outward installed.clauses (families installed) (required installed))) ∧
        RowAnnotation (.sequence (.spent owner) tailReq) (.sequence (.spent owner) tailAnnotated) ∧
        LexicalUnwind.MachineUse policy (actions.insert owner code.requiredActions)
          (.eval ⟨code.subst parameter operand, .ticket binder owner, nextStack⟩) ∧
        LexicalUnwind.MachineTicketAccess policy (actions.insert owner code.requiredActions)
          (.eval ⟨code.subst parameter operand, .ticket binder owner, nextStack⟩) ∧
        LexicalUnwind.MachineAccess ambient
          (.eval ⟨code.subst parameter operand, .ticket binder owner, nextStack⟩) ∧
        RawStep ⟨.perform (Instantiation.freezeEffect requested) operation operand, caller, whole⟩
          ⟨code.subst parameter operand, .ticket binder owner, nextStack⟩ [.ticket owner] [] ∧
        ownedTickets nextStack = owner :: ownedTickets whole ∧
        (ownedTickets nextStack).Nodup ∧
        ((owner :: capDemand) ++ tailDemand).Perm (ownedTickets nextStack) ∧
        spend (available (ownedTickets nextStack)) owner = available (ownedTickets whole) ∧
        RecursiveRequirements.Checked (annotateDisposalStore nextStore) (OwnerPhases.ofStack tables tail)
          (available (ownedTickets whole)) (annotateDisposals capAnnotated) capRow ∧
        RecursiveRequirements.Checked (annotateDisposalStore nextStore) []
          (spendAll (available (ownedTickets whole)) capDemand) (annotateDisposals tailAnnotated) tailRow ∧
        RecursiveRequirements.Checked (annotateDisposalStore nextStore) (OwnerPhases.ofStack tables nextStack)
          (available (ownedTickets nextStack)) (.invoke ⟨owner, .resume⟩ capDemand []) capRow ∧
        ClauseRowAdmission.Interface owner contract.erase offered.dispose (annotateDisposalStore nextStore)
          (OwnerPhases.ofStack tables tail) (available (ownedTickets nextStack)) requestRow := by
  obtain ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    plans, resumeEffects, closeEffects, family, offered, advertised, bodies, chosen, certified,
    scopeSame, demandSame, saved, returns, declaration, offeredKnown, rowAvailable, familyKnown, exported,
    cutCertificate, cutRow, cutAnnotation, cutCheck, cutBound, originalPath, splitPath, finish⟩ :=
    capture_planned_allocation_generated cut current source hinted pendingLocal usage ticketAccess resourceAccess
      operandSupport operandBoundary selected isValue fresh freshAction absent bound freshAnnotation
      recorded closing (fun key body member => (closingRecorded key body member).erase)
      unique storeAnnotation annotation certificate currentCheck currentLocal finite
  refine ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    plans, resumeEffects, closeEffects, family, offered, advertised, bodies, chosen, certified,
    scopeSame, demandSame, saved, returns, declaration, offeredKnown, rowAvailable, familyKnown, exported,
    cutCertificate, cutRow, cutAnnotation, cutCheck, cutBound, originalPath, splitPath, ?_⟩
  intro capAnnotated tailAnnotated capAnnotation tailAnnotation selectedPath suppliedDemand suppliedRequirements suppliedSource cleanupPath
  obtain ⟨capRow, tailRow, within, closingDemand, closingRow, balanced, noClosing,
    nextDisposals, nextStore, origin, closingLookup, guarded,
    nextAnnotation, nextLookup, nextBound, sourceStore, nextResumes, oldClosing, closingRecords,
    nextSource, nextLocal, tailAnnotation, nextUse, nextTickets, nextResources, step,
    ownedSame, nextUnique, afterBalance, phaseSame, capChecked, tailChecked, resumeChecked, interface⟩ :=
    finish capAnnotated tailAnnotated capAnnotation tailAnnotation selectedPath
      suppliedDemand suppliedRequirements (fun held => (suppliedSource held).erase) cleanupPath
  refine ⟨capRow, tailRow, within, closingDemand, closingRow, balanced, noClosing,
    nextDisposals, nextStore, origin, closingLookup, guarded,
    nextAnnotation, nextLookup, nextBound, sourceStore, nextResumes, ?_, closingRecords,
    nextSource, nextLocal, tailAnnotation, nextUse, nextTickets, nextResources, step,
    ownedSame, nextUnique, afterBalance, phaseSame, capChecked, tailChecked, resumeChecked, interface⟩
  exact capture_planned_unwind_records cut suppliedSource freshAnnotation closingRecorded
    (SourcePlannedTyping.insert_extends contracts fresh)
    (Syntax.fresh_usage_insert_extends freshAction) origin

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.capture_planned_allocation_generated_recorded

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Value)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (Signature signature)
open SourcePlannedChecks (Certified)
open SourceDependencyAnnotations (Dependencies RowAnnotation RequirementPath)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (spendAll)

/-- A returned value reconstructs the waiting context's actual source and
certified plan. Recursive checks come from the waiting context; value bodies
retain their complete rich source typing. -/
theorem plug_context_certified
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    {checking : Signature dependencies}
    (same : signature plan = checking)
    (context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
      position input output demand requirements checking)
    (child : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints) :
    ∃ combined : Requirements demand, ∃ nextDependencies, ∃ nextPlan : Plan nextDependencies,
      SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        (position.plug value) output demand combined (signature nextPlan) ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      Local outward actions phases world nextDependencies hints ∧
      ∀ entries receiving before,
        evaluate entries receiving before (annotateDisposals combined) =
          evaluate entries receiving before (annotateDisposals requirements) := by
  have childSource := SourcePlannedSources.summary_expression child scope
  cases context with
  | pairLeft right =>
    refine ⟨_, _, .sequence .pure plan, .pair childSource (by simpa only [same] using right), Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
    intro entries receiving before
    simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty,
      spendAll, RecursiveRecomposition.merge_empty_left]
  | pairRight left =>
    cases plan
    refine ⟨_, _, .pure, .purePair (SourcePlannedSources.summary_expression left scope) childSource, Certified.pure (evidence := declarationPolicy), .pure, ?_⟩
    intros; rfl
  | appFunction argument admitted =>
    cases plan with | sequence argumentPlan bodyPlan =>
      obtain ⟨argumentSame, bodySame⟩ := Signature.sequence.inj same
      cases bodySame
      cases argumentSame
      refine ⟨_, _, .sequence .pure (.sequence argumentPlan bodyPlan), .app childSource argument admitted,
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
      intro entries receiving before
      simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
  | appArgument function admitted =>
    refine ⟨_, _, .sequence .pure (.sequence .pure plan),
      by simpa only [signature, same, Context.plug, List.nil_append] using SourcePlannedSources.Expression.app (SourcePlannedSources.summary_expression function scope) childSource admitted,
      Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified), .sequence .pure (.sequence .pure checked), ?_⟩
    intro entries receiving before
    simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence,
      RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left,
      RecursiveContexts.evaluate_request, List.nil_append]
  | bind body =>
    refine ⟨_, _, .sequence .pure plan, .bind childSource (by simpa only [same] using body), Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
    intro entries receiving before
    simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty,
      spendAll, RecursiveRecomposition.merge_empty_left]
  | branch yes no balanced =>
    cases plan with | choice yesPlan noPlan =>
      obtain ⟨yesSame, noSame⟩ := Signature.choice.inj same
      cases yesSame
      cases noSame
      refine ⟨_, _, .sequence .pure (.choice yesPlan noPlan), .branch childSource yes no balanced,
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
      intro entries receiving before
      simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty,
        spendAll, RecursiveRecomposition.merge_empty_left]
  | perform known admitted formed =>
    refine ⟨_, _, .sequence .pure plan, by simpa only [signature, same, Context.plug] using SourcePlannedSources.Expression.perform known admitted childSource formed,
      Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
    intro entries receiving before
    simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRecomposition.evaluate_empty,
      spendAll, RecursiveRecomposition.merge_empty_left, RecursiveContexts.evaluate_request, List.nil_append]
  | resume known resolved permission admitted formed =>
    refine ⟨_, _, .sequence .pure plan, by simpa only [signature, same, Context.plug, List.nil_append] using SourcePlannedSources.Expression.resume known resolved permission childSource admitted formed,
      Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
    intro entries receiving before
    simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty,
      spendAll, RecursiveRecomposition.merge_empty_left]
  | cleanup body admitted =>
    let nextPlan := Plan.sequence .pure plan
    cases plan with | cleanup callbackPlan bodyPlan =>
      obtain ⟨callbackSame, bodySame⟩ := Signature.cleanup.inj same
      cases callbackSame
      cases bodySame
      refine ⟨_, _, nextPlan, .cleanup childSource body admitted,
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
      intro entries receiving before
      simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
  | resource body formed effectsBound admitted hidden =>
    cases plan with | resource bodyPlan =>
      have bodySame := Signature.resource.inj same
      cases bodySame
      refine ⟨_, _, .sequence .pure (.resource bodyPlan), .resource childSource body formed effectsBound admitted hidden,
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified, .sequence .pure checked, ?_⟩
      intro entries receiving before
      simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty,
        spendAll, RecursiveRecomposition.merge_empty_left]
/-- A returned value is silent at the immediate root. Rebuilding its waiting
context keeps the old annotation and both path kinds using the same successor
requirements supplied by authenticated reconstruction. -/
theorem plug_root_annotation
    (plain : PlainData)
    {currentRequirements : Requirements []}
    {restRequirements nextRequirements : Requirements restDemand}
    {pendingRequirements : Requirements pendingDemand}
    (silent : ∀ entries receiving before,
      evaluate entries receiving before (annotateDisposals currentRequirements) = some [])
    (evaluation : ∀ entries receiving before,
      evaluate entries receiving before (annotateDisposals nextRequirements) =
        evaluate entries receiving before (annotateDisposals restRequirements))
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.plain plain) tail)))
        (.sequence (restRequirements.prepend (OwnerPhases.ofStack tables tail)) pendingRequirements)) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row) :
    let nextRoot := Requirements.sequence
      (nextRequirements.prepend (OwnerPhases.ofStack tables tail)) pendingRequirements
    ∃ nextAnnotated : Requirements (restDemand ++ pendingDemand), ∃ nextRow,
      RowAnnotation nextRoot nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row := by
  let nextRoot := Requirements.sequence
    (nextRequirements.prepend (OwnerPhases.ofStack tables tail)) pendingRequirements
  have generated : ∀ entries receiving before, evaluate entries receiving before (annotateDisposals nextRoot) =
      evaluate entries receiving before (annotateDisposals
        (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.plain plain) tail)))
          (.sequence (restRequirements.prepend (OwnerPhases.ofStack tables tail)) pendingRequirements))) := by
    intro entries receiving before
    simp only [nextRoot, annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
      RecursiveRequirements.evaluate_prepend, silent, spendAll, RecursiveRecomposition.merge_empty_left, evaluation]
  obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked rowChecked
  have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) normalRow :=
    RecursiveRequirements.evaluate_sound ((generated entries receiving before).trans (RecursiveRequirements.checked_complete normalCheck))
  exact ⟨.choice nextRoot annotated (.refl _), normalRow ++ row,
    .alternatives .original (.refl _), .no .here, .no .here, .choice nextCheck rowChecked,
    List.append_subset.mpr ⟨within, List.Subset.refl _⟩⟩


/-- Returning a value removes one waiting frame and preserves the full rich
source, recursive lexical checks, generated row certificate and owner records. -/
theorem plug_planned_generated
    {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      value input currentDemand currentRequirements checking)
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.plain plain) tail) (.value input) output pendingDemand pendingRequirements dependencyScope)
    (closed : ClosedValue value)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints (.push (.plain plain) tail))
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.plain plain) tail))) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩)) :
    ∃ (nextInput : Value) (frameDemand tailDemand : List Nat),
    ∃ nextRequirements : Requirements frameDemand, ∃ tailRequirements : Requirements tailDemand,
    ∃ nextDependencies, ∃ nextPlan : Plan nextDependencies,
    ∃ restDependencies restScope boundary, ∃ restHints : ReturnHints restScope,
    ∃ nextAnnotated : Requirements (frameDemand ++ tailDemand), ∃ nextRow,
      dependencyScope = .plain restDependencies restScope ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports plain.scope ∧
      currentDemand = [] ∧ pendingDemand = frameDemand ++ tailDemand ∧
      SourcePlannedSources.Expression operations policy contracts world boundary plain.scope (fun _ => none)
        (plain.context.plug value) nextInput frameDemand nextRequirements (signature nextPlan) ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        tail (.value nextInput) output tailDemand tailRequirements restScope ∧
      RowAnnotation
        (.sequence (nextRequirements.prepend (OwnerPhases.ofStack tables tail)) tailRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world nextDependencies restHints ∧
      Pending outward actions phases world restHints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families restHints tail ∧ Bound annotations restScope ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.plain plain) tail) key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.plain plain) tail) key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      RawStep ⟨value, runtimeScope, .push (.plain plain) tail⟩ ⟨plain.context.plug value, plain.scope, tail⟩ [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩)
        (.eval ⟨plain.context.plug value, plain.scope, tail⟩) [] [] ∧
      ownedTickets tail = ownedTickets (.push (.plain plain) tail) ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨plain.context.plug value, plain.scope, tail⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨plain.context.plug value, plain.scope, tail⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨plain.context.plug value, plain.scope, tail⟩) := by
  have template := DeclaredSources.expression_erase
    (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase current))
  have empty := SourceTemplates.expression_value_demand template closed.1
  subst currentDemand
  cases pending with | @push entry initial middle firstDemand first layer rest output tailDemand second restScope frame suffix =>
    cases frame with | ordinary frame =>
      cases frame with | plain context scope inputAnnotation outputAnnotation certified =>
        cases matching with | plain matched =>
          cases retained with | plain waiting rest =>
            cases annotationBound with | plain bound =>
              have waitingCheck := waiting.reindex_scope (SourceDependencyProjection.scope_append_nil _)
                (return_hints_append_nil _)
              obtain ⟨combined, nextDependencies, nextPlan, source, nextCertified, nextLocal, evaluation⟩ :=
                plug_context_certified rfl context
                  (SourcePlannedSources.Values.change_allowed (SourcePlannedSources.value_summary current closed.1) closed.1 _)
                  certified waitingCheck
              have silent : ∀ entries receiving before,
                  evaluate entries receiving before (annotateDisposals currentRequirements) = some [] := by
                intro entries receiving before
                rw [SourcePlannedSources.template_value_disposals template closed.1]
                exact RecursiveRecomposition.value_evaluation template closed.1
              obtain ⟨nextAnnotated, nextRow, nextAnnotation, rawPath, generatedPath, nextChecked, included⟩ :=
                plug_root_annotation plain silent evaluation annotation rowChecked
              have step : RawStep ⟨value, runtimeScope, .push (.plain plain) tail⟩ ⟨plain.context.plug value, plain.scope, tail⟩ [] [] :=
                .plug plain value closed runtimeScope tail
              refine ⟨_, _, _, combined, _, _, nextPlan, _, _, _, _,
                nextAnnotated, nextRow,
                rfl, ⟨_, scope⟩, rfl, rfl, source, nextCertified, suffix, nextAnnotation, rawPath, generatedPath,
                nextChecked, included,
                nextLocal, rest, matched, bound, ?_, ?_, step,
                .evaluate step (LexicalUnwind.value_computation_head closed.1), rfl,
                LexicalUnwind.raw_value_machine_use step closed usage,
                LexicalUnwind.raw_value_machine_ticket_access step closed usage ticketAccess, ?_⟩
              · intro key body record
                cases record with | resume located known recorded source answer =>
                  cases located with | push located => exact .resume located known recorded source answer
              · intro key body record
                cases record with | dispose located held recorded source =>
                  cases located with | push located => exact .dispose located held recorded source
              · cases resourceAccess with | eval supported =>
                  apply LexicalUnwind.MachineAccess.eval
                  apply ScopedExecution.raw_step_preserves_access step supported
                  constructor
                  · intro identity payload answer savedScope current value rest same closed
                    cases same
                  · intro requested operation operand current stack cap outside handler same cut operandClosed
                    have impossible := congrArg Configuration.expression same
                    change value = _ at impossible
                    have isValue := closed.1
                    rw [impossible] at isValue
                    exact False.elim isValue
                  · intro binder owner current caller input answer front cap outside plan same resolve built
                    have impossible := congrArg Configuration.expression same
                    change value = _ at impossible
                    have isValue := closed.1
                    rw [impossible] at isValue
                    exact False.elim isValue

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
