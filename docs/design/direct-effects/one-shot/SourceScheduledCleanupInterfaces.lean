/-- Inverting a retirement source exposes its exact waiting source. -/
theorem PlannedModeSource.retire_value_pop
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.retiring owner) tail) (.value input) output demand requirements dependencyScope) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand, ∃ nextScope,
      demand = [owner] ++ nextDemand ∧
      HEq requirements (Requirements.sequence (.retire owner) nextRequirements) ∧
      dependencyScope = .running nextScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        tail (.value input) output nextDemand nextRequirements nextScope := by
  cases pending with | push frame rest =>
    cases frame with
    | ordinary frame => cases frame with | retiring known interface => exact ⟨_, _, _, rfl, HEq.rfl, rfl, rest⟩
    | retiring => exact ⟨_, _, _, rfl, HEq.rfl, rfl, rest⟩

/-- A value crosses retirement at its original rich type. The retiring owner
is removed from ownership and callable records, the exact waiting annotation
survives, and its check runs at the consumed phase. -/
theorem retire_value_planned_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      value input currentDemand currentRequirements (signature plan))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.retiring owner) tail) (.value input) output pendingDemand pendingRequirements dependencyScope)
    (closed : ClosedValue value)
    (retained : Pending outward actions (available (ownedTickets (.push (.retiring owner) tail))) world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints (.push (.retiring owner) tail))
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.retiring owner) tail)))
        pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (unique : (ownedTickets (.push (.retiring owner) tail)).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩)) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand, ∃ nextScope,
    ∃ nextHints : ReturnHints nextScope, ∃ tailAnnotated : Requirements nextDemand,
    ∃ nextAnnotated : Requirements ([] ++ nextDemand), ∃ nextRow,
      currentDemand = [] ∧ pendingDemand = [owner] ++ nextDemand ∧ dependencyScope = .running nextScope ∧
      SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
        value input [] (.request [] []) (signature Plan.pure) ∧
      Certified (evidence := declarationPolicy) outward world Plan.pure ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        tail (.value input) output nextDemand nextRequirements nextScope ∧
      RowAnnotation nextRequirements tailAnnotated ∧
      RowAnnotation (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) nextRequirements) nextAnnotated ∧
      RequirementPath tailAnnotated annotated [owner] ∧
      RequirementPath (annotateDisposals tailAnnotated) (annotateDisposals annotated) [owner] ∧
      RequirementPath tailAnnotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals tailAnnotated) (annotateDisposals nextAnnotated) [] ∧
      Checked (RecursiveTransport.removeOwner owner entries) receiving (spendAll before [owner]) (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions (available (ownedTickets tail)) world .pure nextHints ∧
      Pending outward actions (available (ownedTickets tail)) world nextHints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families nextHints tail ∧ Bound annotations nextScope ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.retiring owner) tail) key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.retiring owner) tail) key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      (value = .unit → RawStep ⟨value, runtimeScope, .push (.retiring owner) tail⟩
        ⟨value, runtimeScope, tail⟩ [] [.ticket owner]) ∧
      LexicalUnwind.UseTransition (.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩)
        (.eval ⟨value, runtimeScope, tail⟩) [] [.ticket owner] ∧
      ownedTickets (.push (.retiring owner) tail) = owner :: ownedTickets tail ∧
      OwnerPhaseTransitions.spend (available (ownedTickets (.push (.retiring owner) tail))) owner = available (ownedTickets tail) ∧
      (ownedTickets tail).Nodup ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, tail⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, tail⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, tail⟩) := by
  have empty := SourceTemplates.expression_value_demand
    (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
      (SourcePlannedSources.expression_erase current))) closed.1
  subst currentDemand
  obtain ⟨nextDemand, nextRequirements, nextScope, demandSame, requirementsSame, scopeSame, rest⟩ := pending.retire_value_pop
  subst pendingDemand dependencyScope
  cases requirementsSame
  cases matching with | running frame restMatch =>
  cases frame
  rename_i restHints
  cases retained with | retiring restCheck =>
  cases annotationBound with | running restBound =>
  obtain ⟨tailAnnotated, tailAnnotation, tailPath⟩ := annotation.focus
    (RequirementPath.second (RequirementPath.second (.here)))
  obtain ⟨tailRow, tailChecked, within⟩ := (disposal_subtree_path tailPath).checked rowChecked
  simp only [List.nil_append] at tailChecked within tailPath
  have removed : Checked (RecursiveTransport.removeOwner owner entries) receiving (spendAll before [owner])
