namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDeclarationPlans (Plan ClausePlans)
open SourcePlanSignatures (signature clauseSignatures)
open SourcePlannedChecks (Certified)
open RecursiveRequirements (Requirements)
open SourceDependencySchemes.Closing (Bound)

/-- The supplied fresh installation selects the authenticated body and preserves
existing registry meanings, rich saved records and the same execution root. -/
theorem ExecutionSite.install_handler_accounting
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (expressionEq : site.expression = .handle (Instantiation.freezeEffect effect) code arms)
    (interpreted : Accounting.Run world installations site.rows site.context (root : Requirements demand))
    (installed : site.stack.erase.activations ⊆ installations)
    (activation : Nat) (fresh : activation ∉ installations) :
    ∃ handler : HandlerData, ∃ nextTables nextFamilies nextRequired,
    ∃ next : ExecutionSite ambient operations policy contracts nextTables nextFamilies nextRequired outward actions phases
      world (installations ++ [activation]) resumes budget ports owners emptyRows output outputRows,
      handler.activation = activation ∧ handler.scope = site.runtimeScope ∧
      handler.effectInst = effect ∧ handler.clauses = arms ∧
      next.expression = code ∧ next.runtimeScope = site.runtimeScope ∧
      next.stack = .push (.handler handler) site.stack ∧
      (∀ old, old.activation ∈ site.stack.erase.activations →
        tables old = nextTables old ∧ families old = nextFamilies old ∧ required old = nextRequired old) ∧
      Accounting.Run world (installations ++ [activation]) next.rows next.context root ∧
      (∀ annotations, Bound annotations site.receiving → Bound annotations next.receiving) ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [] := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at expressionEq interpreted installed ⊢
  subst expression
  generalize frozen : Instantiation.freezeEffect effect = syntaxEffect at current
  rcases current with ⟨current, certificate⟩
  change CodeChecked ambient outward certificate at currentResource
  change PendingChecked ambient outward retained at retainedResource
  cases plan with
  | handler needed plans bodyPlan =>
    rename_i priorArms clauseDependencies bodyDependencies effectPlan table
    dsimp only [signature] at rows current certificate currentResource interpreted
    generalize signatureSame : clauseSignatures plans = declarationSignature at rows current certificate currentResource interpreted
    rcases current with ⟨source, authenticated, localCheck, cleanupBudget, contextSource⟩
    cases authenticated with
    | handler bodyAuth declarationsAuth =>
      rename_i residual admitted capabilities unique bodyReq coverage clauses modes actual actualRows declarations bodyRows body
      cases freeze_effect_injective frozen
      cases certified with | handler recipes clausesCertified bodyCertified =>
        have actualRecipes := ClauseDeclarations.signature_congr recipes signatureSame
        have actualCertified := certified_clause_signatures clausesCertified signatureSame
        let handler : HandlerData := ⟨activation, effect, arms, runtimeScope,
          ScopedPorts.embedPort result.erase.erase.port, ScopedPorts.clauses_have_ticket_barrier clauses⟩
        let nextTables := RecursiveHandlerTables.register tables activation table
        let nextFamilies : SourceDependencyFrames.Families := fun old => if old.activation = activation then clauseDependencies else families old
        let nextRequired : SourceContextualRechecking.Required := fun old => if old.activation = activation then needed else required old
        have tableInstalled : nextTables handler = table := RecursiveHandlerTables.registered_lookup rfl
        have familiesInstalled : nextFamilies handler = clauseDependencies := by simp [nextFamilies, handler]
        have requiredInstalled : nextRequired handler = needed := by simp [nextRequired, handler]
        have tablesAgree : ∀ old, old.activation ∈ stack.erase.activations → tables old = nextTables old :=
          RecursiveHandlerTables.register_agrees (fun member => fresh (installed member))
        have familiesAgree : ∀ old, old.activation ∈ stack.erase.activations → families old = nextFamilies old := by
          intro old member
          have different : old.activation ≠ activation := fun same => fresh (same ▸ installed member)
          simp [nextFamilies, different]
        have requiredAgree : ∀ old, old.activation ∈ stack.erase.activations → required old = nextRequired old := by
          intro old member
          have different : old.activation ≠ activation := fun same => fresh (same ▸ installed member)
          simp [nextRequired, different]
        have moved := coherent.registries tablesAgree familiesAgree requiredAgree
        obtain ⟨decorate, frame, frameRows⟩ := FrameRows.handler_install
          handler context declarationsAuth scopeTyped
          (by simp only [handler, ScopedPorts.erase_embed_port]) clauses coverage unique actualRecipes capabilities modes actualCertified
          tableInstalled familiesInstalled requiredInstalled
        have nextCoherent := RecordPendingRows.push (ModeFrameRows.ordinary frameRows) moved
        have bodyHistory : activation :: installations ⊆ installations ++ [activation] := by
          intro name member
          rcases List.mem_cons.mp member with same | old
          · exact same ▸ List.mem_append_right _ List.mem_cons_self
          · exact List.mem_append_left _ old
        cases certificate with | handler bodyCertificate =>
          have selected := (bodyCertificate activation fresh).installations_mono bodyHistory
          have nextRun := (interpreted.enter_handler fresh).mono (List.Subset.refl _) bodyHistory
          let next : ExecutionSite ambient operations policy contracts nextTables nextFamilies nextRequired outward actions phases
              world (installations ++ [activation]) resumes budget ports owners emptyRows output outputRows :=
            { expression := code, runtimeScope := runtimeScope, stack := .push (.handler handler) stack,
              result := result, resultRows := resultRows, allowed := effect :: residual,
              dependencies := bodyDependencies, plan := bodyPlan, rows := bodyRows,
              sourceDemand := sourceDemand, sourceRequirements := bodyReq,
              receiving := .handler effect table clauseDependencies receiving,
              hints := .handler hints,
              context := .handler (effect := effect) (table := table) activation _ context,
              current := SourceAdmission.Admitted.of_source body bodyAuth selected nextCoherent.forget.source,
              certified := bodyCertified, scopeTyped := scopeTyped,
              pendingDemand := [] ++ pendingDemand,
              pendingRequirements := .sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack nextTables stack)) pendingRequirements,
              pending := .push (.ordinary frame) (pending.registries tablesAgree familiesAgree requiredAgree),
              coherent := nextCoherent,
              retained := .handler (retained.installations_mono (List.subset_append_left _ _)),
              currentResource := by
                cases currentResource with | handler _ bodyResource =>
                  exact (bodyResource activation fresh).installations_mono bodyHistory,
              retainedResource := .handler (retainedResource.installations_mono (List.subset_append_left _ _)) }
          exact ⟨handler, nextTables, nextFamilies, nextRequired, next,
            rfl, rfl, rfl, rfl, rfl, rfl, rfl,
            (fun old member => ⟨tablesAgree old member, familiesAgree old member, requiredAgree old member⟩),
            nextRun, (fun _ bound => .handler bound), .enterHandler handler code stack⟩
  | pure | request | invoke | sequence | choice | cleanup | resource => cases current.source

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.install_handler_accounting

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)
open OwnerPhaseTransitions (available)

/-- A ready installation uses the retained contextual interpretation. -/
theorem ExecutionRoot.handler_run
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (expressionEq : site.expression = .handle (Instantiation.freezeEffect effect) code arms) :
    Accounting.Run world history site.rows site.context root := by
  cases rooted with
  | contextual interpreted => exact interpreted
  | branch chosen inside =>
      have selected := chosen.1
      rw [expressionEq] at selected
      cases selected
  | focus focused inside =>
      have selected := focused.1
      rw [expressionEq] at selected
      cases selected

/-- Handler installation chooses a fresh identity and preserves the actual
checked source, saved records, lifetime evidence and resource access. -/
theorem ExecutableState.install_handler
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩, issued, completed⟩, actions⟩) :
    ∃ handler : HandlerData, ∃ nextTables nextFamilies nextRequired,
      handler.activation ∉ history ∧ handler.scope = runtimeScope ∧ handler.effectInst = effect ∧ handler.clauses = arms ∧
      (∀ old, old.activation ∈ stack.erase.activations →
        tables old = nextTables old ∧ families old = nextFamilies old ∧ required old = nextRequired old) ∧
      LexicalUnwind.Event
        ⟨.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩, issued, completed⟩
        ⟨.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩, issued, completed⟩ ∧
      ExecutableState operations policy contracts nextTables nextFamilies nextRequired outward annotations world ambient
        (history ++ [handler.activation]) resumes disposals annotatedStore budget ports owners emptyRows output outputRows
        ⟨⟨.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩, issued, completed⟩, actions⟩ := by
  obtain ⟨activation, fresh⟩ := ScopedTyping.fresh_world_name history
  have source := state.source
  dsimp only at source
  generalize machineEq : LexicalUnwind.Machine.eval
    ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩ = machine at source
  cases source with
  | eval site phaseAgreement rooted bound annotation checked bounded =>
      obtain ⟨expressionEq, runtimeEq, stackEq⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
      have interpreted := rooted.handler_run expressionEq.symm
      obtain ⟨handler, nextTables, nextFamilies, nextRequired, next,
        identityEq, handlerScope, handlerEffect, handlerArms, bodyEq, nextScopeEq,
        nextStackEq, registryAgree, nextRun, nextBound, raw⟩ :=
        site.install_handler_accounting expressionEq.symm interpreted
          (by simpa only [LexicalUnwind.Machine.stack, ← stackEq] using state.activations) activation fresh
      have ownedSame : ownedTickets next.stack = ownedTickets site.stack := by rw [nextStackEq]; rfl
      have nextPhase := phaseAgreement.trans (congrArg available ownedSame.symm)
      have transition : LexicalUnwind.Transition
          (.eval ⟨site.expression, site.runtimeScope, site.stack⟩)
          (.eval ⟨next.expression, next.runtimeScope, next.stack⟩) [] [] :=
        .evaluate raw (by rw [← expressionEq]; trivial)
      have event : LexicalUnwind.Event
          ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩
          ⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, completed⟩ := by
        simpa only [List.append_nil, List.nil_append] using
          (LexicalUnwind.Event.step (before := ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩)
            transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
      have nextState : ExecutableState operations policy contracts nextTables nextFamilies nextRequired outward annotations world ambient
          (history ++ [activation]) resumes disposals annotatedStore budget ports owners emptyRows output outputRows
          ⟨⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, completed⟩, actions⟩ := by
        refine ⟨.eval next nextPhase (.contextual nextRun) (nextBound annotations bound) annotation checked bounded,
          ?_, ?_, state.storeAnnotation, ?_, state.registry, ?_, ?_, state.issuedResources,
          event.ticket_history (by simpa only [← expressionEq, ← runtimeEq, ← stackEq] using state.ticketHistory),
          state.captureMetadata⟩
        · intro key stored member
          rw [nextStackEq]
          have record := state.resumeRecords key stored member
          have actual : PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
              site.stack key stored := by simpa only [LexicalUnwind.Machine.stack, ← stackEq] using record
          have moved := actual.registries (fun old member => (registryAgree old member).1)
            (fun old member => (registryAgree old member).2.1) (fun old member => (registryAgree old member).2.2)
          cases moved with
          | resume located known recorded source answer => exact .resume (.push located) known recorded source answer
        · intro key stored member
          rw [nextStackEq]
          have record := state.unwindRecords key stored member
          have actual : PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
              site.stack key stored := by simpa only [LexicalUnwind.Machine.stack, ← stackEq] using record
          have moved := actual.registries (fun old member => (registryAgree old member).1)
            (fun old member => (registryAgree old member).2.1) (fun old member => (registryAgree old member).2.2)
          cases moved with
          | dispose located held recorded source => exact .dispose (.push located) held recorded source
        · apply LexicalUnwind.event_preserves_ledger event
          simpa only [← expressionEq, ← runtimeEq, ← stackEq] using state.ledger
        · cases state.resources with
          | eval supported =>
              apply LexicalUnwind.MachineAccess.eval
              apply raw_step_preserves_access raw
              · simpa only [← expressionEq, ← runtimeEq, ← stackEq] using supported
              · rw [← expressionEq]
                exact ScopedPortJoint.ordinary_access_checks (by simp [Code.IsValue]) (by intros; simp) (by intros; simp)
        · rw [nextStackEq]
          change (handler.activation :: site.stack.erase.activations) ⊆ history ++ [activation]
          intro name member
          rcases List.mem_cons.mp member with same | prior
          · exact same ▸ identityEq.symm ▸ List.mem_append_right _ List.mem_cons_self
          · apply List.mem_append_left
            exact state.activations (by simpa only [LexicalUnwind.Machine.stack, ← stackEq] using prior)
      refine ⟨handler, nextTables, nextFamilies, nextRequired, ?_, handlerScope.trans runtimeEq.symm,
        handlerEffect, handlerArms, ?_, ?_, ?_⟩
      · simpa only [identityEq] using fresh
      · simpa only [LexicalUnwind.Machine.stack, ← stackEq] using registryAgree
      · simpa only [← expressionEq, bodyEq, nextScopeEq, nextStackEq, ← runtimeEq, ← stackEq] using event
      · simpa only [identityEq, bodyEq, nextScopeEq, nextStackEq, ← runtimeEq, ← stackEq] using nextState
  | unwind => cases machineEq

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
