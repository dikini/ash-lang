theorem PlannedModeSource.extract_discard_generated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output demand requirements scope)
    (known : contracts owner = some contract)
    (unprotected : ProtectionContexts.protectedMode captured.erase = false)
    (checked : Checked entries receiving before
      (.sequence (.invoke ⟨owner, .dispose⟩ contract.closeDemand nearer) requirements) row) :
    ∃ (frontDemand tailDemand : List Nat), ∃ frontRequirements : Requirements frontDemand,
    ∃ capturedRequirements : Requirements contract.resumeDemand,
    ∃ tailRequirements : Requirements tailDemand,
    ∃ frontScope capturedScope tailScope,
      PlannedModeSource operations policy contracts tables families required outward actions world front
        (.value .unit) (.value contract.answer) frontDemand frontRequirements frontScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured
        (.value contract.input) (.value contract.answer) contract.resumeDemand capturedRequirements capturedScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail
        (.value contract.answer) output tailDemand tailRequirements tailScope ∧
      contract.answer.erase.erase.port = ScopedPorts.eraseType answerType ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      scope = frontScope.append (.live owner capturedScope tailScope) ∧
      demand = frontDemand ++ tailDemand ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals requirements) =
          merge (evaluate store (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail) ++ receiving)
            phases (annotateDisposals frontRequirements))
            (evaluate store receiving (spendAll phases frontDemand) (annotateDisposals (.sequence (.spent owner) tailRequirements))) := by
  have unused : owner ∉ demand := by
    have unique := RecursiveRequirements.checked_once checked
    intro member
    exact (List.nodup_cons.mp unique).1 (List.mem_append_right _ member)
  obtain ⟨middle, frontDemand, restDemand, frontRequirements, restRequirements,
    frontScope, restScope, frontSource, restSource, sameScope, sameDemand, ordinaryEvaluation, evaluation⟩ := source.split_disposals
  cases restSource with
  | live actual rights inputAnnotation answerAnnotation callerScope held saved answer remaining =>
      cases Option.some.inj (known.symm.trans actual)
      rcases answer with rfl | rfl
      · exact ⟨frontDemand, restDemand, frontRequirements, _, _, frontScope, _, _,
          frontSource, saved, remaining, answerAnnotation, callerScope, sameScope, sameDemand, evaluation⟩
      · have returned := saved.return_mode
        rw [LexicalUnwind.unwind_prefix_return_mode
          (LexicalUnwind.unprotected_unwind_prefix unprotected)] at returned
        cases returned
  | opening saved remaining =>
      apply False.elim
      apply unused
      rw [sameDemand]
      simp

theorem PlannedModeSource.discard_waiting_generated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output demand requirements scope)
    (known : contracts owner = some contract)
    (unprotected : ProtectionContexts.protectedMode captured.erase = false)
    (checked : Checked entries receiving before
      (.sequence (.invoke ⟨owner, .dispose⟩ contract.closeDemand nearer) requirements) row)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup) :
    ∃ frontScope capturedScope tailScope, ∃ waitingRequirements : Requirements demand,
      OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩ ∧
      SourceDependencyCapture.Realizes tables families frontScope front ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        (front.append (.spent owner answerType caller tail)) (.value .unit) output
        demand waitingRequirements (frontScope.append (.spent owner tailScope)) ∧
      Bound annotations (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))) ∧
      ∀ store receiving phases, phases owner = .consumed →
        evaluate store receiving phases (annotateDisposals waitingRequirements) = evaluate store receiving phases (annotateDisposals requirements) := by
  obtain ⟨frontDemand, tailDemand, frontRequirements, capturedRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontSource, savedSource, tailSource,
    answerAnnotation, callerScope, scopeSame, demandSame, evaluation⟩ :=
    source.extract_discard_generated known unprotected checked
  have prefixUnique : (ownedTickets front ++ owner :: (ownedTickets captured ++ ownedTickets tail)).Nodup := by
    simpa only [owned_tickets_append, ownedTickets] using unique
  have absent : owner ∉ ownedTickets front := fun member =>
    (List.nodup_append.mp prefixUnique).2.2 owner member owner List.mem_cons_self rfl
  have cut : OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩ := by
    rw [scopeSame]
    exact SourceDependencySchemes.Closing.prefix_owner_cut frontSource.realizes absent
  obtain ⟨waitingRequirements, waiting, ordinaryWaitingEvaluation, waitingEvaluation⟩ := frontSource.append_disposals
    (.spent known answerAnnotation callerScope tailSource)
  subst demand
  refine ⟨frontScope, capturedScope, tailScope, waitingRequirements, cut, frontSource.realizes,
    waiting, SourceDependencySchemes.Lexical.bound_lexical_discard bound cut, ?_⟩
  intro store receiving phases consumed
  rw [waitingEvaluation, evaluation]
  congr 1
  exact RecursiveTransport.evaluate_transport (fun _ _ => rfl)
    (RecursiveRecomposition.normalize_replaced (front := .nil) (capture := captured)
      (tail := tail) (input := inputType) (answer := answerType) (caller := caller)
      (tables := tables) (receiving := receiving) consumed).symm
theorem discard_planned_fragments_checked_generated
    {recordedRequirements : Requirements contract.closeDemand}
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output pendingDemand pendingRequirements scope)
    (known : contracts owner = some contract)
    (unprotected : ProtectionContexts.protectedMode captured.erase = false)
    (runtimeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (resumeModes : ∀ key body, (key, body) ∈ (resumes : Store) → key.mode = .resume)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (found : RecursiveRequirements.lookup ⟨owner, .dispose⟩ disposals = some ⟨contract.closeDemand, recordedRequirements⟩)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (invocation : Checked (annotateDisposalStore annotatedStore)
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail))) before
      (.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]) closeRow)
    (pendingAnnotation : RowAnnotation pendingRequirements pendingAnnotated)
    (pending : Checked (annotateDisposalStore annotatedStore) [] (spendAll before (owner :: contract.closeDemand)) (annotateDisposals pendingAnnotated) pendingRow) :
    let waitingStack := front.append (.spent owner answerType caller tail)
    let closingStack := Stack.push (.closing identity runtimeScope) waitingStack
    let nextStack := captured.append closingStack
    ∃ frontScope capturedScope tailScope,
    ∃ requirements annotatedNext : Requirements (contract.closeDemand ++ pendingDemand),
    ∃ nextRow annotatedRow,
      OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩ ∧
      SourceDependencyCapture.Realizes tables families frontScope front ∧
      PlannedModeSource operations policy contracts tables families required outward actions world nextStack
        .unwind output (contract.closeDemand ++ pendingDemand) requirements
        (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))) ∧
      Bound annotations (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))) ∧
      RowAnnotation requirements annotatedNext ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) [] (spend before owner) (annotateDisposals requirements) nextRow ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) [] (spend before owner) (annotateDisposals annotatedNext) annotatedRow ∧
      nextRow ⊆ closeRow ++ pendingRow ∧ annotatedRow ⊆ closeRow ++ pendingRow ∧
      RequirementPath pendingAnnotated annotatedNext contract.closeDemand ∧
      (∃ savedAnnotated : Requirements contract.closeDemand,
        RowAnnotation recordedRequirements savedAnnotated ∧
        RequirementPath (savedAnnotated.prepend (OwnerPhases.ofStack tables closingStack)) annotatedNext []) ∧
      contract.closeDemand.Perm (ownedTickets captured) := by
  dsimp only
  obtain ⟨normalPendingRow, normalPending, pendingBound⟩ := (annotated_disposals pendingAnnotation).checked pending
  have invoked : Checked (annotateDisposalStore annotatedStore) [] before
      ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) closeRow :=
    RecursiveRequirements.checked_prepend_iff.mpr (by simpa only [List.append_nil] using invocation)
  obtain ⟨frontScope, capturedScope, tailScope, waitingRequirements, cut, frontSource,
    waitingSource, nextBound, waitingEvaluation⟩ :=
    source.discard_waiting_generated known unprotected (.sequence invoked normalPending) bound unique
  have paired := selected_planned_unwind_source closing found bound cut
    (RecursiveRecords.located_below front .here) unique
  obtain ⟨body, selectedContext, actual, ready, selection, bodyChecked⟩ :=
    RecursiveRequirements.checked_invocation invocation
  have fullFound : RecursiveRequirements.lookup ⟨owner, .dispose⟩ (resumes ++ disposals) =
      some ⟨contract.closeDemand, recordedRequirements⟩ := by
    rw [RecursiveDisposalCapture.lookup_after_resumes resumeModes]
    exact found
  obtain ⟨savedAnnotated, actualFound, savedAnnotation⟩ := storeAnnotation.lookup_annotated fullFound
  have sameTemplate := Option.some.inj (actual.symm.trans (disposal_store_lookup actualFound))
  have sameBody := eq_of_heq (Sigma.mk.inj sameTemplate).2
  subst body
  have consumed : spend before owner owner = .consumed := OwnerPhaseTransitions.spend_self before owner
  have contexts := RecursiveTransport.normalized_prefix (prefixContext := [.ordinary (.barrier true)])
    (RecursiveRecomposition.normalize_replaced (front := front) (capture := captured)
      (tail := tail) (input := inputType) (answer := answerType) (caller := caller)
      (tables := tables) (receiving := []) consumed)
  have savedChecked : Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
      (OwnerPhases.ofStack tables (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))
      (spend before owner) (annotateDisposals savedAnnotated) closeRow := by
    rw [disposal_store_remove_owner]
    apply RecursiveTransport.checked_transport bodyChecked (RecursiveTransport.remove_consumed_agrees consumed)
    simpa only [List.append_nil, OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase,
      ProtectionContexts.frameProtected, closeFrame, List.singleton_append] using contexts
  obtain ⟨cleanupRequirements, cleanupAnnotated, cleanupRow, cleanupSource, cleanupAnnotation,
    storedPath, generatedStoredPath, cleanupChecked, cleanupBound, captureBalance⟩ := paired.annotated_checked_generated savedAnnotation savedChecked
  obtain ⟨normalCleanupRow, normalCleanupCheck, normalCleanupBound⟩ := (disposal_annotation_map cleanupAnnotation).checked cleanupChecked
  have consumedAfter := RecursiveTransport.phases_spendAll_later (owners := contract.closeDemand) owner consumed
  have retainedChecked : Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) []
      (spendAll (spend before owner) contract.closeDemand) (annotateDisposals pendingAnnotated) pendingRow := by
    rw [disposal_store_remove_owner]
    exact RecursiveTransport.checked_remove_consumed pending consumedAfter
  obtain ⟨waitingRow, waitingCheck, waitingBound⟩ := (disposal_annotation_map pendingAnnotation).checked retainedChecked
  have actualWaiting : Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) []
      (spendAll (spend before owner) contract.closeDemand) (annotateDisposals waitingRequirements) waitingRow := by
    apply RecursiveRequirements.evaluate_sound
    rw [waitingEvaluation _ _ _ consumedAfter]
    exact RecursiveRequirements.checked_complete waitingCheck
  have closingSource := PlannedModeSource.push (PlannedModeFrame.closing (input := .unwind) (identity := identity) runtimeKnown) waitingSource
  have closingCheck : Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) []
      (spendAll (spend before owner) contract.closeDemand)
      (annotateDisposals (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))) waitingRequirements)) waitingRow := by
    apply RecursiveRequirements.evaluate_sound
    simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
      RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
    exact RecursiveRequirements.checked_complete actualWaiting
  obtain ⟨requirements, rebuilt, generatedAnnotation, rebuiltCheck⟩ := cleanupSource.append_checked_generated closingSource
    (by simpa only [List.append_nil] using normalCleanupCheck) closingCheck
  have bounded : normalCleanupRow ++ waitingRow ⊆ closeRow ++ pendingRow :=
    ScopedExpressions.append_subset (normalCleanupBound.trans cleanupBound) waitingBound
  have savedAtRoot : Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) [] (spend before owner)
      ((annotateDisposals savedAnnotated).prepend (OwnerPhases.ofStack tables
        (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) closeRow :=
    RecursiveRequirements.checked_prepend_iff.mpr (by simpa only [List.append_nil] using savedChecked)
  let annotatedNext := Requirements.choice requirements
    (.sequence (savedAnnotated.prepend (OwnerPhases.ofStack tables
      (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) pendingAnnotated) (.refl _)
  refine ⟨frontScope, capturedScope, tailScope, requirements, annotatedNext, _, _, cut, frontSource,
    rebuilt, nextBound, .alternatives .original (.refl _), rebuiltCheck,
    (by simpa only [annotatedNext, annotateDisposals, disposal_prepend] using
      (Checked.choice rebuiltCheck (Checked.sequence savedAtRoot retainedChecked) (same := List.Perm.refl _))), bounded,
    List.append_subset.mpr ⟨bounded, List.Subset.refl _⟩, ?_,
    ⟨savedAnnotated, savedAnnotation, .no (.first .here)⟩, captureBalance⟩
  exact .no (by simpa only [List.append_nil] using (RequirementPath.second (.here : RequirementPath pendingAnnotated pendingAnnotated [])))
theorem discard_planned_segments_checked_generated
    {recordedRequirements : Requirements contract.closeDemand}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.discard binder) .unit (owner :: contract.closeDemand) (.invoke ⟨owner, .dispose⟩ contract.closeDemand [])
      (.invoke (key := ⟨owner, .dispose⟩)))
    (known : contracts owner = some contract)
    (resolved : runtimeScope.resolve binder = some owner)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
