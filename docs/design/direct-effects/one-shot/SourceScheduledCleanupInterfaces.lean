/-- Reuse the row-subtree witness from the established computation proof. -/
theorem Code.computation_rows
    (checked : Code outward actions budget phases world installations rows context)
    (selected : ComputationRows rows nextRows) :
    Code outward actions budget phases world installations nextRows context := by
  cases selected with
  | binding => cases checked with | sequence first second => exact second
  | application => cases checked with | sequence functionCertificate rest =>
    cases rest with | sequence argumentCertificate bodyCertificate => exact bodyCertificate
  | trueBranch => cases checked with | sequence conditionCertificate rest =>
    cases rest with | choice yesCertificate noCertificate => exact yesCertificate
  | falseBranch => cases checked with | sequence conditionCertificate rest =>
    cases rest with | choice yesCertificate noCertificate => exact noCertificate

/-- All four ordinary computation reductions retain structural source evidence
through the same authenticated reduction and requirement-transfer witnesses. -/
theorem Admitted.computation
    {plan : Plan dependencies} {rows : Rows (signature plan)}
    (admitted : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families context stack code result demand requirements
      (signature plan) resultRows rows)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (ready : Ready code)
    (step : RawStep ⟨code, runtimeScope, stack⟩ after created completed) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand, ∃ nextDependencies,
    ∃ nextPlan : Plan nextDependencies, ∃ nextRows : Rows (signature nextPlan), ∃ nextTicket,
      Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
        after.scope actions phases budget tables families context after.stack after.expression result nextDemand nextRequirements
        (signature nextPlan) resultRows nextRows ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      ScopedPorts.EffectScope contracts.erase.erase.ports after.scope nextTicket ∧
      demand.Perm nextDemand ∧ after.stack = stack ∧ created = [] ∧ completed = [] ∧
      (∀ entries receiving before row, Checked entries receiving before requirements row →
        ∃ nextRow, Checked entries receiving before nextRequirements nextRow ∧ nextRow ⊆ row) ∧
      (∀ entries receiving before row, Checked entries receiving before (annotateDisposals requirements) row →
        ∃ nextRow, Checked entries receiving before (annotateDisposals nextRequirements) nextRow ∧ nextRow ⊆ row) := by
  obtain ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
    next, nextCertified, nextScope, demands, stackSame, createdSame, completedSame,
    normalTransfer, generatedTransfer, selected⟩ :=
    admitted.previous.computation_rows certified scopeTyped ready step
  exact ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextRows, nextTicket,
    ⟨next, admitted.certificate.computation_rows selected⟩, nextCertified, nextScope,
    demands, stackSame, createdSame, completedSame, normalTransfer, generatedTransfer⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
