namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Store Checked evaluate)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)

/-- The existing cleanup-template grammar supplies the abandonment prefix and
contains no explicit disposal invocation to annotate. Callback effect checks
remain present; this says nothing about the callback's separate source body. -/
theorem unwind_template_disposals
    (source : SourceDependencyFrames.UnwindTemplate operations policy contracts tables world stack demand requirements) :
    LexicalUnwind.UnwindPrefix stack ∧ annotateDisposals requirements = requirements := by
  induction source with
  | nil => exact ⟨.nil, rfl⟩
  | plain next ih => exact ⟨.plain ih.1, ih.2⟩
  | handler next ih => exact ⟨.handler ih.1, ih.2⟩
  | cell next ih => exact ⟨.cell ih.1, ih.2⟩
  | cleanup callback next ih => exact ⟨.armed ih.1, by simp only [annotateDisposals, ih.2]⟩
  | retiring next ih => exact ⟨.retiring ih.1, by simp only [annotateDisposals, ih.2]⟩
  | spent next ih => exact ⟨.spent ih.1, by simp only [annotateDisposals, ih.2]⟩
  | live saved next ihSaved ihNext =>
      exact ⟨.live ihSaved.1 ihNext.1, by simp only [annotateDisposals, disposal_prepend, ihSaved.2, ihNext.2]⟩

/-- On an abandonable prefix, planned unwinding uses the same callback-effect
and retirement forms. It cannot enter a closing or running marker and resume
ordinary code inside this prefix. -/
theorem PlannedModeSource.unwind_disposals
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind output demand requirements scope)
    (scopes : LexicalUnwind.UnwindPrefix stack) :
    annotateDisposals requirements = requirements := by
  generalize initial : PlannedModeValue.unwind = input at source
  induction scopes generalizing input output demand requirements scope with
  | nil => cases source; rfl
  | plain next ih => cases source with | push head tail => cases initial; cases head with
      | skipped => simp only [annotateDisposals, Requirements.prepend, ih .unwind rfl tail]
  | handler next ih => cases source with | push head tail => cases initial; cases head with
      | handler frame => simp only [annotateDisposals, Requirements.prepend, ih .unwind rfl tail]
  | cell next ih => cases source with | push head tail => cases initial; cases head with
      | cell => simp only [annotateDisposals, Requirements.prepend, ih .unwind rfl tail]
  | armed next ih => cases source with | push head tail => cases initial; cases head with
      | cleanup callback certified => simp only [annotateDisposals, Requirements.prepend, ih .unwind rfl tail]
  | retiring next ih => cases source with | push head tail => cases initial; cases head with
      | retiring => simp only [annotateDisposals, Requirements.prepend, ih .unwind rfl tail]
  | live inside outside ihInside ihOutside => cases source with
      | live => cases initial
      | opening saved tail => simp only [annotateDisposals, disposal_prepend, ihInside .unwind rfl saved, ihOutside .unwind rfl tail]
  | spent next ih => cases source with
      | spent => cases initial
      | skippedSpent tail => simp only [annotateDisposals, ih .unwind rfl tail]
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.unwind_template_disposals
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.unwind_disposals

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Store Checked evaluate)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)

/-- Generated cleanup requirements agree across the existing paired source
representations. This follows from their syntax and the already proved ordinary
evaluation equality, without an additional premise on generated checks. -/
theorem PlannedUnwindSource.disposal_evaluation
    (source : PlannedUnwindSource operations policy contracts tables families required outward actions world stack demand stored scope) :
    ∃ requirements : Requirements demand,
      PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind .unwind demand requirements scope ∧
      annotateDisposals requirements = requirements ∧
      annotateDisposals stored = stored ∧
      ∀ entries receiving phases,
        evaluate entries receiving phases (annotateDisposals requirements) =
          evaluate entries receiving phases (annotateDisposals stored) := by
  cases source with
  | paired planned erased same =>
      obtain ⟨scopes, storedSame⟩ := unwind_template_disposals erased.template
      have plannedSame := planned.unwind_disposals scopes
      exact ⟨_, planned, plannedSame, storedSame, by intros; rw [plannedSame, storedSame]; apply same⟩

/-- Reconstruct cleanup from a generated stored annotation. The successor is
itself a generated annotation and retains the entire old generated subtree.
Existing callback-effect and ownership proofs are reused. -/
theorem PlannedUnwindSource.annotated_checked_generated
    (source : PlannedUnwindSource operations policy contracts tables families required outward actions world stack demand stored scope)
    (annotation : RowAnnotation stored annotated)
    (checked : Checked (annotateDisposalStore entries) receiving phases (annotateDisposals annotated) row) :
    ∃ requirements nextAnnotated : Requirements demand, ∃ nextRow,
      PlannedModeSource operations policy contracts tables families required outward actions world stack .unwind .unwind
        demand requirements scope ∧
      RowAnnotation requirements nextAnnotated ∧ RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked (annotateDisposalStore entries) receiving phases (annotateDisposals nextAnnotated) nextRow ∧
      nextRow ⊆ row ∧ demand.Perm (ownedTickets stack) := by
  obtain ⟨requirements, planned, plannedSame, storedSame, evaluation⟩ := source.disposal_evaluation
  obtain ⟨normalRow, normalCheck, within⟩ := (annotated_disposals annotation).checked checked
  have generatedStored : Checked (annotateDisposalStore entries) receiving phases
      (annotateDisposals stored) normalRow := storedSame.symm ▸ normalCheck
  have plannedCheck := RecursiveRequirements.evaluate_sound
    ((evaluation (annotateDisposalStore entries) receiving phases).trans
      (RecursiveRequirements.checked_complete generatedStored))
  refine ⟨requirements, .choice requirements annotated (.refl _), normalRow ++ row,
    planned, .alternatives .original (.refl _), .no .here, .no .here, ?_,
    List.append_subset.mpr ⟨within, List.Subset.refl _⟩, source.erase.template.ownership⟩
  exact .choice plannedCheck checked
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindSource.disposal_evaluation
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindSource.annotated_checked_generated

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Store Checked evaluate)
open SourceDependencyAnnotations (RowAnnotation)
open OwnerPhaseTransitions (spendAll)

/-- Join generated source checks at the same actual append used by source
recomposition. Receiver extension and ownership consumption come from the
existing append equations, not an assumption about ordinary row equality. -/
theorem PlannedModeSource.append_checked_generated
    (first : PlannedModeSource operations policy contracts tables families required outward actions world front input middle
      firstDemand firstRequirements firstScope)
    (second : PlannedModeSource operations policy contracts tables families required outward actions world tail middle output
      secondDemand secondRequirements secondScope)
    (firstChecked : Checked (annotateDisposalStore entries) (OwnerPhases.ofStack tables tail ++ receiving) before
      (annotateDisposals firstRequirements) firstRow)
    (secondChecked : Checked (annotateDisposalStore entries) receiving (spendAll before firstDemand)
      (annotateDisposals secondRequirements) secondRow) :
    ∃ combined : Requirements (firstDemand ++ secondDemand),
      PlannedModeSource operations policy contracts tables families required outward actions world (front.append tail) input output
        (firstDemand ++ secondDemand) combined (firstScope.append secondScope) ∧
      RowAnnotation combined (annotateDisposals combined) ∧
      Checked (annotateDisposalStore entries) receiving before (annotateDisposals combined) (firstRow ++ secondRow) := by
  obtain ⟨combined, source, ordinary, generated⟩ := first.append_disposals second
  refine ⟨combined, source, disposal_annotation combined, RecursiveRequirements.evaluate_sound ?_⟩
  rw [generated, RecursiveRequirements.checked_complete firstChecked, RecursiveRequirements.checked_complete secondChecked]
  rfl
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.append_checked_generated

