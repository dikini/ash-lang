namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts)
open SourcePlannedFrames (Families)
open SourceDependencyFrames (UnwindSource unwindStore unwind_store_sublist)
open SourceDependencyCapture (OwnerCut)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Key evaluate)

/-- Planned cleanup and the exact stored requirement body share a lexical
source. Their evaluations agree in every receiving context, phase and store. -/
inductive PlannedUnwindSource (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables) (families : Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance)
    (actions : Syntax.UsageTickets) (world : List Nat) (stack : Stack)
    (demand : List Nat) (stored : Requirements demand) (scope : SourceDependencyCapture.Scope) : Prop where
  | paired (planned : PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind .unwind demand requirements scope)
      (erased : UnwindSource operations.erase policy contracts.erase tables families world stack demand stored scope)
      (same : ∀ entries receiving phases, evaluate entries receiving phases requirements = evaluate entries receiving phases stored) :
      PlannedUnwindSource operations policy contracts tables families required outward actions world stack demand stored scope

theorem PlannedUnwindSource.erase
    (source : PlannedUnwindSource operations policy contracts tables families required outward actions world stack demand stored scope) :
    UnwindSource operations.erase policy contracts.erase tables families world stack demand stored scope := by
  cases source with | paired planned erased same => exact erased

theorem PlannedModeSource.planned_unwind_source
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope)
    (scopes : LexicalUnwind.UnwindPrefix stack) :
    ∃ closingDemand, ∃ stored : Requirements closingDemand,
      PlannedUnwindSource operations policy contracts tables families required outward actions world stack closingDemand stored scope := by
  obtain ⟨closingDemand, requirements, planned, stored, erased, same⟩ := source.unwind_source_evaluation scopes
  exact ⟨closingDemand, stored, .paired planned erased same⟩

theorem PlannedUnwindSource.transport
    (source : PlannedUnwindSource operations policy contracts tables families required outward actions world stack demand stored scope)
    (extension : contracts.Extends nextContracts) (permissions : Syntax.UsageExtension actions nextActions) :
    PlannedUnwindSource operations policy nextContracts tables families required outward nextActions world stack demand stored scope := by
  cases source with | paired planned erased same =>
    exact .paired (planned.transport extension permissions)
      (erased.transport (SourcePlannedCheckedFrames.erased_extension extension) (List.Subset.refl _)) same

inductive PlannedUnwindAnnotated (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables) (families : Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance)
    (actions : Syntax.UsageTickets) (annotations : Nat → Option SourceDependencyCapture.Scope)
    (world : List Nat) (root : Stack) : Key → RecursiveRequirements.Template → Prop where
  | dispose (located : SourceTemplates.CapturedIn owner captured root)
      (unprotected : ProtectionContexts.protectedMode captured.erase = false)
      (recorded : annotations owner = some capturedScope)
      (source : PlannedUnwindSource operations policy contracts tables families required outward actions world
        captured demand stored capturedScope) :
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world root
        ⟨owner, .dispose⟩ ⟨demand, stored⟩

theorem PlannedUnwindAnnotated.erase
    (record : PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world root key body) :
    SourceDependencySchemes.Lexical.UnwindAnnotated operations.erase policy contracts.erase tables families annotations world root key body := by
  cases record with | dispose located held recorded source => exact .dispose located held recorded source.erase

theorem PlannedUnwindAnnotated.transport
    (record : PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world root key body)
    (extension : contracts.Extends nextContracts) (permissions : Syntax.UsageExtension actions nextActions)
    (annotationExtension : ∀ owner captured, annotations owner = some captured → nextAnnotations owner = some captured)
    (locations : ∀ owner captured, SourceTemplates.CapturedIn owner captured root → SourceTemplates.CapturedIn owner captured nextRoot) :
    PlannedUnwindAnnotated operations policy nextContracts tables families required outward nextActions nextAnnotations world nextRoot key body := by
  cases record with | dispose located held recorded source =>
    exact .dispose (locations _ _ located) held (annotationExtension _ _ recorded) (source.transport extension permissions)

/-- The allocator's explicit equation installs the supplied planned cleanup
witness. Existing entries retain their own exact witnesses and lexical scopes. -/
theorem capture_planned_unwind_records
    (cut : HandlerCut requested whole captured tail handler)
    (source : ProtectionContexts.protectedMode captured.erase = false →
      PlannedUnwindSource operations policy contracts tables families required outward actions world captured demand stored capturedScope)
    (fresh : annotations owner = none)
    (records : ∀ key body, (key, body) ∈ (entries : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world whole key body)
    (extension : contracts.Extends nextContracts) (permissions : Syntax.UsageExtension actions nextActions)
    (allocated : nextEntries = (if ProtectionContexts.protectedMode captured.erase then entries else
      (⟨owner, .dispose⟩, ⟨demand, stored⟩) :: entries)) :
    let nextAnnotations := fun other => if other = owner then some capturedScope else annotations other
    ∀ key body, (key, body) ∈ nextEntries →
      PlannedUnwindAnnotated operations policy nextContracts tables families required outward nextActions nextAnnotations world
        (.live owner input answer captured caller tail) key body := by
  let nextAnnotations := fun other => if other = owner then some capturedScope else annotations other
  have annotationExtension : ∀ other scope, annotations other = some scope → nextAnnotations other = some scope := by
    intro other scope known
    by_cases same : other = owner
    · subst other; rw [fresh] at known; cases known
    · simpa only [nextAnnotations, if_neg same] using known
  have preserved : ∀ key body, (key, body) ∈ entries →
      PlannedUnwindAnnotated operations policy nextContracts tables families required outward nextActions nextAnnotations world
        (.live owner input answer captured caller tail) key body := by
    intro key body member
    exact (records key body member).transport extension permissions annotationExtension (by
      intro other saved located
      rw [handler_cut_reconstructs cut] at located
      rcases SavedCaptureIdentity.located_append.mp located with inside | outside
      · exact .saved inside
      · exact .tail outside)
  dsimp only
  intro key body member
  rw [allocated] at member
  cases held : ProtectionContexts.protectedMode captured.erase with
  | true => exact preserved key body (by simpa only [held, if_true] using member)
  | false =>
    simp only [held, Bool.false_eq_true, if_false] at member
    rcases List.mem_cons.mp member with same | old
    · cases same
      exact .dispose .here held (by simp) ((source held).transport extension permissions)
    · exact preserved key body old

/-- Lookup, unique physical capture and the recorded scope recover the exact
stored cleanup witness. No uniqueness of source typing is assumed. -/
theorem selected_planned_unwind_source
    (records : ∀ key body, (key, body) ∈ (entries : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world root key body)
    (found : RecursiveRequirements.lookup ⟨owner, .dispose⟩ entries = some ⟨demand, stored⟩)
    (bound : Bound annotations receiving) (cut : OwnerCut owner receiving selected)
    (located : SourceTemplates.CapturedIn owner captured root) (unique : (ownedTickets root).Nodup) :
    PlannedUnwindSource operations policy contracts tables families required outward actions world captured demand stored selected.captured := by
  cases records _ _ (SourceTemplates.lookup_member found) with
  | dispose actual held recorded source =>
    cases SourceTemplates.captured_in_unique unique actual located
    cases Option.some.inj (recorded.symm.trans (bound.selected cut))
    exact source

theorem planned_unwind_records_advance
    (step : LexicalUnwind.Advance before after discharged)
    (records : ∀ key body, (key, body) ∈ (entries : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world before key body) :
    ∀ key body, (key, body) ∈ unwindStore before entries →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world after key body := by
  intro key body member
  cases records key body (unwind_store_sublist.subset member) with
  | dispose located held recorded source =>
    exact .dispose (SourceDependencyOwners.Lexical.unwind_record_location step located member) held recorded source
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindSource.erase
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.planned_unwind_source
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindSource.transport
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindAnnotated.erase
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindAnnotated.transport
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.capture_planned_unwind_records
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.selected_planned_unwind_source
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.planned_unwind_records_advance

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked Store)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)

/-- Use the exact stored cleanup certificate to check its planned source and
retain the stored annotation as an alternative. No chosen typing is equated
with an independently inferred typing. -/
theorem PlannedUnwindSource.annotated_checked
    (source : PlannedUnwindSource operations policy contracts tables families required outward actions world stack demand stored scope)
    (annotation : RowAnnotation stored annotated)
    (checked : Checked entries receiving phases annotated row) :
    ∃ requirements nextAnnotated : Requirements demand, ∃ nextRow,
      PlannedModeSource operations policy contracts tables families required outward actions world stack .unwind .unwind
        demand requirements scope ∧
      RowAnnotation requirements nextAnnotated ∧ RequirementPath annotated nextAnnotated [] ∧
      Checked entries receiving phases nextAnnotated nextRow ∧ nextRow ⊆ row ∧
      demand.Perm (ownedTickets stack) := by
  cases source with
  | paired planned erased same =>
    obtain ⟨normalRow, normalCheck, within⟩ := annotation.checked checked
    have plannedCheck := RecursiveRequirements.evaluate_sound
      ((same entries receiving phases).trans (RecursiveRequirements.checked_complete normalCheck))
    exact ⟨_, _, normalRow ++ row, planned, .alternatives .original (.refl _), .no .here,
      .choice plannedCheck checked, List.append_subset.mpr ⟨within, List.Subset.refl _⟩, erased.template.ownership⟩

theorem planned_unwind_records_resume {front captured tail : Stack}
    (records : ∀ key body, (key, body) ∈ (entries : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner input answer captured caller tail)) key body) :
    ∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner entries →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (captured.append (front.append (.spent owner answer caller tail))) key body := by
  intro key body member
  cases records key body (RecursiveTransport.remove_owner_sublist.subset member) with
  | dispose located held recorded source =>
    exact .dispose (SourceDependencyOwners.Lexical.resume_record_location located member) held recorded source

theorem planned_unwind_records_discard {front captured tail : Stack}
    (records : ∀ key body, (key, body) ∈ (entries : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner input answer captured caller tail)) key body) :
    ∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner entries →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answer caller tail)))) key body := by
  intro key body member
  cases records key body (RecursiveTransport.remove_owner_sublist.subset member) with
  | dispose located held recorded source =>
    have moved := SourceDependencyOwners.Lexical.resume_record_location located member
    refine .dispose ?_ held recorded source
    rcases SavedCaptureIdentity.located_append.mp moved with inside | outside
    · exact SavedCaptureIdentity.located_append.mpr (Or.inl inside)
    · exact SavedCaptureIdentity.located_append.mpr (Or.inr (.push outside))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindSource.annotated_checked
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.planned_unwind_records_resume
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.planned_unwind_records_discard

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts Contract Value)
open SourcePlannedFrames (Families DependencyScope)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencyCapture (OwnerCut)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Checked evaluate)
open OwnerPhaseTransitions (spend spendAll)

/-- Disposing an unprotected capture leaves an ordinary waiting caller. The
source split and existing return-mode lemma determine this boundary. -/
theorem PlannedModeSource.extract_discard
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output demand requirements scope)
    (known : contracts owner = some contract)
    (unprotected : ProtectionContexts.protectedMode captured.erase = false)
    (checked : Checked entries receiving before
      (.sequence (.invoke ⟨owner, .dispose⟩ contract.closeDemand nearer) requirements) row) :
    ∃ (frontDemand tailDemand : List Nat), ∃ frontRequirements : Requirements frontDemand,
    ∃ capturedRequirements : Requirements contract.resumeDemand,
    ∃ tailRequirements : Requirements tailDemand,
    ∃ frontScope capturedScope tailScope,
      PlannedModeSource operations policy contracts tables families required outward actions world front
        (.value .unit) (.value contract.answer) frontDemand frontRequirements frontScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured
        (.value contract.input) (.value contract.answer) contract.resumeDemand capturedRequirements capturedScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail
        (.value contract.answer) output tailDemand tailRequirements tailScope ∧
      contract.answer.erase.erase.port = ScopedPorts.eraseType answerType ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      scope = frontScope.append (.live owner capturedScope tailScope) ∧
      demand = frontDemand ++ tailDemand ∧
      ∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail) ++ receiving)
            phases frontRequirements)
            (evaluate store receiving (spendAll phases frontDemand) (.sequence (.spent owner) tailRequirements)) := by
  have unused : owner ∉ demand := by
    have unique := RecursiveRequirements.checked_once checked
    intro member
    exact (List.nodup_cons.mp unique).1 (List.mem_append_right _ member)
  obtain ⟨middle, frontDemand, restDemand, frontRequirements, restRequirements,
    frontScope, restScope, frontSource, restSource, sameScope, sameDemand, evaluation⟩ := source.split
  cases restSource with
  | live actual rights inputAnnotation answerAnnotation callerScope held saved answer remaining =>
      cases Option.some.inj (known.symm.trans actual)
      rcases answer with rfl | rfl
      · exact ⟨frontDemand, restDemand, frontRequirements, _, _, frontScope, _, _,
          frontSource, saved, remaining, answerAnnotation, callerScope, sameScope, sameDemand, evaluation⟩
      · have returned := saved.return_mode
        rw [LexicalUnwind.unwind_prefix_return_mode
          (LexicalUnwind.unprotected_unwind_prefix unprotected)] at returned
        cases returned
  | opening saved remaining =>
      apply False.elim
      apply unused
      rw [sameDemand]
      simp
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.extract_discard

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencyCapture (OwnerCut)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Checked evaluate)
open OwnerPhaseTransitions (spend spendAll)

theorem PlannedModeSource.discard_waiting
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output demand requirements scope)
    (known : contracts owner = some contract)
    (unprotected : ProtectionContexts.protectedMode captured.erase = false)
    (checked : Checked entries receiving before
      (.sequence (.invoke ⟨owner, .dispose⟩ contract.closeDemand nearer) requirements) row)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup) :
    ∃ frontScope capturedScope tailScope, ∃ waitingRequirements : Requirements demand,
      OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩ ∧
      SourceDependencyCapture.Realizes tables families frontScope front ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        (front.append (.spent owner answerType caller tail)) (.value .unit) output
        demand waitingRequirements (frontScope.append (.spent owner tailScope)) ∧
      Bound annotations (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))) ∧
      ∀ store receiving phases, phases owner = .consumed →
        evaluate store receiving phases waitingRequirements = evaluate store receiving phases requirements := by
  obtain ⟨frontDemand, tailDemand, frontRequirements, capturedRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontSource, savedSource, tailSource,
    answerAnnotation, callerScope, scopeSame, demandSame, evaluation⟩ :=
    source.extract_discard known unprotected checked
  have prefixUnique : (ownedTickets front ++ owner :: (ownedTickets captured ++ ownedTickets tail)).Nodup := by
    simpa only [owned_tickets_append, ownedTickets] using unique
  have absent : owner ∉ ownedTickets front := fun member =>
    (List.nodup_append.mp prefixUnique).2.2 owner member owner List.mem_cons_self rfl
  have cut : OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩ := by
    rw [scopeSame]
    exact SourceDependencySchemes.Closing.prefix_owner_cut frontSource.realizes absent
  obtain ⟨waitingRequirements, waiting, waitingEvaluation⟩ := frontSource.append
    (.spent known answerAnnotation callerScope tailSource)
  subst demand
  refine ⟨frontScope, capturedScope, tailScope, waitingRequirements, cut, frontSource.realizes,
    waiting, SourceDependencySchemes.Lexical.bound_lexical_discard bound cut, ?_⟩
  intro store receiving phases consumed
  rw [waitingEvaluation, evaluation]
  congr 1
  exact RecursiveTransport.evaluate_transport (fun _ _ => rfl)
    (RecursiveRecomposition.normalize_replaced (front := .nil) (capture := captured)
      (tail := tail) (input := inputType) (answer := answerType) (caller := caller)
      (tables := tables) (receiving := receiving) consumed).symm
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.discard_waiting

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencyCapture (OwnerCut)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Checked evaluate)
open OwnerPhaseTransitions (spend spendAll)

/-- Discard checks its finite cleanup invocation with the closing boundary
that execution installs. Both checks are predecessor annotations. -/
theorem discard_planned_fragments
    {recordedRequirements : Requirements contract.closeDemand}
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output pendingDemand pendingRequirements scope)
    (known : contracts owner = some contract)
    (unprotected : ProtectionContexts.protectedMode captured.erase = false)
    (runtimeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (resumeModes : ∀ key body, (key, body) ∈ (resumes : Store) → key.mode = .resume)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (found : RecursiveRequirements.lookup ⟨owner, .dispose⟩ disposals = some ⟨contract.closeDemand, recordedRequirements⟩)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (invocation : Checked annotatedStore
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail))) before
      (.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]) closeRow)
    (pendingAnnotation : RowAnnotation pendingRequirements pendingAnnotated)
    (pending : Checked annotatedStore [] (spendAll before (owner :: contract.closeDemand)) pendingAnnotated pendingRow) :
    let waitingStack := front.append (.spent owner answerType caller tail)
    let closingStack := Stack.push (.closing identity runtimeScope) waitingStack
    let nextStack := captured.append closingStack
    ∃ frontScope capturedScope tailScope,
    ∃ requirements annotatedNext : Requirements (contract.closeDemand ++ pendingDemand),
    ∃ nextRow annotatedRow,
      OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩ ∧
      SourceDependencyCapture.Realizes tables families frontScope front ∧
      PlannedModeSource operations policy contracts tables families required outward actions world nextStack
        .unwind output (contract.closeDemand ++ pendingDemand) requirements
        (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))) ∧
      Bound annotations (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))) ∧
      RowAnnotation requirements annotatedNext ∧
      Checked (RecursiveTransport.removeOwner owner annotatedStore) [] (spend before owner) requirements nextRow ∧
      Checked (RecursiveTransport.removeOwner owner annotatedStore) [] (spend before owner) annotatedNext annotatedRow ∧
      nextRow ⊆ closeRow ++ pendingRow ∧ annotatedRow ⊆ closeRow ++ pendingRow ∧
      RequirementPath pendingAnnotated annotatedNext contract.closeDemand ∧
      (∃ savedAnnotated : Requirements contract.closeDemand,
        RowAnnotation recordedRequirements savedAnnotated ∧
        RequirementPath (savedAnnotated.prepend (OwnerPhases.ofStack tables closingStack)) annotatedNext []) ∧
      contract.closeDemand.Perm (ownedTickets captured) := by
  dsimp only
  obtain ⟨normalPendingRow, normalPending, pendingBound⟩ := pendingAnnotation.checked pending
  have invoked : Checked annotatedStore [] before
      ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) closeRow :=
    RecursiveRequirements.checked_prepend_iff.mpr (by simpa only [List.append_nil] using invocation)
  obtain ⟨frontScope, capturedScope, tailScope, waitingRequirements, cut, frontSource,
    waitingSource, nextBound, waitingEvaluation⟩ :=
    source.discard_waiting known unprotected (.sequence invoked normalPending) bound unique
  have paired := selected_planned_unwind_source closing found bound cut
    (RecursiveRecords.located_below front .here) unique
  obtain ⟨body, selectedContext, actual, ready, selection, bodyChecked⟩ :=
    RecursiveRequirements.checked_invocation invocation
  have fullFound : RecursiveRequirements.lookup ⟨owner, .dispose⟩ (resumes ++ disposals) =
      some ⟨contract.closeDemand, recordedRequirements⟩ := by
    rw [RecursiveDisposalCapture.lookup_after_resumes resumeModes]
    exact found
  obtain ⟨savedAnnotated, actualFound, savedAnnotation⟩ := storeAnnotation.lookup_annotated fullFound
  have sameTemplate := Option.some.inj (actual.symm.trans actualFound)
  have sameBody := eq_of_heq (Sigma.mk.inj sameTemplate).2
  subst body
  have consumed : spend before owner owner = .consumed := OwnerPhaseTransitions.spend_self before owner
  have contexts := RecursiveTransport.normalized_prefix (prefixContext := [.ordinary (.barrier true)])
    (RecursiveRecomposition.normalize_replaced (front := front) (capture := captured)
      (tail := tail) (input := inputType) (answer := answerType) (caller := caller)
      (tables := tables) (receiving := []) consumed)
  have savedChecked : Checked (RecursiveTransport.removeOwner owner annotatedStore)
      (OwnerPhases.ofStack tables (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))
      (spend before owner) savedAnnotated closeRow := by
    apply RecursiveTransport.checked_transport bodyChecked (RecursiveTransport.remove_consumed_agrees consumed)
    simpa only [List.append_nil, OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase,
      ProtectionContexts.frameProtected, closeFrame, List.singleton_append] using contexts
  obtain ⟨cleanupRequirements, cleanupAnnotated, cleanupRow, cleanupSource, cleanupAnnotation,
    storedPath, cleanupChecked, cleanupBound, captureBalance⟩ := paired.annotated_checked savedAnnotation savedChecked
  obtain ⟨normalCleanupRow, normalCleanupCheck, normalCleanupBound⟩ := cleanupAnnotation.checked cleanupChecked
  have consumedAfter := RecursiveTransport.phases_spendAll_later (owners := contract.closeDemand) owner consumed
  have retainedChecked : Checked (RecursiveTransport.removeOwner owner annotatedStore) []
      (spendAll (spend before owner) contract.closeDemand) pendingAnnotated pendingRow :=
    RecursiveTransport.checked_remove_consumed pending consumedAfter
  obtain ⟨waitingRow, waitingCheck, waitingBound⟩ := pendingAnnotation.checked retainedChecked
  have actualWaiting : Checked (RecursiveTransport.removeOwner owner annotatedStore) []
      (spendAll (spend before owner) contract.closeDemand) waitingRequirements waitingRow := by
    apply RecursiveRequirements.evaluate_sound
    rw [waitingEvaluation _ _ _ consumedAfter]
    exact RecursiveRequirements.checked_complete waitingCheck
  have closingSource := PlannedModeSource.push (PlannedModeFrame.closing (input := .unwind) (identity := identity) runtimeKnown) waitingSource
  have closingCheck : Checked (RecursiveTransport.removeOwner owner annotatedStore) []
      (spendAll (spend before owner) contract.closeDemand)
      (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))) waitingRequirements) waitingRow := by
    apply RecursiveRequirements.evaluate_sound
    simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
      RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
    exact RecursiveRequirements.checked_complete actualWaiting
  obtain ⟨requirements, rebuilt, rebuiltCheck⟩ := cleanupSource.append_checked closingSource
    (by simpa only [List.append_nil] using normalCleanupCheck) closingCheck
  have bounded : normalCleanupRow ++ waitingRow ⊆ closeRow ++ pendingRow :=
    ScopedExpressions.append_subset (normalCleanupBound.trans cleanupBound) waitingBound
  have savedAtRoot : Checked (RecursiveTransport.removeOwner owner annotatedStore) [] (spend before owner)
      (savedAnnotated.prepend (OwnerPhases.ofStack tables
        (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) closeRow :=
    RecursiveRequirements.checked_prepend_iff.mpr (by simpa only [List.append_nil] using savedChecked)
  let annotatedNext := Requirements.choice requirements
    (.sequence (savedAnnotated.prepend (OwnerPhases.ofStack tables
      (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) pendingAnnotated) (.refl _)
  refine ⟨frontScope, capturedScope, tailScope, requirements, annotatedNext, _, _, cut, frontSource,
    rebuilt, nextBound, .alternatives .original (.refl _), rebuiltCheck,
    .choice rebuiltCheck (.sequence savedAtRoot retainedChecked), bounded,
    List.append_subset.mpr ⟨bounded, List.Subset.refl _⟩, ?_,
    ⟨savedAnnotated, savedAnnotation, .no (.first .here)⟩, captureBalance⟩
  exact .no (by simpa only [List.append_nil] using (RequirementPath.second (.here : RequirementPath pendingAnnotated pendingAnnotated [])))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.discard_planned_fragments

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints (Matches)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open SourceDependencyCapture (OwnerCut OwnerSelection Realizes)
open OwnerPhaseTransitions (spend)
open RecursiveRequirements (Store)

theorem discard_pending_at_cut {hints : ReturnHints scope}
    (admitted : Local outward actions phases world (.invoke ⟨owner, .dispose⟩) hints)
    (matching : Matches tables families hints
      (front.append (.live owner input answer captured caller tail)))
    (cut : OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩)
    (frontSource : Realizes tables families frontScope front) :
    ∃ nextHints : ReturnHints (capturedScope.append (.running (frontScope.append (.spent owner tailScope)))),
      Matches tables families nextHints
        (captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answer caller tail)))) ∧
      Pending outward actions (spend phases owner) world nextHints .nil .unwind (hints.returnMode .ordinary) := by
  cases admitted with
  | dispose located known permission available unprotected abandoned waiting =>
      have same := Option.some.inj (located.lookup.symm.trans cut.lookup)
      obtain ⟨rfl, rfl, rfl⟩ := OwnerSelection.mk.inj same
      obtain ⟨first, boundary⟩ := matching.split_at frontSource
      cases boundary with
      | live inside outside =>
          have waitingMatch := Matches.append first (.spent (owner := owner) (answer := answer) (caller := caller) outside)
          have next := Matches.append inside (.running (.close (identity := identity) (caller := runtimeScope)) waitingMatch)
          refine ⟨_, next, SourceDependencyNeutral.Lexical.Recursive.pending_join (middle := .unwind) ?_ (.closing waiting)⟩
          exact abandoned.reindex_outside (SourceDependencyProjection.scope_append_nil _).symm
            (return_hints_append_nil _).symm

theorem planned_resume_records_discard {front captured tail : Stack}
    (records : ∀ key body, (key, body) ∈ (entries : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner input answer captured caller tail)) key body) :
    ∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner entries →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answer caller tail)))) key body := by
  intro key body member
  cases records key body (RecursiveTransport.remove_owner_sublist.subset member) with
  | resume located known recorded source answer =>
    have moved := SourceDependencyOwners.Lexical.resume_record_location located member
    refine .resume ?_ known recorded source answer
    rcases SavedCaptureIdentity.located_append.mp moved with inside | outside
    · exact SavedCaptureIdentity.located_append.mpr (Or.inl inside)
    · exact SavedCaptureIdentity.located_append.mpr (Or.inr (.push outside))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.discard_pending_at_cut
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.planned_resume_records_discard

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints (Matches)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available spend spendAll Trace)

/-- Join the actual discard transition with rich planned source, recursive
capability checks, both retained certificates, and physical ownership. The
protected cleanup path is a finite predecessor annotation, not a successor check. -/
theorem discard_planned_segments
    {recordedRequirements : Requirements contract.closeDemand}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.discard binder) .unit (owner :: contract.closeDemand) (.invoke ⟨owner, .dispose⟩ contract.closeDemand [])
      (.invoke (key := ⟨owner, .dispose⟩)))
    (known : contracts owner = some contract)
    (resolved : runtimeScope.resolve binder = some owner)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value .unit) output pendingDemand pendingRequirements scope)
    {hints : ReturnHints scope}
    (matching : Matches tables families hints (front.append (.live owner inputType answerType captured caller tail)))
    (localCheck : Local outward actions
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) world
      (.invoke ⟨owner, .dispose⟩) hints)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (found : RecursiveRequirements.lookup ⟨owner, .dispose⟩ disposals = some ⟨contract.closeDemand, recordedRequirements⟩)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation
      (.sequence ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand []).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) pendingRequirements)
      annotatedRoot)
    (certificate : Checked annotatedStore []
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) annotatedRoot certificateRow)
    (protectedPath : RequirementPath
      ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) annotatedRoot [])
    (usage : LexicalUnwind.MachineUse policy actions (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (resources : LexicalUnwind.MachineAccess ambient (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (frontBound : InternalUses (ownedTickets front ++ ownedTickets tail) front.erase.pending)
    (internal : InternalUses captured.erase.liveTickets captured.erase.pending)
    (tailBound : InternalUses (ownedTickets tail) tail.erase.pending) :
    let nextStack := captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail)))
    let after := available (ownedTickets nextStack)
    LexicalUnwind.UseTransition (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩)
      (.unwind runtimeScope nextStack) [.close identity] [.ticket owner] ∧
    LexicalUnwind.MachineUse policy actions (.unwind runtimeScope nextStack) ∧
    LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope nextStack) ∧
    LexicalUnwind.MachineAccess ambient (.unwind runtimeScope nextStack) ∧
    StoreAnnotation (RecursiveTransport.removeOwner owner (resumes ++ disposals))
      (RecursiveTransport.removeOwner owner annotatedStore) ∧
    ∃ nextScope, ∃ nextHints : ReturnHints nextScope,
    ∃ requirements annotatedNext : Requirements (contract.closeDemand ++ pendingDemand), ∃ row annotatedRow,
      PlannedModeSource operations policy contracts tables families required outward actions world nextStack
        .unwind output (contract.closeDemand ++ pendingDemand) requirements nextScope ∧
      Matches tables families nextHints nextStack ∧
      Pending outward actions after world nextHints .nil .unwind output.mode ∧
      Bound annotations nextScope ∧
      RowAnnotation requirements annotatedNext ∧
      Checked (RecursiveTransport.removeOwner owner annotatedStore) [] after requirements row ∧ row ⊆ certificateRow ∧
      Checked (RecursiveTransport.removeOwner owner annotatedStore) [] after annotatedNext annotatedRow ∧ annotatedRow ⊆ certificateRow ∧
      (∃ retained : Requirements pendingDemand,
        RowAnnotation pendingRequirements retained ∧
        RequirementPath retained annotatedRoot (owner :: contract.closeDemand) ∧
        RequirementPath retained annotatedNext contract.closeDemand) ∧
      (∃ savedAnnotated : Requirements contract.closeDemand,
        RowAnnotation recordedRequirements savedAnnotated ∧
        RequirementPath (savedAnnotated.prepend (OwnerPhases.ofStack tables
          (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) annotatedNext []) ∧
      Trace (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) [owner] after ∧
      (ownedTickets nextStack).Nodup ∧
      (contract.closeDemand ++ pendingDemand).Perm (ownedTickets nextStack) ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner disposals →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) := by
  dsimp only
  have runtimeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope := by
    cases runtimeScope with
    | none => cases resolved
    | ticket localBinder actual =>
      simp only [Execution.Scope.resolve] at resolved
      split at resolved
      · cases Option.some.inj resolved
        exact ⟨_, .bound (CoherentSourceTypes.Owners.ports_lookup
          (SourceDependencyAnnotations.contract_erase_known (SourcePlannedSources.contract_erase_known known)))⟩
      · cases resolved
  have unprotected : ProtectionContexts.protectedMode captured.erase = false := by
    cases closing _ _ (SourceTemplates.lookup_member found) with
    | dispose located held recorded cleanup =>
      cases SourceTemplates.captured_in_unique unique located (RecursiveRecords.located_below front .here)
      exact held
  have resumeModes : ∀ key body, (key, body) ∈ resumes → key.mode = .resume := by
    intro key body member
    cases records key body member
    rfl
  obtain ⟨normalRow, normalCheck, normalBound⟩ := annotation.checked certificate
  obtain ⟨_, originalCheck, _⟩ := storeAnnotation.checked normalCheck
  have balanced := SourceDependencySchemes.Lexical.mode_source_ownership_balance
    (SourcePlannedSources.expression_erase current) source.erase
    (fun key body member => (records key body member).erase)
    (fun key body member => (closing key body member).erase) unique originalCheck
  obtain ⟨retained, retainedAnnotation, retainedPath⟩ := annotation.focus
    (show RequirementPath pendingRequirements
      (.sequence ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand []).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) pendingRequirements)
      (owner :: contract.closeDemand) from by simpa only [List.append_nil] using
        (RequirementPath.second (.here : RequirementPath pendingRequirements pendingRequirements [])))
  obtain ⟨waitingRow, waitingCheck, waitingBound⟩ := retainedPath.checked certificate
  obtain ⟨closeRow, closeCheck, closeBound⟩ := protectedPath.checked certificate
  have actualInvocation : Checked annotatedStore
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      (.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]) closeRow := by
    simpa only [List.append_nil, spendAll] using RecursiveRequirements.checked_prepend_iff.mp closeCheck
  obtain ⟨frontScope, capturedScope, tailScope, requirements, annotatedNext, row, annotatedRow,
    cut, frontSource, nextSource, nextBound, nextAnnotation, nextCheck, annotatedCheck, rowBound,
    annotatedBound, kept, saved, captureBalance⟩ :=
    discard_planned_fragments source known unprotected runtimeKnown storeAnnotation resumeModes closing found bound unique
      actualInvocation retainedAnnotation waitingCheck
  have phaseSame : available (ownedTickets (captured.append (.push (.closing identity runtimeScope)
      (front.append (.spent owner answerType caller tail))))) =
      spend (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) owner := by
    simpa only [owned_tickets_append, ownedTickets, spendAll] using
      OwnerPhaseTransitions.trace_result (OwnerPhaseTransitions.resume_phase_trace unique)
  rw [← phaseSame] at nextCheck annotatedCheck
  have nextUnique : (ownedTickets (captured.append (.push (.closing identity runtimeScope)
      (front.append (.spent owner answerType caller tail))))).Nodup := by
    simpa only [owned_tickets_append, ownedTickets] using
      (List.nodup_cons.mp (OwnerPhaseTransitions.resume_owned_permutation.nodup unique)).2
  have nextBalance : (contract.closeDemand ++ pendingDemand).Perm
      (ownedTickets (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answerType caller tail))))) := by
    apply List.Perm.cons_inv (a := owner)
    simpa only [owned_tickets_append, ownedTickets, List.cons_append] using
      balanced.trans OwnerPhaseTransitions.resume_owned_permutation
  have trace : Trace (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      [owner] (available (ownedTickets (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answerType caller tail)))))) := by
    simpa only [owned_tickets_append, ownedTickets] using OwnerPhaseTransitions.resume_phase_trace unique
  obtain ⟨nextHints, nextMatch, nextPending⟩ := discard_pending_at_cut (identity := identity)
    (runtimeScope := runtimeScope) localCheck matching cut frontSource
  have returnMode : hints.returnMode .ordinary = output.mode := matching.return_mode.trans source.return_mode
  rw [← phaseSame, returnMode] at nextPending
  have event := LexicalUnwind.UseTransition.discard binder owner identity runtimeScope caller inputType answerType
    front captured tail resolved unprotected frontBound internal tailBound
  have nextUsage := LexicalUnwind.discard_machine_use (identity := identity) usage resolved unique unprotected frontBound internal tailBound
  have nextTickets := event.ticket_access (policy := policy) (tickets := actions)
    (by intro other impossible; simp at impossible) unique usage tickets
  have nextResources : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope
      (captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) := by
    cases resources with | eval supported => exact .unwind (LexicalUnwind.discard_access supported.control)
  have covered : closeRow ++ waitingRow ⊆ certificateRow := List.append_subset.mpr ⟨closeBound, waitingBound⟩
  exact ⟨event, nextUsage, nextTickets, nextResources, storeAnnotation.remove_owner owner,
    _, nextHints, requirements, annotatedNext, row, annotatedRow, nextSource, nextMatch, nextPending, nextBound,
    nextAnnotation, nextCheck, rowBound.trans covered, annotatedCheck, annotatedBound.trans covered,
    ⟨retained, retainedAnnotation, retainedPath, kept⟩, saved, trace, nextUnique, nextBalance,
    planned_resume_records_discard records, planned_unwind_records_discard closing⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.discard_planned_segments

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open RecursiveRequirements (Requirements)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)

/-- The additional discard check is constructed locally from the owner,
cleanup demand and receiving context. It adds no runtime planning operation. -/
theorem discard_closing_annotation
    (pending : RowAnnotation requirements annotated) :
    let ordinary := (Requirements.invoke ⟨owner, .dispose⟩ closeDemand []).prepend receiving
    let closingInvocation := (Requirements.invoke ⟨owner, .dispose⟩ closeDemand [.ordinary (.barrier true)]).prepend receiving
    let result := Requirements.sequence (.choice ordinary closingInvocation (.refl _)) annotated
    RowAnnotation (.sequence ordinary requirements) result ∧
      RequirementPath closingInvocation result [] ∧
      RequirementPath annotated result (owner :: closeDemand) := by
  exact ⟨.sequence (.alternatives .original (.refl _)) pending, .first (.no .here),
    by simpa only [List.append_nil] using (RequirementPath.second (.here : RequirementPath annotated annotated []))⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.discard_closing_annotation


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open RecursiveRequirements (Requirements Store Checked evaluate)

def annotateDisposalStore : Store → Store
  | [] => []
  | (key, ⟨demand, requirements⟩) :: rest =>
      (key, ⟨demand, annotateDisposals requirements⟩) :: annotateDisposalStore rest

theorem annotated_disposals (annotation : RowAnnotation normal annotated) :
    RowAnnotation normal (annotateDisposals annotated) := by
  induction annotation with
  | original => exact disposal_annotation _
  | alternatives normal same ih => exact .alternatives ih same
  | sequence first second ihFirst ihSecond => exact .sequence ihFirst ihSecond
  | emitAfter body ih => exact .emitAfter ih
  | choice first second ihFirst ihSecond => exact .choice ihFirst ihSecond

theorem annotated_disposal_store (annotation : StoreAnnotation normal annotated) :
    StoreAnnotation normal (annotateDisposalStore annotated) := by
  induction annotation with
  | nil => exact .nil
  | cons body rest ih => exact .cons (annotated_disposals body) ih

/-- Every explicit disposal position has its closing-boundary check at the
same owner phase in the generated tree. -/
theorem disposal_path
    (path : RequirementPath (.invoke ⟨owner, .dispose⟩ demand nearer) requirements prior) :
    RequirementPath (.invoke ⟨owner, .dispose⟩ demand (.ordinary (.barrier true) :: nearer))
      (annotateDisposals requirements) prior := by
  induction path with
  | here => exact .no .here
  | first inside ih => exact .first ih
  | second inside ih => exact .second ih
  | body inside ih => exact .body ih
  | yes inside ih => exact .yes ih
  | no inside ih => exact .no ih

/-- Normal invocation leaves remain explicit paths through added row choices. -/
private theorem annotation_invocation_path_heq
    {normal annotated : Requirements normalDemand}
    (annotation : RowAnnotation normal annotated)
    (same : normalDemand = key.owner :: demand)
    (equation : HEq normal (Requirements.invoke key demand nearer)) :
    RequirementPath (.invoke key demand nearer) annotated [] := by
  induction annotation generalizing key demand nearer with
  | original =>
      cases same
      cases eq_of_heq equation
      exact .here
  | alternatives normal aligned ih => exact .yes (ih same equation)
  | sequence | emitAfter | choice => exact Requirements.noConfusion same equation

theorem annotation_invocation_path
    (annotation : RowAnnotation (.invoke key demand nearer) annotated) :
    RequirementPath (.invoke key demand nearer) annotated [] :=
  annotation_invocation_path_heq annotation rfl HEq.rfl

theorem annotated_disposal_path
    (annotation : RowAnnotation normal annotated)
    (path : RequirementPath (.invoke ⟨owner, .dispose⟩ demand nearer) normal prior) :
    RequirementPath (.invoke ⟨owner, .dispose⟩ demand (.ordinary (.barrier true) :: nearer))
      (annotateDisposals annotated) prior := by
  obtain ⟨focused, focusedAnnotation, position⟩ := annotation.focus path
  apply disposal_path
  simpa only [List.append_nil] using position.trans (annotation_invocation_path focusedAnnotation)

/-- Retaining an annotated source subtree retains all generated disposal
checks below that subtree, at their composed consumption prefixes. -/
theorem retained_disposal_path
    (retained : RequirementPath (annotateDisposals annotated) whole outerPrior)
    (annotation : RowAnnotation normal annotated)
    (path : RequirementPath (.invoke ⟨owner, .dispose⟩ demand nearer) normal innerPrior) :
    RequirementPath (.invoke ⟨owner, .dispose⟩ demand (.ordinary (.barrier true) :: nearer))
      whole (outerPrior ++ innerPrior) :=
  retained.trans (annotated_disposal_path annotation path)

/-- Generated annotation is finite checking data. A successful existing checker
supplies the normal source check and every disposal check at its actual phase. -/
theorem disposal_check_sound
    (storeAnnotation : StoreAnnotation originalStore entries)
    (annotation : RowAnnotation normal annotated)
    (accepted : evaluate (annotateDisposalStore entries) receiving before (annotateDisposals annotated) = some row) :
    ∃ normalRow, Checked originalStore receiving before normal normalRow ∧ normalRow ⊆ row ∧
      ∀ owner demand nearer prior,
        RequirementPath (.invoke ⟨owner, .dispose⟩ demand nearer) normal prior →
        ∃ cleanupRow, Checked (annotateDisposalStore entries) receiving (OwnerPhaseTransitions.spendAll before prior)
          (.invoke ⟨owner, .dispose⟩ demand (.ordinary (.barrier true) :: nearer)) cleanupRow ∧ cleanupRow ⊆ row := by
  have checked := RecursiveRequirements.evaluate_sound accepted
  obtain ⟨sourceRow, sourceCheck, sourceBound⟩ := (annotated_disposals annotation).checked checked
  obtain ⟨normalRow, normalCheck, normalBound⟩ := (annotated_disposal_store storeAnnotation).checked sourceCheck
  refine ⟨normalRow, normalCheck, normalBound.trans sourceBound, ?_⟩
  intro owner demand nearer prior path
  exact (annotated_disposal_path annotation path).checked checked
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.disposal_annotation
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.annotated_disposals
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.annotated_disposal_store
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.disposal_prepend
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.disposal_path
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.annotation_invocation_path
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.annotated_disposal_path
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.retained_disposal_path
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.disposal_check_sound

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open RecursiveRequirements (Requirements Store Checked)

/-- Any selected source subtree keeps its generated annotations at exactly the
same position. This also applies to capture and callback certificate paths. -/
theorem disposal_subtree_path (path : RequirementPath selected whole prior) :
    RequirementPath (annotateDisposals selected) (annotateDisposals whole) prior := by
  induction path with
  | here => exact .here
  | first inside ih => exact .first ih
  | second inside ih => exact .second ih
  | body inside ih => exact .body ih
  | yes inside ih => exact .yes ih
  | no inside ih => exact .no ih

theorem disposal_source_focus
    (annotation : RowAnnotation normal annotated)
    (path : RequirementPath (selected : Requirements selectedDemand) normal prior) :
    ∃ focused : Requirements selectedDemand,
      RowAnnotation selected focused ∧
      RowAnnotation selected (annotateDisposals focused) ∧
      RequirementPath (annotateDisposals focused) (annotateDisposals annotated) prior := by
  obtain ⟨focused, source, position⟩ := annotation.focus path
  exact ⟨focused, source, annotated_disposals source, disposal_subtree_path position⟩

/-- Store generation changes only the requirement body. Lookup authenticates
the exact generated body, rather than another annotation with the same type. -/
theorem disposal_store_lookup
    (found : RecursiveRequirements.lookup key entries = some ⟨demand, requirements⟩) :
    RecursiveRequirements.lookup key (annotateDisposalStore entries) =
      some ⟨demand, annotateDisposals requirements⟩ := by
  induction entries with
  | nil => cases found
  | cons entry rest ih =>
      obtain ⟨candidate, actualDemand, body⟩ := entry
      simp only [RecursiveRequirements.lookup, annotateDisposalStore] at found ⊢
      by_cases same : key = candidate
      · rw [if_pos same] at found ⊢
        cases Option.some.inj found
        rfl
      · rw [if_neg same] at found ⊢
        exact ih found

/-- Consuming an owner preserves the generated shape of every surviving record. -/
theorem disposal_store_remove_owner (owner : Nat) (entries : Store) :
    annotateDisposalStore (RecursiveTransport.removeOwner owner entries) =
      RecursiveTransport.removeOwner owner (annotateDisposalStore entries) := by
  induction entries with
  | nil => rfl
  | cons entry rest ih =>
      obtain ⟨key, demand, body⟩ := entry
      by_cases removed : key.owner = owner <;>
        simp only [RecursiveTransport.removeOwner, annotateDisposalStore, removed, reduceIte, ih]

theorem disposal_store_unwind (stack : Stack) (entries : Store) :
    annotateDisposalStore (SourceDependencyFrames.unwindStore stack entries) =
      SourceDependencyFrames.unwindStore stack (annotateDisposalStore entries) := by
  cases stack <;> first | rfl | exact disposal_store_remove_owner _ _

/-- Entering a referenced source record exposes its generated checks in the
actual receiving context and consumed-owner phase. The ordinary recursive
checker already visits this body; no future execution premise is added. -/
theorem disposal_record_sound
    (found : RecursiveRequirements.lookup key entries = some ⟨demand, requirements⟩)
    (checked : Checked (annotateDisposalStore entries) receiving before (.invoke key demand nearer) row) :
    Checked (annotateDisposalStore entries) (nearer ++ receiving) (OwnerPhaseTransitions.spend before key.owner)
      (annotateDisposals requirements) row ∧
    ∀ owner closeDemand context prior,
      RequirementPath (.invoke ⟨owner, .dispose⟩ closeDemand context) requirements prior →
      ∃ cleanupRow, Checked (annotateDisposalStore entries) (nearer ++ receiving)
        (OwnerPhaseTransitions.spendAll (OwnerPhaseTransitions.spend before key.owner) prior)
        (.invoke ⟨owner, .dispose⟩ closeDemand (.ordinary (.barrier true) :: context)) cleanupRow ∧ cleanupRow ⊆ row := by
  obtain ⟨body, waiting, actual, ready, selection, bodyChecked⟩ := RecursiveRequirements.checked_invocation checked
  have same := Option.some.inj (actual.symm.trans (disposal_store_lookup found))
  have sameBody := eq_of_heq (Sigma.mk.inj same).2
  subst body
  refine ⟨bodyChecked, ?_⟩
  intro owner closeDemand context prior path
  exact (disposal_path path).checked bodyChecked
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.disposal_subtree_path
