/-- A registry update outside this installed frame retains its authenticated
metadata, exact endpoint rows, and decorated context. -/
theorem FrameRows.registries
    {frame : CertifiedFrame (evidence := declarationPolicy.accepts outward)
      operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing}
    (checked : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (tableAgree : ∀ handler, handler.activation ∈ entry.erase.activation → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ entry.erase.activation → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ entry.erase.activation → required handler = nextRequired handler) :
    ∃ nextDecorate, ∃ nextFrame : CertifiedFrame (evidence := declarationPolicy.accepts outward)
      operations policy contracts nextTables nextFamilies nextRequired outward world entry input output demand requirements layer nextDecorate incoming outgoing,
      FrameRows operations policy contracts nextTables nextFamilies nextRequired outward world ports owners emptyRows
        nextFrame inputRows outputRows tail decorated := by
  cases checked with
  | plain authenticated => exact ⟨_, _, .plain authenticated (scopeKnown := by assumption) (inputAnnotation := by assumption) (outputAnnotation := by assumption) (certified := by assumption)⟩
  | handler authenticated =>
    rename_i data plans declarationRows scopeKnown coverage unique recipes capabilities modes certified annotation clauses declarations
    have tableSame := tableAgree data List.mem_cons_self
    have familySame := familyAgree data List.mem_cons_self
    have requiredSame := requiredAgree data List.mem_cons_self
    generalize tableValue : tables data = oldTable at *
    generalize familyValue : families data = oldFamily at *
    generalize requiredValue : required data = oldRequired at *
    cases tableSame
    cases familySame
    cases requiredSame
    exact ⟨_, _, .handler authenticated (scopeKnown := scopeKnown) (annotation := annotation)
      (clauses := clauses) (coverage := coverage) (unique := unique) (recipes := recipes)
      (capabilities := capabilities) (modes := modes) (certified := certified)⟩
  | cell => exact ⟨_, _, .cell (scopeKnown := by assumption) (noEscape := by assumption) (annotation := by assumption) (interface := by assumption)⟩
  | armed authenticated => exact ⟨_, _, .armed authenticated (scopeKnown := by assumption) (annotation := by assumption) (interface := by assumption) (certified := by assumption)⟩
  | running callback saved => exact ⟨_, _, .running callback saved (scopeKnown := by assumption) (annotation := by assumption) (interface := by assumption)⟩
  | closing => exact ⟨_, _, .closing (scopeKnown := by assumption) (interface := by assumption)⟩
  | retiring => exact ⟨_, _, .retiring (known := by assumption) (interface := by assumption)⟩

/-- Registry agreement preserves each ordinary or unwind frame decoration. -/
theorem ModeFrameRows.registries
    {frame : PlannedModeFrame operations policy contracts tables families required outward world
      entry input output demand requirements layer}
    (checked : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail decorated)
    (tableAgree : ∀ handler, handler.activation ∈ entry.erase.activation → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ entry.erase.activation → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ entry.erase.activation → required handler = nextRequired handler) :
    ∃ nextFrame : PlannedModeFrame operations policy contracts nextTables nextFamilies nextRequired outward world
      entry input output demand requirements layer,
      ModeFrameRows operations policy contracts nextTables nextFamilies nextRequired outward world ports owners emptyRows
        nextFrame inputRows outputRows tail decorated := by
  cases checked with
  | ordinary authenticated =>
    obtain ⟨_, _, moved⟩ := authenticated.registries tableAgree familyAgree requiredAgree
    exact ⟨_, .ordinary moved⟩
  | unwinding authenticated => exact ⟨_, .unwinding authenticated (certified := by assumption)⟩
  | closing => exact ⟨_, .closing (scopeKnown := by assumption)⟩
  | retiring => exact ⟨_, .retiring⟩
  | skipped => exact ⟨_, .skipped⟩
  | handler authenticated =>
    obtain ⟨_, _, moved⟩ := authenticated.registries tableAgree familyAgree requiredAgree
    rename_i answer residual data answerRows decorate frame hints nextDecorate nextFrame
    have tableSame := tableAgree data List.mem_cons_self
    have familySame := familyAgree data List.mem_cons_self
    generalize tableValue : tables data = oldTable at *
    generalize familyValue : families data = oldFamily at *
    cases tableSame
    cases familySame
    exact ⟨_, .handler moved⟩
  | cell => exact ⟨_, .cell⟩
  | cleanup authenticated => exact ⟨_, .cleanup authenticated (certified := by assumption)⟩

/-- The existing source registry transport retains the same coherent rows
and context throughout the stack, including saved and opening continuations. -/
theorem PendingRows.registries
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (checked : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (tableAgree : ∀ handler, handler.activation ∈ stack.erase.activations → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ stack.erase.activations → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ stack.erase.activations → required handler = nextRequired handler) :
    PendingRows operations policy contracts nextTables nextFamilies nextRequired outward actions world ports owners emptyRows
      (source.registries tableAgree familyAgree requiredAgree) inputRows outputRows context := by
  induction checked with
  | nil => exact .nil
  | push head tail ih =>
      have next := fun handler member => tableAgree handler (List.mem_append_right _ member)
      have same := RecursiveHandlerTables.context_congr next
      obtain ⟨_, moved⟩ := head.registries
        (fun handler member => tableAgree handler (List.mem_append_left _ member))
        (fun handler member => familyAgree handler (List.mem_append_left _ member))
        (fun handler member => requiredAgree handler (List.mem_append_left _ member))
      have remaining := ih next (fun handler member => familyAgree handler (List.mem_append_right _ member))
        (fun handler member => requiredAgree handler (List.mem_append_right _ member))
      simpa only [same] using PendingRows.push moved remaining
  | live answerRows inside tail ihInside ihTail =>
      exact .live answerRows
        (ihInside (fun handler member => tableAgree handler (List.mem_append_left _ member))
          (fun handler member => familyAgree handler (List.mem_append_left _ member))
          (fun handler member => requiredAgree handler (List.mem_append_left _ member)))
        (ihTail (fun handler member => tableAgree handler (List.mem_append_right _ member))
          (fun handler member => familyAgree handler (List.mem_append_right _ member))
          (fun handler member => requiredAgree handler (List.mem_append_right _ member)))
        (known := by assumption) (actionKnown := by assumption) (inputAnnotation := by assumption)
        (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption) (answer := by assumption)
  | opening inside tail ihInside ihTail =>
      have next := fun handler member => tableAgree handler (List.mem_append_right _ member)
      have remaining := ihTail next (fun handler member => familyAgree handler (List.mem_append_right _ member))
        (fun handler member => requiredAgree handler (List.mem_append_right _ member))
      have saved := ihInside (fun handler member => tableAgree handler (List.mem_append_left _ member))
        (fun handler member => familyAgree handler (List.mem_append_left _ member))
        (fun handler member => requiredAgree handler (List.mem_append_left _ member))
      have same := RecursiveHandlerTables.context_congr next
      simpa only [OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase, same] using PendingRows.opening saved remaining
  | spent tail ih =>
      exact .spent (ih tableAgree familyAgree requiredAgree) (known := by assumption)
        (annotation := by assumption) (callerScope := by assumption)
  | skippedSpent tail ih => exact .skippedSpent (ih tableAgree familyAgree requiredAgree)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.FrameRows.registries
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ModeFrameRows.registries
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.registries

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
