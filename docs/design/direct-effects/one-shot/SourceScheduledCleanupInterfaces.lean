    (fun _ => none) (.resume 9 .unit) .unit [0] (.sequence empty (.invoke ⟨0, .resume⟩ [] []))
    (.sequence .pure (.invoke (key := ⟨0, .resume⟩))) :=
  .resume (show contracts 0 = some (contract 0) from rfl) rfl rfl .unit
    (by simp [contract]) (by intro x member; cases member)

theorem currentAuth : Auth operations policy ports owners emptyRows currentSource .unit currentRows := by
  apply Auth.resume (operand := SourcePlannedSources.Expression.unit) (known := show contracts 0 = some (contract 0) from rfl) (resolved := rfl)
    (permission := rfl) (admitted := by simp [contract]) (formed := by intro x member; cases member)
  exact .unit

theorem primitiveCertificate : SourceAdmission.Code [] actions []
    (OwnerPhaseTransitions.available (ownedTickets whole)) [] []
    (Rows.invoke (key := ⟨0, .resume⟩)) wholeContext := by
  apply SourceAdmission.Code.resume (front := frontContext) (captured := capturedContext) (tail := tailContext)
  · exact .plain .hit
  · rfl
  · rfl
  · rfl
  · simp [ResumeShape, frontContext, Context.closing?,
      SourceDependencyChecks.Lexical.ReturnHints.returnMode, SourceDependencyChecks.Lexical.ReturnBoundary.apply]
  · exact .unwinding (.skipped (.spent (.opening .nil (.closing .nil))))

theorem currentCertificate : SourceAdmission.Code [] actions []
    (OwnerPhaseTransitions.available (ownedTickets whole)) [] [] currentRows wholeContext :=
  .sequence .pure primitiveCertificate


def ordinaryPending : Requirements [1, 1] :=
  .sequence ((Requirements.invoke ⟨1, .resume⟩ [] []).prepend
    (OwnerPhases.ofStack tables (.live 0 .unit .unit captured .none tail))) liveReq

theorem wholeSource : Source whole (.value .unit) (.value .unit) [1, 1] ordinaryPending
    (.plain (.invoke ⟨1, .resume⟩) (.live 0 (.running .nil) (.live 1 .nil (.running .nil)))) :=
  .push (.ordinary (.plain (plain := frontData) (input := .unit) (output := .unit) (demand := [1])
    (requirements := Requirements.invoke ⟨1, .resume⟩ [] []) (allowed := []) callerSource (.bound rfl) rfl rfl callerCertified)) liveSource

theorem wholeRows : Rich wholeSource (.value .unit) (.value .unit) wholeContext :=
  .push (.ordinary (.plain (scopeKnown := .bound rfl) (inputAnnotation := rfl) (outputAnnotation := rfl)
    (certified := callerCertified) callerAuth)) liveRows

theorem legacy_demand_rejected {requirements : Requirements [0, 1, 1]} :
    ¬ RecursiveRequirements.Checked entries receiving phases requirements row := by
  intro checked
  have unique := OwnerPhaseTransitions.trace_nodup (RecursiveRequirements.checked_trace checked)
  simp at unique

