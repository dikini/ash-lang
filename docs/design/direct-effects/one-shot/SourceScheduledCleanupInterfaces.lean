namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Value transitions reuse one ledger and resource transport proof. -/
theorem value_step_ledger_resources
    (raw : RawStep before after [] discharged)
    (value : before.expression.IsValue)
    (checks : AccessChecks before ambient)
    (ledger : Ledger (RunState.erase ⟨.eval before, issued, completed⟩))
    (history : UsageRegistryHistory tickets issued)
    (access : MachineAccess ambient (.eval before)) :
    Event ⟨.eval before, issued, completed⟩ ⟨.eval after, issued, discharged ++ completed⟩ ∧
    Ledger (RunState.erase ⟨.eval after, issued, discharged ++ completed⟩) ∧
    UsageRegistryHistory tickets issued ∧ MachineAccess ambient (.eval after) := by
  have transition : Transition (.eval before) (.eval after) [] discharged :=
    .evaluate raw (by cases before; rename_i expression scope stack; cases expression <;> first | trivial | exact value)
  have event : Event ⟨.eval before, issued, completed⟩ ⟨.eval after, issued, discharged ++ completed⟩ := by
    simpa only [List.append_nil] using
      (Event.step (before := ⟨.eval before, issued, completed⟩) transition
        (by simpa only [List.append_nil, RunState.erase] using ledger.2))
  refine ⟨event, event_preserves_ledger event ledger, history, ?_⟩
  cases access with
  | eval supported => exact .eval (raw_step_preserves_access raw supported checks)

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.LexicalUnwind.value_step_ledger_resources

namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Plugging preserves independent ledger and resource fields without raw-code accounting. -/
theorem plug_ledger_resources
    (closed : ClosedValue value)
    (ledger : Ledger (RunState.erase ⟨.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩, issued, completed⟩))
    (history : UsageRegistryHistory tickets issued)
    (access : MachineAccess ambient (.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩)) :
    Event ⟨.eval ⟨value, runtimeScope, .push (.plain plain) tail⟩, issued, completed⟩
      ⟨.eval ⟨plain.context.plug value, plain.scope, tail⟩, issued, completed⟩ ∧
    Ledger (RunState.erase ⟨.eval ⟨plain.context.plug value, plain.scope, tail⟩, issued, completed⟩) ∧
    UsageRegistryHistory tickets issued ∧
    MachineAccess ambient (.eval ⟨plain.context.plug value, plain.scope, tail⟩) := by
  have checks : AccessChecks ⟨value, runtimeScope, .push (.plain plain) tail⟩ ambient := by
    constructor
    · intro identity payload answer savedScope current value rest same closed
      cases same
    · intro requested operation operand current stack cap outside handler same cut operandClosed
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
    · intro binder owner current caller input answer front cap outside plan same resolve built
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
  simpa only [List.nil_append] using value_step_ledger_resources
    (RawStep.plug plain value closed runtimeScope tail) closed.1 checks ledger history access

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.LexicalUnwind.plug_ledger_resources

namespace Ash.OneShot.SourceDependencyOwners
open ScopedExpressions ScopedExecution SourceDependencyAnnotations

/-- A resolved free ticket in authenticated syntax lies within its lexical owner bound. -/
theorem expression_ticket_visible
    (source : Expression operations policy contracts world allowed scope environment code value demand requirements dependencies)
    (bounded : Within world owned dependencies)
    (used : Syntax.Dependency.ticket binder ∈ code.dependencies)
    (resolved : scope.resolve binder = some owner) : owner ∈ owned := by
  by_cases included : owner ∈ owned
  · exact included
  apply False.elim
  have outside : ∀ other target, scope.resolve other = some target → target ∉ owned := by
    intro other target known
    cases scopeSame : scope with
    | none => simp [scopeSame, Execution.Scope.resolve] at resolved
    | ticket localBinder actual =>
        simp only [scopeSame, Execution.Scope.resolve] at resolved known
        split at resolved <;> simp_all
  have idle := expression_external_idle source bounded outside
  obtain ⟨rights, impossible, _⟩ := free_ticket_requires_consumption idle used
  cases impossible

end Ash.OneShot.SourceDependencyOwners

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport

/-- Current free-ticket visibility follows from the existing source certificate. -/
theorem ExecutionSite.ticket_visible
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (used : Syntax.Dependency.ticket binder ∈ site.expression.dependencies)
    (resolved : site.runtimeScope.resolve binder = some owner) : owner ∈ activeTickets site.stack := by
  have bounded := SourceTicketAccess.local_within_active site.current.previous.capabilities
  have visible := SourceDependencyOwners.expression_ticket_visible
    (SourcePlannedSources.expression_erase site.current.previous.source) bounded used resolved
  simpa only [SourceTicketAccess.active_realizes site.coherent.forget.source.matching.erases] using visible

/-- The retained source derives mode-correct pending access, including dormant captures. -/
theorem ExecutableSource.pending_ticket_access
    (source : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows machine) :
    match machine with
    | .eval configuration => LexicalUnwind.TicketAccess configuration.stack .ordinary output.mode []
    | .unwind _ stack => LexicalUnwind.TicketAccess stack .unwind output.mode [] := by
  cases source with
  | eval site phaseAgreement rooted bound annotation checked bounded =>
      exact site.coherent.ticket_access site.retained
        (SourceDependencyCapture.Realizes.nil (tables := tables) (families := families))
  | unwind pending coherent certificate waiting bound annotation checked bounded pendingResource =>
      exact coherent.ticket_access certificate
        (SourceDependencyCapture.Realizes.nil (tables := tables) (families := families))

/-- Current lexical name access requires no whole-expression consumption trace. -/
theorem ExecutableSource.current_ticket_visible
    (source : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows (.eval configuration))
    (used : Syntax.Dependency.ticket binder ∈ configuration.expression.dependencies)
    (resolved : configuration.scope.resolve binder = some owner) :
    owner ∈ activeTickets configuration.stack := by
  cases source with
  | eval site phaseAgreement rooted bound annotation checked bounded => exact site.ticket_visible used resolved

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
