  have cutChecked : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) []
      (available (ownedTickets whole)) (annotateDisposals cutCertificate) (normalRow ++ certificateRow) :=
    .choice splitChecked certificate
  have cutBound : normalRow ++ certificateRow ⊆ certificateRow :=
    List.append_subset.mpr ⟨normalBound, List.Subset.refl _⟩
  refine ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    plans, resumeEffects, closeEffects, family, offered, advertised, bodies, chosen, certified,
    scopeSame, demandSame, saved, returns, declaration, offeredKnown, rowAvailable, familyKnown, exported,
    cutCertificate, normalRow ++ certificateRow, .alternatives .original splitSame,
    cutChecked, cutBound, .no .here, .yes .here, ?_⟩
  intro capAnnotated tailAnnotated capAnnotation tailAnnotation selectedPath suppliedDemand suppliedRequirements suppliedSource cleanupPath
  have unchanged : offered.dispose = true → annotateDisposals suppliedRequirements = suppliedRequirements :=
    fun permitted => (unwind_template_disposals (suppliedSource (unprotected permitted)).template).2
  obtain ⟨selectedRow, selectedCheck, selectedBound⟩ := (disposal_subtree_path selectedPath).checked cutChecked
  have suppliedCheck : ∃ selectedRow, RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) []
      (available (ownedTickets whole))
      (.sequence ((annotateDisposals capAnnotated).prepend (OwnerPhases.ofStack tables tail))
        (annotateDisposals tailAnnotated)) selectedRow ∧ selectedRow ⊆ certificateRow :=
    ⟨selectedRow, by simpa only [annotateDisposals, disposal_prepend, spendAll] using selectedCheck,
      selectedBound.trans cutBound⟩
  have generatedCleanup : offered.dispose = true → RequirementPath suppliedRequirements (annotateDisposals capAnnotated) [] := by
    intro permitted
    simpa only [unchanged permitted] using disposal_subtree_path (cleanupPath permitted)
  obtain ⟨capRow, tailRow, branchBound, closingDemand, closingRow, closingBalance, noClosing,
    nextDisposals, actualStore, allocationOrigin, allocationStore, closingLookup, guarded,
    actualAnnotation, actualResumeLookup, nextBound, sourceStore, nextResumes, nextClosing, closingRecords,
    nextSource, nextLocal, oldTailAnnotation, nextUse, nextTickets, nextResources, rawStep,
    ownedSame, nextUnique, afterBalance, phaseSame, capChecked, tailChecked, resumeChecked, interface, ordinaryClause⟩ :=
    finish (annotateDisposals capAnnotated) (annotateDisposals tailAnnotated)
