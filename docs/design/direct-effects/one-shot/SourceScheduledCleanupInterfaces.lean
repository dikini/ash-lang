/-- Register the actual authenticated callback and retain its exact latent rows
in the installed scope. Source, pending metadata, generated checks and the
lifetime event all use the same constructed action. -/
theorem RetainedState.register_cleanup
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.cleanup callback body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (isValue : callback.IsValue) (fresh : (issued ++ [Owner.cleanup identity]).Nodup) :
    ∃ action : ActionData,
      action.identity = identity ∧ action.action = callback ∧ action.scope = runtimeScope ∧
      RetainedState operations policy contracts tables families required outward annotations world ambient history
        resumes disposals annotatedStore budget ports owners emptyRows output outputRows
        ⟨⟨.eval ⟨body, runtimeScope, .push (.armed action) stack⟩,
          issued ++ [Owner.cleanup identity], completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    obtain ⟨ticket, typed⟩ := scopeTyped
    cases plan with
    | sequence initialPlan remainingPlan => cases remainingPlan with
      | cleanup callbackPlan bodyPlan =>
        rename_i callbackDependencies bodyDependencies requests
        rcases current with ⟨source, authenticated, localCheck, cleanupBudget, contextSource⟩
        cases authenticated with
        | cleanup callbackAuth bodyAuth =>
          rename_i latent initialDemand initialReq bodyDemand bodyReq admitted callbackRows callbackBodyRows callbackSource bodyRows bodySource
          have certificates :
              SourceAdmission.Code outward actions budget (available (ownedTickets stack)) world history
                bodyRows (.cleanup (needs := requests) latent callbackBodyRows context) ∧
              SourceAdmission.Code outward actions budget (available (ownedTickets stack)) world history
                callbackBodyRows (.normal context) := by
            cases currentCertificate with
            | sequence initial remaining =>
              cases remaining with
              | cleanup bodyCertificate callbackCertificate => exact ⟨bodyCertificate, callbackCertificate⟩
