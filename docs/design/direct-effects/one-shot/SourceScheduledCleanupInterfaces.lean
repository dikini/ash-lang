#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.requirement_remainder_generated


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Store)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)

/-- The allocator's concrete store is the generated image of an annotated raw
store when its predecessor and saved annotation are generated. Cleanup records
are unchanged by generation because they come from the lexical unwind source.
No successor check or successful cleanup is assumed. -/
theorem capture_generated_store
    (annotation : StoreAnnotation (resumes ++ disposals) entries)
    (savedAnnotation : RowAnnotation (saved : Requirements demand) savedAnnotated)
    (closing : captureProtected = false →
      SourceDependencyFrames.UnwindTemplate operations policy contracts tables world capture closeDemand closingRequirements)
    (allocated : nextStore = (⟨owner, .resume⟩, ⟨demand, annotateDisposals savedAnnotated⟩) ::
      ((annotateDisposalStore entries).take resumes.length ++
        ((if captureProtected then [] else [(⟨owner, .dispose⟩, ⟨closeDemand, closingRequirements⟩)]) ++
          (annotateDisposalStore entries).drop resumes.length))) :
    ∃ base : Store,
      StoreAnnotation (((⟨owner, .resume⟩, ⟨demand, saved⟩) :: resumes) ++
        (if captureProtected then disposals else (⟨owner, .dispose⟩, ⟨closeDemand, closingRequirements⟩) :: disposals)) base ∧
      nextStore = annotateDisposalStore base ∧
      RecursiveRequirements.lookup ⟨owner, .resume⟩ base = some ⟨demand, savedAnnotated⟩ := by
  obtain ⟨savedEntries, closingEntries, rfl, savedEntriesAnnotation, closingEntriesAnnotation⟩ := annotation.split
  have appendGeneration : ∀ first second : Store,
      annotateDisposalStore (first ++ second) = annotateDisposalStore first ++ annotateDisposalStore second := by
    intro first second
    induction first with
    | nil => rfl
    | cons head tail ih => cases head with | mk key body => cases body with
        | mk demand requirements => simpa only [List.cons_append, annotateDisposalStore] using congrArg (List.cons _) ih
  have lengths : ∀ {original annotated : Store}, StoreAnnotation original annotated → annotated.length = original.length := by
    intro original annotated source
    induction source with
    | nil => rfl
    | cons head tail ih => exact congrArg Nat.succ ih
  have savedLength := lengths (annotated_disposal_store savedEntriesAnnotation)
  let added : Store := if captureProtected then [] else [(⟨owner, .dispose⟩, ⟨closeDemand, closingRequirements⟩)]
  have addedSame : annotateDisposalStore added = added := by
    cases held : captureProtected with
    | true => simp only [added, held, if_true, annotateDisposalStore]
    | false => simp only [added, held, Bool.false_eq_true, if_false, annotateDisposalStore,
        (unwind_template_disposals (closing held)).2]
  let base : Store := (⟨owner, .resume⟩, ⟨demand, savedAnnotated⟩) ::
    (savedEntries ++ (added ++ closingEntries))
  have baseAnnotation : StoreAnnotation
      (((⟨owner, .resume⟩, ⟨demand, saved⟩) :: resumes) ++ (added ++ disposals)) base :=
    .cons savedAnnotation (savedEntriesAnnotation.append ((StoreAnnotation.refl added).append closingEntriesAnnotation))
  refine ⟨base, ?_, ?_, by simp only [base, RecursiveRequirements.lookup, if_true]⟩
  · cases held : captureProtected <;> simpa only [added, held, Bool.false_eq_true,
      if_false, if_true, List.nil_append, List.singleton_append] using baseAnnotation
  · rw [allocated]
    simp only [appendGeneration, ← savedLength, List.take_append_length, List.drop_append_length,
      base, annotateDisposalStore, addedSame, added]
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.capture_generated_store

