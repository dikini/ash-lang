/-- A supplied fresh identity opens the exact authenticated resource body and retains its ownership root. -/
theorem ExecutionSite.enter_resource_accounting
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows)
    (expressionEq : site.expression = .resource binder initializer body)
    (isValue : initializer.IsValue)
    (interpreted : Accounting.Run world history site.rows site.context (root : Requirements demand))
    (fresh : identity ∉ world) :
    ∃ payload answer,
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases (world ++ [identity]) history
      resumes budget ports owners emptyRows output outputRows,
      initializer = .integer payload ∧
      next.expression = body.instantiate (Instantiation.Environment.empty.bind binder identity) ∧
      next.runtimeScope = site.runtimeScope ∧
      next.stack = .push (.cell identity payload site.runtimeScope answer) site.stack ∧
      Accounting.Run (world ++ [identity]) history next.rows next.context root ∧
      (∀ annotations, Bound annotations site.receiving → Bound annotations next.receiving) ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [.resource identity] [] := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at expressionEq interpreted ⊢
  subst expression
  obtain ⟨ticket, typed⟩ := scopeTyped
  rcases current with ⟨current, currentCertificate⟩
  change CodeChecked ambient outward currentCertificate at currentResource
  change PendingChecked ambient outward retained at retainedResource
  have ready := ScopedPorts.typed_resource_closed
    (SourceTemplates.expression_ports (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
      (SourcePlannedSources.expression_erase current.source))) typed)
  cases plan with
  | sequence initialPlan remainingPlan => cases remainingPlan with
    | resource bodyPlans =>
      rcases current with ⟨source, authenticated, localCheck, cleanupBudget, contextSource⟩
      cases authenticated with
      | resource initialAuth bodyAuth =>
        rename_i bodyDemand initialDemand initialReq residual bodyReq outwardReq effectsBound hidden admitted formed
          initialRows initialSource bodyRows bodySource
        have resourceRun := (Accounting.silent_prefix_iff
          (SourceDependencyAnnotations.value_silent (SourcePlannedSources.expression_erase initialSource) isValue)
          initialRows (.resource bodyRows)).mp interpreted
        have bodyRun := resourceRun.enter_resource fresh
        obtain ⟨payload, initialSame⟩ := ScopedPorts.typed_integer_value
          (SourceTemplates.expression_ports (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase initialSource))) typed) isValue
        subst initializer
        cases initialPlan with
        | pure =>
          cases initialAuth
          cases certified with | sequence initialCertified bodyCertified =>
            cases bodyCertified with | resource bodyCertified =>
              have larger : world ⊆ world ++ [identity] := List.subset_append_left _ _
              let answer := ScopedPorts.embedPort result.erase.erase.port
              have noEscape : identity ∉ (ScopedPorts.eraseType answer).resources := by
                simpa only [answer, ScopedPorts.erase_embed_port] using (fun member => fresh (formed member))
              have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward (world ++ [identity])
                  (.cell identity payload runtimeScope answer) result result [] (.request [] []) (.cell identity) (fun rest => .cell rest)
                  (.cell identity :: residual) residual :=
                .cell ⟨_, ScopedPorts.effect_scope_has_types typed⟩ noEscape
                  (by simp only [answer, ScopedPorts.erase_embed_port]) (.cell ⟨_, typed⟩ noEscape)
              have frameRows : FrameRows operations policy contracts tables families required outward (world ++ [identity]) ports owners emptyRows
                  frame resultRows resultRows context (.cell (identity := identity) context) :=
                .cell (scopeKnown := ⟨_, ScopedPorts.effect_scope_has_types typed⟩) (noEscape := noEscape)
                  (annotation := by simp only [answer, ScopedPorts.erase_embed_port]) (interface := .cell ⟨_, typed⟩ noEscape)
              have nextCertificate : SourceAdmission.Code outward actions budget phases (world ++ [identity]) history
                  (bodyRows identity) (.cell (identity := identity) context) := by
                cases currentCertificate with
                | sequence initial resource =>
                  cases resource with | resource checkedBody => exact checkedBody identity fresh
              let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases
                  (world ++ [identity]) history resumes budget ports owners emptyRows output outputRows :=
                { expression := body.instantiate (Instantiation.Environment.empty.bind binder identity),
                  runtimeScope := runtimeScope, stack := .push (.cell identity payload runtimeScope answer) stack,
                  result := result, resultRows := resultRows, allowed := .cell identity :: residual,
                  dependencies := _, plan := bodyPlans identity, rows := bodyRows identity,
                  sourceDemand := bodyDemand, sourceRequirements := bodyReq identity,
                  receiving := .cell identity receiving, hints := .cell hints, context := .cell context,
                  current := SourceAdmission.Admitted.of_source (bodySource identity fresh) (bodyAuth identity fresh)
                    nextCertificate (.cell (contextSource.world_weaken larger)),
                  certified := bodyCertified identity fresh, scopeTyped := ⟨ticket, typed⟩,
                  pendingDemand := [] ++ pendingDemand,
                  pendingRequirements := .sequence
                    ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables stack)) pendingRequirements,
                  pending := .push (.ordinary frame) (pending.world_weaken larger),
                  coherent := .push (.ordinary frameRows) (coherent.world_weaken larger),
                  retained := .cell (retained.world_weaken larger),
                  currentResource := by
                    cases currentResource with | sequence _ remaining =>
                      cases remaining with | resource inside => exact inside identity fresh,
                  retainedResource := .cell (retainedResource.world_weaken larger) }
              exact ⟨payload, answer, next, rfl, rfl, rfl, rfl, bodyRun,
                (fun _ bound => .cell bound), .enterCell binder identity payload body runtimeScope answer stack ready⟩
        | request | invoke | sequence | choice | handler | cleanup | resource => cases initialSource
    | pure | request | invoke | sequence | choice | handler | cleanup => cases current.source
  | pure | request | invoke | choice | handler | cleanup | resource => cases current.source

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
