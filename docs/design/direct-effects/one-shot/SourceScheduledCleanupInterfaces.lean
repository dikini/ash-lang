/-- Registration retains the actual callback's latent source and the body's
recursive checks, with generated rows for the same installed cleanup frame. -/
theorem register_cleanup_planned_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.cleanup callback body) input currentDemand currentRequirements (signature plan))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value input) output pendingDemand pendingRequirements dependencyScope)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (isValue : callback.IsValue) (identity : Nat)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints stack)
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨.cleanup callback body, runtimeScope, stack⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.cleanup callback body, runtimeScope, stack⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨.cleanup callback body, runtimeScope, stack⟩)) :
    ∃ action : ActionData, ∃ bodyDemand, ∃ bodyRequirements : Requirements bodyDemand,
    ∃ nextRequirements : Requirements pendingDemand, ∃ bodyDependencies callbackDependencies,
    ∃ bodyPlan : Plan bodyDependencies,
    ∃ nextAnnotated : Requirements (bodyDemand ++ pendingDemand), ∃ nextRow,
      action.identity = identity ∧ action.action = callback ∧ action.scope = runtimeScope ∧ currentDemand = bodyDemand ∧
      SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
        body input bodyDemand bodyRequirements (signature bodyPlan) ∧
      Certified (evidence := declarationPolicy) outward world bodyPlan ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        (.push (.armed action) stack) (.value input) output pendingDemand nextRequirements
        (.cleanup action.requests callbackDependencies dependencyScope) ∧
      RowAnnotation
        (.sequence (bodyRequirements.prepend (OwnerPhases.ofStack tables (.push (.armed action) stack))) nextRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world bodyDependencies (.cleanup (needs := action.requests) (callback := callbackDependencies) hints) ∧
      Pending outward actions phases world (.cleanup (needs := action.requests) (callback := callbackDependencies) hints) .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families (.cleanup (needs := action.requests) (callback := callbackDependencies) hints) (.push (.armed action) stack) ∧
      Bound annotations (.cleanup action.requests callbackDependencies dependencyScope) ∧
      (∀ key stored, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world stack key stored →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world (.push (.armed action) stack) key stored) ∧
      (∀ key stored, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world stack key stored →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world (.push (.armed action) stack) key stored) ∧
      RawStep ⟨.cleanup callback body, runtimeScope, stack⟩ ⟨body, runtimeScope, .push (.armed action) stack⟩ [.cleanup identity] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨.cleanup callback body, runtimeScope, stack⟩)
        (.eval ⟨body, runtimeScope, .push (.armed action) stack⟩) [.cleanup identity] [] ∧
      ownedTickets (.push (.armed action) stack) = ownedTickets stack ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨body, runtimeScope, .push (.armed action) stack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨body, runtimeScope, .push (.armed action) stack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨body, runtimeScope, .push (.armed action) stack⟩) := by
  cases plan with
  | sequence initialPlan remainingPlan => cases remainingPlan with
    | cleanup callbackPlan bodyPlan => cases current with
      | cleanup callbackSource bodySource admitted =>
        rename_i requests latent initialDemand initialReq bodyDemand bodyReq
        have oldCallback := DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
          (SourcePlannedSources.expression_erase callbackSource))
        have empty := SourceTemplates.expression_value_demand oldCallback isValue
        subst initialDemand
        have summary := SourcePlannedSources.Values.change_allowed (SourcePlannedSources.value_summary callbackSource isValue) isValue []
        have ports := SourceTemplates.expression_ports
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase summary))) ScopedPorts.EffectScope.none
        have closed := ScopedPorts.typed_value_closed ports isValue
        let action : ActionData := ⟨identity, callback, closed, runtimeScope, ScopedPorts.embedPort input.erase.erase.port, requests⟩
        cases certified with | sequence initialCertified remainingCertified =>
          cases remainingCertified with | cleanup callbackCertified bodyCertified =>
            cases checked with | sequence initialCheck remainingCheck =>
              cases remainingCheck with | cleanup bodyCheck completion =>
                have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required
                    outward world (.armed action) input input [] (.request [] (qualify true latent))
                    (.cleanup requests _) (fun rest => .cleanup rest) allowed allowed :=
                  .armed ⟨_, ScopedPorts.effect_scope_has_types scopeTyped⟩ summary (by simp [action])
                    (.armed ⟨_, scopeTyped⟩ ports admitted) callbackCertified
                let nextReq := Requirements.sequence ((Requirements.request [] (qualify true latent)).prepend (OwnerPhases.ofStack tables stack)) pendingRequirements
                let nextRoot := Requirements.sequence (bodyReq.prepend (OwnerPhases.ofStack tables (.push (.armed action) stack))) nextReq
                have generated : evaluate entries receiving before (annotateDisposals nextRoot) =
                    evaluate entries receiving before (annotateDisposals
                      (.sequence ((Requirements.emitAfter (.sequence initialReq bodyReq) [] (qualify true latent)).prepend
                        (OwnerPhases.ofStack tables stack)) pendingRequirements)) := by
                  simp only [nextRoot, nextReq, annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                    RecursiveRequirements.evaluate_prepend, RecursiveRequirements.evaluate_emit,
                    SourcePlannedSources.template_value_disposals oldCallback isValue,
                    RecursiveRecomposition.value_evaluation oldCallback isValue,
                    RecursiveRecomposition.merge_empty_left, RecursiveContexts.evaluate_request, RecursiveEntries.armed_context,
                    List.nil_append, List.cons_append, spendAll, RecursiveContexts.evaluate_plain, merge_assoc]
                obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked rowChecked
                have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) normalRow :=
                  RecursiveRequirements.evaluate_sound (generated.trans (RecursiveRequirements.checked_complete normalCheck))
                have aligned : (bodyDemand ++ pendingDemand).Perm (([] ++ bodyDemand) ++ pendingDemand) := .refl _
                have step : RawStep ⟨.cleanup callback body, runtimeScope, stack⟩
                    ⟨body, runtimeScope, .push (.armed action) stack⟩ [.cleanup identity] [] := .enterCleanup action body stack
                have allocation : ∀ owner, Owner.ticket owner ∈ [Owner.cleanup identity] → actions owner = none := by simp
                have nextUse := LexicalUnwind.raw_computation_machine_use step trivial allocation usage
                have nextTickets := LexicalUnwind.raw_computation_machine_ticket_access step trivial allocation usage ticketAccess
                refine ⟨action, bodyDemand, bodyReq, nextReq, _, _, bodyPlan, .choice nextRoot annotated aligned,
                  normalRow ++ row, rfl, rfl, rfl, rfl, bodySource, bodyCertified, .push (.ordinary frame) pending,
                  .alternatives .original aligned, .no .here, .no .here, .choice nextCheck rowChecked,
                  List.append_subset.mpr ⟨within, List.Subset.refl _⟩, bodyCheck,
                  .cleanup (completion.reindex_scope
                    (congrArg SourceDependencyCapture.Scope.running (SourceDependencyProjection.scope_append_nil _)).symm
                    (SourceDependencyNeutral.Lexical.Recursive.running_congr (SourceDependencyProjection.scope_append_nil _)
                      (return_hints_append_nil hints) .normal).symm) retained,
                  .cleanup matching, .cleanup annotationBound, ?_, ?_, step, .evaluate step trivial, rfl, ?_, ?_, ?_⟩
                · intro key stored record; cases record with | resume located known recorded source answer =>
                    exact .resume (.push located) known recorded source answer
                · intro key stored record; cases record with | dispose located held recorded source =>
                    exact .dispose (.push located) held recorded source
                · simpa only [advanceUsageTickets] using nextUse
                · simpa only [advanceUsageTickets] using nextTickets
                · cases resourceAccess with | eval supported =>
                    exact .eval (raw_step_preserves_access step supported
                      (ScopedPortJoint.ordinary_access_checks (by simp [Code.IsValue]) (by simp) (by simp)))
    | pure | request | invoke | sequence | choice | handler | resource => cases current
  | pure | request | invoke | choice | handler | cleanup | resource => cases current
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
