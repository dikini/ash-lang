/-- Return across the actual cleanup-return marker, retaining the predecessor's checked
annotation and the exact source certificates in all surviving records. -/
theorem finish_planned_cleanup
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.unwinding action) rest) (.value .unit) output demand requirements scope)
    {hints : ReturnHints scope}
    (matching : ReturnHints.Matches tables families hints (.push (.unwinding action) rest))
    (pending : Pending outward actions (available (ownedTickets (.push (.unwinding action) rest))) world
      hints .nil .ordinary output.mode)
    (bound : Bound annotations scope)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.unwinding action) rest) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      UnwindAnnotated operations.erase policy contracts.erase tables families annotations world (.push (.unwinding action) rest) key body)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets (.push (.unwinding action) rest)))
      annotatedRoot certificateRow)
    (finite : SourceContextualRechecking.checkForest required (.push (.unwinding action) rest) scope .nil = true)
    (unique : (ownedTickets (.push (.unwinding action) rest)).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩))
    (resources : LexicalUnwind.MachineAccess ambient (.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩)) :
    ∃ nextScope, ∃ nextRequirements annotatedNext : Requirements demand,
    ∃ nextHints : ReturnHints nextScope, ∃ nextRow,
      scope = .running nextScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest
        .unwind output demand nextRequirements nextScope ∧
      ReturnHints.Matches tables families nextHints rest ∧
      Pending outward actions (available (ownedTickets rest)) world nextHints .nil .unwind output.mode ∧
      Bound annotations nextScope ∧
      RowAnnotation nextRequirements annotatedNext ∧
      RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets rest)) annotatedNext nextRow ∧
      nextRow ⊆ certificateRow ∧ RequirementPath annotatedRoot annotatedNext [] ∧
      demand.Perm (ownedTickets rest) ∧ (ownedTickets rest).Nodup ∧
      SourceContextualRechecking.checkForest required rest nextScope .nil = true ∧
      (∀ key body, (key, body) ∈ resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world rest key body) ∧
      (∀ key body, (key, body) ∈ disposals →
        UnwindAnnotated operations.erase policy contracts.erase tables families annotations world rest key body) ∧
      LexicalUnwind.UseTransition (.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩) (.unwind action.scope rest) [] [.cleanup action.identity] ∧
      LexicalUnwind.MachineUse policy actions (.unwind action.scope rest) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.unwind action.scope rest) ∧
      LexicalUnwind.MachineAccess ambient (.unwind action.scope rest) := by
  obtain ⟨normalRow, normalCheck, normalBound⟩ := annotation.checked checked
  obtain ⟨_, originalCheck, _⟩ := storeAnnotation.checked normalCheck
  have balance := SourceDependencySchemes.Lexical.mode_stack_ownership_balance source.erase
    (fun key body member => (records key body member).erase) closing unique originalCheck
  obtain ⟨nextScope, nextRequirements, scopeSame, nextSource, nextChecked⟩ := source.finish_cleanup normalCheck
  cases scopeSame
  cases matching with
  | running marker restMatch =>
    cases marker
    cases pending with
    | unwinding tailPending =>
      cases bound with
      | running tailBound =>
        let annotatedNext := Requirements.choice nextRequirements annotatedRoot (List.Perm.refl demand)
        have step : LexicalUnwind.UseTransition (.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩) (.unwind action.scope rest) [] [.cleanup action.identity] := .finishCleanup
        have location : ∀ key captured, SourceTemplates.CapturedIn key captured (.push (.unwinding action) rest) →
            SourceTemplates.CapturedIn key captured rest := by
          intro key captured located
          cases located with | push found => exact found
        refine ⟨nextScope, nextRequirements, annotatedNext, _, _, rfl, nextSource, restMatch,
          tailPending, tailBound, .alternatives .original (.refl _), .choice nextChecked checked,
          List.append_subset.mpr ⟨normalBound, List.Subset.refl _⟩, .no .here, balance, unique,
          ?_, ?_, ?_, step, ?_, ?_, ?_⟩
        · simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame, Bool.true_and] using finite
        · intro key body member
          exact (records key body member).transport (fun _ _ known => known) (fun _ _ known => known)
            (fun _ _ known => known) location
        · intro key body member
          exact (closing key body member).transport (fun _ _ known => known) (fun _ _ known => known)
            (List.Subset.refl _) location
        · simpa only [LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
            step.preserves (by intro owner member; cases member) unique usage
        · simpa only [LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
            step.ticket_access (by intro owner member; cases member) unique usage tickets
        · apply LexicalUnwind.transition_access step.erases resources
          constructor
          · intro identity payload answer savedScope scope value tail impossible
            cases impossible
          · intro requested operation operand scope whole cap tail handler impossible
            cases impossible

/-- Return across the actual closing-scope marker, retaining the predecessor's checked
annotation and the exact source certificates in all surviving records. -/
theorem finish_planned_close
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.closing identity caller) rest) .unwind output demand requirements scope)
    {hints : ReturnHints scope}
    (matching : ReturnHints.Matches tables families hints (.push (.closing identity caller) rest))
    (pending : Pending outward actions (available (ownedTickets (.push (.closing identity caller) rest))) world
      hints .nil .unwind output.mode)
    (bound : Bound annotations scope)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.closing identity caller) rest) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      UnwindAnnotated operations.erase policy contracts.erase tables families annotations world (.push (.closing identity caller) rest) key body)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets (.push (.closing identity caller) rest)))
      annotatedRoot certificateRow)
    (finite : SourceContextualRechecking.checkForest required (.push (.closing identity caller) rest) scope .nil = true)
    (unique : (ownedTickets (.push (.closing identity caller) rest)).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.unwind runtimeScope (.push (.closing identity caller) rest)))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope (.push (.closing identity caller) rest)))
    (resources : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope (.push (.closing identity caller) rest))) :
    ∃ nextScope, ∃ nextRequirements annotatedNext : Requirements demand,
    ∃ nextHints : ReturnHints nextScope, ∃ nextRow,
      scope = .running nextScope ∧ ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest
        (.value .unit) output demand nextRequirements nextScope ∧
      ReturnHints.Matches tables families nextHints rest ∧
      Pending outward actions (available (ownedTickets rest)) world nextHints .nil .ordinary output.mode ∧
      Bound annotations nextScope ∧
      RowAnnotation nextRequirements annotatedNext ∧
      RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets rest)) annotatedNext nextRow ∧
      nextRow ⊆ certificateRow ∧ RequirementPath annotatedRoot annotatedNext [] ∧
      demand.Perm (ownedTickets rest) ∧ (ownedTickets rest).Nodup ∧
      SourceContextualRechecking.checkForest required rest nextScope .nil = true ∧
      (∀ key body, (key, body) ∈ resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world rest key body) ∧
      (∀ key body, (key, body) ∈ disposals →
        UnwindAnnotated operations.erase policy contracts.erase tables families annotations world rest key body) ∧
      LexicalUnwind.UseTransition (.unwind runtimeScope (.push (.closing identity caller) rest)) (.eval ⟨.unit, caller, rest⟩) [] [.close identity] ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨.unit, caller, rest⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.unit, caller, rest⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨.unit, caller, rest⟩) := by
  obtain ⟨normalRow, normalCheck, normalBound⟩ := annotation.checked checked
  obtain ⟨_, originalCheck, _⟩ := storeAnnotation.checked normalCheck
  have balance := SourceDependencySchemes.Lexical.mode_stack_ownership_balance source.erase
    (fun key body member => (records key body member).erase) closing unique originalCheck
  obtain ⟨nextScope, nextRequirements, scopeSame, scopeKnown, nextSource, nextChecked⟩ := source.finish_close normalCheck
  cases scopeSame
  cases matching with
  | running marker restMatch =>
    cases marker
    cases pending with
    | closing tailPending =>
      cases bound with
      | running tailBound =>
        let annotatedNext := Requirements.choice nextRequirements annotatedRoot (List.Perm.refl demand)
        have step : LexicalUnwind.UseTransition (.unwind runtimeScope (.push (.closing identity caller) rest)) (.eval ⟨.unit, caller, rest⟩) [] [.close identity] := .finishClose
        have location : ∀ key captured, SourceTemplates.CapturedIn key captured (.push (.closing identity caller) rest) →
            SourceTemplates.CapturedIn key captured rest := by
          intro key captured located
          cases located with | push found => exact found
        refine ⟨nextScope, nextRequirements, annotatedNext, _, _, rfl, scopeKnown, nextSource, restMatch,
          tailPending, tailBound, .alternatives .original (.refl _), .choice nextChecked checked,
          List.append_subset.mpr ⟨normalBound, List.Subset.refl _⟩, .no .here, balance, unique,
          ?_, ?_, ?_, step, ?_, ?_, ?_⟩
        · simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame, Bool.true_and] using finite
        · intro key body member
          exact (records key body member).transport (fun _ _ known => known) (fun _ _ known => known)
            (fun _ _ known => known) location
        · intro key body member
          exact (closing key body member).transport (fun _ _ known => known) (fun _ _ known => known)
            (List.Subset.refl _) location
        · simpa only [LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
            step.preserves (by intro owner member; cases member) unique usage
        · simpa only [LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
            step.ticket_access (by intro owner member; cases member) unique usage tickets
        · exact LexicalUnwind.transition_access step.erases resources trivial

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
