/-- Reconstruct the physical resume successor at the supplied exact lexical cut.
Both caller modes are retained; cleanup existence comes from the current source
primitive, and no scalar resume lookup or successor check is supplied. -/
theorem RecordPendingRows.resume_physical_from_code
    {contract : SourcePlannedTyping.Contract} {known : contracts owner = some contract}
    {hints : ReturnHints scope} {context : Context hints}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail)) (.value contract.answer) output
      pendingDemand pendingRequirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source (.value (owners owner contract known).2) outputRows context)
    (same : context.pack = (frontContext.append
      (.live (owner := owner) (resumeDemand := resumeDemand) capturedContext tailContext)).pack)
    (frontRealized : Realizes tables families frontScope front)
    (located : OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩)
    (code : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .resume⟩)) context) :
    ∃ demand, ∃ requirements : Requirements demand,
    ∃ successor : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
      demand requirements (capturedScope.append (frontScope.append (.spent owner tailScope))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) successor
        (.value (owners owner contract known).1) outputRows
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) ∧
      SourceAdmission.Pending outward actions budget (spend phases owner) world installations
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext)))
        .nil .ordinary output.mode := by
  have scopeSame := congrArg Packed.scope same
  change scope = frontScope.append (.live owner capturedScope tailScope) at scopeSame
  have actualCut : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
      ⟨frontScope, capturedScope, tailScope⟩ := scopeSame ▸ located
  obtain ⟨budgeted, restored⟩ := (code.reindex_context same).resume_evidence_at actualCut
  have finalMode : hints.returnMode .ordinary = output.mode :=
    rows.forget.source.matching.return_mode.trans source.return_mode
  have originalMode := congrArg (fun p : Packed => p.hints.returnMode .ordinary) same
  change hints.returnMode .ordinary =
    (frontHints.append (.live (owner := owner) capturedHints tailHints)).returnMode .ordinary at originalMode
  rw [← originalMode, finalMode] at restored
  obtain ⟨middle, middleRows, frontDemand, tailDemand, frontRequirements, liveRequirements,
    frontSource, liveSource, frontRows, liveRows, _demandSame, _evaluation, _generated⟩ :=
    rows.split_disposals_at frontContext
      (.live (owner := owner) (resumeDemand := resumeDemand) capturedContext tailContext) same frontRealized
  cases returned : LexicalUnwind.returnMode captured .ordinary with
  | ordinary =>
      obtain ⟨demand, requirements, successor, nextRows⟩ :=
        frontRows.resume_physical_ordinary liveRows returned
      exact ⟨demand, requirements, successor, nextRows, restored⟩
  | unwind =>
      have physical := liveRows.forget.source
      cases physical with
      | live inside outside =>
          have sameMode := inside.matching.return_mode.trans returned
          change capturedHints.returnMode .ordinary = .unwind at sameMode
          rw [sameMode] at budgeted
          obtain ⟨metadata, closing⟩ := ResumeShape.unwind_iff.mp budgeted
          obtain ⟨demand, requirements, successor, nextRows⟩ :=
            frontRows.resume_physical_unwind liveRows closing returned
          exact ⟨demand, requirements, successor, nextRows, restored⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Code.resume_evidence_at
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_physical_from_code
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (spend)
open SourceDependencySchemes.Closing (Bound)

/-- A contextual resume constructs one actual successor with its finite check.
The restored source is taken from the physical capture, not a scalar lookup. -/
theorem ExecutionSite.resume_accounting_successor
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (expressionEq : site.expression = .resume binder operand)
    (closed : ClosedValue operand)
    (run : Accounting.Run world installations site.rows site.context (root : Requirements demand))
    (checked : Checked (annotateDisposalStore entries) receivingContext phases (annotateDisposals root) row) :
    ∃ owner, ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions
        (spend phases owner) world installations (RecursiveTransport.removeOwner owner resumes)
        budget ports owners emptyRows output outputRows,
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand,
      next.expression = operand ∧ next.runtimeScope = site.runtimeScope ∧
      ExecutionRoot operations policy contracts tables families required outward actions
        (spend phases owner) world installations (RecursiveTransport.removeOwner owner resumes)
        budget ports owners emptyRows output outputRows next nextRoot ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner entries)) receivingContext
        (spend phases owner) (annotateDisposals nextRoot) row ∧
      demand = owner :: nextDemand ∧
      (∀ annotations, Bound annotations site.receiving → Bound annotations next.receiving) ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [.ticket owner] := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at expressionEq run ⊢
  subst expression
  obtain ⟨owner, contract, known, resolved, resultSame, resultRowsSame, primitiveRun⟩ :=
    current.previous.authenticated.ready_resume_accounting rfl closed.1 run
  subst result
  cases eq_of_heq resultRowsSame
  have primitive := SourceAdmission.Code.ready_resume current.previous.authenticated resolved current.certificate
  have primitiveResource : CodeChecked ambient outward primitive := by
    obtain ⟨actualOwner, actualContract, actualKnown, actualResolved, _, _, actualPrimitive, resource⟩ :=
      checked_resume_origin current.previous.authenticated rfl currentResource
    have same : actualOwner = owner := Option.some.inj (actualResolved.symm.trans resolved)
    subst actualOwner
    exact resource.reproof
  obtain ⟨⟨frontScope, frontHints, frontContext⟩, ⟨capturedScope, capturedHints, capturedContext⟩,
    ⟨tailScope, tailHints, tailContext⟩, resumeDemand, nextDemand, nextRoot,
    contextEq, cut, demandEq, waiting, nextCheck⟩ := primitiveRun.resume_accounting checked
  have scopeEq := congrArg Packed.scope contextEq
  change receiving = frontScope.append (.live owner capturedScope tailScope) at scopeEq
  have resourceCut : SourceDependencyCapture.OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩ :=
    scopeEq ▸ cut
  obtain ⟨front, physicalTail, middle, middleRows, frontDemand, tailDemand,
    frontRequirements, tailRequirements, frontSource, tailSource,
    stackEq, frontRows, tailRows, _sourceDemand, _evaluation, _generated⟩ :=
    coherent.split_disposals frontContext
      (.live (owner := owner) (resumeDemand := resumeDemand) capturedContext tailContext) contextEq
  have physical := tailRows.forget.source
  cases physical with
  | live savedSource outsideSource =>
    rename_i captured tail inputType answerType caller
    subst stack
    obtain ⟨newDemand, newRequirements, newPending, newCoherent, newRetained⟩ :=
      coherent.resume_physical_from_code (known := known) contextEq
        frontRows.forget.source.matching.erases cut primitive
    obtain ⟨summary, operandAuth⟩ := current.previous.authenticated.resume_operand_summary
      rfl resolved known closed
    let source := SourcePlannedSources.Values.change_context summary closed.1 [] runtimeScope
    have authenticated := operandAuth.value_context closed.1 [] runtimeScope
    let next : ExecutionSite ambient operations policy contracts tables families required outward actions
        (spend phases owner) world installations (RecursiveTransport.removeOwner owner resumes)
        budget ports owners emptyRows output outputRows :=
      { expression := operand, runtimeScope := runtimeScope,
        stack := captured.append (front.append (.spent owner answerType caller tail)),
        result := contract.input, resultRows := (owners owner contract known).1,
        allowed := [], dependencies := .pure, plan := .pure, rows := .pure,
        sourceDemand := [], sourceRequirements := .request [] [],
        receiving := capturedScope.append (frontScope.append (.spent owner tailScope)),
        hints := capturedHints.append (frontHints.append (.spent tailHints)),
        context := capturedContext.append (frontContext.append (.spent (owner := owner) tailContext)),
        current := SourceAdmission.Admitted.of_source source authenticated .pure newCoherent.forget.source,
        certified := .pure (evidence := declarationPolicy), scopeTyped := scopeTyped,
        pendingDemand := newDemand, pendingRequirements := newRequirements, pending := newPending,
        coherent := newCoherent, retained := newRetained, currentResource := .pure,
        retainedResource := (((primitiveResource.reindex_context contextEq).resume_pending_at
          resourceCut).output_mode
            (retained.reindex_context contextEq).return_mode).reproof }
    refine ⟨owner, next, nextDemand, nextRoot, rfl, rfl, .contextualValue closed.1 waiting,
      nextCheck, demandEq, ?_, ?_⟩
    · intro annotations bound
      exact (bound.invocations cut).1
    · exact .resume binder owner runtimeScope caller inputType answerType front captured tail operand closed resolved

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.resume_accounting_successor

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Store Checked)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open SourceDependencySchemes.Closing (Bound)
open OwnerPhaseTransitions (available)

/-- The replacement common source invariant checks an executable root, rather
than current syntax followed by an unconditionally ordinary caller. The old
forest checker is not an admission premise for this source judgment. -/
inductive ExecutableSource (ambient : List Nat)
    (operations : SourcePlannedTyping.Operations) (policy : Syntax.TicketPolicy)
    (contracts : SourcePlannedTyping.Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (actions : Syntax.UsageTickets)
    (annotations : Nat → Option SourceDependencyCapture.Scope)
    (world installations : List Nat) (resumes annotatedStore : Store) (budget : Footprint)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none))
    (output : PlannedModeValue) (outputRows : ModeRowsValue output) : LexicalUnwind.Machine → Prop where
  | eval
      (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows)
      (phaseAgreement : phases = available (ownedTickets site.stack))
      (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
        resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
      (bound : Bound annotations site.receiving)
      (annotation : RowAnnotation root annotated)
      (checked : Checked (annotateDisposalStore annotatedStore) [] phases (annotateDisposals annotated) row)
      (bounded : row ⊆ budget) :
      ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
        resumes annotatedStore budget ports owners emptyRows output outputRows
        (.eval ⟨site.expression, site.runtimeScope, site.stack⟩)
  | unwind {hints : ReturnHints receiving} {context : Context hints}
      (pending : PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind output demand requirements receiving)
      (coherent : RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows resumes pending .unwind outputRows context)
      (certificate : SourceAdmission.Pending outward actions budget (available (ownedTickets stack)) world installations
        context .nil .unwind output.mode)
      (waiting : Accounting.Wait world installations context .unwind (root : Requirements rootDemand))
      (bound : Bound annotations receiving)
      (annotation : RowAnnotation root annotated)
      (checked : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
        (annotateDisposals annotated) row)
      (bounded : row ⊆ budget)
      (resourceChecked : InstallationSupport.PendingChecked ambient outward certificate) :
      ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
        resumes annotatedStore budget ports owners emptyRows output outputRows (.unwind runtimeScope stack)

/-- Common machine evidence for the executable source judgment. Ownership/use
accounting comes from its checked root; the lifetime ledger and registry history
remain independent. Lexical ticket access derives from source; no separate
raw-code consumption witness or legacy MachineUse conjunct is required. -/
structure ExecutableState
    (operations : SourcePlannedTyping.Operations) (policy : Syntax.TicketPolicy)
    (contracts : SourcePlannedTyping.Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (annotations : Nat → Option SourceDependencyCapture.Scope)
    (world ambient history : List Nat) (resumes disposals annotatedStore : Store) (budget : Footprint)
    (ports : OperationRows operations) (owners : ContractRows contracts)
    (emptyRows : EnvironmentRows (fun _ => none))
    (output : PlannedModeValue) (outputRows : ModeRowsValue output) (run : LexicalUnwind.UseRunState) : Prop where
  source : ExecutableSource ambient operations policy contracts tables families required outward run.tickets annotations world history
    resumes annotatedStore budget ports owners emptyRows output outputRows run.execution.machine
  resumeRecords : ∀ key body, (key, body) ∈ resumes →
    PlannedResumeAnnotated operations policy contracts tables families required outward run.tickets annotations world run.execution.machine.stack key body
  unwindRecords : ∀ key body, (key, body) ∈ disposals →
    PlannedUnwindAnnotated operations policy contracts tables families required outward run.tickets annotations world run.execution.machine.stack key body
  storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore
  ledger : Ledger run.execution.erase
  registry : UsageRegistryHistory run.tickets run.execution.issued
  resources : LexicalUnwind.MachineAccess ambient run.execution.machine
  activations : run.execution.machine.stack.erase.activations ⊆ history
  issuedResources : ScopedTyping.resourceWorld run.execution.issued ⊆ world
  ticketHistory : LexicalUnwind.TicketHistory run.execution
  captureMetadata : CaptureMetadataHistory contracts annotations run.execution.issued

/-- Focus preserves the corrected common state and the identical executable root.
The proof reuses physical access/ledger transport without old use accounting. -/
theorem ExecutableState.focus
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨whole, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (position : Focus whole child evaluationContext) :
    ∃ plain : PlainData, plain.context = evaluationContext ∧ plain.scope = runtimeScope ∧
      ExecutableState operations policy contracts tables families required outward annotations world ambient history
        resumes disposals annotatedStore budget ports owners emptyRows output outputRows
        ⟨⟨.eval ⟨child, runtimeScope, .push (.plain plain) stack⟩, issued, completed⟩, actions⟩ := by
  have source := state.source
  dsimp only at source
  generalize machineEq : LexicalUnwind.Machine.eval ⟨whole, runtimeScope, stack⟩ = machine at source
  cases source with
  | eval site phaseAgreement rooted bound annotation checked bounded =>
      have fields := LexicalUnwind.Machine.eval.inj machineEq
      obtain ⟨rfl, rfl, rfl⟩ := ScopedExecution.Configuration.mk.inj fields
      obtain ⟨rootRow, rootCheck, _included⟩ := (disposal_annotation_map annotation).checked checked
      obtain ⟨next, focused, nextRoot, _nextRootCheck⟩ := rooted.focus_step position rootCheck
      obtain ⟨_, plain, contextSame, scopeSame, expressionSame, runtimeSame, stackSame, raw,
        restDependencies, restPlan, restRows, _split, receiverSame, _restCheck⟩ := focused
      have ownersSame : ownedTickets next.stack = ownedTickets site.stack := by rw [stackSame]; rfl
      have nextPhase : _ = available (ownedTickets next.stack) := phaseAgreement.trans (congrArg available ownersSame.symm)
      have nextBound : Bound annotations next.receiving := by
        have same := congrArg Packed.scope receiverSame
        change next.receiving = .plain restDependencies site.receiving at same
        rw [same]
        exact .plain bound
      have transition : LexicalUnwind.UseTransition
          (.eval ⟨site.expression, site.runtimeScope, site.stack⟩)
          (.eval ⟨next.expression, next.runtimeScope, next.stack⟩) [] [] :=
        .evaluate raw (LexicalUnwind.focus_computation_head position)
      have event : LexicalUnwind.Event
          ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩
          ⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, completed⟩ := by
        simpa only [List.append_nil, List.nil_append] using
          (LexicalUnwind.Event.step (before := ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩)
            transition.erases (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
      have nextState : ExecutableState operations policy contracts tables families required outward annotations world ambient history
          resumes disposals annotatedStore budget ports owners emptyRows output outputRows
          ⟨⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, completed⟩, actions⟩ := by
        refine ⟨.eval next nextPhase nextRoot nextBound annotation checked bounded, ?_, ?_, state.storeAnnotation,
          LexicalUnwind.event_preserves_ledger event state.ledger, state.registry, ?_, ?_, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
        · change ∀ key body, (key, body) ∈ resumes →
            PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world next.stack key body
          rw [stackSame]
          intro key body member
          cases state.resumeRecords key body member with
          | resume located known recorded source answer => exact .resume (.push located) known recorded source answer
        · change ∀ key body, (key, body) ∈ disposals →
            PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world next.stack key body
          rw [stackSame]
          intro key body member
          cases state.unwindRecords key body member with
          | dispose located held recorded source => exact .dispose (.push located) held recorded source
        · cases state.resources with
          | eval supported => exact .eval (ScopedExecution.raw_step_preserves_access raw supported (ScopedPortJoint.focus_access_checks position))
        · change next.stack.erase.activations ⊆ history
          rw [stackSame]
          exact state.activations
      exact ⟨plain, contextSame, scopeSame, by simpa only [expressionSame, runtimeSame, stackSame] using nextState⟩

  | unwind => cases machineEq

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.focus

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (available spend)

private theorem resume_raw_parts
    (raw : RawStep ⟨.resume binder operand, scope, before⟩ after [] [.ticket owner]) :
    ∃ front captured tail inputType answerType caller,
      before = Stack.append front (.live owner inputType answerType captured caller tail) ∧
      after = ⟨operand, scope, captured.append (front.append (.spent owner answerType caller tail))⟩ ∧
      ClosedValue operand ∧ scope.resolve binder = some owner := by
  cases raw with
  | resume => exact ⟨_, _, _, _, _, _, rfl, rfl, by assumption, by assumption⟩

/-- Resume's operational fields depend on the actual raw step and reconstructed
source, independently of which executable-root interpretation supplied it. -/
theorem ExecutableState.resume_from_site
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows (.value terminal) outputRows}
    {next : ExecutionSite ambient operations policy contracts tables families required outward actions (spend phases owner)
      world history (RecursiveTransport.removeOwner owner resumes) budget ports owners emptyRows (.value terminal) outputRows}
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows (.value terminal) outputRows
      ⟨⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩, actions⟩)
    (expression : site.expression = .resume binder operand)
    (raw : RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
      ⟨next.expression, next.runtimeScope, next.stack⟩ [] [.ticket owner])
    (phaseAgreement : phases = available (ownedTickets site.stack))
    (nextBound : Bound annotations next.receiving)
    {root : Requirements demand}
    (nextRoot : ExecutionRoot operations policy contracts tables families required outward actions (spend phases owner)
      world history (RecursiveTransport.removeOwner owner resumes) budget ports owners emptyRows (.value terminal) outputRows next root)
    (nextChecked : Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) []
      (spend phases owner) (annotateDisposals root) row)
    (bounded : row ⊆ budget) :
    LexicalUnwind.Event
      ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩
      ⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, .ticket owner :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner disposals)
      (RecursiveTransport.removeOwner owner annotatedStore) budget ports owners emptyRows (.value terminal) outputRows
      ⟨⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, .ticket owner :: completed⟩, actions⟩ := by
  have actualRaw := raw
  rw [expression] at actualRaw
  obtain ⟨front, captured, tail, inputType, answerType, caller, beforeStack, after, closed, resolved⟩ :=
    resume_raw_parts actualRaw
  obtain ⟨expressionSame, scopeSame, stackSame⟩ := Configuration.mk.inj after
  have unique : (ownedTickets site.stack).Nodup :=
    owned_tickets_unique (ledger_unique_live state.ledger)
  have nextPhase : spend phases owner = available (ownedTickets next.stack) := by
    have actualUnique : (ownedTickets (front.append
        (.live owner inputType answerType captured caller tail))).Nodup := by
      simpa only [beforeStack] using unique
    have actual := OwnerPhaseTransitions.trace_result (OwnerPhaseTransitions.resume_phase_trace actualUnique)
    change available (ownedTickets (captured.append
      (front.append (.spent owner answerType caller tail)))) =
      spend (available (ownedTickets (front.append
        (.live owner inputType answerType captured caller tail)))) owner at actual
    simpa only [phaseAgreement, stackSame, beforeStack] using actual.symm
  have ledger := state.ledger
  rw [expression, beforeStack] at ledger
  obtain ⟨event, nextLedger, nextRegistry⟩ :=
    LexicalUnwind.ready_resume_ledger_registry ledger state.registry closed resolved
  have finalEvent : LexicalUnwind.Event
      ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩
      ⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, .ticket owner :: completed⟩ := by
    simpa only [expression, beforeStack, expressionSame, scopeSame, stackSame] using event
  have nextState : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner disposals)
      (RecursiveTransport.removeOwner owner annotatedStore) budget ports owners emptyRows (.value terminal) outputRows
      ⟨⟨.eval ⟨next.expression, next.runtimeScope, next.stack⟩, issued, .ticket owner :: completed⟩, actions⟩ := by
    refine ⟨.eval next nextPhase nextRoot nextBound .original nextChecked bounded,
      ?_, ?_, ?_, ?_, nextRegistry, ?_, ?_, state.issuedResources, finalEvent.ticket_history state.ticketHistory, state.captureMetadata⟩
    · change ∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world next.stack key body
      rw [stackSame]
      apply planned_resume_records_resume
      simpa only [LexicalUnwind.Machine.stack, beforeStack] using state.resumeRecords
    · change ∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner disposals →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world next.stack key body
      rw [stackSame]
      apply planned_unwind_records_resume
      simpa only [LexicalUnwind.Machine.stack, beforeStack] using state.unwindRecords
    · simpa only [RecursiveConsumption.remove_owner_append] using state.storeAnnotation.remove_owner owner
    · simpa only [expressionSame, scopeSame, stackSame] using nextLedger
    · cases state.resources with
      | eval supported =>
          exact .eval (raw_step_preserves_access raw supported (by
            rw [expression]
            exact ScopedPorts.resume_access_checks))
    · change next.stack.erase.activations ⊆ history
      rw [stackSame]
      intro activation member
      apply state.activations
      change activation ∈ site.stack.erase.activations
      rw [beforeStack]
      simp only [erase_append, Stack.erase, activations_append, Control.activations, List.mem_append] at member ⊢
      rcases member with member | member | member
      · exact Or.inr (Or.inl member)
      · exact Or.inl member
      · exact Or.inr (Or.inr member)
  exact ⟨finalEvent, nextState⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.resume_from_site

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation)
open SourceDependencySchemes.Closing (Bound)
open OwnerPhaseTransitions (available spend)


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)

/-- A ready resume extracts its selected fragments from the retained executable
root. Values and enclosing focus cannot describe this ready expression. -/
theorem ExecutionRoot.ready_resume
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (expression : site.expression = .resume binder operand)
    (value : operand.IsValue) :
    Accounting.Run world installations site.rows site.context root := by
  cases rooted with
  | contextual interpreted => exact interpreted
  | branch selected inside =>
      have branch := selected.1
      rw [expression] at branch
      cases branch
  | focus focused inside =>
      have focus := focused.1
      rw [expression] at focus
      cases focus with
      | resume notValue => exact False.elim (notValue value)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.ready_resume

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport

/-- An authenticated common state at a ready resume constructs its actual
successor and preserves all common fields. Selected source fragments and their
checks are extracted from the predecessor; none are extra premises. -/
theorem ExecutableState.resume_successor
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows (.value terminal) outputRows
      ⟨⟨.eval ⟨.resume binder operand, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue operand) :
    ∃ owner nextStack,
      LexicalUnwind.Event
        ⟨.eval ⟨.resume binder operand, runtimeScope, stack⟩, issued, completed⟩
        ⟨.eval ⟨operand, runtimeScope, nextStack⟩, issued, .ticket owner :: completed⟩ ∧
      ExecutableState operations policy contracts tables families required outward annotations world ambient history
        (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner disposals)
        (RecursiveTransport.removeOwner owner annotatedStore) budget ports owners emptyRows (.value terminal) outputRows
        ⟨⟨.eval ⟨operand, runtimeScope, nextStack⟩, issued, .ticket owner :: completed⟩, actions⟩ := by
  have source := state.source
  dsimp only at source
  generalize machineEq : LexicalUnwind.Machine.eval ⟨.resume binder operand, runtimeScope, stack⟩ = machine at source
  cases source with
  | eval site phaseAgreement rooted bound annotation checked bounded =>
      obtain ⟨expression, runtime, stackSame⟩ := ScopedExecution.Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
      have actualState : ExecutableState operations policy contracts tables families required outward annotations world ambient history
          resumes disposals annotatedStore budget ports owners emptyRows (.value terminal) outputRows
          ⟨⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩, actions⟩ := by
        simpa only [← expression, ← runtime, ← stackSame] using state
      have interpreted := rooted.ready_resume expression.symm closed.1
      obtain ⟨rootRow, rootCheck, rootIncluded⟩ := (disposal_annotation_map annotation).checked checked
      obtain ⟨owner, next, nextDemand, nextRoot, nextExpression, nextScope,
        nextRooted, nextChecked, _demand, nextBound, raw⟩ :=
        site.resume_accounting_successor expression.symm closed interpreted rootCheck
      obtain ⟨event, after⟩ := actualState.resume_from_site expression.symm raw phaseAgreement
        (nextBound annotations bound) nextRooted nextChecked (rootIncluded.trans bounded)
      refine ⟨owner, next.stack, ?_, ?_⟩
      · simpa only [nextExpression, nextScope, ← expression, ← runtime, ← stackSame] using event
      · simpa only [nextExpression, nextScope, ← runtime] using after
  | unwind => cases machineEq


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.resume_successor

namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Lexical discard creates its close boundary and preserves lifetime history;
continuation-use accounting belongs to the independently checked source. -/
theorem ready_discard_ledger_registry
    {front captured tail : Stack}
    (ledger : Ledger (RunState.erase
      ⟨.eval ⟨.discard binder, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩))
    (history : UsageRegistryHistory tickets issued)
    (resolved : runtimeScope.resolve binder = some owner)
    (unprotected : ProtectionContexts.protectedMode captured.erase = false)
    (fresh : Owner.close identity ∉ issued) :
    Event
      ⟨.eval ⟨.discard binder, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩
      ⟨.unwind runtimeScope (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answer caller tail)))),
        issued ++ [.close identity], .ticket owner :: completed⟩ ∧
    Ledger (RunState.erase
      ⟨.unwind runtimeScope (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answer caller tail)))),
        issued ++ [.close identity], .ticket owner :: completed⟩) ∧
    UsageRegistryHistory tickets (issued ++ [.close identity]) := by
  have step : Transition
      (.eval ⟨.discard binder, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩)
      (.unwind runtimeScope (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answer caller tail)))))
      [.close identity] [.ticket owner] :=
    .discard binder owner identity runtimeScope caller input answer front captured tail resolved unprotected
  have freshIssued : (issued ++ [Owner.close identity]).Nodup := by
    rw [List.nodup_append]
    refine ⟨ledger.2, by simp, ?_⟩
    intro item member other otherMember same
    have otherSame : other = Owner.close identity := by simpa using otherMember
    exact fresh ((same.trans otherSame) ▸ member)
  have event : Event
      ⟨.eval ⟨.discard binder, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩
      ⟨.unwind runtimeScope (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answer caller tail)))),
        issued ++ [.close identity], .ticket owner :: completed⟩ := by
    simpa only [List.singleton_append] using
      (Event.step (before := ⟨.eval ⟨.discard binder, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩)
        step freshIssued)
  refine ⟨event, event_preserves_ledger event ledger, ?_⟩
  intro ticket
  simpa using history ticket

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.LexicalUnwind.ready_discard_ledger_registry

