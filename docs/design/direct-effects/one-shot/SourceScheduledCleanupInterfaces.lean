        (ownedTickets nextStack).Nodup ∧
        ((owner :: capDemand) ++ tailDemand).Perm (ownedTickets nextStack) ∧
        spend (available (ownedTickets nextStack)) owner = available (ownedTickets whole) ∧
        RecursiveRequirements.Checked (annotateDisposalStore nextStore) (OwnerPhases.ofStack tables tail)
          (available (ownedTickets whole)) (annotateDisposals capAnnotated) capRow ∧
        RecursiveRequirements.Checked (annotateDisposalStore nextStore) []
          (spendAll (available (ownedTickets whole)) capDemand) (annotateDisposals tailAnnotated) tailRow ∧
        RecursiveRequirements.Checked (annotateDisposalStore nextStore) (OwnerPhases.ofStack tables nextStack)
          (available (ownedTickets nextStack)) (.invoke ⟨owner, .resume⟩ capDemand []) capRow ∧
        ClauseRowAdmission.Interface owner contract.erase offered.dispose (annotateDisposalStore nextStore)
          (OwnerPhases.ofStack tables tail) (available (ownedTickets nextStack)) requestRow := by
  obtain ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    plans, resumeEffects, closeEffects, family, offered, advertised, bodies, chosen, certified,
    scopeSame, demandSame, saved, returns, declaration, offeredKnown, rowAvailable, familyKnown, exported,
    unprotected, generatedEvaluation, oldCut, oldCutRow, oldCutAnnotation, oldCutChecked, oldCutBound, oldRootPath, oldSplitPath, finish⟩ :=
    capture_planned_allocation_with_protected_store cut current source hinted pendingLocal usage ticketAccess resourceAccess
      operandSupport operandBoundary selected isValue fresh freshAction absent bound freshAnnotation
      recorded closing closingRecorded unique (annotated_disposal_store storeAnnotation)
      (annotated_disposals annotation) certificate currentCheck currentLocal finite
  obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked certificate
  have splitSame : (capDemand ++ tailDemand).Perm demand := by rw [demandSame]
  let split := Requirements.sequence (capReq.prepend (OwnerPhases.ofStack tables tail)) tailReq
  have splitChecked : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) []
      (available (ownedTickets whole)) (annotateDisposals split) normalRow := by
    apply RecursiveRequirements.evaluate_sound
    simpa only [split, annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
      RecursiveRequirements.evaluate_prepend, List.append_nil] using
      (generatedEvaluation (annotateDisposalStore annotatedStore) [] (available (ownedTickets whole))).symm.trans
