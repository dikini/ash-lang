namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements evaluate)
open SourcePlannedTyping (Value Environment Operations Contracts)
open SourcePlanSignatures (Signature)

/-- Widen only the ambient allowed-effect bound. Latent lambda, handler clause
and resource-body bounds retain their original authenticated derivations. -/
theorem Auth.allowed_mono
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (more : allowed ⊆ destination) :
    Auth operations policy ports owners environmentRows
      (SourcePlannedSources.expression_allowed_mono source more) valueRows rows := by
  induction checked using Auth.rec
      (motive_2 := fun {_} _ {_ _ _ _} _ {_ _} _ {_ _ _} _ _ _ => True)
      (motive_3 := fun {_} _ {_ _} _ {_ _ _ _} _ {_} _ {_} _ {_ _ _ _ _ _ _ _} _ _ _ => True)
      (motive_4 := fun {_} _ {_ _} _ {_ _ _} _ {_ _ _ _} _ _ _ => True)
      generalizing destination with
  | unit => exact .unit
  | boolean => exact .boolean
  | integer => exact .integer
  | reference => exact Auth.reference (issued := by assumption)
  | «variable» => exact Auth.variable (known := by assumption) (formed := by assumption)
  | lambda body captured ih => exact Auth.lambda body captured (outward := by assumption) (formed := by assumption) (latentBound := by assumption)
  | purePair left right ihLeft ihRight => exact .purePair (ihLeft more) (ihRight more)
  | pair left right ihLeft ihRight => exact .pair (ihLeft more) (ihRight more)
  | app function argument ihFunction ihArgument =>
      exact Auth.app (ihFunction more) (ihArgument more) (admitted := List.Subset.trans (by assumption) more)
  | bind initializer body ihInit ihBody => exact .bind (ihInit more) (ihBody more)
  | branch condition yes no ihCondition ihYes ihNo =>
      exact Auth.branch (ihCondition more) (ihYes more) (ihNo more) (same := by assumption)
  | perform operand ih =>
      exact Auth.perform (ih more) (known := by assumption) (admitted := more (by assumption)) (formed := by assumption)
  | handler body declarations ihBody ihDecl =>
      exact Auth.handler body declarations (clauses := by assumption) (capabilities := by assumption)
        (coverage := by assumption) (unique := by assumption) (admitted := List.Subset.trans (by assumption) more) (modes := by assumption)
  | resume operand ih =>
      exact Auth.resume (ih more) (known := by assumption) (resolved := by assumption) (permission := by assumption)
        (admitted := List.Subset.trans (by assumption) more) (formed := by assumption)
  | discard =>
      exact Auth.discard (known := by assumption) (resolved := by assumption) (permission := by assumption)
        (unprotected := by assumption) (admitted := List.Subset.trans (by assumption) more)
  | cleanup callback body ihCallback ihBody =>
      exact Auth.cleanup (ihCallback more) (ihBody more) (admitted := List.Subset.trans (by assumption) more)
  | resource initializer body ihInit ihBody =>
      exact Auth.resource (ihInit more) body (formed := by assumption) (effectsBound := by assumption)
        (admitted := List.Subset.trans (by assumption) more) (hidden := by assumption)
  | typed | unavailable | available | nil | cons => trivial

/-- Bind keeps the authenticated suffix rows and result decoration while
reusing the existing exact requirement-evaluation equality. -/
theorem Auth.bind_expression
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {initialSignature : Signature initialDependencies} {bodySignature : Signature bodyDependencies}
    {initialRows : Rows initialSignature} {bodyRows : Rows bodySignature}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        (.bind parameter value body) result demand requirements (.sequence initialSignature bodySignature)}
    (checked : Auth operations policy ports owners environmentRows source
      resultRows (.sequence initialRows bodyRows))
    (closed : ClosedValue value) :
    ∃ reduced, ∃ next : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (body.subst parameter value) result demand reduced bodySignature,
      Auth operations policy ports owners environmentRows next resultRows bodyRows ∧
      ∀ store receiving before, evaluate store receiving before reduced = evaluate store receiving before requirements := by
  cases checked with
  | bind initializerChecked bodyChecked =>
      rename_i initialSource bodySource
      have empty := SourceTemplates.expression_value_demand
        (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
          (SourcePlannedSources.expression_erase initialSource))) closed.1
      subst_vars
      have replaced := Auth.substitution bodyChecked (initializerChecked.value_summary closed.1) closed
      refine ⟨_, _, replaced, ?_⟩
      intro store receiving before
      rw [RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.value_evaluation
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase initialSource))) closed.1]
      simp only [OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left]

/-- Beta retains the exact body rows at the original ambient allowed effects,
using authenticated substitution and allowed-effect weakening. -/
theorem Auth.beta_expression
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {functionSignature : Signature functionDependencies} {argumentSignature : Signature argumentDependencies}
    {bodySignature : Signature bodyDependencies}
    {functionRows : Rows functionSignature} {argumentRows : Rows argumentSignature} {bodyRows : Rows bodySignature}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        (.app (.lambda parameter body) value) result demand requirements
        (.sequence functionSignature (.sequence argumentSignature bodySignature))}
    (checked : Auth operations policy ports owners environmentRows source
      resultRows (.sequence functionRows (.sequence argumentRows bodyRows)))
    (closed : ClosedValue value) :
    ∃ reduced, ∃ next : SourcePlannedSources.Expression operations policy contracts world allowed .none environment
      (body.subst parameter value) result demand reduced bodySignature,
      Auth operations policy ports owners environmentRows next resultRows bodyRows ∧
      ∀ store receiving before, evaluate store receiving before reduced = evaluate store receiving before requirements := by
  cases checked with
  | app functionChecked argumentChecked =>
      rename_i input requests latent functionDemand functionReq argumentDemand argumentReq inputRows admitted argumentSource functionSource
      have functionEmpty := SourceTemplates.expression_value_demand
        (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
          (SourcePlannedSources.expression_erase functionSource))) trivial
      have argumentEmpty := SourceTemplates.expression_value_demand
        (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
          (SourcePlannedSources.expression_erase argumentSource))) closed.1
      subst functionDemand argumentDemand
      obtain ⟨bodyDemand, bodyRequirements, bodySource, bodyAuth, outward⟩ :=
        (functionChecked.value_summary (by trivial)).lambda_body
      have bodyEmpty := RecursiveOutward.no_owners outward
      subst bodyDemand
      have replaced := Auth.substitution bodyAuth
        ((argumentChecked.value_summary closed.1).value_context closed.1 requests .none) closed
      have changed := replaced.allowed_mono admitted
      refine ⟨_, _, changed, ?_⟩
      intro store receiving before
      rw [RecursiveOutward.evaluation outward, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.value_evaluation
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase functionSource))) trivial,
        RecursiveRecomposition.value_evaluation
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase argumentSource))) closed.1]
      simp only [OwnerPhaseTransitions.spendAll, List.nil_append, RecursiveRecomposition.merge_empty_left]
      rfl

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.allowed_mono
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.bind_expression
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.beta_expression

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts)
open SourcePlannedFrames (Families DependencyScope)
open SourceDependencyFrames (unwindStore)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available)

/-- Lexical administrative unwinding removes no still-enclosing activation and
introduces none, including when a dormant captured stack is opened. -/
theorem advance_activation_subset (step : LexicalUnwind.Advance before after discharged) :
    after.erase.activations ⊆ before.erase.activations := by
  cases step <;>
    simp [Stack.erase, ExecFrame.erase, PlainData.erase, HandlerData.erase,
      Control.activations, Frame.activation, CloseItem.frame, erase_append, activations_append]

/-- All six lexical administrative transitions preserve the joined invariant.
The existing generated unwind theorem supplies source, records and owner
phases; the lifetime event supplies completed-owner accounting. -/
theorem JoinedState.advance
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.unwind runtimeScope before, issued, completed⟩, actions⟩)
    (step : LexicalUnwind.Advance before after discharged) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      (unwindStore before resumes) (unwindStore before disposals) (unwindStore before annotatedStore) budget output
      ⟨⟨.unwind runtimeScope after, issued, discharged ++ completed⟩, actions⟩ := by
  cases state.source with
  | unwind pending retained matching bound finite annotation checked bounded =>
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨nextDemand, nextRequirements, nextAnnotated, nextHints, nextRow,
      nextSource, nextMatch, nextPending, nextBound, nextStore, nextAnnotation, nextCheck,
      paths, within, balance, nextUnique, nextFinite, nextResumes, nextClosing,
      transition, nextUse, nextTickets, nextResources⟩ :=
      advance_planned_unwind_generated pending matching retained bound state.resumeRecords
        state.unwindRecords state.storeAnnotation annotation checked finite unique
        state.lifetime.2.2 state.tickets state.resources step
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.unwind runtimeScope before, issued, completed⟩, actions⟩
        ⟨⟨.unwind runtimeScope after, issued, discharged ++ completed⟩, actions⟩ := by
      simpa only [List.append_nil, LexicalUnwind.advanceUseTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.unwind runtimeScope before, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    exact ⟨JoinedSource.unwind nextSource nextPending nextMatch nextBound nextFinite nextAnnotation
        nextCheck (within.trans bounded), nextResumes, nextClosing, nextStore,
      event.preserves state.lifetime, nextTickets, nextResources,
      (advance_activation_subset step).trans state.activations, state.issuedResources⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.advance_activation_subset
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.JoinedState.advance


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open SourcePlannedChecks (Certified)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available spendAll)

private theorem unit_source_shape
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      .unit input demand requirements checking) : input = .unit ∧ demand = [] := by
  cases source
  exact ⟨rfl, rfl⟩

/-- Unwind callback entry uses only the joined predecessor's existing checks. -/
theorem JoinedState.start_unwind_cleanup
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.unwind runtimeScope (.push (.armed action) rest), issued, completed⟩, actions⟩) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.app action.action .unit, .none, .push (.unwinding action) rest⟩, issued, completed⟩, actions⟩ := by
  cases state.source with
  | unwind pending retained matching bound finite annotation checked bounded =>
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨latent, dependencies, callbackPlan, nextScope, nextRequirements, nextHints,
      nextAnnotated, nextRow, scopeSame, certified, expression, nextSource, nextMatch,
      nextLocal, nextPending, nextBound, nextAnnotation, nextCheck, within, path,
      balance, nextUnique, nextFinite, nextRecords, nextClosing, transition, nextUse, nextTickets, nextResources⟩ :=
      start_planned_cleanup_generated pending matching retained bound state.resumeRecords state.unwindRecords
        state.storeAnnotation annotation checked finite unique state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.unwind runtimeScope (.push (.armed action) rest), issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨.app action.action .unit, .none, .push (.unwinding action) rest⟩, issued, completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.unwind runtimeScope (.push (.armed action) rest), issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    exact ⟨JoinedSource.eval expression certified ⟨.none, .none⟩ nextSource nextLocal nextPending
        nextMatch nextBound nextFinite nextAnnotation nextCheck (within.trans bounded),
      nextRecords, nextClosing, state.storeAnnotation, event.preserves state.lifetime,
      nextTickets, nextResources, state.activations, state.issuedResources⟩

/-- A Unit callback result resumes lexical unwinding and completes exactly the
installed cleanup owner. -/
theorem JoinedState.finish_unwind_cleanup
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩, issued, completed⟩, actions⟩) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.unwind action.scope rest, issued, .cleanup action.identity :: completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    obtain ⟨rfl, rfl⟩ := unit_source_shape current
    obtain ⟨tailAnnotated, tailAnnotation, tailPath⟩ := annotation.focus (RequirementPath.second .here)
    obtain ⟨tailRow, tailChecked, tailWithin⟩ := (disposal_subtree_path tailPath).checked checked
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨nextScope, nextRequirements, nextAnnotated, nextHints, nextRow,
      scopeSame, nextSource, nextMatch, nextPending, nextBound, nextAnnotation, nextCheck,
      within, path, balance, nextUnique, nextFinite, nextRecords, nextClosing,
      transition, nextUse, nextTickets, nextResources⟩ :=
      finish_planned_cleanup_generated pending matching retained bound state.resumeRecords state.unwindRecords
        state.storeAnnotation tailAnnotation tailChecked finite unique state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩, issued, completed⟩, actions⟩
        ⟨⟨.unwind action.scope rest, issued, .cleanup action.identity :: completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.singleton_append, LexicalUnwind.advanceUseTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) rest⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    exact ⟨JoinedSource.unwind nextSource nextPending nextMatch nextBound nextFinite nextAnnotation
        nextCheck (within.trans (tailWithin.trans bounded)), nextRecords, nextClosing, state.storeAnnotation,
      event.preserves state.lifetime, nextTickets, nextResources, state.activations, state.issuedResources⟩

/-- Finishing an unwind closing delimiter restores Unit at its recorded caller. -/
theorem JoinedState.finish_unwind_close
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.unwind runtimeScope (.push (.closing identity caller) rest), issued, completed⟩, actions⟩) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.unit, caller, rest⟩, issued, .close identity :: completed⟩, actions⟩ := by
  cases state.source with
  | unwind pending retained matching bound finite annotation checked bounded =>
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨nextScope, nextRequirements, nextAnnotated, nextHints, nextRow,
      scopeSame, callerKnown, nextSource, nextMatch, nextPending, nextBound, nextAnnotation, nextCheck,
      within, path, balance, nextUnique, nextFinite, nextRecords, nextClosing,
      transition, nextUse, nextTickets, nextResources⟩ :=
      finish_planned_close_generated pending matching retained bound state.resumeRecords state.unwindRecords
        state.storeAnnotation annotation checked finite unique state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.unwind runtimeScope (.push (.closing identity caller) rest), issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨.unit, caller, rest⟩, issued, .close identity :: completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.singleton_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.unwind runtimeScope (.push (.closing identity caller) rest), issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, nextRecords, nextClosing, state.storeAnnotation, event.preserves state.lifetime,
      nextTickets, nextResources, state.activations, state.issuedResources⟩
    apply JoinedSource.eval (plan := Plan.pure) (current := SourcePlannedSources.Expression.unit (allowed := []))
      (Certified.pure (evidence := declarationPolicy)) callerKnown nextSource .pure nextPending
      nextMatch nextBound nextFinite (RowAnnotation.sequence .original nextAnnotation) ?_ (within.trans bounded)
    change Checked _ _ _ (.sequence (.request (OwnerPhases.ofStack tables rest) []) (annotateDisposals nextAnnotated)) ([] ++ nextRow)
    exact .sequence (.request (by simp [OwnerSource.exportAt, residual_empty])) nextCheck

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.JoinedState.start_unwind_cleanup
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.JoinedState.finish_unwind_cleanup
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.JoinedState.finish_unwind_close


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ProtectionContracts (Footprint)
open SourceDependencyCapture (Scope)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature ClauseSignatures)

/-- Context data retains the exact return hints and latent source decorations.
This datatype alone does not authenticate those decorations. -/
inductive Context : {scope : Scope} → ReturnHints scope → Type where
  | nil : Context .nil
  | plain {checking : Signature dependencies} (rows : Rows checking)
      {rest : ReturnHints restScope} (tail : Context rest) :
      Context (.plain (dependencies := dependencies) rest)
  | handler {declarations : ClauseSignatures families} (activation : Nat)
      (rows : ClauseRows declarations) {rest : ReturnHints restScope} (tail : Context rest) :
      Context (.handler (effect := effect) (table := table) (families := families) rest)
  | cell {rest : ReturnHints restScope} (tail : Context rest) :
      Context (.cell (identity := identity) rest)
  | cleanup {checking : Signature callback} (latent : Footprint) (rows : Rows checking)
      {rest : ReturnHints restScope} (tail : Context rest) :
      Context (.cleanup (needs := needs) (callback := callback) rest)
  | normal {rest : ReturnHints restScope} (tail : Context rest) : Context (.running .normal rest)
  | unwinding {rest : ReturnHints restScope} (tail : Context rest) : Context (.running .unwind rest)
  | closing {rest : ReturnHints restScope} (tail : Context rest) : Context (.running .close rest)
  | retiring (owner : Nat) {rest : ReturnHints restScope} (tail : Context rest) : Context (.running .retire rest)
  | live {resumeDemand : List Nat} {saved : ReturnHints savedScope} {rest : ReturnHints restScope}
      (captured : Context saved) (tail : Context rest) : Context (.live (owner := owner) saved rest)
  | spent {rest : ReturnHints restScope} (tail : Context rest) : Context (.spent (owner := owner) rest)

def Context.hints {hints : ReturnHints scope} (_ : Context hints) : ReturnHints scope := hints

def Context.context : {scope : Scope} → {hints : ReturnHints scope} → Context hints → OwnerPhases.Context
  | _, _, .nil => []
  | _, _, .plain _ tail => .ordinary (.barrier false) :: tail.context
  | _, _, .handler (effect := effect) (table := table) activation _ tail =>
      .ordinary (.handler effect activation table) :: tail.context
  | _, _, .cell (identity := identity) tail => .ordinary (.builtin identity) :: tail.context
  | _, _, .cleanup _ _ tail => .ordinary (.barrier false) :: tail.context
  | _, _, .normal tail | _, _, .unwinding tail | _, _, .closing tail | _, _, .retiring _ tail =>
      .ordinary (.barrier true) :: tail.context
  | _, _, .live (savedScope := savedScope) (owner := owner) _ tail => .live owner savedScope.held :: tail.context
  | _, _, .spent (owner := owner) tail => .spent owner :: tail.context

def Context.append {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (head : Context first) (tail : Context second) : Context (first.append second) :=
  match head with
  | .nil => tail
  | .plain rows rest => .plain rows (rest.append tail)
  | .handler activation rows rest => .handler activation rows (rest.append tail)
  | .cell rest => .cell (rest.append tail)
  | .cleanup latent rows rest => .cleanup latent rows (rest.append tail)
  | .normal rest => .normal (rest.append tail)
  | .unwinding rest => .unwinding (rest.append tail)
  | .closing rest => .closing (rest.append tail)
  | .retiring owner rest => .retiring owner (rest.append tail)
  | .live (resumeDemand := resumeDemand) saved rest => .live (resumeDemand := resumeDemand) saved (rest.append tail)
  | .spent rest => .spent (rest.append tail)

/-- Only abandonable contexts project to the existing cleanup metadata. -/
def Context.closing? {hints : ReturnHints scope} (context : Context hints) : Option (CleanupHints.Metadata scope) :=
  match context with
  | .nil => some .nil
  | .plain _ tail => tail.closing?.map .plain
  | .handler activation _ tail => tail.closing?.map (.handler activation)
  | .cell tail => tail.closing?.map .cell
  | .cleanup latent _ tail => tail.closing?.map (.cleanup latent)
  | .normal _ | .unwinding _ | .closing _ => none
  | .retiring owner tail => tail.closing?.map (.retiring owner)
  | .live saved tail => do
      let captured ← saved.closing?
      let rest ← tail.closing?
      pure (.live captured rest)
  | .spent tail => tail.closing?.map .spent

theorem Context.closing?_sound {hints : ReturnHints scope} (context : Context hints)
    (found : context.closing? = some metadata) :
    metadata.erase = hints ∧ metadata.context = context.context := by
  induction context with
  | nil =>
      cases found
      exact ⟨rfl, rfl⟩
  | plain rows tail ih | handler activation rows tail ih | cell tail ih
  | cleanup latent rows tail ih | retiring owner tail ih | spent tail ih =>
      cases same : tail.closing? with
      | none => simp [Context.closing?, same] at found
      | some actual =>
          simp only [Context.closing?, same, Option.map_some, Option.some.injEq] at found
          subst metadata
          obtain ⟨erased, matching⟩ := ih same
          simp only [CleanupHints.Metadata.erase, CleanupHints.Metadata.context, Context.context, erased, matching, and_self]
  | normal tail ih | unwinding tail ih | closing tail ih => simp [Context.closing?] at found
  | live saved tail ihSaved ihTail =>
      cases savedSame : saved.closing? with
      | none => simp [Context.closing?, savedSame] at found
      | some savedMetadata =>
          cases tailSame : tail.closing? with
          | none => simp [Context.closing?, savedSame, tailSame] at found
          | some tailMetadata =>
              simp [Context.closing?, savedSame, tailSame] at found
              subst metadata
              obtain ⟨savedErased, _⟩ := ihSaved savedSame
              obtain ⟨tailErased, tailContext⟩ := ihTail tailSame
              simp only [CleanupHints.Metadata.erase, CleanupHints.Metadata.context, Context.context,
                savedErased, tailErased, tailContext, and_self]

theorem Context.append_context {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (head : Context first) (tail : Context second) :
    (head.append tail).context = head.context ++ tail.context := by
  induction head <;> simp_all [Context.append, Context.context] <;> rfl

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.closing?_sound
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.append_context


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyFrames (Frame UnwindSource)
open SourceDependencyAnnotations (Operations Contracts ValueSummary)

/-- Structural agreement for the data used by the cleanup budget checker.
Handler identities and cleanup latent rows come from these exact runtime/source
frames. Pending expression and declaration admission remain separate. -/
inductive Context.Source (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourceDependencyFrames.Families) (world : List Nat) :
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} →
    Context hints → Stack → Prop where
  | nil : Context.Source operations policy contracts tables families world .nil .nil
  | plain (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.plain rows rest) (.push (.plain data) stack)
  | handler
      (declaration : SourceDependencyFrames.Frame operations policy contracts tables families world
        (.handler data) answer answer [] (.request [] [])
        (.handler data.effectInst (tables data) (families data)) (data.effectInst :: residual) residual)
      (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world
        (.handler (effect := data.effectInst) (table := tables data) (families := families data) data.activation rows rest)
        (.push (.handler data) stack)
  | cell (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.cell (identity := identity) rest)
        (.push (.cell identity payload caller answer) stack)
  | cleanup
      (callback : ValueSummary operations policy contracts world SourceDependencyAnnotations.Environment.empty []
        action.action (.function .unit .unit action.requests latent dependencies))
      (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world
        (.cleanup (needs := action.requests) (callback := dependencies) latent rows rest) (.push (.armed action) stack)
  | normal (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.normal rest) (.push (.running action value closed) stack)
  | unwinding (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.unwinding rest) (.push (.unwinding action) stack)
  | closing (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.closing rest) (.push (.closing identity caller) stack)
  | retiring (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.retiring owner rest) (.push (.retiring owner) stack)
  | live (saved : Context.Source operations policy contracts tables families world captured savedStack)
      (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.live (resumeDemand := resumeDemand) (owner := owner) captured rest)
        (.live owner input answer savedStack caller stack)
  | spent (tail : Context.Source operations policy contracts tables families world rest stack) :
      Context.Source operations policy contracts tables families world (.spent (owner := owner) rest) (.spent owner answer caller stack)

theorem Context.Source.matching {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack) :
    ReturnHints.Matches tables families context.hints stack := by
  induction source with
  | nil => exact .nil
  | plain tail ih => exact .plain ih
  | handler declaration tail ih => exact .handler ih
  | cell tail ih => exact .cell ih
  | cleanup callback tail ih => exact .cleanup ih
  | normal tail ih => exact .running .normal ih
  | unwinding tail ih => exact .running .unwind ih
  | closing tail ih => exact .running .close ih
  | retiring tail ih => exact .running .retire ih
  | live saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | spent tail ih => exact .spent ih

theorem Context.Source.context_eq {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack) :
    context.context = OwnerPhases.ofStack tables stack := by
  induction source with
  | live saved tail ihSaved ihTail =>
      simp only [Context.context, OwnerPhases.ofStack, ihTail]
      rw [saved.matching.erases.held]
  | _ => simp_all [Context.context, OwnerPhases.ofStack, OwnerPhases.frameEntry,
      ExecFrame.erase, PlainData.erase, ActionData.erase, CloseItem.frame,
      ProtectionContexts.frameProtected, closeFrame]

/-- Successful projection uses the exact callback latent rows retained by the
source constructors, and reconstructs the established unwind source. -/
theorem Context.Source.closing_source {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack)
    (found : context.closing? = some metadata) :
    UnwindSource operations policy contracts tables families world stack
      metadata.closing.1 metadata.closing.2 scope := by
  induction source with
  | nil => cases found; exact .nil
  | plain tail ih | handler declaration tail ih | cell tail ih
  | cleanup callback tail ih | retiring tail ih | spent tail ih =>
      simp only [Context.closing?, Option.map_eq_some_iff] at found
      obtain ⟨actual, same, equal⟩ := found
      subst metadata
      have next := ih same
      first
      | exact .plain next
      | exact .handler declaration next
      | exact .cell next
      | exact .retiring next
      | exact .spent next
      | simpa only [CleanupHints.Metadata.closing,
          (Context.closing?_sound _ same).2, tail.context_eq] using
          (UnwindSource.cleanup callback next)
  | normal tail ih | unwinding tail ih | closing tail ih =>
      simp [Context.closing?] at found
  | @live savedScope savedHints captured savedStack restScope restHints rest stack owner resumeDemand input answer caller saved tail ihSaved ihTail =>
      cases savedSame : captured.closing? with
      | none => simp [Context.closing?, savedSame] at found
      | some savedMetadata =>
          cases tailSame : rest.closing? with
          | none => simp [Context.closing?, savedSame, tailSame] at found
          | some tailMetadata =>
              simp [Context.closing?, savedSame, tailSame] at found
              subst metadata
              have next := UnwindSource.live (owner := owner) (input := input) (answer := answer)
                (caller := caller) (ihSaved savedSame) (ihTail tailSame)
              simpa only [CleanupHints.Metadata.closing,
                (Context.closing?_sound _ tailSame).2, tail.context_eq,
                OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase,
                CloseItem.frame, ProtectionContexts.frameProtected] using next

theorem Context.Source.closing_agreement {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack)
    (found : context.closing? = some metadata) :
    CleanupHints.Agreement operations policy contracts tables families world metadata stack
      metadata.closing.1 metadata.closing.2 := by
  obtain ⟨erased, contexts⟩ := context.closing?_sound found
  exact ⟨source.closing_source found, by simpa only [erased, Context.hints] using source.matching,
    contexts.trans source.context_eq, rfl⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.matching
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.context_eq
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.closing_agreement


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ProtectionContracts
open SourceDependencyCapture (Scope lookupDependencies)
open SourceDependencyChecks.Lexical (ReturnHints)

structure Packed where
  scope : Scope
  hints : ReturnHints scope
  context : Context hints

def Context.pack {hints : ReturnHints scope} (context : Context hints) : Packed := ⟨scope, hints, context⟩

inductive Selection where
  | builtin (identity : Nat)
  | handler (captured tail : Packed) (contract : ClauseContract)
      (modes : Option (Nat → SourceDependencyAnnotations.Dependencies) × Option (Nat → SourceDependencyAnnotations.Dependencies))

def Selection.prepend (frame : Packed → Packed) : Selection → Selection
  | .builtin identity => .builtin identity
  | .handler captured tail contract modes => .handler (frame captured) tail contract modes

def Selection.erase : Selection → SourceDependencyCapture.Selection
  | .builtin identity => .builtin identity
  | .handler captured tail contract modes => .handler captured.scope tail.scope contract modes

/-- Structural nearest-handler lookup retains the actual context decorations.
A matching handler with a missing operation or dependency family stops lookup. -/
def select (effect : Instance) (operation : Nat) {hints : ReturnHints scope} (context : Context hints) : Option Selection :=
  match context with
  | .nil => none
  | .handler (effect := requested) (table := table) (families := families) activation rows tail =>
      if effect = requested then
        match lookup operation table, lookupDependencies operation families with
        | some contract, some modes => some (.handler (Context.handler (effect := requested) (table := table) activation rows .nil).pack tail.pack contract modes)
        | _, _ => none
      else (select effect operation tail).map (.prepend fun captured => (Context.handler (effect := requested) (table := table) activation rows captured.context).pack)
  | .cell (identity := identity) tail =>
      if effect = .cell identity then some (.builtin identity)
      else (select effect operation tail).map (.prepend fun captured => (Context.cell (identity := identity) captured.context).pack)
  | .plain rows tail => (select effect operation tail).map (.prepend fun captured => (Context.plain rows captured.context).pack)
  | .cleanup (needs := needs) latent rows tail =>
      (select effect operation tail).map (.prepend fun captured => (Context.cleanup (needs := needs) latent rows captured.context).pack)
  | .normal tail => (select effect operation tail).map (.prepend fun captured => (Context.normal captured.context).pack)
  | .unwinding tail => (select effect operation tail).map (.prepend fun captured => (Context.unwinding captured.context).pack)
  | .closing tail => (select effect operation tail).map (.prepend fun captured => (Context.closing captured.context).pack)
  | .retiring owner tail => (select effect operation tail).map (.prepend fun captured => (Context.retiring owner captured.context).pack)
  | .live (resumeDemand := resumeDemand) (owner := owner) saved tail =>
      (select effect operation tail).map (.prepend fun captured => (Context.live (resumeDemand := resumeDemand) (owner := owner) saved captured.context).pack)
  | .spent (owner := owner) tail =>
      (select effect operation tail).map (.prepend fun captured => (Context.spent (owner := owner) captured.context).pack)

private theorem erase_prepend (frame : Packed → Packed) (erased : Scope → Scope)
    (same : ∀ packed, (frame packed).scope = erased packed.scope) (selected : Option Selection) :
    (selected.map (Selection.prepend frame)).map Selection.erase =
      (selected.map Selection.erase).map (SourceDependencyCapture.Selection.prepend erased) := by
  cases selected with
  | none => rfl
  | some selected => cases selected with
    | builtin identity => rfl
    | handler captured tail contract modes => simp only [Option.map_some, Selection.prepend, Selection.erase,
        SourceDependencyCapture.Selection.prepend, same]

/-- Decorated selection follows the existing nearest-handler lookup exactly. -/
theorem select_sound (effect : Instance) (operation : Nat)
    {hints : ReturnHints scope} (context : Context hints) :
    (select effect operation context).map Selection.erase = SourceDependencyCapture.select effect operation scope := by
  induction context with
  | nil => rfl
  | handler activation rows tail ih =>
      simp only [select, SourceDependencyCapture.select]
      split
      · split <;> simp_all [Selection.erase, Context.pack]
      · rw [erase_prepend _ _ (fun _ => rfl), ih]
  | cell tail ih =>
      simp only [select, SourceDependencyCapture.select]
      split
      · rfl
      · rw [erase_prepend _ _ (fun _ => rfl), ih]
  | plain rows tail ih | cleanup latent rows tail ih | normal tail ih | unwinding tail ih
  | closing tail ih | retiring owner tail ih | spent tail ih =>
      exact (erase_prepend _ _ (fun _ => rfl) _).trans (congrArg (Option.map _) ih)
  | live saved tail ihSaved ihTail =>
      exact (erase_prepend _ _ (fun _ => rfl) _).trans (congrArg (Option.map _) ihTail)

def Packed.append (head tail : Packed) : Packed := (head.context.append tail.context).pack

private def Decomposes (whole : Packed) (selected : Option Selection) : Prop :=
  ∀ captured tail contract modes, selected = some (.handler captured tail contract modes) →
    whole = captured.append tail

private theorem decomposes_prepend (frame : Packed → Packed)
    (commutes : ∀ captured tail, frame (captured.append tail) = (frame captured).append tail)
    (checked : Decomposes whole selected) : Decomposes (frame whole) (selected.map (Selection.prepend frame)) := by
  intro captured tail contract modes found
  cases selected with
  | none => cases found
  | some selected => cases selected with
    | builtin identity => cases found
    | handler first rest offered families =>
        have same := congrArg frame (checked first rest offered families rfl)
        rw [commutes] at same
        cases found
        exact same

private theorem select_decomposes (effect : Instance) (operation : Nat)
    {hints : ReturnHints scope} (context : Context hints) :
    Decomposes context.pack (select effect operation context) := by
  induction context with
  | nil => intro _ _ _ _ found; cases found
  | handler activation rows tail ih =>
      simp only [select]
      split
      · split
        · intro captured rest contract modes found
          cases found
          rfl
        · intro _ _ _ _ found; cases found
      · exact decomposes_prepend _ (fun _ _ => rfl) ih
  | cell tail ih =>
      simp only [select]
      split
      · intro _ _ _ _ found; cases found
      · exact decomposes_prepend _ (fun _ _ => rfl) ih
  | plain rows tail ih | cleanup latent rows tail ih | normal tail ih | unwinding tail ih
  | closing tail ih | retiring owner tail ih | spent tail ih =>
      exact decomposes_prepend _ (fun _ _ => rfl) ih
  | live saved tail ihSaved ihTail =>
      exact decomposes_prepend _ (fun _ _ => rfl) ihTail

/-- A cut identifies exact decorated contexts, rather than arbitrary metadata
with the same lexical erasure. -/
def Cut (effect : Instance) (operation : Nat)
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    (whole : Context wholeHints) (captured : Context captureHints) (tail : Context tailHints)
    (contract : ClauseContract) (modes : Option (Nat → SourceDependencyAnnotations.Dependencies) × Option (Nat → SourceDependencyAnnotations.Dependencies)) : Prop :=
  select effect operation whole = some (.handler captured.pack tail.pack contract modes)

theorem Cut.select_sound
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (cut : Cut effect operation whole captured tail contract modes) :
    SourceDependencyCapture.select effect operation wholeScope =
      some (.handler captureScope tailScope contract modes) := by
  rw [← Contextual.select_sound effect operation whole, cut]
  rfl

theorem Cut.decomposition
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (cut : Cut effect operation whole captured tail contract modes) :
    whole.pack = (captured.append tail).pack :=
  select_decomposes effect operation whole captured.pack tail.pack contract modes cut

theorem Cut.hints
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (cut : Cut effect operation whole captured tail contract modes) :
    HEq wholeHints (captureHints.append tailHints) := by
  have same := cut.decomposition
  cases same
  rfl

theorem Cut.context
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (cut : Cut effect operation whole captured tail contract modes) :
    whole.context = captured.context ++ tail.context := by
  have same := congrArg (fun packed : Packed => packed.context.context) cut.decomposition
  exact same.trans (Context.append_context captured tail)

/-- Determinism preserves every decoration, including dormant contexts. -/
theorem Cut.unique
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {nextCaptureHints : ReturnHints nextCaptureScope} {nextTailHints : ReturnHints nextTailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    {nextCaptured : Context nextCaptureHints} {nextTail : Context nextTailHints}
    (first : Cut effect operation whole captured tail contract modes)
    (second : Cut effect operation whole nextCaptured nextTail nextContract nextModes) :
    captured.pack = nextCaptured.pack ∧ tail.pack = nextTail.pack ∧ contract = nextContract ∧ modes = nextModes := by
  have same := Option.some.inj (first.symm.trans second)
  cases same
  exact ⟨rfl, rfl, rfl, rfl⟩

/-- This finite check concerns only the cleanup budget. Existing local source
checks separately enforce request existence, permission and selected modes. -/
def RequestBudget (budget : Footprint) (phases : OwnerPhaseTransitions.Phases)
    (effect : Instance) (operation : Nat) {hints : ReturnHints scope} (context : Context hints) : Prop :=
  match select effect operation context with
  | none | some (.builtin _) => True
  | some (.handler captured tail contract _) =>
      contract.dispose = true → ∃ metadata, captured.context.closing? = some metadata ∧
        metadata.check tail.context.context phases budget = true ∧
        metadata.check (.ordinary (.barrier true) :: tail.context.context) phases budget = true

theorem RequestBudget.consuming
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (checked : RequestBudget budget phases effect operation whole)
    (cut : Cut effect operation whole captured tail contract modes)
    (consuming : contract.dispose = true) :
    ∃ metadata, captured.closing? = some metadata ∧
      metadata.check tail.context phases budget = true ∧
      metadata.check (.ordinary (.barrier true) :: tail.context) phases budget = true := by
  unfold RequestBudget at checked
  rw [cut] at checked
  exact checked consuming

/-- Ordinary, builtin and failed selections intentionally impose no cleanup
budget obligation at this layer. -/
theorem RequestBudget.unselected
    {hints : ReturnHints scope} {context : Context hints}
    (found : select effect operation context = none) : RequestBudget budget phases effect operation context := by
  simp only [RequestBudget, found]

theorem RequestBudget.builtin
    {hints : ReturnHints scope} {context : Context hints}
    (found : select effect operation context = some (.builtin identity)) : RequestBudget budget phases effect operation context := by
  simp only [RequestBudget, found]

theorem RequestBudget.nonconsuming
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (cut : Cut effect operation whole captured tail contract modes) (ordinary : contract.dispose = false) :
    RequestBudget budget phases effect operation whole := by
  unfold RequestBudget
  rw [cut]
  intro consuming
  rw [ordinary] at consuming
  cases consuming

theorem RequestBudget.handler
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (cut : Cut effect operation whole captured tail contract modes)
    (found : captured.closing? = some metadata)
    (ordinary : metadata.check tail.context phases budget = true)
    (protectedCheck : metadata.check (.ordinary (.barrier true) :: tail.context) phases budget = true) :
    RequestBudget budget phases effect operation whole := by
  unfold RequestBudget
  rw [cut]
  exact fun _ => ⟨metadata, found, ordinary, protectedCheck⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

