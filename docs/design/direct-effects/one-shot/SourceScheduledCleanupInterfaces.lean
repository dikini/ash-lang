namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)
open OwnerPhaseTransitions (spend)

/-- The structural resume primitive and actual predecessor records construct a
rich successor source in either return mode. The restored certificate uses the
same decorated context as that successor. -/
theorem RecordPendingRows.resume_recompose_from_code
    {contract : SourcePlannedTyping.Contract} {known : contracts owner = some contract}
    {recorded : Requirements contract.resumeDemand}
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail)) (.value contract.answer) output
      pendingDemand pendingRequirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source (.value (owners owner contract known).2) outputRows context)
    (code : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .resume⟩)) context)
    (cut : SourceDependencyCapture.OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩)
    (frontRealized : SourceDependencyCapture.Realizes tables families frontScope front)
    (frontOrdinary : LexicalUnwind.returnMode front .ordinary = .ordinary)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recorded⟩) :
    ∃ frontHints : ReturnHints frontScope, ∃ capturedHints : ReturnHints capturedScope,
    ∃ tailHints : ReturnHints tailScope, ∃ frontContext : Context frontHints,
    ∃ capturedContext : Context capturedHints, ∃ tailContext : Context tailHints,
    ∃ demand, ∃ requirements : Requirements demand,
    ∃ successor : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
      demand requirements (capturedScope.append (frontScope.append (.spent owner tailScope))),
      context.pack = (frontContext.append
        (.live (owner := owner) (resumeDemand := contract.resumeDemand) capturedContext tailContext)).pack ∧
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) successor
        (.value (owners owner contract known).1) outputRows
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) ∧
      SourceAdmission.Pending outward actions budget (spend phases owner) world installations
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext)))
        .nil .ordinary (hints.returnMode .ordinary) := by
  obtain ⟨⟨richFrontScope, richFrontHints, richFront⟩,
    ⟨richCapturedScope, richCapturedHints, richCaptured⟩,
    ⟨richTailScope, richTailHints, richTail⟩, rights,
    same, located, actionKnown, permission, available, budgeted, restored⟩ := rows.resume_site code known
  obtain ⟨rfl, rfl, rfl⟩ := owner_cut_scope_parts located cut
  have reconstructed : ∃ demand, ∃ requirements : Requirements demand,
      ∃ successor : PlannedModeSource operations policy contracts tables families required outward actions world
        (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
        demand requirements (richCapturedScope.append (richFrontScope.append (.spent owner richTailScope))),
        RecordPendingRows operations policy contracts tables families required outward actions world
          ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) successor
          (.value (owners owner contract known).1) outputRows
          (richCaptured.append (richFront.append (.spent (owner := owner) richTail))) := by
    cases mode : LexicalUnwind.returnMode captured .ordinary with
    | ordinary => exact rows.resume_recompose_ordinary_at same frontRealized frontOrdinary found mode
    | unwind =>
      obtain ⟨middle, middleRows, firstDemand, secondDemand, firstRequirements, secondRequirements,
        firstSource, secondSource, firstRows, secondRows, demandSame, evaluation, generatedEvaluation⟩ :=
        rows.split_disposals_at richFront
          (Context.live (owner := owner) (resumeDemand := contract.resumeDemand) richCaptured richTail) same frontRealized
      have physical := secondRows.forget.source
      cases physical with
      | live inside outside =>
          have modeSame := inside.matching.return_mode.trans mode
          change richCapturedHints.returnMode .ordinary = .unwind at modeSame
          dsimp only [Context.pack, Packed.hints, Packed.context] at budgeted
          rw [modeSame] at budgeted
          obtain ⟨metadata, closing⟩ := ResumeShape.unwind_iff.mp budgeted
          exact rows.resume_recompose_unwind_at same frontRealized frontOrdinary found closing mode
  obtain ⟨demand, requirements, successor, nextRows⟩ := reconstructed
  exact ⟨_, _, _, richFront, richCaptured, richTail, demand, requirements, successor, same, nextRows, restored⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_recompose_from_code


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (spend spendAll)

/-- Retiring an owner discharges its empty row and permits removing its records.
The argument is independent of the shape of the remaining computation. -/
theorem retire_prefix_checked
    {root : Requirements demand}
    (checked : Checked (annotateDisposalStore entries) receiving phases
      (annotateDisposals (.sequence (.retire owner) root)) row) :
    Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner entries)) receiving
      (spend phases owner) (annotateDisposals root) row := by
  obtain ⟨retireRow, bodyRow, retireCheck, bodyCheck, same⟩ :=
    RecursiveRequirements.checked_sequence_parts checked
  have retireEvaluation := RecursiveRequirements.checked_complete retireCheck
  change evaluate _ _ _ (.retire owner) = some retireRow at retireEvaluation
  rw [RecursiveClosing.evaluate_retire] at retireEvaluation
  split at retireEvaluation
  next available =>
    have empty : retireRow = [] := (Option.some.inj retireEvaluation).symm
    subst retireRow
    simp only [List.nil_append] at same
    subst row
    have moved := RecursiveTransport.checked_remove_consumed bodyCheck
      (OwnerPhaseTransitions.spend_self phases owner)
    simpa only [spendAll, ← disposal_store_remove_owner] using moved
  next unavailable => cases retireEvaluation
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.retire_prefix_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (spend spendAll)

/-- Execution order after selecting a one-shot resume: saved computation, caller
in the saved return mode, then the selected live boundary's spent tail. -/
def resumeExecutionBody (tables : CallableProtectionFrames.Tables) (owner : Nat)
    (front tail : Stack) (answerType : Ty) (caller : Scope)
    (saved : Requirements savedDemand) (actualCaller : Requirements callerDemand)
    (liveTail : Requirements tailDemand) : Requirements (savedDemand ++ (callerDemand ++ tailDemand)) :=
  .sequence (saved.prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail))))
    (.sequence (actualCaller.prepend (OwnerPhases.ofStack tables (.spent owner answerType caller tail))) liveTail)

/-- Consuming the selected owner precedes execution of its authenticated body.
No ordinary caller alternative is added when the saved return mode is unwind. -/
def resumeExecutionRoot (tables : CallableProtectionFrames.Tables) (owner : Nat)
    (front tail : Stack) (answerType : Ty) (caller : Scope)
    (saved : Requirements savedDemand) (actualCaller : Requirements callerDemand)
    (liveTail : Requirements tailDemand) : Requirements (owner :: (savedDemand ++ (callerDemand ++ tailDemand))) :=
  .sequence (.retire owner) (resumeExecutionBody tables owner front tail answerType caller saved actualCaller liveTail)

/-- Structural execution-root composition for a ready resume. Rich source
reconstruction below authenticates the same selected record and lexical frames.
The two constructors select executable requirements, not a same-demand choice. -/
inductive ResumeExecution (tables : CallableProtectionFrames.Tables) (owner : Nat)
    (front captured tail : Stack) (answerType : Ty) (caller : Scope)
    {hints : ReturnHints scope} (frontContext : Context hints)
    (saved : Requirements savedDemand) (ordinaryCaller : Requirements frontDemand)
    (liveTail : Requirements tailDemand) : {demand : List Nat} → Requirements demand → Prop where
  | ordinary (returns : LexicalUnwind.returnMode captured .ordinary = .ordinary) :
      ResumeExecution tables owner front captured tail answerType caller frontContext saved ordinaryCaller liveTail
        (resumeExecutionRoot tables owner front tail answerType caller saved ordinaryCaller liveTail)
  | unwind (returns : LexicalUnwind.returnMode captured .ordinary = .unwind)
      (closing : frontContext.closing? = some metadata) :
      ResumeExecution tables owner front captured tail answerType caller frontContext saved ordinaryCaller liveTail
        (resumeExecutionRoot tables owner front tail answerType caller saved metadata.closing.2 liveTail)

/-- Root checking retires the selected owner once and checks the executable body
at the resulting phase. Removing its records preserves that exact check. -/
theorem resume_execution_body_checked
    (checked : Checked (annotateDisposalStore entries) receiving phases
      (annotateDisposals (resumeExecutionRoot tables owner front tail answerType caller
        saved actualCaller liveTail)) row) :
    Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner entries)) receiving
      (spend phases owner)
      (annotateDisposals (resumeExecutionBody tables owner front tail answerType caller saved actualCaller liveTail)) row :=
  retire_prefix_checked checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.resume_execution_body_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)

/-- Compile the actual-mode execution root to its checked rich successor source.
The same witness carries source typing, record agreement and the finite check;
no successor certificate or caller ownership-balance premise is supplied. -/
theorem RecordPendingRows.resume_execution_checked
    {contract : SourcePlannedTyping.Contract}
    {known : contracts owner = some contract}
    {recorded : Requirements contract.resumeDemand}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope}
    {liveSource : PlannedModeSource operations policy contracts tables families required outward actions world
      (.live owner inputType answerType captured caller tail) liveInput output
      tailDemand liveRequirements (.live owner capturedScope tailScope)}
    (frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes frontSource (.value (owners owner contract known).2)
        (.value (owners owner contract known).2) frontContext)
    (liveRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes liveSource liveInputRows outputRows
        (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (ordinaryInput : liveInput = .value contract.answer)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recorded⟩)
    (execution : ResumeExecution tables owner front captured tail answerType caller frontContext
      recorded frontRequirements liveRequirements (root : Requirements rootDemand))
    (checked : RecursiveRequirements.Checked (annotateDisposalStore entries) receiving phases
      (annotateDisposals root) row) :
    ∃ demand, ∃ requirements : Requirements demand,
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
      demand requirements (capturedScope.append (frontScope.append (.spent owner tailScope))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) source
        (.value (owners owner contract known).1) outputRows
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) ∧
      RecursiveRequirements.Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner entries))
        receiving (OwnerPhaseTransitions.spend phases owner) (annotateDisposals requirements) row ∧
      rootDemand = owner :: demand := by
  cases execution with
  | ordinary mode =>
      obtain ⟨requirements, source, nextRows, evaluation⟩ :=
        frontRows.resume_recompose_ordinary liveRows ordinaryInput found mode
      have bodyCheck := resume_execution_body_checked checked
      refine ⟨_, requirements, source, nextRows, ?_, rfl⟩
      apply RecursiveRequirements.evaluate_sound
      rw [evaluation]
      simpa only [resumeExecutionBody, annotateDisposals, disposal_prepend,
        RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend]
        using RecursiveRequirements.checked_complete bodyCheck
  | unwind mode closing =>
      obtain ⟨requirements, source, nextRows, evaluation⟩ :=
        frontRows.resume_recompose_unwind liveRows ordinaryInput found closing mode
      have bodyCheck := resume_execution_body_checked checked
      refine ⟨_, requirements, source, nextRows, ?_, rfl⟩
      apply RecursiveRequirements.evaluate_sound
      rw [evaluation]
      have unchanged := (unwind_template_disposals (frontRows.forget.source.closing_source closing).template).2
      simpa only [resumeExecutionBody, annotateDisposals, disposal_prepend,
        RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend, unchanged]
        using RecursiveRequirements.checked_complete bodyCheck

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_execution_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (available spendAll)

/-- The executable root accounts for all physical owners before and after resume.
Ownership follows from actual-mode source and its check, rather than locality
guards or a permutation supplied by admission. -/
theorem RecordPendingRows.resume_execution_owned
    {contract : SourcePlannedTyping.Contract}
    {known : contracts owner = some contract}
    {recorded : Requirements contract.resumeDemand}
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {frontContext : Context frontHints} {capturedContext : Context capturedHints}
    {tailContext : Context tailHints}
    {frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope}
    {liveSource : PlannedModeSource operations policy contracts tables families required outward actions world
      (.live owner inputType answerType captured caller tail) liveInput output
      tailDemand liveRequirements (.live owner capturedScope tailScope)}
    (frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes frontSource (.value (owners owner contract known).2)
        (.value (owners owner contract known).2) frontContext)
    (liveRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes liveSource liveInputRows outputRows
        (.live (resumeDemand := resumeDemand) capturedContext tailContext))
    (ordinaryInput : liveInput = .value contract.answer)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recorded⟩)
    (execution : ResumeExecution tables owner front captured tail answerType caller frontContext
      recorded frontRequirements liveRequirements (root : Requirements rootDemand))
    (records : ∀ key body, (key, body) ∈ (resumes : RecursiveRequirements.Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : RecursiveRequirements.Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (storeAnnotation : SourceDependencyAnnotations.StoreAnnotation (resumes ++ disposals) annotatedStore)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (checked : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) receiving
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      (annotateDisposals root) row) :
    ∃ demand, ∃ requirements : Requirements demand,
    ∃ source : PlannedModeSource operations policy contracts tables families required outward actions world
      (captured.append (front.append (.spent owner answerType caller tail))) (.value contract.input) output
      demand requirements (capturedScope.append (frontScope.append (.spent owner tailScope))),
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows (RecursiveTransport.removeOwner owner resumes) source
        (.value (owners owner contract known).1) outputRows
        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) ∧
      RecursiveRequirements.Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore))
        receiving (available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))))
        (annotateDisposals requirements) row ∧
      demand.Perm (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) ∧
      rootDemand.Perm (ownedTickets (front.append (.live owner inputType answerType captured caller tail))) := by
  obtain ⟨demand, requirements, source, nextRows, nextCheck, demandSame⟩ :=
    frontRows.resume_execution_checked liveRows ordinaryInput found execution checked
  have phaseSame := OwnerPhaseTransitions.trace_result (OwnerPhaseTransitions.resume_phase_trace unique)
  change available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) =
    OwnerPhaseTransitions.spend
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) owner at phaseSame
  rw [← phaseSame] at nextCheck
  have nextUnique := (List.nodup_cons.mp (OwnerPhaseTransitions.resume_owned_permutation.nodup unique)).2
  have nextRecords := planned_resume_records_resume records
  have nextClosing := planned_unwind_records_resume closing
  obtain ⟨_, normalCheck, _⟩ := (disposal_annotation requirements).checked nextCheck
  obtain ⟨_, originalCheck, _⟩ := (annotated_disposal_store (storeAnnotation.remove_owner owner)).checked normalCheck
  rw [RecursiveConsumption.remove_owner_append] at originalCheck
  have balance := SourceDependencySchemes.Lexical.mode_stack_ownership_balance source.erase
    (fun key body member => (nextRecords key body member).erase)
    (fun key body member => (nextClosing key body member).erase) nextUnique originalCheck
  refine ⟨demand, requirements, source, nextRows, nextCheck, balance, ?_⟩
  rw [demandSame]
  exact (balance.cons owner).trans OwnerPhaseTransitions.resume_owned_permutation.symm

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.resume_execution_owned

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeExecutionExamples
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (available)

def caller : PlainData := ⟨.resume 5, .ticket 5 1, .unit, .unit, [1], rfl⟩
def front : Stack := .push (.plain caller) .nil
def captured (action : ActionData) : Stack := .push (.unwinding action) .nil
def tail : Stack := .live 1 .unit .unit .nil .none (.push (.closing 0 .none) .nil)
def callerContext := Context.plain (Rows.invoke (key := ⟨1, .resume⟩)) Context.nil

def savedRequirements : Requirements [] := .request [] []
def ordinaryCaller : Requirements [1] := .invoke ⟨1, .resume⟩ [] []
def liveTail : Requirements [1] := .sequence (.spent 0) (.retire 1)
def executableRoot (tables : CallableProtectionFrames.Tables) :=
  resumeExecutionRoot tables 0 front tail .unit .none savedRequirements (.request [] []) liveTail

/-- The selected unwind branch checks once per actual owner; the skipped caller
invocation adds no executable demand here. Source authentication is a separate
compiler premise, not established by this example. -/
theorem unwind_selected (tables : CallableProtectionFrames.Tables) (action : ActionData) :
    ResumeExecution tables 0 front (captured action) tail .unit .none callerContext
      savedRequirements ordinaryCaller liveTail (executableRoot tables) :=
  .unwind (metadata := .plain .nil) rfl rfl

theorem executable_checked (tables : CallableProtectionFrames.Tables) :
    Checked [] [] (available [0, 1]) (annotateDisposals (executableRoot tables)) [] := by
  apply RecursiveRequirements.evaluate_sound
  simp [executableRoot, resumeExecutionRoot, resumeExecutionBody, savedRequirements, liveTail,
    annotateDisposals, RecursiveRequirements.evaluate, RecursiveRequirements.evaluateFuel,
    RecursiveRequirements.Requirements.prepend, PhaseRechecking.checkOwners, available,
    OwnerPhaseTransitions.spendAll, OwnerPhaseTransitions.spend, OwnerSource.exportAt,
    ProtectionResiduals.residual_empty, ProtectionResiduals.merge]

/-- A root retaining the skipped ordinary demand cannot pass the phase trace. -/
theorem ordinary_demand_rejected {requirements : Requirements [0, 1, 1]} :
    ¬ Checked entries receiving phases requirements row := by
  intro checked
  have unique := OwnerPhaseTransitions.trace_nodup (RecursiveRequirements.checked_trace checked)
  simp at unique

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeExecutionExamples
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeExecutionExamples.unwind_selected
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeExecutionExamples.executable_checked
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeExecutionExamples.ordinary_demand_rejected

namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Ready resume preserves physical ownership and registry history. Executable
source requirements provide continuation-use accounting independently. -/
theorem ready_resume_ledger_registry
    {front captured tail : Stack}
    (ledger : Ledger (RunState.erase
      ⟨.eval ⟨.resume binder value, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩))
    (history : UsageRegistryHistory tickets issued)
    (closed : ClosedValue value)
    (resolved : runtimeScope.resolve binder = some owner) :
    Event
      ⟨.eval ⟨.resume binder value, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩
      ⟨.eval ⟨value, runtimeScope,
        captured.append (front.append (.spent owner answer caller tail))⟩,
        issued, .ticket owner :: completed⟩ ∧
    Ledger (RunState.erase
      ⟨.eval ⟨value, runtimeScope,
        captured.append (front.append (.spent owner answer caller tail))⟩,
        issued, .ticket owner :: completed⟩) ∧
    UsageRegistryHistory tickets issued := by
  have step : Transition
      (.eval ⟨.resume binder value, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩)
      (.eval ⟨value, runtimeScope,
        captured.append (front.append (.spent owner answer caller tail))⟩)
      [] [.ticket owner] :=
    .evaluate (.resume binder owner runtimeScope caller input answer front captured tail value closed resolved) trivial
  have event : Event
      ⟨.eval ⟨.resume binder value, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩
      ⟨.eval ⟨value, runtimeScope,
        captured.append (front.append (.spent owner answer caller tail))⟩,
        issued, .ticket owner :: completed⟩ := by
    simpa only [List.append_nil, List.singleton_append] using
      (Event.step (before := ⟨.eval ⟨.resume binder value, runtimeScope,
        front.append (.live owner input answer captured caller tail)⟩, issued, completed⟩)
        step (by simpa only [List.append_nil, RunState.erase] using ledger.2))
  exact ⟨event, event_preserves_ledger event ledger, history⟩

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.LexicalUnwind.ready_resume_ledger_registry

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyAnnotations (Dependencies)
open SourcePlanSignatures (Signature)
open OwnerPhaseTransitions (introduce)

/-- A finite clause derivation indexed by its actual rows and receiver. Primitive
inherited requests retain exact local evidence; an arbitrary effectful suffix
cannot be added to an own-owner leaf by changing its receiver. -/
inductive ClauseSchema (outward : List Instance) (actions : Syntax.UsageTickets)
    (budget : Footprint) (phases : OwnerPhaseTransitions.Phases)
    (world installations : List Nat) (owner : Nat) (rights : Syntax.OneShotRights)
    (originContract : ClauseContract) (resumeDemand : List Nat)
    {captureScope tailScope : SourceDependencyCapture.Scope}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    (captured : Context captureHints) (tail : Context tailHints) :
    {dependencies : Dependencies} → {checking : Signature dependencies} → Rows checking →
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} → Context hints → Prop where
  | pure : ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
      .pure context
  | ownResume (permission : rights.resume = true) :
      ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        (Rows.invoke (key := ⟨owner, .resume⟩)) (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)
  | ownDiscard (permission : rights.dispose = true) (disposing : originContract.dispose = true) :
      ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        (Rows.invoke (key := ⟨owner, .dispose⟩)) (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)
  | builtin (found : select effect operation context = some (.builtin identity)) :
      ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        (Rows.request (effect := effect) (operation := operation)) context
  | request
      {wholeHints : ReturnHints wholeScope} {nextCaptureHints : ReturnHints nextCaptureScope} {nextTailHints : ReturnHints nextTailScope}
      {whole : Context wholeHints} {nextCaptured : Context nextCaptureHints} {nextTail : Context nextTailHints}
      (cut : Cut effect operation whole nextCaptured nextTail contract modes)
      (guarded : SourceDependencyChecks.Lexical.Capture wholeScope effect operation)
      (callbacks : contract.dispose = true → Pending outward (actions.insert owner rights) budget
        (introduce phases owner) world installations nextCaptured (.closing nextTail) .unwind .unwind)
      (ownerBound : contract.dispose = true → SourceDependencyOwners.PendingWithin world
        (SourceDependencyOwners.owners nextCaptureScope) nextCaptureScope)
      (cleanupBudget : RequestBudget budget (introduce phases owner) effect operation whole)
      {family : Nat → Dependencies} {bodies : ∀ freshOwner, Signature (family freshOwner)}
      {bodyRows : ∀ freshOwner, Rows (bodies freshOwner)}
      {declarations : SourcePlanSignatures.ClauseSignatures declarationFamilies}
      {declarationRows : ClauseRows declarations}
      (selected : CapturedClauseRows effect operation nextCaptureScope.held nextCaptured bodyRows)
      (terminal : TerminalHandler effect activation declarationRows nextCaptured)
      (requiredRights : rightsAt operation declarations = some nextRights)
      (retained : Pending outward (actions.insert owner rights) budget (introduce phases owner)
        world installations whole Context.nil .ordinary (wholeHints.returnMode .ordinary))
      (body : ∀ freshOwner nextResumeDemand,
        (actions.insert owner rights) freshOwner = none → freshOwner ∉ whole.ticketNames →
        Code outward ((actions.insert owner rights).insert freshOwner nextRights) budget
          (introduce (introduce phases owner) freshOwner) world installations (bodyRows freshOwner)
          (Context.live (owner := freshOwner) (resumeDemand := nextResumeDemand) nextCaptured nextTail)) :
      ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        (Rows.request (effect := effect) (operation := operation)) whole
  | sequence
      (first : ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        firstRows (.plain secondRows context))
      (second : ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        secondRows context) :
      ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        (.sequence firstRows secondRows) context
  | choice
      (left : ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail first context)
      (right : ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail second context) :
      ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail
        (.choice first second) context
  | pureContinuation
      (body : ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail rows context) :
      ClauseSchema outward actions budget phases world installations owner rights originContract resumeDemand captured tail rows (.plain .pure context)

/-- Compilation reuses the source rules and the predecessor-derived own-owner
leaves. There is no successor Code premise in the finite schema. -/
theorem ClauseSchema.compile_at_cut
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (schema : ClauseSchema outward actions budget phases world installations owner rights contract resumeDemand captured tail rows context)
    (request : Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole)
    (retained : Pending outward actions budget phases world installations whole .nil .ordinary finalMode)
    (cut : Cut effect operation whole captured tail contract modes)
    (fresh : actions owner = none) (consumed : phases owner = .consumed) :
    Code outward (actions.insert owner rights) budget (introduce phases owner) world installations rows context := by
  induction schema with
  | pure => exact .pure
  | ownResume permission => exact Code.own_resume_at_cut retained cut fresh consumed permission
  | ownDiscard permission disposing => exact Code.own_discard_at_cut request retained cut fresh consumed permission disposing
  | builtin found => exact .builtin found
  | request cut guarded callbacks ownerBound cleanupBudget selected terminal requiredRights retained body =>
      exact .request cut guarded callbacks ownerBound cleanupBudget selected terminal requiredRights retained body
  | sequence first second ihFirst ihSecond => exact .sequence ihFirst ihSecond
  | choice left right ihLeft ihRight => exact .choice ihLeft ihRight
  | pureContinuation body ih => exact ih.plain_pure

/-- Both own-owner branches may have nonempty pure continuations. -/
theorem ClauseSchema.resume_or_discard
    (resumable : rights.resume = true) (disposable : rights.dispose = true)
    (disposing : contract.dispose = true) :
    ClauseSchema outward actions budget phases world installations owner rights contract resumeDemand captured tail
      (.choice (.sequence (Rows.invoke (key := ⟨owner, .resume⟩)) .pure)
        (.sequence (Rows.invoke (key := ⟨owner, .dispose⟩)) .pure))
      (.live (owner := owner) (resumeDemand := resumeDemand) captured tail) :=
  .choice (.sequence (.pureContinuation (.ownResume resumable)) .pure)
    (.sequence (.pureContinuation (.ownDiscard disposable disposing)) .pure)

/-- A builtin effect can precede an own-owner action; lookup is checked with
that actual action installed as the continuation frame. -/
theorem ClauseSchema.builtin_then_discard
    (found : select effect operation
      (.plain (Rows.invoke (key := ⟨owner, .dispose⟩))
        (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)) = some (.builtin identity))
    (disposable : rights.dispose = true) (disposing : contract.dispose = true) :
    ClauseSchema outward actions budget phases world installations owner rights contract resumeDemand captured tail
      (.sequence (Rows.request (effect := effect) (operation := operation))
        (Rows.invoke (key := ⟨owner, .dispose⟩)))
      (.live (owner := owner) (resumeDemand := resumeDemand) captured tail) :=
  .sequence (.builtin found) (.ownDiscard disposable disposing)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.ClauseSchema.compile_at_cut

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.ClauseSchema.resume_or_discard

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.ClauseSchema.builtin_then_discard

