namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyCapture (Scope)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyFrames (UnwindSource UnwindTemplate ClosingEffects)
open RecursiveRequirements (Requirements Template evaluate Checked)

/-- Static decoration for the scope forms admitted by UnwindSource.  The
existing return hints remain its erasure; no code or runtime stack is copied. -/
inductive Metadata : SourceDependencyCapture.Scope → Type where
  | nil : Metadata .nil
  | plain : Metadata rest → Metadata (.plain dependencies rest)
  | handler (activation : Nat) : Metadata rest → Metadata (.handler effect table families rest)
  | cell : Metadata rest → Metadata (.cell identity rest)
  | cleanup (latent : Footprint) : Metadata rest → Metadata (.cleanup needs callback rest)
  | live : Metadata captured → Metadata rest → Metadata (.live owner captured rest)
  | spent : Metadata rest → Metadata (.spent owner rest)
  | retiring (owner : Nat) : Metadata rest → Metadata (.running rest)

def Metadata.erase : Metadata scope → ReturnHints scope
  | .nil => .nil
  | .plain rest => .plain rest.erase
  | .handler _ rest => .handler rest.erase
  | .cell rest => .cell rest.erase
  | .cleanup _ rest => .cleanup rest.erase
  | .live saved rest => .live saved.erase rest.erase
  | .spent rest => .spent rest.erase
  | .retiring _ rest => .running .retire rest.erase

def Metadata.context : Metadata scope → OwnerPhases.Context
  | .nil => []
  | .plain rest => .ordinary (.barrier false) :: rest.context
  | @Metadata.handler rest effect table _ activation tail =>
      .ordinary (.handler effect activation table) :: tail.context
  | @Metadata.cell rest identity tail => .ordinary (.builtin identity) :: tail.context
  | .cleanup _ rest => .ordinary (.barrier false) :: rest.context
  | @Metadata.live captured _ owner _ rest => .live owner captured.held :: rest.context
  | @Metadata.spent _ owner rest => .spent owner :: rest.context
  | .retiring _ rest => .ordinary (.barrier true) :: rest.context

/-- Build only existing requirement syntax; interpretation is the existing
RecursiveRequirements evaluator. Saved scopes remain recursive metadata. -/
def Metadata.closing : Metadata scope → Template
  | .nil => ⟨[], .request [] []⟩
  | .plain rest | .handler _ rest | .cell rest => rest.closing
  | .cleanup latent rest =>
      ⟨[] ++ rest.closing.1,
        .sequence (.request rest.context (qualify true latent)) rest.closing.2⟩
  | @Metadata.live _ _ owner saved rest =>
      ⟨saved.closing.1 ++ ([owner] ++ rest.closing.1),
        .sequence (saved.closing.2.prepend (.ordinary (.barrier true) :: rest.context))
          (.sequence (.retire owner) rest.closing.2)⟩
  | @Metadata.spent _ owner rest =>
      ⟨[] ++ rest.closing.1, .sequence (.spent owner) rest.closing.2⟩
  | .retiring owner rest =>
      ⟨[owner] ++ rest.closing.1, .sequence (.retire owner) rest.closing.2⟩

/-- Agreement ties the generated cleanup requirements to the existing rich
source witness rather than trusting a user-provided footprint. -/
structure Agreement (operations : SourceDependencyAnnotations.Operations)
    (policy : Syntax.TicketPolicy) (contracts : SourceDependencyAnnotations.Contracts)
    (tables : CallableProtectionFrames.Tables) (families : SourceDependencyFrames.Families)
    (world : List Nat) {scope : SourceDependencyCapture.Scope} (metadata : Metadata scope) (stack : Stack)
    (demand : List Nat) (requirements : Requirements demand) : Prop where
  source : UnwindSource operations policy contracts tables families world stack demand requirements scope
  matching : ReturnHints.Matches tables families metadata.erase stack
  context_eq : metadata.context = OwnerPhases.ofStack tables stack
  requirements_eq : metadata.closing = ⟨demand, requirements⟩

theorem extract
    (source : UnwindSource operations policy contracts tables families world stack demand requirements scope) :
    ∃ metadata : Metadata scope, Agreement operations policy contracts tables families world metadata stack demand requirements := by
  induction source with
  | nil => exact ⟨.nil, ⟨.nil, .nil, rfl, rfl⟩⟩
  | plain tail ih =>
      obtain ⟨metadata, agreed⟩ := ih
      exact ⟨.plain metadata, ⟨.plain tail, .plain agreed.matching,
        by simpa [Metadata.context, OwnerPhases.ofStack, OwnerPhases.frameEntry,
          ExecFrame.erase, PlainData.erase, ProtectionContexts.frameProtected] using congrArg (List.cons (.ordinary (.barrier false))) agreed.context_eq,
        agreed.requirements_eq⟩⟩
  | @handler data answer residual rest demand requirements restScope declaration tail ih =>
      obtain ⟨metadata, agreed⟩ := ih
      refine ⟨.handler data.activation metadata, ⟨.handler declaration tail, .handler agreed.matching, ?_, agreed.requirements_eq⟩⟩
      simp only [Metadata.context, OwnerPhases.ofStack, OwnerPhases.frameEntry, agreed.context_eq]
  | cell tail ih =>
      obtain ⟨metadata, agreed⟩ := ih
      refine ⟨.cell metadata, ⟨.cell tail, .cell agreed.matching, ?_, agreed.requirements_eq⟩⟩
      simp only [Metadata.context, OwnerPhases.ofStack, OwnerPhases.frameEntry, agreed.context_eq]
  | @cleanup latent dependencies rest demand requirements restScope action callback tail ih =>
      obtain ⟨metadata, agreed⟩ := ih
      refine ⟨.cleanup latent metadata, ⟨.cleanup callback tail, .cleanup agreed.matching, ?_, ?_⟩⟩
      · simp [Metadata.context, OwnerPhases.ofStack, OwnerPhases.frameEntry, agreed.context_eq,
          ExecFrame.erase, ActionData.erase, ProtectionContexts.frameProtected]
      · change (fun body : Template => (⟨[] ++ body.1,
          .sequence (.request metadata.context (qualify true latent)) body.2⟩ : Template)) metadata.closing = _
        rw [agreed.requirements_eq, agreed.context_eq]
  | @live captured savedDemand savedRequirements savedScope rest tailDemand tailRequirements restScope owner input answer caller saved tail ihSaved ihTail =>
      obtain ⟨savedMeta, savedAgreed⟩ := ihSaved
      obtain ⟨tailMeta, tailAgreed⟩ := ihTail
      refine ⟨.live savedMeta tailMeta, ⟨.live saved tail,
        .live savedAgreed.matching tailAgreed.matching, ?_, ?_⟩⟩
      · simp only [Metadata.context, OwnerPhases.ofStack, tailAgreed.context_eq]
        rw [saved.realizes.held]
      · change (fun a b : Template => (⟨a.1 ++ ([owner] ++ b.1),
          .sequence (a.2.prepend (.ordinary (.barrier true) :: tailMeta.context))
            (.sequence (.retire owner) b.2)⟩ : Template)) savedMeta.closing tailMeta.closing = _
        rw [savedAgreed.requirements_eq, tailAgreed.requirements_eq, tailAgreed.context_eq]
        rfl
  | @spent rest demand requirements restScope owner answer caller tail ih =>
      obtain ⟨metadata, agreed⟩ := ih
      refine ⟨.spent metadata, ⟨.spent tail, .spent agreed.matching, ?_, ?_⟩⟩
      · simp only [Metadata.context, OwnerPhases.ofStack, agreed.context_eq]
      · exact congrArg (fun body : Template => (⟨[] ++ body.1,
          .sequence (.spent owner) body.2⟩ : Template)) agreed.requirements_eq
  | @retiring rest demand requirements restScope owner tail ih =>
      obtain ⟨metadata, agreed⟩ := ih
      refine ⟨.retiring owner metadata, ⟨.retiring tail, .running .retire agreed.matching, ?_, ?_⟩⟩
      · simp [Metadata.context, OwnerPhases.ofStack, OwnerPhases.frameEntry, agreed.context_eq,
          ExecFrame.erase, CloseItem.frame, ProtectionContexts.frameProtected]
      · exact congrArg (fun body : Template => (⟨[owner] ++ body.1,
          .sequence (.retire owner) body.2⟩ : Template)) agreed.requirements_eq

/-- A finite source-annotation check using the existing evaluator. Closing
requirements contain no invocation nodes, so no runtime store is supplied. -/
def Metadata.check (metadata : Metadata scope) (receiving : OwnerPhases.Context)
    (before : OwnerPhaseTransitions.Phases) (budget : Footprint) : Bool :=
  match evaluate [] receiving before metadata.closing.2 with
  | none => false
  | some row => row.all (fun request => decide (request ∈ budget))

theorem Metadata.check_iff (metadata : Metadata scope) :
    metadata.check receiving before budget = true ↔
      ∃ row, evaluate [] receiving before metadata.closing.2 = some row ∧ row ⊆ budget := by
  unfold Metadata.check
  cases checked : evaluate [] receiving before metadata.closing.2 with
  | none => simp
  | some row =>
      simp only [List.all_eq_true, decide_eq_true_eq, Option.some.injEq]
      constructor
      · intro included
        exact ⟨row, rfl, fun {_} member => included _ member⟩
      · rintro ⟨actual, rfl, included⟩
        exact fun _ member => included member

/-- Successful finite metadata checking originates the existing ClosingEffects
judgment. Receiving context is a parameter, so ordinary and protected closing
use this same theorem independently. -/
theorem Agreement.effects
    (agreed : Agreement operations policy contracts tables families world metadata stack demand requirements)
    (checked : metadata.check receiving before budget = true) :
    ClosingEffects budget receiving before requirements := by
  obtain ⟨row, evaluated, bounded⟩ := metadata.check_iff.mp checked
  have checkedSource :
      (fun body : Template => ∃ row, evaluate [] receiving before body.2 = some row ∧ row ⊆ budget)
        metadata.closing := ⟨row, evaluated, bounded⟩
  rw [agreed.requirements_eq] at checkedSource
  obtain ⟨row, evaluated, bounded⟩ := checkedSource
  exact agreed.source.template.effects_of_checked (RecursiveRequirements.evaluate_sound evaluated) bounded

/-- Both allocator contexts require finite source checks. Neither is inferred
from the other, and no ClosingEffects premise is assumed. -/
theorem Agreement.effects_pair
    (agreed : Agreement operations policy contracts tables families world metadata stack demand requirements)
    (ordinary : metadata.check receiving before budget = true)
    (protectedCheck : metadata.check (.ordinary (.barrier true) :: receiving) before budget = true) :
    ClosingEffects budget receiving before requirements ∧
    ClosingEffects budget (.ordinary (.barrier true) :: receiving) before requirements :=
  ⟨agreed.effects ordinary, agreed.effects protectedCheck⟩

/-- The two finite source checks reach the actual generated capture
annotation, retaining the existing normal and both lexical cleanup paths. -/
theorem Agreement.capture_annotation
    (agreed : Agreement operations policy contracts tables families world metadata stack closeDemand closingRequirements)
    (balance : resumeDemand.Perm (ownedTickets stack))
    (unique : (ownedTickets stack).Nodup)
    (ready : ∀ owner ∈ ownedTickets stack, before owner = .available)
    (normal : SourceDependencyAnnotations.RowAnnotation (requirements : Requirements resumeDemand) annotated)
    (checked : Checked (annotateDisposalStore entries) receiving before (annotateDisposals annotated) normalRow)
    (bounded : normalRow ⊆ budget)
    (ordinary : metadata.check receiving before budget = true)
    (protectedCheck : metadata.check (.ordinary (.barrier true) :: receiving) before budget = true) :
    ∃ combined : Requirements resumeDemand, ∃ row,
      SourceDependencyAnnotations.RowAnnotation requirements (annotateDisposals combined) ∧
      SourceDependencyAnnotations.RequirementPath (annotateDisposals annotated) (annotateDisposals combined) [] ∧
      SourceDependencyAnnotations.RequirementPath closingRequirements (annotateDisposals combined) [] ∧
      SourceDependencyAnnotations.RequirementPath
        (closingRequirements.prepend [.ordinary (.barrier true)]) (annotateDisposals combined) [] ∧
      Checked (annotateDisposalStore entries) receiving before (annotateDisposals combined) row ∧
      row ⊆ budget := by
  obtain ⟨ordinaryEffects, protectedEffects⟩ := agreed.effects_pair ordinary protectedCheck
  exact capture_annotation_from_effects agreed.source.template balance unique ready normal checked bounded
    ordinaryEffects protectedEffects

/-- The planned rich source already retains the typed callback witnesses used
for extraction. This bridge does not impose additional callback restrictions. -/
theorem extract_planned
    (source : PlannedUnwindSource operations policy contracts tables families required outward actions world
      stack demand requirements scope) :
    ∃ metadata : Metadata scope,
      Agreement operations.erase policy contracts.erase tables families world metadata stack demand requirements :=
  extract source.erase

/-- General planned source first reuses its existing lexical abandonment
extraction. Running callbacks excluded by UnwindPrefix remain excluded here. -/
theorem extract_from_planned_mode
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope)
    (scopes : LexicalUnwind.UnwindPrefix stack) :
    ∃ closingDemand, ∃ closingRequirements : Requirements closingDemand, ∃ metadata : Metadata scope,
      Agreement operations.erase policy contracts.erase tables families world metadata stack closingDemand closingRequirements := by
  obtain ⟨closingDemand, closingRequirements, cleanup⟩ := source.planned_unwind_source scopes
  obtain ⟨metadata, agreed⟩ := extract_planned cleanup
  exact ⟨closingDemand, closingRequirements, metadata, agreed⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints
