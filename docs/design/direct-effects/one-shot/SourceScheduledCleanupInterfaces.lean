        (capturedContext.append (frontContext.append (.spent (owner := owner) tailContext))) := by
  obtain ⟨middle, middleRows, frontDemand, tailDemand, frontRequirements, liveRequirements,
    frontSource, liveSource, frontRows, liveRows, demandSame, evaluation, generated⟩ :=
    rows.split_disposals_at frontContext
      (.live (owner := owner) (resumeDemand := resumeDemand) capturedContext tailContext) same frontRealized
  have frontMode := frontSource.return_mode
  cases liveRows with
  | live answerRows agreement inside tailRows =>
      have sameContract := Option.some.inj ((by assumption : contracts owner = some _).symm.trans known)
      subst_vars
      have liveRows := RecordPendingRows.live answerRows agreement inside tailRows
        (known := by assumption) (actionKnown := by assumption)
        (inputAnnotation := by assumption) (answerAnnotation := by assumption)
        (callerScope := by assumption) (held := by assumption) (answer := by assumption)
      obtain ⟨requirements, successor, successorRows, _⟩ :=
        frontRows.resume_recompose_ordinary liveRows rfl found ordinary
      exact ⟨_, requirements, successor, successorRows⟩
  | opening answerRows agreement ordinarySaved inside tailRows =>
      change LexicalUnwind.returnMode front .ordinary = .unwind at frontMode
      rw [frontOrdinary] at frontMode
