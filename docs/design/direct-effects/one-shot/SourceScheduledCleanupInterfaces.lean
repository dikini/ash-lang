  let nextAnnotated := Requirements.choice nextRequirements annotatedRoot (List.Perm.refl demand)
  exact ⟨nextScope, nextRequirements, nextAnnotated, nextHints, normalRow ++ certificateRow,
    newSame, newKnown, nextSource, nextMatch, nextPending, nextBound, .alternatives .original (.refl _),
    .choice nextCheck checked, List.append_subset.mpr ⟨within, List.Subset.refl _⟩, .no .here,
    balance, nextUnique, nextFinite, nextRecords, strongClosing, event, nextUsage, nextTickets, nextResources⟩

/-- Cleanup entry retains the exact generated annotation while reusing the
existing complete transition for capabilities, ownership and resource access. -/
theorem start_planned_cleanup_generated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.armed action) rest) .unwind output demand requirements scope)
    {hints : ReturnHints scope}
    (matching : ReturnHints.Matches tables families hints (.push (.armed action) rest))
    (pending : Pending outward actions (available (ownedTickets (.push (.armed action) rest))) world
      hints .nil .unwind output.mode)
    (bound : Bound annotations scope)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.armed action) rest) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world (.push (.armed action) rest) key body)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets (.push (.armed action) rest)))
      (annotateDisposals annotatedRoot) certificateRow)
    (finite : SourceContextualRechecking.checkForest required (.push (.armed action) rest) scope .nil = true)
    (unique : (ownedTickets (.push (.armed action) rest)).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.unwind runtimeScope (.push (.armed action) rest)))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope (.push (.armed action) rest)))
    (resources : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope (.push (.armed action) rest))) :
    ∃ latent dependencies, ∃ callbackPlan : Plan dependencies, ∃ nextScope,
    ∃ nextRequirements : Requirements demand,
    ∃ nextHints : ReturnHints (.running nextScope),
    let nextStack := Stack.push (.unwinding action) rest
    let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
    let combined := Requirements.sequence (callbackRequirements.prepend (OwnerPhases.ofStack tables nextStack)) nextRequirements
    ∃ annotatedNext : Requirements demand, ∃ nextRow,
      scope = .cleanup action.requests dependencies nextScope ∧
      Certified (evidence := declarationPolicy) outward world (.sequence .pure (.sequence .pure callbackPlan)) ∧
      SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
        (.app action.action .unit) .unit [] callbackRequirements (signature (.sequence .pure (.sequence .pure callbackPlan))) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world nextStack
        (.value .unit) output demand nextRequirements (.running nextScope) ∧
      ReturnHints.Matches tables families nextHints nextStack ∧
      Local outward actions (available (ownedTickets nextStack)) world (.sequence .pure (.sequence .pure dependencies)) nextHints ∧
      Pending outward actions (available (ownedTickets nextStack)) world nextHints .nil .ordinary output.mode ∧
      Bound annotations (.running nextScope) ∧
      RowAnnotation combined annotatedNext ∧
      RecursiveRequirements.Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets nextStack))
        (annotateDisposals annotatedNext) nextRow ∧
      nextRow ⊆ certificateRow ∧ RequirementPath annotatedRoot annotatedNext [] ∧
      demand.Perm (ownedTickets nextStack) ∧ (ownedTickets nextStack).Nodup ∧
      SourceContextualRechecking.checkForest required nextStack (.running nextScope) .nil = true ∧
      (∀ key body, (key, body) ∈ resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      (∀ key body, (key, body) ∈ disposals →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      LexicalUnwind.UseTransition (.unwind runtimeScope (.push (.armed action) rest))
        (.eval ⟨.app action.action .unit, .none, nextStack⟩) [] [] ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨.app action.action .unit, .none, nextStack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.app action.action .unit, .none, nextStack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨.app action.action .unit, .none, nextStack⟩) := by
  have erasedClosing := fun key body member => (closing key body member).erase
  have strongClosing : ∀ key body, (key, body) ∈ disposals →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.unwinding action) rest) key body := by
    intro key body member
    cases closing key body member with | dispose located held recorded source =>
      cases located with | push located => exact .dispose (.push located) held recorded source
  obtain ⟨oldLatent, dependencies, oldPlan, nextScope, oldRequirements, nextHints,
    oldAnnotated, oldRow, oldSame, oldCertified, oldExpression, oldSource, nextMatch,
    nextLocal, nextPending, nextBound, oldAnnotation, oldCheck, oldWithin, oldPath,
    balance, nextUnique, nextFinite, nextRecords, nextClosing, event, nextUsage, nextTickets, nextResources⟩ :=
    start_planned_cleanup source matching pending bound records erasedClosing (annotated_disposal_store storeAnnotation)
      (annotated_disposals annotation) checked finite unique usage tickets resources
  obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked checked
  obtain ⟨latent, newDependencies, callbackPlan, callbackRow, tailRow, newScope, tailRequirements, nextRequirements,
    newSame, certified, expression, tailSource, nextSource, appChecked, nextChecked, rowSame⟩ :=
    source.start_cleanup_generated normalCheck
  have dependenciesEq := (SourceDependencyCapture.Scope.cleanup.inj (newSame.symm.trans oldSame)).2.1
  have scopeEq := (SourceDependencyCapture.Scope.cleanup.inj (newSame.symm.trans oldSame)).2.2
  subst newDependencies
  subst newScope
  let combined := Requirements.sequence
    ((Requirements.emitAfter (Requirements.sequence (.request [] []) (.request [] [])) [] latent).prepend
      (OwnerPhases.ofStack tables (.push (.unwinding action) rest))) nextRequirements
  have combinedCheck : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets rest))
      (annotateDisposals combined) (callbackRow ++ tailRow) := by
    apply Checked.sequence
    · simpa only [annotateDisposals, disposal_prepend, List.append_nil, ownedTickets] using
        RecursiveRequirements.checked_prepend_iff.mpr appChecked
    · exact nextChecked
  let nextAnnotated := Requirements.choice combined annotatedRoot (List.Perm.refl demand)
  refine ⟨latent, dependencies, callbackPlan, nextScope, nextRequirements, nextHints, nextAnnotated,
    (callbackRow ++ tailRow) ++ certificateRow, newSame, ?_, expression, nextSource,
    nextMatch, nextLocal, nextPending, nextBound, .alternatives .original (.refl _),
    .choice combinedCheck checked, List.append_subset.mpr ⟨rowSame ▸ within, List.Subset.refl _⟩, .no .here,
    balance, nextUnique, nextFinite, nextRecords, strongClosing, event, nextUsage, nextTickets, nextResources⟩
  exact Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
    (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
