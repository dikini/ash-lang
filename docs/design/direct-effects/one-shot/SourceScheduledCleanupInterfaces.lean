    (resources : LexicalUnwind.MachineAccess ambient (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (frontBound : InternalUses (ownedTickets front ++ ownedTickets tail) front.erase.pending)
    (internal : InternalUses captured.erase.liveTickets captured.erase.pending)
    (tailBound : InternalUses (ownedTickets tail) tail.erase.pending) :
    let nextStack := captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail)))
    let after := available (ownedTickets nextStack)
    LexicalUnwind.UseTransition (.eval
      ⟨.discard binder, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩)
      (.unwind runtimeScope nextStack) [.close identity] [.ticket owner] ∧
    LexicalUnwind.MachineUse policy actions (.unwind runtimeScope nextStack) ∧
    LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope nextStack) ∧
    LexicalUnwind.MachineAccess ambient (.unwind runtimeScope nextStack) ∧
    StoreAnnotation (RecursiveTransport.removeOwner owner (resumes ++ disposals))
      (RecursiveTransport.removeOwner owner annotatedStore) ∧
    ∃ nextScope, ∃ nextHints : ReturnHints nextScope,
    ∃ requirements annotatedNext : Requirements (contract.closeDemand ++ pendingDemand), ∃ row annotatedRow,
      PlannedModeSource operations policy contracts tables families required outward actions world nextStack
        .unwind output (contract.closeDemand ++ pendingDemand) requirements nextScope ∧
      Matches tables families nextHints nextStack ∧
      Pending outward actions after world nextHints .nil .unwind output.mode ∧
      Bound annotations nextScope ∧
      RowAnnotation requirements annotatedNext ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) [] after (annotateDisposals requirements) row ∧ row ⊆ certificateRow ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner annotatedStore)) [] after (annotateDisposals annotatedNext) annotatedRow ∧ annotatedRow ⊆ certificateRow ∧
      (∃ retained : Requirements pendingDemand,
        RowAnnotation pendingRequirements retained ∧
        RequirementPath retained annotatedRoot (owner :: contract.closeDemand) ∧
        RequirementPath retained annotatedNext contract.closeDemand) ∧
      (∃ savedAnnotated : Requirements contract.closeDemand,
        RowAnnotation recordedRequirements savedAnnotated ∧
        RequirementPath (savedAnnotated.prepend (OwnerPhases.ofStack tables
          (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) annotatedNext []) ∧
      Trace (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) [owner] after ∧
      (ownedTickets nextStack).Nodup ∧
      (contract.closeDemand ++ pendingDemand).Perm (ownedTickets nextStack) ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner disposals →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) := by
  dsimp only
  have protectedPath : RequirementPath
      ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail))))
      (annotateDisposals annotatedRoot) [] := annotated_disposal_path annotation (.first .here)
  have runtimeKnown : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope := by
    cases runtimeScope with
    | none => cases resolved
    | ticket localBinder actual =>
      simp only [Execution.Scope.resolve] at resolved
      split at resolved
      · cases Option.some.inj resolved
        exact ⟨_, .bound (CoherentSourceTypes.Owners.ports_lookup
          (SourceDependencyAnnotations.contract_erase_known (SourcePlannedSources.contract_erase_known known)))⟩
      · cases resolved
  have unprotected : ProtectionContexts.protectedMode captured.erase = false := by
    cases closing _ _ (SourceTemplates.lookup_member found) with
    | dispose located held recorded cleanup =>
      cases SourceTemplates.captured_in_unique unique located (RecursiveRecords.located_below front .here)
      exact held
  have resumeModes : ∀ key body, (key, body) ∈ resumes → key.mode = .resume := by
    intro key body member
    cases records key body member
    rfl
  obtain ⟨normalRow, normalCheck, normalBound⟩ := (annotated_disposals annotation).checked certificate
  obtain ⟨_, originalCheck, _⟩ := (annotated_disposal_store storeAnnotation).checked normalCheck
  have balanced := SourceDependencySchemes.Lexical.mode_source_ownership_balance
    (SourcePlannedSources.expression_erase current) source.erase
    (fun key body member => (records key body member).erase)
    (fun key body member => (closing key body member).erase) unique originalCheck
  obtain ⟨retained, retainedAnnotation, retainedPath⟩ := annotation.focus
    (show RequirementPath pendingRequirements
      (.sequence ((Requirements.invoke ⟨owner, .dispose⟩ contract.closeDemand []).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) pendingRequirements)
      (owner :: contract.closeDemand) from by simpa only [List.append_nil] using
        (RequirementPath.second (.here : RequirementPath pendingRequirements pendingRequirements [])))
  obtain ⟨waitingRow, waitingCheck, waitingBound⟩ := (disposal_subtree_path retainedPath).checked certificate
  obtain ⟨closeRow, closeCheck, closeBound⟩ := protectedPath.checked certificate
  have actualInvocation : Checked (annotateDisposalStore annotatedStore)
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      (.invoke ⟨owner, .dispose⟩ contract.closeDemand [.ordinary (.barrier true)]) closeRow := by
    simpa only [List.append_nil, spendAll] using RecursiveRequirements.checked_prepend_iff.mp closeCheck
  obtain ⟨frontScope, capturedScope, tailScope, requirements, annotatedNext, row, annotatedRow,
    cut, frontSource, nextSource, nextBound, nextAnnotation, nextCheck, annotatedCheck, rowBound,
    annotatedBound, kept, saved, captureBalance⟩ :=
    discard_planned_fragments_checked_generated source known unprotected runtimeKnown storeAnnotation resumeModes closing found bound unique
      actualInvocation retainedAnnotation waitingCheck
  have phaseSame : available (ownedTickets (captured.append (.push (.closing identity runtimeScope)
      (front.append (.spent owner answerType caller tail))))) =
      spend (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) owner := by
    simpa only [owned_tickets_append, ownedTickets, spendAll] using
      OwnerPhaseTransitions.trace_result (OwnerPhaseTransitions.resume_phase_trace unique)
  rw [← phaseSame] at nextCheck annotatedCheck
  have nextUnique : (ownedTickets (captured.append (.push (.closing identity runtimeScope)
      (front.append (.spent owner answerType caller tail))))).Nodup := by
    simpa only [owned_tickets_append, ownedTickets] using
      (List.nodup_cons.mp (OwnerPhaseTransitions.resume_owned_permutation.nodup unique)).2
  have nextBalance : (contract.closeDemand ++ pendingDemand).Perm
      (ownedTickets (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answerType caller tail))))) := by
    apply List.Perm.cons_inv (a := owner)
    simpa only [owned_tickets_append, ownedTickets, List.cons_append] using
      balanced.trans OwnerPhaseTransitions.resume_owned_permutation
  have trace : Trace (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      [owner] (available (ownedTickets (captured.append (.push (.closing identity runtimeScope)
        (front.append (.spent owner answerType caller tail)))))) := by
    simpa only [owned_tickets_append, ownedTickets] using OwnerPhaseTransitions.resume_phase_trace unique
  obtain ⟨nextHints, nextMatch, nextPending⟩ := discard_pending_at_cut (identity := identity)
    (runtimeScope := runtimeScope) localCheck matching cut frontSource
  have returnMode : hints.returnMode .ordinary = output.mode := matching.return_mode.trans source.return_mode
  rw [← phaseSame, returnMode] at nextPending
  have event := LexicalUnwind.UseTransition.discard binder owner identity runtimeScope caller inputType answerType
    front captured tail resolved unprotected frontBound internal tailBound
  have nextUsage := LexicalUnwind.discard_machine_use (identity := identity) usage resolved unique unprotected frontBound internal tailBound
  have nextTickets := event.ticket_access (policy := policy) (tickets := actions)
    (by intro other impossible; simp at impossible) unique usage tickets
  have nextResources : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope
      (captured.append (.push (.closing identity runtimeScope) (front.append (.spent owner answerType caller tail))))) := by
    cases resources with | eval supported => exact .unwind (LexicalUnwind.discard_access supported.control)
  have covered : closeRow ++ waitingRow ⊆ certificateRow := List.append_subset.mpr ⟨closeBound, waitingBound⟩
  exact ⟨event, nextUsage, nextTickets, nextResources, storeAnnotation.remove_owner owner,
    _, nextHints, requirements, annotatedNext, row, annotatedRow, nextSource, nextMatch, nextPending, nextBound,
    nextAnnotation, nextCheck, rowBound.trans covered, annotatedCheck, annotatedBound.trans covered,
    ⟨retained, retainedAnnotation, retainedPath, kept⟩, saved, trace, nextUnique, nextBalance,
    planned_resume_records_discard records, planned_unwind_records_discard closing⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.discard_planned_fragments_checked_generated

