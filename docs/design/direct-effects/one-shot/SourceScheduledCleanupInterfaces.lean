/-- Only caller shape is needed for physical unwind-source reconstruction.
Ownership accounting and callback source checks are separate judgments. -/
def ResumeShape (savedMode : UseMode) {hints : ReturnHints scope}
    (front : Context hints) : Bool :=
  match savedMode with
  | .ordinary => true
  | .unwind => front.closing?.isSome

theorem ResumeShape.ordinary : ResumeShape .ordinary front = true := rfl

theorem ResumeShape.unwind_iff :
    ResumeShape .unwind front = true ↔ ∃ metadata, front.closing? = some metadata := by
  cases found : front.closing? <;> simp [ResumeShape, found]

theorem ResumeShape.empty_front : ResumeShape mode Context.nil = true := by
  cases mode <;> rfl

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeShape.ordinary
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeShape.unwind_iff
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeShape.empty_front

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

/-- The former scalar guard implies the structural guard. Its numerical
bound remains a separate hypothesis for the legacy scalar-row results. -/
theorem ResumeBudget.shape
    (checked : ResumeBudget budget before owner demand mode front tail = true) :
    ResumeShape mode front = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
      obtain ⟨metadata, found, _accepted⟩ := ResumeBudget.unwind_iff.mp checked
      exact ResumeShape.unwind_iff.mpr ⟨metadata, found⟩

theorem ResumeShape.plain
    (related : Plain front nextFront) (checked : ResumeShape mode front = true) :
    ResumeShape mode nextFront = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
      obtain ⟨metadata, found⟩ := ResumeShape.unwind_iff.mp checked
      obtain ⟨next, nextFound, _⟩ := related.metadata found
      exact ResumeShape.unwind_iff.mpr ⟨next, nextFound⟩

theorem ResumeShape.history
    (related : SpentTransport.SpentHistory owner front nextFront)
    (checked : ResumeShape mode front = true) :
    ResumeShape mode nextFront = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
      obtain ⟨metadata, found⟩ := ResumeShape.unwind_iff.mp checked
      obtain ⟨next, nextFound, _⟩ := related.metadata found
      exact ResumeShape.unwind_iff.mpr ⟨next, nextFound⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

