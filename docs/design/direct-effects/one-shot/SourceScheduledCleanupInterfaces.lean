/-- Disposal checks the same lexical fragments selected by source admission. -/
theorem Accounting.Run.discard_at
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
    (run : Accounting.Run world installations (Rows.invoke (key := ⟨owner, .dispose⟩))
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail))
      (root : Requirements demand))
    (located : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
      ⟨frontScope, capturedScope, tailScope⟩)
    (checked : Checked (annotateDisposalStore entries) receiving phases (annotateDisposals root) row) :
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand,
      demand = owner :: nextDemand ∧
      Accounting.Wait world installations
        (captured.append (.closing (front.append (.spent (owner := owner) tail)))) .unwind nextRoot ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner entries)) receiving
        (spend phases owner) (annotateDisposals nextRoot) row := by
  obtain ⟨⟨actualFrontScope, actualFrontHints, actualFront⟩,
    ⟨actualCapturedScope, actualCapturedHints, actualCaptured⟩,
    ⟨actualTailScope, actualTailHints, actualTail⟩,
    actualDemand, nextDemand, nextRoot, same, actualLocated, demandEq, waiting, nextCheck⟩ :=
    run.dispose_accounting checked
  obtain ⟨rfl, rfl, rfl⟩ := owner_cut_scope_parts actualLocated located
  obtain ⟨frontSame, liveSame⟩ := context_append_pack_injective front actualFront
    (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail)
    (Context.live (owner := owner) (resumeDemand := actualDemand) actualCaptured actualTail) same
  have hintsSame := eq_of_heq (Packed.mk.inj liveSame).2.1
  obtain ⟨capturedHintsSame, tailHintsSame⟩ := ReturnHints.live.inj hintsSame
  cases capturedHintsSame
  cases tailHintsSame
  have contextsSame := eq_of_heq (Packed.mk.inj liveSame).2.2
  obtain ⟨demandSame, capturedSame, tailSame⟩ := Context.live.inj contextsSame
  cases demandSame
  cases capturedSame
  cases tailSame
  refine ⟨nextDemand, nextRoot, demandEq, ?_, nextCheck⟩
  have sameContext := congrArg
    (fun p : Packed => (actualCaptured.append (.closing (p.context.append (.spent (owner := owner) actualTail)))).pack)
    frontSame
  exact (congrArg (fun p : Packed => Accounting.Wait world installations p.context .unwind nextRoot)
    sameContext).mpr waiting

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.discard_at


