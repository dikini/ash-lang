/-- A fresh owner's permissions extend the registry without changing any
existing source's rights, receiver, phases or cleanup budget. -/
private theorem inserted_extension
    (extension : Syntax.UsageExtension actions nextActions) :
    Syntax.UsageExtension (actions.insert owner rights) (nextActions.insert owner rights) := by
  intro name old known
  by_cases same : name = owner
  · subst name
    simpa [Syntax.UsageTickets.insert] using known
  · simp only [Syntax.UsageTickets.insert, if_neg same] at known ⊢
    exact extension _ _ known


private theorem fresh_before
    (extension : Syntax.UsageExtension actions nextActions)
    (fresh : nextActions owner = none) : actions owner = none := by
  cases known : actions owner with
  | none => rfl
  | some rights =>
    have impossible := extension owner rights known
    rw [fresh] at impossible
    cases impossible


theorem Code.permissions
    (checked : Code outward actions budget phases world installations rows context)
    (extension : Syntax.UsageExtension actions nextActions) :
    Code outward nextActions budget phases world installations rows context := by
  refine (Code.rec
    (motive_1 := fun actions budget phases world installations {dependencies checking} rows {scope hints} context _ =>
      ∀ nextActions, Syntax.UsageExtension actions nextActions →
        Code outward nextActions budget phases world installations rows context)
    (motive_2 := fun actions budget phases world installations {scope outsideScope hints external} context outside before after _ =>
      ∀ nextActions, Syntax.UsageExtension actions nextActions →
        Pending outward nextActions budget phases world installations context outside before after)
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    (t := checked)) nextActions extension
  · intros; exact .pure
  · intros; exact .builtin (by assumption)
  · intros
    rename_i selected terminal requiredRights retained body ihCallbacks ihRetained ihBody nextActions extension
    refine .request (by assumption) (by assumption)
      (fun disposing => ihCallbacks disposing nextActions extension) (by assumption) (by assumption)
      selected terminal requiredRights (ihRetained nextActions extension) ?_
    intro owner demand fresh absent
    have oldFresh : _ := fresh_before extension fresh
    exact ihBody owner demand oldFresh absent _ (inserted_extension extension)
  · intros
    rename_i located known permission available resumeBudget restored ih nextActions extension
    exact .resume located (extension _ _ known) permission available resumeBudget (ih nextActions extension)
  · intros
    rename_i located known permission available unprotected abandoned waiting ihAbandoned ihWaiting nextActions extension
    exact .dispose located (extension _ _ known) permission available unprotected
      (ihAbandoned nextActions extension) (ihWaiting nextActions extension)
  · intros
    rename_i first second ihFirst ihSecond nextActions extension
    exact .sequence (ihFirst nextActions extension) (ihSecond nextActions extension)
  · intros
    rename_i first second ihFirst ihSecond nextActions extension
    exact .choice (ihFirst nextActions extension) (ihSecond nextActions extension)
  · intros
    rename_i body ih nextActions extension
    exact .handler (fun activation fresh => ih activation fresh nextActions extension)
  · intros
    rename_i body callback ihBody ihCallback nextActions extension
    exact .cleanup (ihBody nextActions extension) (ihCallback nextActions extension)
  · intros
    rename_i body ih nextActions extension
    exact .resource (fun identity fresh => ih identity fresh nextActions extension)
  · intros; exact .nil
  · intros
    rename_i code tail ihCode ihTail nextActions extension
    exact .plain (ihCode nextActions extension) (ihTail nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .skipped (ih nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .handler (ih nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .cell (ih nextActions extension)
  · intros
    rename_i callback tail ihCallback ihTail nextActions extension
    exact .cleanup (ihCallback nextActions extension) (ihTail nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .normal (ih nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .unwinding (ih nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .closing (ih nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .retiring (ih nextActions extension)
  · intros
    rename_i saved tail ihSaved ihTail nextActions extension
    exact .live (ihSaved nextActions extension) (ihTail nextActions extension)
  · intros
    rename_i saved tail ihSaved ihTail nextActions extension
    exact .opening (ihSaved nextActions extension) (ihTail nextActions extension)
  · intros
    rename_i tail ih nextActions extension
    exact .spent (ih nextActions extension)

theorem Pending.permissions
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints externalScope} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside before after)
    (extension : Syntax.UsageExtension actions nextActions) :
    Pending outward nextActions budget phases world installations context outside before after := by
  induction context generalizing externalScope before after with
  | nil => cases checked; exact .nil
  | plain rows rest ih => cases checked with
    | plain code tail => exact .plain (code.permissions extension) (ih tail)
    | skipped tail => exact .skipped (ih tail)
  | handler activation rows rest ih => cases checked with
    | handler tail => exact .handler (ih tail)
  | cell rest ih => cases checked with
    | cell tail => exact .cell (ih tail)
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback tail => exact .cleanup (callback.permissions extension) (ih tail)
  | normal rest ih => cases checked with
    | normal tail => exact .normal (ih tail)
  | unwinding rest ih => cases checked with
    | unwinding tail => exact .unwinding (ih tail)
  | closing rest ih => cases checked with
    | closing tail => exact .closing (ih tail)
  | retiring owner rest ih => cases checked with
    | retiring tail => exact .retiring (ih tail)
  | live saved rest ihSaved ihRest => cases checked with
    | live captured tail => exact .live (ihSaved captured) (ihRest tail)
    | opening captured tail => exact .opening (ihSaved captured) (ihRest tail)
  | spent rest ih => cases checked with
    | spent tail => exact .spent (ih tail)

