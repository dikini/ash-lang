namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts Value)
open SourcePlannedFrames (Families DependencyScope)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open SourcePlannedChecks (Certified)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available)
open RecursiveExpressions (Ready)

/-- The joined source component fixes the same source, signature, stack, return
hints, annotation and checked store. Source admission still has to construct
capture/caller alternatives and support/locality evidence; this component is
not a replacement for those source obligations. -/
inductive JoinedSource (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables) (families : Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance)
    (actions : Syntax.UsageTickets) (annotations : Nat → Option DependencyScope)
    (world : List Nat) (annotatedStore : Store) (budget : Footprint) (output : PlannedModeValue) :
    LexicalUnwind.Machine → Prop where
  | eval {plan : Plan dependencies} {hints : ReturnHints receiving}
      (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
        code input currentDemand currentRequirements (signature plan))
      (certified : Certified (evidence := declarationPolicy) outward world plan)
      (scopeTyped : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
      (pending : PlannedModeSource operations policy contracts tables families required outward actions world
        stack (.value input) output pendingDemand pendingRequirements receiving)
      (localCheck : Local outward actions (available (ownedTickets stack)) world dependencies hints)
      (retained : Pending outward actions (available (ownedTickets stack)) world hints .nil .ordinary output.mode)
      (matching : ReturnHints.Matches tables families hints stack)
      (bound : Bound annotations receiving)
      (finite : SourceContextualRechecking.checkForest required stack receiving .nil = true)
      (annotation : RowAnnotation
        (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
      (checked : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
        (annotateDisposals annotated) row)
      (bounded : row ⊆ budget) :
      JoinedSource operations policy contracts tables families required outward actions annotations world annotatedStore budget output
        (.eval ⟨code, runtimeScope, stack⟩)
  | unwind {hints : ReturnHints receiving}
      (pending : PlannedModeSource operations policy contracts tables families required outward actions world
        stack .unwind output demand requirements receiving)
      (retained : Pending outward actions (available (ownedTickets stack)) world hints .nil .unwind output.mode)
      (matching : ReturnHints.Matches tables families hints stack)
      (bound : Bound annotations receiving)
      (finite : SourceContextualRechecking.checkForest required stack receiving .nil = true)
      (annotation : RowAnnotation requirements annotated)
      (checked : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
        (annotateDisposals annotated) row)
      (bounded : row ⊆ budget) :
      JoinedSource operations policy contracts tables families required outward actions annotations world annotatedStore budget output
        (.unwind runtimeScope stack)

/-- Shared operational evidence for the selected lexical machine. Every store
record refers to this machine's physical stack and every phase is its available
owner map. The lifetime ledger and handler activation history remain distinct.
Full admitted-state preservation additionally needs the outstanding structural
source evidence at capture, unwind resumption and resource boundaries. -/
structure JoinedState (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables) (families : Families)
    (required : SourceContextualRechecking.Required) (outward : List Instance)
    (annotations : Nat → Option DependencyScope) (world ambient history : List Nat)
    (resumes disposals annotatedStore : Store) (budget : Footprint) (output : PlannedModeValue)
    (run : LexicalUnwind.UseRunState) : Prop where
  source : JoinedSource operations policy contracts tables families required outward run.tickets annotations world annotatedStore budget output run.execution.machine
  resumeRecords : ∀ key body, (key, body) ∈ resumes →
    PlannedResumeAnnotated operations policy contracts tables families required outward run.tickets annotations world run.execution.machine.stack key body
  unwindRecords : ∀ key body, (key, body) ∈ disposals →
    PlannedUnwindAnnotated operations policy contracts tables families required outward run.tickets annotations world run.execution.machine.stack key body
  storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore
  lifetime : LexicalUnwind.UseRunInvariant policy run
  tickets : LexicalUnwind.MachineTicketAccess policy run.tickets run.execution.machine
  resources : LexicalUnwind.MachineAccess ambient run.execution.machine
  activations : run.execution.machine.stack.erase.activations ⊆ history
  issuedResources : ScopedTyping.resourceWorld run.execution.issued ⊆ world

/-- One shared computation proof covers bind, beta and both branch choices.
It packages the existing conditional connection without new successor premises
and preserves the complete shared ledger, stores, scopes and phase alignment. -/
theorem JoinedState.computation
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output ⟨⟨.eval before, issued, completed⟩, actions⟩)
    (ready : Ready before.expression) (step : RawStep before after [] []) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output ⟨⟨.eval after, issued, completed⟩, actions⟩ := by
  rcases before with ⟨code, runtimeScope, stack⟩
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    obtain ⟨ticket, scopeTyped⟩ := scopeTyped
    obtain ⟨nextDemand, nextRequirements, nextDependencies, nextPlan, nextTicket, nextAnnotated, nextRow,
      currentNext, certifiedNext, scopeNext, pendingNext, demands, stackSame, annotationNext,
      rawPath, generatedPath, checkedNext, included, localNext, retainedNext, matchingNext, boundNext,
      resumesNext, disposalsNext, raw, transition, owners, usageNext, ticketsNext, resourcesNext⟩ :=
      computation_planned_generated current pending scopeTyped ready step certified localCheck retained matching
        bound annotation checked state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨code, runtimeScope, stack⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval after, issued, completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step (before := ⟨⟨.eval ⟨code, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, (fun key body member => resumesNext key body (state.resumeRecords key body member)),
      (fun key body member => disposalsNext key body (state.unwindRecords key body member)),
      state.storeAnnotation, event.preserves state.lifetime, ticketsNext, resourcesNext, ?_, state.issuedResources⟩
    · exact JoinedSource.eval currentNext certifiedNext ⟨nextTicket, scopeNext⟩ pendingNext
        (by simpa only [stackSame] using localNext) (by simpa only [stackSame] using retainedNext)
        matchingNext boundNext (by simpa only [stackSame] using finite) annotationNext
        (by simpa only [stackSame] using checkedNext) (included.trans bounded)
    · simpa only [LexicalUnwind.Machine.stack, stackSame] using state.activations

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.JoinedState.computation

