/-- Splitting exact decorated contexts retains one shared mode and its value
metadata, and both ordinary and generated requirement evaluations. -/
theorem PendingRows.split_disposals
    {whole : ReturnHints scope} {context : Context whole}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context) :
    ∀ {firstScope secondScope} {first : ReturnHints firstScope} {second : ReturnHints secondScope}
      (head : Context first) (tail : Context second),
      context.pack = (head.append tail).pack →
    ∃ captured rest, ∃ middle, ∃ middleRows : ModeRowsValue middle,
    ∃ firstDemand secondDemand, ∃ firstRequirements : Requirements firstDemand,
    ∃ secondRequirements : Requirements secondDemand,
    ∃ firstSource : PlannedModeSource operations policy contracts tables families required outward actions world
      captured input middle firstDemand firstRequirements firstScope,
    ∃ secondSource : PlannedModeSource operations policy contracts tables families required outward actions world
      rest middle output secondDemand secondRequirements secondScope,
      stack = captured.append rest ∧
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        firstSource inputRows middleRows head ∧
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        secondSource middleRows outputRows tail ∧
      demand = firstDemand ++ secondDemand ∧
      (∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables rest ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals requirements) =
          merge (evaluate store (OwnerPhases.ofStack tables rest ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  induction rows with
  | nil =>
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      refine ⟨.nil, .nil, _, _, [], [], .request [] [], .request [] [], .nil, .nil, rfl, .nil, .nil, rfl, ?_, ?_⟩
      all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
  | push frame remaining ih =>
      have full := PendingRows.push frame remaining
      cases frame with
      | ordinary checked | handler checked =>
          cases checked
          all_goals
            intro firstScope secondScope first second head tail same
            cases head <;> cases same
            all_goals first
            | solve
              | refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
                all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
            | obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
                firstRequirements, secondRequirements, firstSource, secondSource,
                equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
              subst_vars
              refine ⟨_, outside, middle, middleRows, _, secondDemand, _, secondRequirements, .push (by first | exact .ordinary (by constructor <;> assumption) | exact .handler (by constructor <;> assumption)) firstSource, secondSource,
                rfl, .push (frame := by first | exact .ordinary (by constructor <;> assumption) | exact .handler (by constructor <;> assumption)) ?_ inside, restRows, ?_, ?_, ?_⟩
              · first
                | exact .ordinary (by constructor <;> assumption)
                | exact .handler (by constructor <;> assumption)
              · simp only [List.append_assoc]
              · intro store receiving phases
                simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
                  OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
              · intro store receiving phases
                simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                  RecursiveRequirements.evaluate_prepend, OwnerPhases.stack_append, List.append_assoc,
                  generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
      | unwinding checked | closing | retiring | skipped | cell | cleanup checked =>
          intro firstScope secondScope first second head tail same
          cases head <;> cases same
          all_goals first
          | solve
            | refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
              all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
          | obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
              firstRequirements, secondRequirements, firstSource, secondSource,
              equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
            subst_vars
            refine ⟨_, outside, middle, middleRows, _, secondDemand, _, secondRequirements, .push (by constructor <;> assumption) firstSource, secondSource,
              rfl, .push (frame := by constructor <;> assumption) ?_ inside, restRows, ?_, ?_, ?_⟩
            · constructor <;> assumption
            · simp only [List.append_assoc]
            · intro store receiving phases
              simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
                OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
            · intro store receiving phases
              simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                RecursiveRequirements.evaluate_prepend, OwnerPhases.stack_append, List.append_assoc,
                generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
  | live aligned saved remaining ihSaved ihTail =>
      have full := PendingRows.live (resumeDemand := by assumption) (actionKnown := by assumption) (inputAnnotation := by assumption)
        (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption)
        (answer := by assumption) aligned saved remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ihTail _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, firstDemand, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .live (actionKnown := by assumption) (inputAnnotation := by assumption)
            (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption)
            (answer := by assumption) aligned saved inside, restRows, rfl, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | opening saved remaining ihSaved ihTail =>
      rename_i owner inputType answerType caller resumeDemand savedSource tailSource
      have full := PendingRows.opening (resumeDemand := resumeDemand) (owner := owner) (input := inputType) (answer := answerType) (caller := caller) saved remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ihTail _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, _, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .opening saved inside, restRows, ?_, ?_, ?_⟩
        · simp only [List.append_assoc]
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, evaluation,
            PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
        · intro store receiving phases
          simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, generatedEvaluation,
            PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
  | spent remaining ih =>
      have full := PendingRows.spent (annotation := by assumption) (callerScope := by assumption) remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, firstDemand, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .spent (annotation := by assumption) (callerScope := by assumption) inside, restRows, rfl, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | skippedSpent remaining ih =>
      rename_i owner answerType caller
      have full := PendingRows.skippedSpent (owner := owner) (answerType := answerType) (caller := caller) remaining
      intro firstScope secondScope first second head tail same
      cases head <;> cases same
      · refine ⟨.nil, _, _, _, [], _, .request [] [], _, .nil, _, rfl, .nil, full, rfl, ?_, ?_⟩
        all_goals intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
      · obtain ⟨captured, outside, middle, middleRows, firstDemand, secondDemand,
          firstRequirements, secondRequirements, firstSource, secondSource,
          equal, inside, restRows, sameDemand, evaluation, generatedEvaluation⟩ := ih _ _ rfl
        subst_vars
        refine ⟨_, outside, middle, middleRows, firstDemand, secondDemand, _, secondRequirements, _, secondSource,
          rfl, .skippedSpent inside, restRows, rfl, ?_, ?_⟩
        · intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
        · intro store receiving phases
          simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.split_disposals

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements evaluate evaluateFuel)

/-- False barriers mark transparent lexical frames. Removing them is only a
proof normalization of receiving contexts, never a change to runtime unwinding. -/
private def stripPlain (context : OwnerPhases.Context) : OwnerPhases.Context :=
  context.filter (fun entry => entry != .ordinary (.barrier false))

private theorem stripPlain_append (first second : OwnerPhases.Context) :
    stripPlain (first ++ second) = stripPlain first ++ stripPlain second := List.filter_append first second

private theorem export_append (first second : OwnerPhases.Context) phases raw :
    OwnerSource.exportAt (first ++ second) phases raw =
      (OwnerSource.exportAt first phases raw).bind (OwnerSource.exportAt second phases) := by
  simp only [OwnerSource.exportAt, OwnerPhaseTransitions.project_append, residual_append]
  cases residualize (OwnerPhaseTransitions.project first phases) raw <;> rfl

private theorem export_stripPlain (context : OwnerPhases.Context) phases raw :
    OwnerSource.exportAt (stripPlain context) phases raw = OwnerSource.exportAt context phases raw := by
  induction context generalizing raw with
  | nil => rfl
  | cons entry rest ih =>
      by_cases plain : entry = .ordinary (.barrier false)
      · subst entry
        simpa only [stripPlain, List.filter_cons, bne_self_eq_false, Bool.false_eq_true, if_false,
          OwnerSource.plain_export] using ih (raw := raw)
      · have same : stripPlain (entry :: rest) = entry :: stripPlain rest := by simp [stripPlain, plain]
        rw [same]
        change OwnerSource.exportAt ([entry] ++ stripPlain rest) phases raw = OwnerSource.exportAt ([entry] ++ rest) phases raw
        rw [export_append, export_append]
        cases OwnerSource.exportAt [entry] phases raw <;> simp only [Option.bind_none, Option.bind_some, ih]

private theorem export_strip_congr (same : stripPlain first = stripPlain second) phases raw :
    OwnerSource.exportAt first phases raw = OwnerSource.exportAt second phases raw := by
  exact (export_stripPlain first phases raw).symm.trans
    ((congrArg (fun context => OwnerSource.exportAt context phases raw) same).trans
      (export_stripPlain second phases raw))

private theorem empty_evaluateFuel_congr (requirements : Requirements demand)
    (same : stripPlain first = stripPlain second) fuel phases :
    evaluateFuel fuel [] first phases requirements = evaluateFuel fuel [] second phases requirements := by
  induction requirements generalizing phases with
  | request nearer raw =>
      simp only [evaluateFuel]
      exact export_strip_congr (first := nearer ++ first) (second := nearer ++ second)
        (by simp only [stripPlain_append, same]) phases raw
  | retire | spent => simp only [evaluateFuel]
  | invoke key demand nearer => cases fuel <;> simp only [evaluateFuel, RecursiveRequirements.lookup]
  | sequence left right ihLeft ihRight => simp only [evaluateFuel, ihLeft, ihRight]
  | emitAfter body nearer raw ih =>
      simp only [evaluateFuel, ih]
      rw [export_strip_congr (first := nearer ++ first) (second := nearer ++ second)
        (by simp only [stripPlain_append, same])]
  | choice left right aligned ihLeft ihRight => simp only [evaluateFuel, ihLeft, ihRight]

private theorem empty_evaluate_congr (requirements : Requirements demand)
    (same : stripPlain first = stripPlain second) phases :
    evaluate [] first phases requirements = evaluate [] second phases requirements :=
  empty_evaluateFuel_congr requirements same _ phases


private theorem empty_request : evaluate [] receiving phases (.request nearer raw) =
    OwnerSource.exportAt (nearer ++ receiving) phases raw := by
  simp only [evaluate, evaluateFuel]

private inductive MetaPlain : {firstScope secondScope : SourceDependencyCapture.Scope} →
    CleanupHints.Metadata firstScope → CleanupHints.Metadata secondScope → Prop where
  | same (metadata) : MetaPlain metadata metadata
  | add (related : MetaPlain first second) : MetaPlain first (.plain (dependencies := dependencies) second)
  | plain (related : MetaPlain first second) : MetaPlain (.plain (dependencies := dependencies) first) (.plain (dependencies := dependencies) second)
  | handler (related : MetaPlain first second) : MetaPlain
      (.handler (effect := effect) (table := table) (families := families) activation first) (.handler (effect := effect) (table := table) (families := families) activation second)
  | cell (related : MetaPlain first second) : MetaPlain (.cell (identity := identity) first) (.cell (identity := identity) second)
  | cleanup (related : MetaPlain first second) : MetaPlain
      (.cleanup (needs := needs) (callback := callback) latent first) (.cleanup (needs := needs) (callback := callback) latent second)
  | retiring (related : MetaPlain first second) : MetaPlain (.retiring owner first) (.retiring owner second)
  | live (saved : MetaPlain oldSaved nextSaved) (related : MetaPlain first second) :
      MetaPlain (.live (owner := owner) oldSaved first) (.live (owner := owner) nextSaved second)
  | spent (related : MetaPlain first second) : MetaPlain (.spent (owner := owner) first) (.spent (owner := owner) second)

private theorem MetaPlain.held
    {first : CleanupHints.Metadata firstScope} {second : CleanupHints.Metadata secondScope}
    (related : MetaPlain first second) :
    firstScope.held = secondScope.held := by
  induction related <;> simp_all [SourceDependencyCapture.Scope.held]

private theorem MetaPlain.demand (related : MetaPlain first second) :
    first.closing.1 = second.closing.1 := by
  induction related <;> simp_all [CleanupHints.Metadata.closing]

private theorem MetaPlain.contexts (related : MetaPlain first second) :
    stripPlain first.context = stripPlain second.context := by
  induction related with
  | live saved related ihSaved ih =>
      simp [CleanupHints.Metadata.context, stripPlain, saved.held]
      exact ih
  | _ => simp_all [CleanupHints.Metadata.context, stripPlain]

private theorem MetaPlain.evaluates (related : MetaPlain first second)
    (same : stripPlain left = stripPlain right) phases :
    evaluate [] left phases first.closing.2 = evaluate [] right phases second.closing.2 := by
  induction related generalizing left right phases with
  | same metadata => exact empty_evaluate_congr _ same phases
  | add related ih | plain related ih | handler related ih | cell related ih => exact ih same phases
  | @cleanup _ first _ second needs callback latent related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence, empty_request,
        OwnerPhaseTransitions.spendAll]
      rw [ih same phases, export_strip_congr (first := first.context ++ left) (second := second.context ++ right) (by simp only [stripPlain_append, related.contexts, same])]
  | retiring related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveClosing.evaluate_retire, ih same]
  | spent related ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_spent, ih same]
  | @live oldScope oldSaved nextScope nextSaved firstScope first secondScope second owner saved related ihSaved ih =>
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRequirements.evaluate_prepend, RecursiveClosing.evaluate_retire]
      have eqCtx : stripPlain ((.ordinary (.barrier true) :: first.context) ++ left) =
          stripPlain ((.ordinary (.barrier true) :: second.context) ++ right) := by
        change .ordinary (.barrier true) :: stripPlain (first.context ++ left) =
          .ordinary (.barrier true) :: stripPlain (second.context ++ right)
        rw [stripPlain_append, stripPlain_append, related.contexts, same]
      rw [ihSaved eqCtx, saved.demand, ih same]

private theorem MetaPlain.checked (related : MetaPlain first second)
    (same : stripPlain left = stripPlain right)
    (checked : first.check left phases budget = true) : second.check right phases budget = true := by
  simpa only [CleanupHints.Metadata.check, related.evaluates same phases] using checked

inductive Plain : {firstScope secondScope : SourceDependencyCapture.Scope} →
    {firstHints : ReturnHints firstScope} → {secondHints : ReturnHints secondScope} →
    Context firstHints → Context secondHints → Prop where
  | same (context) : Plain context context
  | add (rows : Rows checking) (related : Plain first second) : Plain first (.plain rows second)
  | plain (rows : Rows checking) (related : Plain first second) : Plain (.plain rows first) (.plain rows second)
  | handler (rows : ClauseRows declarations) (related : Plain first second) : Plain
      (.handler (effect := effect) (table := table) activation rows first)
      (.handler (effect := effect) (table := table) activation rows second)
  | cell (related : Plain first second) : Plain (.cell (identity := identity) first) (.cell (identity := identity) second)
  | cleanup (rows : Rows checking) (related : Plain first second) : Plain
      (.cleanup (needs := needs) latent rows first) (.cleanup (needs := needs) latent rows second)
  | normal (related : Plain first second) : Plain (.normal first) (.normal second)
  | unwinding (related : Plain first second) : Plain (.unwinding first) (.unwinding second)
  | closing (related : Plain first second) : Plain (.closing first) (.closing second)
  | retiring (related : Plain first second) : Plain (.retiring owner first) (.retiring owner second)
  | live (saved : Context savedHints) (related : Plain first second) :
      Plain (.live (resumeDemand := resumeDemand) (owner := owner) saved first) (.live (resumeDemand := resumeDemand) (owner := owner) saved second)
  | spent (related : Plain first second) : Plain (.spent (owner := owner) first) (.spent (owner := owner) second)

private theorem Plain.contexts (related : Plain first second) :
    stripPlain first.context = stripPlain second.context := by
  induction related <;> simp_all [Context.context, stripPlain]

private theorem Plain.metadata {metadata : CleanupHints.Metadata firstScope}
    {firstHints : ReturnHints firstScope} {first : Context firstHints} (related : Plain first second) (found : first.closing? = some metadata) :
    ∃ next, second.closing? = some next ∧ MetaPlain metadata next := by
  induction related with
  | same context => exact ⟨metadata, found, .same _⟩
  | add rows related ih =>
      obtain ⟨next, nextFound, nextRelated⟩ := ih found
      exact ⟨.plain next, by simp only [Context.closing?, nextFound, Option.map_some], .add nextRelated⟩
  | plain rows related ih | handler rows related ih | cell related ih
  | cleanup rows related ih | retiring related ih | spent related ih =>
      simp only [Context.closing?] at found ⊢
      obtain ⟨actual, previous, equality⟩ := Option.map_eq_some_iff.mp found
      subst metadata
      obtain ⟨next, nextFound, nextRelated⟩ := ih previous
      simp only [nextFound, Option.map_some]
      refine ⟨_, rfl, ?_⟩
      first | exact .plain nextRelated | exact .handler nextRelated | exact .cell nextRelated
            | exact .cleanup nextRelated | exact .retiring nextRelated | exact .spent nextRelated
  | normal related ih | unwinding related ih | closing related ih => cases found
  | @live _ _ _ _ first _ _ second _ resumeDemand saved related ih =>
      cases savedFound : saved.closing? with
      | none => simp [Context.closing?, savedFound] at found
      | some savedMetadata =>
          simp only [Context.closing?, savedFound] at found ⊢
          cases previous : first.closing? with
          | none => simp [previous] at found
          | some actual =>
              simp [previous] at found
              subst metadata
              obtain ⟨next, nextFound, nextRelated⟩ := ih previous
              exact ⟨.live savedMetadata next, by simp [nextFound], .live (.same _) nextRelated⟩

private inductive SelectedPlain : Option Selection → Option Selection → Prop where
  | none : SelectedPlain none none
  | builtin : SelectedPlain (some (.builtin identity)) (some (.builtin identity))
  | handler (capture : Plain first.context second.context) (tail : Plain firstTail.context secondTail.context) :
      SelectedPlain (some (.handler first firstTail contract modes)) (some (.handler second secondTail contract modes))

private theorem SelectedPlain.same (selected : Option Selection) : SelectedPlain selected selected := by
  cases selected with
  | none => exact .none
  | some selected => cases selected with
    | builtin => exact .builtin
    | handler => exact .handler (.same _) (.same _)

private theorem SelectedPlain.prepend (related : SelectedPlain first second)
    (frame nextFrame : Packed → Packed)
    (congruent : ∀ left right, Plain left.context right.context → Plain (frame left).context (nextFrame right).context) :
    SelectedPlain (first.map (.prepend frame)) (second.map (.prepend nextFrame)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (congruent _ _ capture) tail

private theorem SelectedPlain.add (related : SelectedPlain first second) (rows : Rows checking) :
    SelectedPlain first (second.map (.prepend fun captured => (Context.plain rows captured.context).pack)) := by
  cases related with
  | none => exact .none
  | builtin => exact .builtin
  | handler capture tail => exact .handler (.add rows capture) tail

private theorem Plain.selected (related : Plain first second) effect operation :
    SelectedPlain (select effect operation first) (select effect operation second) := by
  induction related with
  | same context => exact .same _
  | add rows related ih => exact ih.add rows
  | plain rows related ih => exact ih.prepend _ _ (fun _ _ h => .plain rows h)
  | handler rows related ih =>
      simp only [select]
      split
      · split
        · exact .handler (.same _) related
        · exact .none
      · exact ih.prepend _ _ (fun _ _ h => .handler rows h)
  | cell related ih =>
      simp only [select]
      split
      · exact .builtin
      · exact ih.prepend _ _ (fun _ _ h => .cell h)
  | cleanup rows related ih => exact ih.prepend _ _ (fun _ _ h => .cleanup rows h)
  | normal related ih => exact ih.prepend _ _ (fun _ _ h => .normal h)
  | unwinding related ih => exact ih.prepend _ _ (fun _ _ h => .unwinding h)
  | closing related ih => exact ih.prepend _ _ (fun _ _ h => .closing h)
  | retiring related ih => exact ih.prepend _ _ (fun _ _ h => .retiring h)
  | live saved related ih => exact ih.prepend _ _ (fun _ _ h => .live saved h)
  | spent related ih => exact ih.prepend _ _ (fun _ _ h => .spent h)

theorem Plain.requestBudget (related : Plain first second)
    (checked : RequestBudget budget phases effect operation first) :
    RequestBudget budget phases effect operation second := by
  have selected := related.selected effect operation
  unfold RequestBudget at checked ⊢
  generalize select effect operation first = left at selected checked
  generalize select effect operation second = right at selected ⊢
  cases selected with
  | none | builtin => trivial
  | handler capture tail =>
      intro consuming
      obtain ⟨metadata, found, normal, protectedCheck⟩ := checked consuming
      obtain ⟨next, nextFound, nextRelated⟩ := capture.metadata found
      refine ⟨next, nextFound, nextRelated.checked tail.contexts normal, nextRelated.checked ?_ protectedCheck⟩
      change .ordinary (.barrier true) :: stripPlain _ = .ordinary (.barrier true) :: stripPlain _
      rw [tail.contexts]

private theorem Plain.budgeted {secondHints : ReturnHints secondScope} {second : Context secondHints}
    (related : Plain first second)
    (checked : Budgeted budget phases world installations rows first) :
    Budgeted budget phases world installations rows second := by
  induction checked generalizing secondScope secondHints second with
  | pure => exact .pure
  | request checked => exact .request (related.requestBudget checked)
  | invoke => exact .invoke
  | sequence left right ihLeft ihRight => exact .sequence (ihLeft (.plain _ related)) (ihRight related)
  | choice left right ihLeft ihRight => exact .choice (ihLeft related) (ihRight related)
  | handler body ih => exact .handler (fun activation fresh => ih activation fresh (.handler _ related))
  | cleanup body callback ihBody ihCallback => exact .cleanup (ihBody (.cleanup _ related)) (ihCallback (.normal related))
  | resource body ih => exact .resource (fun identity fresh => ih identity fresh (.cell related))

private theorem Plain.append (front : Context prefixHints) (related : Plain first second) :
    Plain (front.append first) (front.append second) := by
  induction front with
  | nil => exact related
  | plain rows tail ih => exact .plain rows ih
  | handler activation rows tail ih => exact .handler rows ih
  | cell tail ih => exact .cell ih
  | cleanup latent rows tail ih => exact .cleanup rows ih
  | normal tail ih => exact .normal ih
  | unwinding tail ih => exact .unwinding ih
  | closing tail ih => exact .closing ih
  | retiring owner tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live saved ihTail
  | spent tail ih => exact .spent ih

/-- Insert a waiting expression at any lexical suffix without introducing
new cleanup-budget checks. Its rows remain checked separately as pending code. -/
theorem Budgeted.insert_plain (front : Context prefixHints) (inserted : Rows checking)
    (checked : Budgeted budget phases world installations rows (front.append tail)) :
    Budgeted budget phases world installations rows (front.append (.plain inserted tail)) :=
  (Plain.append front (.add inserted (.same tail))).budgeted checked

/-- Focusing under a plain waiting frame preserves the child budget. -/
theorem Budgeted.plain (checked : Budgeted budget phases world installations rows context)
    (inserted : Rows checking) : Budgeted budget phases world installations rows (.plain inserted context) :=
  (Plain.add inserted (.same context)).budgeted checked

/-- Nearest-handler lookup and both disposal checks tolerate a plain frame
at any lexical suffix, including beneath handlers and saved-owner frames. -/
theorem RequestBudget.insert_plain (front : Context prefixHints) (inserted : Rows checking)
    (checked : RequestBudget budget phases effect operation (front.append tail)) :
    RequestBudget budget phases effect operation (front.append (.plain inserted tail)) :=
  (Plain.append front (.add inserted (.same tail))).requestBudget checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Budgeted.insert_plain
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Budgeted.plain
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RequestBudget.insert_plain

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveContexts (evaluate_request)
open SourcePlannedTyping (Value)
open SourcePlanSignatures (Signature)
open SourcePlannedSources (FocusSignature)

/-- Exact cleanup metadata follows the four existing focus signature cases.
The evaluated value prefix may disappear while latent rows remain unchanged. -/
inductive FocusRows :
    {whole child rest : SourceDependencyAnnotations.Dependencies} →
    {wholeSignature : Signature whole} → {childSignature : Signature child} → {restSignature : Signature rest} →
    Rows wholeSignature → Rows childSignature → Rows restSignature → Prop where
  | pure : FocusRows .pure .pure .pure
  | sequence : FocusRows (.sequence child rest) child rest
  | pairRight {leftSignature : Signature leftDependencies} {left : Rows leftSignature}
      (silent : leftDependencies.Silent) : FocusRows (.sequence left right) right .pure
  | appArgument {functionSignature : Signature functionDependencies} {function : Rows functionSignature}
      (silent : functionDependencies.Silent) : FocusRows (.sequence function (.sequence argument body)) argument body

theorem FocusRows.signature
    {wholeRows : Rows wholeSignature} {childRows : Rows childSignature} {restRows : Rows restSignature}
    (split : FocusRows wholeRows childRows restRows) :
    FocusSignature wholeSignature childSignature restSignature := by
  cases split with
  | pure => exact .pure
  | sequence => exact .sequence
  | pairRight _ => exact .pairRight
  | appArgument _ => exact .appArgument

/-- Decompose the actual authenticated source at its actual evaluation focus.
The child and retained context share one intermediate value decoration, and
both requirement equations use those same coherent source witnesses. -/
theorem Auth.focus_decompose_rows
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      whole output demand requirements checking}
    (checked : Auth operations policy ports owners environmentRows source outputRows rows)
    (focus : Focus whole child position) :
    ∃ (input : Value) (childDemand restDemand : List Nat) (current : Requirements childDemand) (rest : Requirements restDemand)
      (childDependencies restDependencies : SourceDependencyAnnotations.Dependencies)
      (childSignature : Signature childDependencies) (restSignature : Signature restDependencies),
      ∃ (inputRows : ValueRows input) (childRows : Rows childSignature) (contextRows : Rows restSignature),
      ∃ (childSource : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        child input childDemand current childSignature)
        (context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
          position input output restDemand rest restSignature),
      Auth operations policy ports owners environmentRows childSource inputRows childRows ∧
      AuthContext operations policy ports owners environmentRows context inputRows outputRows contextRows ∧
      FocusSignature checking childSignature restSignature ∧ FocusRows rows childRows contextRows ∧ demand = childDemand ++ restDemand ∧
      ∀ store receiving before,
        (evaluate store receiving before requirements =
          merge (evaluate store receiving before current) (evaluate store receiving (spendAll before childDemand) rest)) ∧
        evaluate store receiving before (annotateDisposals requirements) =
          merge (evaluate store receiving before (annotateDisposals current))
            (evaluate store receiving (spendAll before childDemand) (annotateDisposals rest)) := by
  cases checked with
  | unit | boolean | integer | reference | «variable» | lambda | handler | discard => cases focus
  | purePair left right => cases focus with
    | pairLeft =>
        refine ⟨_, [], [], _, _, _, _, _, _, _, _, _, _, _, left, .pairLeft right, .pure, .pure, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRecomposition.evaluate_empty, merge, List.nil_append]
    | pairRight isValue notValue =>
        refine ⟨_, [], [], _, _, _, _, _, _, _, _, _, _, _, right, .pairRight (left.value_summary isValue), .pure, .pure, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRecomposition.evaluate_empty, merge, List.nil_append]
  | pair left right => cases focus with
    | pairLeft => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, left, .pairLeft right, .sequence, .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
    | pairRight isValue notValue =>
        rename_i leftSource rightSource
        have empty := SourceTemplates.expression_value_demand
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase leftSource))) isValue
        subst_vars
        refine ⟨_, _, [], _, _, _, _, _, _, _, _, _, _, _, right, .pairRight (left.value_summary isValue), .pairRight,
          .pairRight (SourceDependencyAnnotations.value_silent (SourcePlannedSources.expression_erase leftSource) isValue), by simp, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence,
          SourcePlannedSources.template_value_disposals (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase leftSource))) isValue,
          RecursiveRecomposition.value_evaluation (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase leftSource))) isValue,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left, RecursiveRecomposition.merge_empty_right]
  | app function argument => cases focus with
    | appFunction =>
        refine ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, function, AuthContext.appFunction argument (admitted := by assumption), .sequence, .sequence, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence, PhaseRechecking.spendAll_append, merge_assoc]
    | appArgument isValue notValue =>
        rename_i functionSource argumentSource
        have empty := SourceTemplates.expression_value_demand
          (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
            (SourcePlannedSources.expression_erase functionSource))) isValue
        subst_vars
        refine ⟨_, _, [], _, _, _, _, _, _, _, _, _, _, _, argument,
          AuthContext.appArgument (function.value_summary isValue) (admitted := by assumption), .appArgument,
          .appArgument (SourceDependencyAnnotations.value_silent (SourcePlannedSources.expression_erase functionSource) isValue), by simp, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence,
          SourcePlannedSources.template_value_disposals (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase functionSource))) isValue,
          RecursiveRecomposition.value_evaluation (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase functionSource))) isValue,
          spendAll, List.nil_append, RecursiveRecomposition.merge_empty_left, evaluate_request]
  | bind initializer body => cases focus with
    | bind => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, initializer, .bind body, .sequence, .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | branch condition yes no => cases focus with
    | branch => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, condition, AuthContext.branch yes no (same := by assumption), .sequence, .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | perform operand => cases focus with
    | perform =>
        refine ⟨_, _, [], _, _, _, _, _, _, _, _, _, _, _, operand,
          AuthContext.perform (known := by assumption) (admitted := by assumption) (formed := by assumption), .sequence, .sequence, by simp, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, evaluate_request, List.nil_append]
  | resource initializer body => cases focus with
    | resource notValue => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, initializer,
        AuthContext.resource body (formed := by assumption) (effectsBound := by assumption) (admitted := by assumption) (hidden := by assumption),
        .sequence, .sequence, rfl, fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | resume operand => cases focus with
    | resume => exact ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, operand,
        AuthContext.resume (known := by assumption) (resolved := by assumption) (permission := by assumption)
          (admitted := by assumption) (formed := by assumption), .sequence, .sequence, rfl,
        fun _ _ _ => ⟨RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_sequence⟩⟩
  | cleanup callback body => cases focus with
    | cleanup =>
        refine ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, callback,
          AuthContext.cleanup body (admitted := by assumption), .sequence, .sequence, rfl, ?_⟩
        intro store receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit, RecursiveRequirements.evaluate_sequence, PhaseRechecking.spendAll_append, merge_assoc]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
