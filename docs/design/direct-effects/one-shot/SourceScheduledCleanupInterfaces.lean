  · exact .handler rfl rfl rfl rfl
  · intro _; exact .opening .nil (.handler .nil)
  · intro _; exact .live .nil (.handler .nil)
  · intro _
    refine ⟨_, rfl, ?_, ?_⟩ <;>
      simp [CleanupHints.Metadata.check, CleanupHints.Metadata.closing, CleanupHints.Metadata.context,
        RecursiveRequirements.evaluate, RecursiveRequirements.evaluateFuel, RecursiveRequirements.Requirements.prepend,
        phases, OwnerPhaseTransitions.spendAll, OwnerPhaseTransitions.available, PhaseRechecking.checkOwners, Context.pack, Context.context,
        OwnerSource.exportAt, ProtectionResiduals.residual_empty, ProtectionResiduals.merge]
  · exact .selected (.live .here) .ordinary
  · exact .live .here
  · rfl
  · exact .live .nil (.handler .nil)
  · intro owner freshDemand _fresh _absent
    apply Code.dispose (front := Context.nil) (captured := inherited) (tail := Context.nil)
