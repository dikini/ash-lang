namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (spend)

/-- Ownership before and after the same constructed successor follows from the
checked root and the established physical resume permutation. No independently
chosen successor is used for accounting. -/
theorem ReadyResumeSite.successor_owned
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyResumeSite site)
    (execution : ResumeExecution tables view.owner view.front view.captured view.tail view.answerType view.caller
      view.frontContext view.recorded view.frontRequirements view.liveRequirements (root : Requirements rootDemand))
    (records : ∀ key body, (key, body) ∈ (resumes : RecursiveRequirements.Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world site.stack key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : RecursiveRequirements.Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world site.stack key body)
    (storeAnnotation : SourceDependencyAnnotations.StoreAnnotation (resumes ++ disposals) annotatedStore)
    (unique : (ownedTickets site.stack).Nodup)
    (phaseAgreement : phases = OwnerPhaseTransitions.available (ownedTickets site.stack))
    (checked : Checked (annotateDisposalStore annotatedStore) receiving phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions (spend phases view.owner)
        world installations (RecursiveTransport.removeOwner view.owner resumes) budget ports owners emptyRows output outputRows,
      next.expression = view.operand ∧ next.runtimeScope = site.runtimeScope ∧
      next.stack = view.captured.append (view.front.append (.spent view.owner view.answerType view.caller view.tail)) ∧
      next.context.pack = (view.capturedContext.append
        (view.frontContext.append (.spent (owner := view.owner) view.tailContext))).pack ∧
      next.expression.IsValue ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner view.owner annotatedStore)) receiving
        (spend phases view.owner) (annotateDisposals next.pendingRequirements) row ∧
      rootDemand = view.owner :: next.pendingDemand ∧
      next.pendingDemand.Perm (ownedTickets next.stack) ∧ rootDemand.Perm (ownedTickets site.stack) ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [.ticket view.owner] := by
  obtain ⟨next, expression, scope, stack, context, rooted, nextChecked, sameDemand, raw⟩ :=
    view.successor execution checked
  have beforeChecked : Checked (annotateDisposalStore annotatedStore) receiving
      (OwnerPhaseTransitions.available (ownedTickets site.stack)) (annotateDisposals root) row := by
    simpa only [phaseAgreement] using checked
  have beforeBalance : rootDemand.Perm (ownedTickets site.stack) := by
    rw [view.stack] at records closing unique beforeChecked ⊢
    obtain ⟨_, _, _, _, _, _, balance⟩ :=
      view.frontRows.resume_execution_owned view.liveRows rfl view.found execution
        records closing storeAnnotation unique beforeChecked
    exact balance
  have physical : (view.owner :: ownedTickets next.stack).Perm (ownedTickets site.stack) := by
    rw [stack, view.stack]
    exact OwnerPhaseTransitions.resume_owned_permutation.symm
  have consumedBalance := beforeBalance
  rw [sameDemand] at consumedBalance
  have afterBalance := List.Perm.cons_inv (consumedBalance.trans physical.symm)
  exact ⟨next, expression, scope, stack, context, rooted, nextChecked, sameDemand, afterBalance, beforeBalance, raw⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ReadyResumeSite.successor_owned


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBindResumeExample
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open AuthenticatedResumeExample

theorem childResumeRecords : ∀ key body, (key, body) ∈ resumes →
    PlannedResumeAnnotated operations policy contracts tables families required [] actions annotations [] childSite.stack key body := by
  intro key body member
  have same := List.mem_singleton.mp member
  cases Prod.mk.inj same with
  | intro keySame bodySame =>
    cases keySame
    cases bodySame
    exact .resume (.push .here) (show contracts 0 = some (contract 0) from rfl) rfl savedSource (Or.inr rfl)

theorem childDisposalRecords : ∀ key body, (key, body) ∈ disposals →
    PlannedUnwindAnnotated operations policy contracts tables families required [] actions annotations [] childSite.stack key body := by
  intro key body member
  cases member

/-- The legacy compiler constructs one returned-value site, its scalar check,
and both ownership facts for the same physical resume step. -/
theorem legacy_checked_resume_successor :
    ∃ next : ExecutionSite [] operations policy contracts tables families required [] actions
        (OwnerPhaseTransitions.spend (OwnerPhaseTransitions.available (ownedTickets parentStack)) 0)
        [] [] (RecursiveTransport.removeOwner 0 resumes) [] ports owners emptyRows (.value .unit) (.value .unit),
      next.expression = .unit ∧ next.runtimeScope = runtimeScope ∧
      next.stack = captured.append (bindFront.append (.spent 0 .unit .none tail)) ∧
      next.context.pack = (capturedContext.append
        (bindFrontContext.append (.spent (owner := 0) tailContext))).pack ∧
      next.expression.IsValue ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner 0 resumes)) []
        (OwnerPhaseTransitions.spend (OwnerPhaseTransitions.available (ownedTickets parentStack)) 0)
        (annotateDisposals next.pendingRequirements) [] ∧
      [0, 1] = 0 :: next.pendingDemand ∧
      next.pendingDemand.Perm (ownedTickets next.stack) ∧ [0, 1].Perm (ownedTickets childSite.stack) ∧
      RawStep ⟨childSite.expression, childSite.runtimeScope, childSite.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [.ticket 0] := by
  obtain ⟨next, expression, scope, stack, context, _legacyEvidence,
    checked, demand, nextBalance, beforeBalance, raw⟩ :=
    ready.successor_owned readyExecution childResumeRecords childDisposalRecords
      storesAnnotated (by decide) rfl legacyBindRootChecked
  refine ⟨next, expression, scope, stack, context, ?_, checked, demand, nextBalance, beforeBalance, raw⟩
  rw [expression]
  trivial

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBindResumeExample
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBindResumeExample.legacy_checked_resume_successor

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceTicketAccess
open ScopedExpressions ScopedExecution
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open SourceDependencyCapture (OwnerCut Realizes)
open SourceDependencyAnnotations (Dependencies)
open SourceDependencyOwners (Within)

/-- Only live owners on the active lexical spine provide invocation access. -/
def active : SourceDependencyCapture.Scope → List Nat
  | .nil => []
  | .plain _ rest | .handler _ _ _ rest | .cell _ rest | .cleanup _ _ rest
  | .running rest | .spent _ rest => active rest
  | .live owner _ rest => owner :: active rest

theorem active_append (first second : SourceDependencyCapture.Scope) :
    active (first.append second) = active first ++ active second := by
  induction first <;> simp_all [active, SourceDependencyCapture.Scope.append]

theorem active_realizes (source : Realizes tables families scope stack) :
    active scope = activeTickets stack := by
  induction source with
  | nil => rfl
  | push frame tail ih => cases frame <;> exact ih
  | live saved tail ihSaved ihTail => exact congrArg (_ :: ·) ihTail
  | spent tail ih => exact ih

theorem owner_cut_active (cut : OwnerCut owner scope selected) : owner ∈ active scope := by
  induction cut with
  | hit => exact List.mem_cons_self
  | plain next ih | handler next ih | cell next ih | cleanup next ih | running next ih | spent next ih => exact ih
  | live different next ih => exact List.mem_cons_of_mem _ ih

theorem local_within_active {hints : ReturnHints scope}
    (checked : Local outward actions phases world dependencies hints) :
    Within world (active scope) dependencies := by
  apply Local.rec
    (motive_1 := fun _ world dependencies {scope} _ _ => Within world (active scope) dependencies)
    (motive_2 := fun _ _ {_ _} _ _ _ _ _ => True) (t := checked)
  · intros; exact .pure
  · intros; exact .request
  · intros; exact .invoke (owner_cut_active (by assumption))
  · intros; exact .invoke (owner_cut_active (by assumption))
  · intros; exact .sequence (by assumption) (by assumption)
  · intros; exact .choice (by assumption) (by assumption)
  · intros; exact .handler (by assumption)
  · intros; exact .cleanup (by assumption) (by assumption)
  · intros; exact .resource (by assumption)
  all_goals intros; trivial


theorem frame_empty_access (empty : frame.erase.pending = []) :
    LexicalUnwind.frameTicketUses frame mode ⊆ names := by
  cases mode <;> simpa only [LexicalUnwind.frameTicketUses, empty] using (List.nil_subset names)

theorem mode_pending_access
    (source : SourceDependencyFrames.ModeSource operations policy contracts tables families actions world
      stack input output demand requirements scope)
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    (matching : ReturnHints.Matches tables families hints stack)
    (checked : Pending outward actions phases world hints external input.mode output.mode) :
    LexicalUnwind.TicketAccess stack input.mode output.mode (active outsideScope) := by
  induction source generalizing outsideScope with
  | nil => exact .nil
  | push head tail ih =>
      cases head with
      | ordinary frame =>
          cases frame with
          | plain context scopeTyped inputAnnotation outputAnnotation =>
              cases matching with | plain matched =>
                cases checked with | plain code pending =>
                  apply LexicalUnwind.TicketAccess.push
                  · apply SourceDependencyOwners.plain_pending_bound context
                    simpa only [active_append, active_realizes tail.realizes] using local_within_active code
                  · exact ih matched pending
          | handler =>
              cases matching with | handler matched => cases checked with | handler pending =>
                exact .push (frame_empty_access rfl) (ih matched pending)
          | cell =>
              cases matching with | cell matched => cases checked with | cell pending =>
                exact .push (frame_empty_access rfl) (ih matched pending)
          | armed =>
              cases matching with | cleanup matched => cases checked with | cleanup callback pending =>
                exact .push (frame_empty_access rfl) (ih matched pending)
          | running =>
              cases matching with
              | running frame matched =>
                cases frame
                cases checked with | normal pending =>
                  exact .push (frame_empty_access rfl) (ih matched pending)
          | closing =>
              cases matching with
              | running frame matched =>
                cases frame
                cases checked with | closing pending =>
                  exact .push (frame_empty_access rfl) (ih matched pending)
          | retiring =>
              cases matching with
              | running frame matched =>
                cases frame
                cases checked with | retiring pending =>
                  exact .push (frame_empty_access rfl) (ih matched pending)
      | unwinding callback =>
          cases matching with
          | running frame matched =>
            cases frame
            cases checked with | unwinding pending =>
              exact .push (frame_empty_access rfl) (ih matched pending)
      | closing scopeTyped =>
          cases matching with
          | running frame matched =>
            cases frame
            cases checked with | closing pending =>
              exact .push (frame_empty_access rfl) (ih matched pending)
      | retiring =>
          cases matching with
          | running frame matched =>
            cases frame
            cases checked with | retiring pending =>
              exact .push (frame_empty_access rfl) (ih matched pending)
      | skipped =>
          cases matching with | plain matched => cases checked with | skipped pending =>
            exact .push (List.nil_subset _) (ih matched pending)
      | handler frame =>
          cases matching with | handler matched => cases checked with | handler pending =>
            exact .push (frame_empty_access rfl) (ih matched pending)
      | cell =>
          cases matching with | cell matched => cases checked with | cell pending =>
            exact .push (frame_empty_access rfl) (ih matched pending)
      | cleanup callback =>
          cases matching with | cleanup matched => cases checked with | cleanup callback pending =>
            exact .push (frame_empty_access rfl) (ih matched pending)
  | live known actionKnown inputAnnotation answerAnnotation callerScope held saved answer tail ihSaved ihTail =>
      cases matching with | live matchedSaved matchedTail =>
        cases checked with | live pendingSaved pendingTail =>
          have modes := (SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending.return_mode pendingSaved).symm.trans
            ((ReturnHints.Matches.return_mode matchedSaved).trans saved.return_mode)
          cases modes
          apply LexicalUnwind.TicketAccess.live
          · simpa only [SourceDependencyFrames.ModeValue.mode, active_append, active_realizes tail.realizes] using ihSaved matchedSaved pendingSaved
          · exact ihTail matchedTail pendingTail
  | opening saved tail ihSaved ihTail =>
      cases matching with | live matchedSaved matchedTail =>
        cases checked with | opening pendingSaved pendingTail =>
          apply LexicalUnwind.TicketAccess.live
          · simpa only [active, active_append, active_realizes tail.realizes] using ihSaved matchedSaved pendingSaved
          · exact ihTail matchedTail pendingTail
  | spent known annotation callerScope tail ih =>
      cases matching with | spent matched => cases checked with | spent pending => exact .spent (ih matched pending)
  | skippedSpent tail ih =>
      cases matching with | spent matched => cases checked with | spent pending => exact .spent (ih matched pending)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceTicketAccess
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceTicketAccess.local_within_active
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceTicketAccess.mode_pending_access

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
