namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (spend spendAll)

/-- A callback leaf and its remaining cleanup share the original phase: the
callback's outward summary has no continuation demand. Both retain the budget. -/
theorem Metadata.check_cleanup_parts
    (rest : Metadata scope)
    (checked : (Metadata.cleanup (needs := needs) (callback := callback) latent rest).check receiving before budget = true) :
    SiteRules.callbackCheck latent (rest.context ++ receiving) before budget = true ∧
      rest.check receiving before budget = true := by
  obtain ⟨row, evaluated, bounded⟩ := (Metadata.check_iff _).mp checked
  obtain ⟨firstRow, restRow, firstCheck, restCheck, rfl⟩ :=
    RecursiveRequirements.checked_sequence_parts (RecursiveRequirements.evaluate_sound evaluated)
  constructor
  · apply SiteRules.callback_check_iff.mpr
    refine ⟨firstRow, ?_, (List.subset_append_left _ _).trans bounded⟩
    simpa only [SourceDependencyFrames.evaluate_request_at] using RecursiveRequirements.checked_complete firstCheck
  · exact rest.check_iff.mpr ⟨restRow, RecursiveRequirements.checked_complete restCheck,
      (List.subset_append_right _ _).trans bounded⟩

/-- Opening a saved capture checks its callbacks below the exact retirement
barrier, then retires the owner and checks the tail at the resulting phase. -/
theorem Metadata.check_live_parts
    (saved : Metadata savedScope) (rest : Metadata restScope)
    (checked : (Metadata.live (owner := owner) saved rest).check receiving before budget = true) :
    saved.check (.ordinary (.barrier true) :: rest.context ++ receiving) before budget = true ∧
      spendAll before saved.closing.1 owner = .available ∧
      rest.check receiving (spend (spendAll before saved.closing.1) owner) budget = true := by
  obtain ⟨row, evaluated, bounded⟩ := (Metadata.check_iff _).mp checked
  obtain ⟨savedRow, remainingRow, savedCheck, remainingCheck, rfl⟩ :=
    RecursiveRequirements.checked_sequence_parts (RecursiveRequirements.evaluate_sound evaluated)
  obtain ⟨retireRow, restRow, retired, restCheck, rfl⟩ :=
    RecursiveRequirements.checked_sequence_parts remainingCheck
  have retirement : spendAll before saved.closing.1 owner = .available ∧ retireRow = [] := by
    have evaluated := RecursiveRequirements.checked_complete retired
    rw [RecursiveClosing.evaluate_retire] at evaluated
    split at evaluated
    · exact ⟨by assumption, (Option.some.inj evaluated).symm⟩
    · cases evaluated
  obtain ⟨ready, rfl⟩ := retirement
  refine ⟨saved.check_iff.mpr ⟨savedRow, ?_, (List.subset_append_left _ _).trans bounded⟩, ready,
      rest.check_iff.mpr ⟨restRow, ?_, (List.subset_append_right _ _).trans bounded⟩⟩
  · exact RecursiveRequirements.checked_complete (RecursiveRequirements.checked_prepend_iff.mp savedCheck)
  · simpa only [spendAll] using RecursiveRequirements.checked_complete restCheck

/-- Retirement exposes availability at this exact position and spends the
owner before checking the remainder. -/
theorem Metadata.check_retiring_parts
    (rest : Metadata scope)
    (checked : (Metadata.retiring owner rest).check receiving before budget = true) :
    before owner = .available ∧ rest.check receiving (spend before owner) budget = true := by
  obtain ⟨row, evaluated, bounded⟩ := (Metadata.check_iff _).mp checked
  obtain ⟨retireRow, restRow, retired, restCheck, rfl⟩ :=
    RecursiveRequirements.checked_sequence_parts (RecursiveRequirements.evaluate_sound evaluated)
  have retirement : before owner = .available ∧ retireRow = [] := by
    have evaluated := RecursiveRequirements.checked_complete retired
    rw [RecursiveClosing.evaluate_retire] at evaluated
    split at evaluated
    · exact ⟨by assumption, (Option.some.inj evaluated).symm⟩
    · cases evaluated
  obtain ⟨ready, rfl⟩ := retirement
  exact ⟨ready, rest.check_iff.mpr ⟨restRow, by simpa only [spendAll] using RecursiveRequirements.checked_complete restCheck, bounded⟩⟩

/-- A spent marker confirms consumption without changing subsequent phases. -/
theorem Metadata.check_spent_parts
    (rest : Metadata scope)
    (checked : (Metadata.spent (owner := owner) rest).check receiving before budget = true) :
    before owner = .consumed ∧ rest.check receiving before budget = true := by
  obtain ⟨row, evaluated, bounded⟩ := (Metadata.check_iff _).mp checked
  obtain ⟨spentRow, restRow, spentCheck, restCheck, rfl⟩ :=
    RecursiveRequirements.checked_sequence_parts (RecursiveRequirements.evaluate_sound evaluated)
  have consumption : before owner = .consumed ∧ spentRow = [] := by
    have evaluated := RecursiveRequirements.checked_complete spentCheck
    rw [RecursiveRecomposition.evaluate_spent] at evaluated
    split at evaluated
    · exact ⟨by assumption, (Option.some.inj evaluated).symm⟩
    · cases evaluated
  obtain ⟨consumed, rfl⟩ := consumption
  exact ⟨consumed, rest.check_iff.mpr ⟨restRow, RecursiveRequirements.checked_complete restCheck, bounded⟩⟩

/-- Reinterpret the same authenticated outward summary beneath the actual
callback barrier. This concludes a requirement check, not per-site Budgeted. -/
theorem SiteRules.callback_body_checked
    (source : RecursiveOutward.Outward requirements (some latent))
    (checked : SiteRules.callbackCheck latent receiving before budget = true) :
    ∃ row, Checked store (.ordinary (.barrier true) :: receiving) before requirements row ∧ row ⊆ budget := by
  obtain ⟨exported, accepted, bounded⟩ := SiteRules.callback_check_iff.mp checked
  have withBoundary : OwnerSource.exportAt (.ordinary (.barrier true) :: receiving) before latent = some exported := by
    simpa only [OwnerSource.exportAt, OwnerPhaseTransitions.project, ProtectionResiduals.residualize,
      DisposalProtection.through_barrier, Option.bind_some] using accepted
  obtain ⟨row, bodyChecked, included⟩ := RecursiveOutward.checked_from_bound source (List.Subset.refl _) withBoundary
  exact ⟨row, bodyChecked, included.trans bounded⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.Metadata.check_cleanup_parts
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.Metadata.check_live_parts
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.Metadata.check_retiring_parts
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.Metadata.check_spent_parts
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.SiteRules.callback_body_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked)
open SourcePlanSignatures (Signature)

/-- The checked latent row belongs to this exact callback. Reuse source
inversion and substitution to check its actual Unit-instantiated body at the
callback boundary. Internal RequestBudget obligations are a separate result. -/
theorem Auth.unit_callback_checked
    {bodySignature : Signature bodyDependencies} {bodyRows : Rows bodySignature}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.lambda parameter code) (.function .unit .unit requests latent bodySignature) demand requirements .pure}
    (authenticated : Auth operations policy ports owners environmentRows source
      (.function .unit .unit bodyRows) .pure)
    (accepted : CleanupHints.SiteRules.callbackCheck latent receiving before budget = true) :
    ∃ bodyDemand, ∃ bodyRequirements : Requirements bodyDemand,
    ∃ bodySource : SourcePlannedSources.Expression operations policy contracts world requests .none environment
      (code.subst parameter .unit) .unit bodyDemand bodyRequirements bodySignature,
      Auth operations policy ports owners environmentRows bodySource .unit bodyRows ∧
      ∃ row, Checked store (.ordinary (.barrier true) :: receiving) before bodyRequirements row ∧ row ⊆ budget := by
  obtain ⟨bodyDemand, bodyRequirements, bodySource, bodyAuth, summary⟩ := authenticated.lambda_body
  have unitAuth : Auth operations policy ports owners environmentRows
      (SourcePlannedSources.Expression.unit (world := world) (allowed := requests) (scope := .none)) .unit .pure := .unit
  exact ⟨bodyDemand, bodyRequirements,
    SourcePlannedSources.substitution bodySource .unit ScopedExecution.Examples.unit_closed,
    bodyAuth.substitution unitAuth ScopedExecution.Examples.unit_closed,
    CleanupHints.SiteRules.callback_body_checked summary accepted⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
