theorem capture_from_planned_source {hints : ReturnHints wholeScope}
    (cut : HandlerCut requested whole capture tail handler)
    (matching : ReturnHints.Matches tables families hints whole)
    (retained : Pending outward actions (available (ownedTickets whole)) world hints .nil .ordinary finalMode)
    (request : Local outward actions (available (ownedTickets whole)) world (.request requested operation) hints)
    (finite : checkForest required whole wholeScope .nil = true)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      whole (.value input) output demand requirements wholeScope)
    (selected : ClauseAt operation handler.clauses parameter binder code)
    (offeredKnown : lookup operation (tables handler) = some offered)
    (rowAvailable : offered.row (ProtectionContexts.protectedMode capture.erase) = some row)
    (fresh : actions owner = none) (absent : owner ∉ ownedTickets whole)
    (unique : (ownedTickets whole).Nodup)
    (operationKnown : operations handler.effectInst operation = some (argument, input))
    (payload : SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none)
      payloadAllowed operand argument)
    (closed : ClosedValue operand) :
    ∃ (answer : Value) (allowed : List Instance),
    ∃ plans : ClausePlans handler.clauses (families handler),
    let next := Stack.live owner (ScopedPorts.embedPort input.erase.erase.port) handler.answer capture handler.scope tail
    ∃ capturedScope tailScope, ∃ (saved : ReturnHints capturedScope) (waiting : ReturnHints tailScope),
    ∃ resumeEffects closeEffects, ∃ (family : Nat → Dependencies) (bodies : ∀ owner, Plan (family owner)),
      wholeScope = capturedScope.append tailScope ∧
      Selected operation capturedScope.held plans parameter binder code bodies ∧
      (lookupDependencies operation (families handler)).bind (modeDependencies capturedScope.held) = some family ∧
      ReturnHints.Matches tables families (.live (owner := owner) saved waiting) next ∧
      Certified (evidence := declarationPolicy) outward world (bodies owner) ∧
      Local outward (actions.insert owner code.requiredActions) (available (ownedTickets next)) world
        (family owner) (.live (owner := owner) saved waiting) ∧
      Pending outward (actions.insert owner code.requiredActions) (available (ownedTickets next)) world
        (.live (owner := owner) saved waiting) .nil .ordinary finalMode ∧
      checkForest required next (.live owner capturedScope tailScope) .nil = true ∧
      (∀ installed ∈ handlers next,
        ClauseDeclarations outward installed.clauses (families installed) (required installed)) ∧
      ownedTickets next = owner :: ownedTickets whole ∧ (ownedTickets next).Nodup ∧
      ∀ (allocated : SourceDependencyAnnotations.Contract), contracts owner = none →
        allocated.input = input.erase → allocated.answer = answer.erase →
        allocated.resumeEffects = resumeEffects → allocated.closeEffects = closeEffects →
        allocated.held = capturedScope.held → allocated.closeDemand.Perm allocated.resumeDemand →
        (SourcePlannedSources.refineContract allocated input answer).erase = allocated ∧
        RawStep ⟨.perform (Instantiation.freezeEffect requested) operation operand, caller, whole⟩
          ⟨code.subst parameter operand, .ticket binder owner, next⟩ [.ticket owner] [] ∧
        SourcePlannedSources.Body operations policy
          (contracts.insert owner (SourcePlannedSources.refineContract allocated input answer)) world allowed (.ticket binder owner)
          (fun _ => none) (code.subst parameter operand) answer ⟨owner, allocated.erase, offered.dispose, row⟩
          (signature (bodies owner)) := by
  obtain ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    decorate, declaration, returns, saved, waiting, scopeSame, demandSame, evaluation⟩ := source.handler_cut cut
  cases declaration with
  | handler caller annotation clauses coverage uniqueKeys declarations recipes capabilities modes certified =>
    exact ⟨_, _, _, capture_certified_source cut matching retained request source.installed_declarations
      finite declarations certified modes selected offeredKnown rowAvailable fresh absent unique operationKnown payload closed⟩

