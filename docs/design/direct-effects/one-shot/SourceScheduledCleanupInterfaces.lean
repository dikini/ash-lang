    returns, inputAnnotation, answerAnnotation, callerScope, held, scopeSame, demandSame,
    nextBound, evaluation, generatedEvaluation⟩ :=
    extract_planned_recorded_resume_disposals source known checked records found bound unique
  exact ⟨boundary, frontDemand, tailDemand, frontRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontSource, savedSource, tailSource,
    returns, inputAnnotation, answerAnnotation, callerScope, held, scopeSame, demandSame,
