/-- The actual authenticated ready expression selects the owner and its
canonical result metadata, while the operand's existing silence proof removes
only its immediate accounting prefix. -/
theorem Auth.ready_resume_accounting
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows source resultRows rows)
    (expression : code = .resume binder operand)
    (value : operand.IsValue)
    (run : Accounting.Run world installations rows context (root : Requirements rootDemand)) :
    ∃ owner contract, ∃ known : contracts owner = some contract,
      runtimeScope.resolve binder = some owner ∧ result = contract.answer ∧
      HEq resultRows (owners owner contract known).2 ∧
      Accounting.Run world installations (Rows.invoke (key := ⟨owner, .resume⟩)) context root := by
  cases expression
  cases authenticated with
  | resume operandChecked =>
    rename_i operandDemand operandRequirements dependencies operandSignature actualOwner actualContract operandRows
      actualKnown _formed _admitted _permission actualResolved operandSource
    exact ⟨actualOwner, actualContract, actualKnown, actualResolved, rfl, HEq.rfl,
      (Accounting.silent_prefix_iff (SourceDependencyAnnotations.value_silent
        (SourcePlannedSources.expression_erase operandSource) value) _ _).mp run⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
