        simp only [spendAll, OwnerPhaseTransitions.spend_self])
  let nextRoot := Requirements.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) tailAnnotated
  have nextCheck : Checked (RecursiveTransport.removeOwner owner entries) receiving (spendAll before [owner])
      (annotateDisposals nextRoot) tailRow := by
    change Checked _ _ _ (.sequence (.request (OwnerPhases.ofStack tables tail) []) (annotateDisposals tailAnnotated)) ([] ++ tailRow)
    exact .sequence (.request (by simp [OwnerSource.exportAt, residual_empty])) removed
  have nextPending : Pending outward actions (available (ownedTickets tail)) world restHints .nil .ordinary output.mode := by
    apply recursive_pending_restrict restCheck
    simpa only [SourceDependencyProjection.scope_append_nil] using
      SourceConsumingCleanupAdmission.realized_available (ReturnHints.Matches.erases restMatch)
  have event : LexicalUnwind.UseTransition (.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩)
