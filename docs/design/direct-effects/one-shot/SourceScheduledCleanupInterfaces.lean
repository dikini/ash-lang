/-- World extension reuses expression weakening for each retained clause body. -/
theorem declarations_world_weaken
    (source : SourcePlannedSources.Declarations operations policy contracts world environment allowed effect answer clauses table plans)
    (larger : world ⊆ nextWorld) :
    SourcePlannedSources.Declarations operations policy contracts nextWorld environment allowed effect answer clauses table plans := by
  induction source using SourcePlannedSources.Declarations.rec
    (motive_1 := fun _ _ _ _ _ _ _ _ _ _ _ _ => True)
    (motive_2 := fun contracts world allowed scope environment code value header _ checking _ => ∀ nextWorld, world ⊆ nextWorld →
      SourcePlannedSources.Body operations policy contracts nextWorld allowed scope environment code value header checking)
    (motive_3 := fun contracts world environment allowed parameter binder argument input answer resumeEffects closeEffects code held disposes row _ checking _ => ∀ nextWorld, world ⊆ nextWorld →
      SourcePlannedSources.Offer operations policy contracts nextWorld environment allowed parameter binder argument input answer resumeEffects closeEffects code held disposes row checking)
    generalizing nextWorld with
  | typed body rows closingRows ih =>
      rename_i nextWorld larger
      exact .typed (SourcePlannedSources.expression_world_weaken body larger) rows closingRows
  | unavailable => intros; exact .unavailable
  | available resumeInterface closeInterface family ih =>
      rename_i nextWorld larger
      exact .available resumeInterface closeInterface (fun owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance =>
        ih owner contract fresh inputSame answerSame resumeSame closeSame heldSame balance nextWorld larger)
  | nil => exact .nil
  | cons known ordinary protectedMode rest ihOrdinary ihProtected ihRest =>
      exact .cons known (ihOrdinary nextWorld larger) (ihProtected nextWorld larger) (ihRest larger)
  | _ => trivial

theorem context_world_weaken
    (source : SourcePlannedSources.Context operations policy contracts world environment allowed scope context input output demand requirements checking)
    (larger : world ⊆ nextWorld) :
    SourcePlannedSources.Context operations policy contracts nextWorld environment allowed scope context input output demand requirements checking := by
  cases source with
  | pairLeft right => exact .pairLeft (SourcePlannedSources.expression_world_weaken right larger)
  | pairRight left => exact .pairRight (SourcePlannedSources.expression_world_weaken left larger)
  | appFunction argument admitted => exact .appFunction (SourcePlannedSources.expression_world_weaken argument larger) admitted
  | appArgument function admitted => exact .appArgument (SourcePlannedSources.expression_world_weaken function larger) admitted
  | bind body => exact .bind (SourcePlannedSources.expression_world_weaken body larger)
  | branch yes no same => exact .branch (SourcePlannedSources.expression_world_weaken yes larger) (SourcePlannedSources.expression_world_weaken no larger) same
  | perform known admitted formed => exact .perform known admitted (ScopedPorts.in_world_mono formed larger)
  | resume known resolved permission admitted formed => exact .resume known resolved permission admitted (ScopedPorts.in_world_mono formed larger)
  | cleanup body admitted => exact .cleanup (SourcePlannedSources.expression_world_weaken body larger) admitted
  | resource body formed effectsBound admitted hidden =>
      exact .resource (fun identity fresh => SourcePlannedSources.expression_world_weaken
        (body identity (fun member => fresh (larger member))) (ScopedExpressions.append_subset larger (List.Subset.refl _)))
        (ScopedPorts.in_world_mono formed larger) (effectsBound.trans larger) admitted
        (fun identity fresh => hidden identity (fun member => fresh (larger member)))

theorem certified_world_weaken {plan : Plan dependencies}
    (source : Certified (evidence := declarationPolicy) outward world plan) (larger : world ⊆ nextWorld) :
    Certified (evidence := declarationPolicy) outward nextWorld plan := by
  induction source using Certified.rec (evidence := declarationPolicy)
    (motive_2 := fun _ _ _ _ => True)
    (motive_3 := fun _ _ _ _ _ => True)
    generalizing nextWorld with
  | pure => exact Certified.pure (evidence := declarationPolicy)
  | request => exact Certified.request (evidence := declarationPolicy)
  | invoke => exact Certified.invoke (evidence := declarationPolicy)
  | sequence first second ihFirst ihSecond => exact Certified.sequence (evidence := declarationPolicy) (ihFirst larger) (ihSecond larger)
  | choice first second ihFirst ihSecond => exact Certified.choice (evidence := declarationPolicy) (ihFirst larger) (ihSecond larger)
  | handler recipes declarations body ihDeclarations ihBody =>
      exact Certified.handler (evidence := declarationPolicy) recipes (SourcePlannedPhases.certified_clauses_world (evidence := declarationPolicy) declarations larger) (ihBody larger)
  | cleanup callback body ihCallback ihBody => exact Certified.cleanup (evidence := declarationPolicy) (ihCallback larger) (ihBody larger)
  | resource body ih => exact Certified.resource (evidence := declarationPolicy) (fun identity fresh => ih identity
      (fun member => fresh (larger member)) (ScopedExpressions.append_subset larger (List.Subset.refl _)))
  | unavailable | available | nil | cons => trivial

theorem CertifiedFrame.world_weaken
    (frame : CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing)
    (larger : world ⊆ nextWorld) :
    CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward nextWorld entry input output demand requirements layer decorate incoming outgoing := by
  cases frame with
  | plain context scope inputAnnotation outputAnnotation checked =>
      exact .plain (context_world_weaken context larger) scope inputAnnotation outputAnnotation (certified_world_weaken checked larger)
  | handler scope annotation clauses coverage unique declarations recipes capabilities modes certified =>
      exact .handler scope annotation (ScopedPorts.clauses_world_weaken clauses larger) coverage unique
        (declarations_world_weaken declarations larger) recipes capabilities modes
        (SourcePlannedPhases.certified_clauses_world (evidence := declarationPolicy) certified larger)
  | cell scope noEscape annotation interface =>
      exact .cell scope noEscape annotation (ScopedPorts.effect_frame_world_weaken interface larger)
  | armed scope callback annotation interface checked =>
      exact .armed scope (SourcePlannedSources.expression_world_weaken callback larger) annotation
        (ScopedPorts.effect_frame_world_weaken interface larger) (certified_world_weaken checked larger)
  | running scope callback saved annotation interface =>
      exact .running scope (SourcePlannedSources.expression_world_weaken callback larger)
        (SourcePlannedSources.expression_world_weaken saved larger) annotation (ScopedPorts.effect_frame_world_weaken interface larger)
  | closing scope interface => exact .closing scope (ScopedPorts.effect_frame_world_weaken interface larger)
  | retiring known interface => exact .retiring known (ScopedPorts.effect_frame_world_weaken interface larger)

theorem PlannedModeFrame.world_weaken
    (source : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer)
    (larger : world ⊆ nextWorld) :
    PlannedModeFrame operations policy contracts tables families required outward nextWorld entry input output demand requirements layer := by
  cases source with
  | ordinary frame => exact .ordinary (frame.world_weaken larger)
  | unwinding callback certified => exact .unwinding (SourcePlannedSources.expression_world_weaken callback larger) (certified_world_weaken certified larger)
  | closing scope => exact .closing scope
  | retiring => exact .retiring
  | skipped => exact .skipped
  | handler frame => exact .handler (frame.world_weaken larger)
  | cell => exact .cell
  | cleanup callback certified => exact .cleanup (SourcePlannedSources.expression_world_weaken callback larger) (certified_world_weaken certified larger)

theorem PlannedModeSource.world_weaken
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope)
    (larger : world ⊆ nextWorld) :
    PlannedModeSource operations policy contracts tables families required outward actions nextWorld stack input output demand requirements scope := by
  induction source with
  | nil => exact .nil
  | push head tail ih => exact .push (head.world_weaken larger) ih
  | live known rights inputAnnotation answerAnnotation caller held saved answer tail ihSaved ihTail =>
      exact .live known rights inputAnnotation answerAnnotation caller held ihSaved answer ihTail
  | opening saved tail ihSaved ihTail => exact .opening ihSaved ihTail
  | spent known annotation caller tail ih => exact .spent known annotation caller ih
  | skippedSpent tail ih => exact .skippedSpent ih
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
