/-- The same physical builtin selection is visible in its authenticated context. -/
theorem Context.Source.cell_update_builtin
    {hints : ReturnHints receiving} {context : Context hints}
    (update : CellUpdate identity old new before after)
    (source : Context.Source operations policy contracts tables families world context before) :
    select (.cell identity) operation context = some (.builtin identity) := by
  induction update generalizing receiving with
  | hit => cases source with | cell tail => simp [select]
  | push miss next ih =>
    cases source with
    | plain tail | cleanup callback tail | normal tail | unwinding tail | closing tail | retiring tail =>
      simp only [select, ih tail, Option.map_some, Selection.prepend]
    | handler declaration tail =>
      rename_i data answer residual restScope restHints rest signatures rows
      have different : Instance.cell identity ≠ data.effectInst := by
        intro same
        apply miss
        simpa only [ExecFrame.erase, HandlerData.erase, Frame.target] using congrArg some same.symm
      simp only [select, if_neg different, ih tail, Option.map_some, Selection.prepend]
    | cell tail =>
      rename_i restScope restHints rest other payload caller answer
      have different : Instance.cell identity ≠ Instance.cell other := by
        intro same
        apply miss
        simpa only [ExecFrame.erase, HandlerData.erase, Frame.target] using congrArg some same.symm
      simp only [select, if_neg different, ih tail, Option.map_some, Selection.prepend]
  | live next ih => cases source with | live saved tail =>
      simp only [select, ih tail, Option.map_some, Selection.prepend]
  | spent next ih => cases source with | spent tail =>
      simp only [select, ih tail, Option.map_some, Selection.prepend]

theorem Accounting.Run.builtin_wait
    (run : Accounting.Run world installations (Rows.request (effect := effect) (operation := operation)) context
      (root : Requirements demand))
    (found : select effect operation context = some (.builtin identity)) :
    Accounting.Wait world installations context .ordinary root := by
  cases run with
  | builtin selected waiting => exact waiting
  | request cut selected body binding => cases found.symm.trans cut

/-- A builtin reply changes only the physical cell payload. Its exact rich
source, lexical context, retained certificate and executable root are preserved. -/
theorem ExecutionSite.cell_reply_accounting
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows)
    (expression : site.expression = .perform (Instantiation.freezeEffect (.cell identity)) operation operand)
    (selected : CellUpdate identity old new site.stack afterStack)
    (isValue : operand.IsValue)
    (response : ∀ allowed argument result, operations (.cell identity) operation = some (argument, result) →
      SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) allowed reply result)
    (responseAuth : ∀ allowed scope result,
      ∀ source : SourcePlannedSources.Expression operations policy contracts world allowed scope (fun _ => none)
        reply result [] (.request [] []) .pure,
      ∀ resultRows : ValueRows result,
        Auth operations policy ports owners emptyRows source resultRows .pure)
    (run : Accounting.Run world history site.rows site.context (root : Requirements demand)) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
        resumes budget ports owners emptyRows output outputRows,
      next.expression = reply ∧ next.runtimeScope = site.runtimeScope ∧ next.stack = afterStack ∧
      next.context.pack = site.context.pack ∧
      ExecutionRoot operations policy contracts tables families required outward actions phases world history
        resumes budget ports owners emptyRows output outputRows next root := by
  obtain ⟨requested, argument, known, effectSame, _rowsSame, primitive⟩ :=
    site.current.previous.authenticated.ready_request_accounting expression isValue run
  have instanceSame := freeze_effect_injective effectSame
  cases instanceSame
  have found := site.coherent.forget.source.cell_update_builtin selected (operation := operation)
  have waiting := primitive.builtin_wait found
  let source := SourcePlannedSources.summary_expression (response site.allowed _ _ known) site.runtimeScope
  have nextCoherent := site.coherent.cell_update selected
  let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows output outputRows :=
    { expression := reply, runtimeScope := site.runtimeScope, stack := afterStack,
      result := site.result, resultRows := site.resultRows, allowed := site.allowed,
      dependencies := .pure, plan := .pure, rows := .pure,
      sourceDemand := [], sourceRequirements := .request [] [],
      receiving := site.receiving, hints := site.hints, context := site.context,
      current := SourceAdmission.Admitted.of_source source (responseAuth _ _ _ source site.resultRows)
        .pure nextCoherent.forget.source,
      certified := .pure (evidence := declarationPolicy), scopeTyped := site.scopeTyped,
      pendingDemand := site.pendingDemand, pendingRequirements := site.pendingRequirements,
      pending := site.pending.cell_update selected, coherent := nextCoherent, retained := site.retained, currentResource := .pure, retainedResource := site.retainedResource }
  exact ⟨next, rfl, rfl, rfl, rfl, .contextual (.pure waiting)⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

