/-- Normal scope exit saves the actual rich value and invokes the installed
callback under its normal-return marker, retaining the whole generated row. -/
theorem start_normal_cleanup_planned_generated
    {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      value input currentDemand currentRequirements checking)
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.armed action) tail) (.value input) output pendingDemand pendingRequirements dependencyScope)
    (closed : ClosedValue value)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints (.push (.armed action) tail))
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.armed action) tail))) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, .push (.armed action) tail⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, .push (.armed action) tail⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, .push (.armed action) tail⟩)) :
    ∃ latent callbackDependencies, ∃ callbackPlan : Plan callbackDependencies,
    ∃ restScope, ∃ restHints : ReturnHints restScope,
    ∃ nextRequirements : Requirements pendingDemand,
    let nextStack := Stack.push (.running action value closed) tail
    let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
    ∃ nextAnnotated : Requirements pendingDemand, ∃ nextRow,
      dependencyScope = .cleanup action.requests callbackDependencies restScope ∧ currentDemand = [] ∧
      SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
        (.app action.action .unit) .unit [] callbackRequirements (signature (.sequence .pure (.sequence .pure callbackPlan))) ∧
      Certified (evidence := declarationPolicy) outward world (.sequence .pure (.sequence .pure callbackPlan)) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        nextStack (.value .unit) output pendingDemand nextRequirements (.running restScope) ∧
      RowAnnotation (.sequence (callbackRequirements.prepend (OwnerPhases.ofStack tables nextStack)) nextRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world (.sequence .pure (.sequence .pure callbackDependencies)) (.running .normal restHints) ∧
      Pending outward actions phases world (.running .normal restHints) .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families (.running .normal restHints) nextStack ∧ Bound annotations (.running restScope) ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.armed action) tail) key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.armed action) tail) key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      RawStep ⟨value, runtimeScope, .push (.armed action) tail⟩ ⟨.app action.action .unit, .none, nextStack⟩ [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨value, runtimeScope, .push (.armed action) tail⟩)
        (.eval ⟨.app action.action .unit, .none, nextStack⟩) [] [] ∧
      ownedTickets nextStack = ownedTickets (.push (.armed action) tail) ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨.app action.action .unit, .none, nextStack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.app action.action .unit, .none, nextStack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨.app action.action .unit, .none, nextStack⟩) := by
  have template := DeclaredSources.expression_erase
    (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase current))
  have empty := SourceTemplates.expression_value_demand template closed.1
  cases empty
  have summary := SourcePlannedSources.Values.change_allowed (SourcePlannedSources.value_summary current closed.1) closed.1 []
  cases pending with | @push entry initial middle firstDemand first layer rest output tailDemand second restScope frame suffix =>
    cases frame with | ordinary frame =>
      cases frame with | @armed callbackDep latent action incoming outgoing result evidence callbackPlan scope callback portAnnotation interface certified =>
        cases matching with
        | cleanup matched =>
          cases retained with | cleanup completion remaining =>
            cases annotationBound with | cleanup bound =>
              cases interface with | armed savedScope callable admitted =>
                have savedTyped : ScopedPorts.Typed operations.erase.erase.ports world ScopedPorts.TypeEnv.empty .none []
                    value (ScopedPorts.eraseType action.answer) := by
                  have environmentSame : (SourcePlannedTyping.Environment.erase (fun _ => none)).erase.ports = ScopedPorts.TypeEnv.empty := by
                    funext name; rfl
                  simpa only [← portAnnotation, environmentSame] using (SourcePlannedSources.Values.erase summary closed.1).ports .none
                let nextRequirements := Requirements.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) second
                let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
                let nextRoot := Requirements.sequence (callbackRequirements.prepend (OwnerPhases.ofStack tables (.push (.running action value closed) tail))) nextRequirements
                have generated : ∀ entries receiving before,
                    evaluate entries receiving before (annotateDisposals nextRoot) =
                      evaluate entries receiving before (annotateDisposals
                        (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.armed action) tail)))
                          (.sequence ((Requirements.request [] (qualify true latent)).prepend (OwnerPhases.ofStack tables tail)) second))) := by
                  intro entries receiving before
                  simp only [nextRoot, nextRequirements, callbackRequirements, annotateDisposals, disposal_prepend,
                    RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
                    RecursiveRequirements.evaluate_emit, SourcePlannedSources.template_value_disposals template closed.1,
                    RecursiveRecomposition.value_evaluation template closed.1, RecursiveRecomposition.evaluate_empty,
                    spendAll, RecursiveRecomposition.merge_empty_left, RecursiveContexts.evaluate_request,
                    OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase, ActionData.erase,
                    ProtectionContexts.frameProtected, OwnerPhaseTransitions.project, OwnerSource.exportAt,
                    residualize, DisposalProtection.through_barrier, List.cons_append, List.nil_append]
                obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked rowChecked
                have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) normalRow :=
                  RecursiveRequirements.evaluate_sound ((generated entries receiving before).trans (RecursiveRequirements.checked_complete normalCheck))
                have callbackLocal := completion.reindex_scope
                  (congrArg SourceDependencyCapture.Scope.running (SourceDependencyProjection.scope_append_nil _))
                  (SourceDependencyNeutral.Lexical.Recursive.running_congr (SourceDependencyProjection.scope_append_nil _)
                    (return_hints_append_nil _) .normal)
                have step : RawStep ⟨value, runtimeScope, .push (.armed action) tail⟩
                    ⟨.app action.action .unit, .none, .push (.running action value closed) tail⟩ [] [] :=
                  .startCleanup action value closed runtimeScope tail
                refine ⟨latent, callbackDep, callbackPlan, _, _, nextRequirements,
                  .choice nextRoot annotated (.refl _), normalRow ++ row, rfl, rfl,
                  .app (SourcePlannedSources.Values.change_context callback action.closed.1 action.requests .none) .unit (List.Subset.refl _),
                  Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
                    (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified),
                  .push (.ordinary (.running scope callback summary portAnnotation (.running savedScope callable savedTyped admitted))) suffix,
                  .alternatives .original (.refl _), .no .here, .no .here,
                  .choice nextCheck rowChecked, List.append_subset.mpr ⟨within, List.Subset.refl _⟩,
                  .sequence .pure (.sequence .pure callbackLocal), .normal remaining, .running .normal matched, .running bound,
                  ?_, ?_, step, .evaluate step (LexicalUnwind.value_computation_head closed.1), rfl,
                  LexicalUnwind.raw_value_machine_use step closed usage,
                  LexicalUnwind.raw_value_machine_ticket_access step closed usage ticketAccess, ?_⟩
                · intro key body record
                  cases record with | resume located known recorded source answer =>
                    cases located with | push located => exact .resume (.push located) known recorded source answer
                · intro key body record
                  cases record with | dispose located held recorded source =>
                    cases located with | push located => exact .dispose (.push located) held recorded source
                · cases resourceAccess with | eval supported =>
                    apply LexicalUnwind.MachineAccess.eval
                    apply ScopedExecution.raw_step_preserves_access step supported
                    constructor
                    · intro identity payload answer savedScope current value rest same closed
                      cases same
                    · intro requested operation operand current stack cap outside handler same cut operandClosed
                      have impossible := congrArg Configuration.expression same
                      change value = _ at impossible
                      have isValue := closed.1
                      rw [impossible] at isValue
                      exact False.elim isValue
                    · intro binder owner current caller input answer front cap outside plan same resolve built
                      have impossible := congrArg Configuration.expression same
                      change value = _ at impossible
                      have isValue := closed.1
                      rw [impossible] at isValue
                      exact False.elim isValue
/-- A normal callback return restores its retained rich value and actual lexical
scope, discharging the cleanup marker while preserving the generated certificate. -/
theorem finish_normal_cleanup_planned_generated
    {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      .unit input currentDemand currentRequirements checking)
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.running action value closed) tail) (.value input) output pendingDemand pendingRequirements dependencyScope)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints (.push (.running action value closed) tail))
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.running action value closed) tail))) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩)) :
    ∃ nextInput restScope, ∃ restHints : ReturnHints restScope,
    ∃ nextRequirements : Requirements pendingDemand,
    ∃ nextAnnotated : Requirements pendingDemand, ∃ nextRow,
      dependencyScope = .running restScope ∧ currentDemand = [] ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports action.scope ∧
      SourcePlannedSources.Expression operations policy contracts world [] action.scope (fun _ => none)
        value nextInput [] (.request [] []) .pure ∧
      Certified (evidence := declarationPolicy) outward world Plan.pure ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        tail (.value nextInput) output pendingDemand nextRequirements restScope ∧
      RowAnnotation (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) nextRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world .pure restHints ∧
      Pending outward actions phases world restHints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families restHints tail ∧ Bound annotations restScope ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.running action value closed) tail) key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.running action value closed) tail) key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      RawStep ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩ ⟨value, action.scope, tail⟩ [] [.cleanup action.identity] ∧
      LexicalUnwind.UseTransition (.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩)
        (.eval ⟨value, action.scope, tail⟩) [] [.cleanup action.identity] ∧
      ownedTickets tail = ownedTickets (.push (.running action value closed) tail) ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨value, action.scope, tail⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, action.scope, tail⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨value, action.scope, tail⟩) := by
  cases current
  cases pending with | @push entry initial middle firstDemand first layer rest output tailDemand second restScope frame suffix =>
    cases frame with | ordinary frame =>
      cases frame with | running scope callback saved portAnnotation interface =>
        cases matching with | running marker matched =>
          cases marker
          cases retained with | normal remaining =>
            cases annotationBound with | running bound =>
              cases interface with | running savedScope callable result admitted =>
                let nextRoot := Requirements.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) second
                have generated : ∀ entries receiving before,
                    evaluate entries receiving before (annotateDisposals nextRoot) =
                      evaluate entries receiving before (annotateDisposals
                        (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables (.push (.running action value closed) tail)))
                          (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) second))) := by
                  intro entries receiving before
                  simp only [nextRoot, annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
                    RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty,
                    spendAll, RecursiveRecomposition.merge_empty_left]
                obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked rowChecked
                have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) normalRow :=
                  RecursiveRequirements.evaluate_sound ((generated entries receiving before).trans (RecursiveRequirements.checked_complete normalCheck))
                have step : RawStep ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩
                    ⟨value, action.scope, tail⟩ [] [.cleanup action.identity] :=
                  .finishCleanup action value closed runtimeScope tail
                have unitClosed : ClosedValue Code.unit := by
                  simp [ClosedValue, Code.IsValue, Code.ResourceClosed, Code.dependencies, Code.freeNames]
                refine ⟨_, _, _, second, .choice nextRoot annotated (.refl _), normalRow ++ row, rfl, rfl, savedScope,
                  SourcePlannedSources.Values.change_context saved closed.1 [] action.scope,
                  Certified.pure (evidence := declarationPolicy), suffix,
                  .alternatives .original (.refl _), .no .here, .no .here,
                  .choice nextCheck rowChecked, List.append_subset.mpr ⟨within, List.Subset.refl _⟩,
                  .pure, remaining, matched, bound, ?_, ?_, step, .evaluate step (by trivial), rfl,
                  LexicalUnwind.raw_value_machine_use step unitClosed usage,
                  LexicalUnwind.raw_value_machine_ticket_access step unitClosed usage ticketAccess, ?_⟩
                · intro key body record
                  cases record with | resume located known recorded source answer =>
                    cases located with | push located => exact .resume located known recorded source answer
                · intro key body record
                  cases record with | dispose located held recorded source =>
                    cases located with | push located => exact .dispose located held recorded source
                · cases resourceAccess with | eval supported =>
                    apply LexicalUnwind.MachineAccess.eval
                    apply ScopedExecution.raw_step_preserves_access step supported
                    constructor
                    · intro identity payload answer savedScope current value rest same closed
                      cases same
                    · intro requested operation operand current stack cap outside handler same cut operandClosed
                      cases same
                    · intro binder owner current caller input answer front cap outside plan same resolve built
                      cases same

