namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open SourcePlannedChecks (Certified)
open RecursiveRequirements (Requirements)

/-- Completion restores the authenticated saved value at its recorded lexical scope. -/
theorem ExecutionSite.finish_normal_cleanup
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (expressionEq : site.expression = .unit)
    (stackEq : site.stack = .push (.running action value closed) tail) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
      next.expression = value ∧ next.runtimeScope = action.scope ∧ next.stack = tail ∧
      site.context.pack = (Context.normal next.context).pack := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at expressionEq stackEq ⊢
  subst expression stack
  cases coherent with
  | push frame tailCoherent =>
    cases frame with
    | ordinary frameRows =>
      cases frameRows with
      | running callbackAuth savedAuth =>
        rename_i restScope restHints restContext tailDemand tailRequirements savedType beforeEffects afterEffects
          savedRows tailSource callbackDeps latent callbackPlan callbackRows scopeKnown callback closedSaved answerAnn saved interface
        cases interface with
        | running savedScope callable savedTyped admitted =>
          cases retained with
          | normal tailCertificate =>
            have returned := savedAuth.value_context closed.1 [] action.scope
            let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
                resumes budget ports owners emptyRows output outputRows :=
              { expression := value, runtimeScope := action.scope, stack := tail,
                result := savedType, resultRows := savedRows, allowed := [],
                dependencies := .pure, plan := .pure, rows := .pure,
                sourceDemand := [], sourceRequirements := .request [] [],
                receiving := restScope, hints := restHints, context := restContext,
                current := SourceAdmission.Admitted.of_source _ returned .pure tailCoherent.forget.source,
                certified := Certified.pure (evidence := declarationPolicy), scopeTyped := savedScope,
                pendingDemand := tailDemand, pendingRequirements := tailRequirements,
                pending := tailSource, coherent := tailCoherent, retained := tailCertificate, currentResource := .pure,
                  retainedResource := by cases retainedResource <;> assumption }
            exact ⟨next, rfl, rfl, rfl, rfl⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open OwnerPhaseTransitions (available)

/-- Cleanup completion restores the saved value and the same checked continuation. -/
theorem ExecutableState.finish_normal_cleanup
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩, issued, completed⟩, actions⟩) :
    LexicalUnwind.Event
      ⟨.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩, issued, completed⟩
      ⟨.eval ⟨value, action.scope, tail⟩, issued, .cleanup action.identity :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, action.scope, tail⟩, issued, .cleanup action.identity :: completed⟩, actions⟩ := by
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows (.eval ⟨value, action.scope, tail⟩) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩ = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
      obtain ⟨expression, _runtime, stackSame⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
      obtain ⟨next, expressionSame, scopeSame, nextStack, contextSame⟩ :=
        site.finish_normal_cleanup expression.symm stackSame.symm
      have waiting := rooted.value_wait (by rw [← expression]; trivial)
      change Accounting.Wait world history site.context.pack.context .ordinary _ at waiting
      rw [contextSame] at waiting
      cases waiting with
      | normal rest =>
        have nextValue : next.expression.IsValue := by rw [expressionSame]; exact closed.1
        have nextBound : SourceDependencySchemes.Closing.Bound annotations next.receiving := by
          have same := congrArg Packed.scope contextSame
          change site.receiving = .running next.receiving at same
          rw [same] at bound
          cases bound with | running tailBound => exact tailBound
        have ownersSame : ownedTickets next.stack = ownedTickets site.stack := by
          rw [nextStack, ← stackSame]
          rfl
        have nextPhase := phaseAgreement.trans (congrArg available ownersSame.symm)
        have certified := ExecutableSource.eval next nextPhase (.contextualValue nextValue rest)
          nextBound annotation checked bounded
        simpa only [expressionSame, scopeSame, nextStack] using certified
    | unwind => cases machineEq
  have raw := RawStep.finishCleanup action value closed runtimeScope tail
  have checks : AccessChecks ⟨.unit, runtimeScope, .push (.running action value closed) tail⟩ ambient := by
    constructor
    · intro identity payload answer savedScope current returned rest same closed
      cases same
    · intro requested operation operand current stack cap outside handler same cut operandClosed
      cases same
    · intro binder owner current caller input answer front cap outside plan same resolve built
      cases same
  obtain ⟨event, ledger, registry, resources⟩ :=
    LexicalUnwind.value_step_ledger_resources raw trivial checks state.ledger state.registry state.resources
  refine ⟨event, nextSource, ?_, ?_, state.storeAnnotation, ledger, registry, resources, ?_, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
      cases located with | push rest => exact .resume rest known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
      cases located with | push rest => exact .dispose rest held recorded source
  · exact state.activations

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.finish_normal_cleanup

