/-- Ready resume extracts its actual operand with the canonical owner's input
metadata, then normalizes only immediate value requirements. -/
theorem Auth.resume_operand_summary
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows source resultRows rows)
    (expression : code = .resume binder operand)
    (resolved : runtimeScope.resolve binder = some owner)
    (known : contracts owner = some contract)
    (closed : ClosedValue operand) :
    ∃ summary : SourcePlannedSources.ValueSummary operations policy contracts world environment [] operand contract.input,
      Auth operations policy ports owners environmentRows summary (owners owner contract known).1 .pure := by
  cases expression
  cases authenticated with
  | resume operandChecked =>
    rename_i operandDemand operandRequirements dependencies operandSignature actualOwner actualContract operandRows
      actualKnown _formed _admitted _permission actualResolved operandSource
    have sameOwner : actualOwner = owner := Option.some.inj (actualResolved.symm.trans resolved)
    subst actualOwner
    have sameContract : actualContract = contract := Option.some.inj (actualKnown.symm.trans known)
    subst actualContract
    exact ⟨_, (operandChecked.value_summary closed.1).value_context closed.1 [] .none⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

