open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open AuthenticatedResumeExample

/-- The contextual compiler constructs the actual returned-value source and a
checked successor root, without identifying it with scalar pending requirements. -/
theorem checked_resume_successor :
    ∃ owner, ∃ next : ExecutionSite [] operations policy contracts tables families required [] actions
        (OwnerPhaseTransitions.spend (OwnerPhaseTransitions.available (ownedTickets parentStack)) owner)
        [] [] (RecursiveTransport.removeOwner owner resumes) [] ports owners emptyRows (.value .unit) (.value .unit),
    ∃ demand, ∃ requirements : Requirements demand,
      next.expression = .unit ∧ next.runtimeScope = runtimeScope ∧
      ExecutionRoot operations policy contracts tables families required [] actions
        (OwnerPhaseTransitions.spend (OwnerPhaseTransitions.available (ownedTickets parentStack)) owner)
        [] [] (RecursiveTransport.removeOwner owner resumes) [] ports owners emptyRows
        (.value .unit) (.value .unit) next requirements ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner resumes)) []
        (OwnerPhaseTransitions.spend (OwnerPhaseTransitions.available (ownedTickets parentStack)) owner)
        (annotateDisposals requirements) [] ∧
      [0, 1] = owner :: demand ∧
      RawStep ⟨childSite.expression, childSite.runtimeScope, childSite.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [.ticket owner] := by
  obtain ⟨owner, next, demand, requirements, expression, scope, rooted, checked, owners, _bound, raw⟩ :=
    childSite.resume_accounting_successor (entries := resumes) rfl
      ⟨trivial, rfl, by simp [ScopedExpressions.Code.dependencies]⟩ childRun bindRootChecked
  exact ⟨owner, next, demand, requirements, expression, scope, rooted, checked, owners, raw⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AuthenticatedBindResumeExample
