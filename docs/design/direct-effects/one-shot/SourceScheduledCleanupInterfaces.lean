open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation)
open SourceDependencySchemes.Closing (Bound)
open OwnerPhaseTransitions (available spend)

theorem ExecutionSite.discard_resource
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyDiscardSite site) :
    InstallationSupport.PendingChecked ambient outward view.certificate.2 := by
  have current := site.current
  have currentChecked := site.currentResource
  have expression := view.expression
  rw [expression] at current
  have primitive : InstallationSupport.CodeChecked ambient outward
      (SourceAdmission.Code.ready_discard current.previous.authenticated view.resolved current.certificate) :=
    InstallationSupport.checked_discard_primitive current.previous.authenticated view.resolved currentChecked
  have combined := (primitive.reindex_context view.context).discard_pending_at view.located
  exact (combined.output_mode (site.retained.reindex_context view.context).return_mode).reproof

theorem ExecutableState.ready_discard
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world history
      resumes budget ports owners emptyRows (.value terminal) outputRows}
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows (.value terminal) outputRows
      ⟨⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩, actions⟩)
    (view : ReadyDiscardSite site)
    (interpreted : Accounting.Run world history site.rows site.context (root : Requirements demand))
    (phaseAgreement : phases = available (ownedTickets site.stack))
    (bound : Bound annotations site.receiving)
    {annotated : Requirements demand}
    (annotation : RowAnnotation root annotated)
    (checked : Checked (annotateDisposalStore annotatedStore) [] phases (annotateDisposals annotated) row)
    (bounded : row ⊆ budget)
    (identity : Nat) (fresh : Owner.close identity ∉ issued) :
    LexicalUnwind.Event
      ⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩
      ⟨.unwind site.runtimeScope (view.captured.append (.push (.closing identity site.runtimeScope)
        (view.front.append (.spent view.owner view.answerType view.caller view.tail)))),
        issued ++ [.close identity], .ticket view.owner :: completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      (RecursiveTransport.removeOwner view.owner resumes) (RecursiveTransport.removeOwner view.owner disposals)
      (RecursiveTransport.removeOwner view.owner annotatedStore) budget ports owners emptyRows (.value terminal) outputRows
      ⟨⟨.unwind site.runtimeScope (view.captured.append (.push (.closing identity site.runtimeScope)
        (view.front.append (.spent view.owner view.answerType view.caller view.tail)))),
        issued ++ [.close identity], .ticket view.owner :: completed⟩, actions⟩ := by
  have unique : (ownedTickets site.stack).Nodup := owned_tickets_unique (ledger_unique_live state.ledger)
  have actualUnique : (ownedTickets (view.front.append
      (.live view.owner view.inputType view.answerType view.captured view.caller view.tail))).Nodup := by
    simpa only [view.stack] using unique
  have records := state.resumeRecords
  have closingRecords := state.unwindRecords
  simp only [LexicalUnwind.Machine.stack, view.stack] at records closingRecords
  obtain ⟨rootRow, rootCheck, rootIncluded⟩ := (disposal_annotation_map annotation).checked checked
  have current := site.current
  rw [view.expression] at current
  have primitive := Auth.ready_discard_accounting current.previous.authenticated view.resolved interpreted
  have actualRun : Accounting.Run world history (Rows.invoke (key := ⟨view.owner, .dispose⟩))
      (view.frontContext.append (.live (owner := view.owner) (resumeDemand := view.contract.resumeDemand)
        view.capturedContext view.tailContext)) root := by
    change Accounting.Run world history _ site.context.pack.context root at primitive
    rw [view.context] at primitive
    exact primitive
  obtain ⟨nextDemand, nextRoot, _demandSame, waiting, nextCheck⟩ :=
    actualRun.discard_at view.located rootCheck
  obtain ⟨requirements, source, nextRows, _ownership, _evaluation⟩ :=
    view.frontRows.discard_recompose view.savedRows view.tailRows view.answerRows view.answerAnnotation
      view.callerKnown view.closing site.scopeTyped identity
  have phaseSame := OwnerPhaseTransitions.trace_result (OwnerPhaseTransitions.resume_phase_trace actualUnique)
  change available (ownedTickets (view.captured.append (view.front.append
      (.spent view.owner view.answerType view.caller view.tail)))) =
    spend (available (ownedTickets (view.front.append
      (.live view.owner view.inputType view.answerType view.captured view.caller view.tail)))) view.owner at phaseSame
  have nextPhase : spend phases view.owner = available (ownedTickets
      (view.captured.append (.push (.closing identity site.runtimeScope)
        (view.front.append (.spent view.owner view.answerType view.caller view.tail))))) := by
    simpa only [phaseAgreement, view.stack, owned_tickets_append, ownedTickets] using phaseSame.symm
  have nextResource := (site.discard_resource view).phases nextPhase
  have certificate := view.certificate.2
  rw [nextPhase] at certificate nextCheck
  have nextBound : Bound annotations
      (view.capturedScope.append (.running (view.frontScope.append (.spent view.owner view.tailScope)))) := by
    have beforeScope := congrArg Packed.scope view.context
    change site.receiving = view.frontScope.append (.live view.owner view.capturedScope view.tailScope) at beforeScope
    have actualBound : Bound annotations
        (view.frontScope.append (.live view.owner view.capturedScope view.tailScope)) := beforeScope ▸ bound
    obtain ⟨frontBound, liveBound⟩ := Bound.append_iff.mp actualBound
    cases liveBound with
    | live recorded capturedBound tailBound =>
        exact Bound.append_iff.mpr ⟨capturedBound, .running (Bound.append_iff.mpr ⟨frontBound, .spent tailBound⟩)⟩
  have ledger := state.ledger
  rw [view.expression, view.stack] at ledger
  obtain ⟨event, nextLedger, nextRegistry⟩ :=
    LexicalUnwind.ready_discard_ledger_registry ledger state.registry view.resolved view.unprotected fresh
  refine ⟨by simpa only [view.expression, view.stack] using event, ?_⟩
  refine ⟨.unwind source nextRows certificate waiting nextBound .original nextCheck (rootIncluded.trans bounded) nextResource,
    ?_, ?_, ?_, nextLedger, nextRegistry, ?_, ?_, ?_,
    event.ticket_history (by simpa only [view.expression, view.stack] using state.ticketHistory),
    state.captureMetadata.mono (List.subset_append_left _ _)⟩
  · exact planned_resume_records_discard records
  · exact planned_unwind_records_discard closingRecords
  · simpa only [RecursiveConsumption.remove_owner_append] using state.storeAnnotation.remove_owner view.owner
  · cases state.resources with
    | eval supported =>
        apply LexicalUnwind.MachineAccess.unwind
        apply LexicalUnwind.discard_access
        simpa only [view.stack] using supported.control
  · change (view.captured.append (.push (.closing identity site.runtimeScope)
      (view.front.append (.spent view.owner view.answerType view.caller view.tail)))).erase.activations ⊆ history
    intro activation member
    apply state.activations
    change activation ∈ site.stack.erase.activations
    rw [view.stack]
    simp only [erase_append, Stack.erase, ExecFrame.erase, activations_append, Control.activations,
      closeFrame, Frame.activation, List.mem_append, List.nil_append] at member ⊢
    rcases member with member | member | member
    · exact Or.inr (Or.inl member)
    · exact Or.inl member
    · exact Or.inr (Or.inr member)
  · change ScopedTyping.resourceWorld (issued ++ [Owner.close identity]) ⊆ world
    rw [ScopedTyping.resource_world_append]
    simpa only [ScopedTyping.resourceWorld, List.filterMap_cons, List.filterMap_nil, List.append_nil]
      using state.issuedResources

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.ready_discard

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport

/-- The common predecessor state supplies the selected discard root and every
source premise. A fresh close boundary is the only runtime allocation. -/
theorem ExecutableState.discard_successor
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows (.value terminal) outputRows
      ⟨⟨.eval ⟨.discard binder, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (identity : Nat) (fresh : Owner.close identity ∉ issued) :
    ∃ owner nextStack,
      LexicalUnwind.Event
        ⟨.eval ⟨.discard binder, runtimeScope, stack⟩, issued, completed⟩
        ⟨.unwind runtimeScope nextStack, issued ++ [.close identity], .ticket owner :: completed⟩ ∧
      ExecutableState operations policy contracts tables families required outward annotations world ambient history
        (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner disposals)
        (RecursiveTransport.removeOwner owner annotatedStore) budget ports owners emptyRows (.value terminal) outputRows
        ⟨⟨.unwind runtimeScope nextStack, issued ++ [.close identity], .ticket owner :: completed⟩, actions⟩ := by
  have source := state.source
  dsimp only at source
  generalize machineEq : LexicalUnwind.Machine.eval ⟨.discard binder, runtimeScope, stack⟩ = machine at source
  cases source with
  | eval site phaseAgreement rooted bound annotation checked bounded =>
      obtain ⟨expression, runtime, stackSame⟩ := ScopedExecution.Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
      have actualState : ExecutableState operations policy contracts tables families required outward annotations world ambient history
          resumes disposals annotatedStore budget ports owners emptyRows (.value terminal) outputRows
          ⟨⟨.eval ⟨site.expression, site.runtimeScope, site.stack⟩, issued, completed⟩, actions⟩ := by
        simpa only [← expression, ← runtime, ← stackSame] using state
      cases rooted with
      | contextual interpreted =>
          obtain ⟨view⟩ := site.discard_origin expression.symm
          obtain ⟨event, next⟩ := actualState.ready_discard view interpreted phaseAgreement bound annotation checked bounded identity fresh
          refine ⟨view.owner, view.captured.append (.push (.closing identity site.runtimeScope)
            (view.front.append (.spent view.owner view.answerType view.caller view.tail))), ?_, ?_⟩
          · simpa only [← expression, ← runtime, ← stackSame] using event
          · simpa only [← runtime] using next
      | branch selected inside =>
          have branch := selected.1
          rw [← expression] at branch
          cases branch
      | focus focused inside =>
          have focus := focused.1
          rw [← expression] at focus
          cases focus
  | unwind => cases machineEq

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.discard_successor



namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Selecting a Boolean branch preserves the same visible continuation demand.
The branch-local proof needs no machine ownership-accounting premise. -/
theorem branch_machine_ticket_access
    (access : MachineTicketAccess policy tickets
      (.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩)) :
    MachineTicketAccess policy tickets
      (.eval ⟨if condition then yes else no, runtimeScope, stack⟩) := by
  obtain ⟨demand, code, visible, pending⟩ := access
  have branches := branch_code_demand code
  cases condition
  · exact ⟨demand, branches.2, visible, pending⟩
  · exact ⟨demand, branches.1, visible, pending⟩

/-- Branch selection preserves all independent operational fields without
old MachineUse or a successor-access premise. -/
theorem branch_operational
    (ledger : Ledger (RunState.erase
      ⟨.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩, issued, completed⟩))
    (history : UsageRegistryHistory tickets issued)
    (ticketsAccessible : MachineTicketAccess policy tickets
      (.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩))
    (resourcesAccessible : MachineAccess ambient
      (.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩)) :
    Event
      ⟨.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩, issued, completed⟩
      ⟨.eval ⟨if condition then yes else no, runtimeScope, stack⟩, issued, completed⟩ ∧
    Ledger (RunState.erase
      ⟨.eval ⟨if condition then yes else no, runtimeScope, stack⟩, issued, completed⟩) ∧
    UsageRegistryHistory tickets issued ∧
    MachineTicketAccess policy tickets
      (.eval ⟨if condition then yes else no, runtimeScope, stack⟩) ∧
    MachineAccess ambient (.eval ⟨if condition then yes else no, runtimeScope, stack⟩) := by
  have selected : ScopedPortJoint.OrdinaryStep
      ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩
      ⟨if condition then yes else no, runtimeScope, stack⟩ := by
    cases condition
    · exact .ifFalse
    · exact .ifTrue
  have raw := ScopedPortJoint.ordinary_step_executes selected
  have transition : Transition
      (.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩)
      (.eval ⟨if condition then yes else no, runtimeScope, stack⟩) [] [] :=
    .evaluate raw trivial
  have event : Event
      ⟨.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩, issued, completed⟩
      ⟨.eval ⟨if condition then yes else no, runtimeScope, stack⟩, issued, completed⟩ := by
    simpa only [List.append_nil, List.nil_append] using
      (Event.step (before := ⟨.eval ⟨.branch (.boolean condition) yes no, runtimeScope, stack⟩, issued, completed⟩)
        transition (by simpa only [List.append_nil, RunState.erase] using ledger.2))
  refine ⟨event, event_preserves_ledger event ledger, history,
    branch_machine_ticket_access ticketsAccessible, ?_⟩
  cases resourcesAccessible with
  | eval supported =>
      exact .eval (raw_step_preserves_access raw supported
        (ScopedPortJoint.ordinary_step_access_checks selected))

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.LexicalUnwind.branch_machine_ticket_access
