namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ProtectionContracts
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourcePlanSignatures (Signature ModeSignatures ClauseSignatures)

mutual
/-- Additional callback-row data indexed by the existing stable signature.
The index retains all prior dependency, clause-right and signature facts.
Rows are authenticated by source rules, not by this data declaration. -/
inductive Rows : {dependencies : Dependencies} → Signature dependencies → Type where
  | pure : Rows .pure
  | request : Rows (.request (effect := effect) (operation := operation))
  | invoke : Rows (.invoke (key := key))
  | sequence : Rows first → Rows second → Rows (.sequence first second)
  | choice : Rows first → Rows second → Rows (.choice first second)
  | handler : ClauseRows declarations → Rows body →
      Rows (.handler (effect := effect) (table := table) required declarations body)
  | cleanup (latent : Footprint) : Rows callback → Rows body →
      Rows (.cleanup (needs := needs) callback body)
  | resource : (∀ identity, Rows (body identity)) → Rows (.resource body)

/-- Available clauses retain row decorations for every fresh owner instance. -/
inductive ModeRows : {family : Option (Nat → Dependencies)} → ModeSignatures family → Type where
  | unavailable : ModeRows .unavailable
  | available : (∀ owner, Rows (body owner)) → ModeRows (.available body)

/-- Clause rights remain in the existing signature index, unchanged. -/
inductive ClauseRows : {families : ClauseDependencies} → ClauseSignatures families → Type where
  | nil : ClauseRows .nil
  | cons (ordinaryRows : ModeRows ordinary) (protectedRows : ModeRows protectedMode)
      (restRows : ClauseRows rest) (supportBound : List Nat := []) :
      ClauseRows (.cons (operation := operation) rights ordinary protectedMode rest)
end

/-- Finite declaration support is data; AuthDeclarations validates it against
the same clause syntax and parameter-sensitive value environment. -/
def ClauseRows.resourceSupport : ClauseRows declarations → List Nat
  | .nil => []
  | .cons _ _ rest supportBound => supportBound ++ rest.resourceSupport

/-- Reading the stored row does not assert that source typing validates it. -/
def Rows.cleanupLatent (rows : Rows (.cleanup (needs := needs) callback body)) : Footprint :=
  match rows with
  | .cleanup latent _ _ => latent

@[simp] theorem Rows.cleanupLatent_constructor
    (callbackRows : Rows callback) (bodyRows : Rows body) :
    (Rows.cleanup (needs := needs) latent callbackRows bodyRows).cleanupLatent = latent := rfl

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Rows.cleanupLatent_constructor

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourcePlannedTyping (Value Environment Operations Contract Contracts)
open SourceDeclarationPlans (ModePlans ClausePlans)
open SourcePlanSignatures (Signature signature modeSignatures clauseSignatures)

/-- Function values carry their body decoration, including nested cleanup rows.
This data becomes trustworthy only through the structural source judgment below. -/
inductive ValueRows : Value → Type where
  | unit : ValueRows .unit
  | boolean : ValueRows .boolean
  | integer : ValueRows .integer
  | reference : ValueRows (.reference identity)
  | pair : ValueRows first → ValueRows second → ValueRows (.pair first second)
  | function : ValueRows input → ValueRows output → Rows body →
      ValueRows (.function input output requests latent body)

abbrev EnvironmentRows (environment : Environment) :=
  ∀ name value, environment name = some value → ValueRows value

def EnvironmentRows.extend (rows : EnvironmentRows environment) (name : Nat)
    (valueRows : ValueRows value) : EnvironmentRows (environment.extend name value) := by
  intro other result known
  by_cases same : other = name
  · subst other
    have eq : value = result := Option.some.inj (by simpa [Environment.extend] using known)
    subst result
    exact valueRows
  · exact rows other result (by simpa [Environment.extend, same] using known)

abbrev OperationRows (operations : Operations) :=
  ∀ effect operation input output, operations effect operation = some (input, output) →
    ValueRows input × ValueRows output

abbrev ContractRows (contracts : Contracts) :=
  ∀ owner contract, contracts owner = some contract →
    ValueRows contract.input × ValueRows contract.answer

def ContractRows.insert (rows : ContractRows contracts) (owner : Nat)
    (input : ValueRows contract.input) (answer : ValueRows contract.answer) :
    ContractRows (contracts.insert owner contract) := by
  intro other result known
  by_cases same : other = owner
  · subst other
    have eq : contract = result := Option.some.inj (by simpa [Contracts.insert] using known)
    subst result
    exact ⟨input, answer⟩
  · exact rows other result (by simpa [Contracts.insert, same] using known)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.LambdaPortCaptureSupport
open ScopedExpressions ScopedExecution ProtectionContracts
open SourcePlannedTyping (Value Environment)

/-- Existing declared port resources interpreted as lexical variable support. -/
def portSupport (environment : Environment) : ScopedPorts.Support.Env :=
  fun name => ((environment name).map (fun value => value.erase.erase.port.resources)).getD []

theorem portSupport_extend (environment : Environment) (name : Nat) (value : Value) :
    portSupport (environment.extend name value) =
      ScopedPorts.Support.extend (portSupport environment) name value.erase.erase.port.resources := by
  funext other
  simp only [portSupport, Environment.extend, ScopedPorts.Support.extend]
  split <;> rfl

theorem literal_support (environment : ScopedPorts.Support.Env) (dependencies : List Syntax.Dependency) :
    Syntax.resourceDependencies dependencies ⊆ ScopedPorts.Support.evaluate environment dependencies := by
  intro identity member
  exact List.mem_flatMap.mpr ⟨.resource identity, Syntax.mem_resourceDependencies.mp member, by simp⟩

/-- This is the proposed extra lambda premise. The lambda dependency list
already removes its bound parameter; free variables use their declared ports. -/
def captures (environment : Environment) (parameter : Nat) (body : Code)
    (input output : Value) (requests : List Instance) : Prop :=
  ScopedPorts.Support.evaluate (portSupport environment) (Code.lambda parameter body).dependencies ⊆
    (input.erase.erase.port.resources ++ output.erase.erase.port.resources ++ requests.flatMap Instance.resources)

theorem lambda_value_support {input output : Value}
    (guard : captures environment parameter body input output requests) :
    Syntax.resourceDependencies (Code.lambda parameter body).dependencies ⊆
      (CoherentSourceTypes.Value.function input.erase.erase output.erase.erase requests latent).port.resources := by
  exact (literal_support _ _).trans guard

/-- The existing substitution-support theorem transports this finite guard.
Replacement support is the value-support induction hypothesis, not a future check. -/
theorem substitution_support {input : Value} {expression : Code}
    (closed : ClosedValue value)
    (valueSupport : Syntax.resourceDependencies value.dependencies ⊆ input.erase.erase.port.resources)
    (guard : ScopedPorts.Support.evaluate (portSupport (environment.extend name input)) expression.dependencies ⊆ resources) :
    ScopedPorts.Support.evaluate (portSupport environment) (expression.subst name value).dependencies ⊆ resources := by
  rw [portSupport_extend] at guard
  exact (ScopedPorts.Support.substitution_support_bound expression name closed valueSupport).trans guard

theorem captures_environment
    (guard : captures environment parameter body input output requests)
    (agree : SourcePlannedTyping.AgreeOn environment destination (Code.lambda parameter body).dependencies) :
    captures destination parameter body input output requests := by
  have same := ScopedPorts.Support.evaluation_congr (source := portSupport environment)
    (dependencies := (Code.lambda parameter body).dependencies)
    (destination := portSupport destination) (fun name member => by simp only [portSupport, agree name member])
  change _ ⊆ _ at guard ⊢
  rw [← same]
  exact guard
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.LambdaPortCaptureSupport

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.LambdaPortCaptureSupport
open ScopedExpressions ScopedExecution
open SourcePlannedTyping (Value Environment)

theorem declaration_bound_environment {body : Code}
    {environment destination : Environment}
    (bounded : ScopedPorts.Support.evaluate (portSupport (environment.extend parameter argument))
      body.dependencies ⊆ supportBound)
    (agree : SourcePlannedTyping.AgreeOn environment destination
      (Syntax.without (.variable parameter) body.dependencies)) :
    ScopedPorts.Support.evaluate (portSupport (destination.extend parameter argument))
      body.dependencies ⊆ supportBound := by
  have same := ScopedPorts.Support.evaluation_congr
    (source := portSupport (environment.extend parameter argument))
    (destination := portSupport (destination.extend parameter argument))
    (dependencies := body.dependencies)
    (fun name member => by
      simp only [portSupport, SourcePlannedTyping.agree_extend agree name member])
  rw [← same]
  exact bounded

theorem declaration_bound_substitution {body : Code} {input argument : Value}
    {environment : Environment}
    (closed : ClosedValue value)
    (valueSupport : Syntax.resourceDependencies value.dependencies ⊆ input.erase.erase.port.resources)
    (bounded : ScopedPorts.Support.evaluate
      (portSupport ((environment.extend name input).extend parameter argument))
      body.dependencies ⊆ supportBound) :
    ScopedPorts.Support.evaluate (portSupport (environment.extend parameter argument))
      (if name = parameter then body else body.subst name value).dependencies ⊆ supportBound := by
  by_cases same : name = parameter
  · subst parameter
    simpa only [ite_true, Environment.extend_shadow] using bounded
  · rw [Environment.extend_commute environment name parameter input argument same] at bounded
    simpa only [if_neg same] using substitution_support closed valueSupport bounded

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.LambdaPortCaptureSupport
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.LambdaPortCaptureSupport.declaration_bound_environment
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.LambdaPortCaptureSupport.declaration_bound_substitution


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourcePlannedTyping (Value Environment Operations Contract Contracts)
open SourceDeclarationPlans (ModePlans ClausePlans)
open SourcePlanSignatures (Signature signature modeSignatures clauseSignatures)

/- Authentication refines the same rich typing judgment with coherent structural
witnesses. Recursive premises decorate matched intermediate types; an arbitrary decoration is
never an admission rule. Lambda captures are bounded by their declared function ports;
receiver checks remain separate. -/
mutual
inductive Auth (operations : Operations) (policy : Syntax.TicketPolicy)
    (ports : OperationRows operations) :
    {contracts : Contracts} → ContractRows contracts →
    {world : List Nat} → {allowed : List Instance} → {scope : Execution.Scope} →
    {environment : Environment} → EnvironmentRows environment →
    {code : Code} → {value : Value} → {demand : List Nat} →
    {requirements : Requirements demand} → {dependencies : Dependencies} →
    {checking : Signature dependencies} →
    SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      code value demand requirements checking → ValueRows value → Rows checking → Prop where
  | unit : Auth operations policy ports owners environmentRows .unit .unit .pure
  | boolean : Auth operations policy ports owners environmentRows (.boolean (value := value)) .boolean .pure
  | integer : Auth operations policy ports owners environmentRows (.integer (value := value)) .integer .pure
  | reference : Auth operations policy ports owners environmentRows (.reference issued) .reference .pure
  | variable {environment : Environment} {environmentRows : EnvironmentRows environment} {known : environment name = some value} :
      Auth operations policy ports owners environmentRows (.variable known formed)
      (environmentRows name value known) .pure
  | lambda {environment : Environment} {environmentRows : EnvironmentRows environment}
      {input : Value} {inputRows : ValueRows input}
      {body : SourcePlannedSources.Expression operations policy contracts world requests .none
        (environment.extend parameter input) code output bodyDemand bodyRequirements checking}
      (checked : Auth operations policy ports owners (environmentRows.extend parameter inputRows)
        body outputRows bodyRows)
      (captured : LambdaPortCaptureSupport.captures environment parameter code input output requests)
      {outward : RecursiveOutward.Outward bodyRequirements (some latent)}
      {formed : ScopedPorts.InWorld world (CoherentSourceTypes.Value.function input.erase.erase output.erase.erase requests latent).port}
      {latentBound : ∀ request ∈ latent, request.effect ∈ requests} :
      Auth operations policy ports owners environmentRows (.lambda (latent := latent) body outward formed latentBound)
        (.function inputRows outputRows bodyRows) .pure
  | purePair
      {left : SourcePlannedSources.Expression operations policy contracts world allowed scope environment a first [] (.request [] []) .pure}
      {right : SourcePlannedSources.Expression operations policy contracts world allowed scope environment b second [] (.request [] []) .pure}
      (leftChecked : Auth operations policy ports owners environmentRows left firstRows .pure)
      (rightChecked : Auth operations policy ports owners environmentRows right secondRows .pure) :
      Auth operations policy ports owners environmentRows (.purePair left right)
        (.pair firstRows secondRows) .pure
  | pair
      {left : SourcePlannedSources.Expression operations policy contracts world allowed scope environment a first leftDemand leftReq leftDep}
      {right : SourcePlannedSources.Expression operations policy contracts world allowed scope environment b second rightDemand rightReq rightDep}
      (leftChecked : Auth operations policy ports owners environmentRows left firstRows leftRows)
      (rightChecked : Auth operations policy ports owners environmentRows right secondRows rightRows) :
      Auth operations policy ports owners environmentRows (.pair left right)
        (.pair firstRows secondRows) (.sequence leftRows rightRows)
  | app
      {function : SourcePlannedSources.Expression operations policy contracts world allowed scope environment f
        (.function input output requests latent checking) functionDemand functionReq functionDep}
      {argument : SourcePlannedSources.Expression operations policy contracts world allowed scope environment a input argumentDemand argumentReq argumentDep}
      (functionChecked : Auth operations policy ports owners environmentRows function
        (.function inputRows outputRows bodyRows) functionRows)
      (argumentChecked : Auth operations policy ports owners environmentRows argument inputRows argumentRows) :
      Auth operations policy ports owners environmentRows (.app function argument admitted)
        outputRows (.sequence functionRows (.sequence argumentRows bodyRows))
  | bind {environment : Environment} {environmentRows : EnvironmentRows environment}
      {input : Value} {inputRows : ValueRows input}
      {initializer : SourcePlannedSources.Expression operations policy contracts world allowed scope environment a input initialDemand initialReq initialDep}
      {body : SourcePlannedSources.Expression operations policy contracts world allowed scope (environment.extend parameter input) b output bodyDemand bodyReq bodyDep}
      (initialChecked : Auth operations policy ports owners environmentRows initializer inputRows initialRows)
      (bodyChecked : Auth operations policy ports owners (environmentRows.extend parameter inputRows) body outputRows bodyRows) :
      Auth operations policy ports owners environmentRows (.bind initializer body) outputRows (.sequence initialRows bodyRows)
  | branch
      {condition : SourcePlannedSources.Expression operations policy contracts world allowed scope environment test .boolean conditionDemand conditionReq conditionDep}
      {yes : SourcePlannedSources.Expression operations policy contracts world allowed scope environment a output yesDemand yesReq yesDep}
      {no : SourcePlannedSources.Expression operations policy contracts world allowed scope environment b output noDemand noReq noDep}
      (conditionChecked : Auth operations policy ports owners environmentRows condition .boolean conditionRows)
      (yesChecked : Auth operations policy ports owners environmentRows yes outputRows yesRows)
      (noChecked : Auth operations policy ports owners environmentRows no outputRows noRows) :
      Auth operations policy ports owners environmentRows (.branch condition yes no same)
        outputRows (.sequence conditionRows (.choice yesRows noRows))
  | perform
      {operand : SourcePlannedSources.Expression operations policy contracts world allowed scope environment value input operandDemand operandReq operandDep}
      (operandChecked : Auth operations policy ports owners environmentRows operand
        (ports effect operation input output known).1 operandRows) :
      Auth operations policy ports owners environmentRows (.perform known admitted operand formed)
        (ports effect operation input output known).2 (.sequence operandRows .request)
  | handler
      {plans : ClausePlans arms families}
      {declarationRows : ClauseRows (clauseSignatures plans)}
      {body : SourcePlannedSources.Expression operations policy contracts world (effect :: residual) scope environment code answer demand requirements checking}
      {declarations : SourcePlannedSources.Declarations operations policy contracts world environment residual effect answer arms table plans}
      (bodyChecked : Auth operations policy ports owners environmentRows body answerRows bodyRows)
      (declarationsChecked : AuthDeclarations operations policy ports owners environmentRows answerRows declarations declarationRows) :
      Auth operations policy ports owners environmentRows
        (.handler body clauses capabilities coverage unique admitted table modes declarations)
        answerRows (.handler (required := required) declarationRows bodyRows)
  | resume
      {operand : SourcePlannedSources.Expression operations policy contracts world allowed scope environment value contract.input operandDemand operandReq operandDep}
      (operandChecked : Auth operations policy ports owners environmentRows operand
        (owners owner contract known).1 operandRows) :
      Auth operations policy ports owners environmentRows (.resume known resolved permission operand admitted formed)
        (owners owner contract known).2 (.sequence operandRows .invoke)
  | discard : Auth operations policy ports owners environmentRows
      (.discard known resolved permission unprotected admitted) .unit .invoke
  | cleanup
      {callback : SourcePlannedSources.Expression operations policy contracts world allowed scope environment action
        (.function .unit .unit requests latent callbackBody) callbackDemand callbackReq callbackDep}
      {body : SourcePlannedSources.Expression operations policy contracts world allowed scope environment code output bodyDemand bodyReq bodyDep}
      (callbackChecked : Auth operations policy ports owners environmentRows callback
        (.function .unit .unit callbackBodyRows) callbackRows)
      (bodyChecked : Auth operations policy ports owners environmentRows body outputRows bodyRows) :
      Auth operations policy ports owners environmentRows (.cleanup callback body admitted)
        outputRows (.sequence callbackRows (.cleanup latent callbackBodyRows bodyRows))
  | resource {code : Code}
      {bodyRequirements : Nat → Requirements bodyDemand} {bodyDependencies : Nat → Dependencies}
      {bodySignatures : ∀ identity, Signature (bodyDependencies identity)}
      {bodyRows : ∀ identity, Rows (bodySignatures identity)}
      {initializer : SourcePlannedSources.Expression operations policy contracts world allowed scope environment initial .integer initialDemand initialRequirements initialDep}
      {body : ∀ identity, identity ∉ world → SourcePlannedSources.Expression operations policy contracts (world ++ [identity])
        (.cell identity :: residual) scope environment
        (code.instantiate (Instantiation.Environment.empty.bind binder identity)) output bodyDemand (bodyRequirements identity) (bodySignatures identity)}
      (initialChecked : Auth operations policy ports owners environmentRows initializer .integer initialRows)
      (bodyChecked : ∀ identity (fresh : identity ∉ world),
        Auth operations policy ports owners environmentRows (body identity fresh) outputRows (bodyRows identity))
      {outward : Requirements bodyDemand}
      {hidden : ∀ identity, identity ∉ world → ResourceRequirements.Hides identity (bodyRequirements identity) outward} :
      Auth operations policy ports owners environmentRows (.resource initializer body formed effectsBound admitted hidden)
        outputRows (.sequence initialRows (.resource bodyRows))

inductive AuthBody (operations : Operations) (policy : Syntax.TicketPolicy)
    (ports : OperationRows operations) :
    {contracts : Contracts} → ContractRows contracts →
    {world : List Nat} → {allowed : List Instance} → {scope : Execution.Scope} →
    {environment : Environment} → EnvironmentRows environment →
    {code : Code} → {answer : Value} → ValueRows answer → {header : ClauseRowAdmission.Header} →
    {dependencies : Dependencies} → {checking : Signature dependencies} →
    SourcePlannedSources.Body operations policy contracts world allowed scope environment code answer header checking →
    Rows checking → Prop where
  | typed
      {source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment code answer demand requirements checking}
      (checked : Auth operations policy ports owners environmentRows source answerRows checkingRows) :
      AuthBody operations policy ports owners environmentRows answerRows (.typed source rows closingRows) checkingRows

inductive AuthOffer (operations : Operations) (policy : Syntax.TicketPolicy)
    (ports : OperationRows operations) :
    {contracts : Contracts} → ContractRows contracts → {world : List Nat} →
    {environment : Environment} → EnvironmentRows environment →
    {allowed : List Instance} → {parameter binder : Nat} →
    {argument : Value} → ValueRows argument → {input : Value} → ValueRows input →
    {answer : Value} → ValueRows answer →
    {resumeEffects closeEffects : List Instance} → {code : Code} → {held disposes : Bool} →
    {row : Option Footprint} → {family : Option (Nat → Dependencies)} → {plans : ModePlans family} →
    SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
      resumeEffects closeEffects code held disposes row plans → ModeRows (modeSignatures plans) → Prop where
  | unavailable : AuthOffer operations policy ports owners environmentRows argumentRows inputRows answerRows .unavailable .unavailable
  | available {contracts : Contracts} {owners : ContractRows contracts}
      {environment : Environment} {environmentRows : EnvironmentRows environment}
      {argument : Value} {argumentRows : ValueRows argument}
      {family : Nat → Dependencies}
      {plans : ∀ owner, SourceDeclarationPlans.Plan (family owner)}
      {bodyRows : ∀ owner, Rows (signature (plans owner))}
      {source : ∀ owner (contract : Contract), contracts owner = none →
        contract.input = input → contract.answer = answer →
        contract.resumeEffects = resumeEffects → contract.closeEffects = closeEffects →
        contract.held = held → contract.closeDemand.Perm contract.resumeDemand →
        SourcePlannedSources.Body operations policy (contracts.insert owner contract) world allowed (.ticket binder owner)
          (environment.extend parameter argument) code answer ⟨owner, contract.erase.erase, disposes, row⟩ (signature (plans owner))}
      (checked : ∀ owner (contract : Contract) (fresh : contracts owner = none)
          (inputSame : contract.input = input) (answerSame : contract.answer = answer)
          (resumeSame : contract.resumeEffects = resumeEffects) (closeSame : contract.closeEffects = closeEffects)
          (heldSame : contract.held = held) (demands : contract.closeDemand.Perm contract.resumeDemand),
        AuthBody operations policy ports
          (owners.insert owner (inputSame.symm ▸ inputRows) (answerSame.symm ▸ answerRows))
          (environmentRows.extend parameter argumentRows) answerRows
          (source owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands) (bodyRows owner)) :
      AuthOffer operations policy ports owners environmentRows argumentRows inputRows answerRows
        (.available resumeInterface closeInterface source) (.available bodyRows)

inductive AuthDeclarations (operations : Operations) (policy : Syntax.TicketPolicy)
    (ports : OperationRows operations) :
    {contracts : Contracts} → ContractRows contracts → {world : List Nat} →
    {environment : Environment} → EnvironmentRows environment →
    {allowed : List Instance} → {requested : Instance} → {answer : Value} → ValueRows answer →
    {clauses : Clauses} → {table : List (Nat × ClauseContract)} →
    {families : ClauseDependencies} → {plans : ClausePlans clauses families} →
    SourcePlannedSources.Declarations operations policy contracts world environment allowed requested answer clauses table plans →
    ClauseRows (clauseSignatures plans) → Prop where
  | nil : AuthDeclarations operations policy ports owners environmentRows answerRows .nil .nil
  | cons
      {ordinary : SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
        resumeEffects closeEffects body false dispose ordinaryRow ordinaryPlan}
      {protectedMode : SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
        resumeEffects closeEffects body true dispose protectedRow protectedPlan}
      {rest : SourcePlannedSources.Declarations operations policy contracts world environment allowed requested answer clauses table restPlan}
      (ordinaryChecked : AuthOffer operations policy ports owners environmentRows
        (ports requested operation argument input known).1 (ports requested operation argument input known).2 answerRows ordinary ordinaryRows)
      (protectedChecked : AuthOffer operations policy ports owners environmentRows
        (ports requested operation argument input known).1 (ports requested operation argument input known).2 answerRows protectedMode protectedRows)
      (restChecked : AuthDeclarations operations policy ports owners environmentRows answerRows rest restRows)
      {supportBound : List Nat}
      (support : ScopedPorts.Support.evaluate
        (LambdaPortCaptureSupport.portSupport (environment.extend parameter argument))
        body.dependencies ⊆ supportBound) :
      AuthDeclarations operations policy ports owners environmentRows answerRows
        (.cons (body := body) (operation := operation) known ordinary protectedMode rest) (by simpa only [clauseSignatures] using
          (ClauseRows.cons (operation := operation) (rights := body.requiredActions)
            ordinaryRows protectedRows restRows supportBound))
end

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Value)
open SourcePlanSignatures (Signature)

/-- Authenticated values retain only resources named by their declared port. -/
theorem Auth.value_support
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : Auth operations policy ports owners environmentRows
      (source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        code value demand requirements checking) valueRows rows)
    (isValue : code.IsValue) : Syntax.resourceDependencies code.dependencies ⊆ value.erase.erase.port.resources := by
  induction checked using Auth.rec
      (motive_2 := fun {_} _ {_ _ _ _} _ {_ _} _ {_ _ _} _ _ _ => True)
      (motive_3 := fun {_} _ {_ _} _ {_ _ _ _} _ {_} _ {_} _ {_ _ _ _ _ _ _ _} _ _ _ => True)
      (motive_4 := fun {_} _ {_ _} _ {_ _ _} _ {_ _ _ _} _ _ _ => True) with
  | unit | boolean | integer => exact List.nil_subset _
  | reference => exact List.Subset.refl _
  | purePair left right ihLeft ihRight | pair left right ihLeft ihRight =>
      simpa only [Code.dependencies, ScopedExecution.resource_dependencies_append, Value.erase,
        SourceDependencyAnnotations.Value.erase, CoherentSourceTypes.Value.port, ScopedPorts.Port.resources] using
        ScopedExpressions.append_subset (ihLeft isValue.1) (ihRight isValue.2)
  | lambda body captured ih => exact LambdaPortCaptureSupport.lambda_value_support captured
  | «variable» | app | bind | branch | perform | handler | resume | discard | cleanup | resource => cases isValue
  | typed | unavailable | available | nil | cons => trivial

/-- An authenticated syntactic cleanup has a coherent typed callback witness
with exactly the latent row and recursive decoration stored at this site.
This is existence, not uniqueness of an older Prop-valued derivation. -/
theorem Auth.cleanup_callback
    {callbackSignature : Signature callbackDependencies}
    {callbackBody : Signature callbackBodyDependencies}
    {bodySignature : Signature bodyDependencies}
    {callbackRows : Rows callbackSignature} {callbackBodyRows : Rows callbackBody}
    {bodyRows : Rows bodySignature}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.cleanup action code) output demand requirements
      (.sequence callbackSignature (.cleanup (needs := requests) callbackBody bodySignature))}
    (checked : Auth operations policy ports owners environmentRows source outputRows
      (.sequence callbackRows (.cleanup latent callbackBodyRows bodyRows))) :
    ∃ callbackDemand, ∃ callbackRequirements : Requirements callbackDemand,
    ∃ callbackSource : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      action (.function .unit .unit requests latent callbackBody) callbackDemand callbackRequirements callbackSignature,
      Auth operations policy ports owners environmentRows callbackSource
        (.function .unit .unit callbackBodyRows) callbackRows := by
  cases checked with
  | cleanup callbackChecked bodyChecked => exact ⟨_, _, _, callbackChecked⟩

/-- Authenticated lambda metadata comes from an authenticated body under its
actual decorated argument environment, including higher-order argument rows. -/
theorem Auth.lambda_body
    {bodySignature : Signature bodyDependencies}
    {inputRows : ValueRows input} {outputRows : ValueRows output}
    {bodyRows : Rows bodySignature}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.lambda parameter code) (.function input output requests latent bodySignature) demand requirements .pure}
    (checked : Auth operations policy ports owners environmentRows source
      (.function inputRows outputRows bodyRows) .pure) :
    ∃ bodyDemand, ∃ bodyRequirements : Requirements bodyDemand,
    ∃ bodySource : SourcePlannedSources.Expression operations policy contracts world requests .none
      (environment.extend parameter input) code output bodyDemand bodyRequirements bodySignature,
      Auth operations policy ports owners (environmentRows.extend parameter inputRows) bodySource outputRows bodyRows ∧
      RecursiveOutward.Outward bodyRequirements (some latent) := by
  cases checked with
  | lambda bodyChecked captured => exact ⟨_, _, _, bodyChecked, by assumption⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.cleanup_callback
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.lambda_body

