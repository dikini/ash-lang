open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDeclarationPlans (ClausePlans)
open SourcePlanSignatures (clauseSignatures)

/-- Actual clause lookup projects its authenticated parameter-sensitive support
into the finite annotation of the same retained declaration rows. -/
theorem AuthDeclarations.selected_support
    {plans : ClausePlans clauses families}
    {declarationRows : ClauseRows (clauseSignatures plans)}
    {source : SourcePlannedSources.Declarations operations policy contracts world environment allowed effect answer clauses table plans}
    (authenticated : AuthDeclarations operations policy ports owners environmentRows answerRows source declarationRows)
    (selected : ClauseAt operation clauses parameter binder code) :
    ∃ argument input, operations effect operation = some (argument, input) ∧
      ScopedPorts.Support.evaluate
        (LambdaPortCaptureSupport.portSupport (environment.extend parameter argument))
        code.dependencies ⊆ declarationRows.resourceSupport := by
  induction selected generalizing table families with
  | hit => cases authenticated with
    | cons ordinary protectedMode rest support =>
      refine ⟨_, _, by assumption, ?_⟩
      intro resource member
      exact List.mem_append_left _ (support member)
  | pass different next ih => cases authenticated with
    | cons ordinary protectedMode rest support =>
      obtain ⟨argument, input, known, bounded⟩ := ih rest
      refine ⟨argument, input, known, ?_⟩
      intro resource member
      exact List.mem_append_right _ (bounded member)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
