/-- Resource release preserves the complete rich value and caller source.
The explicit value-support bound supplies the existing release obligation,
including resources captured by higher-order values. -/
theorem leave_resource_planned_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      value input currentDemand currentRequirements (signature plan))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.cell identity payload caller answer) tail) (.value input) output pendingDemand pendingRequirements dependencyScope)
    (closed : ClosedValue value)
    (valueSupport : Syntax.resourceDependencies value.dependencies ⊆ supportBound)
    (excluded : identity ∉ supportBound)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints (.push (.cell identity payload caller answer) tail))
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.cell identity payload caller answer) tail))) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (unique : (ownedTickets (.push (.cell identity payload caller answer) tail)).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩)) :
    ∃ nextScope, ∃ nextRequirements : Requirements pendingDemand,
    ∃ nextHints : ReturnHints nextScope, ∃ nextAnnotated : Requirements ([] ++ pendingDemand), ∃ nextRow,
      currentDemand = [] ∧ dependencyScope = .cell identity nextScope ∧ ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      SourcePlannedSources.Expression operations policy contracts world allowed caller (fun _ => none)
        value input [] (.request [] []) (signature Plan.pure) ∧
      Certified (evidence := declarationPolicy) outward world Plan.pure ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        tail (.value input) output pendingDemand nextRequirements nextScope ∧
      RowAnnotation (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) nextRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world .pure nextHints ∧
      Pending outward actions phases world nextHints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families nextHints tail ∧ Bound annotations nextScope ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.cell identity payload caller answer) tail) key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.cell identity payload caller answer) tail) key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      RawStep ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩ ⟨value, caller, tail⟩ [] [.resource identity] ∧
      LexicalUnwind.UseTransition (.eval ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩)
        (.eval ⟨value, caller, tail⟩) [] [.resource identity] ∧
      ownedTickets tail = ownedTickets (.push (.cell identity payload caller answer) tail) ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨value, caller, tail⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, caller, tail⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨value, caller, tail⟩) := by
  have empty := SourceTemplates.expression_value_demand
    (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
      (SourcePlannedSources.expression_erase current))) closed.1
  subst currentDemand
  cases pending with
  | push frame rest => cases frame with
    | ordinary frame => cases frame with
      | cell scopeKnown noEscape answerAnnotation interface =>
        cases interface with | cell callerKnown missing =>
        cases matching with | cell restMatch =>
        cases retained with | cell restCheck =>
        cases annotationBound with | cell restBound =>
        obtain ⟨tailAnnotated, tailAnnotation, tailPath⟩ := annotation.focus
          (RequirementPath.second (RequirementPath.second (.here)))
        obtain ⟨tailRow, tailChecked, within⟩ := (disposal_subtree_path tailPath).checked rowChecked
        simp only [spendAll, List.nil_append] at tailChecked within tailPath
        let nextRoot := Requirements.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) tailAnnotated
        have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) tailRow := by
          change Checked entries receiving before (.sequence (.request (OwnerPhases.ofStack tables tail) []) (annotateDisposals tailAnnotated)) ([] ++ tailRow)
          exact .sequence (.request (by simp [OwnerSource.exportAt, residual_empty])) tailChecked
        let nextAnnotation := Requirements.choice nextRoot annotated (List.Perm.refl _)
        have raw : RawStep ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩ ⟨value, caller, tail⟩ [] [.resource identity] :=
          .leaveCell identity payload answer caller runtimeScope value closed tail
        have event : LexicalUnwind.UseTransition (.eval ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩)
            (.eval ⟨value, caller, tail⟩) [] [.resource identity] := .evaluate raw (LexicalUnwind.value_computation_head closed.1)
        refine ⟨_, _, _, nextAnnotation, tailRow ++ row, rfl, rfl, callerKnown,
          SourcePlannedSources.Values.change_context (SourcePlannedSources.Values.summary current closed.1) closed.1 allowed caller,
          Certified.pure (evidence := declarationPolicy), rest, .alternatives (.sequence .original tailAnnotation) (.refl _), .no .here, .no .here,
          .choice nextCheck rowChecked, List.append_subset.mpr ⟨within, List.Subset.refl _⟩,
          .pure, restCheck, restMatch, restBound, ?_, ?_, raw, event, rfl, ?_, ?_, ?_⟩
        · intro key body record
          cases record with | resume located contractKnown recorded source returns =>
            cases located with | push located => exact .resume located contractKnown recorded source returns
        · intro key body record
          cases record with | dispose located held recorded source =>
            cases located with | push located => exact .dispose located held recorded source
        · simpa only [LexicalUnwind.advanceUseTickets, ScopedExecution.advanceUsageTickets] using
            event.preserves (by intro owner member; cases member) unique usage
        · simpa only [LexicalUnwind.advanceUseTickets, ScopedExecution.advanceUsageTickets] using
            event.ticket_access (by intro owner member; cases member) unique usage ticketAccess
        · have access : LexicalUnwind.AccessConditions
              ⟨value, runtimeScope, .push (.cell identity payload caller answer) tail⟩ ambient := by
            constructor
            · intro other payload' answer' savedScope scope returned rest same returnedClosed
              cases same
              exact ScopedPorts.Support.result_excludes_resource valueSupport excluded
            · intro requested operation operand scope whole cap rest handler same cut operandClosed
              cases same
              cases closed.1
          exact LexicalUnwind.transition_access event.erases resourceAccess access
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
