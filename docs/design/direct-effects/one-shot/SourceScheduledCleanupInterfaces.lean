namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Value)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (Signature signature)
open SourcePlannedChecks (Certified)
open SourceDependencyAnnotations (Dependencies RowAnnotation RequirementPath)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveExpressions (Ready ready_not_focus ready_not_value)

private theorem computation_source_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      code input currentDemand currentRequirements (signature plan))
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints)
    (ready : Ready code)
    (step : RawStep ⟨code, runtimeScope, stack⟩ after created completed) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand, ∃ nextDependencies,
    ∃ nextPlan : Plan nextDependencies, ∃ nextTicket,
      SourcePlannedSources.Expression operations policy contracts world allowed after.scope (fun _ => none)
        after.expression input nextDemand nextRequirements (signature nextPlan) ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      Local outward actions phases world nextDependencies hints ∧
      ScopedPorts.EffectScope contracts.erase.erase.ports after.scope nextTicket ∧
      currentDemand.Perm nextDemand ∧ after.stack = stack ∧ created = [] ∧ completed = [] ∧
      (∀ entries receiving before row, Checked entries receiving before (annotateDisposals currentRequirements) row →
        ∃ nextRow, Checked entries receiving before (annotateDisposals nextRequirements) nextRow ∧ nextRow ⊆ row) := by
  cases step with
  | focus plain focus tail => exact False.elim (ready_not_focus ready focus)
  | plug plain value closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveHandler handler value closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveCell identity payload answer savedScope scope value closed tail => exact False.elim (ready_not_value ready closed.1)
  | startCleanup action saved closed scope tail => exact False.elim (ready_not_value ready closed.1)
  | leaveClause owner answer value closed scope caller tail => exact False.elim (ready_not_value ready closed.1)
  | bind parameter value body scope tail closed environmentReady =>
      cases plan with
      | sequence initialPlan bodyPlan => cases current with
        | bind initializer bodySource =>
          have empty := SourceTemplates.expression_value_demand
            (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
              (SourcePlannedSources.expression_erase initializer))) closed.1
          subst_vars
          cases certified with | sequence initialCertified bodyCertified =>
            cases checked with | sequence initialChecked bodyChecked =>
              refine ⟨_, _, _, bodyPlan, _,
                SourcePlannedSources.substitution bodySource (SourcePlannedSources.Values.summary initializer closed.1) closed,
                bodyCertified, bodyChecked, scopeTyped, .refl _, rfl, rfl, rfl, ?_⟩
              intro entries receiving before row rowChecked
              obtain ⟨firstRow, secondRow, firstCheck, secondCheck, rfl⟩ :=
                RecursiveRequirements.checked_sequence_parts rowChecked
              exact ⟨secondRow, secondCheck, List.subset_append_right _ _⟩
      | pure | request | invoke | choice | handler | cleanup | resource => cases current
  | beta parameter body value scope tail closed closureReady =>
      cases plan with
      | sequence functionPlan remaining => cases remaining with
        | sequence argumentPlan bodyPlan =>
          obtain ⟨reduced, nextSource, nextCertified, nextLocal, evaluation⟩ :=
            beta_preserves current certified checked closed
          refine ⟨_, reduced, _, bodyPlan, _, nextSource, nextCertified, nextLocal, .none,
            .refl _, rfl, rfl, rfl, ?_⟩
          intro entries receiving before row rowChecked
          obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation _).checked rowChecked
          obtain ⟨outwardRow, derived⟩ := RecursiveOutward.expression_outward
            (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
              (SourcePlannedSources.expression_erase nextSource))) rfl
          refine ⟨normalRow, ?_, normalBound⟩
          rw [outward_disposals derived]
          exact RecursiveRequirements.evaluate_sound
            ((evaluation entries receiving before).trans (RecursiveRequirements.checked_complete normalCheck))
        | pure | request | invoke | choice | handler | cleanup | resource => cases current
      | pure | request | invoke | choice | handler | cleanup | resource => cases current
  | ifTrue yes no scope tail =>
      cases plan with
      | sequence conditionPlan remaining => cases remaining with
        | choice yesPlan noPlan => cases current with
          | branch condition yesSource noSource same =>
            have empty := SourceTemplates.expression_value_demand
              (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
                (SourcePlannedSources.expression_erase condition))) trivial
            subst_vars
            cases certified with | sequence conditionCertified branchesCertified =>
              cases branchesCertified with | choice yesCertified noCertified =>
                cases checked with | sequence conditionChecked branchesChecked =>
                  cases branchesChecked with | choice yesChecked noChecked =>
                    refine ⟨_, _, _, yesPlan, _, yesSource, yesCertified, yesChecked, scopeTyped,
                      .refl _, rfl, rfl, rfl, ?_⟩
                    intro entries receiving before row rowChecked
                    obtain ⟨conditionRow, branchesRow, conditionCheck, branchesCheck, rfl⟩ :=
                      RecursiveRequirements.checked_sequence_parts rowChecked
                    cases branchesCheck with | choice yesCheck noCheck =>
                      exact ⟨_, yesCheck, (List.subset_append_left _ _).trans (List.subset_append_right _ _)⟩
        | pure | request | invoke | sequence | handler | cleanup | resource => cases current
      | pure | request | invoke | choice | handler | cleanup | resource => cases current
  | ifFalse yes no scope tail =>
      cases plan with
      | sequence conditionPlan remaining => cases remaining with
        | choice yesPlan noPlan => cases current with
          | branch condition yesSource noSource same =>
            have empty := SourceTemplates.expression_value_demand
              (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
                (SourcePlannedSources.expression_erase condition))) trivial
            subst_vars
            cases certified with | sequence conditionCertified branchesCertified =>
              cases branchesCertified with | choice yesCertified noCertified =>
                cases checked with | sequence conditionChecked branchesChecked =>
                  cases branchesChecked with | choice yesChecked noChecked =>
                    refine ⟨_, _, _, noPlan, _, noSource, noCertified, noChecked, scopeTyped,
                      same, rfl, rfl, rfl, ?_⟩
                    intro entries receiving before row rowChecked
                    obtain ⟨conditionRow, branchesRow, conditionCheck, branchesCheck, rfl⟩ :=
                      RecursiveRequirements.checked_sequence_parts rowChecked
                    cases branchesCheck with | choice yesCheck noCheck =>
                      exact ⟨_, noCheck, (List.subset_append_right _ _).trans (List.subset_append_right _ _)⟩
        | pure | request | invoke | sequence | handler | cleanup | resource => cases current
      | pure | request | invoke | choice | handler | cleanup | resource => cases current
  | enterHandler | enterCell | enterCleanup | finishCleanup | capture | resume | discard | finishClose | retire | readCell | writeCell => cases ready
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

