/-- Resumption retains the captured source's actual intermediate return mode,
including protected captures. Only the fresh consumed owner's marker is added
to its lexical receiver; no successor source premise is needed. -/
theorem Code.own_resume_at_cut
    {resumeDemand : List Nat}
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (retained : Pending outward actions budget phases world installations whole .nil .ordinary finalMode)
    (cut : Cut effect operation whole captured tail contract modes)
    (fresh : actions owner = none) (consumed : phases owner = .consumed)
    (permission : rights.resume = true) :
    Code outward (actions.insert owner rights) budget (introduce phases owner) world installations
      (Rows.invoke (key := ⟨owner, .resume⟩)) (.live (owner := owner) (resumeDemand := resumeDemand) captured tail) := by
  obtain ⟨middle, saved, waiting⟩ := retained.at_cut cut
  have extension := Syntax.fresh_usage_insert_extends (rights := rights) fresh
  have nextSaved := (saved.permissions extension).outside_history (.add (.same _)) consumed
  have nextWaiting : Pending outward (actions.insert owner rights) budget phases world installations
      (.spent (owner := owner) tail) .nil middle finalMode := .spent (waiting.permissions extension)
  have restored := (nextSaved.reindex_outside (Context.spent tail).append_nil_pack.symm).append nextWaiting
  have mode : (ReturnHints.live (owner := owner) captureHints tailHints).returnMode .ordinary = finalMode := by
    simp only [ReturnHints.returnMode, saved.return_mode]
    exact waiting.return_mode
  have phaseSame := OwnerCaptureContracts.spend_introduced (owner := owner) consumed
  apply Code.resume (front := .nil) .hit
    (by simp [Syntax.UsageTickets.insert]) permission (by simp [introduce]) ResumeShape.empty_front
  simpa only [phaseSame, Context.append, ReturnHints.append, SourceDependencyCapture.Scope.append, mode] using restored

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission.Code.own_resume_at_cut


