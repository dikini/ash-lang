            RowAnnotation
              (.sequence (clauseReq.prepend (OwnerPhases.ofStack tables nextStack)) (.sequence (.spent owner) tailReq))
              (.sequence (clauseAnnotated.prepend (OwnerPhases.ofStack tables nextStack)) (.sequence (.spent owner) tailAnnotated)) ∧
            RecursiveRequirements.Checked nextStore [] (available (ownedTickets nextStack))
              (.sequence (clauseAnnotated.prepend (OwnerPhases.ofStack tables nextStack)) (.sequence (.spent owner) tailAnnotated))
              (clauseRow ++ tailRow) ∧
            clauseRow ++ tailRow ⊆ requestRow ++ certificateRow ∧
            (clauseDemand ++ tailDemand).Perm (ownedTickets nextStack) := by
  obtain ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    plans, resumeEffects, closeEffects, family, offered, advertised, bodies, chosen, certified,
    wholeSame, demandSame, saved, returns, declaration, offeredKnown, rowAvailable, familyKnown, residualized,
    cutCertificate, cutRow, cutAnnotation, cutCheck, cutBound, rootPath, sourcePath, finish⟩ :=
    capture_planned_allocation_with_closing cut current source hinted pendingLocal usage ticketAccess resourceAccess
      operandSupport operandBoundary selected isValue fresh freshAction absent bound freshAnnotation recorded closing
      closingRecorded unique storeAnnotation annotation certificate currentCheck currentLocal finite
  refine ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    plans, resumeEffects, closeEffects, family, offered, advertised, bodies, chosen, certified,
    wholeSame, demandSame, returns, declaration, offeredKnown, rowAvailable, familyKnown, residualized,
    cutCertificate, cutRow, cutAnnotation, cutCheck, cutBound, rootPath, sourcePath, ?_⟩
  intro capAnnotated tailAnnotated capAnnotation tailAnnotation splitCovered cleanupCovered
  obtain ⟨suppliedDemand, suppliedRequirements, suppliedSource, suppliedPath⟩ :
      ∃ suppliedDemand, ∃ suppliedRequirements : Requirements suppliedDemand,
        (ProtectionContexts.protectedMode capture.erase = false →
          UnwindSource operations.erase policy contracts.erase tables families world capture suppliedDemand suppliedRequirements capScope) ∧
        (offered.dispose = true → RequirementPath suppliedRequirements capAnnotated []) := by
    cases disposes : offered.dispose with
    | true =>
      obtain ⟨closeDemand, closeRequirements, closeSource, closePath⟩ := cleanupCovered disposes
      exact ⟨closeDemand, closeRequirements, fun _ => closeSource, fun _ => closePath⟩
    | false =>
      cases held : ProtectionContexts.protectedMode capture.erase with
      | false =>
        obtain ⟨closeDemand, closeRequirements, closeSource⟩ :=
          saved.erase.unwind_source (LexicalUnwind.unprotected_unwind_prefix held)
        exact ⟨closeDemand, closeRequirements, fun _ => closeSource, by intro impossible; cases impossible⟩
      | true => exact ⟨[], .request [] [], (by intro impossible; cases impossible), (by intro impossible; cases impossible)⟩
  obtain ⟨capRow, tailRow, within, closingDemand, closingRow, balanced, noClosing,
    nextDisposals, nextStore, origin, result⟩ :=
    finish capAnnotated tailAnnotated capAnnotation tailAnnotation splitCovered
      suppliedDemand suppliedRequirements suppliedSource suppliedPath
  exact ⟨capRow, tailRow, within, closingDemand, closingRow, balanced, noClosing,
    nextDisposals, nextStore, result⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.capture_planned_allocation


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts Contract Value)
open SourcePlannedFrames (Families DependencyScope)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store evaluate)
open OwnerPhaseTransitions (spend spendAll)
theorem resume_planned_fragments {contract : SourcePlannedTyping.Contract}
    {recordedRequirements : Requirements contract.resumeDemand}
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value contract.answer) output pendingDemand pendingRequirements scope)
    (known : contracts owner = some contract)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recordedRequirements⟩)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (invocation : RecursiveRequirements.Checked annotatedStore
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))
      before (.invoke ⟨owner, .resume⟩ contract.resumeDemand []) resumeRow)
    (pending : RecursiveRequirements.Checked annotatedStore [] (spendAll before (owner :: contract.resumeDemand))
      pendingRequirements pendingRow) :
    ∃ (boundary : PlannedModeValue) (frontDemand tailDemand : List Nat),
    ∃ frontRequirements : Requirements frontDemand, ∃ tailRequirements : Requirements tailDemand,
    ∃ frontScope capturedScope tailScope frontRow tailRow savedRow,
    ∃ savedAnnotated : Requirements contract.resumeDemand,
      RowAnnotation recordedRequirements savedAnnotated ∧ savedRow ⊆ resumeRow ∧
      PlannedModeSource operations policy contracts tables families required outward actions world front
        (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured
        (.value contract.input) boundary contract.resumeDemand recordedRequirements capturedScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail
        boundary output tailDemand tailRequirements tailScope ∧
      (boundary = .value contract.answer ∨ boundary = .unwind) ∧
      contract.input.erase.erase.port = ScopedPorts.eraseType inputType ∧
      contract.answer.erase.erase.port = ScopedPorts.eraseType answerType ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      contract.held = ProtectionContexts.protectedMode captured.erase ∧
      scope = frontScope.append (.live owner capturedScope tailScope) ∧
      pendingDemand = frontDemand ++ tailDemand ∧ pendingRow = frontRow ++ tailRow ∧
      Bound annotations (capturedScope.append (frontScope.append (.spent owner tailScope))) ∧
      RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore)
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))
        (spend before owner) recordedRequirements savedRow ∧
      RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore)
        (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))
        (spend before owner) savedAnnotated resumeRow ∧
      RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore)
        (OwnerPhases.ofStack tables (.spent owner answerType caller tail))
        (spendAll (spend before owner) contract.resumeDemand) frontRequirements frontRow ∧
      RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
        (spendAll (spendAll (spend before owner) contract.resumeDemand) frontDemand)
        tailRequirements tailRow := by
  have invoked : RecursiveRequirements.Checked annotatedStore [] before
      (.invoke ⟨owner, .resume⟩ contract.resumeDemand
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) resumeRow := by
    change RecursiveRequirements.Checked annotatedStore [] before
      ((Requirements.invoke ⟨owner, .resume⟩ contract.resumeDemand []).prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) resumeRow
    apply RecursiveRequirements.checked_prepend_iff.mpr
    simpa only [List.append_nil] using invocation
  obtain ⟨boundary, frontDemand, tailDemand, frontRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontSource, savedSource, tailSource, returns,
    inputAnnotation, answerAnnotation, callerScope, held, scopeSame, demandSame, nextBound, evaluation⟩ :=
    extract_planned_recorded_resume source known (RecursiveRequirements.Checked.sequence invoked pending) records found bound unique
  obtain ⟨frontRow, tailRow, savedRow, savedAnnotated,
    savedAnnotation, savedBound, rowSame, savedChecked, savedAnnotatedCheck, frontChecked, tailChecked⟩ :=
    SourceDependencySchemes.Lexical.resume_fragment_rows (contract := contract.erase) storeAnnotation found invocation pending evaluation
  exact ⟨boundary, frontDemand, tailDemand, frontRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontRow, tailRow, savedRow, savedAnnotated,
    savedAnnotation, savedBound, frontSource, savedSource, tailSource,
    returns, inputAnnotation, answerAnnotation, callerScope, held, scopeSame, demandSame, rowSame,
    nextBound, savedChecked, savedAnnotatedCheck, frontChecked, tailChecked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.resume_planned_fragments


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts Contract Value)
open SourcePlannedFrames (Families DependencyScope)
open SourceDependencyFrames (UnwindSource UnwindRecords)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencySchemes.Lexical
open SourceDependencySchemes.Closing (Bound)
open RecursiveRequirements (Requirements Store Checked evaluate)
open OwnerPhaseTransitions (available spend spendAll Trace)
open RecursiveDisposalCapture SourceDependencyOwners.Lexical
variable {front captured tail : Stack}
theorem PlannedModeSource.append_checked
    (first : PlannedModeSource operations policy contracts tables families required outward actions world
      front input middle firstDemand firstRequirements firstScope)
    (second : PlannedModeSource operations policy contracts tables families required outward actions world
      tail middle output secondDemand secondRequirements secondScope)
    (firstChecked : Checked entries (OwnerPhases.ofStack tables tail ++ receiving) before firstRequirements firstRow)
    (secondChecked : Checked entries receiving (spendAll before firstDemand) secondRequirements secondRow) :
    ∃ combined : Requirements (firstDemand ++ secondDemand),
      PlannedModeSource operations policy contracts tables families required outward actions world (front.append tail)
        input output (firstDemand ++ secondDemand) combined (firstScope.append secondScope) ∧
      Checked entries receiving before combined (firstRow ++ secondRow) := by
  obtain ⟨combined, source, evaluation⟩ := first.append second
  refine ⟨combined, source, RecursiveRequirements.evaluate_sound ?_⟩
  rw [evaluation, RecursiveRequirements.checked_complete firstChecked,
    RecursiveRequirements.checked_complete secondChecked]
  rfl

private theorem resume_planned_expression_check
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.resume binder value) result currentDemand currentRequirements dependencies)
    (known : contracts owner = some contract)
    (resolved : runtimeScope.resolve binder = some owner)
    (isValue : value.IsValue)
    (checked : RecursiveRequirements.Checked entries receiving before currentRequirements row) :
    currentDemand = owner :: contract.resumeDemand ∧
    RecursiveRequirements.Checked entries receiving before (.invoke ⟨owner, .resume⟩ contract.resumeDemand []) row ∧
    SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) [] value contract.input := by
  cases current with
  | resume actualKnown actualResolved permission operand admitted formed =>
      cases Option.some.inj (actualResolved.symm.trans resolved)
      cases Option.some.inj (actualKnown.symm.trans known)
      have empty := SourceTemplates.expression_value_demand
        (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase operand))) isValue
      have evaluated := RecursiveRequirements.checked_complete checked
      rw [RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.value_evaluation (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase operand))) isValue] at evaluated
      simp only [empty, spendAll, RecursiveRecomposition.merge_empty_left] at evaluated
      exact ⟨by simp only [empty, List.nil_append], RecursiveRequirements.evaluate_sound evaluated,
        SourcePlannedSources.Values.change_allowed (SourcePlannedSources.Values.summary operand isValue) isValue []⟩

/-- Resume the exact planned record and recompose its saved, caller and tail
source with authenticated rows, retained certificates and physical ownership.
Unwind return consumes the predecessor's exact caller-cleanup branch. -/
theorem resume_planned_segments {contract : SourcePlannedTyping.Contract}
    {checking : SourcePlanSignatures.Signature dependencies}
    {recordedRequirements : Requirements contract.resumeDemand}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.resume binder value) contract.answer currentDemand currentRequirements checking)
    (resolved : runtimeScope.resolve binder = some owner)
    (isValue : value.IsValue)
    (usage : LexicalUnwind.MachineUse policy actions (.eval
      ⟨.resume binder value, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval
      ⟨.resume binder value, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval
      ⟨.resume binder value, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩))
    (reentry : SourceDependencyOwners.ReentrySource operations.erase policy contracts.erase world front captured tail
      (LexicalUnwind.returnMode captured .ordinary))
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append (.live owner inputType answerType captured caller tail))
      (.value contract.answer) output pendingDemand pendingRequirements scope)
    {returnHints : SourceDependencyChecks.Lexical.ReturnHints scope}
    (currentLocal : SourceDependencyChecks.Lexical.ReturnHints.Recursive.Local outward actions
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      world dependencies returnHints)
    (hinted : SourceDependencyChecks.Lexical.ReturnHints.Matches tables families returnHints
      (front.append (.live owner inputType answerType captured caller tail)))
    (known : contracts owner = some contract)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      UnwindAnnotated operations.erase policy contracts.erase tables families annotations world
        (front.append (.live owner inputType answerType captured caller tail)) key body)
    (found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recordedRequirements⟩)
    (bound : Bound annotations scope)
    (unique : (ownedTickets (front.append (.live owner inputType answerType captured caller tail))).Nodup)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) pendingRequirements)
      annotatedRoot)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (certificate : RecursiveRequirements.Checked annotatedStore []
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      annotatedRoot certificateRow) :
    let nextStack := captured.append (front.append (.spent owner answerType caller tail))
    let after := available (ownedTickets nextStack)
    LexicalUnwind.UseTransition (.eval
      ⟨.resume binder value, runtimeScope, front.append (.live owner inputType answerType captured caller tail)⟩)
      (.eval ⟨value, runtimeScope, nextStack⟩) [] [.ticket owner] ∧
    LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, nextStack⟩) ∧
    LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, nextStack⟩) ∧
    LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, nextStack⟩) ∧
    StoreAnnotation (RecursiveTransport.removeOwner owner (resumes ++ disposals))
      (RecursiveTransport.removeOwner owner annotatedStore) ∧
    ∃ (boundary : PlannedModeValue) (frontDemand : List Nat), ∃ frontRequirements : Requirements frontDemand,
    ∃ (frontScope nextScope : DependencyScope) (frontRow tailRow : Footprint),
    ∃ closeDemand, ∃ closeRequirements : Requirements closeDemand, ∃ aligned : frontDemand.Perm closeDemand,
      SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) [] value contract.input ∧
      PlannedModeSource operations policy contracts tables families required outward actions world front
        (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope ∧
      (boundary = .value contract.answer ∨ boundary = .unwind) ∧
      (boundary.mode = .unwind →
        UnwindSource operations.erase policy contracts.erase tables families world front closeDemand closeRequirements frontScope) ∧
      frontRow ++ tailRow ⊆ certificateRow ∧ Bound annotations nextScope ∧
      (∃ nextHints : SourceDependencyChecks.Lexical.ReturnHints nextScope,
        SourceDependencyChecks.Lexical.ReturnHints.Matches tables families nextHints nextStack ∧
        SourceDependencyChecks.Lexical.ReturnHints.Recursive.Pending outward actions after world
          nextHints .nil .ordinary output.mode) ∧
      ((boundary.mode = .unwind →
          RequirementPath
              (.choice
                (frontRequirements.prepend (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail)))
                (closeRequirements.prepend (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail))) aligned)
              annotatedRoot (owner :: contract.resumeDemand)) →
        ∃ demand, ∃ requirements annotatedNext : Requirements demand, ∃ row annotatedRow,
          PlannedModeSource operations policy contracts tables families required outward actions world nextStack
            (.value contract.input) output demand requirements nextScope ∧
          RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
            after requirements row ∧ row ⊆ certificateRow ∧
          RowAnnotation requirements annotatedNext ∧
          RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
            after annotatedNext annotatedRow ∧ annotatedRow ⊆ certificateRow ∧
          (∃ retained : Requirements pendingDemand,
            RowAnnotation pendingRequirements retained ∧
            RequirementPath retained annotatedRoot currentDemand ∧
            RequirementPath retained annotatedNext contract.resumeDemand) ∧
          (boundary.mode = .unwind →
            RequirementPath
              (.choice
                (frontRequirements.prepend (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail)))
                (closeRequirements.prepend (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail))) aligned)
              annotatedNext contract.resumeDemand) ∧
          (∃ savedAnnotated : Requirements contract.resumeDemand,
            RowAnnotation recordedRequirements savedAnnotated ∧
            RequirementPath
              (savedAnnotated.prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail))))
              annotatedNext []) ∧
          demand.Perm (ownedTickets nextStack)) ∧
      Trace (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) [owner] after ∧
      (ownedTickets nextStack).Nodup ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      (∀ key body, (key, body) ∈ RecursiveTransport.removeOwner owner disposals →
        UnwindAnnotated operations.erase policy contracts.erase tables families annotations world nextStack key body) := by
  dsimp only
  have oldCurrent := SourcePlannedSources.expression_erase current
  have oldRecords := fun key body member => (records key body member).erase
  obtain ⟨rootRow, rootCheck, rootBound⟩ := annotation.checked certificate
  obtain ⟨_, normalStoreCheck, _⟩ := storeAnnotation.checked rootCheck
  have ownerBalance := mode_source_ownership_balance oldCurrent source.erase oldRecords closing unique normalStoreCheck
  obtain ⟨resumeRow, normalPendingRow, currentCheck, normalPending, rootSame⟩ :=
    RecursiveRequirements.checked_sequence_parts rootCheck
  obtain ⟨currentDemandSame, invocation, payload⟩ := resume_planned_expression_check current known resolved isValue
    (RecursiveRequirements.checked_prepend_iff.mp currentCheck)
  have balanced : (owner :: (contract.resumeDemand ++ pendingDemand)).Perm
      (ownedTickets (front.append (.live owner inputType answerType captured caller tail))) := by
    simpa only [currentDemandSame, List.cons_append] using ownerBalance
  have closed := ScopedPorts.typed_value_closed
    ((DeclaredSourceValues.erase (SourceDependencyFrames.value_erase (SourcePlannedSources.expression_erase payload))).ports .none) isValue
  have step := LexicalUnwind.UseTransition.resume binder owner runtimeScope caller inputType answerType
    front captured tail value closed resolved reentry.bounds
  have nextUsage := SourceDependencyOwners.source_resume_use usage resolved isValue unique reentry
  have nextTickets := step.ticket_access (policy := policy) (tickets := actions)
    (by intro other impossible; cases impossible) unique usage ticketAccess
  have nextResources : LexicalUnwind.MachineAccess ambient (.eval
      ⟨value, runtimeScope, captured.append (front.append (.spent owner answerType caller tail))⟩) := by
    cases resourceAccess with
    | eval supported =>
        exact .eval (raw_step_preserves_access
          (.resume binder owner runtimeScope caller inputType answerType front captured tail value closed resolved)
          supported ScopedPorts.resume_access_checks)
  refine ⟨step, nextUsage, nextTickets, nextResources, storeAnnotation.remove_owner owner, ?_⟩
  have invocationActual : RecursiveRequirements.Checked annotatedStore
      (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))
      (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail))))
      (.invoke ⟨owner, .resume⟩ contract.resumeDemand []) resumeRow := by
    simpa only [List.append_nil] using invocation
  rw [currentDemandSame] at normalPending
  have resumeBound : resumeRow ⊆ certificateRow :=
    (List.subset_append_left _ _).trans (rootSame ▸ rootBound)
  have normalBound : normalPendingRow ⊆ certificateRow :=
    (List.subset_append_right _ _).trans (rootSame ▸ rootBound)
  obtain ⟨boundary, frontDemand, tailDemand, frontRequirements, tailRequirements,
    frontScope, capturedScope, tailScope, frontRow, tailRow, savedRow, savedAnnotated,
    savedAnnotation, savedRowBound, frontSource, savedSource, tailSource,
    returns, inputAnnotation, answerAnnotation, callerScope, held, scopeSame, demandSame, rowSame,
    nextBound, savedChecked, savedAnnotatedCheck, frontChecked, tailChecked⟩ :=
    resume_planned_fragments source known storeAnnotation records found bound unique invocationActual normalPending
  have trace := OwnerPhaseTransitions.resume_phase_trace unique
  have phaseSame := OwnerPhaseTransitions.trace_result trace
  change available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) =
    spend (available (ownedTickets (front.append (.live owner inputType answerType captured caller tail)))) owner at phaseSame
  rw [← phaseSame] at savedChecked savedAnnotatedCheck frontChecked tailChecked
  have prefixUnique : (ownedTickets front ++ owner :: (ownedTickets captured ++ ownedTickets tail)).Nodup := by
    simpa only [owned_tickets_append, ownedTickets] using unique
  have absent : owner ∉ ownedTickets front := fun member =>
    (List.nodup_append.mp prefixUnique).2.2 owner member owner List.mem_cons_self rfl
  have localCut : SourceDependencyCapture.OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩ := by
    rw [scopeSame]
    exact SourceDependencySchemes.Closing.prefix_owner_cut frontSource.realizes absent
  have invocationLocal := SourceDependencyChecks.Lexical.ReturnHints.Recursive.Local.ready_resume oldCurrent resolved currentLocal
  have localRetained := invocationLocal.resume_at_cut hinted localCut frontSource.realizes
  have returnModeSame : returnHints.returnMode .ordinary = output.mode :=
    (SourceDependencyChecks.Lexical.ReturnHints.Matches.return_mode hinted).trans source.return_mode
  rw [← phaseSame, returnModeSame] at localRetained
  have consumed : available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) owner = .consumed := by
    rw [phaseSame]
    exact OwnerPhaseTransitions.spend_self _ _
  have nextBalance : (contract.resumeDemand ++ pendingDemand).Perm
      (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) :=
    (balanced.trans OwnerPhaseTransitions.resume_owned_permutation).cons_inv
  have nextUnique := (List.nodup_cons.mp (OwnerPhaseTransitions.resume_owned_permutation.nodup unique)).2
  have combinedBound : frontRow ++ tailRow ⊆ certificateRow := rowSame ▸ normalBound
  have frontBound : frontRow ⊆ certificateRow := (List.subset_append_left _ _).trans combinedBound
  have tailBound : tailRow ⊆ certificateRow := (List.subset_append_right _ _).trans combinedBound
  have returnMode := savedSource.return_mode
  have reentryBounds : LexicalUnwind.ReentryBounds front captured tail boundary.mode := by
    rw [← returnMode]
    exact reentry.bounds
  have survivingResumes := planned_resume_records_resume records
  have survivingDisposals := annotated_records_resume closing (.refl _)
  have nextStoreAnnotation := storeAnnotation.remove_owner owner
  obtain ⟨_, normalSavedCheck, _⟩ := nextStoreAnnotation.checked savedChecked
  obtain ⟨_, normalFrontCheck, _⟩ := nextStoreAnnotation.checked frontChecked
  obtain ⟨_, normalTailCheck, _⟩ := nextStoreAnnotation.checked tailChecked
  obtain ⟨closeDemand, closeRequirements, aligned, cleanup, plannedCleanup⟩ :
      ∃ closeDemand, ∃ closeRequirements : Requirements closeDemand, ∃ aligned : frontDemand.Perm closeDemand,
        (boundary.mode = .unwind →
          UnwindSource operations.erase policy contracts.erase tables families world front closeDemand closeRequirements frontScope) ∧
        (boundary.mode = .unwind → ∃ plannedRequirements : Requirements closeDemand,
          PlannedModeSource operations policy contracts tables families required outward actions world front .unwind .unwind
            closeDemand plannedRequirements frontScope ∧
          ∀ store receiving phases, evaluate store receiving phases plannedRequirements = evaluate store receiving phases closeRequirements) := by
    cases boundary with
    | value answer => exact ⟨frontDemand, frontRequirements, .refl _, (by intro impossible; cases impossible),
        (by intro impossible; cases impossible)⟩
    | unwind =>
        have frontBalance := mode_reentry_unwind_balance frontSource.erase savedSource.erase tailSource.erase
          (fun key body member => (survivingResumes key body member).erase) survivingDisposals nextUnique
          (by simpa only [RecursiveConsumption.remove_owner_append] using normalSavedCheck)
          (by simpa only [RecursiveConsumption.remove_owner_append] using normalFrontCheck)
          (by simpa only [RecursiveConsumption.remove_owner_append] using normalTailCheck)
          reentryBounds (by simpa only [demandSame, List.append_assoc] using nextBalance)
        have scopes : LexicalUnwind.UnwindPrefix front := by cases reentryBounds with | unwind scopes _ _ _ => exact scopes
        obtain ⟨closeDemand, plannedRequirements, planned, closeRequirements, cleanup, evaluation⟩ :=
          frontSource.unwind_source_evaluation scopes
        have aligned := cleanup.template.ownership.trans frontBalance.symm
        exact ⟨closeDemand, closeRequirements, aligned.symm, fun _ => cleanup,
          fun _ => ⟨plannedRequirements, planned, evaluation⟩⟩
  refine ⟨boundary, frontDemand, frontRequirements, frontScope, _, frontRow, tailRow,
    closeDemand, closeRequirements, aligned, payload, frontSource, returns, cleanup, combinedBound, nextBound, localRetained,
    ?_, trace, nextUnique, survivingResumes, survivingDisposals⟩
  intro coveredCaller
  obtain ⟨restoredDemand, restoredRequirements, restoredRow, restored, same, restoredChecked, covered⟩ :
      ∃ restoredDemand, ∃ restoredRequirements : Requirements restoredDemand, ∃ restoredRow,
        PlannedModeSource operations policy contracts tables families required outward actions world front boundary boundary
          restoredDemand restoredRequirements frontScope ∧
        restoredDemand.Perm frontDemand ∧
        RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore)
          (OwnerPhases.ofStack tables (.spent owner answerType caller tail) ++ [])
          (spendAll (available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail))))) contract.resumeDemand)
          restoredRequirements restoredRow ∧ restoredRow ⊆ certificateRow := by
    cases boundary with
    | value answer =>
        have answerSame : answer = contract.answer := by
          rcases returns with sameAnswer | impossible
          · exact PlannedModeValue.value.inj sameAnswer
          · cases impossible
        subst answer
        exact ⟨frontDemand, frontRequirements, frontRow, frontSource, .refl _,
          by simpa only [List.append_nil] using frontChecked, frontBound⟩
    | unwind =>
        have path := coveredCaller rfl
        have closingSource := cleanup rfl
        obtain ⟨choiceRow, choiceCheck, choiceBound⟩ := path.checked certificate
        obtain ⟨normalRow, closeRow, normalCheck, closeCheck, choiceSame⟩ :=
          RecursiveExpressions.choice_parts choiceCheck
        have closingBound : closeRow ⊆ certificateRow :=
          (List.subset_append_right _ _).trans (choiceSame ▸ choiceBound)
        have closingAtCaller := RecursiveRequirements.checked_prepend_iff.mp closeCheck
        simp only [spendAll] at closingAtCaller
        rw [← phaseSame] at closingAtCaller
        have consumedAfter := RecursiveTransport.phases_spendAll_later (owners := contract.resumeDemand) owner consumed
        have contexts := RecursiveRecomposition.normalize_replaced
          (front := .nil) (capture := captured) (tail := tail) (input := inputType) (answer := answerType)
          (caller := caller) (tables := tables) (receiving := []) consumedAfter
        have closingChecked := RecursiveTransport.checked_transport closingAtCaller
          (RecursiveTransport.remove_consumed_agrees consumedAfter)
          (by simpa only [Stack.append] using contexts)
        obtain ⟨plannedRequirements, planned, evaluation⟩ := plannedCleanup rfl
        refine ⟨closeDemand, plannedRequirements, closeRow, planned, aligned.symm,
          RecursiveRequirements.evaluate_sound ?_, closingBound⟩
        rw [evaluation]
        exact RecursiveRequirements.checked_complete closingChecked
  let before := available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail))))
  have spentSource : ∃ waiting : Requirements tailDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world
        (.spent owner answerType caller tail) boundary output tailDemand waiting (.spent owner tailScope) ∧
      RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
        (spendAll (spendAll before contract.resumeDemand) restoredDemand) waiting tailRow := by
    have phased : spendAll (spendAll before contract.resumeDemand) restoredDemand =
        spendAll (spendAll before contract.resumeDemand) frontDemand :=
      PhaseRechecking.spendAll_permutation same
    have stillConsumed : spendAll (spendAll before contract.resumeDemand) restoredDemand owner = .consumed :=
      RecursiveTransport.phases_spendAll_later owner (RecursiveTransport.phases_spendAll_later owner consumed)
    have waitingChecked : RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
        (spendAll (spendAll before contract.resumeDemand) restoredDemand)
        (.sequence (.spent owner) tailRequirements) tailRow := by
      simpa only [spendAll, List.nil_append] using
        (RecursiveRequirements.Checked.sequence (RecursiveRequirements.Checked.spent stillConsumed) (phased ▸ tailChecked))
    rcases returns with rfl | rfl
    · exact ⟨_, .spent known answerAnnotation callerScope tailSource, waitingChecked⟩
    · exact ⟨_, .skippedSpent tailSource, waitingChecked⟩
  obtain ⟨waitingRequirements, waitingSource, waitingChecked⟩ := spentSource
  obtain ⟨callerRequirements, callerSource, callerChecked⟩ :=
    restored.append_checked waitingSource restoredChecked waitingChecked
  obtain ⟨requirements, rebuilt, checked⟩ :=
    savedSource.append_checked callerSource (by simpa only [List.append_nil] using savedChecked) callerChecked
  let demand := contract.resumeDemand ++ (restoredDemand ++ tailDemand)
  let row := savedRow ++ (restoredRow ++ tailRow)
  have sameDemand : demand.Perm (contract.resumeDemand ++ frontDemand ++ tailDemand) := by
    simpa only [demand, List.append_assoc] using (same.append_right tailDemand).append_left contract.resumeDemand
  have normalCovered : row ⊆ certificateRow :=
    List.append_subset.mpr ⟨savedRowBound.trans resumeBound, List.append_subset.mpr ⟨covered, tailBound⟩⟩
  obtain ⟨retained, retainedAnnotation, retainedPath⟩ := annotation.focus
    (show RequirementPath pendingRequirements
      (.sequence (currentRequirements.prepend
        (OwnerPhases.ofStack tables (front.append (.live owner inputType answerType captured caller tail)))) pendingRequirements)
      currentDemand from by simpa only [List.append_nil] using
        (RequirementPath.second (.here : RequirementPath pendingRequirements pendingRequirements [])))
  obtain ⟨retainedRow, retainedCheck, retainedBound⟩ := retainedPath.checked certificate
  rw [currentDemandSame] at retainedCheck
  simp only [spendAll] at retainedCheck
  rw [← phaseSame] at retainedCheck
  have retainedAfter := RecursiveTransport.checked_remove_consumed retainedCheck
    (RecursiveTransport.phases_spendAll_later (owners := contract.resumeDemand) owner consumed)
  obtain ⟨continuing, continuingRow, continuingCheck, continuingBound, retainedInContinuing, cleanupInContinuing⟩ :
      ∃ continuing : Requirements pendingDemand, ∃ continuingRow,
        RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
          (spendAll (available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail))))) contract.resumeDemand)
          continuing continuingRow ∧ continuingRow ⊆ certificateRow ∧
        RequirementPath retained continuing [] ∧
        (boundary.mode = .unwind →
          RequirementPath
            (.choice
              (frontRequirements.prepend (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail)))
              (closeRequirements.prepend (OwnerPhases.ofStack tables (.live owner inputType answerType captured caller tail))) aligned)
            continuing []) := by
    cases boundary with
    | value answer => exact ⟨retained, retainedRow, retainedAfter, retainedBound, .here,
        by intro impossible; cases impossible⟩
    | unwind =>
        obtain ⟨remainingDemand, remaining, sameRemaining, selected, checkedRemaining⟩ := (coveredCaller rfl).remainder
        have alignedRemaining : pendingDemand.Perm remainingDemand := by
          rw [← currentDemandSame] at sameRemaining
          exact (List.perm_append_left_iff _).mp sameRemaining
        obtain ⟨remainingRow, remainingCheck, remainingBound⟩ := checkedRemaining _ _ _ _ certificate
        simp only [spendAll] at remainingCheck
        rw [← phaseSame] at remainingCheck
        have remainingAfter := RecursiveTransport.checked_remove_consumed remainingCheck
          (RecursiveTransport.phases_spendAll_later (owners := contract.resumeDemand) owner consumed)
        exact ⟨.choice retained remaining alignedRemaining, retainedRow ++ remainingRow,
          .choice retainedAfter remainingAfter, List.append_subset.mpr ⟨retainedBound, remainingBound⟩,
          .yes .here, fun _ => .no selected⟩
  have savedAtRoot : RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
      (available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))))
      (savedAnnotated.prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))) resumeRow :=
    RecursiveRequirements.checked_prepend_iff.mpr (by simpa only [List.append_nil] using savedAnnotatedCheck)
  have retainedSequence := RecursiveRequirements.Checked.sequence savedAtRoot continuingCheck
  have sameRetained : demand.Perm (contract.resumeDemand ++ pendingDemand) := by
    simpa only [demandSame, List.append_assoc] using sameDemand
  let annotatedNext := Requirements.choice requirements
    (.sequence (savedAnnotated.prepend (OwnerPhases.ofStack tables (front.append (.spent owner answerType caller tail)))) continuing)
    sameRetained
  have annotatedCheck : RecursiveRequirements.Checked (RecursiveTransport.removeOwner owner annotatedStore) []
      (available (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))))
      annotatedNext (row ++ (resumeRow ++ continuingRow)) := .choice checked retainedSequence
  refine ⟨demand, requirements, annotatedNext, row, _, rebuilt, checked, normalCovered,
    .alternatives .original sameRetained, annotatedCheck, ?_,
    ⟨retained, retainedAnnotation, retainedPath, ?_⟩, ?_,
    ⟨savedAnnotated, savedAnnotation, .no (.first .here)⟩, sameDemand.trans ?_⟩
  · exact List.append_subset.mpr ⟨normalCovered, List.append_subset.mpr ⟨resumeBound, continuingBound⟩⟩
  · exact .no (by simpa only [List.append_nil] using
      (RequirementPath.second retainedInContinuing))
  · intro unwinding
    exact .no (by simpa only [List.append_nil] using
      (RequirementPath.second (cleanupInContinuing unwinding)))
  · simpa only [demandSame, List.append_assoc] using nextBalance

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.append_checked
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.resume_planned_segments

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.unwind_source_evaluation

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts Value)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open SourcePlannedChecks (Certified)
open RecursiveRequirements (Requirements Store Checked evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveRecomposition (evaluate_empty merge_empty_left)
theorem PlannedModeSource.start_cleanup
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.armed action) rest) .unwind output demand requirements scope)
    (checked : RecursiveRequirements.Checked entries receiving before requirements row) :
    ∃ latent dependencies, ∃ callbackPlan : Plan dependencies,
    ∃ callbackRow tailRow nextScope,
    ∃ tailRequirements nextRequirements : Requirements demand,
      scope = .cleanup action.requests dependencies nextScope ∧
      Certified (evidence := declarationPolicy) outward world callbackPlan ∧
      SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
        (.app action.action .unit) .unit []
        (.emitAfter (.sequence (.request [] []) (.request [] [])) [] latent)
        (signature (.sequence .pure (.sequence .pure callbackPlan))) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest .unwind output demand tailRequirements nextScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world (.push (.unwinding action) rest)
        (.value .unit) output demand nextRequirements (.running nextScope) ∧
      RecursiveRequirements.Checked entries
        (OwnerPhases.ofStack tables (.push (.unwinding action) rest) ++ receiving) before
        (.emitAfter (.sequence (.request [] []) (.request [] [])) [] latent) callbackRow ∧
      RecursiveRequirements.Checked entries receiving before nextRequirements tailRow ∧
      row = callbackRow ++ tailRow := by
  cases source with
  | push head tail => cases head with
      | cleanup callback certified =>
          obtain ⟨callbackRow, tailRow, callbackCheck, tailCheck, same⟩ :=
            RecursiveRequirements.checked_sequence_parts checked
          obtain ⟨expression, appCheck⟩ := SourceDependencyFrames.cleanup_application_checked (SourcePlannedSources.expression_erase callback)
            (by simpa only [Requirements.prepend, List.nil_append] using callbackCheck)
          refine ⟨_, _, _, callbackRow, tailRow, _, _, _, rfl, certified,
            .app (SourcePlannedSources.Values.change_context callback action.closed.1 action.requests .none) .unit (List.Subset.refl _), tail,
            .push (.unwinding callback certified) tail, appCheck, ?_, same⟩
          apply RecursiveRequirements.evaluate_sound
          simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            evaluate_empty, spendAll, merge_empty_left] using RecursiveRequirements.checked_complete tailCheck

theorem PlannedModeSource.finish_cleanup
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.unwinding action) rest) (.value .unit) output demand requirements scope)
    (checked : RecursiveRequirements.Checked entries receiving before requirements row) :
    ∃ nextScope, ∃ nextRequirements : Requirements demand,
      scope = .running nextScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest .unwind output demand nextRequirements nextScope ∧
      RecursiveRequirements.Checked entries receiving before nextRequirements row := by
  cases source with
  | push head tail => cases head with
      | ordinary frame => cases frame
      | unwinding callback certified =>
          refine ⟨_, _, rfl, tail, RecursiveRequirements.evaluate_sound ?_⟩
          simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            evaluate_empty, spendAll, merge_empty_left] using RecursiveRequirements.checked_complete checked

theorem PlannedModeSource.advance_checked
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack .unwind output demand requirements scope)
    (step : LexicalUnwind.Advance stack after discharged)
    (checked : Checked entries receiving before requirements row) :
    ∃ nextDemand, ∃ nextRequirements : Requirements nextDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world after .unwind output
        nextDemand nextRequirements scope.afterUnwind ∧
      Checked entries receiving (spendAll before (discharged.filterMap Syntax.ticketProjection)) nextRequirements row := by
  cases step with
  | plain => cases source with | push head tail => cases head with
      | skipped =>
          refine ⟨_, _, tail, RecursiveRequirements.evaluate_sound ?_⟩
          simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            evaluate_empty, spendAll, merge_empty_left, List.filterMap_nil] using RecursiveRequirements.checked_complete checked
  | handler => cases source with | push head tail => cases head with
      | handler declaration =>
          refine ⟨_, _, tail, RecursiveRequirements.evaluate_sound ?_⟩
          simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            evaluate_empty, spendAll, merge_empty_left, List.filterMap_nil] using RecursiveRequirements.checked_complete checked
  | cell => cases source with | push head tail => cases head with
      | cell =>
          refine ⟨_, _, tail, RecursiveRequirements.evaluate_sound ?_⟩
          simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            evaluate_empty, spendAll, merge_empty_left, List.filterMap_cons, List.filterMap_nil, Syntax.ticketProjection] using
            RecursiveRequirements.checked_complete checked
  | spent => cases source with
      | skippedSpent tail =>
          obtain ⟨firstRow, secondRow, first, second, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
          have firstEmpty : firstRow = [] := by
            have evaluated := RecursiveRequirements.checked_complete first
            rw [RecursiveRecomposition.evaluate_spent] at evaluated
            split at evaluated
            · exact (Option.some.inj evaluated).symm
            · cases evaluated
          subst firstRow
          exact ⟨_, _, tail, second⟩
  | retire => cases source with | push head tail => cases head with
      | retiring =>
          obtain ⟨firstRow, secondRow, first, second, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
          have firstEmpty : firstRow = [] := by
            have evaluated := RecursiveRequirements.checked_complete first
            rw [RecursiveRequirements.evaluate_prepend, RecursiveClosing.evaluate_retire] at evaluated
            split at evaluated
            · exact (Option.some.inj evaluated).symm
            · cases evaluated
          subst firstRow
          exact ⟨_, _, tail, second⟩
  | live => cases source with
      | opening saved tail =>
          obtain ⟨combined, result, evaluation⟩ := saved.append (PlannedModeSource.push .retiring tail)
          refine ⟨_, combined, result, RecursiveRequirements.evaluate_sound ?_⟩
          rw [evaluation]
          simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            RecursiveClosing.evaluate_retire, List.filterMap_nil, spendAll] using RecursiveRequirements.checked_complete checked

theorem PlannedModeSource.finish_close
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.closing identity caller) rest) .unwind output demand requirements scope)
    (checked : Checked entries receiving before requirements row) :
    ∃ nextScope, ∃ nextRequirements : Requirements demand,
      scope = .running nextScope ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest (.value .unit) output demand nextRequirements nextScope ∧
      Checked entries receiving before nextRequirements row := by
  cases source with | push head tail => cases head with
    | closing scopeKnown =>
        refine ⟨_, _, rfl, scopeKnown, tail, RecursiveRequirements.evaluate_sound ?_⟩
        simpa only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          evaluate_empty, spendAll, merge_empty_left] using RecursiveRequirements.checked_complete checked
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.start_cleanup
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.finish_cleanup
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.advance_checked
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.finish_close

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Operations Contracts Value)
open SourceDeclarationPlans (Plan)
open SourcePlanSignatures (signature)
open SourcePlannedChecks (Certified)
open SourceDependencyAnnotations (Dependencies RowAnnotation StoreAnnotation RequirementPath)
open SourceDependencyFrames (UnwindRecords)
open SourceDependencySchemes.Lexical (UnwindAnnotated)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open RecursiveRequirements (Requirements Store)
open OwnerPhaseTransitions (available)

private theorem return_hints_append_nil (hints : ReturnHints scope) : HEq (hints.append .nil) hints := by
  have lift {first second : SourceDependencyCapture.Scope} {layer : SourceDependencyCapture.Scope → SourceDependencyCapture.Scope}
      {a : ReturnHints first} {b : ReturnHints second}
      (same : first = second) (related : HEq a b)
      (f : ∀ {scope}, ReturnHints scope → ReturnHints (layer scope)) : HEq (f a) (f b) := by
    cases same
    cases eq_of_heq related
    rfl
  induction hints with
  | nil => rfl
  | plain rest ih => exact lift (SourceDependencyProjection.scope_append_nil _) ih (fun x => .plain x)
  | handler rest ih => exact lift (SourceDependencyProjection.scope_append_nil _) ih (fun x => .handler x)
  | cell rest ih => exact lift (SourceDependencyProjection.scope_append_nil _) ih (fun x => .cell x)
  | cleanup rest ih => exact lift (SourceDependencyProjection.scope_append_nil _) ih (fun x => .cleanup x)
  | running kind rest ih => exact lift (SourceDependencyProjection.scope_append_nil _) ih (fun x => .running kind x)
  | live saved rest ihSaved ihRest => exact lift (SourceDependencyProjection.scope_append_nil _) ihRest (fun x => .live saved x)
  | spent rest ih => exact lift (SourceDependencyProjection.scope_append_nil _) ih (fun x => .spent x)

/-- Enter the actual cleanup callback with the same retained plan, records and
annotated certificate. The entire predecessor certificate remains a checked
alternative; no selected future cleanup branch is discarded by this step. -/
theorem start_planned_cleanup
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.armed action) rest) .unwind output demand requirements scope)
    {hints : ReturnHints scope}
    (matching : ReturnHints.Matches tables families hints (.push (.armed action) rest))
    (pending : Pending outward actions (available (ownedTickets (.push (.armed action) rest))) world
      hints .nil .unwind output.mode)
    (bound : Bound annotations scope)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
        (.push (.armed action) rest) key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      UnwindAnnotated operations.erase policy contracts.erase tables families annotations world (.push (.armed action) rest) key body)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets (.push (.armed action) rest)))
      annotatedRoot certificateRow)
    (finite : SourceContextualRechecking.checkForest required (.push (.armed action) rest) scope .nil = true)
    (unique : (ownedTickets (.push (.armed action) rest)).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.unwind runtimeScope (.push (.armed action) rest)))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope (.push (.armed action) rest)))
    (resources : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope (.push (.armed action) rest))) :
    ∃ latent dependencies, ∃ callbackPlan : Plan dependencies, ∃ nextScope,
    ∃ nextRequirements : Requirements demand,
    ∃ nextHints : ReturnHints (.running nextScope),
    let nextStack := Stack.push (.unwinding action) rest
    let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
    let combined := Requirements.sequence (callbackRequirements.prepend (OwnerPhases.ofStack tables nextStack)) nextRequirements
    ∃ annotatedNext : Requirements demand, ∃ nextRow,
      scope = .cleanup action.requests dependencies nextScope ∧
      Certified (evidence := declarationPolicy) outward world (.sequence .pure (.sequence .pure callbackPlan)) ∧
      SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
        (.app action.action .unit) .unit [] callbackRequirements (signature (.sequence .pure (.sequence .pure callbackPlan))) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world nextStack
        (.value .unit) output demand nextRequirements (.running nextScope) ∧
      ReturnHints.Matches tables families nextHints nextStack ∧
      Local outward actions (available (ownedTickets nextStack)) world (.sequence .pure (.sequence .pure dependencies)) nextHints ∧
      Pending outward actions (available (ownedTickets nextStack)) world nextHints .nil .ordinary output.mode ∧
      Bound annotations (.running nextScope) ∧
      RowAnnotation combined annotatedNext ∧
      RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets nextStack)) annotatedNext nextRow ∧
      nextRow ⊆ certificateRow ∧ RequirementPath annotatedRoot annotatedNext [] ∧
      demand.Perm (ownedTickets nextStack) ∧ (ownedTickets nextStack).Nodup ∧
      SourceContextualRechecking.checkForest required nextStack (.running nextScope) .nil = true ∧
      (∀ key body, (key, body) ∈ resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world nextStack key body) ∧
      (∀ key body, (key, body) ∈ disposals →
        UnwindAnnotated operations.erase policy contracts.erase tables families annotations world nextStack key body) ∧
      LexicalUnwind.UseTransition (.unwind runtimeScope (.push (.armed action) rest))
        (.eval ⟨.app action.action .unit, .none, nextStack⟩) [] [] ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨.app action.action .unit, .none, nextStack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.app action.action .unit, .none, nextStack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨.app action.action .unit, .none, nextStack⟩) := by
  obtain ⟨normalRow, normalCheck, normalBound⟩ := annotation.checked checked
  obtain ⟨_, originalCheck, _⟩ := storeAnnotation.checked normalCheck
  have balance := SourceDependencySchemes.Lexical.mode_stack_ownership_balance source.erase
    (fun key body member => (records key body member).erase) closing unique originalCheck
  obtain ⟨latent, dependencies, callbackPlan, callbackRow, tailRow, nextScope, tailRequirements, nextRequirements,
    scopeSame, certified, expression, tailSource, nextSource, appChecked, nextChecked, rowSame⟩ := source.start_cleanup normalCheck
  cases scopeSame
  cases matching with
  | cleanup restMatch =>
    have checks := pending.start_cleanup
    cases bound with
    | cleanup tailBound =>
      have callbackLocal := checks.1.reindex_scope
        (congrArg SourceDependencyCapture.Scope.running (SourceDependencyProjection.scope_append_nil _))
        (SourceDependencyNeutral.Lexical.Recursive.running_congr (SourceDependencyProjection.scope_append_nil _)
          (return_hints_append_nil _) .unwind)
      let combined := Requirements.sequence
        ((Requirements.emitAfter (Requirements.sequence (.request [] []) (.request [] [])) [] latent).prepend
          (OwnerPhases.ofStack tables (.push (.unwinding action) rest))) nextRequirements
      have combinedCheck : RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets rest)) combined
          (callbackRow ++ tailRow) :=
        .sequence (RecursiveRequirements.checked_prepend_iff.mpr (by simpa only [List.append_nil, ownedTickets] using appChecked)) nextChecked
      let annotatedNext := Requirements.choice combined annotatedRoot (List.Perm.refl demand)
      have step : LexicalUnwind.UseTransition (.unwind runtimeScope (.push (.armed action) rest))
          (.eval ⟨.app action.action .unit, .none, .push (.unwinding action) rest⟩) [] [] := .startCleanup
      have location : ∀ key captured, SourceTemplates.CapturedIn key captured (.push (.armed action) rest) →
          SourceTemplates.CapturedIn key captured (.push (.unwinding action) rest) := by
        intro key captured located
        cases located with | push found => exact .push found
      refine ⟨latent, dependencies, callbackPlan, nextScope, nextRequirements, _, annotatedNext, _, rfl,
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
          (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified), expression, nextSource, .running .unwind restMatch,
        callbackLocal, checks.2, .running tailBound, .alternatives .original (.refl _),
        .choice combinedCheck checked, List.append_subset.mpr ⟨rowSame ▸ normalBound, List.Subset.refl _⟩,
        .no .here, balance, unique, ?_, ?_, ?_, step, ?_, ?_, ?_⟩
      · simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame] using finite
      · intro key body member
        exact (records key body member).transport (fun _ _ known => known) (fun _ _ known => known)
          (fun _ _ known => known) location
      · intro key body member
        exact (closing key body member).transport (fun _ _ known => known) (fun _ _ known => known)
          (List.Subset.refl _) location
      · simpa only [LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
          step.preserves (by intro owner member; cases member) unique usage
      · simpa only [LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
          step.ticket_access (by intro owner member; cases member) unique usage tickets
      · exact LexicalUnwind.transition_access step.erases resources trivial

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.start_planned_cleanup

