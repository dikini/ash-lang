      (front.append (.live owner inputType answerType captured caller tail))
      (.value contract.answer) output pendingDemand pendingRequirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source (.value (owners owner contract known).2) outputRows context)
    (same : context.pack = (frontContext.append
      (.live (owner := owner) (resumeDemand := resumeDemand) capturedContext tailContext)).pack)
