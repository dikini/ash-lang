private theorem resume_pending_at
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
    (code : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .resume⟩))
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)))
    (located : SourceDependencyCapture.OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩) :
    SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations
      (captured.append (front.append (.spent (owner := owner) tail))) .nil .ordinary
      ((frontHints.append (.live (owner := owner) capturedHints tailHints)).returnMode .ordinary) :=
  (code.resume_evidence_at located).2

/-- The authenticated ready primitive supplies the pending certificate at the
same selected decorated contexts, after consuming its owner. -/
theorem ReadyResumeSite.restored_pending
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyResumeSite site) :
    SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases view.owner) world installations
      (view.capturedContext.append (view.frontContext.append (.spent (owner := view.owner) view.tailContext)))
      .nil .ordinary output.mode := by
  have primitive : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨view.owner, .resume⟩)) site.context := by
    have current := site.current
    have expression := view.expression
    rw [expression] at current
    exact SourceAdmission.Code.ready_resume current.previous.authenticated view.resolved current.certificate
  have restored := resume_pending_at (primitive.reindex_context view.context) view.located
  have mode := (site.retained.reindex_context view.context).return_mode
  rw [mode] at restored
  exact restored

 theorem ReadyResumeSite.restored_resource
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyResumeSite site) :
    InstallationSupport.PendingChecked ambient outward view.restored_pending := by
  obtain ⟨owner, contract, known, resolved, _result, _rows, primitive, checked⟩ :=
    InstallationSupport.checked_resume_origin site.current.previous.authenticated view.expression site.currentResource
  have same : owner = view.owner := Option.some.inj (resolved.symm.trans view.resolved)
  subst owner
  exact (((checked.reindex_context view.context).resume_pending_at view.located).output_mode
    (site.retained.reindex_context view.context).return_mode).reproof

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ReadyResumeSite.restored_pending


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (spend)

/-- Assemble the actual returned-value site from one reconstructed pending
source. The primitive's restored structural certificate is joined below. -/
private theorem ready_resume_successor_of_pending
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyResumeSite site)
    (execution : ResumeExecution tables view.owner view.front view.captured view.tail view.answerType view.caller
      view.frontContext view.recorded view.frontRequirements view.liveRequirements (root : Requirements rootDemand))
    (restored : SourceAdmission.Pending outward actions budget (spend phases view.owner) world installations
      (view.capturedContext.append (view.frontContext.append (.spent (owner := view.owner) view.tailContext)))
      .nil .ordinary output.mode)
    (restoredResource : PendingChecked ambient outward restored)
    (checked : Checked (annotateDisposalStore entries) receiving phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions (spend phases view.owner)
        world installations (RecursiveTransport.removeOwner view.owner resumes) budget ports owners emptyRows output outputRows,
      next.expression = view.operand ∧ next.runtimeScope = site.runtimeScope ∧
      next.stack = view.captured.append (view.front.append (.spent view.owner view.answerType view.caller view.tail)) ∧
      next.context.pack = (view.capturedContext.append
        (view.frontContext.append (.spent (owner := view.owner) view.tailContext))).pack ∧
      next.expression.IsValue ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner view.owner entries)) receiving
        (spend phases view.owner) (annotateDisposals next.pendingRequirements) row ∧
      rootDemand = view.owner :: next.pendingDemand ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [.ticket view.owner] := by
  obtain ⟨demand, requirements, pending, coherent, nextChecked, sameDemand⟩ :=
    view.frontRows.resume_execution_checked view.liveRows rfl view.found execution checked
  obtain ⟨summary, authenticated⟩ := view.operand_summary
  let source := SourcePlannedSources.Values.change_context summary view.closed.1 [] site.runtimeScope
  have sourceAuth := authenticated.value_context view.closed.1 [] site.runtimeScope
  let next : ExecutionSite ambient operations policy contracts tables families required outward actions (spend phases view.owner)
      world installations (RecursiveTransport.removeOwner view.owner resumes) budget ports owners emptyRows output outputRows :=
    { expression := view.operand, runtimeScope := site.runtimeScope,
      stack := view.captured.append (view.front.append (.spent view.owner view.answerType view.caller view.tail)),
      result := view.contract.input, resultRows := (owners view.owner view.contract view.known).1,
      allowed := [], dependencies := .pure, plan := .pure, rows := .pure,
      sourceDemand := [], sourceRequirements := .request [] [],
      receiving := view.capturedScope.append (view.frontScope.append (.spent view.owner view.tailScope)),
      hints := view.capturedHints.append (view.frontHints.append (.spent view.tailHints)),
      context := view.capturedContext.append (view.frontContext.append (.spent (owner := view.owner) view.tailContext)),
      current := SourceAdmission.Admitted.of_source source sourceAuth .pure coherent.forget.source,
      certified := .pure (evidence := declarationPolicy), scopeTyped := site.scopeTyped,
      pendingDemand := demand, pendingRequirements := requirements, pending := pending,
      coherent := coherent, retained := restored, currentResource := .pure, retainedResource := restoredResource }
  refine ⟨next, rfl, rfl, rfl, rfl, view.closed.1, nextChecked, sameDemand, ?_⟩
  change RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
    ⟨view.operand, site.runtimeScope,
      view.captured.append (view.front.append (.spent view.owner view.answerType view.caller view.tail))⟩ [] [.ticket view.owner]
  rw [view.expression, view.stack]
  exact .resume view.binder view.owner site.runtimeScope view.caller view.inputType view.answerType
    view.front view.captured view.tail view.operand view.closed view.resolved

/-- The predecessor's actual operand and structural resume primitive construct
one actual value site and its legacy scalar check. No successor certificate
is an input, and no central execution root is asserted by this legacy result. -/
theorem ReadyResumeSite.successor
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (view : ReadyResumeSite site)
    (execution : ResumeExecution tables view.owner view.front view.captured view.tail view.answerType view.caller
      view.frontContext view.recorded view.frontRequirements view.liveRequirements (root : Requirements rootDemand))
    (checked : Checked (annotateDisposalStore entries) receiving phases (annotateDisposals root) row) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions (spend phases view.owner)
        world installations (RecursiveTransport.removeOwner view.owner resumes) budget ports owners emptyRows output outputRows,
      next.expression = view.operand ∧ next.runtimeScope = site.runtimeScope ∧
      next.stack = view.captured.append (view.front.append (.spent view.owner view.answerType view.caller view.tail)) ∧
      next.context.pack = (view.capturedContext.append
        (view.frontContext.append (.spent (owner := view.owner) view.tailContext))).pack ∧
      next.expression.IsValue ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner view.owner entries)) receiving
        (spend phases view.owner) (annotateDisposals next.pendingRequirements) row ∧
      rootDemand = view.owner :: next.pendingDemand ∧
      RawStep ⟨site.expression, site.runtimeScope, site.stack⟩
        ⟨next.expression, next.runtimeScope, next.stack⟩ [] [.ticket view.owner] :=
  ready_resume_successor_of_pending view execution view.restored_pending view.restored_resource checked

