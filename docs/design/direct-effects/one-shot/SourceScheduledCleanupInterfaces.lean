private theorem executable_cell_reply
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
        runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩)
    (selected : CellUpdate identity old new beforeStack afterStack)
    (isValue : operand.IsValue)
    (response : ∀ allowed argument result, operations (.cell identity) operation = some (argument, result) →
      SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none) allowed reply result)
    (responseAuth : ∀ allowed scope result,
      ∀ source : SourcePlannedSources.Expression operations policy contracts world allowed scope (fun _ => none)
        reply result [] (.request [] []) .pure,
      ∀ resultRows : ValueRows result,
        Auth operations policy ports owners emptyRows source resultRows .pure)
    (step : RawStep ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
      runtimeScope, beforeStack⟩ ⟨reply, runtimeScope, afterStack⟩ [] []) :
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨reply, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  have event : LexicalUnwind.Event
      ⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
        runtimeScope, beforeStack⟩, issued, completed⟩
      ⟨.eval ⟨reply, runtimeScope, afterStack⟩, issued, completed⟩ := by
    simpa only [List.append_nil, List.nil_append] using
      (LexicalUnwind.Event.step
        (before := ⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand,
          runtimeScope, beforeStack⟩, issued, completed⟩)
        (LexicalUnwind.Transition.evaluate step (by trivial))
        (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.ledger.2))
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.eval ⟨reply, runtimeScope, afterStack⟩) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval
      ⟨.perform (Instantiation.freezeEffect (.cell identity)) operation operand, runtimeScope, beforeStack⟩ = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
      obtain ⟨expressionSame, scopeSame, stackSame⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
      have update : CellUpdate identity old new site.stack afterStack := by simpa only [← stackSame] using selected
      have run := rooted.ready_request expressionSame.symm isValue
      obtain ⟨next, nextExpression, nextScope, nextStack, nextContext, nextRoot⟩ :=
        site.cell_reply_accounting expressionSame.symm update isValue response responseAuth run
      have nextPhase := phaseAgreement.trans (congrArg available (cell_update_owned_tickets update))
      rw [← nextStack] at nextPhase
      have nextBound : Bound annotations next.receiving := by
        have same := congrArg Packed.scope nextContext
        change next.receiving = site.receiving at same
        rw [same]
        exact bound
      have certified := ExecutableSource.eval next nextPhase nextRoot nextBound annotation checked bounded
      simpa only [nextExpression, nextScope, nextStack, ← scopeSame] using certified
    | unwind => cases machineEq
  refine ⟨nextSource, ?_, ?_, state.storeAnnotation, LexicalUnwind.event_preserves_ledger event state.ledger,
    state.registry, ?_, ?_, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
      exact .resume (cell_update_capture_retained selected located) known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
      exact .dispose (cell_update_capture_retained selected located) held recorded source
  · cases state.resources with
    | eval supported =>
      apply LexicalUnwind.MachineAccess.eval
      apply ScopedExecution.raw_step_preserves_access step supported
      constructor
      · intro identity payload answer savedScope current valueCode rest same closed
        have value := closed.1
        have expressionSame := congrArg Configuration.expression same
        change Code.perform _ _ _ = valueCode at expressionSame
        rw [← expressionSame] at value
        exact False.elim value
      · intro requested operation operand current stack cap outside handler same cut closed
        have expressionSame := congrArg Configuration.expression same
        have effectSame := freeze_effect_injective (Code.perform.inj expressionSame).1
        cases effectSame
        cases same
        exact False.elim (cell_update_excludes_handler_cut selected cut)
      · intro binder owner current caller input answer front cap outside plan same resolve built
        cases same
  · simpa only [LexicalUnwind.Machine.stack, cell_update_erases selected] using state.activations

/-- A builtin read preserves the corrected common state and the same executable root. -/
theorem ExecutableState.read_cell
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 0 (.resourceRef (.activation identity)),
        runtimeScope, beforeStack⟩, issued, completed⟩, actions⟩)
    (builtin : operations.erase.erase.ports (.cell identity) 0 = some (.reference identity, .integer))
    (selected : CellUpdate identity payload payload beforeStack afterStack) :
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.integer payload, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  apply executable_cell_reply state selected (by trivial) ?_ ?_
    (.readCell identity payload runtimeScope beforeStack afterStack selected)
  · intro allowed argument result known
    have answer := (Prod.mk.inj (Option.some.inj (builtin.symm.trans (CoherentSourceTypes.port_lookup
      (SourceDependencyAnnotations.operation_erase (SourcePlannedSources.operation_erase known)))))).2
    cases result <;> cases answer
    exact .integer
  · intro allowed scope result source resultRows
    cases source
    cases resultRows
    exact .integer

/-- A builtin write retains the same source annotations and all common fields. -/
theorem ExecutableState.write_cell
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.perform (Instantiation.freezeEffect (.cell identity)) 1
        (.pair (.resourceRef (.activation identity)) (.integer new)), runtimeScope, beforeStack⟩,
        issued, completed⟩, actions⟩)
    (builtin : operations.erase.erase.ports (.cell identity) 1 = some (.product (.reference identity) .integer, .unit))
    (selected : CellUpdate identity old new beforeStack afterStack) :
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, afterStack⟩, issued, completed⟩, actions⟩ := by
  apply executable_cell_reply state selected (by trivial) ?_ ?_
    (.writeCell identity old new runtimeScope beforeStack afterStack selected)
  · intro allowed argument result known
    have answer := (Prod.mk.inj (Option.some.inj (builtin.symm.trans (CoherentSourceTypes.port_lookup
      (SourceDependencyAnnotations.operation_erase (SourcePlannedSources.operation_erase known)))))).2
    cases result <;> cases answer
    exact .unit
  · intro allowed scope result source resultRows
    cases source
    cases resultRows
    exact .unit

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
