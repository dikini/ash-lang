/-- The ready resume leaf is tied to the authenticated expression, lexical
receiver, physical stack, and actual saved record. Its fragments are source
premises; no successor check or ownership permutation is a field. -/
structure ReadyResumeSite
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows) where
  owner : Nat
  binder : Nat
  operand : Code
  expression : site.expression = .resume binder operand
  closed : ClosedValue operand
  resolved : site.runtimeScope.resolve binder = some owner
  contract : SourcePlannedTyping.Contract
  known : contracts owner = some contract
  result : site.result = contract.answer
  front : Stack
  captured : Stack
  tail : Stack
  inputType : Ty
  answerType : Ty
  caller : Scope
  stack : site.stack = front.append (.live owner inputType answerType captured caller tail)
  frontScope : SourceDependencyCapture.Scope
  capturedScope : SourceDependencyCapture.Scope
  tailScope : SourceDependencyCapture.Scope
  frontHints : ReturnHints frontScope
  capturedHints : ReturnHints capturedScope
  tailHints : ReturnHints tailScope
  frontContext : Context frontHints
  capturedContext : Context capturedHints
  tailContext : Context tailHints
  context : site.context.pack = (frontContext.append
    (.live (owner := owner) (resumeDemand := contract.resumeDemand) capturedContext tailContext)).pack
  located : SourceDependencyCapture.OwnerCut owner
    (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩
  frontDemand : List Nat
  tailDemand : List Nat
  frontRequirements : Requirements frontDemand
  liveRequirements : Requirements tailDemand
  recorded : Requirements contract.resumeDemand
  found : RecursiveRequirements.lookup ⟨owner, .resume⟩ resumes = some ⟨contract.resumeDemand, recorded⟩
  frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
    front (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope
  liveSource : PlannedModeSource operations policy contracts tables families required outward actions world
    (.live owner inputType answerType captured caller tail) (.value contract.answer) output
    tailDemand liveRequirements (.live owner capturedScope tailScope)
  frontRows : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes frontSource (.value (owners owner contract known).2)
      (.value (owners owner contract known).2) frontContext
  liveRows : RecordPendingRows operations policy contracts tables families required outward actions world
    ports owners emptyRows resumes liveSource (.value (owners owner contract known).2) outputRows
      (.live (resumeDemand := contract.resumeDemand) capturedContext tailContext)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual




