/-- Starting a normal callback retains the authenticated saved value and the
callback's exact body rows in the same physical running marker. -/
theorem RetainedState.start_normal_cleanup
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .push (.armed action) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.app action.action .unit, .none, .push (.running action value closed) tail⟩,
        issued, completed⟩, actions⟩ := by
  have operational := state.joined.start_normal_cleanup closed
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    have template := DeclaredSources.expression_erase
      (SourceDependencyAnnotations.expression_erase (SourcePlannedSources.expression_erase current.source))
    have empty := SourceTemplates.expression_value_demand template closed.1
    cases empty
    cases coherent with
    | push frame remaining =>
      cases frame with
      | ordinary authenticated =>
        cases authenticated with
        | armed callbackAuth =>
          rename_i restScope restHints restContext tailDemand tailRequirements incoming outgoing callbackDependencies latent
            callbackPlan bodyRows callbackCertified scopeKnown callback portAnnotation suffix interface
          cases retained with | cleanup completion remainingLocal =>
            cases pendingBudget with | cleanup normalBudget remainingBudget =>
              cases bound with | cleanup restBound =>
                cases interface with | armed savedScope callable admitted =>
                  let summary := SourcePlannedSources.Values.change_context
                    (SourcePlannedSources.Values.summary current.source closed.1) closed.1 [] .none
                  have summaryAuth := (current.authenticated.value_summary closed.1).value_context closed.1 [] .none
                  have savedTyped : ScopedPorts.Typed operations.erase.erase.ports world ScopedPorts.TypeEnv.empty .none []
                      value (ScopedPorts.eraseType action.answer) := by
                    have environmentSame : (SourcePlannedTyping.Environment.erase (fun _ => none)).erase.ports = ScopedPorts.TypeEnv.empty := by
                      funext name; rfl
                    simpa only [← portAnnotation, environmentSame] using (SourcePlannedSources.Values.erase summary closed.1).ports .none
                  have callbackLocal : Local outward actions (available (ownedTickets tail)) world callbackDependencies
                      (.running .normal restHints) := by
                    change Local outward actions (available (ownedTickets tail)) world callbackDependencies
                      (Context.normal (restContext.append .nil).pack.context).pack.hints at completion
                    rw [restContext.append_nil_pack] at completion
                    exact completion
                  have callbackBudget : Budgeted budget (available (ownedTickets tail)) world history bodyRows (.normal restContext) := by
                    change Budgeted budget (available (ownedTickets tail)) world history bodyRows
                      (Context.normal (restContext.append .nil).pack.context) at normalBudget
                    rw [restContext.append_nil_pack] at normalBudget
                    exact normalBudget
                  let nextRequirements := Requirements.sequence
                    ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) tailRequirements
                  let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
                  let nextRoot := Requirements.sequence
                    (callbackRequirements.prepend (OwnerPhases.ofStack tables (.push (.running action value closed) tail))) nextRequirements
                  have callbackSource : SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
                      (.app action.action .unit) .unit [] callbackRequirements
                      (signature (.sequence .pure (.sequence .pure callbackPlan))) :=
                    .app (SourcePlannedSources.Values.change_context callback action.closed.1 action.requests .none) .unit (List.Subset.refl _)
                  have nextAuth : Auth operations policy ports owners emptyRows callbackSource .unit
                      (.sequence .pure (.sequence .pure bodyRows)) :=
                    .app (callbackAuth.value_context action.closed.1 action.requests .none) .unit (admitted := List.Subset.refl _)
                  have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows world history
                      action.requests outward .none actions (available (ownedTickets tail)) budget tables families
                      (.normal restContext) (.push (.running action value closed) tail)
                      (.app action.action .unit) .unit [] callbackRequirements
                      (signature (.sequence .pure (.sequence .pure callbackPlan))) .unit
                      (.sequence .pure (.sequence .pure bodyRows)) :=
                    ⟨callbackSource, nextAuth, .sequence .pure (.sequence .pure callbackLocal),
                      .sequence .pure (.sequence .pure callbackBudget), .normal remaining.forget.source⟩
                  have nextCertified : Certified (evidence := declarationPolicy) outward world
                      (.sequence .pure (.sequence .pure callbackPlan)) :=
                    Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
                      (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) callbackCertified)
                  have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required
                      outward world (.running action value closed) .unit result [] (.request [] [])
                      (fun scope => scope.running) (fun rest => .running rest) _ _ :=
                    .running scopeKnown callback summary portAnnotation (.running savedScope callable savedTyped admitted)
                  have frameRows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
                      frame .unit resultRows restContext (.normal restContext) :=
                    .running (action := action) (callback := callback) (saved := summary)
                      (scopeKnown := scopeKnown) (annotation := portAnnotation)
                      (interface := .running savedScope callable savedTyped admitted) callbackAuth summaryAuth
                  have generated : ∀ entries receiving before,
