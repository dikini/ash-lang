open RecursiveRequirements (Requirements evaluate)

set_option linter.unusedSimpArgs false in
/-- Construct the unwind source and its authenticated rows together at the
original decorated context. Evaluation agrees with the projected metadata. -/
theorem PendingRows.closing_rich
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : PendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows source inputRows outputRows context)
    (found : context.closing? = some metadata) :
    ∃ generated : Requirements metadata.closing.1,
    ∃ next : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind .unwind metadata.closing.1 generated scope,
      PendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows next .unwind .unwind context ∧
      ∀ entries receiving phases,
        evaluate entries receiving phases generated = evaluate entries receiving phases metadata.closing.2 := by
  induction rows with
  | nil => cases found; exact ⟨_, .nil, .nil, by intros; rfl⟩
  | push head tail ih =>
      obtain ⟨tailMetadata, tailFound⟩ := head.closing_tail found
      obtain ⟨generated, next, nextRows, evaluation⟩ := ih tailFound
      cases head with
      | ordinary authenticated | handler authenticated =>
          cases authenticated <;> simp only [Context.closing?, tailFound, Option.map_some, Option.some.injEq] at found
          all_goals first | contradiction | subst metadata
          all_goals first
          | refine ⟨_, .push .skipped next, .push .skipped nextRows, ?_⟩
          | refine ⟨_, .push (.handler (by constructor <;> assumption)) next, .push (.handler (by constructor <;> assumption)) nextRows, ?_⟩
          | refine ⟨_, .push .cell next, .push .cell nextRows, ?_⟩
          | refine ⟨_, .push (.cleanup (by assumption) (by assumption)) next, .push (.cleanup (by assumption) (certified := by assumption)) nextRows, ?_⟩
          | refine ⟨_, .push .retiring next, .push .retiring nextRows, ?_⟩
          all_goals
            intro entries receiving phases
            simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
              RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty,
              OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
              Requirements.prepend, List.nil_append, RecursiveClosing.evaluate_retire, evaluation,
              (Context.closing?_sound _ tailFound).2, tail.source.context_eq]
      | unwinding authenticated | closing => cases found
      | retiring | skipped | cell | cleanup authenticated =>
          simp only [Context.closing?, tailFound, Option.map_some, Option.some.injEq] at found
          subst metadata
          first
          | refine ⟨_, .push .retiring next, .push .retiring nextRows, ?_⟩
          | refine ⟨_, .push .skipped next, .push .skipped nextRows, ?_⟩
          | refine ⟨_, .push .cell next, .push .cell nextRows, ?_⟩
          | refine ⟨_, .push (.cleanup (by assumption) (by assumption)) next, .push (.cleanup authenticated (certified := by assumption)) nextRows, ?_⟩
          all_goals
            intro entries receiving phases
            simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
              RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty,
              OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
              Requirements.prepend, List.nil_append, RecursiveClosing.evaluate_retire, evaluation,
              (Context.closing?_sound _ tailFound).2, tail.source.context_eq]
  | live aligned saved tail ihSaved ihTail | opening saved tail ihSaved ihTail =>
      obtain ⟨⟨savedMetadata, savedFound⟩, ⟨tailMetadata, tailFound⟩⟩ := live_closing_parts found
      simp [Context.closing?, savedFound, tailFound] at found
      subst metadata
      obtain ⟨savedRequirements, savedNext, savedRows, savedEvaluation⟩ := ihSaved savedFound
      obtain ⟨tailRequirements, tailNext, tailRows, tailEvaluation⟩ := ihTail tailFound
      refine ⟨_, .opening savedNext tailNext, .opening savedRows tailRows, ?_⟩
      intro entries receiving phases
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRequirements.evaluate_prepend, RecursiveClosing.evaluate_retire,
        OwnerPhaseTransitions.spendAll, savedEvaluation, tailEvaluation,
        (Context.closing?_sound _ tailFound).2, tail.source.context_eq,
        OwnerPhases.ofStack, OwnerPhases.frameEntry, ExecFrame.erase,
        CloseItem.frame, ProtectionContexts.frameProtected]
  | spent tail ih | skippedSpent tail ih =>
      simp only [Context.closing?, Option.map_eq_some_iff] at found
      obtain ⟨tailMetadata, tailFound, same⟩ := found
      subst metadata
      obtain ⟨generated, next, nextRows, evaluation⟩ := ih tailFound
      refine ⟨_, .skippedSpent next, .skippedSpent nextRows, ?_⟩
      intro entries receiving phases
      simp only [CleanupHints.Metadata.closing, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_spent, OwnerPhaseTransitions.spendAll, evaluation]

/-- Retain the original ordinary saved views while generating rich unwind rows.
The old six-case source construction is reused through reauthentication. -/
theorem RecordPendingRows.closing_rich
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (found : context.closing? = some metadata) :
    ∃ generated : Requirements metadata.closing.1,
    ∃ next : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind .unwind metadata.closing.1 generated scope,
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows resumes next .unwind .unwind context ∧
      annotateDisposals generated = generated ∧
      metadata.closing.1.Perm (ownedTickets stack) ∧
      ∀ entries receiving phases,
        evaluate entries receiving phases (annotateDisposals generated) =
          evaluate entries receiving phases metadata.closing.2 := by
  obtain ⟨generated, next, nextRows, evaluation⟩ := rows.forget.closing_rich found
  have erased := rows.forget.source.closing_source found
  obtain ⟨scopes, _storedUnchanged⟩ := unwind_template_disposals erased.template
  have unchanged := next.unwind_disposals scopes
  refine ⟨generated, next, rows.reauthenticate nextRows, unchanged, erased.template.ownership, ?_⟩
  intro entries receiving phases
  simpa only [unchanged] using evaluation entries receiving phases

/-- The finite caller check checks the same generated source whose unwind rows
are returned here; no second existential source is selected. -/
theorem RecordPendingRows.closing_rich_checked
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (found : context.closing? = some metadata)
    (accepted : metadata.check receiving phases budget = true) (entries : RecursiveRequirements.Store) :
    ∃ generated : Requirements metadata.closing.1,
    ∃ next : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind .unwind metadata.closing.1 generated scope, ∃ row,
      RecordPendingRows operations policy contracts tables families required outward actions world
        ports owners emptyRows resumes next .unwind .unwind context ∧
      annotateDisposals generated = generated ∧
      metadata.closing.1.Perm (ownedTickets stack) ∧
      RecursiveRequirements.Checked entries receiving phases (annotateDisposals generated) row ∧ row ⊆ budget := by
  obtain ⟨generated, next, nextRows, unchanged, ownership, evaluation⟩ := rows.closing_rich found
  obtain ⟨metadataRow, evaluated, _bounded⟩ := metadata.check_iff.mp accepted
  have trace := RecursiveRequirements.checked_trace (RecursiveRequirements.evaluate_sound evaluated)
  have agreed := rows.forget.source.closing_agreement found
  obtain ⟨row, checked, within⟩ := (agreed.effects accepted).checked (store := entries) trace
  refine ⟨generated, next, row, nextRows, unchanged, ownership, ?_, within⟩
  apply RecursiveRequirements.evaluate_sound
  rw [evaluation]
  exact RecursiveRequirements.checked_complete checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
