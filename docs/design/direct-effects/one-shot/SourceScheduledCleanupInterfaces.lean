      recorded closing closingRecorded unique storeAnnotation annotation certificate currentCheck currentLocal finite
  refine ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    plans, resumeEffects, closeEffects, family, offered, advertised, bodies, chosen, certified,
    scopeSame, demandSame, saved, returns, declaration, offeredKnown, rowAvailable, familyKnown, exported,
    cutCertificate, cutRow, cutAnnotation, cutChecked, cutBound, rootPath, splitPath, ?_⟩
  intro capAnnotated tailAnnotated capAnnotation tailAnnotation selectedPath suppliedDemand suppliedRequirements suppliedSource cleanupPath
  obtain ⟨selectedRow, selectedCheck, selectedBound⟩ := selectedPath.checked cutChecked
  have splitCheck : ∃ selectedRow, RecursiveRequirements.Checked annotatedStore [] (available (ownedTickets whole))
      (.sequence (capAnnotated.prepend (OwnerPhases.ofStack tables tail)) tailAnnotated) selectedRow ∧ selectedRow ⊆ certificateRow :=
