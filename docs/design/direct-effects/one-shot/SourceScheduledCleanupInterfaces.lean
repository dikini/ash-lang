/-- Normal cleanup starts the authenticated callback under its protected return
boundary, retaining the saved value and the same contextual execution root. -/
theorem ExecutionSite.start_normal_cleanup
    (site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows)
    (closed : ClosedValue site.expression)
    (stackEq : site.stack = .push (.armed action) tail)
    (waiting : Accounting.Wait world installations site.context .ordinary (root : Requirements demand)) :
    ∃ next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows,
      next.expression = .app action.action .unit ∧ next.runtimeScope = .none ∧
      next.stack = .push (.running action site.expression closed) tail ∧
      Accounting.Run world installations next.rows next.context root ∧
      (∀ annotations, SourceDependencySchemes.Closing.Bound annotations site.receiving →
        SourceDependencySchemes.Closing.Bound annotations next.receiving) := by
  rcases site with ⟨expression, runtimeScope, stack, result, resultRows, allowed,
    dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
    current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
  dsimp only at closed stackEq waiting ⊢
  subst stack
  cases coherent with
  | push frame remaining =>
    cases frame with
    | ordinary authenticated =>
      cases authenticated with
      | armed callbackAuth =>
        rename_i restScope restHints restContext tailDemand tailRequirements incoming outgoing callbackDependencies latent
          callbackPlan bodyRows callbackCertified scopeKnown callback portAnnotation suffix interface
        cases interface with
        | armed savedScope callable admitted =>
          cases retained with
          | cleanup callbackCertificate tailCertificate =>
            let summary := SourcePlannedSources.Values.change_context
              (SourcePlannedSources.Values.summary current.previous.source closed.1) closed.1 [] .none
            have summaryAuth := (current.previous.authenticated.value_summary closed.1).value_context closed.1 [] .none
            have savedTyped : ScopedPorts.Typed operations.erase.erase.ports world ScopedPorts.TypeEnv.empty .none []
                expression (ScopedPorts.eraseType action.answer) := by
              have environmentSame : (SourcePlannedTyping.Environment.erase (fun _ => none)).erase.ports = ScopedPorts.TypeEnv.empty := by
                funext name; rfl
              simpa only [← portAnnotation, environmentSame] using (SourcePlannedSources.Values.erase summary closed.1).ports .none
            change SourceAdmission.Code _ _ _ _ _ _ bodyRows
              (Context.normal (restContext.append .nil).pack.context).pack.context at callbackCertificate
            rw [restContext.append_nil_pack] at callbackCertificate
            let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
            have callbackSource : SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
                (.app action.action .unit) .unit [] callbackRequirements
                (signature (.sequence .pure (.sequence .pure callbackPlan))) :=
              .app (SourcePlannedSources.Values.change_context callback action.closed.1 action.requests .none) .unit (List.Subset.refl _)
            have nextAuth : Auth operations policy ports owners emptyRows callbackSource .unit
                (.sequence .pure (.sequence .pure bodyRows)) :=
              .app (callbackAuth.value_context action.closed.1 action.requests .none) .unit (admitted := List.Subset.refl _)
            have nextCertified : Certified (evidence := declarationPolicy) outward world
                (.sequence .pure (.sequence .pure callbackPlan)) :=
              Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
                (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) callbackCertified)
            have nextFrame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required
                outward world (.running action expression closed) .unit result [] (.request [] [])
                (fun scope => scope.running) (fun rest => .running rest) _ _ :=
              .running scopeKnown callback summary portAnnotation (.running savedScope callable savedTyped admitted)
            have nextFrameRows : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
                nextFrame .unit resultRows restContext (.normal restContext) :=
              .running (action := action) (callback := callback) (saved := summary)
                (scopeKnown := scopeKnown) (annotation := portAnnotation)
                (interface := .running savedScope callable savedTyped admitted) callbackAuth summaryAuth
            let next : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
                resumes budget ports owners emptyRows output outputRows :=
              { expression := .app action.action .unit, runtimeScope := .none,
                stack := .push (.running action expression closed) tail,
                result := .unit, resultRows := .unit, allowed := action.requests,
                dependencies := _, plan := .sequence .pure (.sequence .pure callbackPlan),
                rows := .sequence .pure (.sequence .pure bodyRows), sourceDemand := [],
                sourceRequirements := callbackRequirements, receiving := .running restScope,
                hints := .running .normal restHints, context := .normal restContext,
                current := SourceAdmission.Admitted.of_source callbackSource nextAuth
                  (.sequence .pure (.sequence .pure callbackCertificate)) (.normal remaining.forget.source),
                certified := nextCertified, scopeTyped := ⟨.none, .none⟩,
                pendingDemand := [] ++ tailDemand,
                pendingRequirements := .sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) tailRequirements,
                pending := .push (.ordinary nextFrame) suffix,
                coherent := .push (.ordinary nextFrameRows) remaining,
                retained := .normal tailCertificate,
                currentResource := by
                  cases retainedResource with | cleanup callbackResource _ =>
                    exact .sequence .pure (.sequence .pure (callbackResource.reindex_context
                      (congrArg (fun p : Packed => (Context.normal p.context).pack) restContext.append_nil_pack))),
                retainedResource := by cases retainedResource with | cleanup _ tailResource => exact .normal tailResource }
            cases waiting with
            | cleanup callbackRun =>
              refine ⟨next, rfl, rfl, rfl, ?_, ?_⟩
              · exact (Accounting.silent_prefix_iff .pure Rows.pure _).mpr
                  ((Accounting.silent_prefix_iff .pure Rows.pure _).mpr callbackRun)
              · intro annotations bound
                cases bound with | cleanup rest => exact .running rest

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.start_normal_cleanup

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open OwnerPhaseTransitions (available)

/-- Starting a normal callback preserves the common state and the same checked
execution root; the cleanup owner remains outstanding until callback return. -/
theorem ExecutableState.start_normal_cleanup
    (state : ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨value, runtimeScope, .push (.armed action) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    LexicalUnwind.Event
      ⟨.eval ⟨value, runtimeScope, .push (.armed action) tail⟩, issued, completed⟩
      ⟨.eval ⟨.app action.action .unit, .none, .push (.running action value closed) tail⟩, issued, completed⟩ ∧
    ExecutableState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.app action.action .unit, .none, .push (.running action value closed) tail⟩, issued, completed⟩, actions⟩ := by
  have nextSource : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world history
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.eval ⟨.app action.action .unit, .none, .push (.running action value closed) tail⟩) := by
    have source := state.source
    dsimp only at source
    generalize machineEq : LexicalUnwind.Machine.eval ⟨value, runtimeScope, .push (.armed action) tail⟩ = machine at source
    cases source with
    | eval site phaseAgreement rooted bound annotation checked bounded =>
        obtain ⟨expression, _runtime, stackSame⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
        have closedSite : ClosedValue site.expression := by simpa only [← expression] using closed
        obtain ⟨next, expressionSame, scopeSame, nextStack, interpreted, nextBound⟩ :=
          site.start_normal_cleanup closedSite stackSame.symm (rooted.value_wait closedSite.1)
        have ownersSame : ownedTickets next.stack = ownedTickets site.stack := by
          rw [nextStack, ← stackSame]
          rfl
        have nextPhase := phaseAgreement.trans (congrArg available ownersSame.symm)
        have certified := ExecutableSource.eval next nextPhase (.contextual interpreted)
          (nextBound annotations bound) annotation checked bounded
        simpa only [expressionSame, scopeSame, nextStack, ← expression] using certified
    | unwind => cases machineEq
  have raw := RawStep.startCleanup action value closed runtimeScope tail
  have checks : AccessChecks ⟨value, runtimeScope, .push (.armed action) tail⟩ ambient := by
    constructor
    · intro identity payload answer savedScope current returned rest same returnedClosed
      cases same
    · intro requested operation operand current stack cap outside handler same cut operandClosed
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
    · intro binder owner current caller input answer front cap outside plan same resolve built
      have impossible := congrArg Configuration.expression same
      change value = _ at impossible
      have isValue := closed.1
      rw [impossible] at isValue
      exact False.elim isValue
  obtain ⟨event, ledger, registry, resources⟩ :=
    LexicalUnwind.value_step_ledger_resources raw closed.1 checks state.ledger state.registry state.resources
  refine ⟨event, nextSource, ?_, ?_, state.storeAnnotation, ledger, registry, resources, ?_, state.issuedResources, event.ticket_history state.ticketHistory, state.captureMetadata⟩
  · intro key body member
    cases state.resumeRecords key body member with
    | resume located known recorded source answer =>
      cases located with | push rest => exact .resume (.push rest) known recorded source answer
  · intro key body member
    cases state.unwindRecords key body member with
    | dispose located held recorded source =>
      cases located with | push rest => exact .dispose (.push rest) held recorded source
  · exact state.activations

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableState.start_normal_cleanup

