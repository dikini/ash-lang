/- Source and static certification share an actual plan witness. Execution
capabilities stay in the independent lexical Local/Pending judgments. -/
inductive CertifiedFrame (operations : Operations) (policy : Syntax.TicketPolicy) (contracts : Contracts)
    (tables : CallableProtectionFrames.Tables) (families : Families) (required : SourceContextualRechecking.Required)
    (outward : List Instance) (world : List Nat) :
    ExecFrame → Value → Value → (demand : List Nat) → Requirements demand → (layer : DependencyScope → DependencyScope) → Decoration layer →
      List Instance → List Instance → (evidence : optParam DeclarationEvidence recipeEvidence) → Prop where
  | plain {plan : Plan dependencies}
      (context : Context operations policy contracts world (fun _ => none) allowed plain.scope plain.context input output demand requirements (signature plan))
      (scope : ScopedPorts.EffectScope contracts.erase.erase.ports plain.scope ticket)
      (inputAnnotation : input.erase.erase.port = ScopedPorts.eraseType plain.input)
      (outputAnnotation : output.erase.erase.port = ScopedPorts.eraseType plain.output)
      (checked : Certified (evidence := declarationPolicy) outward world plan) :
      CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world (.plain plain) input output demand requirements (.plain dependencies) (fun rest => .plain rest) allowed allowed
  | handler {plans : ClausePlans handler.clauses (families handler)}
      (scope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports handler.scope)
      (annotation : answer.erase.erase.port = ScopedPorts.eraseType handler.answer)
      (clauses : ScopedPorts.ClausesTyped operations.erase.erase.ports world SourceDependencyAnnotations.Environment.empty.erase.ports handler.effectInst answer.erase.erase.port residual handler.clauses)
      (coverage : ScopedPorts.Covers operations.erase.erase.ports handler.effectInst handler.clauses)
      (unique : (ScopedTyping.clauseKeys handler.clauses).Nodup)
      (declarations : Declarations operations policy contracts world (fun _ => none) residual handler.effectInst answer handler.clauses (tables handler) plans)
      (recipes : evidence (required handler) plans)
      (capabilities : ClausesUse policy handler.clauses)
      (modes : SourceTemplates.ClauseModes handler.clauses (tables handler))
      (certified : CertifiedClauses (evidence := declarationPolicy) outward world plans) :
      CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world (.handler handler) answer answer [] (.request [] [])
        (.handler handler.effectInst (tables handler) (families handler))
        (fun rest => .handler (required handler) rest) (handler.effectInst :: residual) residual
  | cell (scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types caller)
      (noEscape : identity ∉ (ScopedPorts.eraseType answer).resources)
      (annotation : result.erase.erase.port = ScopedPorts.eraseType answer)
      (interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world (.cell identity payload caller answer) incoming outgoing) :
      CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world (.cell identity payload caller answer) result result [] (.request [] []) (.cell identity) (fun rest => .cell rest) incoming outgoing
  | armed {callbackPlan : Plan callbackDep} (scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types action.scope)
      (callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action (.function .unit .unit action.requests latent (signature callbackPlan)))
      (annotation : result.erase.erase.port = ScopedPorts.eraseType action.answer)
      (interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world (.armed action) incoming outgoing)
      (checked : Certified (evidence := declarationPolicy) outward world callbackPlan) :
      CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world (.armed action) result result [] (.request [] (qualify true latent))
        (.cleanup action.requests callbackDep) (fun rest => .cleanup rest) incoming outgoing
  | running {callbackPlan : Plan callbackDep} (scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types action.scope)
      (callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action (.function .unit .unit action.requests latent (signature callbackPlan)))
      (saved : ValueSummary operations policy contracts world (fun _ => none) [] value result)
      (annotation : result.erase.erase.port = ScopedPorts.eraseType action.answer)
      (interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world (.running action value closed) incoming outgoing) :
      CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world (.running action value closed) .unit result [] (.request [] []) .running (fun rest => .running rest) incoming outgoing
  | closing (scopeKnown : ScopedPorts.ScopeKnown contracts.erase.erase.ports.types caller)
      (interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world (.closing identity caller) incoming outgoing) :
      CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world (.closing identity caller) .unit .unit [] (.request [] []) .running (fun rest => .running rest) incoming outgoing
  | retiring (known : contracts owner = some contract)
      (interface : ScopedPorts.EffectFrame operations.erase.erase.ports contracts.erase.erase.ports world (.retiring owner) incoming outgoing) :
      CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world (.retiring owner) .unit .unit [owner] (.retire owner) .running (fun rest => .running rest) incoming outgoing

theorem CertifiedFrame.source
    (frame : CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing) :
    SourcePlannedFrames.Frame (evidence := evidence) operations policy contracts tables families required world entry input output demand requirements layer decorate incoming outgoing := by
  cases frame with
  | plain context scope inputAnnotation outputAnnotation checked => exact .plain context scope inputAnnotation outputAnnotation
  | handler scope annotation clauses coverage unique declarations recipes capabilities modes certified =>
      exact .handler scope annotation clauses coverage unique declarations recipes capabilities modes
  | cell scopeKnown noEscape annotation interface => exact .cell scopeKnown noEscape annotation interface
  | armed scopeKnown callback annotation interface checked => exact .armed scopeKnown callback annotation interface
  | running scopeKnown callback saved annotation interface => exact .running scopeKnown callback saved annotation interface
  | closing scopeKnown interface => exact .closing scopeKnown interface
  | retiring known interface => exact .retiring known interface

inductive PlannedModeValue where
  | value (type : Value)
  | unwind

def PlannedModeValue.mode : PlannedModeValue → LexicalUnwind.UseMode
  | .value _ => .ordinary
  | .unwind => .unwind

/-- Source for one actual frame, at its actual execution mode. Ordinary
frames reuse rich source typing; skipped frames contribute no ordinary work.
Whole-stack request checking remains contextual at the requirement judgment. -/
inductive PlannedModeFrame (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables) (families : Families) (required : SourceContextualRechecking.Required) (outward : List Instance) (world : List Nat) :
    ExecFrame → PlannedModeValue → PlannedModeValue → (demand : List Nat) → Requirements demand →
      (DependencyScope → DependencyScope) → Prop where
  | ordinary (source : CertifiedFrame (evidence := declarationPolicy.accepts outward)
        operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing) :
      PlannedModeFrame operations policy contracts tables families required outward world entry (.value input) (.value output) demand requirements layer
  | unwinding {callbackPlan : Plan dependencies}
      (callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action
        (.function .unit .unit action.requests latent (signature callbackPlan)))
      (certified : Certified (evidence := declarationPolicy) outward world callbackPlan) :
      PlannedModeFrame operations policy contracts tables families required outward world (.unwinding action) (.value .unit) .unwind
        [] (.request [] []) .running
  | closing (scope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller) :
      PlannedModeFrame operations policy contracts tables families required outward world (.closing identity caller) input (.value .unit)
        [] (.request [] []) .running
  | retiring : PlannedModeFrame operations policy contracts tables families required outward world (.retiring owner) input input
        [owner] (.retire owner) .running
  | skipped : PlannedModeFrame operations policy contracts tables families required outward world (.plain data) .unwind .unwind
        [] (.request [] []) (.plain dependencies)
  | handler (source : CertifiedFrame (evidence := declarationPolicy.accepts outward)
        operations policy contracts tables families required outward world (.handler data) answer answer [] (.request [] [])
        (.handler data.effectInst (tables data) (families data)) decorate (data.effectInst :: residual) residual) :
      PlannedModeFrame operations policy contracts tables families required outward world (.handler data) .unwind .unwind
        [] (.request [] []) (.handler data.effectInst (tables data) (families data))
  | cell : PlannedModeFrame operations policy contracts tables families required outward world (.cell identity payload caller answer) .unwind .unwind
        [] (.request [] []) (.cell identity)
  | cleanup {callbackPlan : Plan dependencies}
      (callback : ValueSummary operations policy contracts world (fun _ => none) [] action.action
        (.function .unit .unit action.requests latent (signature callbackPlan)))
      (certified : Certified (evidence := declarationPolicy) outward world callbackPlan) :
      PlannedModeFrame operations policy contracts tables families required outward world (.armed action) .unwind .unwind
        [] (.request [] (qualify true latent)) (.cleanup action.requests dependencies)

/-- Rich source requirements follow the actual return mode. Dormant ordinary
captures retain their checked source; opening an abandoned capture contributes
its cleanup requirements and the owner's retirement. Store certificates and
continuation permissions are separate facets, as in the existing source rules. -/
inductive PlannedModeSource (operations : Operations) (policy : Syntax.TicketPolicy)
    (contracts : Contracts) (tables : CallableProtectionFrames.Tables) (families : Families) (required : SourceContextualRechecking.Required) (outward : List Instance)
    (actions : Syntax.UsageTickets) (world : List Nat) :
    Stack → PlannedModeValue → PlannedModeValue → (demand : List Nat) → Requirements demand → DependencyScope → Prop where
  | nil : PlannedModeSource operations policy contracts tables families required outward actions world .nil input input [] (.request [] []) .nil
  | push (head : PlannedModeFrame operations policy contracts tables families required outward world entry input middle firstDemand first layer)
      (tail : PlannedModeSource operations policy contracts tables families required outward actions world rest middle output tailDemand second restScope) :
      PlannedModeSource operations policy contracts tables families required outward actions world (.push entry rest) input output
        (firstDemand ++ tailDemand) (.sequence (first.prepend (OwnerPhases.ofStack tables rest)) second) (layer restScope)
  | live (known : contracts owner = some contract) (actionKnown : actions owner = some rights)
      (inputAnnotation : contract.input.erase.erase.port = ScopedPorts.eraseType inputType)
      (answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType)
      (callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller)
      (held : contract.held = ProtectionContexts.protectedMode captured.erase)
      (saved : PlannedModeSource operations policy contracts tables families required outward actions world
        captured (.value contract.input) boundary contract.resumeDemand body savedScope)
      (answer : boundary = .value contract.answer ∨ boundary = .unwind)
      (tail : PlannedModeSource operations policy contracts tables families required outward actions world rest boundary output demand requirements restScope) :
      PlannedModeSource operations policy contracts tables families required outward actions world (.live owner inputType answerType captured caller rest)
        (.value contract.answer) output demand (.sequence (.spent owner) requirements) (.live owner savedScope restScope)
  | opening (saved : PlannedModeSource operations policy contracts tables families required outward actions world captured .unwind .unwind savedDemand savedRequirements savedScope)
      (tail : PlannedModeSource operations policy contracts tables families required outward actions world rest .unwind output tailDemand tailRequirements restScope) :
      PlannedModeSource operations policy contracts tables families required outward actions world (.live owner input answer captured caller rest)
        .unwind output (savedDemand ++ ([owner] ++ tailDemand))
        (.sequence (savedRequirements.prepend (OwnerPhases.ofStack tables (.push (.retiring owner) rest)))
          (.sequence (.retire owner) tailRequirements)) (.live owner savedScope restScope)
  | spent (known : contracts owner = some contract)
      (annotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType)
      (callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller)
      (tail : PlannedModeSource operations policy contracts tables families required outward actions world rest (.value contract.answer) output demand requirements restScope) :
      PlannedModeSource operations policy contracts tables families required outward actions world (.spent owner answerType caller rest)
        (.value contract.answer) output demand (.sequence (.spent owner) requirements) (.spent owner restScope)
  | skippedSpent (tail : PlannedModeSource operations policy contracts tables families required outward actions world rest .unwind output demand requirements restScope) :
      PlannedModeSource operations policy contracts tables families required outward actions world (.spent owner answerType caller rest)
        .unwind output demand (.sequence (.spent owner) requirements) (.spent owner restScope)

def PlannedModeValue.erase : PlannedModeValue → SourceDependencyFrames.ModeValue
  | .value ty => .value ty.erase
  | .unwind => .unwind

theorem PlannedModeFrame.erase
    (source : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer) :
    SourceDependencyFrames.ModeSourceFrame operations.erase policy contracts.erase tables families world
      entry input.erase output.erase demand requirements layer := by
  cases source with
  | ordinary source => exact .ordinary source.source.erase
  | unwinding callback certified => exact .unwinding (SourcePlannedSources.expression_erase callback)
  | closing scope => cases input <;> exact .closing scope
  | retiring => cases input <;> exact .retiring
  | skipped => exact .skipped
  | handler source => exact .handler source.source.erase
  | cell => exact .cell
  | cleanup callback certified => exact .cleanup (SourcePlannedSources.expression_erase callback)

theorem PlannedModeSource.erase
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope) :
    SourceDependencyFrames.ModeSource operations.erase policy contracts.erase tables families actions world
      stack input.erase output.erase demand requirements scope := by
  induction source with
  | nil => exact .nil
  | push head tail ih => exact .push head.erase ih
  | live known rights inputAnnotation answerAnnotation caller held saved answer tail ihSaved ihTail =>
      exact .live (SourcePlannedSources.contract_erase_known known) rights inputAnnotation answerAnnotation
        caller held ihSaved (by rcases answer with rfl | rfl; exact .inl rfl; exact .inr rfl) ihTail
  | opening saved tail ihSaved ihTail => exact .opening ihSaved ihTail
  | spent known annotation caller tail ih => exact .spent (SourcePlannedSources.contract_erase_known known) annotation caller ih
  | skippedSpent tail ih => exact .skippedSpent ih

theorem PlannedModeFrame.realizes
    (source : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer) :
    SourceDependencyCapture.Frame tables families layer entry := source.erase.realizes

theorem PlannedModeSource.realizes
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope) :
    SourceDependencyCapture.Realizes tables families scope stack := source.erase.realizes

theorem disposal_prepend (requirements : Requirements demand) (nearer : OwnerPhases.Context) :
    annotateDisposals (requirements.prepend nearer) = (annotateDisposals requirements).prepend nearer := by
  induction requirements with
  | request | retire | spent => rfl
  | invoke key demand context => cases key with | mk owner mode => cases mode <;> rfl
  | sequence first second ihFirst ihSecond => simp only [Requirements.prepend, annotateDisposals, ihFirst, ihSecond]
  | emitAfter body context raw ih => simp only [Requirements.prepend, annotateDisposals, ih]
  | choice first second same ihFirst ihSecond => simp only [Requirements.prepend, annotateDisposals, ihFirst, ihSecond]

/-- The same source append preserves ordinary and generated disposal checks. -/
theorem PlannedModeSource.append_disposals
    (first : PlannedModeSource operations policy contracts tables families required outward actions world front input middle
      firstDemand firstRequirements firstScope)
    (second : PlannedModeSource operations policy contracts tables families required outward actions world tail middle output
      secondDemand secondRequirements secondScope) :
    ∃ combined : Requirements (firstDemand ++ secondDemand),
      PlannedModeSource operations policy contracts tables families required outward actions world (front.append tail) input output
        (firstDemand ++ secondDemand) combined (firstScope.append secondScope) ∧
      (∀ store receiving phases,
        evaluate store receiving phases combined =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals combined) =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  induction first generalizing output secondDemand secondRequirements secondScope tail with
  | nil => exact ⟨secondRequirements, second, by intros; simp only [evaluate_empty, spendAll, merge_empty_left],
      by intros; simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]⟩
  | push head rest ih =>
      obtain ⟨combined, source, evaluation, generatedEvaluation⟩ := ih second
      rw [List.append_assoc]
      have rebuilt := PlannedModeSource.push head source
      rw [← head.realizes.append] at rebuilt
      refine ⟨_, rebuilt, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
        OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
        OwnerPhases.stack_append, List.append_assoc, generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
  | live known rights inputAnnotation answerAnnotation caller held saved answer rest ihSaved ihRest =>
      obtain ⟨combined, source, evaluation, generatedEvaluation⟩ := ihRest second
      refine ⟨_, .live known rights inputAnnotation answerAnnotation caller held saved answer source, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | opening saved rest ihSaved ihRest =>
      obtain ⟨combined, source, evaluation, generatedEvaluation⟩ := ihRest second
      rw [List.append_assoc, List.append_assoc]
      refine ⟨_, .opening saved source, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
        OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, evaluation,
        PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
      · intro store receiving phases
        simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
        OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, generatedEvaluation,
        PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
  | spent known annotation caller rest ih =>
      obtain ⟨combined, source, evaluation, generatedEvaluation⟩ := ih second
      refine ⟨_, .spent known annotation caller source, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
  | skippedSpent rest ih =>
      obtain ⟨combined, source, evaluation, generatedEvaluation⟩ := ih second
      refine ⟨_, .skippedSpent source, ?_, ?_⟩
      · intro store receiving phases
        simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
      · intro store receiving phases
        simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]

/-- Project the ordinary equation from the shared source append proof. -/
theorem PlannedModeSource.append
    (first : PlannedModeSource operations policy contracts tables families required outward actions world front input middle
      firstDemand firstRequirements firstScope)
    (second : PlannedModeSource operations policy contracts tables families required outward actions world tail middle output
      secondDemand secondRequirements secondScope) :
    ∃ combined : Requirements (firstDemand ++ secondDemand),
      PlannedModeSource operations policy contracts tables families required outward actions world (front.append tail) input output
        (firstDemand ++ secondDemand) combined (firstScope.append secondScope) ∧
      ∀ store receiving phases,
        evaluate store receiving phases combined =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements) := by
  obtain ⟨combined, source, evaluation, generatedEvaluation⟩ := first.append_disposals second
  exact ⟨combined, source, evaluation⟩


/-- Split one source witness with both ordinary and generated equations. -/
theorem PlannedModeSource.split_disposals
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append tail) input output demand requirements scope) :
    ∃ (middle : PlannedModeValue) (firstDemand secondDemand : List Nat),
    ∃ firstRequirements : Requirements firstDemand, ∃ secondRequirements : Requirements secondDemand,
    ∃ firstScope secondScope,
      PlannedModeSource operations policy contracts tables families required outward actions world front input middle firstDemand firstRequirements firstScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail middle output secondDemand secondRequirements secondScope ∧
      scope = firstScope.append secondScope ∧ demand = firstDemand ++ secondDemand ∧
      (∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals requirements) =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  induction front generalizing input demand requirements scope with
  | nil =>
      refine ⟨input, [], demand, .request [] [], requirements, .nil, scope, .nil, source, rfl, rfl, ?_, ?_⟩
      · intro store receiving phases
        simp only [evaluate_empty, spendAll, merge_empty_left]
      · intro store receiving phases
        simp only [annotateDisposals, evaluate_empty, spendAll, merge_empty_left]
  | push entry rest ih => cases source with
      | push head remaining =>
          obtain ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
            firstScope, secondScope, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ := ih remaining
          subst sameScope
          refine ⟨middle, _, secondDemand, _, secondRequirements, _, secondScope,
            .push head first, second, head.realizes.append.symm, ?_, ?_, ?_⟩
          · simp only [sameDemand, List.append_assoc]
          · intro store receiving phases
            simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
              OwnerPhases.stack_append, List.append_assoc, evaluation, PhaseRechecking.spendAll_append, merge_assoc]
          · intro store receiving phases
            simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
              OwnerPhases.stack_append, List.append_assoc, generatedEvaluation, PhaseRechecking.spendAll_append, merge_assoc]
  | live owner inputType answerType saved caller rest ihSaved ihRest => cases source with
      | live known rights inputAnnotation answerAnnotation scope held captured answer remaining =>
          obtain ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
            firstScope, secondScope, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ := ihRest remaining
          subst sameScope
          refine ⟨middle, firstDemand, secondDemand, _, secondRequirements, _, secondScope,
            .live known rights inputAnnotation answerAnnotation scope held captured answer first,
            second, rfl, sameDemand, ?_, ?_⟩
          · intro store receiving phases
            simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
          · intro store receiving phases
            simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
      | opening captured remaining =>
          obtain ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
            firstScope, secondScope, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ := ihRest remaining
          subst sameScope
          refine ⟨middle, _, secondDemand, _, secondRequirements, _, secondScope,
            .opening captured first, second, rfl, ?_, ?_, ?_⟩
          · simp only [sameDemand, List.append_assoc]
          · intro store receiving phases
            simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
              OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, evaluation,
              PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
          · intro store receiving phases
            simp only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
              OwnerPhases.stack_append, OwnerPhases.ofStack, List.cons_append, List.append_assoc, generatedEvaluation,
              PhaseRechecking.spendAll_append, merge_assoc, RecursiveClosing.evaluate_retire, spendAll, List.nil_append]
  | spent owner answerType caller rest ih => cases source with
      | spent known annotation scope remaining =>
          obtain ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
            firstScope, secondScope, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ := ih remaining
          subst sameScope
          refine ⟨middle, firstDemand, secondDemand, _, secondRequirements, _, secondScope,
            .spent known annotation scope first, second, rfl, sameDemand, ?_, ?_⟩
          · intro store receiving phases
            simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
          · intro store receiving phases
            simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]
      | skippedSpent remaining =>
          obtain ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
            firstScope, secondScope, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ := ih remaining
          subst sameScope
          refine ⟨middle, firstDemand, secondDemand, _, secondRequirements, _, secondScope,
            .skippedSpent first, second, rfl, sameDemand, ?_, ?_⟩
          · intro store receiving phases
            simp only [RecursiveRequirements.evaluate_sequence, evaluate_spent, evaluation, spendAll, merge_assoc]
          · intro store receiving phases
            simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence, evaluate_spent, generatedEvaluation, spendAll, merge_assoc]

/-- Preserve the ordinary split interface by projection. -/
theorem PlannedModeSource.split
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (front.append tail) input output demand requirements scope) :
    ∃ (middle : PlannedModeValue) (firstDemand secondDemand : List Nat),
    ∃ firstRequirements : Requirements firstDemand, ∃ secondRequirements : Requirements secondDemand,
    ∃ firstScope secondScope,
      PlannedModeSource operations policy contracts tables families required outward actions world front input middle firstDemand firstRequirements firstScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail middle output secondDemand secondRequirements secondScope ∧
      scope = firstScope.append secondScope ∧ demand = firstDemand ++ secondDemand ∧
      ∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements) := by
  obtain ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ := source.split_disposals
  exact ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, first, second, sameScope, sameDemand, evaluation⟩

/-- At a terminal handler cut the retained result boundary is either that
handler's rich answer or abandonment. The handler declaration is the witness
stored in the same source derivation. -/
theorem PlannedModeSource.handler_result {handler : HandlerData}
    (cut : HandlerCut requested whole captured tail handler)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world whole input output demand requirements scope)
    (empty : tail = .nil) :
    ∃ (answer : Value) (residual : List Instance), ∃ decorate,
      CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world (.handler handler) answer answer [] (.request [] [])
        (.handler handler.effectInst (tables handler) (families handler)) decorate (handler.effectInst :: residual) residual ∧
      (output = .value answer ∨ output = .unwind) := by
  induction cut generalizing input demand requirements scope with
  | hit handler tail same =>
      subst tail
      cases source with
      | push head rest =>
          cases rest
          cases head with
          | ordinary frame => cases frame with
              | handler caller annotation clauses coverage unique declarations recipes capabilities modes certified =>
                  exact ⟨_, _, _, .handler caller annotation clauses coverage unique declarations recipes capabilities modes certified, .inl rfl⟩
          | handler frame => exact ⟨_, _, _, frame, .inr rfl⟩
  | push frame rest captured tail handler miss next ih => cases source with
      | push head remaining => exact ih remaining empty
  | live owner inputType answerType saved caller rest captured tail handler next ih => cases source with
      | live known rights inputAnnotation answerAnnotation caller held saved answer remaining => exact ih remaining empty
      | opening saved remaining => exact ih remaining empty
  | spent owner answerType caller rest captured tail handler next ih => cases source with
      | spent known annotation caller remaining => exact ih remaining empty
      | skippedSpent remaining => exact ih remaining empty

/-- Handler capture follows the same split, even when the captured fragment
contains an unwind-return marker. No ordinary requirements are imposed on its
abandoned suffix. -/
theorem PlannedModeSource.handler_cut_disposals
    (cut : HandlerCut requested whole captured tail handler)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world whole input output demand requirements scope) :
    ∃ (answer : Value) (residual : List Instance) (middle : PlannedModeValue) (firstDemand secondDemand : List Nat),
    ∃ firstRequirements : Requirements firstDemand, ∃ secondRequirements : Requirements secondDemand,
    ∃ firstScope secondScope decorate,
      CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world (.handler handler) answer answer [] (.request [] [])
        (.handler handler.effectInst (tables handler) (families handler)) decorate (handler.effectInst :: residual) residual ∧
      (middle = .value answer ∨ middle = .unwind) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured input middle firstDemand firstRequirements firstScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail middle output secondDemand secondRequirements secondScope ∧
      scope = firstScope.append secondScope ∧ demand = firstDemand ++ secondDemand ∧
      (∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements)) ∧
      ∀ store receiving phases,
        evaluate store receiving phases (annotateDisposals requirements) =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll phases firstDemand) (annotateDisposals secondRequirements)) := by
  rw [handler_cut_reconstructs cut] at source
  obtain ⟨middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ := source.split_disposals
  have selected : HandlerCut requested captured captured .nil handler := by
    clear source first second evaluation generatedEvaluation
    induction cut with
    | hit handler tail same => exact .hit handler .nil same
    | push frame rest cap tail handler miss next ih => exact .push frame cap cap .nil handler miss ih
    | live ticket q a saved scope rest cap tail handler next ih => exact .live ticket q a saved scope cap cap .nil handler ih
    | spent ticket a scope rest cap tail handler next ih => exact .spent ticket a scope cap cap .nil handler ih
  obtain ⟨answer, residual, decorate, declaration, boundary⟩ := first.handler_result selected rfl
  exact ⟨answer, residual, middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, decorate, declaration, boundary, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩

/-- Preserve the ordinary handler-cut interface by projection. -/
theorem PlannedModeSource.handler_cut
    (cut : HandlerCut requested whole captured tail handler)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world whole input output demand requirements scope) :
    ∃ (answer : Value) (residual : List Instance) (middle : PlannedModeValue) (firstDemand secondDemand : List Nat),
    ∃ firstRequirements : Requirements firstDemand, ∃ secondRequirements : Requirements secondDemand,
    ∃ firstScope secondScope decorate,
      CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world (.handler handler) answer answer [] (.request [] [])
        (.handler handler.effectInst (tables handler) (families handler)) decorate (handler.effectInst :: residual) residual ∧
      (middle = .value answer ∨ middle = .unwind) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured input middle firstDemand firstRequirements firstScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail middle output secondDemand secondRequirements secondScope ∧
      scope = firstScope.append secondScope ∧ demand = firstDemand ++ secondDemand ∧
      ∀ store receiving phases,
        evaluate store receiving phases requirements =
          merge (evaluate store (OwnerPhases.ofStack tables tail ++ receiving) phases firstRequirements)
            (evaluate store receiving (spendAll phases firstDemand) secondRequirements) := by
  obtain ⟨answer, residual, middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, decorate, declaration, boundary, first, second, sameScope, sameDemand, evaluation, generatedEvaluation⟩ :=
    source.handler_cut_disposals cut
  exact ⟨answer, residual, middle, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstScope, secondScope, decorate, declaration, boundary, first, second, sameScope, sameDemand, evaluation⟩

/-- Abandonment keeps planned handler and callback witnesses while skipping
ordinary code. The paired old cleanup source reuses its ownership theorem. -/
theorem PlannedModeSource.unwind_source_evaluation
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope)
    (scopes : LexicalUnwind.UnwindPrefix stack) :
    ∃ closeDemand, ∃ closeRequirements : Requirements closeDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world stack .unwind .unwind closeDemand closeRequirements scope ∧
      ∃ oldRequirements : Requirements closeDemand,
        SourceDependencyFrames.UnwindSource operations.erase policy contracts.erase tables families world stack closeDemand oldRequirements scope ∧
      ∀ store receiving phases, evaluate store receiving phases closeRequirements = evaluate store receiving phases oldRequirements := by
  induction scopes generalizing input output demand requirements scope with
  | nil => cases source; exact ⟨_, _, .nil, _, .nil, by intros; rfl⟩
  | plain next ih => cases source with | push head tail => cases head with
      | ordinary frame => cases frame with
          | plain context caller inputAnnotation outputAnnotation certified =>
              obtain ⟨_, _, source, _, old, same⟩ := ih tail
              refine ⟨_, _, .push .skipped source, _, .plain old, ?_⟩
              intro store receiving phases
              simp only [RecursiveRequirements.evaluate_sequence,
                RecursiveRecomposition.evaluate_empty, OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
                Requirements.prepend, List.nil_append, same]
      | skipped =>
          obtain ⟨_, _, source, _, old, same⟩ := ih tail
          refine ⟨_, _, .push .skipped source, _, .plain old, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence,
            RecursiveRecomposition.evaluate_empty, OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
            Requirements.prepend, List.nil_append, same]
  | handler next ih => cases source with | push head tail => cases head with
      | ordinary frame => cases frame with
          | handler caller annotation clauses coverage unique declarations recipes capabilities modes certified =>
              obtain ⟨_, _, source, _, old, same⟩ := ih tail
              have frame := CertifiedFrame.handler caller annotation clauses coverage unique declarations recipes capabilities modes certified
              refine ⟨_, _, .push (.handler frame) source, _, .handler frame.source.erase old, ?_⟩
              intro store receiving phases
              simp only [RecursiveRequirements.evaluate_sequence,
                RecursiveRecomposition.evaluate_empty, OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
                Requirements.prepend, List.nil_append, same]
      | handler frame =>
          obtain ⟨_, _, source, _, old, same⟩ := ih tail
          refine ⟨_, _, .push (.handler frame) source, _, .handler frame.source.erase old, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence,
            RecursiveRecomposition.evaluate_empty, OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
            Requirements.prepend, List.nil_append, same]
  | cell next ih => cases source with | push head tail => cases head with
      | ordinary frame => cases frame with
          | cell caller excluded annotation interface =>
              obtain ⟨_, _, source, _, old, same⟩ := ih tail
              refine ⟨_, _, .push .cell source, _, .cell old, ?_⟩
              intro store receiving phases
              simp only [RecursiveRequirements.evaluate_sequence,
                RecursiveRecomposition.evaluate_empty, OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
                Requirements.prepend, List.nil_append, same]
      | cell =>
          obtain ⟨_, _, source, _, old, same⟩ := ih tail
          refine ⟨_, _, .push .cell source, _, .cell old, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence,
            RecursiveRecomposition.evaluate_empty, OwnerPhaseTransitions.spendAll, RecursiveRecomposition.merge_empty_left,
            Requirements.prepend, List.nil_append, same]
  | armed next ih => cases source with | push head tail => cases head with
      | ordinary frame => cases frame with
          | armed caller callback annotation interface certified =>
              obtain ⟨_, _, source, _, old, same⟩ := ih tail
              refine ⟨_, _, .push (.cleanup callback certified) source, _,
                .cleanup (SourcePlannedSources.expression_erase callback) old, ?_⟩
              intro store receiving phases
              simp only [RecursiveRequirements.evaluate_sequence,
                OwnerPhaseTransitions.spendAll,
                Requirements.prepend, List.nil_append, same]
      | cleanup callback certified =>
          obtain ⟨_, _, source, _, old, same⟩ := ih tail
          refine ⟨_, _, .push (.cleanup callback certified) source, _,
            .cleanup (SourcePlannedSources.expression_erase callback) old, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence,
            OwnerPhaseTransitions.spendAll,
            Requirements.prepend, List.nil_append, same]
  | retiring next ih => cases source with | push head tail => cases head with
      | ordinary frame => cases frame with
          | retiring known interface =>
              obtain ⟨_, _, source, _, old, same⟩ := ih tail
              refine ⟨_, _, .push .retiring source, _, .retiring old, ?_⟩
              intro store receiving phases
              simp only [RecursiveRequirements.evaluate_sequence,
                OwnerPhaseTransitions.spendAll,
                Requirements.prepend, RecursiveClosing.evaluate_retire, same]
      | retiring =>
          obtain ⟨_, _, source, _, old, same⟩ := ih tail
          refine ⟨_, _, .push .retiring source, _, .retiring old, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence,
            OwnerPhaseTransitions.spendAll,
            Requirements.prepend, RecursiveClosing.evaluate_retire, same]
  | live inside outside ihInside ihOutside => cases source with
      | live known rights inputAnnotation answerAnnotation caller held saved answer tail =>
          obtain ⟨_, _, first, _, oldFirst, sameFirst⟩ := ihInside saved
          obtain ⟨_, _, second, _, oldSecond, sameSecond⟩ := ihOutside tail
          refine ⟨_, _, .opening first second, _, .live oldFirst oldSecond, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhaseTransitions.spendAll,
            RecursiveClosing.evaluate_retire, sameFirst, sameSecond]
      | opening saved tail =>
          obtain ⟨_, _, first, _, oldFirst, sameFirst⟩ := ihInside saved
          obtain ⟨_, _, second, _, oldSecond, sameSecond⟩ := ihOutside tail
          refine ⟨_, _, .opening first second, _, .live oldFirst oldSecond, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            OwnerPhaseTransitions.spendAll,
            RecursiveClosing.evaluate_retire, sameFirst, sameSecond]
  | spent next ih => cases source with
      | spent known annotation caller tail =>
          obtain ⟨_, _, source, _, old, same⟩ := ih tail
          refine ⟨_, _, .skippedSpent source, _, .spent old, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence,
            OwnerPhaseTransitions.spendAll,
            same]
      | skippedSpent tail =>
          obtain ⟨_, _, source, _, old, same⟩ := ih tail
          refine ⟨_, _, .skippedSpent source, _, .spent old, ?_⟩
          intro store receiving phases
          simp only [RecursiveRequirements.evaluate_sequence,
            OwnerPhaseTransitions.spendAll,
            same]

theorem PlannedModeSource.unwind_source
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope)
    (scopes : LexicalUnwind.UnwindPrefix stack) :
    ∃ closeDemand, ∃ closeRequirements : Requirements closeDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world stack .unwind .unwind closeDemand closeRequirements scope ∧
      ∃ oldRequirements : Requirements closeDemand,
        SourceDependencyFrames.UnwindSource operations.erase policy contracts.erase tables families world stack closeDemand oldRequirements scope := by
  obtain ⟨demand, requirements, planned, oldRequirements, old, evaluation⟩ := source.unwind_source_evaluation scopes
  exact ⟨demand, requirements, planned, oldRequirements, old⟩

theorem PlannedModeSource.unwind_reentry
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope)
    (scopes : LexicalUnwind.UnwindPrefix stack) (balance : demand.Perm (ownedTickets stack)) :
    ∃ closeDemand, ∃ closeRequirements : Requirements closeDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world stack .unwind .unwind closeDemand closeRequirements scope ∧
      closeDemand.Perm demand := by
  obtain ⟨_, _, cleanup, _, old⟩ := source.unwind_source scopes
  exact ⟨_, _, cleanup, old.template.ownership.trans balance.symm⟩

theorem PlannedModeSource.reentry_from_bounds
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value answer) (.value answer) frontDemand frontRequirements frontScope)
    (returns : boundary = .value answer ∨ boundary = .unwind)
    (frontUse : LexicalUnwind.StackUse policy actions front .ordinary .ordinary frontUseDemand)
    (aligned : frontDemand.Perm frontUseDemand)
    (savedUse : LexicalUnwind.StackUse policy actions captured .ordinary boundary.mode captureDemand)
    (tailUse : LexicalUnwind.StackUse policy actions tail boundary.mode finalMode tailDemand)
    (bounds : LexicalUnwind.ReentryBounds front captured tail boundary.mode)
    (balance : (frontUseDemand ++ captureDemand ++ tailDemand).Perm
      (ownedTickets front ++ ownedTickets captured ++ ownedTickets tail))
    (unique : (ownedTickets front ++ ownedTickets captured ++ ownedTickets tail).Nodup) :
    ∃ restoredDemand, ∃ restoredRequirements : Requirements restoredDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world front boundary boundary
        restoredDemand restoredRequirements frontScope ∧ restoredDemand.Perm frontDemand := by
  rcases returns with rfl | rfl
  · exact ⟨frontDemand, frontRequirements, source, .refl _⟩
  · have balanced := LexicalUnwind.reentry_unwind_balance frontUse savedUse tailUse bounds balance unique
    cases bounds with
    | unwind scopes inside saved outside =>
        obtain ⟨demand, requirements, cleanup, same⟩ := source.unwind_reentry scopes (aligned.trans balanced)
        exact ⟨demand, requirements, cleanup, same⟩

/-- Recompose the actual saved continuation, caller fragment and spent owner.
The caller fragment is derived at the captured return mode, including the
unwind case. Requirement checking of its cleanup effects is separate. -/
theorem PlannedModeSource.resume_recomposition
    (known : contracts owner = some contract)
    (answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType)
    (callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller)
    (saved : PlannedModeSource operations policy contracts tables families required outward actions world
      captured (.value contract.input) boundary captureDemand captureRequirements capturedScope)
    (frontSource : PlannedModeSource operations policy contracts tables families required outward actions world
      front (.value contract.answer) (.value contract.answer) frontDemand frontRequirements frontScope)
    (tailSource : PlannedModeSource operations policy contracts tables families required outward actions world
      tail boundary output tailDemand tailRequirements tailScope)
    (returns : boundary = .value contract.answer ∨ boundary = .unwind)
    (frontUse : LexicalUnwind.StackUse policy actions front .ordinary .ordinary frontUseDemand)
    (savedUse : LexicalUnwind.StackUse policy actions captured .ordinary boundary.mode captureUseDemand)
    (tailUse : LexicalUnwind.StackUse policy actions tail boundary.mode output.mode tailUseDemand)
    (frontAligned : frontDemand.Perm frontUseDemand)
    (savedAligned : captureDemand.Perm captureUseDemand)
    (tailAligned : tailDemand.Perm tailUseDemand)
    (bounds : LexicalUnwind.ReentryBounds front captured tail boundary.mode)
    (balance : (frontUseDemand ++ captureUseDemand ++ tailUseDemand).Perm
      (ownedTickets front ++ ownedTickets captured ++ ownedTickets tail))
    (unique : (ownedTickets front ++ ownedTickets captured ++ ownedTickets tail).Nodup) :
    ∃ demand, ∃ requirements : Requirements demand,
      PlannedModeSource operations policy contracts tables families required outward actions world
        (captured.append (front.append (.spent owner answerType caller tail)))
        (.value contract.input) output demand requirements
        (capturedScope.append (frontScope.append (.spent owner tailScope))) ∧
      demand.Perm (captureDemand ++ frontDemand ++ tailDemand) ∧
      demand.Perm (ownedTickets (captured.append (front.append (.spent owner answerType caller tail)))) := by
  obtain ⟨restoredDemand, restoredRequirements, restored, same⟩ :=
    frontSource.reentry_from_bounds returns frontUse frontAligned savedUse tailUse bounds balance unique
  have waiting : ∃ next : Requirements tailDemand,
      PlannedModeSource operations policy contracts tables families required outward actions world
        (.spent owner answerType caller tail) boundary output tailDemand next (.spent owner tailScope) := by
    rcases returns with rfl | rfl
    · exact ⟨_, .spent known answerAnnotation callerScope tailSource⟩
    · exact ⟨_, .skippedSpent tailSource⟩
  obtain ⟨waitingRequirements, waiting⟩ := waiting
  obtain ⟨callerRequirements, callerSource, _⟩ := restored.append waiting
  obtain ⟨requirements, result, _⟩ := saved.append callerSource
  have demandSame : (captureDemand ++ (restoredDemand ++ tailDemand)).Perm
      (captureDemand ++ frontDemand ++ tailDemand) := by
    simpa only [List.append_assoc] using (same.append_right tailDemand).append_left captureDemand
  have sourceBalance : (frontDemand ++ captureDemand ++ tailDemand).Perm
      (ownedTickets front ++ ownedTickets captured ++ ownedTickets tail) :=
    ((frontAligned.append savedAligned).append tailAligned).trans balance
  have exchanged : (captureDemand ++ frontDemand ++ tailDemand).Perm
      (ownedTickets captured ++ ownedTickets front ++ ownedTickets tail) :=
    ((List.perm_append_comm (l₁ := captureDemand) (l₂ := frontDemand)).append_right tailDemand).trans
      (sourceBalance.trans ((List.perm_append_comm (l₁ := ownedTickets front)
        (l₂ := ownedTickets captured)).append_right (ownedTickets tail)))
  refine ⟨_, requirements, result, demandSame, ?_⟩
  simpa only [owned_tickets_append, ownedTickets, List.append_assoc] using demandSame.trans exchanged
open SourcePlannedCheckedFrames (erased_extension context_extension declarations_extension)
open SourcePlannedSources (expression_extension)

theorem CertifiedFrame.transport
    (frame : CertifiedFrame (evidence := evidence) operations policy contracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing)
    (extension : contracts.Extends nextContracts) :
    CertifiedFrame (evidence := evidence) operations policy nextContracts tables families required outward world entry input output demand requirements layer decorate incoming outgoing := by
  have ports := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension (erased_extension extension))
  have types := ScopedPorts.effect_extension_has_type_extension ports
  cases frame with
  | plain context scope inputAnnotation outputAnnotation checked =>
      exact .plain (context_extension context extension) (ScopedPorts.effect_scope_extension scope ports)
        inputAnnotation outputAnnotation checked
  | handler scope annotation clauses coverage unique declarations recipes capabilities modes certified =>
      exact .handler (ScopedPorts.effect_scope_known_extension scope ports) annotation clauses coverage unique
        (declarations_extension declarations extension) recipes capabilities modes certified
  | cell scope noEscape annotation interface =>
      exact .cell (ScopedPorts.scope_known_extension scope types) noEscape annotation (ScopedPorts.effect_frame_extension interface ports)
  | armed scope callback annotation interface checked =>
      exact .armed (ScopedPorts.scope_known_extension scope types) (expression_extension callback extension) annotation
        (ScopedPorts.effect_frame_extension interface ports) checked
  | running scope callback saved annotation interface =>
      exact .running (ScopedPorts.scope_known_extension scope types) (expression_extension callback extension)
        (expression_extension saved extension) annotation (ScopedPorts.effect_frame_extension interface ports)
  | closing scope interface =>
      exact .closing (ScopedPorts.scope_known_extension scope types) (ScopedPorts.effect_frame_extension interface ports)
  | retiring known interface => exact .retiring (extension _ _ known) (ScopedPorts.effect_frame_extension interface ports)

theorem PlannedModeFrame.transport
    (source : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer)
    (extension : contracts.Extends nextContracts) :
    PlannedModeFrame operations policy nextContracts tables families required outward world entry input output demand requirements layer := by
  have ports := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension (erased_extension extension))
  cases source with
  | ordinary frame => exact .ordinary (frame.transport extension)
  | unwinding callback certified => exact .unwinding (expression_extension callback extension) certified
  | closing scope => exact .closing (ScopedPorts.effect_scope_known_extension scope ports)
  | retiring => exact .retiring
  | skipped => exact .skipped
  | handler frame => exact .handler (frame.transport extension)
  | cell => exact .cell
  | cleanup callback certified => exact .cleanup (expression_extension callback extension) certified

theorem PlannedModeSource.transport
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope)
    (extension : contracts.Extends nextContracts) (permissions : Syntax.UsageExtension actions nextActions) :
    PlannedModeSource operations policy nextContracts tables families required outward nextActions world stack input output demand requirements scope := by
  have ports := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension (erased_extension extension))
  induction source with
  | nil => exact .nil
  | push head tail ih => exact .push (head.transport extension) ih
  | live known rights inputAnnotation answerAnnotation caller held saved answer tail ihSaved ihTail =>
      exact .live (extension _ _ known) (permissions _ _ rights) inputAnnotation answerAnnotation
        (ScopedPorts.effect_scope_known_extension caller ports) held ihSaved answer ihTail
  | opening saved tail ihSaved ihTail => exact .opening ihSaved ihTail
  | spent known annotation caller tail ih =>
      exact .spent (extension _ _ known) annotation (ScopedPorts.effect_scope_known_extension caller ports) ih
  | skippedSpent tail ih => exact .skippedSpent ih

/-- Capture retains the typed and certified saved source at the very contract
chosen by allocation. The ordinary and unwind return boundaries are both kept. -/
theorem PlannedModeSource.capture_retention
    (cut : HandlerCut requested whole captured tail handler)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world whole
      (.value input) output demand requirements scope) :
    ∃ (answer : Value) (residual : List Instance) (boundary : PlannedModeValue) (capDemand tailDemand : List Nat),
    ∃ capReq : Requirements capDemand, ∃ tailReq : Requirements tailDemand,
    ∃ capScope tailScope decorate,
      CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world
        (.handler handler) answer answer [] (.request [] [])
        (.handler handler.effectInst (tables handler) (families handler)) decorate (handler.effectInst :: residual) residual ∧
      scope = capScope.append tailScope ∧ demand = capDemand ++ tailDemand ∧
      (boundary = .value answer ∨ boundary = .unwind) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world captured
        (.value input) boundary capDemand capReq capScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world tail
        boundary output tailDemand tailReq tailScope ∧
      ∀ owner (contract : SourcePlannedTyping.Contract) rights,
        contracts owner = none → actions owner = none →
        contract.input = input → contract.answer = answer → contract.resumeDemand = capDemand → contract.held = capScope.held →
        PlannedModeSource operations policy (contracts.insert owner contract) tables families required outward
          (actions.insert owner rights) world
          (.live owner (ScopedPorts.embedPort input.erase.erase.port) handler.answer captured handler.scope tail)
          (.value answer) output tailDemand (.sequence (.spent owner) tailReq) (.live owner capScope tailScope) := by
  obtain ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    decorate, declaration, returns, saved, waiting, scopeSame, demandSame, evaluation⟩ := source.handler_cut cut
  refine ⟨answer, residual, boundary, capDemand, tailDemand, capReq, tailReq, capScope, tailScope,
    decorate, declaration, scopeSame, demandSame, returns, saved, waiting, ?_⟩
  intro owner contract rights fresh freshAction inputSame answerSame demandSame heldSame
  have extension := SourcePlannedTyping.insert_extends (contract := contract) contracts fresh
  have permissions := Syntax.fresh_usage_insert_extends (rights := rights) freshAction
  have ports := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension (erased_extension extension))
  have known : (contracts.insert owner contract) owner = some contract := by simp [SourcePlannedTyping.Contracts.insert]
  have actionKnown : (actions.insert owner rights) owner = some rights := by simp [Syntax.UsageTickets.insert]
  cases declaration with
  | handler caller annotation clauses coverage unique declarations recipes capabilities modes certified =>
    subst inputSame
    subst answerSame
    subst demandSame
    exact .live known actionKnown (ScopedPorts.erase_embed_port _).symm annotation
      (ScopedPorts.effect_scope_known_extension caller ports) (heldSame.trans saved.realizes.held)
      (saved.transport extension permissions) returns (waiting.transport extension permissions)
/-- Installed structural declarations come from the retained source frames,
including dormant captures; they are not an independent global assumption. -/
theorem PlannedModeFrame.installed_declarations
    (source : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer) :
    ∀ installed ∈ SourceContextualRechecking.frameHandlers entry,
      ClauseDeclarations outward installed.clauses (families installed) (required installed) := by
  intro installed member
  cases source with
  | ordinary frame => cases frame with
      | handler caller annotation clauses coverage unique declarations recipes capabilities modes certified =>
          have same := List.mem_singleton.mp member
          subst installed
          exact recipes
      | plain | cell | armed | running | closing | retiring => cases member
  | handler frame => cases frame with
      | handler caller annotation clauses coverage unique declarations recipes capabilities modes certified =>
          have same := List.mem_singleton.mp member
          subst installed
          exact recipes
  | unwinding | closing | retiring | skipped | cell | cleanup => cases member

theorem PlannedModeSource.installed_declarations
    (source : PlannedModeSource operations policy contracts tables families required outward actions world stack input output demand requirements scope) :
    ∀ installed ∈ SourceContextualRechecking.handlers stack,
      ClauseDeclarations outward installed.clauses (families installed) (required installed) := by
  induction source with
  | nil => intro installed member; cases member
  | push head tail ih =>
      intro installed member
      rcases List.mem_append.mp member with first | rest
      · exact head.installed_declarations installed first
      · exact ih installed rest
  | live known rights inputAnnotation answerAnnotation caller held saved answer tail ihSaved ihTail
  | opening saved tail ihSaved ihTail =>
      intro installed member
      rcases List.mem_append.mp member with first | rest
      · exact ihSaved installed first
      · exact ihTail installed rest
  | spent known annotation caller tail ih | skippedSpent tail ih => exact ih

