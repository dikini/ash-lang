/-- Certification follows the same literal clause plan selected by source
lookup, including its chosen ordinary/protected mode. -/
theorem selected_plan_certified [evidence : SourcePlannedChecks.DeclarationPolicy]
    {declarations : ClausePlans clauses families} {family : Nat → Dependencies} {plans : ∀ owner, Plan (family owner)}
    (selected : Selected operation held declarations parameter binder code plans)
    (checked : CertifiedClauses outward world declarations) :
    ∀ owner, Certified outward world (plans owner) := by
  induction selected with
  | ordinary => cases checked with
    | cons ordinary protectedMode rest => cases ordinary with
      | available bodies => exact bodies
  | protectedMode => cases checked with
    | cons ordinary protectedMode rest => cases protectedMode with
      | available bodies => exact bodies
  | pass different next ih => cases checked with
    | cons ordinary protectedMode rest => exact ih rest

/-- The actual lexical capture retains certification for nested declarations
at the exact source plan, after substituting a possibly higher-order payload.
Allocation may instantiate this result with its chosen contract; the proof does
not use the historical scheduled Local/Pending judgments or a closing plan. -/
theorem capture_certified_source {hints : ReturnHints wholeScope}
    {plans : ClausePlans handler.clauses (families handler)}
    (cut : HandlerCut requested whole capture tail handler)
    (matching : ReturnHints.Matches tables families hints whole)
    (retained : Pending outward actions (available (ownedTickets whole)) world hints .nil .ordinary finalMode)
    (request : Local outward actions (available (ownedTickets whole)) world (.request requested operation) hints)
    (recipes : ∀ installed ∈ handlers whole,
      ClauseDeclarations outward installed.clauses (families installed) (required installed))
    (finite : checkForest required whole wholeScope .nil = true)
    (source : SourcePlannedSources.Declarations operations policy contracts world (fun _ => none)
      allowed handler.effectInst answer handler.clauses (tables handler) plans)
    (certified : CertifiedClauses (evidence := declarationPolicy) outward world plans)
    (modes : SourceTemplates.ClauseModes handler.clauses (tables handler))
    (selected : ClauseAt operation handler.clauses parameter binder code)
    (offeredKnown : lookup operation (tables handler) = some offered)
    (rowAvailable : offered.row (ProtectionContexts.protectedMode capture.erase) = some row)
    (fresh : actions owner = none) (absent : owner ∉ ownedTickets whole)
    (unique : (ownedTickets whole).Nodup)
    (operationKnown : operations handler.effectInst operation = some (argument, input))
    (payload : SourcePlannedSources.ValueSummary operations policy contracts world (fun _ => none)
      payloadAllowed operand argument)
    (closed : ClosedValue operand) :
    let next := Stack.live owner (ScopedPorts.embedPort input.erase.erase.port) handler.answer capture handler.scope tail
    ∃ capturedScope tailScope, ∃ (saved : ReturnHints capturedScope) (waiting : ReturnHints tailScope),
    ∃ resumeEffects closeEffects, ∃ (family : Nat → Dependencies) (bodies : ∀ owner, Plan (family owner)),
      wholeScope = capturedScope.append tailScope ∧
      Selected operation capturedScope.held plans parameter binder code bodies ∧
      (lookupDependencies operation (families handler)).bind (modeDependencies capturedScope.held) = some family ∧
      ReturnHints.Matches tables families (.live (owner := owner) saved waiting) next ∧
      Certified (evidence := declarationPolicy) outward world (bodies owner) ∧
      Local outward (actions.insert owner code.requiredActions) (available (ownedTickets next)) world
        (family owner) (.live (owner := owner) saved waiting) ∧
      Pending outward (actions.insert owner code.requiredActions) (available (ownedTickets next)) world
        (.live (owner := owner) saved waiting) .nil .ordinary finalMode ∧
      checkForest required next (.live owner capturedScope tailScope) .nil = true ∧
      (∀ installed ∈ handlers next,
        ClauseDeclarations outward installed.clauses (families installed) (required installed)) ∧
      ownedTickets next = owner :: ownedTickets whole ∧ (ownedTickets next).Nodup ∧
      ∀ (allocated : SourceDependencyAnnotations.Contract), contracts owner = none →
        allocated.input = input.erase → allocated.answer = answer.erase →
        allocated.resumeEffects = resumeEffects → allocated.closeEffects = closeEffects →
        allocated.held = capturedScope.held → allocated.closeDemand.Perm allocated.resumeDemand →
        (SourcePlannedSources.refineContract allocated input answer).erase = allocated ∧
        RawStep ⟨.perform (Instantiation.freezeEffect requested) operation operand, caller, whole⟩
          ⟨code.subst parameter operand, .ticket binder owner, next⟩ [.ticket owner] [] ∧
        SourcePlannedSources.Body operations policy
          (contracts.insert owner (SourcePlannedSources.refineContract allocated input answer)) world allowed (.ticket binder owner)
          (fun _ => none) (code.subst parameter operand) answer ⟨owner, allocated.erase, offered.dispose, row⟩
          (signature (bodies owner)) := by
  dsimp only
  have consumed : available (ownedTickets whole) owner = .consumed := by simp [available, absent]
  obtain ⟨capturedScope, tailScope, saved, waiting, family, scopeSame, familyKnown,
    matched, bodyLocal, pending, nextFinite, nextStored⟩ :=
    capture_declared_clause (input := ScopedPorts.embedPort input.erase.erase.port)
      (answer := handler.answer) (caller := handler.scope)
      cut matching retained request recipes finite modes selected offeredKnown fresh consumed
  have heldSame : capturedScope.held = ProtectionContexts.protectedMode capture.erase := by
    cases matched with
    | live saved tail => exact (ReturnHints.Matches.erases saved).held
  obtain ⟨actualArgument, actualInput, resumeEffects, closeEffects, actualFamily, bodies,
    known, resuming, disposing, chosen, body⟩ :=
    SourcePlannedSelectedSources.selected_body source selected offeredKnown
      (heldSame.symm ▸ rowAvailable)
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj (operationKnown.symm.trans known))
  have sameFamily := Option.some.inj (familyKnown.symm.trans chosen.lookup)
  cases sameFamily
  refine ⟨capturedScope, tailScope, saved, waiting, resumeEffects, closeEffects, _, bodies,
    scopeSame, chosen, familyKnown, matched, selected_plan_certified (evidence := declarationPolicy) chosen certified owner,
    ?_, ?_, nextFinite, nextStored, RecursiveCapture.capture_owned cut, ?_, ?_⟩
  · simpa only [OwnerPhaseTransitions.capture_map cut] using bodyLocal
  · simpa only [OwnerPhaseTransitions.capture_map cut] using pending
  · rw [RecursiveCapture.capture_owned cut]
    exact List.nodup_cons.mpr ⟨absent, unique⟩
  · intro allocated freshContract inputSame answerSame resumeSame closeSame heldSame balance
    let contract := SourcePlannedSources.refineContract allocated input answer
    have exactErasure := SourcePlannedSources.refine_contract_erase inputSame answerSame
    have instantiated := body owner contract freshContract rfl rfl resumeSame closeSame heldSame balance
    have inserted : (contracts.insert owner contract) owner = some contract := by
      simp [SourcePlannedTyping.Contracts.insert]
    obtain ⟨step, _, _, _, substituted⟩ := SourcePlannedCaptureSubstitution.body_step instantiated inserted
      (SourcePlannedCaptureSubstitution.fresh_payload payload closed freshContract) closed cut selected unique absent
    exact ⟨exactErasure, step, by simpa only [contract, exactErasure] using substituted⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
