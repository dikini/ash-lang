/-- A selected clause's finite local binding derives its fresh-owner check
from the predecessor check. The existing ownership theorem then accounts for
every retained owner; cancelling the binder yields the enclosing demand. -/
theorem Accounting.Run.capture_owned
    (cut : Cut effect operation whole captured tail contract modes)
    (body : Accounting.Run world installations rows
      (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail)
      (localRoot : Requirements localDemand))
    (binding : LocalOwner owner .available localRoot (outerRoot : Requirements outerDemand) .consumed)
    (unique : whole.owned.Nodup) (fresh : owner ∉ whole.owned)
    (checked : Checked store receiving (available whole.owned) outerRoot row) :
    Checked store receiving
      (available (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail).owned) localRoot row ∧
      outerDemand.Perm whole.owned := by
  have ordered := cut.local_owned (owner := owner) (resumeDemand := resumeDemand)
  have nextCheck := binding.checked checked
  rw [withPhase_available, ← OwnerPhaseTransitions.available_permutation ordered] at nextCheck
  have nextUnique := ordered.symm.nodup (List.nodup_cons.mpr ⟨fresh, unique⟩)
  have actual := (body.owned nextUnique nextCheck).trans ordered
  exact ⟨nextCheck, List.Perm.cons_inv (binding.demand_discharge.symm.trans actual)⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.capture_owned

