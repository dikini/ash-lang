namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Store Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open SourceDependencyFrames (UnwindTemplate ClosingEffects)

/-- On a source-derived cleanup template, checking the generated capture
alternatives is equivalent to checking the existing normal annotation and the
two lexical callback-effect judgments. Physical ownership supplies retirement
readiness. No path or checked cleanup branch is an input. -/
theorem capture_annotation_generated_iff
    (summary : UnwindTemplate operations policy contracts tables world stack closeDemand closingRequirements)
    (same : resumeDemand.Perm closeDemand)
    (unique : (ownedTickets stack).Nodup)
    (ready : ∀ owner ∈ ownedTickets stack, before owner = .available)
    (annotated : Requirements resumeDemand) :
    (∃ row, Checked (annotateDisposalStore entries) receiving before
      (annotateDisposals (.choice (.choice annotated closingRequirements same)
        (closingRequirements.prepend [.ordinary (.barrier true)]) same)) row ∧ row ⊆ budget) ↔
    (∃ row, Checked (annotateDisposalStore entries) receiving before (annotateDisposals annotated) row ∧ row ⊆ budget) ∧
      ClosingEffects budget receiving before closingRequirements ∧
      ClosingEffects budget ([.ordinary (.barrier true)] ++ receiving) before closingRequirements := by
  have unchanged := (unwind_template_disposals summary).2
  simp only [annotateDisposals, disposal_prepend, unchanged]
  constructor
  · rintro ⟨row, checked, bounded⟩
    cases checked with
    | choice ordinary closed => cases ordinary with
      | choice normal cleanup =>
          obtain ⟨ordinaryBound, closedBound⟩ := List.append_subset.mp bounded
          obtain ⟨normalBound, cleanupBound⟩ := List.append_subset.mp ordinaryBound
          exact ⟨⟨_, normal, normalBound⟩, summary.effects_of_checked cleanup cleanupBound,
            summary.effects_of_checked (RecursiveRequirements.checked_prepend_iff.mp closed) closedBound⟩
  · rintro ⟨⟨normalRow, normal, normalBound⟩, ordinary, guarded⟩
    obtain ⟨cleanupRow, cleanup, cleanupBound⟩ := summary.checked_effects (entries := annotateDisposalStore entries) ordinary unique ready
    obtain ⟨guardedRow, closed, closedBound⟩ := summary.checked_effects (entries := annotateDisposalStore entries) guarded unique ready
    exact ⟨_, .choice (.choice normal (RecursiveRequirements.evaluate_sound cleanup))
      (RecursiveRequirements.checked_prepend_iff.mpr (RecursiveRequirements.evaluate_sound closed)),
      List.append_subset.mpr ⟨List.append_subset.mpr ⟨normalBound, cleanupBound⟩, closedBound⟩⟩

/-- Construct the capture annotation and all three retained paths from source
ownership and local effect evidence. The output remains a generated annotation,
so explicit disposal alternatives in the normal subtree are preserved. -/
theorem capture_annotation_from_effects
    (summary : UnwindTemplate operations policy contracts tables world stack closeDemand closingRequirements)
    (balance : resumeDemand.Perm (ownedTickets stack))
    (unique : (ownedTickets stack).Nodup)
    (ready : ∀ owner ∈ ownedTickets stack, before owner = .available)
    (normal : RowAnnotation (requirements : Requirements resumeDemand) annotated)
    (checked : Checked (annotateDisposalStore entries) receiving before (annotateDisposals annotated) normalRow)
    (bounded : normalRow ⊆ budget)
    (ordinary : ClosingEffects budget receiving before closingRequirements)
    (guarded : ClosingEffects budget ([.ordinary (.barrier true)] ++ receiving) before closingRequirements) :
    ∃ combined : Requirements resumeDemand, ∃ row,
      RowAnnotation requirements (annotateDisposals combined) ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals combined) [] ∧
      RequirementPath closingRequirements (annotateDisposals combined) [] ∧
      RequirementPath (closingRequirements.prepend [.ordinary (.barrier true)]) (annotateDisposals combined) [] ∧
      Checked (annotateDisposalStore entries) receiving before (annotateDisposals combined) row ∧
      row ⊆ budget := by
  have same := balance.trans summary.ownership.symm
  obtain ⟨annotation, closingPath, guardedPath, normalPath⟩ := protected_capture_annotation normal same (closingRequirements := closingRequirements)
  obtain ⟨row, allChecked, allBound⟩ := (capture_annotation_generated_iff summary same unique ready annotated).mpr
    ⟨⟨normalRow, checked, bounded⟩, ordinary, guarded⟩
  refine ⟨_, row, annotated_disposals annotation, disposal_subtree_path normalPath, ?_, ?_, allChecked, allBound⟩
  · simpa only [(unwind_template_disposals summary).2] using disposal_subtree_path closingPath
  · simpa only [disposal_prepend, (unwind_template_disposals summary).2] using disposal_subtree_path guardedPath
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.capture_annotation_generated_iff
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.capture_annotation_from_effects

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CaptureAnnotationExamples
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open SourceDependencyFrames (UnwindTemplate ClosingEffects)
open SourceDependencyFrames.UnwindExamples

/-- Two dormant owners enclose the existing effectful callback and its lexical
handlers. Abandonment visits the inner capture before retiring its owners. -/
def nestedStack : Stack :=
  .live 7 .unit .unit (.live 8 .unit .unit InitialCleanupRouteGap.capture .none .nil) .none .nil

def innerRequirements : Requirements [8] :=
  .sequence (closingRequirements.prepend (OwnerPhases.ofStack tables (.push (.retiring 8) .nil)))
    (.sequence (.retire 8) (.request [] []))

def nestedRequirements : Requirements [8, 7] :=
  .sequence (innerRequirements.prepend (OwnerPhases.ofStack tables (.push (.retiring 7) .nil)))
    (.sequence (.retire 7) (.request [] []))

theorem nested_summary : UnwindTemplate richOperations InitialCleanupRouteGap.policy richContracts tables []
    nestedStack [8, 7] nestedRequirements :=
  .live (.live retained_handler_summary .nil) .nil

/-- The generated annotation is constructed without an empty-demand condition,
a supplied cleanup path, or a supplied generated target check. -/
theorem nested_capture_admitted :
    ∃ combined : Requirements [8, 7], ∃ row,
      RowAnnotation nestedRequirements (annotateDisposals combined) ∧
      RequirementPath nestedRequirements (annotateDisposals combined) [] ∧
      RequirementPath (nestedRequirements.prepend [.ordinary (.barrier true)]) (annotateDisposals combined) [] ∧
      Checked (annotateDisposalStore []) [] (OwnerPhaseTransitions.available [7, 8])
        (annotateDisposals combined) row ∧ row ⊆ [] := by
  have normal : Checked [] [] (OwnerPhaseTransitions.available [7, 8]) nestedRequirements [] := by
    apply RecursiveRequirements.evaluate_sound
    simp only [nestedRequirements, innerRequirements, closingRequirements, Requirements.prepend,
      RecursiveRequirements.evaluate, RecursiveRequirements.evaluateFuel]
    decide
  have guarded : Checked [] [.ordinary (.barrier true)] (OwnerPhaseTransitions.available [7, 8]) nestedRequirements [] := by
    apply RecursiveRequirements.evaluate_sound
    simp only [nestedRequirements, innerRequirements, closingRequirements, Requirements.prepend,
      RecursiveRequirements.evaluate, RecursiveRequirements.evaluateFuel]
    decide
  have generated : Checked (annotateDisposalStore []) [] (OwnerPhaseTransitions.available [7, 8])
      (annotateDisposals nestedRequirements) [] := by
    simpa only [(unwind_template_disposals nested_summary).2, annotateDisposalStore, List.map_nil] using normal
  obtain ⟨combined, row, annotation, retained, cleanup, closed, checked, bounded⟩ :=
    capture_annotation_from_effects nested_summary nested_summary.ownership (by decide)
      (by intro owner member; exact if_pos member) (RowAnnotation.original (requirements := nestedRequirements))
      generated (List.Subset.refl [])
      (nested_summary.effects_of_checked normal (List.Subset.refl []))
      (nested_summary.effects_of_checked guarded (List.Subset.refl []))
  exact ⟨combined, row, annotation, cleanup, closed, checked, bounded⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CaptureAnnotationExamples
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CaptureAnnotationExamples.nested_summary
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CaptureAnnotationExamples.nested_capture_admitted


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open OwnerPhaseTransitions (spendAll)

/-- Focus the original finite annotation, then map its exact retained subtree.
The caller receives a generated successor, not an arbitrary checked row tree. -/
theorem retire_annotation_checked_generated
    {tail : Requirements demand}
    (annotation : RowAnnotation (.sequence (.retire owner) tail) annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) row) :
    ∃ annotatedTail : Requirements demand, ∃ tailRow,
      RowAnnotation tail annotatedTail ∧
      RequirementPath annotatedTail annotated [owner] ∧
      Checked entries receiving (spendAll before [owner]) (annotateDisposals annotatedTail) tailRow ∧
      tailRow ⊆ row := by
  obtain ⟨annotatedTail, tailAnnotation, path⟩ := annotation.focus (RequirementPath.second (.here (selected := tail)))
  obtain ⟨tailRow, tailCheck, within⟩ := (disposal_subtree_path path).checked checked
  exact ⟨annotatedTail, tailRow, tailAnnotation, path, tailCheck, within⟩

/-- Reuse the established opening proof for retirement readiness, retaining
exact generated copies of the original saved and waiting annotations. -/
theorem open_annotation_checked_generated
    {saved : Requirements savedDemand} {tail : Requirements tailDemand}
    (annotation : RowAnnotation (.sequence saved (.sequence (.retire owner) tail)) annotated)
    (checked : Checked entries receiving before (annotateDisposals annotated) row) :
    ∃ annotatedSaved : Requirements savedDemand, ∃ annotatedTail : Requirements tailDemand,
    ∃ savedRow tailRow,
      RowAnnotation saved annotatedSaved ∧ RowAnnotation tail annotatedTail ∧
      RequirementPath annotatedSaved annotated [] ∧
      RequirementPath annotatedTail annotated (savedDemand ++ [owner]) ∧
      Checked (RecursiveTransport.removeOwner owner entries) receiving before (annotateDisposals annotatedSaved) savedRow ∧
      Checked (RecursiveTransport.removeOwner owner entries) receiving (spendAll before savedDemand) (.retire owner) [] ∧
      Checked (RecursiveTransport.removeOwner owner entries) receiving
        (spendAll (spendAll before savedDemand) [owner]) (annotateDisposals annotatedTail) tailRow ∧
      savedRow ++ tailRow ⊆ row := by
  obtain ⟨annotatedSaved, savedAnnotation, savedPath⟩ := annotation.focus (RequirementPath.first (.here (selected := saved)))
  obtain ⟨annotatedTail, tailAnnotation, tailPath⟩ := annotation.focus
    (RequirementPath.second (RequirementPath.second (.here (selected := tail))))
  obtain ⟨savedRow, savedCheck, savedBound⟩ := (disposal_subtree_path savedPath).checked checked
  obtain ⟨tailRow, tailCheck, tailBound⟩ := (disposal_subtree_path tailPath).checked checked
  simp only [spendAll] at savedCheck
  simp only [List.append_nil, PhaseRechecking.spendAll_append] at tailCheck tailPath
  have absent : owner ∉ savedDemand := by
    intro member
    exact (List.nodup_append.mp (RecursiveRequirements.checked_once checked)).2.2
      owner member owner List.mem_cons_self rfl
  obtain ⟨_, _, _, _, _, _, _, _, _, retireCheck, _, _⟩ :=
    open_annotation_checked (disposal_annotation_map annotation) checked
  refine ⟨annotatedSaved, annotatedTail, savedRow, tailRow, savedAnnotation, tailAnnotation,
    savedPath, tailPath, checked_remove_undemanded savedCheck absent, retireCheck, ?_,
    List.append_subset.mpr ⟨savedBound, tailBound⟩⟩
  apply RecursiveTransport.checked_remove_consumed tailCheck
  simp only [spendAll, OwnerPhaseTransitions.spend_self]

/-- The retained-path account commutes with disposal generation, including
retirement's changed demand and opening's split saved/waiting annotations. -/
theorem UnwindAnnotationStep.disposals
    (step : UnwindAnnotationStep normal annotated discharged next) :
    UnwindAnnotationStep (annotateDisposals normal) (annotateDisposals annotated) discharged (annotateDisposals next) := by
  cases step with
  | retained empty path => exact .retained empty (disposal_subtree_path path)
  | retired annotation before after =>
      exact .retired (disposal_annotation_map annotation)
        (disposal_subtree_path before) (disposal_subtree_path after)
  | opened saved tail beforeSaved beforeTail afterSaved afterTail =>
      exact .opened (disposal_annotation_map saved) (disposal_annotation_map tail)
        (disposal_subtree_path beforeSaved) (disposal_subtree_path beforeTail)
        (disposal_subtree_path afterSaved) (disposal_subtree_path afterTail)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.retire_annotation_checked_generated
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.open_annotation_checked_generated
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.UnwindAnnotationStep.disposals

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements Checked Store)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open SourceDependencyFrames (unwindStore)
open OwnerPhaseTransitions (spendAll)

/-- Preserve generated certificates with arbitrary source annotations through
all administrative unwind steps. Retained scopes keep the whole prior root;
retirement and opening keep the exact generated waiting and saved subtrees. -/
theorem PlannedModeSource.advance_generated_annotated_checked
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind output demand requirements scope)
    (step : LexicalUnwind.Advance stack after discharged)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : Checked entries [] before (annotateDisposals annotatedRoot) row) :
    ∃ nextDemand, ∃ nextRequirements annotatedNext : Requirements nextDemand, ∃ nextRow,
      PlannedModeSource operations policy contracts tables families required outward actions world after .unwind output
        nextDemand nextRequirements scope.afterUnwind ∧
      RowAnnotation nextRequirements annotatedNext ∧
      Checked (unwindStore stack entries) [] (spendAll before (discharged.filterMap Syntax.ticketProjection))
        (annotateDisposals annotatedNext) nextRow ∧ nextRow ⊆ row ∧
      UnwindAnnotationStep requirements annotatedRoot discharged annotatedNext := by
  have retained {sourceDemand : List Nat} {original next annotatedRoot : Requirements sourceDemand} {nextRow : Footprint}
      (empty : discharged.filterMap Syntax.ticketProjection = [])
      (annotation : RowAnnotation original annotatedRoot)
      (checked : Checked entries [] before (annotateDisposals annotatedRoot) row)
      (nextCheck : Checked entries [] before (annotateDisposals next) nextRow) (within : nextRow ⊆ row) :
      ∃ annotatedNext : Requirements sourceDemand, ∃ totalRow,
        RowAnnotation next annotatedNext ∧
        Checked entries [] before (annotateDisposals annotatedNext) totalRow ∧ totalRow ⊆ row ∧
        UnwindAnnotationStep original annotatedRoot discharged annotatedNext := by
    refine ⟨.choice next annotatedRoot (.refl _), nextRow ++ row, .alternatives .original (.refl _), ?_,
      List.append_subset.mpr ⟨within, List.Subset.refl _⟩, .retained empty (.no .here)⟩
    exact Checked.choice (same := List.Perm.refl _) nextCheck checked
  obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked checked
  cases step with
  | plain => cases source with | push head tail => cases head with
    | skipped =>
      have tailCheck : Checked entries [] before _ normalRow := RecursiveRequirements.evaluate_sound (by
        simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left] using
          RecursiveRequirements.checked_complete normalCheck)
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck normalBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | handler => cases source with | push head tail => cases head with
    | handler declaration =>
      have tailCheck : Checked entries [] before _ normalRow := RecursiveRequirements.evaluate_sound (by
        simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left] using
          RecursiveRequirements.checked_complete normalCheck)
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck normalBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | cell => cases source with | push head tail => cases head with
    | cell =>
      have tailCheck : Checked entries [] before _ normalRow := RecursiveRequirements.evaluate_sound (by
        simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left] using
          RecursiveRequirements.checked_complete normalCheck)
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck normalBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | spent => cases source with | skippedSpent tail =>
      obtain ⟨_, tailRow, _, tailCheck, rowSame⟩ := RecursiveRequirements.checked_sequence_parts normalCheck
      have tailBound : tailRow ⊆ row := (rowSame ▸ List.subset_append_right _ _).trans normalBound
      obtain ⟨nextAnnotated, nextRow, annotated, valid, within, paths⟩ := retained rfl annotation checked tailCheck tailBound
      exact ⟨_, _, nextAnnotated, nextRow, tail, annotated, valid, within, paths⟩
  | retire => cases source with | push head tail => cases head with
    | retiring =>
      obtain ⟨annotatedTail, tailRow, tailAnnotation, path, tailCheck, within⟩ := retire_annotation_checked_generated annotation checked
      exact ⟨_, _, annotatedTail, tailRow, tail, tailAnnotation, tailCheck, within, .retired tailAnnotation path .here⟩
  | @live owner input answer captured caller rest => cases source with
    | @opening captured savedDemand savedRequirements savedScope rest output tailDemand tailRequirements restScope owner input answer caller saved tail =>
      obtain ⟨annotatedSaved, annotatedTail, savedRow, tailRow, savedAnnotation, tailAnnotation,
        savedPath, tailPath, savedCheck, retireCheck, tailCheck, within⟩ := open_annotation_checked_generated annotation checked
      obtain ⟨combined, nextSource, normalEvaluation, generatedEvaluation⟩ := saved.append_disposals (PlannedModeSource.push .retiring tail)
      obtain ⟨rawSavedRow, rawSavedCheck, savedWithin⟩ := (disposal_annotation_map savedAnnotation).checked savedCheck
      obtain ⟨rawTailRow, rawTailCheck, tailWithin⟩ := (disposal_annotation_map tailAnnotation).checked tailCheck
      have combinedCheck : Checked (RecursiveTransport.removeOwner owner entries) [] before
          (annotateDisposals combined) (rawSavedRow ++ rawTailRow) := by
        apply RecursiveRequirements.evaluate_sound
        rw [generatedEvaluation]
        have retainedNormal := Checked.sequence rawSavedCheck (Checked.sequence retireCheck rawTailCheck)
        simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
          RecursiveRequirements.evaluate_prepend, List.append_nil, List.nil_append, Requirements.prepend] using
          RecursiveRequirements.checked_complete retainedNormal
      have combinedBound : rawSavedRow ++ rawTailRow ⊆ row :=
        (ScopedExpressions.append_subset savedWithin tailWithin).trans within
      let retained := Requirements.sequence annotatedSaved (.sequence (.retire owner) annotatedTail)
      have retainedCheck : Checked (RecursiveTransport.removeOwner owner entries) [] before (annotateDisposals retained) (savedRow ++ tailRow) := by
        exact .sequence savedCheck (.sequence retireCheck tailCheck)
      let nextAnnotated := Requirements.choice combined retained (List.Perm.refl _)
      refine ⟨_, combined, nextAnnotated, (rawSavedRow ++ rawTailRow) ++ (savedRow ++ tailRow), nextSource,
        .alternatives .original (.refl _), .choice combinedCheck retainedCheck,
        List.append_subset.mpr ⟨combinedBound, within⟩,
        .opened savedAnnotation tailAnnotation savedPath tailPath (.no (.first .here)) ?_⟩
      exact .no (by simpa only [List.append_nil] using
        (RequirementPath.second (RequirementPath.second (.here (selected := annotatedTail)))))
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.advance_generated_annotated_checked

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Pending)
open SourceDependencyAnnotations (RowAnnotation StoreAnnotation)
open SourceDependencySchemes.Lexical (UnwindAnnotated)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyFrames (unwindStore)
open RecursiveRequirements (Requirements Store Checked)
open OwnerPhaseTransitions (available spendAll)

/-- Join the generated source result to the established full administrative
preservation theorem. The successor is generated over the successor base store
and annotation, so the same invariant shape can be used at the next step. -/
theorem advance_planned_unwind_generated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack .unwind output demand requirements scope)
    {hints : ReturnHints scope}
    (matching : ReturnHints.Matches tables families hints stack)
    (pending : Pending outward actions (available (ownedTickets stack)) world hints .nil .unwind output.mode)
    (bound : Bound annotations scope)
    (records : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world stack key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world stack key body)
    (storeAnnotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (annotation : RowAnnotation requirements annotatedRoot)
    (checked : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
      (annotateDisposals annotatedRoot) certificateRow)
    (finite : SourceContextualRechecking.checkForest required stack scope .nil = true)
    (unique : (ownedTickets stack).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.unwind runtimeScope stack))
    (tickets : LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope stack))
    (resources : LexicalUnwind.MachineAccess ambient (.unwind runtimeScope stack))
    (step : LexicalUnwind.Advance stack after discharged) :
    ∃ nextDemand, ∃ nextRequirements annotatedNext : Requirements nextDemand,
    ∃ nextHints : ReturnHints scope.afterUnwind, ∃ nextRow,
      PlannedModeSource operations policy contracts tables families required outward actions world after .unwind output
        nextDemand nextRequirements scope.afterUnwind ∧
      ReturnHints.Matches tables families nextHints after ∧
      Pending outward actions (available (ownedTickets after)) world nextHints .nil .unwind output.mode ∧
      Bound annotations scope.afterUnwind ∧
      StoreAnnotation (unwindStore stack resumes ++ unwindStore stack disposals) (unwindStore stack annotatedStore) ∧
      RowAnnotation nextRequirements annotatedNext ∧
      Checked (annotateDisposalStore (unwindStore stack annotatedStore)) [] (available (ownedTickets after))
        (annotateDisposals annotatedNext) nextRow ∧
      UnwindAnnotationStep requirements annotatedRoot discharged annotatedNext ∧
      nextRow ⊆ certificateRow ∧ nextDemand.Perm (ownedTickets after) ∧ (ownedTickets after).Nodup ∧
      SourceContextualRechecking.checkForest required after scope.afterUnwind .nil = true ∧
      (∀ key body, (key, body) ∈ unwindStore stack resumes →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world after key body) ∧
      (∀ key body, (key, body) ∈ unwindStore stack disposals →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world after key body) ∧
      LexicalUnwind.UseTransition (.unwind runtimeScope stack) (.unwind runtimeScope after) [] discharged ∧
      LexicalUnwind.MachineUse policy actions (.unwind runtimeScope after) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.unwind runtimeScope after) ∧
      LexicalUnwind.MachineAccess ambient (.unwind runtimeScope after) := by
  have erasedClosing := fun key body member => (closing key body member).erase
  have strongClosing := planned_unwind_records_advance step closing
  obtain ⟨oldDemand, oldRequirements, oldAnnotated, nextHints, oldRow, oldSource, nextMatch,
    nextPending, nextBound, oldStore, oldAnnotation, oldCheck, oldPaths, oldWithin,
    oldBalance, nextUnique, nextFinite, nextRecords, nextClosing, event, nextUsage, nextTickets, nextResources⟩ :=
    advance_planned_unwind_annotated source matching pending bound records erasedClosing
      (annotated_disposal_store storeAnnotation) (annotated_disposals annotation) checked
      finite unique usage tickets resources step
  obtain ⟨nextDemand, nextRequirements, nextAnnotated, nextRow, nextSource, nextAnnotation,
    nextCheck, within, paths⟩ := source.advance_generated_annotated_checked step annotation checked
  have phaseSame := (SourceDependencyFrames.unwind_owner_phases step unique).2
  rw [phaseSame] at nextCheck
  obtain ⟨_, normalCheck, _⟩ := (annotated_disposals nextAnnotation).checked nextCheck
  obtain ⟨_, originalCheck, _⟩ := oldStore.checked normalCheck
  have balance := SourceDependencySchemes.Lexical.mode_stack_ownership_balance nextSource.erase
    (fun key body member => (nextRecords key body member).erase) nextClosing nextUnique originalCheck
  have nextStore : StoreAnnotation (unwindStore stack resumes ++ unwindStore stack disposals)
      (unwindStore stack annotatedStore) := by
    rw [← SourceDependencyFrames.unwind_store_combined]
    cases stack <;> first | exact storeAnnotation | exact storeAnnotation.remove_owner _
  rw [← disposal_store_unwind] at nextCheck
  exact ⟨nextDemand, nextRequirements, nextAnnotated, nextHints, nextRow, nextSource, nextMatch,
    nextPending, nextBound, nextStore, nextAnnotation, nextCheck, paths, within, balance, nextUnique,
    nextFinite, nextRecords, strongClosing, event, nextUsage, nextTickets, nextResources⟩
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.advance_planned_unwind_generated


