        exact Instantiation.frozen_effect_realizes _ _
      exact Instantiation.frozen_effect_cannot_change realization
    subst requested
    rw [effectEq] at known
    have valuesSame := Option.some.inj (known.symm.trans actualKnown)
    obtain ⟨argumentSame, inputSame⟩ := Prod.mk.inj valuesSame
    subst actualArgument
    subst input
    have inputRowsSame := eq_of_heq resultRowsSame
    obtain ⟨_, _, rowsSame⟩ := selectedAt.unique selectedActual
    have actualSelected : CapturedClauseRows effect operation captureScope.held captured selectedRows :=
      .selected actualTerminal selectedActual
    have requiredRights := SourceAdmission.rightsAt_clause located declarationPlans
    have certificate := split.compile_clause_from_request actualSelected actualTerminal requiredRights
      expression cut freshActions absent
    have terminalAt : TerminalHandler effect handler.activation actualRows captured := by
      rw [activationEq]
      exact actualTerminal
    let readinessContract : Contract :=
      ⟨site.result, answer, captureScope.held, [], [], [], none, resumeEffects, closeEffects⟩
    have ready : ClosedExcept parameter code :=
      SourcePlannedCaptureSubstitution.body_ready (contract := readinessContract)
        (body owner readinessContract fresh rfl rfl rfl rfl rfl (List.Perm.refl []))
        (by simp [SourcePlannedTyping.Contracts.insert])
    refine ⟨frontStack, handler, answer, residual, parameter, binder, code, offered, row,
      answerRows, nextFamily, plans, selectedRows, resumeEffects, closeEffects,
      declarationPlans, actualRows, declarations,
      stackEq, effectEq, answerAnnotation, answerMode, callerScope, selected_plan_certified (evidence := declarationPolicy) selectedPlan certifiedDeclarations owner, located, ready, found, offeredRow,
      actualSelected, rowsSame, authenticated, terminalAt, requiredRights, certificate,
      resumeInterface, closeInterface, ?_⟩
    intro contract inputSame answerSame resumeSame closeSame heldSame demands _savedDemand
    have checked := bodyChecked owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
    simp only [effectEq] at checked
    have replaced := checked.fresh_substitution payloadChecked closed fresh
    refine ⟨SourcePlannedCaptureSubstitution.body_substitution
      (body owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands)
      (SourcePlannedCaptureSubstitution.fresh_payload payload closed fresh) closed, ?_⟩
    simpa only [inputRowsSame] using replaced

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
