theorem Code.spend_absent
    {checking : SourcePlanSignatures.Signature dependencies} {rows : Rows checking}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations rows context)
    (absent : owner ∉ context.owned) :
    Code outward actions budget (spend phases owner) world installations rows context :=
  checked.spend_absent_all owner absent

private theorem Pending.spend_absent_all
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside input output) :
    ∀ owner, owner ∉ (context.append outside).owned →
      Pending outward actions budget (spend phases owner) world installations context outside input output := by
  apply Pending.rec (motive_1 := fun actions budget phases world installations {dependencies checking} rows {scope hints} context _ =>
      ∀ owner, owner ∉ context.owned →
        Code outward actions budget (spend phases owner) world installations rows context)
    (motive_2 := fun actions budget phases world installations {scope outsideScope hints external} context outside input output _ =>
      ∀ owner, owner ∉ (context.append outside).owned →
        Pending outward actions budget (spend phases owner) world installations context outside input output) (t := checked)
  · intros
    exact .pure
  · intros
    rename_i found owner absent
    exact .builtin found
  · intros
    rename_i cut guarded callbacks ownerBound cleanupBudget family bodies bodyRows declarations declarationRows selected terminal requiredRights retained body ihCallbacks ihRetained ihBody owner absent
    have wholeOwned := congrArg (fun packed : Packed => packed.context.owned) cut.decomposition
    dsimp only [Context.pack] at wholeOwned
    have parts := absent
    rw [wholeOwned] at parts
    simp only [Context.append_owned, List.mem_append, not_or] at parts
    refine .request cut guarded (fun disposing => ihCallbacks disposing owner ?_) ownerBound
      (cleanupBudget.spend_absent absent) selected terminal requiredRights (ihRetained owner ?_) ?_
    · simpa only [Context.append_owned, Context.owned, List.mem_append, not_or] using parts
    · simpa only [Context.append_owned, Context.owned, List.append_nil] using absent
    · intro allocated demand fresh names
      by_cases same : allocated = owner
      · subst allocated
        rw [introduce_spend_same]
        exact body owner demand fresh names
      · rw [introduce_spend_other same]
        apply ihBody allocated demand fresh names owner
        simp only [Context.owned, List.mem_append, List.mem_cons, not_or]
        exact ⟨parts.1, Ne.symm same, parts.2⟩
  · intros
    rename_i located known permission available resumeBudget restored ih owner absent
    have parts := absent
    simp only [Context.append_owned, Context.owned, List.mem_append, List.mem_cons, not_or] at parts
    refine .resume located known permission ((OwnerPhaseTransitions.spend_other (Ne.symm parts.2.2.1)).trans available)
      resumeBudget ?_
    rw [budget_spend_comm]
    apply ih owner
    simpa only [Context.append_owned, Context.owned, List.append_nil, List.mem_append, not_or] using
      And.intro parts.2.1 (And.intro parts.1 parts.2.2.2)
  · intros
    rename_i located known permission available unprotected abandoned waiting ihAbandoned ihWaiting owner absent
    have parts := absent
    simp only [Context.append_owned, Context.owned, List.mem_append, List.mem_cons, not_or] at parts
    refine .dispose located known permission ((OwnerPhaseTransitions.spend_other (Ne.symm parts.2.2.1)).trans available) unprotected ?_ ?_
    · rw [budget_spend_comm]
      apply ihAbandoned owner
      simpa only [Context.append_owned, Context.owned, List.mem_append, not_or] using
        And.intro parts.2.1 (And.intro parts.1 parts.2.2.2)
    · rw [budget_spend_comm]
      apply ihWaiting owner
      simpa only [Context.append_owned, Context.owned, List.append_nil, List.mem_append, not_or] using
        And.intro parts.1 parts.2.2.2
  · intros
    rename_i first second ihFirst ihSecond owner absent
    exact .sequence (ihFirst owner absent) (ihSecond owner absent)
  · intros
    rename_i left right ihLeft ihRight owner absent
    exact .choice (ihLeft owner absent) (ihRight owner absent)
  · intros
    rename_i body ih owner absent
    exact .handler (fun activation fresh => ih activation fresh owner absent)
  · intros
    rename_i body callback ihBody ihCallback owner absent
    exact .cleanup (ihBody owner absent) (ihCallback owner absent)
  · intros
    rename_i body ih owner absent
    exact .resource (fun identity fresh => ih identity fresh owner absent)
  · intros
    exact .nil
  · intros
    rename_i code tail ihCode ihTail owner absent
    exact .plain (ihCode owner absent) (ihTail owner absent)
  · intros
    rename_i tail ih owner absent
    exact .skipped (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .handler (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .cell (ih owner absent)
  · intros
    rename_i callback tail ihCallback ihTail owner absent
    apply Pending.cleanup (ihCallback owner ?_) (ihTail owner absent)
    simpa only [Context.callback_owned, Context.append, Context.owned] using absent
  · intros
    rename_i tail ih owner absent
    exact .normal (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .unwinding (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .closing (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .retiring (ih owner (fun member => absent (List.mem_cons_of_mem _ member)))
  · intros
    rename_i saved tail ihSaved ihTail owner absent
    apply Pending.live (ihSaved owner ?_) (ihTail owner ?_)
    · intro member
      apply absent
      simp only [Context.append_owned, Context.append, Context.owned, List.mem_append, List.mem_cons] at member ⊢
      rcases member with inside | outside
      · exact .inl inside
      · exact .inr (.inr outside)
    · exact fun member => absent (List.mem_append.mpr (.inr (List.mem_cons_of_mem _ member)))
  · intros
    rename_i saved tail ihSaved ihTail owner absent
    apply Pending.opening (ihSaved owner ?_) (ihTail owner ?_)
    · simpa only [Context.append_owned, Context.append, Context.owned] using absent
    · exact fun member => absent (List.mem_append.mpr (.inr (List.mem_cons_of_mem _ member)))
  · intros
    rename_i tail ih owner absent
    exact .spent (ih owner absent)

theorem Pending.spend_absent
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside input output)
    (absent : owner ∉ (context.append outside).owned) :
    Pending outward actions budget (spend phases owner) world installations context outside input output :=
