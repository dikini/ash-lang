namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)
open LexicalUnwind (UseMode)

/-- Association preserves the complete decorated context, not only its erasure. -/
theorem Context.append_assoc_pack {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {third : ReturnHints thirdScope} (head : Context first) (tail : Context second) (outside : Context third) :
    ((head.append tail).append outside).pack = (head.append (tail.append outside)).pack := by
  induction head with
  | nil => rfl
  | plain rows rest ih => exact congrArg (fun p : Packed => (Context.plain rows p.context).pack) ih
  | handler activation rows rest ih => exact congrArg (fun p : Packed => (Context.handler activation rows p.context).pack) ih
  | cell rest ih => exact congrArg (fun p : Packed => (Context.cell p.context).pack) ih
  | cleanup latent rows rest ih => exact congrArg (fun p : Packed => (Context.cleanup latent rows p.context).pack) ih
  | normal rest ih => exact congrArg (fun p : Packed => (Context.normal p.context).pack) ih
  | unwinding rest ih => exact congrArg (fun p : Packed => (Context.unwinding p.context).pack) ih
  | closing rest ih => exact congrArg (fun p : Packed => (Context.closing p.context).pack) ih
  | retiring owner rest ih => exact congrArg (fun p : Packed => (Context.retiring owner p.context).pack) ih
  | @live savedScope restScope owner resumeDemand savedHints restHints saved rest ihSaved ihRest =>
      exact congrArg (fun p : Packed => (Context.live (resumeDemand := resumeDemand) saved p.context).pack) ihRest
  | spent rest ih => exact congrArg (fun p : Packed => (Context.spent p.context).pack) ih

/-- Reindex only by equality of the complete decorated receiving context. -/
theorem Budgeted.reindex_context {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {context : Context first} {next : Context second}
    (checked : Budgeted budget phases world installations rows context) (same : context.pack = next.pack) :
    Budgeted budget phases world installations rows next := by
  change Budgeted budget phases world installations rows context.pack.context at checked
  rw [same] at checked
  exact checked

/-- Reindex only the external suffix, retaining every pending scope and mode. -/
theorem PendingBudget.reindex_outside {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {outside : Context first} {next : Context second}
    (checked : PendingBudget budget phases world installations context outside before after)
    (same : outside.pack = next.pack) : PendingBudget budget phases world installations context next before after := by
  change PendingBudget budget phases world installations context outside.pack.context before after at checked
  rw [same] at checked
  exact checked

/-- Recomposition preserves the actual lexical receiver used by every budget
check, including saved continuations and their retirement boundary. -/
theorem PendingBudget.append {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {external : ReturnHints externalScope} {head : Context first} {tail : Context second} {outside : Context external}
    (inside : PendingBudget budget phases world installations head (tail.append outside) before middle)
    (remaining : PendingBudget budget phases world installations tail outside middle after) :
    PendingBudget budget phases world installations (head.append tail) outside before after := by
  induction head generalizing before middle after with
  | nil => cases inside; exact remaining
  | plain rows rest ih => cases inside with
    | plain code next => exact .plain (code.reindex_context (rest.append_assoc_pack tail outside).symm) (ih next remaining)
    | skipped next => exact .skipped (ih next remaining)
  | handler activation rows rest ih => cases inside with
    | handler next => exact .handler (ih next remaining)
  | cell rest ih => cases inside with
    | cell next => exact .cell (ih next remaining)
  | cleanup latent rows rest ih => cases inside with
    | cleanup callback next =>
        exact .cleanup
          (callback.reindex_context (congrArg (fun p : Packed => (p.context.callback before).pack)
          (rest.append_assoc_pack tail outside).symm)) (ih next remaining)
  | normal rest ih => cases inside with
    | normal next => exact .normal (ih next remaining)
  | unwinding rest ih => cases inside with
    | unwinding next => exact .unwinding (ih next remaining)
  | closing rest ih => cases inside with
    | closing next => exact .closing (ih next remaining)
  | retiring owner rest ih => cases inside with
    | retiring next => exact .retiring (ih next remaining)
  | live saved rest ihSaved ihRest => cases inside with
    | live captured next =>
        exact .live
          (captured.reindex_outside (rest.append_assoc_pack tail outside).symm) (ihRest next remaining)
    | opening captured next =>
        exact .opening
          (captured.reindex_outside (congrArg (fun p : Packed => (Context.retiring _ p.context).pack)
          (rest.append_assoc_pack tail outside).symm)) (ihRest next remaining)
  | spent rest ih => cases inside with
    | spent next => exact .spent (ih next remaining)

/-- Splitting at an exact decorated boundary produces the intermediate return
mode and retains existing checks at their original lexical receiver. -/
theorem PendingBudget.split {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {external : ReturnHints externalScope} {head : Context first} {tail : Context second} {outside : Context external}
    (checked : PendingBudget budget phases world installations (head.append tail) outside before after) :
    ∃ middle : UseMode,
      PendingBudget budget phases world installations head (tail.append outside) before middle ∧
      PendingBudget budget phases world installations tail outside middle after := by
  induction head generalizing before after with
  | nil => exact ⟨before, .nil, checked⟩
  | plain rows rest ih => cases checked with
    | plain code next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .plain (code.reindex_context (rest.append_assoc_pack tail outside)) inside, remaining⟩
    | skipped next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .skipped inside, remaining⟩
  | handler activation rows rest ih => cases checked with
    | handler next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .handler inside, remaining⟩
  | cell rest ih => cases checked with
    | cell next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .cell inside, remaining⟩
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .cleanup
            (callback.reindex_context (congrArg (fun p : Packed => (p.context.callback before).pack)
            (rest.append_assoc_pack tail outside))) inside, remaining⟩
  | normal rest ih => cases checked with
    | normal next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .normal inside, remaining⟩
  | unwinding rest ih => cases checked with
    | unwinding next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .unwinding inside, remaining⟩
  | closing rest ih => cases checked with
    | closing next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .closing inside, remaining⟩
  | retiring owner rest ih => cases checked with
    | retiring next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .retiring inside, remaining⟩
  | live saved rest ihSaved ihRest => cases checked with
    | live captured next =>
        obtain ⟨middle, inside, remaining⟩ := ihRest next
        exact ⟨middle, .live (captured.reindex_outside (rest.append_assoc_pack tail outside)) inside, remaining⟩
    | opening captured next =>
        obtain ⟨middle, inside, remaining⟩ := ihRest next
        exact ⟨middle, .opening
            (captured.reindex_outside (congrArg (fun p : Packed => (Context.retiring _ p.context).pack)
            (rest.append_assoc_pack tail outside))) inside, remaining⟩
  | spent rest ih => cases checked with
    | spent next =>
        obtain ⟨middle, inside, remaining⟩ := ih next
        exact ⟨middle, .spent inside, remaining⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingBudget.append
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingBudget.split

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)
open ScopedExpressions ScopedExecution ProtectionContracts

/-- An ordinary authenticated frame passes the budget to its exact tail in
ordinary mode, including callback and closing return markers. -/
theorem FrameRows.budget_tail
    (coherent : FrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail context)
    (checked : PendingBudget budget phases world installations context outside .ordinary finalMode) :
    PendingBudget budget phases world installations tail outside .ordinary finalMode := by
  cases coherent <;> cases checked <;> assumption

/-- The budget return mode agrees with the existing rich mode-frame interface. -/
theorem ModeFrameRows.budget_tail
    {frame : PlannedModeFrame operations policy contracts tables families required outward world
      entry input output demand requirements layer}
    (coherent : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows outputRows tail context)
    (checked : PendingBudget budget phases world installations context outside input.mode finalMode) :
    PendingBudget budget phases world installations tail outside output.mode finalMode := by
  cases coherent with
  | ordinary authenticated => exact authenticated.budget_tail checked
  | unwinding authenticated => cases checked with | unwinding next => exact next
  | closing => cases checked with | closing next => exact next
  | retiring => cases checked with | retiring next => exact next
  | skipped => cases checked with | skipped next => exact next
  | handler authenticated => cases authenticated with
    | handler clauses => cases checked with | handler next => exact next
  | cell => cases checked with | cell next => exact next
  | cleanup authenticated => cases checked with | cleanup callback next => exact next

/-- Independently checked pending budgets have the rich source's actual output
mode. No uniqueness of hidden typing derivations or metadata is used. -/
theorem PendingRows.budget_output_mode
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    {external : ReturnHints externalScope} {outside : Context external}
    (coherent : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (checked : PendingBudget budget phases world installations context outside input.mode finalMode) :
    output.mode = finalMode := by
  induction coherent generalizing externalScope external outside finalMode with
  | nil => cases checked; rfl
  | push head tail ih => exact ih (head.budget_tail checked)
  | live answerRows inside tail ihInside ihTail => cases checked with
    | live saved next =>
        have middle := ihInside saved
        rw [← middle] at next
        exact ihTail next
  | opening inside tail ihInside ihTail => cases checked with
    | opening saved next => exact ihTail next
  | spent tail ih | skippedSpent tail ih => cases checked with
    | spent next => exact ih next

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.budget_output_mode

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)

/-- Split the actual pending source and its budget at one exact decorated
boundary. Both physical fragments share the same rich mode and value metadata;
the budget fragments use that mode, and both evaluation equations are retained. -/
theorem PendingRows.split_budgeted
    {whole : ReturnHints scope} {context : Context whole}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    {external : ReturnHints externalScope} {outside : Context external}
    (rows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (checked : PendingBudget budget phases world installations context outside input.mode output.mode)
    {firstScope secondScope} {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (head : Context first) (tail : Context second)
    (same : context.pack = (head.append tail).pack) :
    ∃ captured rest, ∃ middle, ∃ middleRows : ModeRowsValue middle,
    ∃ firstDemand secondDemand, ∃ firstRequirements : Requirements firstDemand,
    ∃ secondRequirements : Requirements secondDemand,
    ∃ firstSource : PlannedModeSource operations policy contracts tables families required outward actions world
      captured input middle firstDemand firstRequirements firstScope,
    ∃ secondSource : PlannedModeSource operations policy contracts tables families required outward actions world
      rest middle output secondDemand secondRequirements secondScope,
      stack = captured.append rest ∧
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        firstSource inputRows middleRows head ∧
      PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
        secondSource middleRows outputRows tail ∧
      PendingBudget budget phases world installations head (tail.append outside) input.mode middle.mode ∧
      PendingBudget budget phases world installations tail outside middle.mode output.mode ∧
      demand = firstDemand ++ secondDemand ∧
      (∀ store receiving before,
        evaluate store receiving before requirements =
          merge (evaluate store (OwnerPhases.ofStack tables rest ++ receiving) before firstRequirements)
            (evaluate store receiving (spendAll before firstDemand) secondRequirements)) ∧
      ∀ store receiving before,
        evaluate store receiving before (annotateDisposals requirements) =
          merge (evaluate store (OwnerPhases.ofStack tables rest ++ receiving) before (annotateDisposals firstRequirements))
            (evaluate store receiving (spendAll before firstDemand) (annotateDisposals secondRequirements)) := by
  obtain ⟨captured, rest, middle, middleRows, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstSource, secondSource, stackSame, firstRows, secondRows, demandSame, evaluation, generatedEvaluation⟩ :=
    rows.split_disposals head tail same
  have appended : PendingBudget budget phases world installations (head.append tail) outside input.mode output.mode := by
    change PendingBudget budget phases world installations context.pack.context outside input.mode output.mode at checked
    rw [same] at checked
    exact checked
  obtain ⟨budgetMiddle, firstBudget, secondBudget⟩ := appended.split (head := head) (tail := tail)
  have aligned : middle.mode = budgetMiddle := firstRows.budget_output_mode firstBudget
  rw [← aligned] at firstBudget secondBudget
  exact ⟨captured, rest, middle, middleRows, firstDemand, secondDemand, firstRequirements, secondRequirements,
    firstSource, secondSource, stackSame, firstRows, secondRows, firstBudget, secondBudget,
    demandSame, evaluation, generatedEvaluation⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.split_budgeted

