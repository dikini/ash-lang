      handler.effectInst = effect ∧
      answer.erase.erase.port = ScopedPorts.eraseType handler.answer ∧
      ModeRowsValue.Answer answerRows split.boundaryRows ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports handler.scope ∧
      SourcePlannedChecks.Certified (evidence := declarationPolicy) outward world (plans owner) ∧
      ClauseAt operation handler.clauses parameter binder code ∧
      ClosedExcept parameter code ∧
      lookup operation (tables handler) = some offered ∧ offered.row captureScope.held = some row ∧
      CapturedClauseRows effect operation captureScope.held captured selectedRows ∧
      HEq bodyRows selectedRows ∧
      AuthDeclarations operations policy ports owners emptyRows answerRows declarations declarationRows ∧
      TerminalHandler effect handler.activation declarationRows captured ∧
      SourceAdmission.rightsAt operation (clauseSignatures declarationPlans) = some code.requiredActions ∧
      SourceAdmission.Code outward (actions.insert owner code.requiredActions) budget
        (OwnerPhaseTransitions.introduce phases owner) world installations (selectedRows owner)
        (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail) ∧
