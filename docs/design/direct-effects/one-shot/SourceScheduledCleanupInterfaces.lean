#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.ClauseRows.cons_heq
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.ClauseRows.substitute_cons_heq
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Rows.handler_heq
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Rows.handler_substitute_heq

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements)
open SourcePlannedTyping (Value Environment Operations Contract Contracts)
open SourcePlanSignatures (Signature signature substituteClauses substitution_signature)
/-- Closed value substitution preserves the authenticated value and checking
metadata. Structural recursion follows the existing rich source substitution. -/
theorem Auth.substitution_exists_at
    {operations : Operations} {policy : Syntax.TicketPolicy} {ports : OperationRows operations}
    {contracts : Contracts} {owners : ContractRows contracts}
    {sourceEnvironment : Environment} {sourceRows : EnvironmentRows sourceEnvironment}
    {result : Value} {resultRows : ValueRows result}
    {checking : Signature dependencies} {checkingRows : Rows checking}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope sourceEnvironment
      code result demand requirements checking}
    (checked : Auth operations policy ports owners sourceRows source resultRows checkingRows) :
∀ (environment : Environment) (destinationRows : EnvironmentRows environment)
      (name : Nat) (input : Value) (inputRows : ValueRows input) (value : Code)
      (same : sourceEnvironment = environment.extend name input),
      (same ▸ sourceRows) = destinationRows.extend name inputRows →
      ∀ (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input),
      Auth operations policy ports owners destinationRows replacement inputRows .pure → ClosedValue value →
      ∃ changed : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
        (code.subst name value) result demand requirements checking,
        Auth operations policy ports owners destinationRows changed resultRows checkingRows := by
  induction checked using Auth.rec
    (motive_2 := fun {contracts} owners {world allowed scope sourceEnvironment} sourceRows {code result} resultRows
      {header dependencies checking} _ checkingRows _ =>
      ∀ (environment : Environment) (destinationRows : EnvironmentRows environment)
      (name : Nat) (input : Value) (inputRows : ValueRows input) (value : Code)
      (same : sourceEnvironment = environment.extend name input),
      (same ▸ sourceRows) = destinationRows.extend name inputRows →
      ∀ (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input),
      Auth operations policy ports owners destinationRows replacement inputRows .pure → ∀ (closed : ClosedValue value),
        ∃ changed : SourcePlannedSources.Body operations policy contracts world allowed scope environment
          (code.subst name value) result header checking,
          AuthBody operations policy ports owners destinationRows resultRows changed checkingRows)
    (motive_3 := fun {contracts} owners {world sourceEnvironment} sourceRows {allowed parameter binder argument} argumentRows
      {input} inputRows {answer} answerRows {resumeEffects closeEffects code held disposes row family plans} _ checkingRows _ =>
      ∀ (environment : Environment) (destinationRows : EnvironmentRows environment)
      (name : Nat) (replacementType : Value) (replacementRows : ValueRows replacementType) (value : Code)
      (same : sourceEnvironment = environment.extend name replacementType),
      (same ▸ sourceRows) = destinationRows.extend name replacementRows →
      ∀ (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value replacementType),
      Auth operations policy ports owners destinationRows replacement replacementRows .pure → ∀ (closed : ClosedValue value),
        ∃ changed : SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
          resumeEffects closeEffects (if name = parameter then code else code.subst name value) held disposes row plans,
          AuthOffer operations policy ports owners destinationRows argumentRows inputRows answerRows changed checkingRows)
    (motive_4 := fun {contracts} owners {world sourceEnvironment} sourceRows {allowed effect answer} answerRows
      {clauses table families plans} _ checkingRows _ =>
      ∀ (environment : Environment) (destinationRows : EnvironmentRows environment)
      (name : Nat) (input : Value) (inputRows : ValueRows input) (value : Code)
      (same : sourceEnvironment = environment.extend name input),
      (same ▸ sourceRows) = destinationRows.extend name inputRows →
      ∀ (replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input),
      Auth operations policy ports owners destinationRows replacement inputRows .pure → ∀ (closed : ClosedValue value),
        ∃ changed : SourcePlannedSources.Declarations operations policy contracts world environment allowed effect answer
          (clauses.subst name value) table (substituteClauses plans name value),
          AuthDeclarations operations policy ports owners destinationRows answerRows changed (checkingRows.substitute name value closed.1)) with
  | unit | boolean | integer | reference =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      cases same
      cases rowsSame
      first
      | exact ⟨_, Auth.unit⟩
      | exact ⟨_, Auth.boolean⟩
      | exact ⟨_, Auth.integer⟩
      | exact ⟨_, Auth.reference (issued := by assumption)⟩
  | @«variable» currentAllowed currentScope variableName variableType contractsHere ownersHere worldHere formed oldEnvironment oldRows known =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      cases same
      cases rowsSame
      simp only [Code.subst]
      split
      · rename_i equal
        subst name
        have valueSame := Option.some.inj (by simpa [Environment.extend] using known)
        cases valueSame
        simp only [ite_true]
        exact ⟨SourcePlannedSources.Values.change_context replacement closed.1 currentAllowed currentScope,
          by simpa only [EnvironmentRows.extend_same] using replacementChecked.value_context closed.1 currentAllowed currentScope⟩
      · rename_i different
        have nextKnown : environment variableName = some variableType := by
          simpa [Environment.extend, different, Ne.symm different] using known
        simp only [if_neg (Ne.symm different)]
        refine ⟨SourcePlannedSources.Expression.variable (allowed := currentAllowed) (scope := currentScope) nextKnown formed, ?_⟩
        simpa [EnvironmentRows.extend, different, Ne.symm different] using
          (Auth.variable (operations := operations) (policy := policy) (ports := ports)
            (owners := ownersHere) (environmentRows := destinationRows) (known := nextKnown) (formed := formed))
  | purePair left right ihLeft ihRight | pair left right ihLeft ihRight =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextLeft, leftChecked⟩ := ihLeft environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextRight, rightChecked⟩ := ihRight environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      first | exact ⟨_, .purePair leftChecked rightChecked⟩ | exact ⟨_, .pair leftChecked rightChecked⟩
  | app function argument ihFunction ihArgument =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextFunction, functionChecked⟩ := ihFunction environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextArgument, argumentChecked⟩ := ihArgument environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .app functionChecked argumentChecked (admitted := by assumption)⟩
  | branch condition yes no ihCondition ihYes ihNo =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextCondition, conditionChecked⟩ := ihCondition environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextYes, yesChecked⟩ := ihYes environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextNo, noChecked⟩ := ihNo environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .branch conditionChecked yesChecked noChecked (same := by assumption)⟩
  | perform operand ih =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextOperand, operandChecked⟩ := ih environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .perform operandChecked (admitted := by assumption) (formed := by assumption)⟩
  | resume operand ih =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextOperand, operandChecked⟩ := ih environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .resume operandChecked (resolved := by assumption) (permission := by assumption)
        (admitted := by assumption) (formed := by assumption)⟩
  | discard =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .discard (known := by assumption) (resolved := by assumption) (permission := by assumption)
        (unprotected := by assumption) (admitted := by assumption)⟩
  | cleanup callback body ihCallback ihBody =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextCallback, callbackChecked⟩ := ihCallback environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextBody, bodyChecked⟩ := ihBody environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .cleanup callbackChecked bodyChecked (admitted := by assumption)⟩
  | typed checked ih =>
      rename_i environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨changed, checked⟩ := ih environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .typed checked (rows := by assumption) (closingRows := by assumption)⟩
  | unavailable =>
      rename_i environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .unavailable⟩
  | nil =>
      rename_i environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      exact ⟨_, .nil⟩
  | @lambda _ _ _ _ _ parameter _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ body captured _ _ _ ih =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      cases same
      cases rowsSame
      have captureAfter := LambdaPortCaptureSupport.substitution_support closed
        (replacementChecked.value_support closed.1) captured
      simp only [Code.subst]
      by_cases equal : name = parameter
      · subst name
        have shadowed := body.environment_cast (Environment.extend_shadow environment parameter input _)
          (EnvironmentRows.extend_shadow destinationRows inputRows _)
        exact (Auth.lambda shadowed (by simpa only [LambdaPortCaptureSupport.captures, Code.subst, if_true] using captureAfter) (outward := by assumption) (formed := by assumption) (latentBound := by assumption)).code_transport (by simp)
      · simp only [if_neg equal]
        have different := equal
        obtain ⟨changed, changedAuth⟩ := ih _ (destinationRows.extend _ _) name input inputRows value
          (Environment.extend_commute environment name _ input _ different)
          (EnvironmentRows.extend_commute destinationRows inputRows _ different)
          (SourcePlannedSources.Values.change_allowed
            (SourcePlannedSources.Values.closed_environment replacement closed _) closed.1 _)
          ((replacementChecked.closed_environment (destinationRows := destinationRows.extend _ _) closed).value_context closed.1 _ .none) closed
        exact ⟨SourcePlannedSources.Expression.lambda changed (by assumption) (by assumption) (by assumption),
          Auth.lambda changedAuth (by simpa only [LambdaPortCaptureSupport.captures, Code.subst, if_neg equal] using captureAfter) (outward := by assumption) (formed := by assumption) (latentBound := by assumption)⟩
  | @bind _ _ _ _ _ _ _ _ _ parameter _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ initializer body ihInitializer ihBody =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      cases same
      cases rowsSame
      obtain ⟨changedInitializer, initializerAuth⟩ := ihInitializer environment destinationRows name input inputRows value rfl rfl replacement replacementChecked closed
      simp only [Code.subst]
      by_cases equal : name = parameter
      · subst name
        have shadowed := body.environment_cast (Environment.extend_shadow environment parameter input _)
          (EnvironmentRows.extend_shadow destinationRows inputRows _)
        exact (Auth.bind initializerAuth shadowed).code_transport (by simp)
      · simp only [if_neg equal]
        have different := equal
        obtain ⟨changed, changedAuth⟩ := ihBody _ (destinationRows.extend _ _) name input inputRows value
          (Environment.extend_commute environment name _ input _ different)
          (EnvironmentRows.extend_commute destinationRows inputRows _ different)
          (SourcePlannedSources.Values.closed_environment replacement closed _)
          (replacementChecked.closed_environment (destinationRows := destinationRows.extend _ _) closed) closed
        exact ⟨SourcePlannedSources.Expression.bind changedInitializer changed, Auth.bind initializerAuth changedAuth⟩
  | handler body declarations ihBody ihDeclarations =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      cases same
      cases rowsSame
      obtain ⟨nextBody, bodyAuth⟩ := ihBody environment destinationRows name input inputRows value rfl rfl
        (SourcePlannedSources.Values.change_allowed replacement closed.1 _)
        (replacementChecked.value_context closed.1 _ .none) closed
      obtain ⟨nextDeclarations, declarationsAuth⟩ := ihDeclarations environment destinationRows name input inputRows value rfl rfl
        (SourcePlannedSources.Values.change_allowed replacement closed.1 _)
        (replacementChecked.value_context closed.1 _ .none) closed
      rename_i oldClauses oldBody oldDeclarations
      rename_i required plans declarationRows
      have changed := ScopedPorts.clauses_typed_substitution (name := name)
        (by simpa only [SourcePlannedTyping.environment_erase_extend, SourceDependencyAnnotations.environment_erase_extend, CoherentSourceTypes.ports_extend] using oldClauses)
        ((SourcePlannedSources.Values.erase (SourcePlannedSources.Values.change_allowed replacement closed.1 []) closed.1).ports .none) closed
      have changedUsage := ScopedExpressions.clauses_usage_substitution (by assumption) closed.1
        (SourceCallableTransport.value_usage (SourcePlannedSources.Values.erase replacement closed.1)) name
      have handlerAuth := Auth.handler bodyAuth declarationsAuth (required := required)
        (clauses := changed) (capabilities := changedUsage)
        (coverage := by simpa only [ScopedPorts.Covers, ScopedTyping.clause_keys_substitution] using (by assumption))
        (unique := by simpa only [ScopedTyping.clause_keys_substitution] using (by assumption))
        (admitted := by assumption)
        (modes := SourceTemplates.clause_modes_substitution (by assumption) closed.1 name)
      exact handlerAuth.signature_transport (by congr 1; exact substitution_signature _ closed.1)
        (Rows.handler_substitute_heq _ _ name value closed.1)
  | resource initializer body ihInitializer ihBody =>
      intro environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      cases same
      cases rowsSame
      obtain ⟨changedInitializer, initializerAuth⟩ := ihInitializer environment destinationRows name input inputRows value rfl rfl replacement replacementChecked closed
      rename_i oldInitializer oldBody
      refine ⟨_, Auth.resource initializerAuth (body := fun identity fresh => ?_) ?_ (formed := by assumption)
        (effectsBound := by assumption) (admitted := by assumption) (hidden := by assumption)⟩
      · rw [Code.instantiation_subst _ name value _ closed.2.1]
        exact SourcePlannedSources.substitution (oldBody identity fresh)
          (SourcePlannedSources.Values.change_allowed
            (SourcePlannedSources.Values.world_weaken replacement (List.subset_append_left _ _)) closed.1 _) closed
      · intro identity fresh
        obtain ⟨changed, changedAuth⟩ := ihBody identity fresh environment destinationRows name input inputRows value rfl rfl
          (SourcePlannedSources.Values.change_allowed
            (SourcePlannedSources.Values.world_weaken replacement (List.subset_append_left _ _)) closed.1 _)
          ((replacementChecked.world_weaken (List.subset_append_left _ _)).value_context closed.1 _ .none) closed
        obtain ⟨nextSource, nextAuth⟩ := changedAuth.code_transport
          (Code.instantiation_subst _ name value _ closed.2.1).symm
        exact nextAuth
  | available body ih =>
      rename_i environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      cases same
      cases rowsSame
      rename_i oldSource
      rename_i inputHere answerHere resumeEffectsHere closeEffectsHere heldHere worldHere allowedHere binderHere parameter codeHere disposesHere rowHere answerRowsHere inputRowsHere resumeInterfaceHere closeInterfaceHere contractsHere ownersHere argumentHere argumentRowsHere familyHere plansHere bodyRowsHere
      refine ⟨_, AuthOffer.available (source := fun owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands => ?_) ?_
        (resumeInterface := by split <;> simpa only [Code.substitution_required_actions _ _ closed.1] using (by assumption))
        (closeInterface := by split <;> simpa only [Code.substitution_required_actions _ _ closed.1] using (by assumption))⟩
      · split
        · rename_i equal
          subst name
          simpa only [Environment.extend_shadow] using
            oldSource owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
        · rename_i different
          exact source_body_substitution_at
            (oldSource owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands)
            (Environment.extend_commute environment name _ input _ different)
            (SourcePlannedSources.Values.closed_environment
              (SourcePlannedSources.Values.extension replacement (SourcePlannedTyping.insert_extends _ fresh)) closed _) closed
      · intro owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
        by_cases equal : name = parameter
        · subst name
          obtain ⟨nextSource, nextAuth⟩ := (body owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands).transport
            (Environment.extend_shadow environment parameter input argumentHere)
            (EnvironmentRows.extend_shadow destinationRows inputRows argumentRowsHere)
            (nextCode := if parameter = parameter then codeHere else codeHere.subst parameter value) (by simp)
          exact nextAuth
        · have different := equal
          obtain ⟨changed, changedAuth⟩ := ih owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
            _ (destinationRows.extend _ _) name input inputRows value
            (Environment.extend_commute environment name _ input _ different)
            (EnvironmentRows.extend_commute destinationRows inputRows _ different)
            (SourcePlannedSources.Values.closed_environment
              (SourcePlannedSources.Values.extension replacement (SourcePlannedTyping.insert_extends _ fresh)) closed _)
            ((replacementChecked.contract_insert fresh _ _).closed_environment (destinationRows := destinationRows.extend _ _) closed) closed
          obtain ⟨nextSource, nextAuth⟩ := changedAuth.transport rfl rfl
            (nextCode := if name = parameter then codeHere else codeHere.subst name value) (by simp [different])
          exact nextAuth
  | cons ordinary protectedMode rest support ihOrdinary ihProtected ihRest =>
      rename_i environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextOrdinary, ordinaryAuth⟩ := ihOrdinary environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextProtected, protectedAuth⟩ := ihProtected environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      obtain ⟨nextRest, restAuth⟩ := ihRest environment destinationRows name input inputRows value same rowsSame replacement replacementChecked closed
      refine ⟨SourcePlannedSources.Declarations.cons (by assumption) nextOrdinary nextProtected nextRest, ?_⟩
      have nextSupport := LambdaPortCaptureSupport.declaration_bound_substitution closed
        (replacementChecked.value_support closed.1) (same ▸ support)
      apply AuthDeclarations.rows_transport
        (AuthDeclarations.cons ordinaryAuth protectedAuth restAuth nextSupport (known := by assumption))
      exact ClauseRows.substitute_cons_heq _ _ _ name _ _ _ _ value closed.1

/-- Authentication follows the existing rich source substitution theorem,
retaining the exact result and checking metadata. -/
theorem Auth.substitution
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment} {inputRows : ValueRows input}
    {source : SourcePlannedSources.Expression operations policy contracts world allowed scope
      (environment.extend name input) code result demand requirements checking}
    {replacement : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input}
    (checked : Auth operations policy ports owners (environmentRows.extend name inputRows)
      source resultRows checkingRows)
    (replacementChecked : Auth operations policy ports owners environmentRows replacement inputRows .pure)
    (closed : ClosedValue value) :
    Auth operations policy ports owners environmentRows
      (SourcePlannedSources.substitution source replacement closed) resultRows checkingRows := by
  obtain ⟨changed, changedAuth⟩ := checked.substitution_exists_at environment environmentRows name input inputRows value
    rfl rfl replacement replacementChecked closed
  exact changedAuth

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows

