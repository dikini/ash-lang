namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourcePlannedTyping (Contract)
open SourceDeclarationPlans (Plan ClausePlans)
open SourcePlanSignatures (Signature signature clauseSignatures)
open SourceDependencyAnnotations (Dependencies)
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Select the actual installed clauses and substitute the authenticated request
payload. The captured demand is retained from this same source split. -/
theorem CaptureSourceAt.selected_body
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    {family : Nat → Dependencies} {bodies : ∀ owner, Signature (family owner)}
    {bodyRows : ∀ owner, Rows (bodies owner)}
    (split : CaptureSourceAt site captured tail)
    (selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
    (expression : site.expression = .perform (Instantiation.freezeEffect effect) operation operand)
    (closed : ClosedValue operand)
    (owner : Nat) (fresh : contracts owner = none)
    (cut : Cut effect operation site.context captured tail selectedContract modes)
    (freshActions : actions owner = none) (absent : owner ∉ site.context.ticketNames)
    (resumeRow : Footprint) (closeRow : Option Footprint) :
    ∃ frontStack : Stack, ∃ handler : HandlerData, ∃ answer residual parameter binder code offered row,
    ∃ answerRows : ValueRows answer, ∃ nextFamily : Nat → Dependencies,
    ∃ plans : ∀ owner, Plan (nextFamily owner), ∃ selectedRows : ∀ owner, Rows (signature (plans owner)),
    ∃ resumeEffects closeEffects,
    ∃ declarationPlans : ClausePlans handler.clauses (families handler),
    ∃ declarationRows : ClauseRows (clauseSignatures declarationPlans),
    ∃ declarations : SourcePlannedSources.Declarations operations policy contracts world (fun _ => none)
      residual handler.effectInst answer handler.clauses (tables handler) declarationPlans,
      split.capturedStack = frontStack.append (.push (.handler handler) .nil) ∧
      handler.effectInst = effect ∧
      answer.erase.erase.port = ScopedPorts.eraseType handler.answer ∧
      ModeRowsValue.Answer answerRows split.boundaryRows ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports handler.scope ∧
      SourcePlannedChecks.Certified (evidence := declarationPolicy) outward world (plans owner) ∧
      ClauseAt operation handler.clauses parameter binder code ∧
      ClosedExcept parameter code ∧
      lookup operation (tables handler) = some offered ∧ offered.row captureScope.held = some row ∧
      CapturedClauseRows effect operation captureScope.held captured selectedRows ∧
      HEq bodyRows selectedRows ∧
      AuthDeclarations operations policy ports owners emptyRows answerRows declarations declarationRows ∧
      TerminalHandler effect handler.activation declarationRows captured ∧
      SourceAdmission.rightsAt operation (clauseSignatures declarationPlans) = some code.requiredActions ∧
      SourceAdmission.Code outward (actions.insert owner code.requiredActions) budget
        (OwnerPhaseTransitions.introduce phases owner) world installations (selectedRows owner)
        (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail) ∧
      (code.requiredActions.resume = true → resumeEffects = residual) ∧
      (code.requiredActions.dispose = true → closeEffects = residual) ∧
      let allocated : Contract :=
        ⟨site.result, answer, captureScope.held, split.savedDemand, resumeRow,
          split.savedDemand, closeRow, resumeEffects, closeEffects⟩
      ∃ source : SourcePlannedSources.Body operations policy (contracts.insert owner allocated) world residual
        (.ticket binder owner) (fun _ => none) (code.subst parameter operand) answer
        ⟨owner, allocated.erase.erase, offered.dispose, row⟩ (signature (plans owner)),
        AuthBody operations policy ports (owners.insert owner site.resultRows answerRows)
          emptyRows answerRows source (selectedRows owner) := by
  obtain ⟨frontStack, handler, answer, residual, parameter, binder, code, offered, row,
    answerRows, nextFamily, plans, selectedRows, resumeEffects, closeEffects,
    declarationPlans, declarationRows, declarations,
    stackEq, effectEq, answerAnnotation, answerMode, callerScope, certified, located, ready, found, offeredRow,
    selectedActual, rowsSame, declarationsAuth, terminal, requiredRights, certificate,
    resumeInterface, closeInterface, authenticated⟩ :=
    split.selected_certificate selected expression closed owner fresh cut freshActions absent
  let allocated : Contract :=
    ⟨site.result, answer, captureScope.held, split.savedDemand, resumeRow,
      split.savedDemand, closeRow, resumeEffects, closeEffects⟩
  obtain ⟨source, bodyAuth⟩ := authenticated allocated rfl rfl rfl rfl rfl (List.Perm.refl _) rfl
  exact ⟨frontStack, handler, answer, residual, parameter, binder, code, offered, row,
    answerRows, nextFamily, plans, selectedRows, resumeEffects, closeEffects,
    declarationPlans, declarationRows, declarations,
    stackEq, effectEq, answerAnnotation, answerMode, callerScope, certified, located, ready, found, offeredRow,
    selectedActual, rowsSame, declarationsAuth, terminal, requiredRights, certificate,
    resumeInterface, closeInterface, source, bodyAuth⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CaptureSourceAt.selected_body

namespace Ash.OneShot.LexicalUnwind
open ScopedExpressions ScopedExecution

/-- Capture reuses the raw lexical step and lifetime event. The new permission
entry records the selected clause's rights, independently of source accounting. -/
theorem capture_lifetime
    (cut : HandlerCut requested whole captured tail handler)
    (selected : ClauseAt operation handler.clauses parameter binder body)
    (closed : ClosedValue operand) (environment : ClosedExcept parameter body)
    (ledger : Ledger (RunState.erase
      ⟨.eval ⟨.perform (Instantiation.freezeEffect requested) operation operand, runtimeScope, whole⟩,
        issued, completed⟩))
    (registry : UsageRegistryHistory tickets issued)
    (ticketHistory : TicketHistory
      ⟨.eval ⟨.perform (Instantiation.freezeEffect requested) operation operand, runtimeScope, whole⟩,
        issued, completed⟩)
    (fresh : (issued ++ [Owner.ticket owner]).Nodup) (rights : Syntax.OneShotRights) :
    let after : RunState :=
      ⟨.eval ⟨body.subst parameter operand, .ticket binder owner,
        .live owner operationResult handler.answer captured handler.scope tail⟩,
        issued ++ [.ticket owner], completed⟩
    Event
      ⟨.eval ⟨.perform (Instantiation.freezeEffect requested) operation operand, runtimeScope, whole⟩,
        issued, completed⟩ after ∧
    Ledger after.erase ∧ UsageRegistryHistory (tickets.insert owner rights) after.issued ∧
    TicketHistory after := by
  have raw := RawStep.capture requested operation parameter binder owner operand body runtimeScope
    whole captured tail handler operationResult cut selected closed environment
  have event : Event
      ⟨.eval ⟨.perform (Instantiation.freezeEffect requested) operation operand, runtimeScope, whole⟩,
        issued, completed⟩
      ⟨.eval ⟨body.subst parameter operand, .ticket binder owner,
        .live owner operationResult handler.answer captured handler.scope tail⟩,
        issued ++ [.ticket owner], completed⟩ := by
    simpa only [List.nil_append] using
      (Event.step (before := ⟨.eval ⟨.perform (Instantiation.freezeEffect requested) operation operand,
        runtimeScope, whole⟩, issued, completed⟩) (.evaluate raw trivial) fresh)
  refine ⟨event, event_preserves_ledger event ledger, ?_, event.ticket_history ticketHistory⟩
  exact raw_step_preserves_usage_registry_history (policy := fun _ => rights) raw registry

end Ash.OneShot.LexicalUnwind
#print axioms Ash.OneShot.LexicalUnwind.capture_lifetime

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)

/-- Install one fresh live frame using the very same captured source and
requirement body. Both possible return boundaries are retained. -/
theorem RecordPendingRows.capture_live
    {contract : SourcePlannedTyping.Contract}
    {savedRequirements : Requirements contract.resumeDemand}
    {tailRequirements : Requirements tailDemand}
    {inputRows : ValueRows contract.input} {boundaryRows : ModeRowsValue boundary}
    {outputRows : ModeRowsValue output}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    {saved : PlannedModeSource operations policy contracts tables families required outward actions world
      capturedStack (.value contract.input) boundary contract.resumeDemand savedRequirements captureScope}
    {waiting : PlannedModeSource operations policy contracts tables families required outward actions world
      tailStack boundary output tailDemand tailRequirements tailScope}
    (savedRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes saved (.value inputRows) boundaryRows captured)
    (tailRows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes waiting boundaryRows outputRows tail)
    (fresh : contracts owner = none) (freshAction : actions owner = none)
    (freshSaved : owner ∉ ownedTickets capturedStack)
    (freshTail : owner ∉ ownedTickets tailStack)
    (answerRows : ValueRows contract.answer)
    (aligned : ModeRowsValue.Answer answerRows boundaryRows)
    (inputAnnotation : contract.input.erase.erase.port = ScopedPorts.eraseType inputType)
    (answerAnnotation : contract.answer.erase.erase.port = ScopedPorts.eraseType answerType)
    (callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller)
    (held : contract.held = captureScope.held) :
    ∃ source : PlannedModeSource operations policy (contracts.insert owner contract) tables families required outward
      (actions.insert owner rights) world
      (.live owner inputType answerType capturedStack caller tailStack)
      (.value contract.answer) output tailDemand (.sequence (.spent owner) tailRequirements)
      (.live owner captureScope tailScope),
      RecordPendingRows operations policy (contracts.insert owner contract) tables families required outward
        (actions.insert owner rights) world ports (owners.insert owner inputRows answerRows) emptyRows
        ((⟨owner, .resume⟩, ⟨contract.resumeDemand, savedRequirements⟩) :: resumes)
        source (.value answerRows) outputRows
        (Context.live (owner := owner) (resumeDemand := contract.resumeDemand) captured tail) := by
  have extension := SourcePlannedTyping.insert_extends (contract := contract) contracts fresh
  have permissions := Syntax.fresh_usage_insert_extends (rights := rights) freshAction
  have portExtension := CoherentSourceTypes.Owners.port_contracts_extension
    (SourceDependencyFrames.erased_contract_extension
      (SourcePlannedCheckedFrames.erased_extension extension))
  have known : (contracts.insert owner contract) owner = some contract := by
    simp [SourcePlannedTyping.Contracts.insert]
  have actionKnown : (actions.insert owner rights) owner = some rights := by
    simp [Syntax.UsageTickets.insert]
  have returns : boundary = .value contract.answer ∨ boundary = .unwind := by
    cases aligned <;> simp
  have inside := (savedRows.contract_insert (rights := rights) fresh freshAction inputRows answerRows).insert_fresh_record
    freshSaved .resume ⟨contract.resumeDemand, savedRequirements⟩
  have outside := (tailRows.contract_insert (rights := rights) fresh freshAction inputRows answerRows).insert_fresh_record
    freshTail .resume ⟨contract.resumeDemand, savedRequirements⟩
  refine ⟨.live known actionKnown inputAnnotation answerAnnotation
    (ScopedPorts.effect_scope_known_extension callerScope portExtension)
    (held.trans saved.realizes.held) (saved.transport extension permissions) returns
    (waiting.transport extension permissions), ?_⟩
  have live := RecordPendingRows.live (known := known) (actionKnown := actionKnown)
    (inputAnnotation := inputAnnotation) (answerAnnotation := answerAnnotation)
    (callerScope := ScopedPorts.effect_scope_known_extension callerScope portExtension)
    (held := held.trans saved.realizes.held) (answer := returns)
    (by simpa [ContractRows.insert] using aligned)
    (ResumeBodyAgreement.capture savedRequirements resumes)
    (by simpa [ContractRows.insert] using inside) outside
  simpa [ContractRows.insert] using live


/-- The actual split supplies both fragments and their exact saved annotation.
The fresh contract stores that same input, protection mode and saved demand. -/
theorem CaptureSourceAt.capture_live
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    (split : CaptureSourceAt site captured tail)
    (fresh : contracts owner = none) (freshAction : actions owner = none)
    (freshOwned : owner ∉ ownedTickets site.stack)
    (answerRows : ValueRows answer)
    (aligned : ModeRowsValue.Answer answerRows split.boundaryRows)
    (answerAnnotation : answer.erase.erase.port = ScopedPorts.eraseType answerType)
    (callerScope : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller)
    (resumeRow : Footprint) (closeDemand : List Nat) (closeRow : Option Footprint)
    (resumeEffects closeEffects : List Instance) :
    let contract : SourcePlannedTyping.Contract :=
      ⟨site.result, answer, captureScope.held, split.savedDemand,
        resumeRow, closeDemand, closeRow, resumeEffects, closeEffects⟩
    ∃ source : PlannedModeSource operations policy (contracts.insert owner contract) tables families required outward
      (actions.insert owner rights) world
      (.live owner (ScopedPorts.embedPort site.result.erase.erase.port) answerType
        split.capturedStack caller split.tailStack)
      (.value answer) output split.tailDemand (.sequence (.spent owner) split.tailRequirements)
      (.live owner captureScope tailScope),
      RecordPendingRows operations policy (contracts.insert owner contract) tables families required outward
        (actions.insert owner rights) world ports (owners.insert owner site.resultRows answerRows) emptyRows
        ((⟨owner, .resume⟩, ⟨split.savedDemand, split.savedRequirements⟩) :: resumes)
        source (.value answerRows) outputRows
        (Context.live (owner := owner) (resumeDemand := split.savedDemand) captured tail) := by
  dsimp only
  have freshPair : owner ∉ ownedTickets (split.capturedStack.append split.tailStack) := by
    rw [← split.stackSplit]
    exact freshOwned
  have freshSaved : owner ∉ ownedTickets split.capturedStack := by
    intro member
    exact freshPair (by rw [owned_tickets_append]; exact List.mem_append_left _ member)
  have freshTail : owner ∉ ownedTickets split.tailStack := by
    intro member
    exact freshPair (by rw [owned_tickets_append]; exact List.mem_append_right _ member)
  exact split.savedRows.capture_live
    (contract := ⟨site.result, answer, captureScope.held, split.savedDemand,
      resumeRow, closeDemand, closeRow, resumeEffects, closeEffects⟩) split.tailRows fresh freshAction freshSaved freshTail
    answerRows aligned (ScopedPorts.erase_embed_port _).symm answerAnnotation callerScope rfl

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.capture_live
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CaptureSourceAt.capture_live

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution
open RecursiveRequirements (Requirements Store)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyAnnotations (StoreAnnotation)

/-- Capture records the exact saved resumption source. Cleanup remains generated
from the lexical source at discard; existing disposal records retain their origin. -/
theorem capture_record_package
    {contract : SourcePlannedTyping.Contract} {requirements : Requirements contract.resumeDemand}
    (cut : HandlerCut requested whole captured tail handler)
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      captured (.value contract.input) boundary contract.resumeDemand requirements capturedScope)
    (returns : boundary = .value contract.answer ∨ boundary = .unwind)
    (scopeSame : receiving = capturedScope.append tailScope)
    (bound : Bound annotations receiving)
    (metadata : CaptureMetadataHistory contracts annotations issued)
    (fresh : (issued ++ [Owner.ticket owner]).Nodup)
    (freshActions : actions owner = none)
    (recorded : ∀ key body, (key, body) ∈ (resumes : Store) →
      PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world whole key body)
    (closing : ∀ key body, (key, body) ∈ (disposals : Store) →
      PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world whole key body)
    (annotation : StoreAnnotation (resumes ++ disposals) annotatedStore)
    (rights : Syntax.OneShotRights) :
    let nextContracts := contracts.insert owner contract
    let nextActions := actions.insert owner rights
    let nextAnnotations := fun other => if other = owner then some capturedScope else annotations other
    let saved := (⟨owner, .resume⟩, ⟨contract.resumeDemand, requirements⟩)
    let nextStack := Stack.live owner input answer captured caller tail
    Bound nextAnnotations (.live owner capturedScope tailScope) ∧
    CaptureMetadataHistory nextContracts nextAnnotations (issued ++ [Owner.ticket owner]) ∧
    (∀ key body, (key, body) ∈ saved :: resumes →
      PlannedResumeAnnotated operations policy nextContracts tables families required outward nextActions nextAnnotations world nextStack key body) ∧
    (∀ key body, (key, body) ∈ disposals →
      PlannedUnwindAnnotated operations policy nextContracts tables families required outward nextActions nextAnnotations world nextStack key body) ∧
    StoreAnnotation ((saved :: resumes) ++ disposals) (saved :: annotatedStore) ∧
    ResumeBodyAgreement (saved :: resumes) owner contract.resumeDemand requirements := by
  obtain ⟨freshContract, freshAnnotation⟩ := metadata.allocated_fresh fresh
  have extension := SourcePlannedTyping.insert_extends (contract := contract) contracts freshContract
  have permissions := Syntax.fresh_usage_insert_extends (rights := rights) freshActions
  have known : (contracts.insert owner contract) owner = some contract := by
    simp [SourcePlannedTyping.Contracts.insert]
  obtain ⟨nextBound, nextRecords, agreement⟩ :=
    capture_planned_resume_records_agreement (input := input) (answer := answer) (caller := caller)
      cut source returns known scopeSame bound freshAnnotation recorded extension permissions
  refine ⟨nextBound, metadata.insert owner contract capturedScope, nextRecords, ?_,
    .cons .original annotation, agreement⟩
  intro key body member
  apply (closing key body member).transport extension permissions
  · intro other scope recorded
    by_cases same : other = owner
    · subst other; rw [freshAnnotation] at recorded; cases recorded
    · simp only [if_neg same]; exact recorded
  · intro other saved located
    rw [handler_cut_reconstructs cut] at located
    rcases SavedCaptureIdentity.located_append.mp located with inside | outside
    · exact .saved inside
    · exact .tail outside

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.capture_record_package



namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
