/-- Start the actual authenticated unwind callback with the same executable root. -/
theorem ExecutableSource.start_unwind_cleanup
    (before : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.unwind runtimeScope (.push (.armed action) tail))) :
    ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.eval ⟨.app action.action .unit, .none, .push (.unwinding action) tail⟩) := by
  cases before with
  | unwind pending coherent certificate waiting bound annotation checked bounded pendingResource =>
    cases coherent with
    | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
        restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest =>
      cases head with
      | cleanup callbackAuth =>
        rename_i dependencies latent callbackPlan bodyRows callbackCertified callback
        cases certificate with | cleanup callbackCertificate tailCertificate =>
          have resourceParts : InstallationSupport.CodeChecked ambient outward callbackCertificate ∧
              InstallationSupport.PendingChecked ambient outward tailCertificate := by
            cases pendingResource with | cleanup callbackResource tailResource =>
              exact ⟨callbackResource.reproof, tailResource.reproof⟩
          obtain ⟨callbackResource, tailResource⟩ := resourceParts
          cases bound with | cleanup restBound =>
            change SourceAdmission.Code _ _ _ _ _ _ bodyRows
              (Context.unwinding (restContext.append .nil).pack.context).pack.context at callbackCertificate
            rw [restContext.append_nil_pack] at callbackCertificate
            have callbackResource := callbackResource.reindex_context
              (congrArg (fun p : Packed => (Context.unwinding p.context).pack) restContext.append_nil_pack)
            let callbackRequirements : Requirements [] := .emitAfter (.sequence (.request [] []) (.request [] [])) [] latent
            have callbackSource : SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
                (.app action.action .unit) .unit [] callbackRequirements
                (signature (.sequence .pure (.sequence .pure callbackPlan))) :=
              .app (SourcePlannedSources.Values.change_context callback action.closed.1 action.requests .none) .unit (List.Subset.refl _)
            have nextAuth : Auth operations policy ports owners emptyRows callbackSource .unit
                (.sequence .pure (.sequence .pure bodyRows)) :=
              .app (callbackAuth.value_context action.closed.1 action.requests .none) .unit (admitted := List.Subset.refl _)
            have nextCertified : Certified (evidence := declarationPolicy) outward world
                (.sequence .pure (.sequence .pure callbackPlan)) :=
              Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
                (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) callbackCertified)
            let next : ExecutionSite ambient operations policy contracts tables families required outward actions
                (available (ownedTickets tail)) world installations resumes budget ports owners emptyRows output outputRows :=
              { expression := .app action.action .unit, runtimeScope := .none,
                stack := .push (.unwinding action) tail,
                result := .unit, resultRows := .unit, allowed := action.requests,
                dependencies := _, plan := .sequence .pure (.sequence .pure callbackPlan),
                rows := .sequence .pure (.sequence .pure bodyRows), sourceDemand := [],
                sourceRequirements := callbackRequirements, receiving := .running restScope,
                hints := .running .unwind restHints, context := .unwinding restContext,
                current := SourceAdmission.Admitted.of_source callbackSource nextAuth
                  (.sequence .pure (.sequence .pure callbackCertificate)) (.unwinding rest.forget.source),
                certified := nextCertified, scopeTyped := ⟨.none, .none⟩,
                pendingDemand := [] ++ restDemand,
                pendingRequirements := .sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) restRequirements,
                pending := .push (.unwinding callback callbackCertified) restSource,
                coherent := .push (.unwinding (certified := callbackCertified) callbackAuth) rest,
                retained := .unwinding tailCertificate,
                currentResource := .sequence .pure (.sequence .pure callbackResource),
                retainedResource := .unwinding tailResource }
            cases waiting with
            | cleanup callbackRun =>
              apply ExecutableSource.eval next rfl (.contextual ?_) (.running restBound) annotation checked bounded
              exact (Accounting.silent_prefix_iff .pure Rows.pure _).mpr
                ((Accounting.silent_prefix_iff .pure Rows.pure _).mpr callbackRun)

/-- Returning Unit resumes the exact interpreted unwind suffix. -/
theorem ExecutableSource.finish_unwind_cleanup
    (before : ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
      resumes annotatedStore budget ports owners emptyRows output outputRows
      (.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩)) :
    ExecutableSource ambient operations policy contracts tables families required outward actions annotations world installations
      resumes annotatedStore budget ports owners emptyRows output outputRows (.unwind action.scope tail) := by
  generalize machineEq : LexicalUnwind.Machine.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩ = machine at before
  cases before with
  | eval site phaseAgreement rooted bound annotation checked bounded =>
    obtain ⟨expressionEq, _runtimeEq, stackEq⟩ := Configuration.mk.inj (LexicalUnwind.Machine.eval.inj machineEq)
    have waiting := rooted.value_wait (by rw [← expressionEq]; trivial)
    rcases site with ⟨expression, currentScope, stack, result, resultRows, allowed,
      dependencies, plan, rows, sourceDemand, sourceRequirements, receiving, hints, context,
      current, certified, scopeTyped, pendingDemand, pendingRequirements, pending, coherent, retained, currentResource, retainedResource⟩
    dsimp only at expressionEq stackEq phaseAgreement waiting bound annotation checked
    subst expression stack
    cases phaseAgreement
    cases coherent with
    | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
        restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest =>
      cases head with
      | ordinary frameRows => cases frameRows
      | unwinding callbackAuth =>
        cases retained with | unwinding tailCertificate =>
          cases waiting with | unwinding tailWaiting =>
            cases bound with | running tailBound =>
              have resourceParts := retainedResource
              cases resourceParts with | unwinding tailResource =>
                exact ExecutableSource.unwind restSource rest tailCertificate tailWaiting tailBound annotation checked bounded tailResource.reproof
  | unwind => cases machineEq

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableSource.start_unwind_cleanup
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutableSource.finish_unwind_cleanup


