/-- The exact focus row split retains the existing cleanup-budget evidence
for the child and the waiting context. No successor budget check is added. -/
theorem FocusRows.budgeted
    (split : FocusRows wholeRows childRows restRows)
    (checked : Budgeted budget phases world installations wholeRows context) :
    Budgeted budget phases world installations childRows (.plain restRows context) ∧
      Budgeted budget phases world installations restRows context := by
  cases split with
  | pure => exact ⟨.pure, .pure⟩
  | sequence =>
      cases checked with
      | sequence first second => exact ⟨first, second⟩
  | pairRight _ =>
      cases checked with
      | sequence first second => exact ⟨second.plain .pure, .pure⟩
  | appArgument _ =>
      cases checked with
      | sequence function rest =>
          cases rest with
          | sequence argument body => exact ⟨argument, body⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
