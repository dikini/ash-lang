/-- Returning Unit completes the cleanup owner and exposes the same
authenticated unwind suffix, using its existing annotation subtree. -/
theorem RetainedState.finish_unwind_cleanup
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, runtimeScope, .push (.unwinding action) tail⟩, issued, completed⟩, actions⟩) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind action.scope tail, issued, .cleanup action.identity :: completed⟩, actions⟩ := by
  have operational := state.joined.finish_unwind_cleanup
  cases state.source with
  | eval current certified scopeTyped pending coherent pendingBudget retained bound finite annotation checked bounded currentCertificate pendingCertificate =>
    rename_i dependencies receiving result allowed currentDemand currentRequirements pendingDemand pendingRequirements
      annotated row plan rows hints context resultRows
    cases plan with
    | pure =>
      rcases current with ⟨currentSource, currentAuth, localCheck, cleanupBudget, contextSource⟩
      cases currentAuth with
      | unit =>
        cases coherent with
        | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
            restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest =>
          cases head with
          | ordinary frameRows => cases frameRows
          | unwinding callbackAuth =>
            cases pendingBudget with | unwinding tailBudget =>
              cases retained with | unwinding tailRetained =>
                cases bound with | running tailBound =>
                  obtain ⟨tailAnnotated, tailAnnotation, tailPath⟩ := annotation.focus
                    (.second (.second .here))
                  obtain ⟨tailRow, tailChecked, tailWithin⟩ := (disposal_subtree_path tailPath).checked checked
                  refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                    operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
                  apply RetainedSource.unwind restSource rest tailBudget tailRetained tailBound ?_
                    tailAnnotation tailChecked (tailWithin.trans bounded)
                    (by cases pendingCertificate with | unwinding tailCertificate => exact tailCertificate)
                  simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
                    Bool.true_and] using finite
    | request | invoke | sequence | choice | handler | cleanup | resource => cases current.source

/-- Finishing the closing marker restores Unit at the recorded caller and
retains the suffix value metadata and annotation check. -/
theorem RetainedState.finish_unwind_close
    (state : RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.unwind runtimeScope (.push (.closing identity caller) tail), issued, completed⟩, actions⟩) :
    RetainedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget ports owners emptyRows output outputRows
      ⟨⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩, actions⟩ := by
  have operational := state.joined.finish_unwind_close
  cases state.source with
  | unwind pending coherent pendingBudget retained bound finite annotation checked bounded pendingCertificate =>
    cases coherent with
    | @push entry frameInput frameMiddle frameDemand frameRequirements layer frame inRows midRows
        restScope restHints restContext hints context restStack result restDemand restRequirements restSource resultRows head rest =>
      cases head with
      | closing =>
        rename_i scopeKnown annotated
        cases pendingBudget with | closing tailBudget =>
          cases retained with | closing tailRetained =>
            cases bound with | running tailBound =>
              have nextCurrent : Admitted operations policy contracts ports owners (fun _ => none) emptyRows
                  world history [] outward caller actions (available (ownedTickets tail)) budget tables families
                  restContext tail .unit .unit [] (.request [] []) .pure .unit .pure :=
                ⟨.unit, .unit, .pure, .pure, rest.forget.source⟩
              obtain ⟨tailAnnotated, tailAnnotation, tailPath⟩ := annotation.focus (.second .here)
              obtain ⟨tailRow, tailChecked, tailWithin⟩ := (disposal_subtree_path tailPath).checked checked
              refine ⟨?_, operational.resumeRecords, operational.unwindRecords, operational.storeAnnotation,
                operational.lifetime, operational.tickets, operational.resources, operational.activations, operational.issuedResources⟩
              apply RetainedSource.eval nextCurrent (Certified.pure (evidence := declarationPolicy)) scopeKnown
