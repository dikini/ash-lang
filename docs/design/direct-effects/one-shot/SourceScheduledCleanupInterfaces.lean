/-- Resource hiding follows both generated disposal alternatives. -/
theorem resource_hides_disposals
    (hidden : ResourceRequirements.Hides identity first second) :
    ResourceRequirements.Hides identity (annotateDisposals first) (annotateDisposals second) := by
  induction hidden with
  | request => exact .request
  | requestThrough exported => exact .requestThrough exported
  | @invoke key demand nearer =>
      cases key with | mk owner mode => cases mode with
      | resume => exact .invoke
      | dispose => exact .choice .invoke .invoke
  | sequence first second ihFirst ihSecond => exact .sequence ihFirst ihSecond
  | emitAfter body ih => exact .emitAfter ih
  | emitThrough body exported ih => exact .emitThrough ih exported
  | choice first second ihFirst ihSecond => exact .choice ihFirst ihSecond

/-- Opening the resource body retains the generated budget and annotation of
its pure initializer and enclosing pending computation. Hiding already belongs
to that same source body; no exclusion of unrelated row names is required. -/
theorem resource_root_annotation
    {closed opened : Requirements demand} {pending : Requirements pendingDemand}
    (receiving : OwnerPhases.Context)
    (annotation : RowAnnotation
      (.sequence ((Requirements.sequence (.request [] []) closed).prepend receiving) pending) annotated)
    (checked : Checked entries outside before (annotateDisposals annotated) row)
    (hidden : ResourceRequirements.Hides identity opened closed) :
    let nextRoot := Requirements.sequence (opened.prepend (.ordinary (.builtin identity) :: receiving))
      (.sequence ((Requirements.request [] []).prepend receiving) pending)
    ∃ nextAnnotated : Requirements (demand ++ pendingDemand), ∃ nextRow,
      RowAnnotation nextRoot nextAnnotated ∧ RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries outside before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row := by
  obtain ⟨normalRow, normalCheck, normalWithin⟩ := (disposal_annotation_map annotation).checked checked
  have splitCheck : Checked entries outside before
      (.sequence ((annotateDisposals closed).prepend receiving) (annotateDisposals pending)) normalRow :=
    RecursiveRequirements.evaluate_sound (by
      simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence,
        RecursiveRequirements.evaluate_prepend, RecursiveRecomposition.evaluate_empty, spendAll,
        RecursiveRecomposition.merge_empty_left, List.nil_append] using RecursiveRequirements.checked_complete normalCheck)
  obtain ⟨bodyRow, pendingRow, bodyCheck, pendingCheck, rowSame⟩ := RecursiveRequirements.checked_sequence_parts splitCheck
  obtain ⟨actualBodyRow, actualBody, bodyWithin⟩ := checked_open_resource_covered
    (RecursiveRequirements.checked_prepend_iff.mp bodyCheck) (resource_hides_disposals hidden)
  let nextRoot := Requirements.sequence (opened.prepend (.ordinary (.builtin identity) :: receiving))
    (.sequence ((Requirements.request [] []).prepend receiving) pending)
  have actualBodyCheck : Checked entries outside before
      (annotateDisposals (opened.prepend (.ordinary (.builtin identity) :: receiving))) actualBodyRow := by
    rw [disposal_prepend]
    exact RecursiveRequirements.checked_prepend_iff.mpr actualBody
  have nextCheck : Checked entries outside before (annotateDisposals nextRoot) (actualBodyRow ++ pendingRow) := by
    apply Checked.sequence actualBodyCheck
    change Checked entries outside (spendAll before demand)
      (.sequence (.request receiving []) (annotateDisposals pending)) ([] ++ pendingRow)
    exact .sequence (.request (by simp [OwnerSource.exportAt, residual_empty])) pendingCheck
  have nextWithin : actualBodyRow ++ pendingRow ⊆ row := by
    apply List.Subset.trans (List.append_subset.mpr
      ⟨bodyWithin.trans (List.subset_append_left _ _), List.subset_append_right _ _⟩)
    simpa only [rowSame] using normalWithin
  exact ⟨.choice nextRoot annotated (.refl _), (actualBodyRow ++ pendingRow) ++ row,
    .alternatives .original (.refl _), .no .here, .no .here, .choice nextCheck checked,
    List.append_subset.mpr ⟨nextWithin, List.Subset.refl _⟩⟩


/-- Fresh resource entry opens the original rich body and extends all retained
sources to the larger resource world. Row coverage preserves the existing effect
bound without additional exclusions for names in rows or invoked saved bodies. -/
theorem enter_resource_planned_generated
    {plan : Plan dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.resource binder initializer body) input currentDemand currentRequirements (signature plan))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value input) output pendingDemand pendingRequirements dependencyScope)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (isValue : initializer.IsValue)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints stack)
    (annotationBound : Bound annotations dependencyScope)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (unique : (ownedTickets stack).Nodup)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨.resource binder initializer body, runtimeScope, stack⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.resource binder initializer body, runtimeScope, stack⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨.resource binder initializer body, runtimeScope, stack⟩)) :
    ∀ identity, identity ∉ world →
    ∃ payload answer residual bodyDependencies, ∃ bodyPlan : Plan bodyDependencies,
    ∃ bodyRequirements : Requirements currentDemand,
    ∃ nextRequirements : Requirements pendingDemand,
    ∃ nextAnnotated : Requirements (currentDemand ++ pendingDemand), ∃ nextRow,
      initializer = .integer payload ∧
      SourcePlannedSources.Expression operations policy contracts (world ++ [identity]) (.cell identity :: residual)
        runtimeScope (fun _ => none) (body.instantiate (Instantiation.Environment.empty.bind binder identity))
        input currentDemand bodyRequirements (signature bodyPlan) ∧
      Certified (evidence := declarationPolicy) outward (world ++ [identity]) bodyPlan ∧
      PlannedModeSource operations policy contracts tables families required outward actions (world ++ [identity])
        (.push (.cell identity payload runtimeScope answer) stack) (.value input) output pendingDemand nextRequirements (.cell identity dependencyScope) ∧
      RowAnnotation
        (.sequence (bodyRequirements.prepend (OwnerPhases.ofStack tables (.push (.cell identity payload runtimeScope answer) stack))) nextRequirements)
        nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases (world ++ [identity]) bodyDependencies (.cell (identity := identity) hints) ∧
      Pending outward actions phases (world ++ [identity]) (.cell (identity := identity) hints) .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families (.cell (identity := identity) hints) (.push (.cell identity payload runtimeScope answer) stack) ∧
      Bound annotations (.cell identity dependencyScope) ∧
      (∀ key saved, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world stack key saved →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations (world ++ [identity])
          (.push (.cell identity payload runtimeScope answer) stack) key saved) ∧
      (∀ key saved, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world stack key saved →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations (world ++ [identity])
          (.push (.cell identity payload runtimeScope answer) stack) key saved) ∧
      RawStep ⟨.resource binder initializer body, runtimeScope, stack⟩
        ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩ [.resource identity] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨.resource binder initializer body, runtimeScope, stack⟩)
        (.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩) [.resource identity] [] ∧
      ownedTickets (.push (.cell identity payload runtimeScope answer) stack) = ownedTickets stack ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩) := by
  have ready := ScopedPorts.typed_resource_closed
    (SourceTemplates.expression_ports (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
      (SourcePlannedSources.expression_erase current))) scopeTyped)
  generalize planSame : signature plan = checking at current
  cases current with
  | resource initial opened formed effectsBound admitted hidden =>
    obtain ⟨payload, initialSame⟩ := ScopedPorts.typed_integer_value
      (SourceTemplates.expression_ports (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
        (SourcePlannedSources.expression_erase initial))) scopeTyped) isValue
    subst initializer
    cases initial
    cases plan with | sequence initialPlan restPlan =>
    cases initialPlan
    cases restPlan with | resource bodyPlans =>
    cases certified with | sequence initialCertified bodyCertified =>
    cases bodyCertified with | resource bodyCertified =>
    cases checked with | sequence initialChecked bodyChecked =>
    cases bodyChecked with | resource bodyChecked =>
    have bodySame := (SourcePlanSignatures.Signature.resource.inj (SourcePlanSignatures.Signature.sequence.inj planSame).2)
    rename_i bodyDemand residual outwardRequirements bodyRequirements bodyDependencies bodySignatures
    intro identity worldFresh
    let answer := ScopedPorts.embedPort input.erase.erase.port
    have noEscape : identity ∉ (ScopedPorts.eraseType answer).resources := by
      simpa only [answer, ScopedPorts.erase_embed_port] using (fun member => worldFresh (formed member))
    have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward (world ++ [identity])
        (.cell identity payload runtimeScope answer) input input [] (.request [] []) (.cell identity) (fun rest => .cell rest)
        (.cell identity :: residual) residual :=
      .cell ⟨_, ScopedPorts.effect_scope_has_types scopeTyped⟩ noEscape
        (by simp only [answer, ScopedPorts.erase_embed_port]) (.cell ⟨_, scopeTyped⟩ noEscape)
    let nextReq := Requirements.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables stack)) pendingRequirements
    obtain ⟨nextAnnotated, nextRow, nextAnnotation, rawPath, generatedPath, nextChecked, nextWithin⟩ :=
      resource_root_annotation (OwnerPhases.ofStack tables stack) annotation rowChecked (hidden identity worldFresh)
    have raw : RawStep ⟨.resource binder (.integer payload) body, runtimeScope, stack⟩
        ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩ [.resource identity] [] :=
      .enterCell binder identity payload body runtimeScope answer stack ready
    have event : LexicalUnwind.UseTransition (.eval ⟨.resource binder (.integer payload) body, runtimeScope, stack⟩)
        (.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩) [.resource identity] [] := .evaluate raw trivial
    have larger : world ⊆ world ++ [identity] := List.subset_append_left _ _
    refine ⟨payload, answer, residual, bodyDependencies identity, bodyPlans identity, bodyRequirements identity, nextReq,
      nextAnnotated, nextRow, rfl,
      ?_, bodyCertified identity worldFresh, .push (.ordinary frame) (pending.world_weaken larger),
      nextAnnotation, rawPath, generatedPath, nextChecked, nextWithin,
      bodyChecked identity worldFresh,
      .cell (SourceDependencySchemes.Lexical.Recursive.pending_transport retained (fun _ h => h) (fun _ _ h => h) larger),
      .cell matching, .cell annotationBound, ?_, ?_, raw, event, rfl, ?_, ?_, ?_⟩
    · simpa only [List.nil_append, ← congrFun bodySame identity] using opened identity worldFresh
    · intro key saved record
      cases record with | resume located known recorded source returns =>
        exact .resume (.push located) known recorded (source.world_weaken larger) returns
    · intro key saved record
      cases record with | dispose located held recorded source =>
        cases source with | paired planned erased same =>
          exact .dispose (.push located) held recorded (.paired (planned.world_weaken larger)
            (erased.transport (fun _ _ h => h) larger) same)
    · simpa only [LexicalUnwind.advanceUseTickets, ScopedExecution.advanceUsageTickets] using
        event.preserves (by intro owner member; simp at member) unique usage
    · simpa only [LexicalUnwind.advanceUseTickets, ScopedExecution.advanceUsageTickets] using
        event.ticket_access (by intro owner member; simp at member) unique usage ticketAccess
    · apply LexicalUnwind.transition_access event.erases resourceAccess
      constructor
      · intro other payload' answer' savedScope scope returned rest same returnedClosed
        cases same
        cases returnedClosed.1
      · intro requested operation operand scope whole cap rest handler same cut operandClosed
        cases same
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
