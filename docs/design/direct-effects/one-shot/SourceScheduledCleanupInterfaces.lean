/-- The existing finite installation check in a coherent enhanced derivation
of the same predecessor. Its initial origin remains a source-admission obligation. -/
inductive JoinedSource.HandlerEntryReady
    (operations : SourcePlannedTyping.Operations) (policy : Syntax.TicketPolicy)
    (contracts : SourcePlannedTyping.Contracts) (tables : CallableProtectionFrames.Tables)
    (families : SourcePlannedFrames.Families) (required : SourceContextualRechecking.Required) (outward : List Instance)
    (actions : Syntax.UsageTickets) (annotations : Nat → Option SourcePlannedFrames.DependencyScope) (world : List Nat)
    (annotatedStore : RecursiveRequirements.Store) (budget : Footprint) (output : PlannedModeValue) :
    {machine : LexicalUnwind.Machine} →
      JoinedSource operations policy contracts tables families required outward actions annotations world
        annotatedStore budget output machine → Prop where
  | eval {plans : ClausePlans priorArms clauseDependencies} {bodyPlan : Plan bodyDependencies}
      {hints : ReturnHints receiving}
      (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
        code input currentDemand currentRequirements
        (signature (.handler (effect := effect) (table := table) needed plans bodyPlan)))
      (certified : Certified (evidence := declarationPolicy) outward world
        (.handler (effect := effect) (table := table) needed plans bodyPlan))
      (scopeTyped : ScopedPorts.EffectScopeKnown contracts.erase.erase.ports runtimeScope)
      (pending : PlannedModeSource operations policy contracts tables families required outward actions world
        stack (.value input) output pendingDemand pendingRequirements receiving)
      (localCheck : Local outward actions (available (ownedTickets stack)) world
        (.handler effect table clauseDependencies bodyDependencies) hints)
      (retained : Pending outward actions (available (ownedTickets stack)) world hints .nil .ordinary output.mode)
      (matching : ReturnHints.Matches tables families hints stack)
      (bound : Bound annotations receiving)
      (finite : SourceContextualRechecking.checkForest required stack receiving .nil = true)
      (annotation : RowAnnotation
        (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
      (checked : Checked (annotateDisposalStore annotatedStore) [] (available (ownedTickets stack))
        (annotateDisposals annotated) row)
      (bounded : row ⊆ budget)
      (supplied : SourceContextualHints.checkRequirements receiving needed = true) :
      HandlerEntryReady operations policy contracts tables families required outward actions annotations world
        annotatedStore budget output
        (JoinedSource.eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded)

private theorem handle_plan_effect
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.handle (Instantiation.freezeEffect effect) code arms) input demand requirements
      (.handler (effect := plannedEffect) (table := table) needed declarationsSignature bodySignature)) :
    plannedEffect = effect := by
  generalize frozen : Instantiation.freezeEffect effect = syntaxEffect at source
  cases source with
  | handler => exact (freeze_effect_injective frozen).symm

/-- Install a fresh lexical handler using the already checked source clauses.
The registry and history extension belong to the same joined successor. -/
theorem JoinedState.enter_handler
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩,
        issued, completed⟩, actions⟩)
    (supplied : state.source.HandlerEntryReady) :
    ∃ handler : HandlerData, ∃ nextTables nextFamilies nextRequired,
      handler.activation ∉ history ∧ handler.scope = runtimeScope ∧ handler.effectInst = effect ∧
      handler.clauses = arms ∧
      (∀ old, old.activation ∈ stack.erase.activations →
        tables old = nextTables old ∧ families old = nextFamilies old ∧ required old = nextRequired old) ∧
      JoinedState operations policy contracts nextTables nextFamilies nextRequired outward annotations world ambient
        (history ++ [handler.activation]) resumes disposals annotatedStore budget output
        ⟨⟨.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩, issued, completed⟩, actions⟩ := by
  cases supplied with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded suppliedNow =>
      have sameEffect := handle_plan_effect current
      cases sameEffect
      obtain ⟨ticket, typed⟩ := scopeTyped
      obtain ⟨handler, nextTables, nextFamilies, nextRequired, residual, bodyRequirements,
        nextRequirements, nextAnnotated, nextRow, fresh, scopeSame, effectSame, clausesSame,
        tableInstalled, familiesInstalled, requiredInstalled, registriesAgree,
        nextSource, nextCertified, nextPending, nextAnnotation, rawPath, generatedPath,
        nextChecked, included, nextLocal, nextRetained, nextMatching, nextBound, nextFinite,
        declarations, nextResumes, nextDisposals, raw, transition, owners, nextUse,
        nextTickets, nextResources⟩ :=
        enter_handler_planned_generated current pending typed certified localCheck retained matching bound
          suppliedNow finite state.activations annotation checked state.lifetime.2.2 state.tickets state.resources
      have event : LexicalUnwind.UseEvent policy
          ⟨⟨.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩,
            issued, completed⟩, actions⟩
          ⟨⟨.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩, issued, completed⟩, actions⟩ := by
        simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
          (LexicalUnwind.UseEvent.step
            (before := ⟨⟨.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩,
              issued, completed⟩, actions⟩)
            transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
      refine ⟨handler, nextTables, nextFamilies, nextRequired, fresh, scopeSame, effectSame,
        clausesSame, registriesAgree, ?_⟩
      refine ⟨?_, (fun key body member => nextResumes key body (state.resumeRecords key body member)),
        (fun key body member => nextDisposals key body (state.unwindRecords key body member)),
        state.storeAnnotation, event.preserves state.lifetime, nextTickets, nextResources, ?_, state.issuedResources⟩
      · exact JoinedSource.eval nextSource nextCertified ⟨ticket, typed⟩ nextPending
          (by simpa only [owners] using nextLocal) (by simpa only [owners] using nextRetained)
          nextMatching nextBound nextFinite nextAnnotation
          (by simpa only [owners] using nextChecked) (included.trans bounded)
      · change (handler.activation :: stack.erase.activations) ⊆ history ++ [handler.activation]
        intro activation member
        rcases List.mem_cons.mp member with same | prior
        · exact same ▸ List.mem_append_right _ List.mem_cons_self
        · exact List.mem_append_left _ (state.activations prior)

/-- Ordinary handler exit preserves the shared source and records while
returning to the scope stored by that exact installation. -/
theorem JoinedState.leave_handler
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨value, handler.scope, tail⟩, issued, completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    obtain ⟨boundary, restScope, nextHints, nextRequirements, nextAnnotated, nextRow,
      empty, nextScope, nextSource, nextCertified, nextPending, nextAnnotation,
      rawPath, generatedPath, nextChecked, included, nextLocal, nextRetained,
      nextMatching, nextBound, nextFinite, declarations, nextResumes, nextDisposals,
      raw, transition, owners, nextUse, nextTickets, nextResources⟩ :=
      leave_handler_planned_generated current pending closed retained matching bound finite annotation checked
        state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨value, handler.scope, tail⟩, issued, completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, (fun key body member => nextResumes key body (state.resumeRecords key body member)),
      (fun key body member => nextDisposals key body (state.unwindRecords key body member)),
      state.storeAnnotation, event.preserves state.lifetime, nextTickets, nextResources, ?_, state.issuedResources⟩
    · exact JoinedSource.eval nextSource nextCertified nextScope nextPending
        (by simpa only [owners] using nextLocal) (by simpa only [owners] using nextRetained)
        nextMatching nextBound nextFinite nextAnnotation
        (by simpa only [owners] using nextChecked) (included.trans bounded)
    · intro activation member
      exact state.activations (List.mem_cons_of_mem _ member)
