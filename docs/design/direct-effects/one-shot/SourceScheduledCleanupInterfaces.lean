end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.computation

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open RecursiveRequirements (Requirements evaluate)
open OwnerPhaseTransitions (spendAll)
open RecursiveContexts (evaluate_request)
open SourcePlanSignatures (Signature signature)
open SourceDeclarationPlans (Plan)
open SourcePlannedChecks (Certified)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local)
open Contextual (Budgeted)

/-- Returning a value adds only its pure immediate row prefixes to the actual
waiting source. The pair-right context is itself pure. -/
inductive PlugRows :
    {whole child : SourceDependencyAnnotations.Dependencies} →
    {wholeSignature : Signature whole} → {childSignature : Signature child} →
    Rows wholeSignature → Rows childSignature → Prop where
  | pure : PlugRows .pure .pure
  | single : PlugRows rows (.sequence .pure rows)
  | double : PlugRows rows (.sequence .pure (.sequence .pure rows))

theorem AuthContext.plug_value_rows
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {plan : Plan dependencies} {hints : ReturnHints receivingScope}
    {receiver : Contextual.Context hints} {checking : Signature dependencies}
    {contextRows : Rows checking}
    {context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
      position input output demand requirements checking}
    {child : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input}
    {inputRows : ValueRows input} {outputRows : ValueRows output}
    (same : signature plan = checking)
    (contextAuth : AuthContext operations policy ports owners environmentRows context inputRows outputRows contextRows)
    (childAuth : Auth operations policy ports owners environmentRows child inputRows .pure)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints)
    (waiting : Budgeted budget phases world installations contextRows receiver) :
    ∃ combined : Requirements demand, ∃ nextDependencies, ∃ nextPlan : Plan nextDependencies,
    ∃ nextRows : Rows (signature nextPlan),
    ∃ source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (position.plug value) output demand combined (signature nextPlan),
      Auth operations policy ports owners environmentRows source outputRows nextRows ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      Local outward actions phases world nextDependencies hints ∧
      Budgeted budget phases world installations nextRows receiver ∧
      PlugRows contextRows nextRows ∧
      ∀ entries receiving before,
        (evaluate entries receiving before combined = evaluate entries receiving before requirements) ∧
        evaluate entries receiving before (annotateDisposals combined) =
          evaluate entries receiving before (annotateDisposals requirements) := by
  have childChecked := childAuth.pure_scope rfl scope
  cases contextAuth with
  | pairLeft right =>
      cases same
      refine ⟨_, _, .sequence .pure plan, _, _, .pair childChecked right,
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
        .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
      intro entries receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
  | pairRight left =>
      cases plan
      refine ⟨_, _, .pure, _, _, .purePair (left.pure_scope rfl scope) childChecked,
        Certified.pure (evidence := declarationPolicy), .pure, .pure, .pure, ?_⟩
      intros; exact ⟨rfl, rfl⟩
  | appFunction argument =>
      cases plan with | sequence argumentPlan bodyPlan =>
        obtain ⟨argumentSame, bodySame⟩ := Signature.sequence.inj same
        cases bodySame
        cases argumentSame
        refine ⟨_, _, .sequence .pure (.sequence argumentPlan bodyPlan), _, _,
          Auth.app childChecked argument (admitted := by assumption),
          Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
          .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
        intro entries receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit,
          RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty, spendAll,
          RecursiveRecomposition.merge_empty_left]
  | appArgument function =>
      cases same
      refine ⟨_, _, .sequence .pure (.sequence .pure plan), _, _,
        Auth.app (function.pure_scope rfl scope) childChecked (admitted := by assumption),
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy))
          (Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified),
        .sequence .pure (.sequence .pure checked), .sequence .pure (.sequence .pure waiting), .double, ?_⟩
      intro entries receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit,
        RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty, spendAll,
        RecursiveRecomposition.merge_empty_left, evaluate_request, List.nil_append]
  | bind body =>
      cases same
      refine ⟨_, _, .sequence .pure plan, _, _, .bind childChecked body,
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
        .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
      intro entries receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
  | branch yes no =>
      cases plan with | choice yesPlan noPlan =>
        obtain ⟨yesSame, noSame⟩ := Signature.choice.inj same
        cases yesSame
        cases noSame
        refine ⟨_, _, .sequence .pure (.choice yesPlan noPlan), _, _, Auth.branch childChecked yes no (same := by assumption),
          Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
          .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
        intro entries receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
  | perform =>
      cases plan
      refine ⟨_, _, .sequence .pure .request, _, _, Auth.perform childChecked (known := by assumption)
        (admitted := by assumption) (formed := by assumption),
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
        .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
      intro entries receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit,
        RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left,
        evaluate_request, List.nil_append]
  | resume =>
      cases plan
      refine ⟨_, _, .sequence .pure .invoke, _, _, Auth.resume childChecked (known := by assumption)
        (resolved := by assumption) (permission := by assumption) (admitted := by assumption) (formed := by assumption),
        Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
        .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
      intro entries receiving before
      constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence,
        RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]
  | cleanup body =>
      cases plan with | cleanup callbackPlan bodyPlan =>
        obtain ⟨callbackSame, bodySame⟩ := Signature.cleanup.inj same
        cases callbackSame
        cases bodySame
        refine ⟨_, _, .sequence .pure (.cleanup callbackPlan bodyPlan), _, _,
          Auth.cleanup childChecked body (admitted := by assumption),
          Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
          .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
        intro entries receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_emit,
          RecursiveRequirements.evaluate_sequence, RecursiveRecomposition.evaluate_empty, spendAll,
          RecursiveRecomposition.merge_empty_left]
  | resource body =>
      cases plan with | resource bodyPlan =>
        have bodySame := Signature.resource.inj same
        cases bodySame
        refine ⟨_, _, .sequence .pure (.resource bodyPlan), _, _, Auth.resource childChecked body
          (formed := by assumption) (effectsBound := by assumption) (admitted := by assumption) (hidden := by assumption),
          Certified.sequence (evidence := declarationPolicy) (Certified.pure (evidence := declarationPolicy)) certified,
          .sequence .pure checked, .sequence .pure waiting, .single, ?_⟩
        intro entries receiving before
        constructor <;> simp only [annotateDisposals, RecursiveRequirements.evaluate_sequence,
          RecursiveRecomposition.evaluate_empty, spendAll, RecursiveRecomposition.merge_empty_left]


theorem AuthContext.plug_value_certified
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {plan : Plan dependencies} {hints : ReturnHints receivingScope}
    {receiver : Contextual.Context hints} {checking : Signature dependencies}
    {contextRows : Rows checking}
    {context : SourcePlannedSources.Context operations policy contracts world environment allowed scope
      position input output demand requirements checking}
    {child : SourcePlannedSources.ValueSummary operations policy contracts world environment allowed value input}
    {inputRows : ValueRows input} {outputRows : ValueRows output}
    (same : signature plan = checking)
    (contextAuth : AuthContext operations policy ports owners environmentRows context inputRows outputRows contextRows)
    (childAuth : Auth operations policy ports owners environmentRows child inputRows .pure)
    (certified : Certified (evidence := declarationPolicy) outward world plan)
    (checked : Local outward actions phases world dependencies hints)
    (waiting : Budgeted budget phases world installations contextRows receiver) :
    ∃ combined : Requirements demand, ∃ nextDependencies, ∃ nextPlan : Plan nextDependencies,
    ∃ nextRows : Rows (signature nextPlan),
    ∃ source : SourcePlannedSources.Expression operations policy contracts world allowed scope environment
      (position.plug value) output demand combined (signature nextPlan),
      Auth operations policy ports owners environmentRows source outputRows nextRows ∧
      Certified (evidence := declarationPolicy) outward world nextPlan ∧
      Local outward actions phases world nextDependencies hints ∧
      Budgeted budget phases world installations nextRows receiver ∧
      ∀ entries receiving before,
        (evaluate entries receiving before combined = evaluate entries receiving before requirements) ∧
        evaluate entries receiving before (annotateDisposals combined) =
          evaluate entries receiving before (annotateDisposals requirements) := by
  obtain ⟨combined, nextDependencies, nextPlan, nextRows, source, authenticated, certified, localCheck, cleanupBudget, rows, evaluation⟩ :=
    contextAuth.plug_value_rows same childAuth certified checked waiting
  exact ⟨combined, nextDependencies, nextPlan, nextRows, source, authenticated, certified, localCheck, cleanupBudget, evaluation⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.AuthContext.plug_value_certified

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- An integer cell update retains the exact decorated context and shared value
metadata, including dormant saved contexts, under the existing rich transport. -/
theorem PendingRows.cell_update
    {hints : ReturnHints dependencyScope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      before input output demand requirements dependencyScope}
    (update : CellUpdate identity old new before after)
    (rows : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context) :
    PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      (source.cell_update update) inputRows outputRows context := by
  induction update generalizing input demand requirements dependencyScope with
  | hit => cases rows with
    | push head rest => cases head with
      | ordinary head => cases head with
        | cell =>
            rename_i interface
            cases interface with
            | cell scopeTyped excluded =>
                rename_i residual resultRows scopeKnown noEscape annotation source
                exact .push (.ordinary (.cell (scopeKnown := by assumption) (noEscape := by assumption)
                  (annotation := by assumption) (interface := .cell (residual := residual) scopeTyped excluded))) rest
      | cell => exact .push .cell rest
  | push miss next ih => cases rows with
    | push head rest =>
        simpa only [RecursiveCells.update_context next] using PendingRows.push head (ih rest)
  | live next ih => cases rows with
    | live aligned saved rest =>
        exact .live (actionKnown := by assumption) (inputAnnotation := by assumption)
          (answerAnnotation := by assumption) (callerScope := by assumption) (held := by assumption)
          (answer := by assumption) aligned saved (ih rest)
    | opening saved rest =>
        have same := RecursiveCells.update_context (tables := tables) next
        simpa only [OwnerPhases.ofStack, same] using PendingRows.opening saved (ih rest)
  | spent next ih => cases rows with
    | spent rest =>
        exact .spent (annotation := by assumption) (callerScope := by assumption) (ih rest)
    | skippedSpent rest => exact .skippedSpent (ih rest)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingRows.cell_update

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (liveNames)

/-- Owners still retained by a decorated scope, including saved captures and
scheduled retirement. Spent markers do not retain ownership. -/
def Context.owned {hints : ReturnHints scope} (context : Context hints) : List Nat :=
  match context with
  | .nil => []
  | .plain _ rest | .handler _ _ rest | .cell rest | .cleanup _ _ rest
  | .normal rest | .unwinding rest | .closing rest | .spent rest => rest.owned
  | .retiring owner rest => owner :: rest.owned
  | .live (owner := owner) saved rest => saved.owned ++ owner :: rest.owned

theorem Context.append_owned {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (head : Context first) (tail : Context second) :
    (head.append tail).owned = head.owned ++ tail.owned := by
  induction head <;> simp_all [Context.append, Context.owned, List.append_assoc] <;> rfl

/-- Successful cleanup projection retains precisely the decorated owners. -/
theorem Context.closing_owned {hints : ReturnHints scope} (context : Context hints)
    (found : context.closing? = some metadata) : metadata.closing.1 = context.owned := by
  induction context with
  | nil => cases found; rfl
  | plain rows tail ih | handler activation rows tail ih | cell tail ih
  | cleanup latent rows tail ih | retiring owner tail ih | spent tail ih =>
      cases same : tail.closing? with
      | none => simp [Context.closing?, same] at found
      | some actual =>
          simp only [Context.closing?, same, Option.map_some, Option.some.injEq] at found
          subst metadata
          simp only [CleanupHints.Metadata.closing, Context.owned, ih same, List.nil_append, List.singleton_append]
  | normal tail ih | unwinding tail ih | closing tail ih => simp [Context.closing?] at found
  | live saved tail ihSaved ihTail =>
      cases savedSame : saved.closing? with
      | none => simp [Context.closing?, savedSame] at found
      | some savedMetadata =>
          cases tailSame : tail.closing? with
          | none => simp [Context.closing?, savedSame, tailSame] at found
          | some tailMetadata =>
              simp [Context.closing?, savedSame, tailSame] at found
              subst metadata
              simp only [CleanupHints.Metadata.closing, Context.owned,
                ihSaved savedSame, ihTail tailSame, List.singleton_append]

/-- Only still-owned live boundaries can affect phase-sensitive dispatch. -/
theorem Context.liveNames_owned {hints : ReturnHints scope} (context : Context hints) :
    liveNames context.context ⊆ context.owned := by
  induction context with
  | nil => exact List.Subset.refl _
  | plain rows rest ih | handler activation rows rest ih | cell rest ih
  | cleanup latent rows rest ih | normal rest ih | unwinding rest ih | closing rest ih | spent rest ih => exact ih
  | retiring owner rest ih => exact ih.trans (List.subset_cons_self _ _)
  | live saved rest ihSaved ihRest =>
      intro owner member
      simp only [Context.context, liveNames, List.mem_cons] at member
      rcases member with same | member
      · subst owner; simp [Context.owned]
      · exact List.mem_append.mpr (.inr (List.mem_cons_of_mem _ (ihRest member)))

/-- Decorated ownership is backed by the exact physical source stack. -/
theorem Context.Source.owned_subset {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack) :
    context.owned ⊆ ownedTickets stack := by
  induction source with
  | nil => exact List.Subset.refl _
  | plain tail ih | handler declaration tail ih | cell tail ih | cleanup callback tail ih
  | normal tail ih | unwinding tail ih | closing tail ih | spent tail ih => exact ih
  | retiring tail ih =>
      intro owner member
      simp only [Context.owned, List.mem_cons] at member
      rcases member with same | member
      · exact List.mem_cons.mpr (.inl same)
      · exact List.mem_cons_of_mem _ (ih member)
  | live saved tail ihSaved ihTail =>
      intro owner member
      simp only [Context.owned, List.mem_append, List.mem_cons] at member
      rcases member with member | same | member
      · exact List.mem_cons_of_mem _ (List.mem_append.mpr (.inl (ihSaved member)))
      · exact List.mem_cons.mpr (.inl same)
      · exact List.mem_cons_of_mem _ (List.mem_append.mpr (.inr (ihTail member)))

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.append_owned
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.closing_owned
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.liveNames_owned
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.owned_subset

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (Phases spend spendAll available liveNames)

private theorem budget_spendAll_spend (before : Phases) (owner : Nat) (owners : List Nat) :
    spendAll (spend before owner) owners = spend (spendAll before owners) owner := by
  funext other
  by_cases same : other = owner <;> simp [OwnerPhaseTransitions.spendAll_at, spend, same]

theorem budget_spend_comm (before : Phases) (first second : Nat) :
    spend (spend before first) second = spend (spend before second) first := by
  funext other
  by_cases a : other = first <;> by_cases b : other = second <;> simp [spend, a, b]

private theorem budget_liveNames_append (first second : OwnerPhases.Context) :
    liveNames (first ++ second) = liveNames first ++ liveNames second := by
  induction first with
  | nil => rfl
  | cons entry rest ih => cases entry <;> simp [liveNames, ih]

private theorem budget_export_spend (absent : owner ∉ liveNames context) :
    OwnerSource.exportAt context (spend before owner) raw = OwnerSource.exportAt context before raw := by
  simp only [OwnerSource.exportAt, OwnerPhaseTransitions.project_spend_absent_live absent]

private theorem metadata_live_names (metadata : CleanupHints.Metadata scope) :
    liveNames metadata.context ⊆ metadata.closing.1 := by
  induction metadata with
  | nil => exact List.Subset.refl _
  | plain rest ih | handler activation rest ih | cell rest ih | cleanup latent rest ih | spent rest ih => exact ih
  | retiring other rest ih => exact ih.trans (List.subset_cons_self _ _)
  | live saved rest ihSaved ihRest =>
      intro other member
      simp only [CleanupHints.Metadata.context, liveNames, List.mem_cons] at member
      rcases member with same | tail
      · subst other; simp [CleanupHints.Metadata.closing]
      · exact List.mem_append.mpr (.inr (List.mem_cons_of_mem _ (ihRest tail)))

private theorem budget_request_parts
    (checked : Checked store receiving before (.request nearer raw) row) :
    OwnerSource.exportAt (nearer ++ receiving) before raw = some row := by
  simpa only [evaluate, RecursiveRequirements.evaluateFuel] using RecursiveRequirements.checked_complete checked

private theorem budget_retire_parts
    (checked : Checked store receiving before (.retire other) row) :
    before other = .available ∧ row = [] := by
  have evaluated := RecursiveRequirements.checked_complete checked
  rw [RecursiveClosing.evaluate_retire] at evaluated
  split at evaluated
  · exact ⟨by assumption, (Option.some.inj evaluated).symm⟩
  · cases evaluated

private theorem budget_spent_parts
    (checked : Checked store receiving before (.spent other) row) :
    before other = .consumed ∧ row = [] := by
  have evaluated := RecursiveRequirements.checked_complete checked
  rw [RecursiveRecomposition.evaluate_spent] at evaluated
  split at evaluated
  · exact ⟨by assumption, (Option.some.inj evaluated).symm⟩
  · cases evaluated

/-- Consuming an owner absent from a cleanup template's retirement demand and
receiving live boundaries preserves its existing successful check. Spent tests
remain valid under consumption, so spent markers need not be excluded. -/
theorem CleanupHints.Metadata.checked_spend_absent
    (metadata : CleanupHints.Metadata scope)
    (absent : owner ∉ metadata.closing.1)
    (outside : owner ∉ liveNames receiving)
    (checked : Checked [] receiving before metadata.closing.2 row) :
    Checked [] receiving (spend before owner) metadata.closing.2 row := by
  induction metadata generalizing receiving before row with
  | nil =>
      exact .request ((budget_export_spend (by simpa using outside)).trans (budget_request_parts checked))
  | plain rest ih | handler activation rest ih | cell rest ih => exact ih absent outside checked
  | cleanup latent rest ih =>
      obtain ⟨firstRow, restRow, firstCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
      refine .sequence (.request ((budget_export_spend ?_).trans (budget_request_parts firstCheck))) (ih absent outside restCheck)
      simp only [budget_liveNames_append, List.mem_append, not_or]
      exact ⟨fun member => absent (metadata_live_names rest member), outside⟩
  | spent rest ih =>
      obtain ⟨firstRow, restRow, firstCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
      obtain ⟨consumed, rfl⟩ := budget_spent_parts firstCheck
      exact .sequence (.spent (RecursiveTransport.phases_spend_later _ consumed)) (ih absent outside restCheck)
  | retiring other rest ih =>
      have separate : owner ≠ other ∧ owner ∉ rest.closing.1 := by
        simpa only [CleanupHints.Metadata.closing, List.singleton_append, List.mem_cons, not_or] using absent
      obtain ⟨firstRow, restRow, firstCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
      obtain ⟨ready, rfl⟩ := budget_retire_parts firstCheck
      refine .sequence (.retire ?_) ?_
      · exact (OwnerPhaseTransitions.spend_other separate.1.symm).trans ready
      · simpa only [spendAll, budget_spend_comm before owner other] using ih separate.2 outside restCheck
  | @live savedScope restScope other saved rest ihSaved ihRest =>
      have separate : owner ∉ saved.closing.1 ∧ owner ≠ other ∧ owner ∉ rest.closing.1 := by
        simpa only [CleanupHints.Metadata.closing, List.mem_append, List.singleton_append, List.mem_cons, not_or] using absent
      obtain ⟨savedRow, remainingRow, savedCheck, remainingCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
      obtain ⟨retireRow, restRow, retireCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts remainingCheck
      obtain ⟨ready, rfl⟩ := budget_retire_parts retireCheck
      refine .sequence (RecursiveRequirements.checked_prepend_iff.mpr (ihSaved separate.1 ?_
        (RecursiveRequirements.checked_prepend_iff.mp savedCheck))) ?_
      · simp only [budget_liveNames_append, liveNames, List.mem_append, not_or]
        exact ⟨fun member => separate.2.2 (metadata_live_names rest member), outside⟩
      · rw [budget_spendAll_spend]
        refine .sequence (.retire ?_) ?_
        · exact (OwnerPhaseTransitions.spend_other separate.2.1.symm).trans ready
        · simpa only [spendAll, budget_spend_comm (spendAll before saved.closing.1) owner other] using
            ihRest separate.2.2 outside restCheck

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.Metadata.checked_spend_absent

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open OwnerPhaseTransitions (spend liveNames)

/-- The finite budget check is stable when only an unrelated owner is consumed. -/
theorem CleanupHints.Metadata.check_spend_absent
    (metadata : CleanupHints.Metadata scope)
    (absent : owner ∉ metadata.closing.1)
    (outside : owner ∉ liveNames receiving)
    (checked : metadata.check receiving before budget = true) :
    metadata.check receiving (spend before owner) budget = true := by
  obtain ⟨row, evaluated, bounded⟩ := metadata.check_iff.mp checked
  exact metadata.check_iff.mpr ⟨row, RecursiveRequirements.checked_complete
    (metadata.checked_spend_absent absent outside (RecursiveRequirements.evaluate_sound evaluated)), bounded⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (spend liveNames)

/-- Existing selected-handler cleanup checks survive retirement outside the
receiving scope and its saved captures. -/
theorem RequestBudget.spend_absent
    {hints : ReturnHints scope} {context : Context hints}
    (checked : RequestBudget budget phases effect operation context)
    (absent : owner ∉ context.owned) :
    RequestBudget budget (spend phases owner) effect operation context := by
  cases found : select effect operation context with
  | none => exact .unselected found
  | some selected =>
      cases selected with
      | builtin identity => exact .builtin found
      | handler captured tail contract modes =>
          have cut : Cut effect operation context captured.context tail.context contract modes := found
          have owned : context.owned = captured.context.owned ++ tail.context.owned := by
            have same := congrArg (fun packed : Packed => packed.context.owned) cut.decomposition
            exact same.trans (Context.append_owned captured.context tail.context)
          have separated : owner ∉ captured.context.owned ∧ owner ∉ tail.context.owned := by
            simpa only [owned, List.mem_append, not_or] using absent
          unfold RequestBudget
          rw [found]
          intro consuming
          obtain ⟨metadata, projection, ordinary, protectedCheck⟩ := checked.consuming cut consuming
          have noDemand : owner ∉ metadata.closing.1 := by
            rw [captured.context.closing_owned projection]
            exact separated.1
          have noReceiver : owner ∉ liveNames tail.context.context :=
            fun member => separated.2 (tail.context.liveNames_owned member)
          exact ⟨metadata, projection,
            metadata.check_spend_absent noDemand noReceiver ordinary,
            metadata.check_spend_absent noDemand noReceiver protectedCheck⟩

/-- Consume an owner absent from the receiving lexical scope without
rechecking any source body or callback. -/
theorem Budgeted.spend_absent
    (checked : Budgeted budget phases world installations rows context)
    (absent : owner ∉ context.owned) :
    Budgeted budget (spend phases owner) world installations rows context := by
  induction checked with
  | pure => exact .pure
  | request checked => exact .request (checked.spend_absent absent)
  | invoke => exact .invoke
  | sequence first second ihFirst ihSecond => exact .sequence (ihFirst absent) (ihSecond absent)
  | choice left right ihLeft ihRight => exact .choice (ihLeft absent) (ihRight absent)
  | handler body ih => exact .handler (fun activation fresh => ih activation fresh absent)
  | cleanup body callback ihBody ihCallback => exact .cleanup (ihBody absent) (ihCallback absent)
  | resource body ih => exact .resource (fun identity fresh => ih identity fresh absent)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupHints.Metadata.check_spend_absent
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RequestBudget.spend_absent
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Budgeted.spend_absent

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open OwnerPhaseTransitions (spend)

theorem Context.callback_owned {hints : ReturnHints scope} (mode : LexicalUnwind.UseMode) (context : Context hints) :
    (context.callback mode).owned = context.owned := by
  cases mode <;> rfl

/-- The pending-stack induction changes phases only through the same
code-budget transport, retaining every saved and external lexical receiver. -/
theorem PendingBudget.spend_absent
    (checked : PendingBudget budget phases world installations context outside input output)
    (absent : owner ∉ (context.append outside).owned) :
    PendingBudget budget (spend phases owner) world installations context outside input output := by
  induction checked with
  | nil => exact .nil
  | plain code tail ih =>
      have restAbsent := absent
      simp only [Context.append, Context.owned] at restAbsent
      exact .plain (code.spend_absent restAbsent) (ih restAbsent)
  | skipped tail ih => exact .skipped (ih absent)
  | handler tail ih => exact .handler (ih absent)
  | cell tail ih => exact .cell (ih absent)
  | cleanup code tail ih =>
      have restAbsent := absent
      simp only [Context.append, Context.owned] at restAbsent
      apply PendingBudget.cleanup (code.spend_absent ?_) (ih restAbsent)
      simpa only [Context.callback_owned] using restAbsent
  | normal tail ih => exact .normal (ih absent)
  | unwinding tail ih => exact .unwinding (ih absent)
  | closing tail ih => exact .closing (ih absent)
  | retiring tail ih =>
      apply PendingBudget.retiring (ih ?_)
      exact fun member => absent (List.mem_cons_of_mem _ member)
  | live saved tail ihSaved ihTail =>
      apply PendingBudget.live (ihSaved ?_) (ihTail ?_)
      · intro member
        apply absent
        simp only [Context.append_owned, Context.append, Context.owned, List.mem_append, List.mem_cons] at member ⊢
        rcases member with inside | outside
        · exact .inl inside
        · exact .inr (.inr outside)
      · exact fun member => absent (List.mem_append.mpr (.inr (List.mem_cons_of_mem _ member)))
  | opening saved tail ihSaved ihTail =>
      apply PendingBudget.opening (ihSaved ?_) (ihTail ?_)
      · simpa only [Context.append_owned, Context.append, Context.owned] using absent
      · exact fun member => absent (List.mem_append.mpr (.inr (List.mem_cons_of_mem _ member)))
  | spent tail ih => exact .spent (ih absent)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingBudget.spend_absent

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (available spend)

/-- A retiring owner absent from the physical suffix cannot invalidate that
suffix's retained cleanup budget. The decorated ownership premise is derived
from the same coherent source, rather than supplied as a successor check. -/
theorem pending_budget_retire_from_source
    {hints : ReturnHints scope} {context : Context hints}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (coherent : PendingRows operations policy contracts tables families required outward actions world ports owners emptyRows
      source inputRows outputRows context)
    (checked : PendingBudget budget (available (owner :: ownedTickets stack)) world installations
      context .nil inputMode outputMode)
    (absent : owner ∉ ownedTickets stack) :
    PendingBudget budget (available (ownedTickets stack)) world installations context .nil inputMode outputMode := by
  have decoratedAbsent : owner ∉ (context.append .nil).owned := by
    simp only [Context.append_owned, Context.owned, List.append_nil]
    exact fun member => absent (coherent.source.owned_subset member)
  have changed := checked.spend_absent decoratedAbsent
  simpa only [OwnerPhaseTransitions.spend_available_cons absent] using changed

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.pending_budget_retire_from_source

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

/-- Extending installation history preserves all pending checks, including
saved continuations and callbacks, because future source handlers quantify over
every activation still fresh in the larger history. -/
theorem PendingBudget.installations_mono
    (checked : PendingBudget budget phases world installations context outside input output)
    (larger : installations ⊆ nextInstallations) :
    PendingBudget budget phases world nextInstallations context outside input output := by
  induction checked with
  | nil => exact .nil
  | plain code tail ih => exact .plain (code.installations_mono larger) ih
  | skipped tail ih => exact .skipped ih
  | handler tail ih => exact .handler ih
  | cell tail ih => exact .cell ih
  | cleanup code tail ih => exact .cleanup (code.installations_mono larger) ih
  | normal tail ih => exact .normal ih
  | unwinding tail ih => exact .unwinding ih
  | closing tail ih => exact .closing ih
  | retiring tail ih => exact .retiring ih
  | live saved tail ihSaved ihTail => exact .live ihSaved ihTail
  | opening saved tail ihSaved ihTail => exact .opening ihSaved ihTail
  | spent tail ih => exact .spent ih

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.PendingBudget.installations_mono

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
