namespace Ash.OneShot.RecursiveRequirements
open Syntax (UseState)
open OwnerPhaseTransitions (Phases spend spendAll)

/-- A local owner is checked where it is bound. Only its retirement and spent
markers disappear from the enclosing ownership computation. -/
inductive LocalOwner (owner : Nat) : UseState → {localDemand : List Nat} →
    Requirements localDemand → {outerDemand : List Nat} → Requirements outerDemand → UseState → Prop where
  | empty : LocalOwner owner phase (.request [] []) (.request [] []) phase
  | retireSelf : LocalOwner owner .available (.retire owner) (.request [] []) .consumed
  | spentSelf : LocalOwner owner .consumed (.spent owner) (.request [] []) .consumed
  | retireOther (different : other ≠ owner) : LocalOwner owner phase (.retire other) (.retire other) phase
  | spentOther (different : other ≠ owner) : LocalOwner owner phase (.spent other) (.spent other) phase
  | sequence (first : LocalOwner owner before localFirst outerFirst middle)
      (second : LocalOwner owner middle localSecond outerSecond after) :
      LocalOwner owner before (.sequence localFirst localSecond) (.sequence outerFirst outerSecond) after
  | choice (first : LocalOwner owner before localFirst outerFirst after)
      (second : LocalOwner owner before localSecond outerSecond after) :
      LocalOwner owner before (.choice localFirst localSecond localSame) (.choice outerFirst outerSecond outerSame) after

def withPhase (phases : Phases) (owner : Nat) (phase : UseState) : Phases :=
  fun other => if other = owner then phase else phases other

theorem LocalOwner.spend_eq
    (binding : LocalOwner owner before (localRoot : Requirements localDemand) (outerRoot : Requirements outerDemand) after)
    (phases : Phases) :
    spendAll (withPhase phases owner before) localDemand =
      withPhase (spendAll phases outerDemand) owner after := by
  induction binding generalizing phases with
  | empty | spentSelf | spentOther => rfl
  | retireSelf =>
      funext other
      by_cases own : other = owner <;> simp [spendAll, spend, withPhase, own]
  | retireOther different =>
      funext key
      simp only [spendAll, spend, withPhase]
      by_cases own : key = owner
      · subst key; simp [Ne.symm different]
      · simp [own]
  | sequence first second ihFirst ihSecond =>
      simp only [PhaseRechecking.spendAll_append, ihFirst, ihSecond]
  | choice first second ihFirst ihSecond => exact ihFirst phases

/-- The local owner contributes no effect row; its phase checks are discharged
by the structural binding derivation. -/
theorem LocalOwner.evaluate_eq
    (binding : LocalOwner owner before (localRoot : Requirements localDemand) (outerRoot : Requirements outerDemand) after)
    (phases : Phases) :
    evaluate store receiving (withPhase phases owner before) localRoot =
      evaluate store receiving phases outerRoot := by
  induction binding generalizing phases with
  | empty | retireSelf | spentSelf =>
      simp [evaluate, evaluateFuel, withPhase, PhaseRechecking.checkOwners,
        OwnerSource.exportAt, ProtectionResiduals.residual_empty]
  | retireOther different =>
      simp [evaluate, evaluateFuel, withPhase, PhaseRechecking.checkOwners, different]
  | spentOther different =>
      simp [evaluate, evaluateFuel, withPhase, different]
  | sequence first second ihFirst ihSecond =>
      simp only [evaluate_sequence, ihFirst, first.spend_eq, ihSecond]
  | choice first second ihFirst ihSecond =>
      simp only [evaluate_choice, ihFirst, ihSecond]

/-- The local check is derived from the enclosing check; it is not an
independent premise about the successor program. -/
theorem LocalOwner.checked
    (binding : LocalOwner owner before (localRoot : Requirements localDemand) (outerRoot : Requirements outerDemand) after)
    (checked : Checked store receiving phases outerRoot row) :
    Checked store receiving (withPhase phases owner before) localRoot row :=
  evaluate_sound ((binding.evaluate_eq phases).trans (checked_complete checked))

end Ash.OneShot.RecursiveRequirements
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.spend_eq
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.evaluate_eq
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.checked

namespace Ash.OneShot.RecursiveRequirements

/-- The only demand removed by local discharge is its single retirement. -/
theorem LocalOwner.demand_balance
    (binding : LocalOwner owner before (localRoot : Requirements localDemand)
      (outerRoot : Requirements outerDemand) after) :
    match before, after with
    | .available, .available => localDemand.Perm outerDemand
    | .available, .consumed => localDemand.Perm (owner :: outerDemand)
    | .consumed, .available => False
    | .consumed, .consumed => localDemand.Perm outerDemand := by
  induction binding with
  | @empty phase => cases phase <;> exact List.Perm.refl _
  | retireSelf => exact .refl _
  | spentSelf => exact .refl _
  | @retireOther other phase different => cases phase <;> exact List.Perm.refl _
  | @spentOther other phase different => cases phase <;> exact List.Perm.refl _
  | @sequence before localFirstDemand localFirst outerFirstDemand outerFirst middle
      localSecondDemand localSecond outerSecondDemand outerSecond after first second ihFirst ihSecond =>
      cases before <;> cases middle <;> cases after <;> simp only at ihFirst ihSecond ⊢
      · exact ihFirst.append ihSecond
      · exact (ihFirst.append ihSecond).trans List.perm_middle
      · exact ihFirst.append ihSecond
      · exact ihFirst.append ihSecond
  | @choice before localFirstDemand localFirst outerFirstDemand outerFirst after
      localSecondDemand localSecond outerSecondDemand outerSecond localSame outerSame first second ihFirst ihSecond =>
      cases before <;> cases after <;> exact ihFirst

theorem LocalOwner.demand_discharge
    (binding : LocalOwner owner .available (localRoot : Requirements localDemand)
      (outerRoot : Requirements outerDemand) .consumed) :
    localDemand.Perm (owner :: outerDemand) := binding.demand_balance

/-- Enclosing demand contains no occurrence of the locally bound owner. -/
theorem LocalOwner.outer_absent
    (binding : LocalOwner owner before (localRoot : Requirements localDemand)
      (outerRoot : Requirements outerDemand) after) : owner ∉ outerDemand := by
  induction binding with
  | empty | retireSelf | spentSelf | spentOther => simp
  | retireOther different => simp [Ne.symm different]
  | sequence first second ihFirst ihSecond => simp [ihFirst, ihSecond]
  | choice first second ihFirst ihSecond => exact ihFirst

end Ash.OneShot.RecursiveRequirements
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.demand_balance
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.demand_discharge
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.outer_absent

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked LocalOwner withPhase)
open OwnerPhaseTransitions (available)

/-- The exact lexical cut determines the local owner's position without
discarding any owners nested in captured continuations. -/
theorem Cut.local_owned
    (cut : Cut effect operation whole captured tail contract modes) :
    (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail).owned.Perm
      (owner :: whole.owned) := by
  have same := congrArg (fun packed : Packed => packed.context.owned) cut.decomposition
  change whole.owned = (captured.append tail).owned at same
  rw [same, Context.append_owned]
  exact List.perm_middle

private theorem withPhase_available (owners : List Nat) (owner : Nat) :
    withPhase (available owners) owner .available = available (owner :: owners) := by
  funext key
  by_cases own : key = owner <;> simp [withPhase, available, own]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Cut.local_owned




namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)

theorem RecordPendingRows.ticketNames_eq
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context) :
    context.ticketNames = stack.erase.ticketNames :=
  rows.forget.source.ticketNames_eq

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.ticketNames_eq

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements)
open LexicalUnwind (UseMode)

/- Accounting follows the whole continuation once. This bounded interpretation
covers structural sequencing and continuation transfer; source authentication
and the finite requirement check remain independent judgments. -/
mutual
inductive Run : (world installations : List Nat) → {dependencies : SourceDependencyAnnotations.Dependencies} →
    {checking : Signature dependencies} → Rows checking →
    {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} → Context hints →
    {demand : List Nat} → Requirements demand → Prop where
  | pure (continuation : Wait world installations context .ordinary root) : Run world installations .pure context root
  | builtin (found : select effect operation context = some (.builtin identity))
      (continuation : Wait world installations context .ordinary root) :
      Run world installations (Rows.request (effect := effect) (operation := operation)) context root
  | request
      {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
      {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
      {family : Nat → SourceDependencyAnnotations.Dependencies}
      {bodies : ∀ owner, Signature (family owner)} {bodyRows : ∀ owner, Rows (bodies owner)}
      {localDemand : Nat → List Nat → List Nat}
      {localRoot : ∀ owner (resumeDemand : List Nat), Requirements (localDemand owner resumeDemand)}
      (cut : Cut effect operation whole captured tail contract modes)
      (selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
      (body : ∀ owner resumeDemand, owner ∉ whole.ticketNames →
        Run world installations (bodyRows owner)
          (.live (owner := owner) (resumeDemand := resumeDemand) captured tail) (localRoot owner resumeDemand))
      (binding : ∀ owner resumeDemand, owner ∉ whole.ticketNames →
        RecursiveRequirements.LocalOwner owner .available (localRoot owner resumeDemand) root .consumed) :
      Run world installations (Rows.request (effect := effect) (operation := operation)) whole root
  | sequence (first : Run world installations firstRows (.plain secondRows context) root) :
      Run world installations (.sequence firstRows secondRows) context root
  | installHandler
      (body : ∀ activation, activation ∉ installations →
        Run world (activation :: installations) bodyRows
          (.handler (effect := effect) (table := table) activation declarations context) root) :
      Run world installations
        (.handler (effect := effect) (table := table) (required := required) declarations bodyRows) context root
  | installResource
      (body : ∀ identity, identity ∉ world →
        Run (world ++ [identity]) installations (bodyRows identity) (.cell (identity := identity) context) root) :
      Run world installations (.resource bodyRows) context root
  | installCleanup
      (body : Run world installations bodyRows (.cleanup (needs := needs) latent callbackRows context) root) :
      Run world installations (.cleanup (needs := needs) latent callbackRows bodyRows) context root
  | choice {firstRoot : Requirements firstDemand} {secondRoot : Requirements secondDemand}
      (left : Run world installations first context firstRoot) (right : Run world installations second context secondRoot)
      (same : firstDemand.Perm secondDemand) :
      Run world installations (.choice first second) context (.choice (a := firstDemand) (b := secondDemand) firstRoot secondRoot same)
  | resume {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
      {tailHints : ReturnHints tailScope} {front : Context frontHints}
      {captured : Context capturedHints} {tail : Context tailHints}
      (located : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
        ⟨frontScope, capturedScope, tailScope⟩)
      (restored : Wait world installations (captured.append (front.append (.spent (owner := owner) tail))) .ordinary root) :
      Run world installations (.invoke (key := ⟨owner, .resume⟩))
        (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail))
        (.sequence (.retire owner) root)

  | dispose {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
      {tailHints : ReturnHints tailScope} {front : Context frontHints}
      {captured : Context capturedHints} {tail : Context tailHints}
      (located : OwnerCut owner (frontScope.append (.live owner capturedScope tailScope))
        ⟨frontScope, capturedScope, tailScope⟩)
      (abandoned : Wait world installations
        (captured.append (.closing (front.append (.spent (owner := owner) tail)))) .unwind root) :
      Run world installations (.invoke (key := ⟨owner, .dispose⟩))
        (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail))
        (.sequence (.retire owner) root)

inductive Wait : (world installations : List Nat) → {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} →
    Context hints → UseMode → {demand : List Nat} → Requirements demand → Prop where
  | nil : Wait world installations .nil mode (.request [] [])
  | plain (code : Run world installations rows tail root) : Wait world installations (.plain rows tail) .ordinary root
  | skipped (tail : Wait world installations context .unwind root) : Wait world installations (.plain rows context) .unwind root
  | handler (tail : Wait world installations context mode root) : Wait world installations (.handler activation declarations context) mode root
  | cell (tail : Wait world installations context mode root) : Wait world installations (.cell (identity := identity) context) mode root
  | cleanup (callback : Run world installations callbackRows (context.callback mode) root) :
      Wait world installations (.cleanup (needs := needs) latent callbackRows context) mode root
  | normal (tail : Wait world installations context .ordinary root) : Wait world installations (.normal context) .ordinary root
  | unwinding (tail : Wait world installations context .unwind root) : Wait world installations (.unwinding context) .ordinary root
  | closing (tail : Wait world installations context .ordinary root) : Wait world installations (.closing context) mode root
  | retiring (tail : Wait world installations context mode root) :
      Wait world installations (.retiring owner context) mode (.sequence (.retire owner) root)
  | live {saved : ReturnHints savedScope} {captured : Context saved}
      (tail : Wait world installations context (saved.returnMode .ordinary) root) :
      Wait world installations (.live (owner := owner) (resumeDemand := resumeDemand) captured context) .ordinary
        (.sequence (.spent owner) root)
  | opening (captured : Wait world installations (saved.append (.retiring owner context)) .unwind root) :
      Wait world installations (.live (owner := owner) (resumeDemand := resumeDemand) saved context) .unwind root
  | spent (tail : Wait world installations context mode root) :
      Wait world installations (.spent (owner := owner) context) mode (.sequence (.spent owner) root)
end


/-- Silent row structure contributes no execution beyond its continuation.
This includes pair-valued prefixes whose rows contain sequences. -/
theorem silent_iff
    (silent : dependencies.Silent) {checking : Signature dependencies}
    (rows : Rows checking) {hints : ReturnHints scope} {context : Context hints}
    {root : Requirements demand} : Run world installations rows context root ↔ Wait world installations context .ordinary root := by
  induction silent generalizing scope demand with
  | pure =>
      cases rows
      exact ⟨fun proof => by cases proof with | pure pending => exact pending, Run.pure⟩
  | sequence left right ihLeft ihRight =>
      cases rows with
      | sequence leftRows rightRows =>
          constructor
          · intro proof
            cases proof with
            | sequence first =>
                have waiting := (ihLeft leftRows).mp first
                cases waiting with
                | plain next => exact (ihRight rightRows).mp next
          · intro pending
            exact .sequence ((ihLeft leftRows).mpr (.plain ((ihRight rightRows).mpr pending)))

/-- A silent initializer is discharged by the same generic lemma at bind and
at each of the two value prefixes of beta reduction. -/
theorem silent_prefix_iff
    (silent : firstDependencies.Silent) {first : Signature firstDependencies}
    (firstRows : Rows first) (secondRows : Rows second)
    {hints : ReturnHints scope} {context : Context hints} {root : Requirements demand} :
    Run world installations (.sequence firstRows secondRows) context root ↔ Run world installations secondRows context root := by
  constructor
  · intro proof
    cases proof with
    | sequence inside =>
        have waiting := (silent_iff silent firstRows).mp inside
        cases waiting with | plain next => exact next
  · intro next
    exact .sequence ((silent_iff silent firstRows).mpr (.plain next))

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.silent_iff
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.silent_prefix_iff

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts
open SourcePlanSignatures (Signature)
open SourceDependencyChecks.Lexical (ReturnHints)
open RecursiveRequirements (Requirements)

/-- Values reuse the established structural silence proof, including pairs. -/
theorem value_iff
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result sourceDemand sourceRequirements checking)
    (isValue : code.IsValue) (rows : Rows checking)
    {context : Context hints} {root : Requirements demand} :
    Run world installations rows context root ↔ Wait world installations context .ordinary root :=
  silent_iff (SourceDependencyAnnotations.value_silent
    (SourcePlannedSources.expression_erase source) isValue) rows

/-- Binding removes its actual value prefix; authenticated substitution already
retains the body rows, so accounting needs no second substitution induction. -/
theorem bind_iff
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.bind parameter value body) result sourceDemand sourceRequirements (.sequence initialSignature bodySignature))
    (isValue : value.IsValue) (initialRows : Rows initialSignature) (bodyRows : Rows bodySignature)
    {context : Context hints} {root : Requirements demand} :
    Run world installations (.sequence initialRows bodyRows) context root ↔ Run world installations bodyRows context root := by
  cases source with
  | bind initializer body =>
    exact silent_prefix_iff (SourceDependencyAnnotations.value_silent
      (SourcePlannedSources.expression_erase initializer) isValue) initialRows bodyRows

/-- The same prefix law discharges both values of beta reduction. -/
theorem beta_iff
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.app (.lambda parameter body) value) result sourceDemand sourceRequirements
      (.sequence functionSignature (.sequence argumentSignature bodySignature)))
    (isValue : value.IsValue) (functionRows : Rows functionSignature)
    (argumentRows : Rows argumentSignature) (bodyRows : Rows bodySignature)
    {context : Context hints} {root : Requirements demand} :
    Run world installations (.sequence functionRows (.sequence argumentRows bodyRows)) context root ↔ Run world installations bodyRows context root := by
  cases source with
  | app function argument admitted =>
    exact (silent_prefix_iff (SourceDependencyAnnotations.value_silent
      (SourcePlannedSources.expression_erase function) trivial) functionRows (.sequence argumentRows bodyRows)).trans
      (silent_prefix_iff (SourceDependencyAnnotations.value_silent
        (SourcePlannedSources.expression_erase argument) isValue) argumentRows bodyRows)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.value_iff
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.bind_iff
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.beta_iff


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements)

theorem Run.mono {root : Requirements demand}
    (run : Run world installations rows context root)
    (worldLarger : world ⊆ nextWorld) (historyLarger : installations ⊆ nextInstallations) :
    Run nextWorld nextInstallations rows context root := by
  induction run using Run.rec
      (motive_2 := fun world installations {_} {_} context mode {demand} root _ =>
        ∀ nextWorld nextInstallations, world ⊆ nextWorld → installations ⊆ nextInstallations →
          Wait nextWorld nextInstallations context mode root)
      generalizing nextWorld nextInstallations with
  | pure waiting ih => exact .pure (ih _ _ worldLarger historyLarger)
  | builtin found waiting ih => exact .builtin found (ih _ _ worldLarger historyLarger)
  | request cut selected body binding ih =>
      exact .request cut selected (fun owner demand fresh => ih owner demand fresh worldLarger historyLarger) binding
  | sequence first ih => exact .sequence (ih worldLarger historyLarger)
  | installCleanup body ih => exact .installCleanup (ih worldLarger historyLarger)
  | installHandler body ih =>
      apply Run.installHandler
      intro activation fresh
      apply ih activation (fun member => fresh (historyLarger member)) worldLarger
      intro identity member
      rcases List.mem_cons.mp member with same | old
      · exact List.mem_cons.mpr (.inl same)
      · exact List.mem_cons.mpr (.inr (historyLarger old))
  | installResource body ih =>
      apply Run.installResource
      intro identity fresh
      exact ih identity (fun member => fresh (worldLarger member))
        (ScopedExpressions.append_subset worldLarger (List.Subset.refl _)) historyLarger
  | choice left right same ihLeft ihRight =>
      exact .choice (ihLeft worldLarger historyLarger) (ihRight worldLarger historyLarger) same
  | resume located restored ih => exact .resume located (ih _ _ worldLarger historyLarger)
  | dispose located abandoned ih => exact .dispose located (ih _ _ worldLarger historyLarger)
  | nil => exact .nil
  | plain code ih =>
      rename_i nextWorld nextInstallations worldLarger historyLarger
      exact .plain (ih worldLarger historyLarger)
  | skipped tail ih | handler tail ih | cell tail ih | normal tail ih
  | unwinding tail ih | closing tail ih | retiring tail ih | live tail ih | spent tail ih =>
      rename_i nextWorld nextInstallations worldLarger historyLarger
      constructor
      exact ih _ _ worldLarger historyLarger
  | cleanup callback ih =>
      rename_i nextWorld nextInstallations worldLarger historyLarger
      exact .cleanup (ih worldLarger historyLarger)
  | opening captured ih =>
      rename_i nextWorld nextInstallations worldLarger historyLarger
      exact .opening (ih _ _ worldLarger historyLarger)

/-- Pending interpretations reuse the same mutual monotonicity proof. -/
theorem Wait.mono {root : Requirements demand}
    (waiting : Wait world installations context mode root)
    (worldLarger : world ⊆ nextWorld) (historyLarger : installations ⊆ nextInstallations) :
    Wait nextWorld nextInstallations context mode root := by
  cases mode with
  | ordinary =>
      have transported := (Run.pure waiting).mono worldLarger historyLarger
      cases transported with | pure pending => exact pending
  | unwind =>
      have transported := (Run.pure (.unwinding waiting)).mono worldLarger historyLarger
      cases transported with | pure pending => cases pending with | unwinding rest => exact rest

/-- Any actually fresh installation selects its exact authenticated body interpretation. -/
theorem Run.enter_handler
    (run : Run world installations (.handler (effect := effect) (table := table)
      (required := required) declarations bodyRows) context root)
    (fresh : activation ∉ installations) :
    Run world (activation :: installations) bodyRows
      (.handler (effect := effect) (table := table) activation declarations context) root := by
  cases run with | installHandler body => exact body activation fresh

/-- Any actually fresh resource identity selects its own literal family instance. -/
theorem Run.enter_resource
    (run : Run world installations (.resource bodyRows) context root)
    (fresh : identity ∉ world) :
    Run (world ++ [identity]) installations (bodyRows identity) (.cell (identity := identity) context) root := by
  cases run with | installResource body => exact body identity fresh

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.mono
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Wait.mono
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.enter_handler
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.enter_resource

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)

/-- Decorated ownership preserves the physical ticket multiset, including dormant
captures and scheduled retirements. Plain row frames contribute no owner. -/
theorem Context.Source.owned_permutation {hints : ReturnHints scope} {context : Context hints}
    (source : Context.Source operations policy contracts tables families world context stack) :
    context.owned.Perm (ownedTickets stack) := by
  induction source with
  | nil => exact .refl _
  | plain tail ih | handler declaration tail ih | cell tail ih | cleanup callback tail ih
  | normal tail ih | unwinding tail ih | closing tail ih | spent tail ih => exact ih
  | retiring tail ih => exact .cons _ ih
  | live saved tail ihSaved ihTail =>
      exact (ihSaved.append (.cons _ ihTail)).trans List.perm_middle

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Context.Source.owned_permutation

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (available spend spendAll available_permutation spend_available_cons)

private theorem restored_owned {front : Context frontHints} {saved : Context savedHints} {tail : Context tailHints} :
    (front.append (.live (owner := owner) (resumeDemand := resumeDemand) saved tail)).owned.Perm
      (owner :: (saved.append (front.append (.spent (owner := owner) tail))).owned) := by
  simp only [Context.append_owned, Context.owned]
  have moved := List.perm_middle (a := owner) (l₁ := front.owned ++ saved.owned) (l₂ := tail.owned)
  have exchanged := (List.perm_append_comm (l₁ := front.owned) (l₂ := saved.owned)).append_right tail.owned
  simpa only [List.append_assoc] using moved.trans (.cons owner exchanged)

/-- The contextual interpretation consumes exactly the retained owners. -/
theorem Run.owned {root : Requirements demand} (run : Run world installations rows context root)
    (unique : context.owned.Nodup)
    (checked : Checked store receiving (available context.owned) root row) :
    demand.Perm context.owned := by
  induction run using Run.rec
      (motive_2 := fun world installations {_} {_} context _ {demand} root _ =>
        ∀ store receiving row, context.owned.Nodup →
          Checked store receiving (available context.owned) root row → demand.Perm context.owned)
      generalizing store receiving row with
  | pure waiting ih => exact ih _ _ _ unique checked
  | builtin found waiting ih => exact ih _ _ _ unique checked
  | request cut selected body binding ih =>
    obtain ⟨owner, fresh⟩ := ScopedTyping.fresh_world_name _
    have localBinding := binding owner [] fresh
    have ordered := cut.local_owned (owner := owner) (resumeDemand := [])
    have nextCheck := localBinding.checked checked
    rw [withPhase_available, ← available_permutation ordered] at nextCheck
    have absent : owner ∉ _ := fun member => fresh (Context.owned_subset_ticketNames _ member)
    have nextUnique := ordered.symm.nodup (List.nodup_cons.mpr ⟨absent, unique⟩)
    have actual := (ih owner [] fresh nextUnique nextCheck).trans ordered
    exact List.Perm.cons_inv (localBinding.demand_discharge.symm.trans actual)
  | sequence first ih => exact ih unique checked
  | installHandler body ih =>
    obtain ⟨activation, fresh⟩ := ScopedTyping.fresh_world_name _
    exact ih activation fresh unique checked
  | installResource body ih =>
    obtain ⟨identity, fresh⟩ := ScopedTyping.fresh_world_name _
    exact ih identity fresh unique checked
  | installCleanup body ih => exact ih unique checked
  | choice left right same ihLeft ihRight =>
    cases checked with
    | choice first second => exact ihLeft unique first
  | @resume frontScope savedScope tailScope owner world installations remaining root resumeDemand frontHints savedHints tailHints front saved tail located restored ih =>
    have ordered := restored_owned (front := front) (saved := saved) (tail := tail)
      (owner := owner) (resumeDemand := resumeDemand)
    have nextUnique := List.nodup_cons.mp (ordered.nodup unique)
    obtain ⟨_, _, _, nextCheck, _⟩ := RecursiveRequirements.checked_sequence_parts checked
    simp only [spendAll] at nextCheck
    rw [available_permutation ordered, spend_available_cons nextUnique.1] at nextCheck
    exact ((ih _ _ _ nextUnique.2 nextCheck).cons owner).trans ordered.symm
  | @dispose frontScope savedScope tailScope owner world installations remaining root resumeDemand frontHints savedHints tailHints front saved tail located abandoned ih =>
    have ordered : (front.append (.live (owner := owner) (resumeDemand := resumeDemand) saved tail)).owned.Perm
        (owner :: (saved.append (.closing (front.append (.spent (owner := owner) tail)))).owned) := by
      simpa only [Context.append_owned, Context.owned] using
        (restored_owned (front := front) (saved := saved) (tail := tail) (owner := owner) (resumeDemand := resumeDemand))
    have nextUnique := List.nodup_cons.mp (ordered.nodup unique)
    obtain ⟨_, _, _, nextCheck, _⟩ := RecursiveRequirements.checked_sequence_parts checked
    simp only [spendAll] at nextCheck
    rw [available_permutation ordered, spend_available_cons nextUnique.1] at nextCheck
    exact ((ih _ _ _ nextUnique.2 nextCheck).cons owner).trans ordered.symm
  | nil => exact .refl _
  | plain code ih =>
    rename_i store receiving row unique checked
    exact ih unique checked
  | cleanup callback ih =>
    rename_i store receiving row unique checked
    simp only [Context.callback_owned] at ih
    exact ih unique checked
  | skipped tail ih | handler tail ih | cell tail ih | normal tail ih | unwinding tail ih | closing tail ih =>
    rename_i store receiving row unique checked
    exact ih _ _ _ unique checked
  | retiring tail ih =>
    rename_i store receiving row unique checked
    have nextUnique := List.nodup_cons.mp unique
    obtain ⟨_, _, _, nextCheck, _⟩ := RecursiveRequirements.checked_sequence_parts checked
    simp only [spendAll, Context.owned] at nextCheck
    rw [spend_available_cons nextUnique.1] at nextCheck
    exact (ih _ _ _ nextUnique.2 nextCheck).cons _
  | live tail ih =>
    rename_i store receiving row unique checked
    obtain ⟨_, _, first, _, _⟩ := RecursiveRequirements.checked_sequence_parts checked
    have rejected := RecursiveRequirements.checked_complete first
    simp [RecursiveRequirements.evaluate, RecursiveRequirements.evaluateFuel, available, Context.owned] at rejected
  | @opening world installations demand root owner resumeDemand savedScope savedHints saved scope hints context captured ih =>
    rename_i store receiving row unique checked
    have ordered : (saved.append (.retiring owner context)).owned =
        (Context.live (owner := owner) (resumeDemand := resumeDemand) saved context).owned := by
      simp only [Context.append_owned, Context.owned]
    have next := ih _ _ _ (ordered.symm ▸ unique) (ordered.symm ▸ checked)
    exact ordered ▸ next
  | spent tail ih =>
    rename_i store receiving row unique checked
    obtain ⟨_, _, _, nextCheck, _⟩ := RecursiveRequirements.checked_sequence_parts checked
    exact ih _ _ _ unique nextCheck

/-- Both pending modes reuse the same mutual induction. -/
theorem Wait.owned {root : Requirements demand} (waiting : Wait world installations context mode root)
    (unique : context.owned.Nodup)
    (checked : Checked store receiving (available context.owned) root row) :
    demand.Perm context.owned := by
  cases mode with
  | ordinary => exact (Run.pure waiting).owned unique checked
  | unwind => exact (Run.pure (.unwinding waiting)).owned unique checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.owned
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Wait.owned


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (available available_permutation)
open SourceDependencyAnnotations (RowAnnotation)

/-- Source authentication relates contextual accounting to the actual stack.
The existing annotation projection supplies the independent finite check. -/
theorem Run.stack_owned {root annotated : Requirements demand} (run : Run world installations rows context root)
    (source : Context.Source operations policy contracts tables families world context stack)
    (unique : (ownedTickets stack).Nodup) (annotation : RowAnnotation root annotated)
    (checked : Checked store receiving (available (ownedTickets stack)) annotated row) :
    demand.Perm (ownedTickets stack) := by
  have physical := source.owned_permutation
  obtain ⟨_, normalCheck, _⟩ := annotation.checked checked
  rw [← available_permutation physical] at normalCheck
  exact (run.owned (physical.symm.nodup unique) normalCheck).trans physical

/-- The same source bridge covers both ordinary and unwinding completion. -/
theorem Wait.stack_owned {root annotated : Requirements demand} (waiting : Wait world installations context mode root)
    (source : Context.Source operations policy contracts tables families world context stack)
    (unique : (ownedTickets stack).Nodup) (annotation : RowAnnotation root annotated)
    (checked : Checked store receiving (available (ownedTickets stack)) annotated row) :
    demand.Perm (ownedTickets stack) := by
  have physical := source.owned_permutation
  obtain ⟨_, normalCheck, _⟩ := annotation.checked checked
  rw [← available_permutation physical] at normalCheck
  exact (waiting.owned (physical.symm.nodup unique) normalCheck).trans physical

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.stack_owned
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Wait.stack_owned

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)

private theorem context_append_injective
    {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    (a b : Context first) (c d : Context second)
    (same : a.append c = b.append d) : a = b ∧ c = d := by
  induction a with
  | nil => cases b; exact ⟨rfl, same⟩
  | plain rows rest ih =>
      cases b
      obtain ⟨checkingSame, rowsSame, restSame⟩ := Context.plain.inj same
      cases checkingSame
      cases eq_of_heq rowsSame
      obtain ⟨rfl, rfl⟩ := ih _ restSame
      exact ⟨rfl, rfl⟩
  | handler activation rows rest ih =>
      cases b
      obtain ⟨declarationsSame, activationSame, rowsSame, restSame⟩ := Context.handler.inj same
      cases declarationsSame
      cases activationSame
      cases eq_of_heq rowsSame
      obtain ⟨rfl, rfl⟩ := ih _ restSame
      exact ⟨rfl, rfl⟩
  | cell rest ih =>
      cases b
      obtain ⟨rfl, rfl⟩ := ih _ (Context.cell.inj same)
      exact ⟨rfl, rfl⟩
  | cleanup latent rows rest ih =>
      cases b
      obtain ⟨checkingSame, latentSame, rowsSame, restSame⟩ := Context.cleanup.inj same
      cases checkingSame
      cases latentSame
      cases eq_of_heq rowsSame
      obtain ⟨rfl, rfl⟩ := ih _ restSame
      exact ⟨rfl, rfl⟩
  | normal rest ih =>
      cases b
      obtain ⟨rfl, rfl⟩ := ih _ (Context.normal.inj same)
      exact ⟨rfl, rfl⟩
  | unwinding rest ih =>
      cases b
      obtain ⟨rfl, rfl⟩ := ih _ (Context.unwinding.inj same)
      exact ⟨rfl, rfl⟩
  | closing rest ih =>
      cases b
      obtain ⟨rfl, rfl⟩ := ih _ (Context.closing.inj same)
      exact ⟨rfl, rfl⟩
  | retiring owner rest ih =>
      cases b
      obtain ⟨rfl, restSame⟩ := Context.retiring.inj same
      obtain ⟨rfl, rfl⟩ := ih _ restSame
      exact ⟨rfl, rfl⟩
  | live captured rest ihCaptured ihRest =>
      cases b
      obtain ⟨rfl, rfl, restSame⟩ := Context.live.inj same
      obtain ⟨rfl, rfl⟩ := ihRest _ restSame
      exact ⟨rfl, rfl⟩
  | spent rest ih =>
      cases b
      obtain ⟨rfl, rfl⟩ := ih _ (Context.spent.inj same)
      exact ⟨rfl, rfl⟩
theorem context_append_pack_injective
    {first nextFirst : ReturnHints firstScope} {second nextSecond : ReturnHints secondScope}
    (a : Context first) (b : Context nextFirst) (c : Context second) (d : Context nextSecond)
    (same : (a.append c).pack = (b.append d).pack) : a.pack = b.pack ∧ c.pack = d.pack := by
  have hintsSame := eq_of_heq (Packed.mk.inj same).2.1
  obtain ⟨rfl, rfl⟩ := SourceDependencyNeutral.Lexical.Recursive.append_injective hintsSame
  have contextSame := eq_of_heq (Packed.mk.inj same).2.2
  obtain ⟨rfl, rfl⟩ := context_append_injective a b c d contextSame
  exact ⟨rfl, rfl⟩


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)
open OwnerPhaseTransitions (spend)

/-- Authenticated discard projects the same owner's actual primitive rows. -/
theorem Code.ready_discard
    {current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      (.discard binder) result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows current resultRows rows)
    (resolved : runtimeScope.resolve binder = some owner)
    (checked : Code outward actions budget phases world installations rows context) :
    Code outward actions budget phases world installations (Rows.invoke (key := ⟨owner, .dispose⟩)) context := by
  cases authenticated with
  | discard =>
    rename_i actual
    cases Option.some.inj (actual.symm.trans resolved)
    exact checked

/-- Primitive inversion retains both actual-mode source premises and the exact
live-context annotation, without replacing it by an inferred contract demand. -/
theorem Code.dispose_parts
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .dispose⟩)) context) :
    ∃ front captured tail : Packed, ∃ resumeDemand : List Nat, ∃ rights : Syntax.OneShotRights,
      context.pack = (front.context.append
        (.live (owner := owner) (resumeDemand := resumeDemand) captured.context tail.context)).pack ∧
      OwnerCut owner scope ⟨front.scope, captured.scope, tail.scope⟩ ∧
      actions owner = some rights ∧ rights.dispose = true ∧ phases owner = .available ∧
      captured.scope.held = false ∧
      Pending outward actions budget (spend phases owner) world installations captured.context
        (.closing (front.context.append (.spent (owner := owner) tail.context))) .unwind .unwind ∧
      Pending outward actions budget (spend phases owner) world installations
        (front.context.append (.spent (owner := owner) tail.context)) .nil .ordinary
        (hints.returnMode .ordinary) := by
  cases checked with
  | dispose located known permission available unprotected abandoned waiting =>
      exact ⟨⟨_, _, _⟩, ⟨_, _, _⟩, ⟨_, _, _⟩, _, _, rfl, located, known, permission, available,
        unprotected, abandoned, waiting⟩

/-- The exact lexical discard cut supplies a single unwind traversal through
its capture, closing marker and ordinary caller. -/
theorem Code.discard_pending_at
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
    (code : Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .dispose⟩))
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)))
    (located : OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩) :
    capturedScope.held = false ∧
    Pending outward actions budget (spend phases owner) world installations
      (captured.append (.closing (front.append (.spent (owner := owner) tail)))) .nil .unwind
      ((frontHints.append (.live (owner := owner) capturedHints tailHints)).returnMode .ordinary) := by
  obtain ⟨⟨actualFrontScope, actualFrontHints, actualFront⟩,
    ⟨actualCapturedScope, actualCapturedHints, actualCaptured⟩,
    ⟨actualTailScope, actualTailHints, actualTail⟩,
    actualDemand, rights, same, actualLocated, known, permission, available, unprotected, abandoned, waiting⟩ := code.dispose_parts
  obtain ⟨rfl, rfl, rfl⟩ := owner_cut_scope_parts actualLocated located
  obtain ⟨frontSame, liveSame⟩ := context_append_pack_injective front actualFront
    (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail)
    (Context.live (owner := owner) (resumeDemand := actualDemand) actualCaptured actualTail) same
  have hintsSame := eq_of_heq (Packed.mk.inj liveSame).2.1
  obtain ⟨capturedHintsSame, tailHintsSame⟩ := ReturnHints.live.inj hintsSame
  cases capturedHintsSame
  cases tailHintsSame
  have contextsSame := eq_of_heq (Packed.mk.inj liveSame).2.2
  obtain ⟨demandSame, capturedSame, tailSame⟩ := Context.live.inj contextsSame
  cases demandSame
  cases capturedSame
  cases tailSame
  have closingWaiting := Pending.closing (mode := .unwind) waiting
  have combined := (abandoned.reindex_outside
    (Context.closing (actualFront.append (.spent (owner := owner) actualTail))).append_nil_pack.symm).append closingWaiting
  refine ⟨unprotected, ?_⟩
  exact combined.reindex_context (congrArg
    (fun p : Packed => (actualCaptured.append (.closing (p.context.append (.spent (owner := owner) actualTail)))).pack)
    frontSame.symm)

/-- The predecessor's retained-source return mode supplies the site's declared
output mode for that same unwind traversal. -/
theorem Code.discard_pending_at_mode
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
    (code : Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .dispose⟩))
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)))
    (located : OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩)
    (retained : Pending outward actions budget phases world installations
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)) .nil .ordinary outputMode) :
    capturedScope.held = false ∧
    Pending outward actions budget (spend phases owner) world installations
      (captured.append (.closing (front.append (.spent (owner := owner) tail)))) .nil .unwind outputMode := by
  have restored := code.discard_pending_at located
  rw [retained.return_mode] at restored
  exact restored

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (Phases spend introduce)

theorem Code.capture_body
    {wholeHints : ReturnHints wholeScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context capturedHints} {tail : Context tailHints}
    {family : Nat → SourceDependencyAnnotations.Dependencies}
    {bodies : ∀ owner, SourcePlanSignatures.Signature (family owner)}
    {bodyRows : ∀ owner, Rows (bodies owner)}
    (request : Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole)
    (cut : Cut effect operation whole captured tail contract modes)
    (selected : CapturedClauseRows effect operation capturedScope.held captured bodyRows)
    (fresh : actions owner = none) (absent : owner ∉ whole.ticketNames)
    (resumeDemand : List Nat) :
    ∃ rights, Code outward (actions.insert owner rights) budget (introduce phases owner)
      world installations (bodyRows owner)
      (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail) := by
  cases request with
  | builtin found =>
    have incompatible := found.symm.trans cut
    cases incompatible
  | request actualCut guarded callbacks ownerBound cleanupBudget actualSelected terminal requiredRights retained body =>
    obtain ⟨sameCapture, sameTail, _, _⟩ := actualCut.unique cut
    cases sameCapture
    cases sameTail
    obtain ⟨sameFamily, sameBodies, sameRows⟩ := actualSelected.unique selected
    cases sameFamily
    cases sameBodies
    cases sameRows
    exact ⟨_, body owner resumeDemand fresh absent⟩

/-- The source declaration fixes rights from actual clause syntax. -/
theorem rightsAt_clause
    (selected : ClauseAt operation clauses parameter binder code)
    (plans : SourceDeclarationPlans.ClausePlans clauses families) :
    rightsAt operation (SourcePlanSignatures.clauseSignatures plans) = some code.requiredActions := by
  induction selected generalizing families with
  | hit => cases plans; simp [rightsAt, SourcePlanSignatures.clauseSignatures]
  | pass different rest ih =>
    cases plans
    simpa [rightsAt, SourcePlanSignatures.clauseSignatures, different] using ih (by assumption)

/-- Source admission yields the actual selected body with its declared rights.
The demand is instantiated from the caller's same captured source at use time. -/
theorem Code.capture_body_with_rights
    {wholeHints : ReturnHints wholeScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context capturedHints} {tail : Context tailHints}
    {family : Nat → SourceDependencyAnnotations.Dependencies}
    {bodies : ∀ owner, SourcePlanSignatures.Signature (family owner)}
    {bodyRows : ∀ owner, Rows (bodies owner)}
    {declarations : SourcePlanSignatures.ClauseSignatures declarationFamilies}
    {declarationRows : ClauseRows declarations}
    (request : Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole)
    (cut : Cut effect operation whole captured tail contract modes)
    (selected : CapturedClauseRows effect operation capturedScope.held captured bodyRows)
    (terminal : TerminalHandler effect activation declarationRows captured)
    (requiredRights : rightsAt operation declarations = some rights)
    (fresh : actions owner = none) (absent : owner ∉ whole.ticketNames)
    (resumeDemand : List Nat) :
    Code outward (actions.insert owner rights) budget (introduce phases owner)
      world installations (bodyRows owner)
      (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail) := by
  cases request with
  | builtin found =>
    have incompatible := found.symm.trans cut
    cases incompatible
  | request actualCut guarded callbacks ownerBound cleanupBudget actualSelected actualTerminal actualRights retained body =>
    obtain ⟨sameCapture, sameTail, _, _⟩ := actualCut.unique cut
    cases sameCapture
    cases sameTail
    obtain ⟨sameFamily, sameBodies, sameRows⟩ := actualSelected.unique selected
    cases sameFamily
    cases sameBodies
    cases sameRows
    obtain ⟨_, _, sameDeclarations, sameSignatures, sameDeclarationRows⟩ := actualTerminal.unique terminal
    cases sameDeclarations
    cases sameSignatures
    cases sameDeclarationRows
    have rightsSame := Option.some.inj (actualRights.symm.trans requiredRights)
    cases rightsSame
    exact body owner resumeDemand fresh absent

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts
open OwnerPhaseTransitions (Phases spend spendAll introduce liveNames)
open RecursiveRequirements (Checked evaluate)

private theorem introduce_other (different : other ≠ owner) :
    introduce phases owner other = phases other := by simp [introduce, different]

private theorem introduce_spend_comm (different : owner ≠ other) :
    spend (introduce phases owner) other = introduce (spend phases other) owner := by
  funext name
  by_cases one : name = owner <;> by_cases two : name = other <;>
    simp_all [introduce, spend]

private theorem introduce_spendAll_comm (absent : owner ∉ names) :
    spendAll (introduce phases owner) names = introduce (spendAll phases names) owner := by
  funext other
  by_cases same : other = owner <;> simp [OwnerPhaseTransitions.spendAll_at, introduce, same, absent]

private theorem project_introduce_absent (absent : owner ∉ liveNames context) :
    OwnerPhaseTransitions.project context (introduce phases owner) = OwnerPhaseTransitions.project context phases := by
  induction context with
  | nil => rfl
  | cons entry rest ih => cases entry with
    | ordinary layer => exact congrArg (layer :: ·) (ih absent)
    | spent other => exact ih absent
    | live other held =>
      have different : other ≠ owner := fun same => absent (by simp [liveNames, same])
      have remaining : owner ∉ liveNames rest := fun member => absent (List.mem_cons_of_mem _ member)
      simp only [OwnerPhaseTransitions.project, introduce_other different, ih remaining]

private theorem export_introduce_absent (absent : owner ∉ liveNames context) :
    OwnerSource.exportAt context (introduce phases owner) row = OwnerSource.exportAt context phases row := by
  simp only [OwnerSource.exportAt, project_introduce_absent absent]

def CleanupHints.Metadata.ticketNames : CleanupHints.Metadata scope → List Nat
  | .nil => []
  | .plain rest | .handler _ rest | .cell rest | .cleanup _ rest => rest.ticketNames
  | .live (owner := owner) saved rest => owner :: (saved.ticketNames ++ rest.ticketNames)
  | .spent (owner := owner) rest | .retiring owner rest => owner :: rest.ticketNames

private theorem metadata_live_ticketNames (metadata : CleanupHints.Metadata scope) :
    liveNames metadata.context ⊆ metadata.ticketNames := by
  induction metadata with
  | nil => exact List.Subset.refl _
  | plain rest ih | handler activation rest ih | cell rest ih | cleanup latent rest ih => exact ih
  | spent rest ih | retiring owner rest ih => exact ih.trans (List.subset_cons_self _ _)
  | live saved rest ihSaved ihRest =>
    intro other member
    simp only [CleanupHints.Metadata.context, liveNames, List.mem_cons] at member
    rcases member with same | remaining
    · subst other; exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (List.mem_append_right _ (ihRest remaining))

private theorem metadata_demand_ticketNames (metadata : CleanupHints.Metadata scope) :
    metadata.closing.1 ⊆ metadata.ticketNames := by
  induction metadata with
  | nil => exact List.Subset.refl _
  | plain rest ih | handler activation rest ih | cell rest ih | cleanup latent rest ih => exact ih
  | spent rest ih => exact ih.trans (List.subset_cons_self _ _)
  | retiring owner rest ih => exact List.cons_subset_cons _ ih
  | live saved rest ihSaved ihRest =>
    intro other member
    simp only [CleanupHints.Metadata.closing, CleanupHints.Metadata.ticketNames, List.mem_append,
      List.singleton_append, List.mem_cons] at member ⊢
    rcases member with inside | same | outside
    · exact .inr (.inl (ihSaved inside))
    · exact .inl same
    · exact .inr (.inr (ihRest outside))

theorem CleanupHints.Metadata.checked_introduce_absent
    (metadata : CleanupHints.Metadata scope)
    (absent : owner ∉ metadata.ticketNames) (outside : owner ∉ liveNames receiving)
    (checked : Checked [] receiving before metadata.closing.2 row) :
    Checked [] receiving (introduce before owner) metadata.closing.2 row := by
  induction metadata generalizing receiving before row with
  | nil => exact .request ((export_introduce_absent (by simpa using outside)).trans (budget_request_parts checked))
  | plain rest ih | handler activation rest ih | cell rest ih => exact ih absent outside checked
  | cleanup latent rest ih =>
    obtain ⟨firstRow, restRow, firstCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
    refine .sequence (.request ((export_introduce_absent ?_).trans (budget_request_parts firstCheck))) (ih absent outside restCheck)
    simp only [budget_liveNames_append, List.mem_append, not_or]
    exact ⟨fun member => absent (metadata_live_ticketNames rest member), outside⟩
  | @spent restScope other rest ih =>
    have separate : owner ≠ other ∧ owner ∉ rest.ticketNames := by
      simpa only [CleanupHints.Metadata.ticketNames, List.mem_cons, not_or] using absent
    obtain ⟨firstRow, restRow, firstCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
    obtain ⟨consumed, rfl⟩ := budget_spent_parts firstCheck
    exact .sequence (.spent ((introduce_other separate.1.symm).trans consumed)) (ih separate.2 outside restCheck)
  | retiring other rest ih =>
    have separate : owner ≠ other ∧ owner ∉ rest.ticketNames := by
      simpa only [CleanupHints.Metadata.ticketNames, List.mem_cons, not_or] using absent
    obtain ⟨firstRow, restRow, firstCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
    obtain ⟨ready, rfl⟩ := budget_retire_parts firstCheck
    refine .sequence (.retire ((introduce_other separate.1.symm).trans ready)) ?_
    simpa only [spendAll, introduce_spend_comm separate.1] using ih separate.2 outside restCheck
  | @live savedScope restScope other saved rest ihSaved ihRest =>
    have separate : owner ≠ other ∧ owner ∉ saved.ticketNames ∧ owner ∉ rest.ticketNames := by
      simpa only [CleanupHints.Metadata.ticketNames, List.mem_cons, List.mem_append, not_or] using absent
    obtain ⟨savedRow, remainingRow, savedCheck, remainingCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts checked
    obtain ⟨retireRow, restRow, retireCheck, restCheck, rfl⟩ := RecursiveRequirements.checked_sequence_parts remainingCheck
    obtain ⟨ready, rfl⟩ := budget_retire_parts retireCheck
    refine .sequence (RecursiveRequirements.checked_prepend_iff.mpr (ihSaved separate.2.1 ?_
      (RecursiveRequirements.checked_prepend_iff.mp savedCheck))) ?_
    · simp only [budget_liveNames_append, liveNames, List.mem_append, not_or]
      exact ⟨fun member => separate.2.2 (metadata_live_ticketNames rest member), outside⟩
    · rw [introduce_spendAll_comm (fun member => separate.2.1 (metadata_demand_ticketNames saved member))]
      refine .sequence (.retire ((introduce_other separate.1.symm).trans ready)) ?_
      simpa only [spendAll, introduce_spend_comm separate.1] using ihRest separate.2.2 outside restCheck

theorem CleanupHints.Metadata.check_introduce_absent
    (metadata : CleanupHints.Metadata scope)
    (absent : owner ∉ metadata.ticketNames) (outside : owner ∉ liveNames receiving)
    (checked : metadata.check receiving before budget = true) :
    metadata.check receiving (introduce before owner) budget = true := by
  obtain ⟨row, evaluated, bounded⟩ := metadata.check_iff.mp checked
  exact metadata.check_iff.mpr ⟨row, RecursiveRequirements.checked_complete
    (metadata.checked_introduce_absent absent outside (RecursiveRequirements.evaluate_sound evaluated)), bounded⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (introduce liveNames)

theorem Context.callback_ticketNames {hints : ReturnHints scope} (context : Context hints) (mode : LexicalUnwind.UseMode) :
    (context.callback mode).ticketNames = context.ticketNames := by
  cases mode <;> rfl

theorem Context.closing_ticketNames {hints : ReturnHints scope} (context : Context hints)
    (found : context.closing? = some metadata) : metadata.ticketNames = context.ticketNames := by
  induction context with
  | nil => cases found; rfl
  | plain rows tail ih | handler activation rows tail ih | cell tail ih
  | cleanup latent rows tail ih | retiring owner tail ih | spent tail ih =>
      cases same : tail.closing? with
      | none => simp [Context.closing?, same] at found
      | some actual =>
          simp only [Context.closing?, same, Option.map_some, Option.some.injEq] at found
          subst metadata
          simp only [CleanupHints.Metadata.ticketNames, Context.ticketNames, ih same]
  | normal tail ih | unwinding tail ih | closing tail ih => simp [Context.closing?] at found
  | live saved tail ihSaved ihTail =>
      cases savedSame : saved.closing? with
      | none => simp [Context.closing?, savedSame] at found
      | some savedMetadata =>
          cases tailSame : tail.closing? with
          | none => simp [Context.closing?, savedSame, tailSame] at found
          | some tailMetadata =>
              simp [Context.closing?, savedSame, tailSame] at found
              subst metadata
              simp only [CleanupHints.Metadata.ticketNames, Context.ticketNames,
                ihSaved savedSame, ihTail tailSame]

theorem RequestBudget.introduce_absent
    {hints : ReturnHints scope} {context : Context hints}
    (checked : RequestBudget budget phases effect operation context)
    (absent : owner ∉ context.ticketNames) :
    RequestBudget budget (introduce phases owner) effect operation context := by
  cases found : select effect operation context with
  | none => exact .unselected found
  | some selected =>
      cases selected with
      | builtin identity => exact .builtin found
      | handler captured tail contract modes =>
          have cut : Cut effect operation context captured.context tail.context contract modes := found
          have owned : context.ticketNames = captured.context.ticketNames ++ tail.context.ticketNames := by
            have same := congrArg (fun packed : Packed => packed.context.ticketNames) cut.decomposition
            exact same.trans (Context.append_ticketNames captured.context tail.context)
          have separated : owner ∉ captured.context.ticketNames ∧ owner ∉ tail.context.ticketNames := by
            simpa only [owned, List.mem_append, not_or] using absent
          unfold RequestBudget
          rw [found]
          intro consuming
          obtain ⟨metadata, projection, ordinary, protectedCheck⟩ := checked.consuming cut consuming
          have noDemand : owner ∉ metadata.ticketNames := by
            rw [captured.context.closing_ticketNames projection]
            exact separated.1
          have noReceiver : owner ∉ liveNames tail.context.context :=
            fun member => separated.2 (tail.context.owned_subset_ticketNames (tail.context.liveNames_owned member))
          exact ⟨metadata, projection,
            metadata.check_introduce_absent noDemand noReceiver ordinary,
            metadata.check_introduce_absent noDemand noReceiver protectedCheck⟩


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (spend introduce)

private theorem introduce_introduce_same : introduce (introduce phases owner) owner = introduce phases owner := by
  funext other
  by_cases same : other = owner <;> simp [introduce, same]

private theorem introduce_introduce_other (different : allocated ≠ owner) :
    introduce (introduce phases owner) allocated = introduce (introduce phases allocated) owner := by
  funext other
  by_cases one : other = owner <;> by_cases two : other = allocated <;> simp_all [introduce]

private theorem Code.introduce_absent_all
    {checking : SourcePlanSignatures.Signature dependencies} {rows : Rows checking}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations rows context) :
    ∀ owner, owner ∉ context.ticketNames →
      Code outward actions budget (introduce phases owner) world installations rows context := by
  apply Code.rec (motive_1 := fun actions budget phases world installations {dependencies checking} rows {scope hints} context _ =>
      ∀ owner, owner ∉ context.ticketNames →
        Code outward actions budget (introduce phases owner) world installations rows context)
    (motive_2 := fun actions budget phases world installations {scope outsideScope hints external} context outside input output _ =>
      ∀ owner, owner ∉ (context.append outside).ticketNames →
        Pending outward actions budget (introduce phases owner) world installations context outside input output) (t := checked)
  · intros
    exact .pure
  · intros
    rename_i found owner absent
    exact .builtin found
  · intros
    rename_i cut guarded callbacks ownerBound cleanupBudget family bodies bodyRows declarations declarationRows selected terminal requiredRights retained body ihCallbacks ihRetained ihBody owner absent
    have wholeOwned := congrArg (fun packed : Packed => packed.context.ticketNames) cut.decomposition
    dsimp only [Context.pack] at wholeOwned
    have parts := absent
    rw [wholeOwned] at parts
    simp only [Context.append_ticketNames, List.mem_append, not_or] at parts
    refine .request cut guarded (fun disposing => ihCallbacks disposing owner ?_) ownerBound
      (cleanupBudget.introduce_absent absent) selected terminal requiredRights (ihRetained owner ?_) ?_
    · simpa only [Context.append_ticketNames, Context.ticketNames, List.mem_append, not_or] using parts
    · simpa only [Context.append_ticketNames, Context.ticketNames, List.append_nil] using absent
    · intro allocated demand fresh names
      by_cases same : allocated = owner
      · subst allocated
        rw [introduce_introduce_same]
        exact body owner demand fresh names
      · rw [introduce_introduce_other same]
        apply ihBody allocated demand fresh names owner
        simp only [Context.ticketNames, List.mem_append, List.mem_cons, not_or]
        exact ⟨Ne.symm same, parts.1, parts.2⟩
  · intros
    rename_i located known permission available resumeBudget restored ih owner absent
    have parts := absent
    simp only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] at parts
    refine .resume located known permission ((introduce_other (Ne.symm parts.2.1)).trans available) resumeBudget ?_
    rw [introduce_spend_comm parts.2.1]
    apply ih owner
    simpa only [Context.append_ticketNames, Context.ticketNames, List.append_nil, List.mem_append, List.mem_cons, not_or] using
      And.intro parts.2.2.1 (And.intro parts.1 (And.intro parts.2.1 parts.2.2.2))
  · intros
    rename_i located known permission available unprotected abandoned waiting ihAbandoned ihWaiting owner absent
    have parts := absent
    simp only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] at parts
    refine .dispose located known permission ((introduce_other (Ne.symm parts.2.1)).trans available) unprotected ?_ ?_
    · rw [introduce_spend_comm parts.2.1]
      apply ihAbandoned owner
      simpa only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] using
        And.intro parts.2.2.1 (And.intro parts.1 (And.intro parts.2.1 parts.2.2.2))
    · rw [introduce_spend_comm parts.2.1]
      apply ihWaiting owner
      simpa only [Context.append_ticketNames, Context.ticketNames, List.append_nil, List.mem_append, List.mem_cons, not_or] using
        And.intro parts.1 (And.intro parts.2.1 parts.2.2.2)
  · intros
    rename_i first second ihFirst ihSecond owner absent
    exact .sequence (ihFirst owner absent) (ihSecond owner absent)
  · intros
    rename_i left right ihLeft ihRight owner absent
    exact .choice (ihLeft owner absent) (ihRight owner absent)
  · intros
    rename_i body ih owner absent
    exact .handler (fun activation fresh => ih activation fresh owner absent)
  · intros
    rename_i body callback ihBody ihCallback owner absent
    exact .cleanup (ihBody owner absent) (ihCallback owner absent)
  · intros
    rename_i body ih owner absent
    exact .resource (fun identity fresh => ih identity fresh owner absent)
  · intros
    exact .nil
  · intros
    rename_i code tail ihCode ihTail owner absent
    exact .plain (ihCode owner absent) (ihTail owner absent)
  · intros
    rename_i tail ih owner absent
    exact .skipped (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .handler (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .cell (ih owner absent)
  · intros
    rename_i callback tail ihCallback ihTail owner absent
    apply Pending.cleanup (ihCallback owner ?_) (ihTail owner absent)
    simpa only [Context.callback_ticketNames, Context.append, Context.ticketNames] using absent
  · intros
    rename_i tail ih owner absent
    exact .normal (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .unwinding (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .closing (ih owner absent)
  · intros
    rename_i tail ih owner absent
    exact .retiring (ih owner (fun member => absent (List.mem_cons_of_mem _ member)))
  · intros
    rename_i saved tail ihSaved ihTail owner absent
    have parts := absent
    simp only [Context.append, Context.ticketNames, Context.append_ticketNames, List.mem_append, List.mem_cons, not_or] at parts
    apply Pending.live (ihSaved owner ?_) (ihTail owner ?_)
    · simpa only [Context.append_ticketNames, List.mem_append, not_or] using
        And.intro parts.2.1 (And.intro parts.2.2.1 parts.2.2.2)
    · simpa only [Context.append_ticketNames, List.mem_append, not_or] using parts.2.2
  · intros
    rename_i saved tail ihSaved ihTail owner absent
    have parts := absent
    simp only [Context.append, Context.ticketNames, Context.append_ticketNames, List.mem_append, List.mem_cons, not_or] at parts
    apply Pending.opening (ihSaved owner ?_) (ihTail owner ?_)
    · simpa only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] using
        And.intro parts.2.1 (And.intro parts.1 parts.2.2)
    · simpa only [Context.append_ticketNames, List.mem_append, not_or] using parts.2.2
  · intros
    rename_i tail ih owner absent
    exact .spent (ih owner (fun member => absent (List.mem_cons_of_mem _ member)))

theorem Code.introduce_absent
    {checking : SourcePlanSignatures.Signature dependencies} {rows : Rows checking}
    {hints : ReturnHints scope} {context : Context hints}
    (checked : Code outward actions budget phases world installations rows context)
    (absent : owner ∉ context.ticketNames) :
    Code outward actions budget (introduce phases owner) world installations rows context :=
  checked.introduce_absent_all owner absent

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (introduce)

theorem Pending.introduce_absent
    {hints : ReturnHints scope} {context : Context hints}
    {external : ReturnHints outsideScope} {outside : Context external}
    (checked : Pending outward actions budget phases world installations context outside before after)
    (absent : owner ∉ (context.append outside).ticketNames) :
    Pending outward actions budget (introduce phases owner) world installations context outside before after := by
  induction context generalizing outsideScope before after with
  | nil => cases checked; exact .nil
  | plain rows rest ih => cases checked with
    | plain code tail => exact .plain (code.introduce_absent absent) (ih tail absent)
    | skipped tail => exact .skipped (ih tail absent)
  | handler activation rows rest ih => cases checked with
    | handler tail => exact .handler (ih tail absent)
  | cell rest ih => cases checked with
    | cell tail => exact .cell (ih tail absent)
  | cleanup latent rows rest ih => cases checked with
    | cleanup callback tail =>
      exact .cleanup (callback.introduce_absent (by simpa only [Context.callback_ticketNames, Context.append, Context.ticketNames] using absent)) (ih tail absent)
  | normal rest ih => cases checked with
    | normal tail => exact .normal (ih tail absent)
  | unwinding rest ih => cases checked with
    | unwinding tail => exact .unwinding (ih tail absent)
  | closing rest ih => cases checked with
    | closing tail => exact .closing (ih tail absent)
  | retiring name rest ih => cases checked with
    | retiring tail => exact .retiring (ih tail (fun member => absent (List.mem_cons_of_mem _ member)))
  | live saved rest ihSaved ihRest => cases checked with
    | live captured tail =>
      apply Pending.live (ihSaved captured ?_) (ihRest tail ?_)
      · simp only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] at absent ⊢
        exact ⟨absent.1.2.1, absent.1.2.2, absent.2⟩
      · simp only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] at absent ⊢
        exact ⟨absent.1.2.2, absent.2⟩
    | opening captured tail =>
      apply Pending.opening (ihSaved captured ?_) (ihRest tail ?_)
      · simp only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] at absent ⊢
        exact ⟨absent.1.2.1, absent.1.1, absent.1.2.2, absent.2⟩
      · simp only [Context.append_ticketNames, Context.ticketNames, List.mem_append, List.mem_cons, not_or] at absent ⊢
        exact ⟨absent.1.2.2, absent.2⟩
  | spent rest ih => cases checked with
    | spent tail => exact .spent (ih tail (fun member => absent (List.mem_cons_of_mem _ member)))

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceAdmission

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourcePlanSignatures (Signature ClauseSignatures)
open OwnerPhaseTransitions (Phases)

mutual
inductive CodeChecked (ambient : List Nat) (outward : List Instance) :
    {actions : Syntax.UsageTickets} → {budget : Footprint} → {phases : Phases} →
    {world installations : List Nat} → {dependencies : Dependencies} → {checking : Signature dependencies} →
    {rows : Rows checking} → {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} →
    {context : Context hints} → SourceAdmission.Code outward actions budget phases world installations rows context → Prop where
  | pure : CodeChecked ambient outward
      (SourceAdmission.Code.pure (actions := actions) (budget := budget) (phases := phases)
        (world := world) (installations := installations) (context := context))
  | builtin
      {context : Context hints}
      {found : select effect operation context = some (.builtin identity)} :
      CodeChecked ambient outward (SourceAdmission.Code.builtin
        (actions := actions) (budget := budget) (phases := phases)
        (world := world) (installations := installations) found)
  | request
      {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
      {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
      {cut : Cut effect operation whole captured tail contract modes}
      {callbacks : contract.dispose = true → SourceAdmission.Pending outward actions budget phases world installations
        captured (.closing tail) .unwind .unwind}
      {guarded : SourceDependencyChecks.Lexical.Capture wholeScope effect operation}
      {ownerBound : contract.dispose = true → SourceDependencyOwners.PendingWithin world
        (SourceDependencyOwners.owners captureScope) captureScope}
      {cleanupBudget : RequestBudget budget phases effect operation whole}
      {family : Nat → Dependencies} {bodies : ∀ owner, Signature (family owner)}
      {bodyRows : ∀ owner, Rows (bodies owner)}
      {declarations : ClauseSignatures declarationFamilies}
      {declarationRows : ClauseRows declarations}
      {terminal : TerminalHandler effect activation declarationRows captured}
      {requiredRights : SourceAdmission.rightsAt operation declarations = some rights}
      {selected : CapturedClauseRows effect operation captureScope.held captured bodyRows}
      {retained : SourceAdmission.Pending outward actions budget phases world installations whole Context.nil
        .ordinary (wholeHints.returnMode .ordinary)}
      {body : ∀ owner resumeDemand, actions owner = none → owner ∉ whole.ticketNames →
        SourceAdmission.Code outward (actions.insert owner rights) budget (OwnerPhaseTransitions.introduce phases owner)
          world installations (bodyRows owner) (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail)}
      (cleanup : ∀ disposing, PendingChecked ambient outward (callbacks disposing))
      (waiting : PendingChecked ambient outward retained)
      (clauses : ∀ owner demand fresh absent, CodeChecked ambient outward (body owner demand fresh absent)) :
      CodeChecked ambient outward
        (SourceAdmission.Code.request cut guarded callbacks ownerBound cleanupBudget selected terminal requiredRights retained body)
  | resume
      {resumeDemand : List Nat} {frontHints : ReturnHints frontScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
      {front : Context frontHints} {captured : Context captureHints} {tail : Context tailHints}
      {located : SourceDependencyCapture.OwnerCut owner (frontScope.append (.live owner captureScope tailScope))
        ⟨frontScope, captureScope, tailScope⟩}
      {known : actions owner = some rights} {available : phases owner = .available}
      {permission : rights.resume = true}
      {resumeShape : ResumeShape (captureHints.returnMode .ordinary) front = true}
      {restored : SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations
        (captured.append (front.append (.spent (owner := owner) tail))) .nil .ordinary
        ((frontHints.append (.live (owner := owner) captureHints tailHints)).returnMode .ordinary)}
      (next : PendingChecked ambient outward restored) :
      CodeChecked ambient outward
        (SourceAdmission.Code.resume (resumeDemand := resumeDemand) located known permission available resumeShape restored)
  | dispose
      {resumeDemand : List Nat} {frontHints : ReturnHints frontScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
      {front : Context frontHints} {captured : Context captureHints} {tail : Context tailHints}
      {located : SourceDependencyCapture.OwnerCut owner (frontScope.append (.live owner captureScope tailScope))
        ⟨frontScope, captureScope, tailScope⟩}
      {known : actions owner = some rights} {available : phases owner = .available}
      {permission : rights.dispose = true} {unprotected : captureScope.held = false}
      {abandoned : SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations captured
        (.closing (front.append (.spent (owner := owner) tail))) .unwind .unwind}
      {waiting : SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations
        (front.append (.spent (owner := owner) tail)) .nil .ordinary
        ((frontHints.append (.live (owner := owner) captureHints tailHints)).returnMode .ordinary)}
      (cleanup : PendingChecked ambient outward abandoned)
      (caller : PendingChecked ambient outward waiting) :
      CodeChecked ambient outward
        (SourceAdmission.Code.dispose (resumeDemand := resumeDemand) located known permission available unprotected abandoned waiting)
  | choice
      {first : SourceAdmission.Code outward actions budget phases world installations firstRows context}
      {second : SourceAdmission.Code outward actions budget phases world installations secondRows context}
      (left : CodeChecked ambient outward first) (right : CodeChecked ambient outward second) :
      CodeChecked ambient outward (.choice first second)
  | cleanup
      {body : SourceAdmission.Code outward actions budget phases world installations bodyRows
        (.cleanup (needs := needs) latent callbackRows context)}
      {callback : SourceAdmission.Code outward actions budget phases world installations callbackRows (.normal context)}
      (inside : CodeChecked ambient outward body) (closing : CodeChecked ambient outward callback) :
      CodeChecked ambient outward (.cleanup body callback)
  | resource
      {family : Nat → Dependencies} {bodies : ∀ identity, Signature (family identity)}
      {bodyRows : ∀ identity, Rows (bodies identity)}
      {body : ∀ identity, identity ∉ world → SourceAdmission.Code outward actions budget phases (world ++ [identity]) installations
        (bodyRows identity) (.cell (identity := identity) context)}
      (inside : ∀ identity fresh, CodeChecked ambient outward (body identity fresh)) :
      CodeChecked ambient outward (.resource body)
  | sequence
      {first : SourceAdmission.Code outward actions budget phases world installations firstRows (.plain secondRows context)}
      {second : SourceAdmission.Code outward actions budget phases world installations secondRows context}
      (left : CodeChecked ambient outward first) (right : CodeChecked ambient outward second) :
      CodeChecked ambient outward (.sequence first second)
  | handler
      {scope : SourceDependencyCapture.Scope} {hints : ReturnHints scope}
      {context : Context hints}
      {body : ∀ activation, activation ∉ installations →
        SourceAdmission.Code outward actions budget phases world (activation :: installations) bodyRows
          (.handler (effect := effect) (table := table) activation declarations context)}
      (supported : ClauseRows.resourceSupport declarations ⊆ scope.visibleResources ++ ambient)
      (inside : ∀ activation fresh, CodeChecked ambient outward (body activation fresh)) :
      CodeChecked ambient outward
        (SourceAdmission.Code.handler (required := required) body)

inductive PendingChecked (ambient : List Nat) (outward : List Instance) :
    {actions : Syntax.UsageTickets} → {budget : Footprint} → {phases : Phases} →
    {world installations : List Nat} → {scope outsideScope : SourceDependencyCapture.Scope} →
    {hints : ReturnHints scope} → {external : ReturnHints outsideScope} →
    {context : Context hints} → {outside : Context external} → {input output : LexicalUnwind.UseMode} →
    SourceAdmission.Pending outward actions budget phases world installations context outside input output → Prop where
  | nil : PendingChecked ambient outward
      (SourceAdmission.Pending.nil (actions := actions) (budget := budget) (phases := phases)
        (world := world) (installations := installations) (outside := outside) (mode := mode))
  | plain
      {code : SourceAdmission.Code outward actions budget phases world installations rows (rest.append outside)}
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside .ordinary finalMode}
      (body : CodeChecked ambient outward code) (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (.plain code tail)
  | skipped
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside .unwind finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (SourceAdmission.Pending.skipped (rows := rows) tail)
  | handler
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside mode finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (SourceAdmission.Pending.handler (activation := activation) (rows := rows) tail)
  | cell
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside mode finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (@SourceAdmission.Pending.cell outward identity _ _ _ _ _ _ _ _ _ _ _ _ _ tail)
  | cleanup
      {callback : SourceAdmission.Code outward actions budget phases world installations rows ((rest.append outside).callback mode)}
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside mode finalMode}
      (body : CodeChecked ambient outward callback) (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (SourceAdmission.Pending.cleanup (latent := latent) callback tail)
  | normal
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside .ordinary finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (.normal tail)
  | unwinding
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside .unwind finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (.unwinding tail)
  | closing
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside .ordinary finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (SourceAdmission.Pending.closing (mode := mode) tail)
  | retiring
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside mode finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (SourceAdmission.Pending.retiring (owner := owner) tail)
  | live
      {saved : SourceAdmission.Pending outward actions budget phases world installations captured (rest.append outside) .ordinary middle}
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside middle finalMode}
      (held : PendingChecked ambient outward saved) (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (@SourceAdmission.Pending.live outward owner _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ resumeDemand saved tail)
  | opening
      {saved : SourceAdmission.Pending outward actions budget phases world installations captured (.retiring owner (rest.append outside)) .unwind .unwind}
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside .unwind finalMode}
      (held : PendingChecked ambient outward saved) (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (SourceAdmission.Pending.opening (resumeDemand := resumeDemand) saved tail)
  | spent
      {tail : SourceAdmission.Pending outward actions budget phases world installations rest outside mode finalMode}
      (waiting : PendingChecked ambient outward tail) :
      PendingChecked ambient outward (@SourceAdmission.Pending.spent outward owner _ _ _ _ _ _ _ _ _ _ _ _ _ tail)

end

/-- Installation checking exposes the bound of the same retained declarations.
It does not assert that those rows authenticate any particular source syntax. -/
theorem CodeChecked.handler_supported
    {scope : SourceDependencyCapture.Scope} {hints : ReturnHints scope} {context : Context hints}
    {admitted : SourceAdmission.Code outward actions budget phases world installations
      (Rows.handler (effect := effect) (table := table) (required := required) declarations bodyRows) context}
    (checked : CodeChecked ambient outward admitted) :
    declarations.resourceSupport ⊆ scope.visibleResources ++ ambient := by
  cases checked with
  | handler supported _ => exact supported

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (OwnerCut)

/-- Same-root owner cuts identify every decorated segment of an equal live
context, including the saved demand. Both consuming primitives reuse this. -/
theorem owner_cut_context_parts
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope}
    {tailHints : ReturnHints tailScope}
    {otherFrontHints : ReturnHints otherFrontScope} {otherCapturedHints : ReturnHints otherCapturedScope}
    {otherTailHints : ReturnHints otherTailScope}
    (front : Context frontHints) (captured : Context capturedHints) (tail : Context tailHints)
    (otherFront : Context otherFrontHints) (otherCaptured : Context otherCapturedHints) (otherTail : Context otherTailHints)
    (located : OwnerCut owner scope ⟨frontScope, capturedScope, tailScope⟩)
    (otherLocated : OwnerCut owner scope ⟨otherFrontScope, otherCapturedScope, otherTailScope⟩)
    (same : (front.append (.live (owner := owner) (resumeDemand := demand) captured tail)).pack =
      (otherFront.append (.live (owner := owner) (resumeDemand := otherDemand) otherCaptured otherTail)).pack) :
    front.pack = otherFront.pack ∧ captured.pack = otherCaptured.pack ∧
      tail.pack = otherTail.pack ∧ demand = otherDemand := by
  obtain ⟨rfl, rfl, rfl⟩ := owner_cut_scope_parts located otherLocated
  obtain ⟨frontSame, liveSame⟩ := context_append_pack_injective front otherFront
    (Context.live (owner := owner) (resumeDemand := demand) captured tail)
    (Context.live (owner := owner) (resumeDemand := otherDemand) otherCaptured otherTail) same
  have hintsSame := eq_of_heq (Packed.mk.inj liveSame).2.1
  obtain ⟨capturedHintsSame, tailHintsSame⟩ := ReturnHints.live.inj hintsSame
  cases capturedHintsSame
  cases tailHintsSame
  have contextsSame := eq_of_heq (Packed.mk.inj liveSame).2.2
  obtain ⟨demandSame, capturedSame, tailSame⟩ := Context.live.inj contextsSame
  cases demandSame
  cases capturedSame
  cases tailSame
  exact ⟨frontSame, rfl, rfl, rfl⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (Scope)

/-- Spent-marker history changes no resource visible at a lexical receiver. -/
theorem DeepSpentHistory.visible_resources
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepSpentHistory owner first second) :
    firstScope.visibleResources = secondScope.visibleResources := by
  induction related <;> simp_all [Scope.visibleResources]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.DeepSpentTransport

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AccountingTransport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (Scope)

/-- Pure waiting frames do not change the resources visible to retained code. -/
theorem DeepPureHistory.visible_resources
    {firstHints : ReturnHints firstScope} {secondHints : ReturnHints secondScope}
    {first : Context firstHints} {second : Context secondHints}
    (related : DeepPureHistory first second) :
    firstScope.visibleResources = secondScope.visibleResources := by
  induction related <;> simp_all [Scope.visibleResources]

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.AccountingTransport

/-! Resource-admission transport for the one-shot experiment. -/
namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyAnnotations (Dependencies ClauseDependencies)
open SourcePlanSignatures (Signature ClauseSignatures)
open OwnerPhaseTransitions (Phases)
open LexicalUnwind (UseMode)

/-- Reproof changes no rows, lexical receiver or source-admission index. -/
theorem CodeChecked.reproof
    {first second : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward first) : CodeChecked ambient outward second := checked

theorem PendingChecked.reproof
    {first second : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward first) : PendingChecked ambient outward second := checked

theorem CodeChecked.reindex_context {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {context : Context first} {next : Context second}
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) (same : context.pack = next.pack) :
    CodeChecked ambient outward (admitted.reindex_context same) := by
  change CodeChecked ambient outward (admitted : SourceAdmission.Code outward actions budget phases world installations rows context.pack.context) at checked
  cases same
  exact checked

theorem PendingChecked.output_mode
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) (same : after = nextAfter) :
    PendingChecked ambient outward (same ▸ admitted) := by
  cases same
  exact checked

theorem PendingChecked.reindex_outside {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {outside : Context first} {next : Context second}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) (same : outside.pack = next.pack) :
    PendingChecked ambient outward (admitted.reindex_outside same) := by
  change PendingChecked ambient outward (admitted : SourceAdmission.Pending outward actions budget phases world installations context outside.pack.context before after) at checked
  cases same
  exact checked

theorem PendingChecked.reindex_context {first : ReturnHints firstScope} {second : ReturnHints secondScope}
    {context : Context first} {next : Context second}
    {admitted : SourceAdmission.Pending outward actions budget phases world installations context outside before after}
    (checked : PendingChecked ambient outward admitted) (same : context.pack = next.pack) :
    PendingChecked ambient outward (admitted.reindex_context same) := by
  change PendingChecked ambient outward (admitted : SourceAdmission.Pending outward actions budget phases world installations context.pack.context outside before after) at checked
  cases same
  exact checked

theorem CodeChecked.computation_rows
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) (selected : ComputationRows rows nextRows) :
    CodeChecked ambient outward (admitted.computation_rows selected) := by
  cases selected with
  | binding => cases checked with | sequence first second => exact second
  | application => cases checked with | sequence functionCertificate rest =>
    cases rest with | sequence argumentCertificate bodyCertificate => exact bodyCertificate
  | trueBranch => cases checked with | sequence conditionCertificate rest =>
    cases rest with | choice yesCertificate noCertificate => exact yesCertificate
  | falseBranch => cases checked with | sequence conditionCertificate rest =>
    cases rest with | choice yesCertificate noCertificate => exact noCertificate

private theorem resume_pending_at
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
    (code : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .resume⟩))
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)))
    (located : SourceDependencyCapture.OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩) :
    phases owner = .available ∧
    SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations
      (captured.append (front.append (.spent (owner := owner) tail))) .nil .ordinary
      ((frontHints.append (.live (owner := owner) capturedHints tailHints)).returnMode .ordinary) := by
  obtain ⟨⟨_, _, actualFront⟩, ⟨_, _, actualCaptured⟩, ⟨_, _, actualTail⟩,
    actualDemand, rights, same, actualLocated, known, permission, available, shape, restored⟩ := code.resume_parts
  obtain ⟨frontSame, capturedSame, tailSame, demandSame⟩ :=
    owner_cut_context_parts front captured tail actualFront actualCaptured actualTail located actualLocated same
  cases frontSame
  cases capturedSame
  cases tailSame
  cases demandSame
  exact ⟨available, restored⟩

private theorem dispose_pending_at
    {frontHints : ReturnHints frontScope} {capturedHints : ReturnHints capturedScope} {tailHints : ReturnHints tailScope}
    {front : Context frontHints} {captured : Context capturedHints} {tail : Context tailHints}
    (code : SourceAdmission.Code outward actions budget phases world installations
      (Rows.invoke (key := ⟨owner, .dispose⟩))
      (front.append (.live (owner := owner) (resumeDemand := resumeDemand) captured tail)))
    (located : SourceDependencyCapture.OwnerCut owner
      (frontScope.append (.live owner capturedScope tailScope)) ⟨frontScope, capturedScope, tailScope⟩) :
    phases owner = .available ∧
    SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations captured
      (.closing (front.append (.spent (owner := owner) tail))) .unwind .unwind ∧
    SourceAdmission.Pending outward actions budget (OwnerPhaseTransitions.spend phases owner) world installations
      (front.append (.spent (owner := owner) tail)) .nil .ordinary
      ((frontHints.append (.live (owner := owner) capturedHints tailHints)).returnMode .ordinary) := by
  obtain ⟨⟨_, _, actualFront⟩, ⟨_, _, actualCaptured⟩, ⟨_, _, actualTail⟩,
    actualDemand, rights, same, actualLocated, known, permission, available, unprotected, abandoned, waiting⟩ := code.dispose_parts
  obtain ⟨frontSame, capturedSame, tailSame, demandSame⟩ :=
    owner_cut_context_parts front captured tail actualFront actualCaptured actualTail located actualLocated same
  cases frontSame
  cases capturedSame
  cases tailSame
  cases demandSame
  exact ⟨available, abandoned, waiting⟩

private theorem action_fresh_before
    (extension : Syntax.UsageExtension actions nextActions)
    (fresh : nextActions owner = none) : actions owner = none := by
  cases known : actions owner with
  | none => rfl
  | some rights =>
    have impossible := extension owner rights known
    rw [fresh] at impossible
    cases impossible

private theorem action_insert_extension
    (extension : Syntax.UsageExtension actions nextActions) :
    Syntax.UsageExtension (actions.insert owner rights) (nextActions.insert owner rights) := by
  intro name old known
  by_cases same : name = owner
  · subst name
    simpa [Syntax.UsageTickets.insert] using known
  · simp only [Syntax.UsageTickets.insert, if_neg same] at known ⊢
    exact extension _ _ known

private theorem request_parameters
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (request : SourceAdmission.Code outward actions budget phases world installations
      (Rows.request (effect := effect) (operation := operation)) whole)
    (cut : Cut effect operation whole captured tail contract modes) :
    SourceDependencyChecks.Lexical.Capture wholeScope effect operation ∧
    (contract.dispose = true → SourceDependencyOwners.PendingWithin world
      (SourceDependencyOwners.owners captureScope) captureScope) ∧
    RequestBudget budget phases effect operation whole ∧
    SourceAdmission.Pending outward actions budget phases world installations whole Context.nil
      .ordinary (wholeHints.returnMode .ordinary) := by
  cases request with
  | builtin found => cases found.symm.trans cut
  | request actualCut guarded callbacks ownerBound cleanupBudget selected terminal requiredRights retained body =>
    obtain ⟨sameCapture, sameTail, sameContract, _⟩ := actualCut.unique cut
    cases sameCapture
    cases sameTail
    cases sameContract
    exact ⟨guarded, ownerBound, cleanupBudget, retained⟩

/-- The resource facet is independent of ordinary phase/budget proofs. This
internal lifting lemma consumes ordinary source evidence, not destination
resource evidence; public wrappers supply the established source transports. -/
private theorem CodeChecked.parameters
    {admitted : SourceAdmission.Code outward actions budget phases world installations rows context}
    (checked : CodeChecked ambient outward admitted) :
    ∀ nextActions nextBudget nextPhases nextWorld nextInstallations,
    Syntax.UsageExtension actions nextActions → world ⊆ nextWorld → installations ⊆ nextInstallations →
    ∀ target : SourceAdmission.Code outward nextActions nextBudget nextPhases nextWorld nextInstallations rows context,
      CodeChecked ambient outward target := by
  apply CodeChecked.rec
    (motive_1 := fun {actions budget phases world installations dependencies checking rows scope hints context} admitted _ =>
      ∀ nextActions nextBudget nextPhases nextWorld nextInstallations,
      Syntax.UsageExtension actions nextActions → world ⊆ nextWorld → installations ⊆ nextInstallations →
      ∀ target : SourceAdmission.Code outward nextActions nextBudget nextPhases nextWorld nextInstallations rows context,
        CodeChecked ambient outward target)
    (motive_2 := fun {actions budget phases world installations scope outsideScope hints external context outside input output} admitted _ =>
      ∀ nextActions nextBudget nextPhases nextWorld nextInstallations,
      Syntax.UsageExtension actions nextActions → world ⊆ nextWorld → installations ⊆ nextInstallations →
      ∀ target : SourceAdmission.Pending outward nextActions nextBudget nextPhases nextWorld nextInstallations context outside input output,
        PendingChecked ambient outward target) (t := checked)
  · intros; exact .pure
  · intros; exact .builtin (found := by assumption)
  · intros
    rename_i cut callbacks guarded ownerBound cleanupBudget family bodies bodyRows declarations declarationRows terminal requiredRights selected retained body
