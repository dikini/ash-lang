/-- Preserve a closing check while inserting plain frames in both regions. -/
theorem Plain.closing_check
    {metadata : CleanupHints.Metadata scope}
    (front : Plain first nextFirst) (receiver : Plain tail nextTail)
    (found : first.closing? = some metadata)
    (checked : metadata.check tail.context phases budget = true) :
    ∃ next, nextFirst.closing? = some next ∧ next.check nextTail.context phases budget = true := by
  obtain ⟨next, nextFound, related⟩ := front.metadata found
  exact ⟨next, nextFound, related.checked receiver.contexts checked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport

/-- Preserve a closing check while inserting an already-consumed owner's history. -/
theorem SpentHistory.closing_check
    {metadata : CleanupHints.Metadata scope}
    (front : SpentHistory freshOwner first nextFirst) (receiver : SpentHistory freshOwner tail nextTail)
    (found : first.closing? = some metadata)
    (consumed : phases freshOwner = .consumed)
    (checked : metadata.check tail.context phases budget = true) :
    ∃ next, nextFirst.closing? = some next ∧ next.check nextTail.context phases budget = true := by
  obtain ⟨next, nextFound, related⟩ := front.metadata found
  exact ⟨next, nextFound, related.checked receiver.contexts consumed checked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SpentTransport

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Plain.closing_check
