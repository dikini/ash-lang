namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ProtectionContracts (Footprint)
open SourceDependencyChecks.Lexical (ReturnHints)
open LexicalUnwind (UseMode)
open OwnerPhaseTransitions (Phases)

def Context.callback {hints : ReturnHints scope} (mode : UseMode) (context : Context hints) :
    Context (.running (SourceDependencyChecks.Lexical.ReturnHints.Recursive.callbackBoundary mode) hints) :=
  match mode with
  | .ordinary => .normal context
  | .unwind => .unwinding context

/-- Pending code retains its source budget admission under the actual caller
suffix. Active callbacks preserve their return mode; dormant captures retain
both their saved context and the enclosing continuation. -/
inductive PendingBudget (budget : Footprint) (phases : Phases) (world installations : List Nat) :
    {scope outside : SourceDependencyCapture.Scope} →
    {hints : ReturnHints scope} → {external : ReturnHints outside} →
    Context hints → Context external → UseMode → UseMode → Prop where
  | nil : PendingBudget budget phases world installations .nil outside mode mode
  | plain
      (code : Budgeted budget phases world installations rows (rest.append outside))
      (tail : PendingBudget budget phases world installations rest outside .ordinary finalMode) :
      PendingBudget budget phases world installations (.plain rows rest) outside .ordinary finalMode
  | skipped (tail : PendingBudget budget phases world installations rest outside .unwind finalMode) :
      PendingBudget budget phases world installations (.plain rows rest) outside .unwind finalMode
  | handler (tail : PendingBudget budget phases world installations rest outside mode finalMode) :
      PendingBudget budget phases world installations (.handler activation rows rest) outside mode finalMode
  | cell (tail : PendingBudget budget phases world installations rest outside mode finalMode) :
      PendingBudget budget phases world installations (.cell rest) outside mode finalMode
  | cleanup
      (callback : Budgeted budget phases world installations rows ((rest.append outside).callback mode))
      (tail : PendingBudget budget phases world installations rest outside mode finalMode) :
      PendingBudget budget phases world installations (.cleanup latent rows rest) outside mode finalMode
  | normal (tail : PendingBudget budget phases world installations rest outside .ordinary finalMode) :
      PendingBudget budget phases world installations (.normal rest) outside .ordinary finalMode
  | unwinding (tail : PendingBudget budget phases world installations rest outside .unwind finalMode) :
      PendingBudget budget phases world installations (.unwinding rest) outside .ordinary finalMode
  | closing (tail : PendingBudget budget phases world installations rest outside .ordinary finalMode) :
      PendingBudget budget phases world installations (.closing rest) outside mode finalMode
  | retiring (tail : PendingBudget budget phases world installations rest outside mode finalMode) :
      PendingBudget budget phases world installations (.retiring owner rest) outside mode finalMode
  | live (saved : PendingBudget budget phases world installations captured (rest.append outside) .ordinary middle)
      (tail : PendingBudget budget phases world installations rest outside middle finalMode) :
      PendingBudget budget phases world installations (.live (resumeDemand := resumeDemand) captured rest) outside .ordinary finalMode
  | opening
      (saved : PendingBudget budget phases world installations captured (.retiring owner (rest.append outside)) .unwind .unwind)
      (tail : PendingBudget budget phases world installations rest outside .unwind finalMode) :
      PendingBudget budget phases world installations (.live (resumeDemand := resumeDemand) (owner := owner) captured rest) outside .unwind finalMode
  | spent (tail : PendingBudget budget phases world installations rest outside mode finalMode) :
      PendingBudget budget phases world installations (.spent rest) outside mode finalMode

/-- Registration places the exact retained callback rows in the pending scope,
with their checked normal-return context. The enclosing source admission supplies
authentication of those rows. -/
theorem Budgeted.cleanup_entry
    {hints : ReturnHints scope} {external : ReturnHints outsideScope}
    {context : Context hints} {outside : Context external}
    (checked : Budgeted budget phases world installations (.cleanup (needs := needs) latent callbackRows bodyRows) (context.append outside))
    (pending : PendingBudget budget phases world installations context outside .ordinary finalMode) :
    Budgeted budget phases world installations bodyRows (.cleanup (needs := needs) latent callbackRows (context.append outside)) ∧
    PendingBudget budget phases world installations (.cleanup (needs := needs) latent callbackRows context) outside .ordinary finalMode := by
  cases checked with
  | cleanup body callback =>
      refine ⟨body, .cleanup ?_ pending⟩
      exact callback

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Budgeted.cleanup_entry

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyFrames (ClosingEffects)

/-- A consuming request derives both cleanup-effect judgments from the
certificate retained in its actual source admission. The selected prefix and
receiving tail are authenticated physical source fragments; neither a fresh
budget check nor an arbitrary cleanup agreement is an input. -/
theorem Admitted.request_effects
    {operandSignature : SourcePlanSignatures.Signature operandDependencies}
    {operandRows : Rows operandSignature}
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (checked : Admitted operations policy contracts ports owners environment environmentRows world installations allowed outward
      runtimeScope actions phases budget tables families whole stack
      (.perform (Instantiation.freezeEffect effect) operation operand) result demand requirements
      (.sequence operandSignature (.request (effect := effect) (operation := operation))) resultRows
      (.sequence operandRows (.request (effect := effect) (operation := operation))))
    (cut : Cut effect operation whole captured tail contract modes)
    (consuming : contract.dispose = true) :
    ∃ capStack tailStack, ∃ metadata : CleanupHints.Metadata captureScope,
      stack = capStack.append tailStack ∧ captured.closing? = some metadata ∧
      CleanupHints.Agreement operations.erase policy contracts.erase tables families world metadata capStack
        metadata.closing.1 metadata.closing.2 ∧
      ClosingEffects budget (OwnerPhases.ofStack tables tailStack) phases metadata.closing.2 ∧
      ClosingEffects budget (.ordinary (.barrier true) :: OwnerPhases.ofStack tables tailStack) phases metadata.closing.2 := by
  cases checked.cleanupBudget with
  | sequence operandBudget requestBudget =>
    cases requestBudget with
    | request retained =>
      obtain ⟨metadata, projected, ordinary, protectedCheck⟩ := retained.consuming cut consuming
      obtain ⟨capStack, tailStack, decomposition, captureSource, tailSource⟩ := checked.contextSource.cut cut
      have agreed := captureSource.closing_agreement projected
      obtain ⟨ordinaryEffects, protectedEffects⟩ := agreed.effects_pair ordinary protectedCheck
      refine ⟨capStack, tailStack, metadata, decomposition, projected, agreed, ?_, ?_⟩
      · simpa only [tailSource.context_eq] using ordinaryEffects
      · simpa only [tailSource.context_eq] using protectedEffects

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Admitted.request_effects

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
