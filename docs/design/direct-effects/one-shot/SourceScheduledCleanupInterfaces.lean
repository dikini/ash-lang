/-- Terminal rows expose the exact active-spine decomposition; saved contexts
remain in the prefix rather than becoming an alternative declaration source. -/
theorem TerminalHandler.decomposition
    (terminal : TerminalHandler effect activation rows captured) :
    ∃ front : Packed, ∃ table,
      captured.pack = (front.context.append
        (.handler (effect := effect) (table := table) activation rows Context.nil)).pack := by
  induction terminal with
  | here => exact ⟨Context.nil.pack, _, rfl⟩
  | @plain restScope restHints rest deps sig waiting terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.plain waiting front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.plain waiting packed.context).pack) same
  | @handler restScope restHints rest other outerTable next fs ds outerRows terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.handler (effect := other) (table := outerTable) next outerRows front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.handler (effect := other) (table := outerTable) next outerRows packed.context).pack) same
  | @cell restScope restHints rest identity terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.cell (identity := identity) front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.cell (identity := identity) packed.context).pack) same
  | @cleanup restScope restHints rest needs latent deps sig callback terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.cleanup (needs := needs) latent callback front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.cleanup (needs := needs) latent callback packed.context).pack) same
  | normal terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.normal front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.normal packed.context).pack) same
  | unwinding terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.unwinding front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.unwinding packed.context).pack) same
  | closing terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.closing front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.closing packed.context).pack) same
  | @retiring restScope restHints rest owner terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.retiring owner front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.retiring owner packed.context).pack) same
  | @live restScope restHints rest owner resumeDemand savedScope savedHints saved terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.live (owner := owner) (resumeDemand := resumeDemand) saved front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.live (owner := owner) (resumeDemand := resumeDemand) saved packed.context).pack) same
  | @spent restScope restHints rest owner terminal ih =>
      obtain ⟨front, table, same⟩ := ih
      refine ⟨(Context.spent (owner := owner) front.context).pack, table, ?_⟩
      exact congrArg (fun packed : Packed => (Context.spent (owner := owner) packed.context).pack) same

/-- The actual terminal handler frame retains its declaration authentication in
both ordinary and unwind mode. -/
theorem RecordPendingRows.handler_declarations
    {declarations : ClauseSignatures clauseDependencies}
    {declarationRows : ClauseRows declarations}
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (coherent : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (contextEq : context.pack =
      (Context.handler (effect := effect) (table := table) activation declarationRows Context.nil).pack) :
    ∃ handler : HandlerData, ∃ answer residual, ∃ plans : ClausePlans handler.clauses (families handler),
    ∃ answerRows : ValueRows answer, ∃ actualRows : ClauseRows (clauseSignatures plans),
    ∃ declarations : SourcePlannedSources.Declarations operations policy contracts world (fun _ => none)
      residual handler.effectInst answer handler.clauses (tables handler) plans,
      stack = .push (.handler handler) .nil ∧ handler.effectInst = effect ∧ handler.activation = activation ∧
      answer.erase.erase.port = ScopedPorts.eraseType handler.answer ∧
      ModeRowsValue.Answer answerRows outputRows ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports handler.scope ∧
      SourcePlannedChecks.CertifiedClauses (evidence := declarationPolicy) outward world plans ∧
      AuthDeclarations operations policy ports owners emptyRows answerRows declarations actualRows ∧
      TerminalHandler effect activation actualRows
        (Context.handler (effect := effect) (table := table) activation declarationRows Context.nil) ∧
      (Context.handler (effect := effect) (table := table) activation declarationRows Context.nil).pack =
        (Context.handler (effect := handler.effectInst) (table := tables handler) handler.activation actualRows Context.nil).pack := by
  cases coherent with
  | nil | live | opening | spent | skippedSpent => cases contextEq
  | push head tail =>
    cases head with
    | ordinary head | handler head =>
      cases head
      all_goals try cases contextEq
      all_goals
        have tailPhysical := tail.forget.source
        cases tailPhysical
        cases tail
        exact ⟨_, _, _, _, _, _, _, rfl, rfl, rfl, by assumption, by constructor, by assumption, by assumption, by assumption, .here, rfl⟩
    | unwinding | closing | retiring | skipped | cell | cleanup => cases contextEq

/-- Rich splitting isolates the selected physical handler without repeating a
pending-source induction or replacing its authenticated row witness. -/
theorem RecordPendingRows.terminal_declarations
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (coherent : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (terminal : TerminalHandler effect activation declarationRows context) :
    ∃ frontStack : Stack, ∃ handler : HandlerData, ∃ answer residual, ∃ plans : ClausePlans handler.clauses (families handler),
    ∃ answerRows : ValueRows answer, ∃ actualRows : ClauseRows (clauseSignatures plans),
    ∃ declarations : SourcePlannedSources.Declarations operations policy contracts world (fun _ => none)
      residual handler.effectInst answer handler.clauses (tables handler) plans,
      stack = frontStack.append (.push (.handler handler) .nil) ∧
      handler.effectInst = effect ∧ handler.activation = activation ∧
      answer.erase.erase.port = ScopedPorts.eraseType handler.answer ∧
      ModeRowsValue.Answer answerRows outputRows ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports handler.scope ∧
      SourcePlannedChecks.CertifiedClauses (evidence := declarationPolicy) outward world plans ∧
      AuthDeclarations operations policy ports owners emptyRows answerRows declarations actualRows ∧
      TerminalHandler effect activation actualRows context ∧
      ∃ front : Packed, context.pack = (front.context.append
        (Context.handler (effect := handler.effectInst) (table := tables handler) handler.activation actualRows Context.nil)).pack := by
  obtain ⟨front, table, same⟩ := terminal.decomposition
  obtain ⟨frontStack, terminalStack, middle, middleRows, firstDemand, secondDemand, firstRequirements,
    secondRequirements, firstSource, secondSource, stackEq, frontRows, handlerRows, remaining⟩ :=
    coherent.split_disposals front.context
      (Context.handler (effect := effect) (table := table) activation declarationRows Context.nil) same
  obtain ⟨handler, answer, residual, plans, answerRows, actualRows, declarations,
    terminalEq, effectEq, activationEq, answerAnnotation, answerMode, callerScope, certified, authenticated, retained, terminalPacked⟩ := handlerRows.handler_declarations rfl
  refine ⟨frontStack, handler, answer, residual, plans, answerRows, actualRows, declarations,
    stackEq.trans (congrArg (Stack.append frontStack) terminalEq), effectEq, activationEq, answerAnnotation, answerMode, callerScope, certified, authenticated, ?_, front, ?_⟩
  · change TerminalHandler effect activation actualRows context.pack.context
    rw [same]
    exact retained.prefix front.context
  · exact same.trans (congrArg (fun packed : Packed => (front.context.append packed.context).pack) terminalPacked)


/-- An exact decorated request cut exposes the actual installed authenticated
clauses, with their retained row decorations and physical handler identity. -/
theorem RecordPendingRows.cut_declarations
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (coherent : RecordPendingRows operations policy contracts tables families required outward actions world
      ports owners emptyRows resumes source inputRows outputRows context)
    (cut : Cut effect operation context captured tail offered modes) :
    ∃ capturedStack tailStack frontStack : Stack, ∃ handler : HandlerData, ∃ answer residual,
    ∃ plans : ClausePlans handler.clauses (families handler),
    ∃ answerRows : ValueRows answer, ∃ actualRows : ClauseRows (clauseSignatures plans),
    ∃ declarations : SourcePlannedSources.Declarations operations policy contracts world (fun _ => none)
      residual handler.effectInst answer handler.clauses (tables handler) plans,
      stack = capturedStack.append tailStack ∧
      capturedStack = frontStack.append (.push (.handler handler) .nil) ∧
      handler.effectInst = effect ∧
      AuthDeclarations operations policy ports owners emptyRows answerRows declarations actualRows ∧
      TerminalHandler effect handler.activation actualRows captured ∧
      ∃ front : Packed, captured.pack = (front.context.append
        (Context.handler (effect := handler.effectInst) (table := tables handler) handler.activation actualRows Context.nil)).pack := by
  obtain ⟨capturedStack, tailStack, middle, middleRows, firstDemand, secondDemand, firstRequirements,
    secondRequirements, firstSource, secondSource, stackEq, capturedRows, tailRows, remaining⟩ :=
    coherent.split_disposals captured tail cut.decomposition
  obtain ⟨activation, clauseDependencies, declarationSignatures, declarationRows, terminal⟩ := cut.terminal_handler
  obtain ⟨frontStack, handler, answer, residual, plans, answerRows, actualRows, declarations,
    terminalEq, effectEq, activationEq, _answerAnnotation, _answerMode, _callerScope, _certified, authenticated, retained, terminalPacked⟩ := capturedRows.terminal_declarations terminal
  exact ⟨capturedStack, tailStack, frontStack, handler, answer, residual, plans, answerRows, actualRows,
    declarations, stackEq, terminalEq, effectEq, authenticated, activationEq.symm ▸ retained, terminalPacked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.cut_declarations

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.TerminalHandler.decomposition

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.handler_declarations

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.terminal_declarations

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDeclarationPlans (ClausePlans)
open SourcePlanSignatures (clauseSignatures)

/-- Authenticated row selection identifies the actual clause syntax and offered
mode. It does not reconstruct a clause from dependency signatures. -/
theorem AuthDeclarations.selected_origin
    {plans : ClausePlans clauses families}
    {declarationRows : ClauseRows (clauseSignatures plans)}
    {source : SourcePlannedSources.Declarations operations policy contracts world environment allowed effect answer clauses table plans}
    (authenticated : AuthDeclarations operations policy ports owners environmentRows answerRows source declarationRows)
    (chosen : ClauseRows.Selected operation held declarationRows bodyRows) :
    ∃ parameter binder code offered row,
      ClauseAt operation clauses parameter binder code ∧
      lookup operation table = some offered ∧ offered.row held = some row := by
  induction clauses using Clauses.rec (motive_1 := fun _ => True) generalizing table families with
  | nil => cases authenticated; cases chosen
  | cons other parameter binder code rest ihCode ihRest =>
      cases authenticated with
      | cons ordinary protectedMode rest support =>
        cases ordinary <;> cases protectedMode <;> cases chosen
        all_goals first
        | case pass different next =>
          obtain ⟨parameter, binder, code, offered, row, located, found, available⟩ := ihRest rest next
          exact ⟨parameter, binder, code, offered, row, .pass different located,
            by simpa only [lookup, if_neg different] using found, available⟩
        | simp only [lookup]
          exact ⟨_, _, _, _, _, .hit, rfl, rfl⟩
  | _ => trivial

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.AuthDeclarations.selected_origin

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

/-- The request's selected family belongs to the independently recovered
actual authenticated declaration rows at the same captured handler. -/
theorem CapturedClauseRows.selected_at
    (selected : CapturedClauseRows effect operation held captured bodyRows)
    (actual : TerminalHandler effect activation actualRows captured) :
    ClauseRows.Selected operation held actualRows bodyRows := by
  cases selected with
  | selected terminal chosen =>
      obtain ⟨_, _, familiesSame, declarationsSame, rowsSame⟩ := terminal.unique actual
      cases familiesSame
      cases declarationsSame
      cases rowsSame
      exact chosen

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.CapturedClauseRows.selected_at

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)
open Contextual

/-- A ready request exposes the actual operation instance and removes only
its value operand's silent accounting prefix. -/
theorem Auth.ready_request_accounting
    {source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope environment
      code result demand requirements checking}
    (authenticated : Auth operations policy ports owners environmentRows source resultRows rows)
    (expression : code = .perform effect operation operand)
    (value : operand.IsValue)
    (run : Accounting.Run world installations rows context (root : Requirements rootDemand)) :
    ∃ requested input, ∃ known : operations requested operation = some (input, result),
      effect = Instantiation.freezeEffect requested ∧
      HEq resultRows (ports requested operation input result known).2 ∧
      Accounting.Run world installations (Rows.request (effect := requested) (operation := operation)) context root := by
  cases expression
  cases authenticated with
  | perform operandChecked =>
    rename_i operandSource
    exact ⟨_, _, by assumption, rfl, HEq.rfl,
      (Accounting.silent_prefix_iff (SourceDependencyAnnotations.value_silent
        (SourcePlannedSources.expression_erase operandSource) value) _ _).mp run⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Auth.ready_request_accounting

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open RecursiveRequirements (Requirements)

theorem ExecutionRoot.ready_request
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (expression : site.expression = .perform effect operation operand)
    (value : operand.IsValue) :
    Accounting.Run world installations site.rows site.context root := by
  cases rooted with
  | contextual interpreted => exact interpreted
  | branch selected inside =>
      have branch := selected.1
      rw [expression] at branch
      cases branch
  | focus focused inside =>
      have focus := focused.1
      rw [expression] at focus
      cases focus with
      | perform notValue => exact False.elim (notValue value)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionRoot.ready_request

namespace Ash.OneShot.RecursiveRequirements
open SourceScheduledCleanupInterfaces.Lexical.Recursive (annotateDisposals)

/-- Local ownership roots contain no invocation or emitted effect. Allocation
may therefore change the record store and receiving context without rechecking
any effect or cleanup source judgment. -/
theorem LocalOwner.evaluate_irrelevant
    (binding : LocalOwner owner before (localRoot : Requirements localDemand)
      (outerRoot : Requirements outerDemand) after) :
    ∀ firstFuel secondFuel firstStore secondStore firstReceiving secondReceiving phases,
      evaluateFuel firstFuel firstStore firstReceiving phases localRoot =
        evaluateFuel secondFuel secondStore secondReceiving phases localRoot := by
  induction binding with
  | empty => intros; simp [evaluateFuel, OwnerSource.exportAt, ProtectionResiduals.residual_empty]
  | retireSelf | spentSelf | retireOther | spentOther => intros; simp only [evaluateFuel]
  | sequence first second ihFirst ihSecond | choice first second ihFirst ihSecond =>
    intro firstFuel secondFuel firstStore secondStore firstReceiving secondReceiving phases
    simp only [evaluateFuel]
    rw [ihFirst firstFuel secondFuel firstStore secondStore firstReceiving secondReceiving phases,
      ihSecond firstFuel secondFuel firstStore secondStore firstReceiving secondReceiving _]

theorem LocalOwner.checked_relocate
    (binding : LocalOwner owner before (localRoot : Requirements localDemand)
      (outerRoot : Requirements outerDemand) after)
    (checked : Checked store receiving phases localRoot row) :
    Checked nextStore nextReceiving phases localRoot row := by
  apply evaluate_sound
  exact (binding.evaluate_irrelevant _ _ _ _ _ _ _).trans (checked_complete checked)

theorem LocalOwner.annotate_disposals
    (binding : LocalOwner owner before (localRoot : Requirements localDemand)
      (outerRoot : Requirements outerDemand) after) :
    annotateDisposals localRoot = localRoot ∧ annotateDisposals outerRoot = outerRoot := by
  induction binding <;> simp_all [annotateDisposals]

end Ash.OneShot.RecursiveRequirements
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.evaluate_irrelevant
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.checked_relocate
#print axioms Ash.OneShot.RecursiveRequirements.LocalOwner.annotate_disposals

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements Checked LocalOwner)
open OwnerPhaseTransitions (available)

/-- Actual cut/row identity and the predecessor check derive the allocated
clause's finite check. The new store and receiving context need no extra check
premise because this root is the independent ownership interpretation. -/
theorem Run.request_checked_body
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope}
    {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    {family : Nat → SourceDependencyAnnotations.Dependencies}
    {bodies : ∀ owner, Signature (family owner)} {bodyRows : ∀ owner, Rows (bodies owner)}
    (run : Run world installations (Rows.request (effect := effect) (operation := operation)) whole (root : Requirements demand))
    (cut : Cut effect operation whole captured tail contract modes)
    (selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
    (owner : Nat) (resumeDemand : List Nat) (fresh : owner ∉ whole.ticketNames)
    (unique : whole.owned.Nodup)
    (checked : Checked store receiving (available whole.owned) (annotateDisposals root) row) :
    ∃ localDemand, ∃ localRoot : Requirements localDemand,
      Run world installations (bodyRows owner)
        (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail) localRoot ∧
      Checked nextStore nextReceiving
        (available (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail).owned)
        (annotateDisposals localRoot) row ∧ localDemand.Perm (owner :: demand) := by
  obtain ⟨localDemand, localRoot, body, binding⟩ := run.request_body cut selected owner resumeDemand fresh
  rw [binding.annotate_disposals.2] at checked
  have absent : owner ∉ whole.owned := fun member => fresh (Context.owned_subset_ticketNames _ member)
  obtain ⟨localCheck, _balance⟩ := body.capture_owned cut binding unique absent checked
  refine ⟨localDemand, localRoot, body, ?_, binding.demand_discharge⟩
  rw [binding.annotate_disposals.1]
  exact binding.checked_relocate localCheck

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.request_checked_body

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.InstallationSupport
open SourceDependencyChecks.Lexical (ReturnHints)
open SourcePlanSignatures (Signature)
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (available)

/-- Source authentication selects the same operation instance as the physical
ready expression; its actual contextual root supplies the new clause check. -/
theorem ExecutionSite.request_checked_body
    {site : ExecutionSite ambient operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows}
    {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {captured : Context captureHints} {tail : Context tailHints}
    {family : Nat → SourceDependencyAnnotations.Dependencies}
    {bodies : ∀ owner, Signature (family owner)} {bodyRows : ∀ owner, Rows (bodies owner)}
    (rooted : ExecutionRoot operations policy contracts tables families required outward actions phases world installations
      resumes budget ports owners emptyRows output outputRows site (root : Requirements demand))
    (expression : site.expression = .perform (Instantiation.freezeEffect effect) operation operand)
    (value : operand.IsValue)
    (cut : Cut effect operation site.context captured tail contract modes)
    (selected : CapturedClauseRows effect operation captureScope.held captured bodyRows)
    (owner : Nat) (resumeDemand : List Nat) (fresh : owner ∉ site.context.ticketNames)
    (unique : site.context.owned.Nodup)
    (checked : Checked store rootReceiving (available site.context.owned) (annotateDisposals root) row) :
    ∃ localDemand, ∃ localRoot : Requirements localDemand,
      Accounting.Run world installations (bodyRows owner)
        (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail) localRoot ∧
      Checked nextStore nextReceiving
        (available (Context.live (owner := owner) (resumeDemand := resumeDemand) captured tail).owned)
        (annotateDisposals localRoot) row ∧ localDemand.Perm (owner :: demand) := by
  have run := rooted.ready_request expression value
  obtain ⟨requested, input, known, effectEq, _resultRows, primitive⟩ :=
    site.current.previous.authenticated.ready_request_accounting expression value run
  have realization : Instantiation.EffectRealizes Instantiation.Environment.empty
      (Instantiation.freezeEffect effect) requested := by
    rw [effectEq]
    exact Instantiation.frozen_effect_realizes _ _
  have same := Instantiation.frozen_effect_cannot_change realization
  subst requested
  exact primitive.request_checked_body cut selected owner resumeDemand fresh unique checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ExecutionSite.request_checked_body

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution
open SourceDependencyChecks.Lexical (ReturnHints)
open LexicalUnwind (UseMode)

/-- Finite source annotation, not a checker: ordinary plain-frame demands are
retained from their actual typed source. Dormant captures retain their own views. -/
inductive SourceDemand : {scope : SourceDependencyCapture.Scope} → {hints : ReturnHints scope} →
    Context hints → UseMode → UseMode → Type where
  | nil : SourceDemand .nil mode mode
  | plain (frameDemand : List Nat) (tail : SourceDemand rest .ordinary output) :
      SourceDemand (.plain rows rest) .ordinary output
  | skipped (tail : SourceDemand rest .unwind output) : SourceDemand (.plain rows rest) .unwind output
  | handler (tail : SourceDemand rest input output) : SourceDemand (.handler activation rows rest) input output
  | cell (tail : SourceDemand rest input output) : SourceDemand (.cell rest) input output
  | cleanup (tail : SourceDemand rest input output) : SourceDemand (.cleanup latent rows rest) input output
  | normal (tail : SourceDemand rest .ordinary output) : SourceDemand (.normal rest) .ordinary output
  | unwinding (tail : SourceDemand rest .unwind output) : SourceDemand (.unwinding rest) .ordinary output
  | closing (tail : SourceDemand rest .ordinary output) : SourceDemand (.closing rest) input output
  | retiring (tail : SourceDemand rest input output) : SourceDemand (.retiring owner rest) input output
  | live (saved : SourceDemand captured .ordinary middle) (tail : SourceDemand rest middle output) :
      SourceDemand (.live (owner := owner) (resumeDemand := resumeDemand) captured rest) .ordinary output
  | opening (ordinary : SourceDemand captured .ordinary middle)
      (saved : SourceDemand captured .unwind .unwind) (tail : SourceDemand rest .unwind output) :
      SourceDemand (.live (owner := owner) (resumeDemand := resumeDemand) captured rest) .unwind output
  | spent (tail : SourceDemand rest input output) : SourceDemand (.spent rest) input output

def SourceDemand.fold : SourceDemand context input output → List Nat
  | .nil => []
  | .plain demand tail => demand ++ tail.fold
  | .skipped tail | .handler tail | .cell tail | .cleanup tail | .normal tail
  | .unwinding tail | .closing tail | .spent tail => tail.fold
  | .retiring (owner := owner) tail => owner :: tail.fold
  | .live _ tail => tail.fold
  | .opening (owner := owner) _ saved tail => saved.fold ++ owner :: tail.fold

/-- Every dormant ordinary view uses its literal recorded contract demand. -/
def SourceDemand.Recorded : SourceDemand context input output → Prop
  | .nil => True
  | .plain _ tail | .skipped tail | .handler tail | .cell tail | .cleanup tail | .normal tail
  | .unwinding tail | .closing tail | .retiring tail | .spent tail => tail.Recorded
  | .live (resumeDemand := resumeDemand) saved tail =>
      saved.fold = resumeDemand ∧ saved.Recorded ∧ tail.Recorded
  | .opening (resumeDemand := resumeDemand) ordinary saved tail =>
      ordinary.fold = resumeDemand ∧ ordinary.Recorded ∧ saved.Recorded ∧ tail.Recorded

/-- One actual source frame contributes exactly its existing demand annotation. -/
theorem ModeFrameRows.sourceDemand
    {frame : PlannedModeFrame operations policy contracts tables families required outward world
      entry input middle frameDemand requirements layer}
    (rows : ModeFrameRows operations policy contracts tables families required outward world ports owners emptyRows
      frame inputRows middleRows rest decorated)
    (tail : SourceDemand rest middle.mode output) :
    ∃ annotation : SourceDemand decorated input.mode output,
      annotation.fold = frameDemand ++ tail.fold ∧ (tail.Recorded → annotation.Recorded) := by
  cases rows with
  | ordinary actual =>
      cases actual with
      | plain authenticated =>
          refine ⟨.plain frameDemand tail, ?_, ?_⟩
          · rfl
          · simp only [SourceDemand.Recorded]; exact id
      | handler authenticated => exact ⟨.handler tail, rfl, id⟩
      | cell => exact ⟨.cell tail, rfl, id⟩
      | armed authenticated => exact ⟨.cleanup tail, rfl, id⟩
      | running callback saved => exact ⟨.normal tail, rfl, id⟩
      | closing => exact ⟨.closing tail, rfl, id⟩
      | retiring => exact ⟨.retiring tail, rfl, id⟩
  | unwinding authenticated => exact ⟨.unwinding tail, rfl, id⟩
  | closing => exact ⟨.closing tail, rfl, id⟩
  | retiring => exact ⟨.retiring tail, rfl, id⟩
  | skipped => exact ⟨.skipped tail, rfl, id⟩
  | handler actual => cases actual with | handler authenticated => exact ⟨.handler tail, rfl, id⟩
  | cell => exact ⟨.cell tail, rfl, id⟩
  | cleanup authenticated => exact ⟨.cleanup tail, rfl, id⟩

/-- Projection authenticates the fold against this same source, not another
source with the same erased stack. Both saved views at opening remain available. -/
theorem RecordPendingRows.sourceDemand
    {source : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements scope}
    (rows : RecordPendingRows operations policy contracts tables families required outward actions world ports owners emptyRows resumes
      source inputRows outputRows context) :
    ∃ annotation : SourceDemand context input.mode output.mode,
      annotation.fold = demand ∧ annotation.Recorded := by
  induction rows with
  | nil => exact ⟨.nil, rfl, trivial⟩
  | push head tail ih =>
      obtain ⟨rest, same, recorded⟩ := ih
      obtain ⟨annotation, folded, retained⟩ := head.sourceDemand rest
      exact ⟨annotation, folded.trans (congrArg (_ ++ ·) same), retained recorded⟩
  | live answerRows agreement inside tail ihInside ihTail =>
      obtain ⟨saved, savedSame, savedRecorded⟩ := ihInside
      obtain ⟨rest, same, recorded⟩ := ihTail
      exact ⟨.live saved rest, same, savedSame, savedRecorded, recorded⟩
  | opening answerRows agreement ordinary inside tail ihOrdinary ihInside ihTail =>
      obtain ⟨normal, normalSame, normalRecorded⟩ := ihOrdinary
      obtain ⟨saved, savedSame, savedRecorded⟩ := ihInside
      obtain ⟨rest, same, recorded⟩ := ihTail
      refine ⟨.opening normal saved rest, ?_, normalSame, normalRecorded, savedRecorded, recorded⟩
      change saved.fold ++ _ :: rest.fold = _
      rw [savedSame, same]
      rfl
  | spent tail ih | skippedSpent tail ih =>
      obtain ⟨rest, same, recorded⟩ := ih
      exact ⟨.spent rest, same, recorded⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.RecordPendingRows.sourceDemand

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open LexicalUnwind (UseMode)
open AccountingTransport

/-- Zero-demand pure frames preserve the retained source demand in either mode. -/
def SourceDemand.purePrefix (annotation : SourceDemand context input output) :
    SourceDemand (.plain Rows.pure context) input output :=
  match input with
  | .ordinary => .plain [] annotation
  | .unwind => .skipped annotation

theorem SourceDemand.purePrefix_fold (annotation : SourceDemand context input output) :
    annotation.purePrefix.fold = annotation.fold := by cases input <;> rfl

theorem SourceDemand.purePrefix_recorded (annotation : SourceDemand context input output) :
    annotation.Recorded → annotation.purePrefix.Recorded := by cases input <;> exact id

/-- Transport the data through pure insertion, including inside dormant captures. -/
theorem SourceDemand.deep_pure_history
    (annotation : SourceDemand first input output) (related : DeepPureHistory first second) :
    ∃ next : SourceDemand second input output,
      next.fold = annotation.fold ∧ (annotation.Recorded → next.Recorded) := by
  induction related generalizing input output with
  | same => exact ⟨annotation, rfl, id⟩
  | add related ih =>
      obtain ⟨next, same, recorded⟩ := ih annotation
      exact ⟨next.purePrefix, next.purePrefix_fold.trans same, fun h => next.purePrefix_recorded (recorded h)⟩
  | plain rows related ih => cases annotation with
      | plain demand tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.plain demand next, congrArg (demand ++ ·) same, recorded⟩
      | skipped tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.skipped next, same, recorded⟩
  | handler rows related ih => cases annotation with
      | handler tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.handler next, same, recorded⟩
  | cell related ih => cases annotation with
      | cell tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.cell next, same, recorded⟩
  | cleanup rows related ih => cases annotation with
      | cleanup tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.cleanup next, same, recorded⟩
  | normal related ih => cases annotation with
      | normal tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.normal next, same, recorded⟩
  | unwinding related ih => cases annotation with
      | unwinding tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.unwinding next, same, recorded⟩
  | closing related ih => cases annotation with
      | closing tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.closing next, same, recorded⟩
  | retiring related ih => cases annotation with
      | retiring tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.retiring next, congrArg (_ :: ·) same, recorded⟩
  | spent related ih => cases annotation with
      | spent tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.spent next, same, recorded⟩
  | live savedRelated tailRelated ihSaved ihTail => cases annotation with
      | live saved tail =>
          obtain ⟨nextSaved, savedSame, savedRecorded⟩ := ihSaved saved
          obtain ⟨nextTail, tailSame, tailRecorded⟩ := ihTail tail
          exact ⟨.live nextSaved nextTail, tailSame,
            fun h => ⟨savedSame.trans h.1, savedRecorded h.2.1, tailRecorded h.2.2⟩⟩
      | opening ordinary saved tail =>
          obtain ⟨nextOrdinary, ordinarySame, ordinaryRecorded⟩ := ihSaved ordinary
          obtain ⟨nextSaved, savedSame, savedRecorded⟩ := ihSaved saved
          obtain ⟨nextTail, tailSame, tailRecorded⟩ := ihTail tail
          refine ⟨.opening nextOrdinary nextSaved nextTail, ?_,
            fun h => ⟨ordinarySame.trans h.1, ordinaryRecorded h.2.1, savedRecorded h.2.2.1, tailRecorded h.2.2.2⟩⟩
          change nextSaved.fold ++ _ :: nextTail.fold = saved.fold ++ _ :: tail.fold
          rw [savedSame, tailSame]

/-- Spent insertion preserves the exact demand and recorded dormant views. -/
theorem SourceDemand.spent_history
    (annotation : SourceDemand first input output) (related : SpentTransport.SpentHistory freshOwner first second) :
    ∃ next : SourceDemand second input output,
      next.fold = annotation.fold ∧ (annotation.Recorded → next.Recorded) := by
  induction related generalizing input output with
  | same => exact ⟨annotation, rfl, id⟩
  | add related ih =>
      obtain ⟨next, same, recorded⟩ := ih annotation
      exact ⟨.spent next, same, recorded⟩
  | plain rows related ih => cases annotation with
      | plain demand tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.plain demand next, congrArg (demand ++ ·) same, recorded⟩
      | skipped tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.skipped next, same, recorded⟩
  | handler rows related ih => cases annotation with
      | handler tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.handler next, same, recorded⟩
  | cell related ih => cases annotation with
      | cell tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.cell next, same, recorded⟩
  | cleanup rows related ih => cases annotation with
      | cleanup tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.cleanup next, same, recorded⟩
  | normal related ih => cases annotation with
      | normal tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.normal next, same, recorded⟩
  | unwinding related ih => cases annotation with
      | unwinding tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.unwinding next, same, recorded⟩
  | closing related ih => cases annotation with
      | closing tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.closing next, same, recorded⟩
  | retiring related ih => cases annotation with
      | retiring tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.retiring next, congrArg (_ :: ·) same, recorded⟩
  | spent related ih => cases annotation with
      | spent tail =>
          obtain ⟨next, same, recorded⟩ := ih tail
          exact ⟨.spent next, same, recorded⟩
  | live savedContext related ih => cases annotation with
      | live saved tail =>
          obtain ⟨nextTail, tailSame, tailRecorded⟩ := ih tail
          exact ⟨.live saved nextTail, tailSame,
            fun h => ⟨h.1, h.2.1, tailRecorded h.2.2⟩⟩
      | opening ordinary saved tail =>
          obtain ⟨nextTail, tailSame, tailRecorded⟩ := ih tail
          refine ⟨.opening ordinary saved nextTail, ?_,
            fun h => ⟨h.1, h.2.1, h.2.2.1, tailRecorded h.2.2.2⟩⟩
          change saved.fold ++ _ :: nextTail.fold = saved.fold ++ _ :: tail.fold
          rw [tailSame]

/-- A spent marker retains its name but contributes no new source demand. -/
theorem SourceDemand.spentPrefix (annotation : SourceDemand context input output) (owner : Nat) :
    ∃ next : SourceDemand (.spent (owner := owner) context) input output,
      next.fold = annotation.fold ∧ (annotation.Recorded → next.Recorded) :=
  ⟨.spent annotation, rfl, id⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceDemand.deep_pure_history
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.SourceDemand.spentPrefix

