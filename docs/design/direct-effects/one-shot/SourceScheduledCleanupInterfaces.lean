namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)

/-- A single exact decorated cut suffices for request admission. Any bare
annotation split at the same selection is its unique existing split. -/
theorem local_request_at_cut
    {wholeHints : ReturnHints wholeScope} {captureHints : ReturnHints captureScope} {tailHints : ReturnHints tailScope}
    {whole : Context wholeHints} {captured : Context captureHints} {tail : Context tailHints}
    (cut : Cut effect operation whole captured tail contract modes)
    (guard : SourceDependencyChecks.Lexical.Capture wholeScope effect operation)
    (callbacks : contract.dispose = true →
      Pending outward actions phases world captureHints (.running .close tailHints) .unwind .unwind)
    (ownerBound : contract.dispose = true → SourceDependencyOwners.PendingWithin world
      (SourceDependencyOwners.owners captureScope) captureScope) :
    Local outward actions phases world (.request effect operation) wholeHints := by
  apply Local.request guard
  · intro actualCaptureScope actualTailScope actualCapture actualTail actualContract actualModes same found disposing
    cases Option.some.inj (cut.select_sound.symm.trans found)
    obtain ⟨rfl, rfl⟩ := SourceDependencyNeutral.Lexical.Recursive.append_injective
      (eq_of_heq (cut.hints.symm.trans same))
    exact callbacks disposing
  · intro actualCapture actualTail actualContract actualModes found disposing
    cases Option.some.inj (cut.select_sound.symm.trans found)
    exact ownerBound disposing

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
