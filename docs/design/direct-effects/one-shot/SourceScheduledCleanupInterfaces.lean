          AuthBody operations policy ports
            (owners.insert owner (inputSame.symm ▸ site.resultRows) (answerSame.symm ▸ answerRows))
            emptyRows answerRows source (selectedRows owner) := by
  cases selected with
  | selected terminal chosen =>
    obtain ⟨frontStack, handler, answer, residual, declarationPlans, answerRows, actualRows,
      declarations, stackEq, effectEq, activationEq, answerAnnotation, answerMode, callerScope, certifiedDeclarations, authenticated, actualTerminal, _packed⟩ :=
      split.savedRows.terminal_declarations terminal
    have selectedAt := (CapturedClauseRows.selected terminal chosen).selected_at actualTerminal
    obtain ⟨parameter, binder, code, offered, row, located, found, offeredRow⟩ :=
      authenticated.selected_origin selectedAt
    obtain ⟨argument, input, resumeEffects, closeEffects, nextFamily, plans, known, selectedRows,
      body, resumeInterface, closeInterface, selectedPlan, selectedActual, bodyChecked⟩ :=
      authenticated.selected located found offeredRow
    obtain ⟨requested, actualArgument, actualKnown, payload, effectSame, payloadChecked, resultRowsSame⟩ :=
      site.current.previous.authenticated.request_payload expression closed
    have effectMatches : requested = effect := by
      have realization : Instantiation.EffectRealizes Instantiation.Environment.empty
          (Instantiation.freezeEffect effect) requested := by
