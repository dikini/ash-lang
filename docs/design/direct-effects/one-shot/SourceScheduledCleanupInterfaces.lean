/-- A checked contextual invocation exposes its exact restored continuation
and the check after consuming the selected owner. -/
theorem Accounting.Run.resume_accounting
    {hints : ReturnHints scope} {context : Context hints}
    (run : Accounting.Run world installations (Rows.invoke (key := ⟨owner, .resume⟩)) context (root : Requirements demand))
    (checked : Checked (annotateDisposalStore entries) receiving phases (annotateDisposals root) row) :
    ∃ front captured tail : Packed, ∃ resumeDemand : List Nat,
    ∃ nextDemand, ∃ nextRoot : Requirements nextDemand,
      context.pack = (front.context.append
        (.live (owner := owner) (resumeDemand := resumeDemand) captured.context tail.context)).pack ∧
      OwnerCut owner scope ⟨front.scope, captured.scope, tail.scope⟩ ∧
      demand = owner :: nextDemand ∧
      Accounting.Wait world installations (captured.context.append
        (front.context.append (.spent (owner := owner) tail.context))) .ordinary nextRoot ∧
      Checked (annotateDisposalStore (RecursiveTransport.removeOwner owner entries)) receiving
        (spend phases owner) (annotateDisposals nextRoot) row := by
  cases run with
  | resume located restored =>
    exact ⟨⟨_, _, _⟩, ⟨_, _, _⟩, ⟨_, _, _⟩, _, _, _, rfl, located, rfl,
      restored, retire_prefix_checked checked⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.Accounting.Run.resume_accounting
