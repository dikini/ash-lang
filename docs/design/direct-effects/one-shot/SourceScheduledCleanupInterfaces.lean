/-- A consumed-clause marker restores the actual caller. Its ticket was
already discharged at invocation, so neither lifetime list changes here. -/
theorem JoinedState.leave_clause
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨value, caller, tail⟩, issued, completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨nextScope, nextRequirements, nextHints, nextAnnotated, nextRow, empty, scopeSame,
      nextScopeKnown, nextSource, nextCertified, nextPending, nextAnnotation, rawPath, generatedPath,
      nextChecked, included, nextLocal, nextRetained, nextMatching, nextBound, nextResumes,
      nextDisposals, raw, transition, owners, nextUse, nextTickets, nextResources⟩ :=
      leave_clause_planned_generated current pending closed retained matching bound annotation checked
        unique state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨value, caller, tail⟩, issued, completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨value, runtimeScope, .spent owner answer caller tail⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, (fun key body member => nextResumes key body (state.resumeRecords key body member)),
      (fun key body member => nextDisposals key body (state.unwindRecords key body member)),
      state.storeAnnotation, event.preserves state.lifetime, nextTickets, nextResources,
      state.activations, state.issuedResources⟩
    apply JoinedSource.eval nextSource nextCertified nextScopeKnown nextPending nextLocal nextRetained
      nextMatching nextBound ?_ nextAnnotation nextChecked (included.trans bounded)
    simpa only [scopeSame, SourceContextualRechecking.checkForest] using finite

/-- Lexical closing accepts any closed returned value and restores Unit.
The general case uses the selected machine's closeValue rule; the underlying
RawStep counterpart is available only for an already-Unit return. -/
theorem JoinedState.close_value
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨nextScope, nextRequirements, nextHints, nextAnnotated, nextRow, empty, scopeSame,
      nextScopeKnown, nextSource, nextCertified, nextPending, nextAnnotation, rawPath, generatedPath,
      nextChecked, included, nextLocal, nextRetained, nextMatching, nextBound, nextResumes,
      nextDisposals, rawWhenUnit, transition, owners, nextUse, nextTickets, nextResources⟩ :=
      close_value_planned_generated current pending closed retained matching bound annotation checked
        unique state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨.unit, caller, tail⟩, issued, .close identity :: completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.singleton_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨value, runtimeScope, .push (.closing identity caller) tail⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, (fun key body member => nextResumes key body (state.resumeRecords key body member)),
      (fun key body member => nextDisposals key body (state.unwindRecords key body member)),
      state.storeAnnotation, event.preserves state.lifetime, nextTickets, nextResources,
      state.activations, state.issuedResources⟩
    apply JoinedSource.eval nextSource nextCertified nextScopeKnown nextPending nextLocal nextRetained
      nextMatching nextBound ?_ nextAnnotation nextChecked (included.trans bounded)
    simpa only [scopeSame, SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
      Bool.true_and] using finite

/-- Retirement consumes the physical owner and removes both kinds of stored
record at that same identity. The surviving tail annotation is checked with
the exact available-tail phases. General returned values use retireValue;
RawStep retirement is the Unit subcase. -/
theorem JoinedState.retire_value
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩, actions⟩)
    (closed : ClosedValue value) :
    JoinedState operations policy contracts tables families required outward annotations world ambient history
      (RecursiveTransport.removeOwner owner resumes) (RecursiveTransport.removeOwner owner disposals)
      (RecursiveTransport.removeOwner owner annotatedStore) budget output
      ⟨⟨.eval ⟨value, runtimeScope, tail⟩, issued, .ticket owner :: completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨nextDemand, nextRequirements, nextScope, nextHints, tailAnnotated, nextAnnotated, nextRow,
      empty, demandSame, scopeSame, nextSource, nextCertified, nextPending, tailAnnotation,
      nextAnnotation, oldRawPath, oldGeneratedPath, rawPath, generatedPath, nextChecked, included,
      nextLocal, nextRetained, nextMatching, nextBound, nextResumes, nextDisposals,
      rawWhenUnit, transition, owners, phaseSame, nextUnique, nextUse, nextTickets, nextResources⟩ :=
      retire_value_planned_generated current pending closed retained matching bound annotation checked
        unique state.lifetime.2.2 state.tickets state.resources
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨value, runtimeScope, tail⟩, issued, .ticket owner :: completed⟩, actions⟩ := by
      simpa only [List.append_nil, List.singleton_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨value, runtimeScope, .push (.retiring owner) tail⟩, issued, completed⟩, actions⟩)
          transition (by simpa only [List.append_nil, LexicalUnwind.RunState.erase] using state.lifetime.1.2))
    refine ⟨?_, ?_, ?_, ?_, event.preserves state.lifetime, nextTickets, nextResources,
      state.activations, state.issuedResources⟩
    · apply JoinedSource.eval nextSource nextCertified scopeTyped nextPending nextLocal nextRetained
        nextMatching nextBound ?_ nextAnnotation ?_ (included.trans bounded)
      · simpa only [scopeSame, SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
          Bool.true_and] using finite
      · simpa only [← disposal_store_remove_owner, spendAll, phaseSame] using nextChecked
    · intro key body member
      exact nextResumes key body (state.resumeRecords key body (RecursiveTransport.remove_owner_sublist.subset member))
    · intro key body member
      exact nextDisposals key body (state.unwindRecords key body (RecursiveTransport.remove_owner_sublist.subset member))
    · simpa only [RecursiveConsumption.remove_owner_append] using state.storeAnnotation.remove_owner owner

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
