private theorem certified_frame_registries
    (frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts tables families required outward world
      entry input output demand requirements layer decorate incoming outgoing)
    (tableAgree : ∀ handler, handler.activation ∈ entry.erase.activation → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ entry.erase.activation → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ entry.erase.activation → required handler = nextRequired handler) :
    ∃ nextDecorate, CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts nextTables nextFamilies nextRequired outward world
      entry input output demand requirements layer nextDecorate incoming outgoing := by
  cases frame with
  | plain context scope inputAnnotation outputAnnotation certified => exact ⟨_, .plain context scope inputAnnotation outputAnnotation certified⟩
  | @handler handler residual answer evidence plans scope annotation clauses coverage unique declarations recipes capabilities modes certified =>
      have tableSame := tableAgree handler List.mem_cons_self
      have familySame := familyAgree handler List.mem_cons_self
      have requiredSame := requiredAgree handler List.mem_cons_self
      have move (nextFamily) (same : families handler = nextFamily) :
          ∃ nextPlans : ClausePlans handler.clauses nextFamily,
            SourcePlannedSources.Declarations operations policy contracts world (fun _ => none) outgoing handler.effectInst input
              handler.clauses (nextTables handler) nextPlans ∧
            declarationPolicy.accepts outward (nextRequired handler) nextPlans ∧
            CertifiedClauses (evidence := declarationPolicy) outward world nextPlans := by
        cases same
        exact ⟨plans, by simpa only [tableSame] using declarations,
          by simpa only [requiredSame] using recipes, certified⟩
      obtain ⟨nextPlans, nextDeclarations, nextRecipes, nextCertified⟩ := move _ familySame
      rw [tableSame, familySame]
      exact ⟨_, CertifiedFrame.handler (evidence := declarationPolicy.accepts outward) (outward := outward) (plans := nextPlans)
          (tables := nextTables) (families := nextFamilies) (required := nextRequired)
          scope annotation clauses coverage unique nextDeclarations nextRecipes capabilities
          (by simpa only [tableSame] using modes) nextCertified⟩
  | cell scope noEscape annotation interface => exact ⟨_, .cell scope noEscape annotation interface⟩
  | armed scope callback annotation interface certified => exact ⟨_, .armed scope callback annotation interface certified⟩
  | running scope callback saved annotation interface => exact ⟨_, .running scope callback saved annotation interface⟩
  | closing scope interface => exact ⟨_, .closing scope interface⟩
  | retiring known interface => exact ⟨_, .retiring known interface⟩

private theorem planned_frame_registries
    (frame : PlannedModeFrame operations policy contracts tables families required outward world entry input output demand requirements layer)
    (tableAgree : ∀ handler, handler.activation ∈ entry.erase.activation → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ entry.erase.activation → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ entry.erase.activation → required handler = nextRequired handler) :
    PlannedModeFrame operations policy contracts nextTables nextFamilies nextRequired outward world entry input output demand requirements layer := by
  cases frame with
  | ordinary frame =>
      obtain ⟨_, changed⟩ := certified_frame_registries frame tableAgree familyAgree requiredAgree
      exact .ordinary changed
  | unwinding callback certified => exact .unwinding callback certified
  | closing scope => exact .closing scope
  | retiring => exact .retiring
  | skipped => exact .skipped
  | @handler data answer decorate residual frame =>
      have tableSame := tableAgree data List.mem_cons_self
      have familySame := familyAgree data List.mem_cons_self
      have changed := certified_frame_registries frame tableAgree familyAgree requiredAgree
      rw [tableSame, familySame] at changed ⊢
      obtain ⟨_, moved⟩ := changed
      exact .handler moved
  | cell => exact .cell
  | cleanup callback certified => exact .cleanup callback certified

/-- Fresh registration changes only absent installation identities. The rich
source and every dormant source retain their exact requirements and signatures. -/
theorem PlannedModeSource.registries
    (segment : PlannedModeSource operations policy contracts tables families required outward actions world
      stack input output demand requirements dependencyScope)
    (tableAgree : ∀ handler, handler.activation ∈ stack.erase.activations → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ stack.erase.activations → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ stack.erase.activations → required handler = nextRequired handler) :
    PlannedModeSource operations policy contracts nextTables nextFamilies nextRequired outward actions world
      stack input output demand requirements dependencyScope := by
  induction segment with
  | nil => exact .nil
  | push head tail ih =>
      have next := fun handler member => tableAgree handler (List.mem_append_right _ member)
      have same := RecursiveHandlerTables.context_congr next
      have changed := planned_frame_registries head
        (fun handler member => tableAgree handler (List.mem_append_left _ member))
        (fun handler member => familyAgree handler (List.mem_append_left _ member))
        (fun handler member => requiredAgree handler (List.mem_append_left _ member))
      simpa only [same] using PlannedModeSource.push changed
        (ih next (fun handler member => familyAgree handler (List.mem_append_right _ member))
          (fun handler member => requiredAgree handler (List.mem_append_right _ member)))
  | live known actionKnown inputAnnotation answerAnnotation scope held saved answer tail ihSaved ihTail =>
      exact .live known actionKnown inputAnnotation answerAnnotation scope held
        (ihSaved (fun handler member => tableAgree handler (List.mem_append_left _ member))
          (fun handler member => familyAgree handler (List.mem_append_left _ member))
          (fun handler member => requiredAgree handler (List.mem_append_left _ member))) answer
        (ihTail (fun handler member => tableAgree handler (List.mem_append_right _ member))
          (fun handler member => familyAgree handler (List.mem_append_right _ member))
          (fun handler member => requiredAgree handler (List.mem_append_right _ member)))
  | @opening captured savedDemand savedRequirements savedScope rest output tailDemand tailRequirements restScope owner input answer caller saved tail ihSaved ihTail =>
      have next := fun handler member => tableAgree handler (List.mem_append_right _ member)
      have same := RecursiveHandlerTables.context_congr (stack := .push (.retiring owner) rest) next
      simpa only [same] using PlannedModeSource.opening
        (ihSaved (fun handler member => tableAgree handler (List.mem_append_left _ member))
          (fun handler member => familyAgree handler (List.mem_append_left _ member))
          (fun handler member => requiredAgree handler (List.mem_append_left _ member)))
        (ihTail next (fun handler member => familyAgree handler (List.mem_append_right _ member))
          (fun handler member => requiredAgree handler (List.mem_append_right _ member)))
  | spent known annotation scope tail ih => exact .spent known annotation scope (ih tableAgree familyAgree requiredAgree)
  | skippedSpent tail ih => exact .skippedSpent (ih tableAgree familyAgree requiredAgree)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedModeSource.registries

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyCapture (Realizes)
open SourceContextualRechecking (checkForest checkFrame handlers)

private theorem handler_matches_registries
    (source : ReturnHints.Matches tables families hints stack)
    (tableAgree : ∀ handler, handler.activation ∈ stack.erase.activations → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ stack.erase.activations → families handler = nextFamilies handler) :
    ReturnHints.Matches nextTables nextFamilies hints stack := by
  induction source with
  | nil => exact .nil
  | plain tail ih => exact .plain (ih
      (fun handler member => tableAgree handler (List.mem_append_right _ member))
      (fun handler member => familyAgree handler (List.mem_append_right _ member)))
  | @handler rest restScope hints data tail ih =>
      have tableSame := tableAgree data List.mem_cons_self
      have familySame := familyAgree data List.mem_cons_self
      have next := ih (fun handler member => tableAgree handler (List.mem_append_right _ member))
        (fun handler member => familyAgree handler (List.mem_append_right _ member))
      have build (table family) (sameTable : table = nextTables data) (sameFamily : family = nextFamilies data) :
          ReturnHints.Matches nextTables nextFamilies
            (.handler (effect := data.effectInst) (table := table) (families := family) hints)
            (.push (.handler data) rest) := by
        cases sameTable
        cases sameFamily
        exact .handler next
      exact build _ _ tableSame familySame
  | cell tail ih => exact .cell (ih tableAgree familyAgree)
  | cleanup tail ih => exact .cleanup (ih tableAgree familyAgree)
  | running frame tail ih =>
      exact .running frame (ih
        (fun handler member => tableAgree handler (List.mem_append_right _ member))
        (fun handler member => familyAgree handler (List.mem_append_right _ member)))
  | live saved tail ihSaved ihTail =>
      exact .live
        (ihSaved (fun handler member => tableAgree handler (List.mem_append_left _ member))
          (fun handler member => familyAgree handler (List.mem_append_left _ member)))
        (ihTail (fun handler member => tableAgree handler (List.mem_append_right _ member))
          (fun handler member => familyAgree handler (List.mem_append_right _ member)))
  | spent tail ih => exact .spent (ih tableAgree familyAgree)

private theorem handler_forest_registries
    (source : Realizes tables families scope stack)
    (agree : ∀ handler, handler.activation ∈ stack.erase.activations → required handler = nextRequired handler) :
    checkForest required stack scope outside = checkForest nextRequired stack scope outside := by
  induction source generalizing outside with
  | nil => rfl
  | push frame tail ih =>
      simp only [SourceContextualRechecking.check_forest_push frame]
      have tailSame := ih (fun handler member => agree handler (List.mem_append_right _ member)) (outside := outside)
      rw [tailSame]
      congr 1
      cases frame <;> try rfl
      simp only [checkFrame, agree _ (List.mem_append_left _ List.mem_cons_self)]
  | live saved tail ihSaved ihTail =>
      simp only [checkForest,
        ihSaved (fun handler member => agree handler (List.mem_append_left _ member)),
        ihTail (fun handler member => agree handler (List.mem_append_right _ member))]
  | spent tail ih => exact ih agree

private theorem captured_activations_subset (located : SourceTemplates.CapturedIn owner capture root) :
    capture.erase.activations ⊆ root.erase.activations := by
  induction located with
  | here => exact List.subset_append_left _ _
  | push located ih => exact ih.trans (List.subset_append_right _ _)
  | saved located ih => exact ih.trans (List.subset_append_left _ _)
  | tail located ih => exact ih.trans (List.subset_append_right _ _)
  | spent located ih => exact ih

/-- Saved rich records follow registry agreement at their own physical
captures, including dormant nested installations. -/
theorem PlannedResumeAnnotated.registries
    (record : PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world root key body)
    (tableAgree : ∀ handler, handler.activation ∈ root.erase.activations → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ root.erase.activations → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ root.erase.activations → required handler = nextRequired handler) :
    PlannedResumeAnnotated operations policy contracts nextTables nextFamilies nextRequired outward actions annotations world root key body := by
  cases record with | resume located known recorded source answer =>
    exact .resume located known recorded (source.registries
      (fun handler member => tableAgree handler (captured_activations_subset located member))
      (fun handler member => familyAgree handler (captured_activations_subset located member))
      (fun handler member => requiredAgree handler (captured_activations_subset located member))) answer

theorem PlannedUnwindAnnotated.registries
    (record : PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world root key body)
    (tableAgree : ∀ handler, handler.activation ∈ root.erase.activations → tables handler = nextTables handler)
    (familyAgree : ∀ handler, handler.activation ∈ root.erase.activations → families handler = nextFamilies handler)
    (requiredAgree : ∀ handler, handler.activation ∈ root.erase.activations → required handler = nextRequired handler) :
    PlannedUnwindAnnotated operations policy contracts nextTables nextFamilies nextRequired outward actions annotations world root key body := by
  cases record with | dispose located held recorded source =>
    cases source with | paired planned erased same =>
      have tableLocal := fun handler member => tableAgree handler (captured_activations_subset located member)
      have familyLocal := fun handler member => familyAgree handler (captured_activations_subset located member)
      exact .dispose located held recorded (.paired
        (planned.registries tableLocal familyLocal
          (fun handler member => requiredAgree handler (captured_activations_subset located member)))
        (SourceDependencyNeutral.Lexical.unwind_source_registries erased tableLocal familyLocal) same)
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedResumeAnnotated.registries
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.PlannedUnwindAnnotated.registries

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (spendAll)

/-- Instantiate a handler's source checking label with its actual activation,
retaining the original generated certificate and its existing budget. -/
theorem handler_root_annotation
    {currentRequirements bodyRequirements : Requirements demand}
    {pendingRequirements : Requirements pendingDemand}
    (handler : HandlerData)
    (tableInstalled : nextTables handler = table)
    (effectSame : handler.effectInst = effect)
    (sameContext : OwnerPhases.ofStack tables stack = OwnerPhases.ofStack nextTables stack)
    (reqSame : currentRequirements = bodyRequirements.prepend [.ordinary (.handler effect 0 table)])
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row) :
    let nextReq := Requirements.sequence
      ((Requirements.request [] []).prepend (OwnerPhases.ofStack nextTables stack)) pendingRequirements
    let nextRoot := Requirements.sequence
      (bodyRequirements.prepend (OwnerPhases.ofStack nextTables (.push (.handler handler) stack))) nextReq
    ∃ nextAnnotated : Requirements (demand ++ pendingDemand), ∃ nextRow,
      RowAnnotation nextRoot nextAnnotated ∧ RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row := by
  obtain ⟨normalRow, normalCheck, normalBound⟩ := (disposal_annotation_map annotation).checked rowChecked
  rw [reqSame] at normalCheck
  simp only [annotateDisposals, disposal_prepend] at normalCheck
  obtain ⟨bodyRow, tailRow, originalBody, tailCheck, rowSame⟩ := RecursiveRequirements.checked_sequence_parts normalCheck
  have bodyCheck := RecursiveRequirements.checked_prepend_iff.mp (RecursiveRequirements.checked_prepend_iff.mp originalBody)
  simp only [List.cons_append, List.nil_append] at bodyCheck
  have relocated := RecursiveHandlerTables.checked_activation bodyCheck
    (front := []) (tail := OwnerPhases.ofStack tables stack ++ receiving) (second := handler.activation) rfl
  have nextBody : Checked entries
      (OwnerPhases.ofStack nextTables (.push (.handler handler) stack) ++ receiving) before
      (annotateDisposals bodyRequirements) bodyRow := by
    simpa only [List.nil_append, OwnerPhases.ofStack, OwnerPhases.frameEntry,
      tableInstalled, effectSame, sameContext, List.cons_append] using relocated
  let nextReq := Requirements.sequence
    ((Requirements.request [] []).prepend (OwnerPhases.ofStack nextTables stack)) pendingRequirements
  let nextRoot := Requirements.sequence
    (bodyRequirements.prepend (OwnerPhases.ofStack nextTables (.push (.handler handler) stack))) nextReq
  have nextTail : Checked entries receiving (spendAll before demand) (annotateDisposals nextReq) tailRow := by
    simp only [nextReq, annotateDisposals, disposal_prepend]
    exact .sequence (firstRow := []) (secondRow := tailRow)
      (.request (by simp [OwnerSource.exportAt, residual_empty])) tailCheck
  have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) (bodyRow ++ tailRow) := by
    simp only [nextRoot, annotateDisposals, disposal_prepend]
    exact .sequence (RecursiveRequirements.checked_prepend_iff.mpr nextBody) nextTail
  exact ⟨.choice nextRoot annotated (.refl _), (bodyRow ++ tailRow) ++ row,
    .alternatives .original (.refl _), .no .here, .no .here,
    .choice nextCheck rowChecked, List.append_subset.mpr ⟨rowSame ▸ normalBound, List.Subset.refl _⟩⟩

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.handler_root_annotation


namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Value)
open SourceDeclarationPlans (Plan ClausePlans)
open SourcePlanSignatures (Signature signature clauseSignatures)
open SourcePlannedChecks (Certified CertifiedClauses)
open SourceDependencyAnnotations (Dependencies RowAnnotation RequirementPath)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open RecursiveRequirements (Requirements Checked evaluate)
open OwnerPhaseTransitions (spendAll)

private theorem handler_source_details {declarationsSignature : SourcePlanSignatures.ClauseSignatures clauseDependencies}
    (source : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.handle (Instantiation.freezeEffect effect) code arms) input demand requirements
      (.handler (effect := effect) (table := table) needed declarationsSignature bodySignature)) :
    ∃ residual, ∃ bodyRequirements : Requirements demand, ∃ actual : ClausePlans arms clauseDependencies,
      SourcePlannedSources.Expression operations policy contracts world (effect :: residual) runtimeScope (fun _ => none)
        code input demand bodyRequirements bodySignature ∧
      ScopedPorts.ClausesTyped operations.erase.erase.ports world SourceDependencyAnnotations.Environment.empty.erase.ports
        effect input.erase.erase.port residual arms ∧
      ClausesUse policy arms ∧ ScopedPorts.Covers operations.erase.erase.ports effect arms ∧
      (ScopedTyping.clauseKeys arms).Nodup ∧ SourceTemplates.ClauseModes arms table ∧
      SourcePlannedSources.Declarations operations policy contracts world (fun _ => none) residual effect input arms table actual ∧
      clauseSignatures actual = declarationsSignature ∧ requirements = bodyRequirements.prepend [.ordinary (.handler effect 0 table)] := by
  generalize frozen : Instantiation.freezeEffect effect = syntaxEffect at source
  cases source with
  | handler body clauses capabilities coverage unique admitted table modes declarations =>
      exact ⟨_, _, _, body, clauses, capabilities, coverage, unique, modes, declarations, rfl, rfl⟩

/-- Allocate a fresh lexical installation, authenticate its actual clauses, and
register the source metadata without changing any existing installation. Both
ordinary and dormant rich records follow the same registry extension. -/
theorem enter_handler_planned_generated
    {plans : ClausePlans priorArms clauseDependencies} {bodyPlan : Plan bodyDependencies}
    {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      (.handle (Instantiation.freezeEffect effect) code arms) input currentDemand currentRequirements
      (signature (.handler (effect := effect) (table := table) needed plans bodyPlan)))
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      stack (.value input) output pendingDemand pendingRequirements dependencyScope)
    (scopeTyped : ScopedPorts.EffectScope contracts.erase.erase.ports runtimeScope ticket)
    (certified : Certified (evidence := declarationPolicy) outward world
      (.handler (effect := effect) (table := table) needed plans bodyPlan))
    (checked : Local outward actions phases world (.handler effect table clauseDependencies bodyDependencies) hints)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints stack)
    (annotationBound : Bound annotations dependencyScope)
    (supplied : SourceContextualHints.checkRequirements dependencyScope needed = true)
    (finite : SourceContextualRechecking.checkForest required stack dependencyScope .nil = true)
    (installed : stack.erase.activations ⊆ history)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables stack)) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩)) :
    ∃ handler : HandlerData, ∃ nextTables nextFamilies nextRequired residual,
    ∃ bodyRequirements : Requirements currentDemand, ∃ nextRequirements : Requirements pendingDemand,
    ∃ nextAnnotated : Requirements (currentDemand ++ pendingDemand), ∃ nextRow,
      handler.activation ∉ history ∧ handler.scope = runtimeScope ∧ handler.effectInst = effect ∧ handler.clauses = arms ∧
      nextTables handler = table ∧ nextFamilies handler = clauseDependencies ∧ nextRequired handler = needed ∧
      (∀ old, old.activation ∈ stack.erase.activations →
        tables old = nextTables old ∧ families old = nextFamilies old ∧ required old = nextRequired old) ∧
      SourcePlannedSources.Expression operations policy contracts world (effect :: residual) runtimeScope (fun _ => none)
        code input currentDemand bodyRequirements (signature bodyPlan) ∧
      Certified (evidence := declarationPolicy) outward world bodyPlan ∧
      PlannedModeSource operations policy contracts nextTables nextFamilies nextRequired outward actions world
        (.push (.handler handler) stack) (.value input) output pendingDemand nextRequirements
        (.handler effect table clauseDependencies dependencyScope) ∧
      RowAnnotation
        (.sequence (bodyRequirements.prepend (OwnerPhases.ofStack nextTables (.push (.handler handler) stack))) nextRequirements)
        nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world bodyDependencies
        (.handler (effect := effect) (table := table) (families := clauseDependencies) hints) ∧
      Pending outward actions phases world
        (.handler (effect := effect) (table := table) (families := clauseDependencies) hints) .nil .ordinary output.mode ∧
      ReturnHints.Matches nextTables nextFamilies
        (.handler (effect := effect) (table := table) (families := clauseDependencies) hints) (.push (.handler handler) stack) ∧
      Bound annotations (.handler effect table clauseDependencies dependencyScope) ∧
      SourceContextualRechecking.checkForest nextRequired (.push (.handler handler) stack)
        (.handler effect table clauseDependencies dependencyScope) .nil = true ∧
      (∀ installed ∈ SourceContextualRechecking.handlers (.push (.handler handler) stack),
        ClauseDeclarations outward installed.clauses (nextFamilies installed) (nextRequired installed)) ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world stack key body →
        PlannedResumeAnnotated operations policy contracts nextTables nextFamilies nextRequired outward actions annotations world
          (.push (.handler handler) stack) key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world stack key body →
        PlannedUnwindAnnotated operations policy contracts nextTables nextFamilies nextRequired outward actions annotations world
          (.push (.handler handler) stack) key body) ∧
      RawStep ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩
        ⟨code, runtimeScope, .push (.handler handler) stack⟩ [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩)
        (.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩) [] [] ∧
      ownedTickets (.push (.handler handler) stack) = ownedTickets stack ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨code, runtimeScope, .push (.handler handler) stack⟩) := by
  obtain ⟨residual, bodyReq, actual, body, typedClauses, capabilities, coverage, unique, modes, declarations, samePlans, reqSame⟩ :=
    handler_source_details current
  cases certified with | handler recipes clausesCertified bodyCertified =>
    have actualRecipes := ClauseDeclarations.signature_congr recipes samePlans.symm
    have actualCertified := certified_clause_signatures clausesCertified samePlans.symm
    obtain ⟨activation, fresh⟩ := ScopedTyping.fresh_world_name history
    let handler : HandlerData := ⟨activation, effect, arms, runtimeScope,
      ScopedPorts.embedPort input.erase.erase.port, ScopedPorts.clauses_have_ticket_barrier typedClauses⟩
    let nextTables := RecursiveHandlerTables.register tables activation table
    let nextFamilies : SourceDependencyCapture.Families := fun old => if old.activation = activation then clauseDependencies else families old
    let nextRequired : SourceContextualRechecking.Required := fun old => if old.activation = activation then needed else required old
    have tablesAgree : ∀ old, old.activation ∈ stack.erase.activations → tables old = nextTables old :=
      RecursiveHandlerTables.register_agrees (fun member => fresh (installed member))
    have familiesAgree : ∀ old, old.activation ∈ stack.erase.activations → families old = nextFamilies old := by
      intro old member
      have different : old.activation ≠ activation := fun same => fresh (same ▸ installed member)
      simp [nextFamilies, different]
    have requiredAgree : ∀ old, old.activation ∈ stack.erase.activations → required old = nextRequired old := by
      intro old member
      have different : old.activation ≠ activation := fun same => fresh (same ▸ installed member)
      simp [nextRequired, different]
    have tableInstalled : nextTables handler = table := RecursiveHandlerTables.registered_lookup rfl
    have familiesInstalled : nextFamilies handler = clauseDependencies := by simp [nextFamilies, handler]
    have requiredInstalled : nextRequired handler = needed := by simp [nextRequired, handler]
    have moved := pending.registries tablesAgree familiesAgree requiredAgree
    have movedMatch := handler_matches_registries matching tablesAgree familiesAgree
    have movedFinite : SourceContextualRechecking.checkForest nextRequired stack dependencyScope .nil = true :=
      (handler_forest_registries pending.realizes requiredAgree).symm.trans finite
    have frame : CertifiedFrame (evidence := declarationPolicy.accepts outward) operations policy contracts nextTables nextFamilies nextRequired
        outward world (.handler handler) input input [] (.request [] [])
        (.handler handler.effectInst (nextTables handler) (nextFamilies handler))
        (fun rest => .handler (nextRequired handler) rest) (handler.effectInst :: residual) residual := by
      have move (family) (same : clauseDependencies = family) :
          ∃ movedPlans : ClausePlans handler.clauses family,
            SourcePlannedSources.Declarations operations policy contracts world (fun _ => none) residual handler.effectInst input
              handler.clauses (nextTables handler) movedPlans ∧
            ClauseDeclarations outward handler.clauses family (nextRequired handler) ∧
            CertifiedClauses (evidence := declarationPolicy) outward world movedPlans := by
        cases same
        exact ⟨actual, by simpa only [tableInstalled] using declarations,
          by simpa only [requiredInstalled] using actualRecipes, actualCertified⟩
      obtain ⟨movedPlans, movedDeclarations, movedRecipes, movedCertified⟩ := move _ familiesInstalled.symm
      exact CertifiedFrame.handler (evidence := declarationPolicy.accepts outward) (outward := outward)
        (tables := nextTables) (families := nextFamilies) (required := nextRequired) (plans := movedPlans)
        ⟨_, scopeTyped⟩ (by simp [handler]) typedClauses coverage unique movedDeclarations movedRecipes
        capabilities (by simpa only [tableInstalled] using modes) movedCertified
    have nextPlanned := PlannedModeSource.push (PlannedModeFrame.ordinary frame) moved
    have declaration : ClauseDeclarations outward handler.clauses (nextFamilies handler) (nextRequired handler) := by
      simpa only [familiesInstalled, requiredInstalled] using actualRecipes
    obtain ⟨nextMatch, nextPending, nextDeclared, nextFinite⟩ := declaration.install
      (by simpa only [requiredInstalled] using supplied) movedMatch retained moved.installed_declarations movedFinite
    have sameContext := RecursiveHandlerTables.context_congr tablesAgree
    let nextReq : Requirements pendingDemand := .sequence
      ((Requirements.request [] []).prepend (OwnerPhases.ofStack nextTables stack)) pendingRequirements
    obtain ⟨nextAnnotated, nextRow, nextAnnotation, rawPath, generatedPath, nextCheck, nextWithin⟩ :=
      handler_root_annotation handler tableInstalled rfl sameContext reqSame annotation rowChecked
    have step : RawStep ⟨.handle (Instantiation.freezeEffect effect) code arms, runtimeScope, stack⟩
        ⟨code, runtimeScope, .push (.handler handler) stack⟩ [] [] := .enterHandler handler code stack
    have nextUse := LexicalUnwind.raw_computation_machine_use step trivial (by intro owner member; cases member) usage
    have nextTickets := LexicalUnwind.raw_computation_machine_ticket_access step trivial
      (by intro owner member; cases member) usage ticketAccess
    cases checked with | handler bodyChecked =>
      refine ⟨handler, nextTables, nextFamilies, nextRequired, residual, bodyReq, nextReq,
        nextAnnotated, nextRow,
        fresh, rfl, rfl, rfl, tableInstalled, familiesInstalled, requiredInstalled,
        (fun old member => ⟨tablesAgree old member, familiesAgree old member, requiredAgree old member⟩),
        body, bodyCertified, by simpa only [tableInstalled, familiesInstalled, List.nil_append] using nextPlanned, nextAnnotation, rawPath, generatedPath,
        nextCheck, nextWithin,
        bodyChecked, .handler retained,
        ?_,
        .handler annotationBound, by simpa only [handler, tableInstalled, familiesInstalled] using nextFinite,
        nextDeclared, ?_, ?_, step, .evaluate step trivial, rfl,
        by simpa only [advanceUsageTickets] using nextUse,
        by simpa only [advanceUsageTickets] using nextTickets, ?_⟩
      · have build (table family) (sameTable : table = nextTables handler) (sameFamily : family = nextFamilies handler) :
            ReturnHints.Matches nextTables nextFamilies
              (.handler (effect := handler.effectInst) (table := table) (families := family) hints)
              (.push (.handler handler) stack) := by
          cases sameTable
          cases sameFamily
          exact .handler movedMatch
        exact build _ _ tableInstalled.symm familiesInstalled.symm
      · intro key saved record
        have movedRecord := record.registries tablesAgree familiesAgree requiredAgree
        cases movedRecord with | resume located known recorded source answer =>
          exact .resume (.push located) known recorded source answer
      · intro key saved record
        have movedRecord := record.registries tablesAgree familiesAgree requiredAgree
        cases movedRecord with | dispose located held recorded source =>
          exact .dispose (.push located) held recorded source
      · cases resourceAccess with | eval supported =>
          exact .eval (raw_step_preserves_access step supported
            (ScopedPortJoint.ordinary_access_checks (by simp [Code.IsValue])
              (by intros; simp) (by intros; simp)))

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.enter_handler_planned_generated

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
open ScopedExpressions ScopedExecution ProtectionContracts ProtectionResiduals
open SourcePlannedTyping (Value)
open SourcePlanSignatures (Signature)
open SourcePlannedChecks (Certified)
open SourceDependencyAnnotations (RowAnnotation RequirementPath)
open SourceDependencySchemes.Closing (Bound)
open SourceDependencyChecks.Lexical (ReturnHints)
open SourceDependencyChecks.Lexical.ReturnHints.Recursive (Local Pending)
open RecursiveRequirements (Requirements Checked)
open OwnerPhaseTransitions (spendAll)

/-- Leaving an installed handler restores its actual lexical scope. Rich
returned values and the complete previous generated certificate are retained;
removing this frame cannot move a saved capture to another installation. -/
theorem leave_handler_planned_generated
    {checking : Signature dependencies} {hints : ReturnHints dependencyScope}
    (current : SourcePlannedSources.Expression operations policy contracts world allowed runtimeScope (fun _ => none)
      value input currentDemand currentRequirements checking)
    (pending : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.handler handler) tail) (.value input) output pendingDemand pendingRequirements dependencyScope)
    (closed : ClosedValue value)
    (retained : Pending outward actions phases world hints .nil .ordinary output.mode)
    (matching : ReturnHints.Matches tables families hints (.push (.handler handler) tail))
    (annotationBound : Bound annotations dependencyScope)
    (finite : SourceContextualRechecking.checkForest required (.push (.handler handler) tail) dependencyScope .nil = true)
    (annotation : RowAnnotation
      (.sequence (currentRequirements.prepend (OwnerPhases.ofStack tables (.push (.handler handler) tail))) pendingRequirements) annotated)
    (rowChecked : Checked entries receiving before (annotateDisposals annotated) row)
    (usage : LexicalUnwind.MachineUse policy actions (.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩))
    (ticketAccess : LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩))
    (resourceAccess : LexicalUnwind.MachineAccess ambient (.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩)) :
    ∃ boundary restScope, ∃ nextHints : ReturnHints restScope,
    ∃ nextRequirements : Requirements pendingDemand,
    ∃ nextAnnotated : Requirements pendingDemand, ∃ nextRow,
      currentDemand = [] ∧ ScopedPorts.EffectScopeKnown contracts.erase.erase.ports handler.scope ∧
      SourcePlannedSources.Expression operations policy contracts world boundary handler.scope (fun _ => none)
        value input [] (.request [] []) .pure ∧
      Certified (evidence := declarationPolicy) outward world SourceDeclarationPlans.Plan.pure ∧
      PlannedModeSource operations policy contracts tables families required outward actions world
        tail (.value input) output pendingDemand nextRequirements restScope ∧
      RowAnnotation
        (.sequence ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) nextRequirements) nextAnnotated ∧
      RequirementPath annotated nextAnnotated [] ∧
      RequirementPath (annotateDisposals annotated) (annotateDisposals nextAnnotated) [] ∧
      Checked entries receiving before (annotateDisposals nextAnnotated) nextRow ∧ nextRow ⊆ row ∧
      Local outward actions phases world .pure nextHints ∧
      Pending outward actions phases world nextHints .nil .ordinary output.mode ∧
      ReturnHints.Matches tables families nextHints tail ∧ Bound annotations restScope ∧
      SourceContextualRechecking.checkForest required tail restScope .nil = true ∧
      (∀ installed ∈ SourceContextualRechecking.handlers tail,
        ClauseDeclarations outward installed.clauses (families installed) (required installed)) ∧
      (∀ key body, PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world
          (.push (.handler handler) tail) key body →
        PlannedResumeAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      (∀ key body, PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world
          (.push (.handler handler) tail) key body →
        PlannedUnwindAnnotated operations policy contracts tables families required outward actions annotations world tail key body) ∧
      RawStep ⟨value, runtimeScope, .push (.handler handler) tail⟩ ⟨value, handler.scope, tail⟩ [] [] ∧
      LexicalUnwind.UseTransition (.eval ⟨value, runtimeScope, .push (.handler handler) tail⟩)
        (.eval ⟨value, handler.scope, tail⟩) [] [] ∧
      ownedTickets tail = ownedTickets (.push (.handler handler) tail) ∧
      LexicalUnwind.MachineUse policy actions (.eval ⟨value, handler.scope, tail⟩) ∧
      LexicalUnwind.MachineTicketAccess policy actions (.eval ⟨value, handler.scope, tail⟩) ∧
      LexicalUnwind.MachineAccess ambient (.eval ⟨value, handler.scope, tail⟩) := by
  have empty := SourceTemplates.expression_value_demand
    (DeclaredSources.expression_erase (SourceDependencyAnnotations.expression_erase
      (SourcePlannedSources.expression_erase current))) closed.1
  subst currentDemand
  obtain ⟨normalRow, normalCheck, within⟩ := (disposal_annotation_map annotation).checked rowChecked
  cases pending with
  | @push entry prior middle firstDemand first layer restStack result tailDemand tailReq restScope frame rest =>
    cases frame with | ordinary frame => cases frame with
    | handler scope annotationValue clauses coverage unique declarations recipes capabilities modes certified =>
      cases matching with | handler tailMatch =>
        cases retained with | handler tailPending =>
          cases annotationBound with | handler tailBound =>
            simp only [annotateDisposals, disposal_prepend] at normalCheck
            obtain ⟨currentRow, restRow, currentCheck, restCheck, rowSame⟩ :=
              RecursiveRequirements.checked_sequence_parts normalCheck
            obtain ⟨frameRow, tailRow, frameCheck, tailCheck, restSame⟩ :=
              RecursiveRequirements.checked_sequence_parts restCheck
            let nextRoot := Requirements.sequence
              ((Requirements.request [] []).prepend (OwnerPhases.ofStack tables tail)) tailReq
            have nextCheck : Checked entries receiving before (annotateDisposals nextRoot) tailRow := by
              simp only [nextRoot, annotateDisposals, disposal_prepend]
              exact .sequence (firstRow := []) (secondRow := tailRow)
                (.request (by simp [OwnerSource.exportAt, residual_empty])) tailCheck
            have nextWithin : tailRow ⊆ row := by
              apply List.Subset.trans (List.subset_append_right frameRow tailRow)
              apply List.Subset.trans (by simpa only [restSame] using (List.subset_append_right currentRow restRow))
              simpa only [rowSame, restSame] using within
            have step : RawStep ⟨value, runtimeScope, .push (.handler handler) tail⟩
                ⟨value, handler.scope, tail⟩ [] [] := .leaveHandler handler value closed runtimeScope tail
            have nextUse := LexicalUnwind.raw_value_machine_use step closed usage
            have nextTickets := LexicalUnwind.raw_value_machine_ticket_access step closed usage ticketAccess
            refine ⟨_, _, _, _, .choice nextRoot annotated (.refl _), tailRow ++ row,
              rfl, scope, SourcePlannedSources.Values.change_context
                (SourcePlannedSources.Values.summary current closed.1) closed.1 [] handler.scope,
              Certified.pure (evidence := declarationPolicy), rest, .alternatives .original (.refl _),
              .no .here, .no .here, .choice nextCheck rowChecked,
              List.append_subset.mpr ⟨nextWithin, List.Subset.refl _⟩,
              .pure, tailPending, tailMatch, tailBound, ?_, rest.installed_declarations, ?_, ?_, step,
              .evaluate step (LexicalUnwind.value_computation_head closed.1), rfl,
              nextUse, nextTickets, ?_⟩
            · have both := finite
              simp only [SourceContextualRechecking.checkForest, Bool.and_eq_true] at both
              exact both.2
            · intro key body record
              cases record with | resume located known recorded source answer =>
                cases located with | push inside => exact .resume inside known recorded source answer
            · intro key body record
              cases record with | dispose located held recorded source =>
                cases located with | push inside => exact .dispose inside held recorded source
            · cases resourceAccess with | eval supported =>
                apply LexicalUnwind.MachineAccess.eval
                apply raw_step_preserves_access step supported
                constructor
                · intro identity payload answer savedScope currentScope returned restStack same returnedClosed
                  cases same
                · intro requested operation operand currentScope whole captured restStack selectedHandler same cut operandClosed
                  have sameValue := congrArg Configuration.expression same
                  change value = _ at sameValue
                  have impossible := closed.1
                  rw [sameValue] at impossible
                  exact False.elim impossible
                · intro binder owner currentScope caller inputType answerType front captured restStack plan same resolved built
                  have sameValue := congrArg Configuration.expression same
                  change value = _ at sameValue
                  have impossible := closed.1
                  rw [sameValue] at impossible
                  exact False.elim impossible
end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive
