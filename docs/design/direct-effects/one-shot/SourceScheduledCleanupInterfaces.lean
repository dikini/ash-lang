namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open ScopedExpressions ScopedExecution ProtectionContracts
open SourceDependencyChecks.Lexical (ReturnHints)
open OwnerPhaseTransitions (Phases spend spendAll liveNames)
open LexicalUnwind (UseMode)

/-- The caller is cleaned only when the saved continuation returns in unwind
mode. Its finite check uses the exact resume demand and the spent receiver. -/
def ResumeBudget (budget : Footprint) (before : Phases) (owner : Nat)
    (demand : List Nat) (savedMode : UseMode)
    {frontHints : ReturnHints frontScope} {tailHints : ReturnHints tailScope}
    (front : Context frontHints) (tail : Context tailHints) : Bool :=
  match savedMode with
  | .ordinary => true
  | .unwind => match front.closing? with
    | none => false
    | some metadata => metadata.check (Context.spent (owner := owner) tail).context
        (spendAll (spend before owner) demand) budget

theorem ResumeBudget.ordinary :
    ResumeBudget budget before owner demand .ordinary front tail = true := rfl

theorem ResumeBudget.unwind_iff :
    ResumeBudget budget before owner demand .unwind front tail = true ↔
      ∃ metadata, front.closing? = some metadata ∧
        metadata.check (Context.spent (owner := owner) tail).context
          (spendAll (spend before owner) demand) budget = true := by
  cases found : front.closing? <;> simp [ResumeBudget, found]

theorem ResumeBudget.demand_permutation (same : first.Perm second) :
    ResumeBudget budget before owner first mode front tail =
      ResumeBudget budget before owner second mode front tail := by
  cases mode <;> simp only [ResumeBudget, PhaseRechecking.spendAll_permutation same]

theorem ResumeBudget.mono
    (checked : ResumeBudget small before owner demand mode front tail = true)
    (larger : small ⊆ large) :
    ResumeBudget large before owner demand mode front tail = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
      obtain ⟨metadata, found, checked⟩ := unwind_iff.mp checked
      obtain ⟨row, evaluated, bounded⟩ := metadata.check_iff.mp checked
      exact unwind_iff.mpr ⟨metadata, found,
        metadata.check_iff.mpr ⟨row, evaluated, bounded.trans larger⟩⟩

private theorem resume_budget_spendAll_spend (before : Phases) (owner : Nat) (owners : List Nat) :
    spendAll (spend before owner) owners = spend (spendAll before owners) owner := by
  funext other
  by_cases same : other = owner <;> simp [OwnerPhaseTransitions.spendAll_at, spend, same]

/-- Spending an owner outside both caller regions preserves the scalar check.
No support restriction on the saved demand is needed. -/
theorem ResumeBudget.spend_absent
    (checked : ResumeBudget budget before owner demand mode front tail = true)
    (frontAbsent : other ∉ front.owned) (tailAbsent : other ∉ tail.owned) :
    ResumeBudget budget (spend before other) owner demand mode front tail = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
      obtain ⟨metadata, found, checked⟩ := unwind_iff.mp checked
      apply unwind_iff.mpr
      refine ⟨metadata, found, ?_⟩
      rw [budget_spend_comm before other owner, resume_budget_spendAll_spend]
      exact metadata.check_spend_absent
        (by simpa only [front.closing_owned found] using frontAbsent)
        (by simpa only [Context.context, liveNames] using
          (fun member => tailAbsent (tail.liveNames_owned member))) checked

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual

#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeBudget.spend_absent

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
open OwnerPhaseTransitions (Phases spend spendAll)
open SpentTransport

/-- An empty caller prefix adds no cleanup demand in either return mode. -/
theorem ResumeBudget.empty_front :
    ResumeBudget budget before owner demand mode Context.nil tail = true := by
  cases mode <;> simp [ResumeBudget, Context.closing?, CleanupHints.Metadata.check,
    CleanupHints.Metadata.closing, RecursiveRecomposition.evaluate_empty]

/-- Plain frame insertion preserves the exact-demand caller guard. -/
theorem ResumeBudget.plain
    (frontRelated : Plain front nextFront) (tailRelated : Plain tail nextTail)
    (checked : ResumeBudget budget before owner demand mode front tail = true) :
    ResumeBudget budget before owner demand mode nextFront nextTail = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
      obtain ⟨metadata, found, accepted⟩ := unwind_iff.mp checked
      obtain ⟨next, nextFound, nextAccepted⟩ :=
        frontRelated.closing_check (Plain.spent (owner := owner) tailRelated) found accepted
      exact unwind_iff.mpr ⟨next, nextFound, nextAccepted⟩

/-- A consumed owner's history preserves the caller guard after the exact saved demand. -/
theorem ResumeBudget.history
    (frontRelated : SpentHistory freshOwner front nextFront)
    (tailRelated : SpentHistory freshOwner tail nextTail)
    (checked : ResumeBudget budget before owner demand mode front tail = true)
    (consumed : before freshOwner = .consumed) :
    ResumeBudget budget before owner demand mode nextFront nextTail = true := by
  cases mode with
  | ordinary => rfl
  | unwind =>
      obtain ⟨metadata, found, accepted⟩ := unwind_iff.mp checked
      have stillConsumed : spendAll (spend before owner) demand freshOwner = .consumed :=
        RecursiveTransport.phases_spendAll_later _ (RecursiveTransport.phases_spend_later _ consumed)
      obtain ⟨next, nextFound, nextAccepted⟩ :=
        frontRelated.closing_check (SpentHistory.spent (owner := owner) tailRelated)
          found stillConsumed accepted
      exact unwind_iff.mpr ⟨next, nextFound, nextAccepted⟩


end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeBudget.empty_front
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeBudget.plain
#print axioms Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual.ResumeBudget.history

namespace Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows.Contextual
