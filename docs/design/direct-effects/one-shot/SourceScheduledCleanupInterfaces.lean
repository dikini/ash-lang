/-- Opening the rich resource body requires only freshness in the source world.
The issued-resource inclusion derives lifetime allocation freshness, while the
existing generated-row coverage proof preserves the effect budget. -/
theorem JoinedState.enter_resource
    (state : JoinedState operations policy contracts tables families required outward annotations world ambient history
      resumes disposals annotatedStore budget output
      ⟨⟨.eval ⟨.resource binder initializer body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
    (isValue : initializer.IsValue) (fresh : identity ∉ world) :
    ∃ payload answer, initializer = .integer payload ∧
      JoinedState operations policy contracts tables families required outward annotations (world ++ [identity]) ambient history
        resumes disposals annotatedStore budget output
        ⟨⟨.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩,
          issued ++ [Owner.resource identity], completed⟩, actions⟩ := by
  cases state.source with
  | eval current certified scopeTyped pending localCheck retained matching bound finite annotation checked bounded =>
    obtain ⟨ticket, typed⟩ := scopeTyped
    have unique := owned_tickets_unique (ledger_unique_live state.lifetime.1)
    obtain ⟨payload, answer, residual, bodyDependencies, bodyPlan, bodyRequirements,
      nextRequirements, nextAnnotated, nextRow, initializerSame, nextSource, nextCertified, nextPending,
      nextAnnotation, rawPath, generatedPath, nextChecked, included, nextLocal, nextRetained,
      nextMatching, nextBound, nextResumes, nextDisposals, raw, transition, owners,
      nextUse, nextTickets, nextResources⟩ :=
      enter_resource_planned_generated current pending typed isValue certified localCheck retained matching bound
        annotation checked unique state.lifetime.2.2 state.tickets state.resources identity fresh
    have ownerFresh : Owner.resource identity ∉ issued := fun member =>
      fresh (state.issuedResources (ScopedTyping.mem_resource_world.mpr member))
    have allocation : (issued ++ [Owner.resource identity]).Nodup := by
      apply List.nodup_append.mpr
      refine ⟨state.lifetime.1.2, by simp, ?_⟩
      intro first member second other same
      have singleton := List.mem_singleton.mp other
      subst second
      exact ownerFresh (singleton ▸ member)
    have event : LexicalUnwind.UseEvent policy
        ⟨⟨.eval ⟨.resource binder initializer body, runtimeScope, stack⟩, issued, completed⟩, actions⟩
        ⟨⟨.eval ⟨body.instantiate (Instantiation.Environment.empty.bind binder identity), runtimeScope,
          .push (.cell identity payload runtimeScope answer) stack⟩,
          issued ++ [Owner.resource identity], completed⟩, actions⟩ := by
      simpa only [List.nil_append, LexicalUnwind.advanceUseTickets, advanceUsageTickets] using
        (LexicalUnwind.UseEvent.step
          (before := ⟨⟨.eval ⟨.resource binder initializer body, runtimeScope, stack⟩, issued, completed⟩, actions⟩)
          transition allocation)
    refine ⟨payload, answer, initializerSame, ?_⟩
    refine ⟨?_, (fun key stored member => nextResumes key stored (state.resumeRecords key stored member)),
      (fun key stored member => nextDisposals key stored (state.unwindRecords key stored member)),
      state.storeAnnotation, event.preserves state.lifetime, nextTickets, nextResources,
      state.activations, ?_⟩
    · apply JoinedSource.eval nextSource nextCertified ⟨ticket, typed⟩ nextPending nextLocal nextRetained
        nextMatching nextBound ?_ nextAnnotation nextChecked (included.trans bounded)
      simpa only [SourceContextualRechecking.checkForest, SourceContextualRechecking.checkFrame,
        Bool.true_and] using finite
    · simpa only [ScopedTyping.resource_world_append, ScopedTyping.resourceWorld,
        List.filterMap_append, List.filterMap_cons, List.filterMap_nil] using
        (ScopedExpressions.append_subset state.issuedResources (List.Subset.refl [identity]))

