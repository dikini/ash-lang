theorem PlannedModeSource.start_cleanup_generated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.armed action) rest) .unwind output demand requirements scope)
    (checked : RecursiveRequirements.Checked entries receiving before (annotateDisposals requirements) row) :
    ∃ latent dependencies, ∃ callbackPlan : Plan dependencies,
    ∃ callbackRow tailRow nextScope,
    ∃ tailRequirements nextRequirements : Requirements demand,
      scope = .cleanup action.requests dependencies nextScope ∧
      Certified (evidence := declarationPolicy) outward world callbackPlan ∧
      SourcePlannedSources.Expression operations policy contracts world action.requests .none (fun _ => none)
        (.app action.action .unit) .unit []
        (.emitAfter (.sequence (.request [] []) (.request [] [])) [] latent)
        (signature (.sequence .pure (.sequence .pure callbackPlan))) ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest .unwind output demand tailRequirements nextScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world (.push (.unwinding action) rest)
        (.value .unit) output demand nextRequirements (.running nextScope) ∧
      RecursiveRequirements.Checked entries
        (OwnerPhases.ofStack tables (.push (.unwinding action) rest) ++ receiving) before
        (.emitAfter (.sequence (.request [] []) (.request [] [])) [] latent) callbackRow ∧
      RecursiveRequirements.Checked entries receiving before (annotateDisposals nextRequirements) tailRow ∧
      row = callbackRow ++ tailRow := by
  cases source with
  | push head tail => cases head with
      | cleanup callback certified =>
          obtain ⟨callbackRow, tailRow, callbackCheck, tailCheck, same⟩ :=
            RecursiveRequirements.checked_sequence_parts checked
          obtain ⟨expression, appCheck⟩ := SourceDependencyFrames.cleanup_application_checked (SourcePlannedSources.expression_erase callback)
            (by simpa only [annotateDisposals, disposal_prepend, Requirements.prepend, List.nil_append] using callbackCheck)
          refine ⟨_, _, _, callbackRow, tailRow, _, _, _, rfl, certified,
            .app (SourcePlannedSources.Values.change_context callback action.closed.1 action.requests .none) .unit (List.Subset.refl _), tail,
            .push (.unwinding callback certified) tail, appCheck, ?_, same⟩
          apply RecursiveRequirements.evaluate_sound
          simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            evaluate_empty, spendAll, merge_empty_left] using RecursiveRequirements.checked_complete tailCheck

theorem PlannedModeSource.finish_cleanup_generated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.unwinding action) rest) (.value .unit) output demand requirements scope)
    (checked : RecursiveRequirements.Checked entries receiving before (annotateDisposals requirements) row) :
    ∃ nextScope, ∃ nextRequirements : Requirements demand,
      scope = .running nextScope ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest .unwind output demand nextRequirements nextScope ∧
      RecursiveRequirements.Checked entries receiving before (annotateDisposals nextRequirements) row := by
  cases source with
  | push head tail => cases head with
      | ordinary frame => cases frame
      | unwinding callback certified =>
          refine ⟨_, _, rfl, tail, RecursiveRequirements.evaluate_sound ?_⟩
          simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
            evaluate_empty, spendAll, merge_empty_left] using RecursiveRequirements.checked_complete checked

theorem PlannedModeSource.finish_close_generated
    (source : PlannedModeSource operations policy contracts tables families required outward actions world
      (.push (.closing identity caller) rest) .unwind output demand requirements scope)
    (checked : Checked entries receiving before (annotateDisposals requirements) row) :
    ∃ nextScope, ∃ nextRequirements : Requirements demand,
      scope = .running nextScope ∧
      ScopedPorts.EffectScopeKnown contracts.erase.erase.ports caller ∧
      PlannedModeSource operations policy contracts tables families required outward actions world rest (.value .unit) output demand nextRequirements nextScope ∧
      Checked entries receiving before (annotateDisposals nextRequirements) row := by
  cases source with | push head tail => cases head with
    | closing scopeKnown =>
        refine ⟨_, _, rfl, scopeKnown, tail, RecursiveRequirements.evaluate_sound ?_⟩
        simpa only [annotateDisposals, disposal_prepend, RecursiveRequirements.evaluate_sequence, RecursiveRequirements.evaluate_prepend,
          evaluate_empty, spendAll, merge_empty_left] using RecursiveRequirements.checked_complete checked
