theorem AuthBody.contract_extension
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {answerRows : ValueRows answer} {rows : Rows checking}
    (checked : AuthBody operations policy ports owners environmentRows answerRows
      (source : SourcePlannedSources.Body operations policy contracts world allowed scope environment code answer header checking) rows)
    (extension : contracts.Extends nextContracts) (nextOwners : ContractRows nextContracts)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    AuthBody operations policy ports nextOwners environmentRows answerRows (body_extension source extension) rows := by
  cases checked with
  | typed checked =>
    exact .typed (checked.contract_extension extension nextOwners compatible)
      (rows := by assumption) (closingRows := by assumption)

theorem AuthOffer.contract_extension
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {argumentRows : ValueRows argument} {inputRows : ValueRows input} {answerRows : ValueRows answer}
    {rows : ModeRows (SourcePlanSignatures.modeSignatures plans)}
    (checked : AuthOffer operations policy ports owners environmentRows argumentRows inputRows answerRows
      (source : SourcePlannedSources.Offer operations policy contracts world environment allowed parameter binder argument input answer
        resumeEffects closeEffects code held disposes row plans) rows)
    (extension : contracts.Extends nextContracts) (nextOwners : ContractRows nextContracts)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    AuthOffer operations policy ports nextOwners environmentRows argumentRows inputRows answerRows
      (offer_extension source extension) rows := by
  cases checked with
  | unavailable => exact .unavailable
  | available checked =>
    apply AuthOffer.available (resumeInterface := by assumption) (closeInterface := by assumption)
    intro owner contract fresh inputSame answerSame resumeSame closeSame heldSame demands
    exact (checked owner contract (SourcePlannedTyping.extension_fresh extension fresh)
      inputSame answerSame resumeSame closeSame heldSame demands).contract_extension
      (SourcePlannedTyping.insert_extension extension)
      (nextOwners.insert owner (inputSame.symm ▸ _) (answerSame.symm ▸ _)) (compatible.insert _ _)

theorem AuthDeclarations.contract_extension
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    {plans : SourceDeclarationPlans.ClausePlans clauses families}
    {answerRows : ValueRows answer} {rows : ClauseRows (SourcePlanSignatures.clauseSignatures plans)}
    {source : SourcePlannedSources.Declarations operations policy contracts world environment allowed effect answer clauses table plans}
    (checked : AuthDeclarations operations policy ports owners environmentRows answerRows source rows)
    (extension : contracts.Extends nextContracts) (nextOwners : ContractRows nextContracts)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    AuthDeclarations operations policy ports nextOwners environmentRows answerRows
      (declarations_extension source extension) rows := by
  induction clauses using Clauses.rec (motive_1 := fun _ => True) generalizing table families with
  | nil => cases checked; exact .nil
  | cons operation parameter binder code rest ihCode ihRest =>
    cases checked with
    | cons ordinary protectedMode rest support =>
      exact .cons (ordinary.contract_extension extension nextOwners compatible)
        (protectedMode.contract_extension extension nextOwners compatible) (ihRest rest) support (known := by assumption)
  | _ => trivial

theorem AuthContext.contract_extension
    {ports : OperationRows operations} {owners : ContractRows contracts}
    {environmentRows : EnvironmentRows environment}
    (checked : AuthContext operations policy ports owners environmentRows
      (source : SourcePlannedSources.Context operations policy contracts world environment allowed scope
        position input output demand requirements checking) inputRows outputRows rows)
    (extension : contracts.Extends nextContracts) (nextOwners : ContractRows nextContracts)
    (compatible : ContractRows.Compatible extension owners nextOwners) :
    AuthContext operations policy ports nextOwners environmentRows
      (context_extension source extension) inputRows outputRows rows := by
  cases checked with
  | pairLeft right => exact .pairLeft (right.contract_extension extension nextOwners compatible)
  | pairRight left => exact .pairRight (left.contract_extension extension nextOwners compatible)
  | appFunction argument => exact .appFunction (argument.contract_extension extension nextOwners compatible) (admitted := by assumption)
  | appArgument function => exact .appArgument (function.contract_extension extension nextOwners compatible) (admitted := by assumption)
  | bind body => exact .bind (body.contract_extension extension nextOwners compatible)
  | branch yes no => exact .branch (yes.contract_extension extension nextOwners compatible) (no.contract_extension extension nextOwners compatible) (same := by assumption)
  | perform => exact .perform (known := by assumption) (admitted := by assumption) (formed := by assumption)
  | resume =>
      rename_i owner contract binder permission known formed admitted resolved
      have same := compatible owner contract known
      simpa only [same] using (AuthContext.resume (owners := nextOwners) (known := extension owner contract known)
        (resolved := by assumption) (permission := by assumption) (admitted := by assumption) (formed := by assumption))
  | cleanup body => exact .cleanup (body.contract_extension extension nextOwners compatible) (admitted := by assumption)
  | resource body =>
    exact .resource (fun identity fresh => (body identity fresh).contract_extension extension nextOwners compatible)
      (formed := by assumption) (effectsBound := by assumption) (admitted := by assumption) (hidden := by assumption)

end Ash.OneShot.SourceScheduledCleanupInterfaces.Lexical.Recursive.CleanupRows
