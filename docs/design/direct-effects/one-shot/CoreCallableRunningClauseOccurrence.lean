import CoreCallableRunningCapture
namespace Ash.OneShot.CoreCallableRunningClauseOccurrence
open CoreSyntax CoreTranslation CoreMachine CoreValueRelation CoreStrictFrames CoreStrictStack
open ScopedExpressions ScopedExecution CoreGeneralStack CoreGeneralCaptureResume CoreGeneralRestoration
open CoreCallableReachableResume CoreCallableCleanupOrigins CoreCallableCleanupReachableTransport
open CoreCallableGeneralHistory CoreCallableCallerBarriers CoreCallableSiteLineage
open CoreCallableRunningOccurrence CoreCallableRunningCapture CoreCaptureEntry CoreRequestFrames

private theorem extension_trans (first : HeapExtends old middle) (second : HeapExtends middle largerHeap) : HeapExtends old largerHeap :=
  fun index cell known => second index cell (first index cell known)

/-- Current fronts are the actual bind frames generated by the local factories.
This is a current physical shape, not an assumption of future lookup success. -/
def BindFront (front : List CoreMachine.Frame) : Prop :=
  ∀ frame ∈ front, ∃ name body environment, frame = .bind name body environment

structure ClauseOccurrence
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    {original : RunningOccurrence start originalHeap originalFrames originalStack}
    {index : Fin (handler_locations original.tailHistory).length}
    (captured : CapturedOccurrence original index selectedClause dynamicTicket) (result : Ty) (heap : CoreMachine.Heap) where
  extension : HeapExtends originalHeap heap
  front : List CoreMachine.Frame
  frontTarget : Stack
  frontHistory : GeneralHistory graph heap front frontTarget
  binds : BindFront front

section
variable {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
variable {original : RunningOccurrence start originalHeap originalFrames originalStack}
variable {index : Fin (handler_locations original.tailHistory).length}
variable {captured : CapturedOccurrence original index selectedClause dynamicTicket}
variable {result : Ty}

noncomputable def ClauseOccurrence.physical (current : ClauseOccurrence captured result heap) : List CoreMachine.Frame :=
  current.front ++ .clauseBoundary (tail_location original index).installation.handler selectedClause.owner
    (tail_location original index).data.activation dynamicTicket
    (some ((tail_location original index).inside ++ [.handlerBoundary (tail_location original index).site
      (tail_location original index).environment (tail_location original index).data.activation])) ::
    (tail_location original index).outside

noncomputable def ClauseOccurrence.target (current : ClauseOccurrence captured result heap) : Stack :=
  current.frontTarget.append (.live dynamicTicket result (tail_location original index).data.answer
    ((tail_location original index).front.append (.push (.handler (tail_location original index).data) .nil))
    (tail_location original index).data.scope (tail_location original index).tail)

noncomputable def ClauseOccurrence.history (current : ClauseOccurrence captured result heap) :
    GeneralHistory graph heap current.physical current.target :=
  current.frontHistory.append (.live captured.installation (captured.header.heap_weaken current.extension)
    ((contained_occurrence original index).history.heap_weaken current.extension)
    ((tail_location original index).after.heap_weaken current.extension))

private def initial (captured : CapturedOccurrence original index selectedClause dynamicTicket) (result : Ty) :
    ClauseOccurrence captured result originalHeap :=
  ⟨(fun _ _ h => h),[],.nil,.nil,by intro _ h; cases h⟩

noncomputable def ClauseOccurrence.heap_weaken (current : ClauseOccurrence captured result heap)
    (extension : HeapExtends heap larger) : ClauseOccurrence captured result larger :=
  ⟨extension_trans current.extension extension,current.front,current.frontTarget,
    current.frontHistory.heap_weaken extension,current.binds⟩

private theorem retained_comp (history : RetainedHistory graph heap physical target)
    (first : HeapExtends heap middle) (second : HeapExtends middle larger) :
    (history.heap_weaken first).heap_weaken second = history.heap_weaken (extension_trans first second) := by
  induction history <;> simp_all [RetainedHistory.heap_weaken]

private theorem history_comp (history : GeneralHistory graph heap physical target)
    (first : HeapExtends heap middle) (second : HeapExtends middle larger) :
    (history.heap_weaken first).heap_weaken second = history.heap_weaken (extension_trans first second) := by
  induction history <;> simp_all [GeneralHistory.heap_weaken,retained_comp]

private theorem weaken_append (first : GeneralHistory graph heap firstPhysical firstTarget)
    (second : GeneralHistory graph heap secondPhysical secondTarget) (extension : HeapExtends heap larger) :
    (first.append second).heap_weaken extension =
      (first.heap_weaken extension).append (second.heap_weaken extension) := rfl

private theorem weaken_live
    (installation : GeneralClausePast graph owners handler owner activation clauseTicket capturedPhysical handlerData)
    (header : OwnerHeader graph owners heap handler owner activation handlerData)
    (saved : GeneralHistory graph heap capturedPhysical savedTarget)
    (tail : GeneralHistory graph heap physical target) (extension : HeapExtends heap larger) :
    (GeneralHistory.live (result := result) installation header saved tail).heap_weaken extension =
      .live installation (header.heap_weaken extension) (saved.heap_weaken extension) (tail.heap_weaken extension) := rfl

theorem ClauseOccurrence.weaken_history (current : ClauseOccurrence captured result heap)
    (extension : HeapExtends heap larger) :
    (current.heap_weaken extension).history = current.history.heap_weaken extension := by
  simp only [ClauseOccurrence.history,ClauseOccurrence.heap_weaken]
  erw [weaken_append,weaken_live,history_comp,history_comp]

/-- Actual bind installation is coupled to this SAME captured occurrence. -/
theorem ClauseOccurrence.bind_enter {base : CoreMachine.State}
    (current : ClauseOccurrence captured result base.heap)
    (origin : CurrentScopeOrigin graph owners plain.scope current.physical)
    (postorder : CoreTranslationFuel.Postorder graph)
    (lineage : SiteLineage graph owners plain.scope site)
    (known : graph.node site = some node) (kind : node.kind = .bind binder initializer body)
    (it : translateFuel graph fuel owners initializer = .ok rawInitializer)
    (bt : translateFuel graph fuel owners body = .ok rawBody)
    (lexical : EnvCloses graph owners base.heap savedEnvironment
      (.bind binder.id rawInitializer rawBody) (.bind binder.id initializerCode suffix))
    (notValue : ¬ initializerCode.IsValue) (ready : ClosedExcept binder.id suffix)
    (context : plain.context = .bind binder.id suffix) :
    ∃ past : CallerBindPast graph owners binder body savedEnvironment plain current.physical current.target,
      past.predecessor = base ∧ HEq past.originalHistory current.history ∧
      ∃ entered : ClauseOccurrence captured result base.heap,
        entered.front = .bind binder.id body savedEnvironment :: current.front ∧
        entered.frontTarget = .push (.plain plain) current.frontTarget := by
  obtain ⟨past,pred,_,_,_,_,same⟩ := CoreCallableCallerBarriers.bind_enter current.history origin postorder lineage known kind it bt lexical notValue ready context
  have frame : PushCarrier graph owners base.heap (.bind binder.id body savedEnvironment) (.plain plain) :=
    .ordinary (by simpa only [pred] using past.saved.saved.related)
  let entered : ClauseOccurrence captured result base.heap := {
    extension := current.extension
    front := .bind binder.id body savedEnvironment :: current.front
    frontTarget := .push (.plain plain) current.frontTarget
    frontHistory := .push frame (by trivial) current.frontHistory
    binds := by
      intro item member
      cases member with
      | head => exact ⟨binder.id,body,savedEnvironment,rfl⟩
      | tail _ h => exact current.binds item h }
  exact ⟨past,pred,same,entered,rfl,rfl⟩

private theorem weaken_heq (first : GeneralHistory graph oldHeap physical target)
    (second : GeneralHistory graph otherHeap physical target) (sameHeap : oldHeap = otherHeap)
    (same : HEq first second) (firstExtension : HeapExtends oldHeap larger)
    (secondExtension : HeapExtends otherHeap larger) :
    HEq (first.heap_weaken firstExtension) (second.heap_weaken secondExtension) := by
  cases sameHeap
  cases eq_of_heq same
  rfl

private theorem current_coupling {beforeBase : CoreMachine.State}
    (before : ClauseOccurrence captured result beforeBase.heap)
    (past : CallerBindPast graph owners binder body savedEnvironment plain before.physical before.target)
    (pred : past.predecessor = beforeBase) (same : HEq past.originalHistory before.history)
    (extension : HeapExtends beforeBase.heap heap) :
    ∃ actualExtension : HeapExtends past.predecessor.heap heap,
      HEq (past.originalHistory.heap_weaken actualExtension) (before.heap_weaken extension).history := by
  have sameHeap := congrArg CoreMachine.State.heap pred
  have actualExtension : HeapExtends past.predecessor.heap heap := by
    intro i cell known
    exact extension i cell (by simpa only [sameHeap] using known)
  exact ⟨actualExtension,(weaken_heq past.originalHistory before.history sameHeap same actualExtension extension).trans
    (heq_of_eq (before.weaken_history extension).symm)⟩

/-- Beta uses the SAME produced bind history after actual current heap growth. -/
theorem ClauseOccurrence.beta_enter {beforeBase base : CoreMachine.State}
    (before : ClauseOccurrence captured result beforeBase.heap)
    (past : CallerBindPast graph bindOwners binder body savedEnvironment plain before.physical before.target)
    (pred : past.predecessor = beforeBase) (same : HEq past.originalHistory before.history)
    (extension : HeapExtends beforeBase.heap base.heap)
    (function : ValueRel graph callOwners base.heap (.closure parameter calleeBody closureSaved) (.lambda parameter bodyCode))
    (argument : ValueRel graph callOwners base.heap value argumentCode) (callScope : Execution.Scope) :
    ∃ actualExtension : HeapExtends past.predecessor.heap base.heap,
      HEq (past.originalHistory.heap_weaken actualExtension) (before.heap_weaken extension).history ∧
      ∃ reset : BetaBindPast graph bindOwners binder body savedEnvironment plain before.physical before.target
          past base [] .nil callOwners parameter calleeBody closureSaved value argumentCode bodyCode callScope,
        reset.frontHistory = .nil ∧
        ∃ entered : ClauseOccurrence captured result base.heap,
          entered.front = .bind binder.id body savedEnvironment :: before.front ∧
          entered.frontTarget = .push (.plain plain) before.frontTarget ∧
          SiteLineage graph [] .none calleeBody := by
  obtain ⟨actualExtension,coupled⟩ := current_coupling before past pred same extension
  obtain ⟨reset,frontSame,_⟩ := CoreCallableCallerBarriers.beta_enter past actualExtension .nil function argument callScope
  let current := before.heap_weaken extension
  have frame : PushCarrier graph bindOwners base.heap (.bind binder.id body savedEnvironment) (.plain plain) :=
    .ordinary (past.saved.saved.related.heap_weaken actualExtension)
  let entered : ClauseOccurrence captured result base.heap := {
    extension := current.extension
    front := .bind binder.id body savedEnvironment :: current.front
    frontTarget := .push (.plain plain) current.frontTarget
    frontHistory := .push frame (by trivial) current.frontHistory
    binds := by
      intro item member
      cases member with
      | head => exact ⟨binder.id,body,savedEnvironment,rfl⟩
      | tail _ h => exact current.binds item h }
  exact ⟨actualExtension,coupled,reset,frontSame,entered,rfl,rfl,reset.resetSite⟩

/-- Actual head return recovers the SAME produced bind's original occurrence. -/
theorem ClauseOccurrence.bind_return {beforeBase base : CoreMachine.State}
    (before : ClauseOccurrence captured result beforeBase.heap)
    (past : CallerBindPast graph bindOwners binder body savedEnvironment plain before.physical before.target)
    (pred : past.predecessor = beforeBase) (same : HEq past.originalHistory before.history)
    (extension : HeapExtends beforeBase.heap base.heap)
    (argument : ValueRel graph codeOwners base.heap value argumentCode) (runtimeScope : Execution.Scope) :
    CoreMachine.next graph {base with control := .returned value,frames := .bind binder.id body savedEnvironment :: before.physical} =
      .stepped {base with control := .evaluate body (.binding binder.id value savedEnvironment),frames := before.physical} ∧
    RawStep ⟨argumentCode,runtimeScope,.push (.plain plain) before.target⟩
      ⟨.bind binder.id argumentCode past.suffixCode,plain.scope,before.target⟩ [] [] ∧
    RawStep ⟨.bind binder.id argumentCode past.suffixCode,plain.scope,before.target⟩
      ⟨past.suffixCode.subst binder.id argumentCode,plain.scope,before.target⟩ [] [] ∧
    SiteLineage graph bindOwners plain.scope body ∧
    CurrentScopeOrigin graph bindOwners plain.scope before.physical ∧
    ∃ current : ClauseOccurrence captured result base.heap,
      current = before.heap_weaken extension ∧
      current.front = before.front ∧ current.frontTarget = before.frontTarget ∧
      ∃ actualExtension : HeapExtends past.predecessor.heap base.heap,
        HEq current.history (past.originalHistory.heap_weaken actualExtension) := by
  obtain ⟨actualExtension,coupled⟩ := current_coupling before past pred same extension
  obtain ⟨actual,plug,step,site,origin,_⟩ := CoreCallableCallerBarriers.bind_return past actualExtension argument runtimeScope
  exact ⟨actual,plug,step,site,origin,before.heap_weaken extension,rfl,rfl,rfl,actualExtension,coupled.symm⟩

/-- Actual tuple allocation derives current heap growth before transporting
this occurrence; it is bounded administrative progress, not a target reduction. -/
theorem ClauseOccurrence.tuple_allocate {base : CoreMachine.State}
    (current : ClauseOccurrence captured result base.heap)
    (left : ValueRel graph owners base.heap leftValue leftCode)
    (right : ValueRel graph owners base.heap rightValue rightCode) :
    CoreAdministrativeSteps.ValueWitness graph owners
      {base with control := .returned rightValue,frames := .tupleRight leftValue :: current.physical}
      {base with control := .returned (.location base.heap.length),frames := current.physical, heap := base.heap ++ [.pair leftValue rightValue]} (.pair leftCode rightCode) ∧
    ∃ extension : HeapExtends base.heap (base.heap ++ [.pair leftValue rightValue]),
      ∃ nextCurrent : ClauseOccurrence captured result (base.heap ++ [.pair leftValue rightValue]),
        nextCurrent = current.heap_weaken extension ∧
        nextCurrent.front = current.front ∧ nextCurrent.frontTarget = current.frontTarget ∧
        HEq nextCurrent.history (current.history.heap_weaken extension) := by
  obtain ⟨actual,extension,_,_⟩ := CoreAdministrativeSteps.tuple_allocate left right current.physical
  exact ⟨actual,extension,current.heap_weaken extension,rfl,rfl,rfl,heq_of_eq (current.weaken_history extension)⟩

private abbrev Pass (handler owner : Nat) (frames : List CoreMachine.Frame) : Prop :=
  ∀ rest cut, CoreMachine.findOwner handler owner rest = .ok cut →
    CoreMachine.findOwner handler owner (frames ++ rest) = .ok {cut with inside := frames ++ cut.inside}

private theorem append_search_missing
    (first : GeneralHistory graph heap firstPhysical firstTarget)
    (second : GeneralHistory graph heap secondPhysical secondTarget)
    (searched : OwnerSearch graph heap handler owner firstPhysical firstTarget)
    (pass : Pass handler owner firstPhysical) (missing : searched = .missing pass) :
    OwnerSearch.rec (motive := fun value => searched = value →
        OwnerSearch graph heap handler owner (firstPhysical ++ secondPhysical) (firstTarget.append secondTarget))
      (fun location _ => .found (location.suffix second))
      (fun savedPass _ => (owner_search second handler owner).prepend first savedPass)
      (fun _ => .blocked) searched rfl =
      (owner_search second handler owner).prepend first pass := by
  cases missing
  rfl

private theorem search_append_missing
    (first : GeneralHistory graph heap firstPhysical firstTarget)
    (second : GeneralHistory graph heap secondPhysical secondTarget)
    (pass : Pass handler owner firstPhysical)
    (missing : owner_search first handler owner = .missing pass) :
    owner_search (first.append second) handler owner =
      (owner_search second handler owner).prepend first pass := by
  conv => lhs; unfold owner_search
  dsimp only
  exact append_search_missing first second _ pass missing

private theorem and_rec_self {α : Sort u} {β : Sort v} {γ : Sort w} {x : α} {y : β}
    (f : x = x → y = y → γ) (h : x = x ∧ y = y) : And.rec f h = f rfl rfl := by
  have same : h = ⟨rfl,rfl⟩ := Subsingleton.elim _ _
  cases same
  rfl

private theorem bind_search_missing (history : GeneralHistory graph heap frames stack)
    (binds : BindFront frames) (handler owner : Nat) :
    ∃ pass : Pass handler owner frames, owner_search history handler owner = .missing pass := by
  induction history with
  | nil => exact ⟨(by intro _ _ h; exact h),rfl⟩
  | retained history => exact ⟨_,rfl⟩
  | @push owners core frameTarget tailPhysical tailTarget frame ordinary tail ih =>
    have tailBinds : BindFront _ := fun item member => binds item (by simp only [List.mem_cons]; exact Or.inr member)
    obtain ⟨pass,missing⟩ := ih tailBinds
    have passFront : Pass handler owner [core] := by
      obtain ⟨n,b,e,coreSame⟩ := binds core (List.mem_cons_self)
      intro rest cut found
      simp [coreSame,CoreMachine.findOwner,found,Functor.map,Except.map]
    have step : owner_search (.push frame ordinary tail) handler owner =
        (owner_search tail handler owner).prepend (.push frame ordinary .nil) passFront := rfl
    erw [step,missing]
    exact ⟨_,rfl⟩
  | @handler owners site env handlerData physical target installation header tail ih =>
    obtain ⟨n,b,e,same⟩ := binds (.handlerBoundary site env handlerData.activation) (by simp)
    cases same
  | @running owners action env actionData value code original receipt =>
    obtain ⟨n,b,e,same⟩ := binds (.cleanupCompletion actionData.identity value) (by simp)
    cases same
  | @unwinding owners action env actionData original installed =>
    obtain ⟨n,b,e,same⟩ := binds (.cleanupCompletion actionData.identity .unit) (by simp)
    cases same
  | closing core target scope =>
    obtain ⟨n,b,e,same⟩ := binds (.closeCompletion core) (by simp)
    cases same
  | @live owners h o activation clauseTicket cap handlerData capTarget physical target result installation header saved tail ihSaved ihTail =>
    obtain ⟨n,b,e,same⟩ := binds (.clauseBoundary h o activation clauseTicket (some cap)) (by simp)
    cases same
  | @spent owners h o activation clauseTicket cap handlerData physical target installation header tail ih =>
    obtain ⟨n,b,e,same⟩ := binds (.clauseBoundary h o activation clauseTicket none) (by simp)
    cases same
  | append first second ihFirst ihSecond =>
    have firstBinds : BindFront _ := fun item member => binds item (List.mem_append_left _ member)
    have secondBinds : BindFront _ := fun item member => binds item (List.mem_append_right _ member)
    obtain ⟨firstPass,firstMissing⟩ := ihFirst firstBinds
    obtain ⟨secondPass,secondMissing⟩ := ihSecond secondBinds
    have step : owner_search (first.append second) handler owner =
        (owner_search second handler owner).prepend first firstPass := by
      conv => lhs; unfold owner_search
      dsimp only
      exact append_search_missing first second _ firstPass firstMissing
    erw [step,secondMissing]
    exact ⟨_,rfl⟩

/-- The generated current ordinary front passes the SAME selected physical
live owner. A matching spent boundary is never introduced as a pass guard. -/
noncomputable def ClauseOccurrence.owner_location (current : ClauseOccurrence captured result heap) :
    OwnerLocation graph heap (tail_location original index).installation.handler selectedClause.owner
      current.physical current.target := by
  let originalLocation := captured.owner_location result
  have currentHeader := captured.header.heap_weaken current.extension
  let here : OwnerLocation graph heap (tail_location original index).installation.handler selectedClause.owner
      (.clauseBoundary (tail_location original index).installation.handler selectedClause.owner
        (tail_location original index).data.activation dynamicTicket (some originalLocation.captured) :: originalLocation.outside)
      (.live dynamicTicket result originalLocation.data.answer originalLocation.capturedTarget originalLocation.data.scope originalLocation.tail) := {
    front := [],frontTarget := .nil,frontHistory := .nil
    owners := originalLocation.owners,occurrence := originalLocation.occurrence,dynamicTicket := dynamicTicket
    data := originalLocation.data,result := result,captured := originalLocation.captured,capturedTarget := originalLocation.capturedTarget
    capturedHistory := originalLocation.capturedHistory.heap_weaken current.extension
    installation := captured.installation,header := currentHeader
    outside := originalLocation.outside,tail := originalLocation.tail
    outsideHistory := originalLocation.outsideHistory.heap_weaken current.extension
    whole := .live captured.installation currentHeader (originalLocation.capturedHistory.heap_weaken current.extension)
      (originalLocation.outsideHistory.heap_weaken current.extension)
    physicalSame := rfl,targetSame := rfl
    cut := .hit currentHeader (originalLocation.capturedHistory.heap_weaken current.extension).related
      (originalLocation.outsideHistory.heap_weaken current.extension).related }
  have pass : Pass (tail_location original index).installation.handler selectedClause.owner current.front := by
    obtain ⟨pass,_⟩ := bind_search_missing current.frontHistory current.binds
      (tail_location original index).installation.handler selectedClause.owner
    exact pass
  exact here.prepend current.frontHistory pass

theorem ClauseOccurrence.owner_picked (current : ClauseOccurrence captured result heap) :
    owner_search current.history (tail_location original index).installation.handler selectedClause.owner =
      .found current.owner_location := by
  obtain ⟨pass,missing⟩ := bind_search_missing current.frontHistory current.binds
    (tail_location original index).installation.handler selectedClause.owner
  have appendEq := search_append_missing current.frontHistory
    (GeneralHistory.live (result := result) captured.installation (captured.header.heap_weaken current.extension)
      ((contained_occurrence original index).history.heap_weaken current.extension)
      ((tail_location original index).after.heap_weaken current.extension)) pass missing
  simp only [ClauseOccurrence.history] at ⊢
  erw [appendEq]
  simp [owner_search,ClauseOccurrence.owner_location,CapturedOccurrence.owner_location]
  rw [and_rec_self]
  rfl


private theorem origin_canonical (origin : CurrentScopeOrigin graph owners scope physical) :
    CanonicalOwnerMap graph owners := by
  cases origin with
  | inactive canonical => exact canonical
  | clause canonical path => exact canonical.clause

private theorem bind_owner_path (binds : BindFront front)
    (path : OwnerPath handler owner activation clauseTicket saved whole inside outside) :
    OwnerPath handler owner activation clauseTicket saved (front ++ whole) (front ++ inside) outside := by
  induction front with
  | nil => exact path
  | cons frame rest ih =>
    obtain ⟨n,b,e,same⟩ := binds frame (List.mem_cons_self)
    have tailBinds : BindFront rest := fun item member => binds item (List.mem_cons_of_mem _ member)
    exact .skip frame (by intro _ _ _ _ _ impossible; cases same; cases impossible) (ih tailBinds)

/-- Selected clause lineage comes from the original actual installation and
selected clause; the bind-front owner path is a derived current path. -/
theorem ClauseOccurrence.selected_origin (current : ClauseOccurrence captured result heap)
    (postorder : CoreTranslationFuel.Postorder graph) :
    let location := tail_location original index
    let clauseOwners := ⟨location.installation.handler,selectedClause.owner,
      CoreTranslation.ticket graph selectedClause.owner⟩ :: location.owners
    CurrentScopeOrigin graph clauseOwners
      (.ticket (CoreTranslation.ticket graph selectedClause.owner) dynamicTicket) current.physical ∧
    SiteLineage graph clauseOwners
      (.ticket (CoreTranslation.ticket graph selectedClause.owner) dynamicTicket) selectedClause.body := by
  have canonical := origin_canonical captured.installation.installation.origin
  have selectedSite := SiteLineage.selected_clause (dynamicTicket := dynamicTicket) postorder canonical
    captured.installation.installation.known captured.installation.installation.kind captured.installation.member
  have path := bind_owner_path current.binds (OwnerPath.hit (saved := some ((tail_location original index).inside ++
    [.handlerBoundary (tail_location original index).site (tail_location original index).environment
      (tail_location original index).data.activation])) (handler := (tail_location original index).installation.handler)
      (owner := selectedClause.owner) (occurrence := (tail_location original index).data.activation)
      (dynamicTicket := dynamicTicket) (tail_location original index).outside)
  refine ⟨.clause canonical path,?_⟩
  simpa only [captured.sameSelected,captured.installation.sameHandler] using selectedSite

/-- The restored running completion retains its original prefix and adds only
this generated clause front and the SAME selected spent receipt to its tail. -/
noncomputable def ClauseOccurrence.restored (current : ClauseOccurrence captured result heap) :
    let location := current.owner_location
    RunningOccurrence start heap
      (location.captured ++ (location.front ++
        .clauseBoundary (tail_location original index).installation.handler selectedClause.owner
          location.occurrence location.dynamicTicket none :: location.outside))
      (location.capturedTarget.append (location.frontTarget.append
        (.spent location.dynamicTicket location.data.answer location.data.scope location.tail))) := by
  let contained := contained_occurrence original index
  refine {
    extension := extension_trans contained.extension current.extension
    front := contained.front,frontTarget := contained.frontTarget
    frontHistory := contained.frontHistory.heap_weaken current.extension
    tail := contained.tail ++ (current.front ++
      .clauseBoundary (tail_location original index).installation.handler selectedClause.owner
        (tail_location original index).data.activation dynamicTicket none :: (tail_location original index).outside)
    tailTarget := contained.tailTarget.append (current.frontTarget.append
      (.spent dynamicTicket (tail_location original index).data.answer
        (tail_location original index).data.scope (tail_location original index).tail))
    tailHistory := (contained.tailHistory.heap_weaken current.extension).append
      (current.frontHistory.append (.spent captured.installation
        (captured.header.heap_weaken current.extension)
        ((tail_location original index).after.heap_weaken current.extension)))
    physicalSame := ?_,targetSame := ?_ }
  · simpa only [ClauseOccurrence.owner_location,OwnerLocation.prepend,CapturedOccurrence.owner_location,
      List.append_nil,List.nil_append,List.append_assoc,List.cons_append] using
      congrArg (fun xs => xs ++ (current.front ++
        .clauseBoundary (tail_location original index).installation.handler selectedClause.owner
          (tail_location original index).data.activation dynamicTicket none :: (tail_location original index).outside))
        contained.physicalSame
  · simpa only [ClauseOccurrence.owner_location,OwnerLocation.prepend,CapturedOccurrence.owner_location,
      stack_append_assoc,Stack.append] using
      congrArg (fun xs => xs.append (current.frontTarget.append
        (.spent dynamicTicket (tail_location original index).data.answer
          (tail_location original index).data.scope (tail_location original index).tail))) contained.targetSame

/-- Actual resume consumes the computed first physical owner through the front
produced by bind/beta factories; it restores the original running occurrence. -/
theorem ClauseOccurrence.resume {base : CoreMachine.State}
    (current : ClauseOccurrence captured result base.heap)
    (frame : CoreResumeFrames.ResumeRel graph frameOwners base.heap
      (.resume (tail_location original index).installation.handler selectedClause.owner) plain)
    (context : plain.context = .resume binder)
    (value : ValueRel graph owners base.heap coreValue code)
    (resolve : plain.scope.resolve binder = some dynamicTicket) (runtimeScope : Execution.Scope) :
    let location := current.owner_location
    GeneralStepWitness graph
      ⟨resumeBefore base (tail_location original index).installation.handler selectedClause.owner coreValue current.physical,
        .eval ⟨.resume binder code,plain.scope,current.target⟩,owners,
          [(frameOwners,.resume (tail_location original index).installation.handler selectedClause.owner)]⟩
      ⟨resumeAfter base (tail_location original index).installation.handler selectedClause.owner
          location.occurrence location.dynamicTicket coreValue location.captured location.front location.outside,
        .eval ⟨code,plain.scope,location.capturedTarget.append (location.frontTarget.append
          (.spent location.dynamicTicket location.data.answer location.data.scope location.tail))⟩,owners,[]⟩
      [] [.ticket dynamicTicket] ∧
    ∃ restored : RunningOccurrence start base.heap
      (location.captured ++ (location.front ++
        .clauseBoundary (tail_location original index).installation.handler selectedClause.owner
          location.occurrence location.dynamicTicket none :: location.outside))
      (location.capturedTarget.append (location.frontTarget.append
        (.spent location.dynamicTicket location.data.answer location.data.scope location.tail))),
      restored = current.restored ∧ restored.front = original.front := by
  have actual := (resume_history current.history current.owner_picked frame context value resolve runtimeScope).1
  exact ⟨actual,current.restored,rfl,rfl⟩


theorem from_capture {base : CoreMachine.State}
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    (occurrence : RunningOccurrence start base.heap physical target)
    (index : Fin (handler_locations occurrence.tailHistory).length) :
    let location := tail_location occurrence index
    ∀ (_same : location.data.effectInst = requested)
      (_prefixScope : SourceRecursiveRoutes.Scope context location.front.erase)
      (_route : SourceResourceRoutes.Route outward context requested none)
      (_lookup : CoreMachine.findInterpreter graph (Instantiation.freezeEffect requested) physical =
        .ok (.handler location.inside location.site location.environment location.data.activation location.outside))
      (_selected : location.installation.clauses.find? (fun clause => clause.operation == operation) = some selectedClause)
      (_operand : ValueRel graph operandOwners base.heap value operandCode)
      (_requestCarrier : EnvCloses graph operandOwners base.heap requestEnvironment
        (.perform effect operation .unit) (.perform (Instantiation.freezeEffect requested) operation .unit))
      (plain : PlainData) (_context : plain.context = .perform (Instantiation.freezeEffect requested) operation)
      (_ready : ∀ parameter binder body, ClauseAt operation location.data.clauses parameter binder body → ClosedExcept parameter body)
      (operationResult : Ty) (_runtimeScope : Execution.Scope),
    ∃ (fuel : Nat) (argument : Binder) (rawBody body : Code),
      selectedClause.argument = .binder argument ∧
      ClauseAt operation location.data.clauses argument.id (CoreTranslation.ticket graph selectedClause.owner) body ∧
      translateFuel graph fuel
        (⟨location.installation.handler,selectedClause.owner,CoreTranslation.ticket graph selectedClause.owner⟩ :: location.owners)
        selectedClause.body = .ok rawBody ∧
      EnvCloses graph
        (⟨location.installation.handler,selectedClause.owner,CoreTranslation.ticket graph selectedClause.owner⟩ :: location.owners)
        base.heap (.binding argument.id value location.environment) rawBody (body.subst argument.id operandCode) ∧
      GeneralStepWitness graph
        ⟨captureBefore base value effect operation requestEnvironment physical,
          .eval ⟨.perform (Instantiation.freezeEffect requested) operation operandCode,plain.scope,target⟩,
          operandOwners,[(operandOwners,.request effect operation requestEnvironment)]⟩
        ⟨captureAfter base selectedClause argument.id value location.installation.handler location.data.activation
          location.site location.environment location.inside location.outside,
          .eval ⟨body.subst argument.id operandCode,.ticket (CoreTranslation.ticket graph selectedClause.owner) base.nextOwner,
            .live base.nextOwner operationResult location.data.answer
              (location.front.append (.push (.handler location.data) .nil)) location.data.scope location.tail⟩,
          ⟨location.installation.handler,selectedClause.owner,CoreTranslation.ticket graph selectedClause.owner⟩ :: location.owners,[]⟩
          [.ticket base.nextOwner] [] ∧
      ∃ captured : CapturedOccurrence occurrence index selectedClause base.nextOwner,
        captured.installation.predecessor = base ∧
        captured.installation.originalInside = location.inside ∧
        captured.installation.originalOutside = location.outside ∧
        ∃ current : ClauseOccurrence captured operationResult base.heap,
          current.front = [] ∧ current.frontTarget = .nil := by
  dsimp only
  intro same prefixScope route lookup selected operand requestCarrier plain context ready operationResult runtimeScope
  obtain ⟨fuel,argument,rawBody,body,pattern,clauseAt,translated,closed,step,captured,pred,inside,outside⟩ :=
    CoreCallableRunningCapture.capture occurrence index same prefixScope route lookup selected operand requestCarrier plain context ready operationResult runtimeScope
  exact ⟨fuel,argument,rawBody,body,pattern,clauseAt,translated,closed,step,captured,pred,inside,outside,
    initial captured operationResult,rfl,rfl⟩

