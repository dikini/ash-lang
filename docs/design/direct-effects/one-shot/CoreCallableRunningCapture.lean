import CoreCallableRunningOccurrence
namespace Ash.OneShot.CoreCallableRunningCapture
open CoreSyntax CoreTranslation CoreMachine CoreValueRelation CoreStrictFrames CoreStrictStack
open ScopedExpressions ScopedExecution CoreGeneralStack CoreGeneralCaptureResume CoreGeneralRestoration
open CoreCallableReachableResume CoreCallableCleanupOrigins CoreCallableCleanupReachableTransport
open CoreCallableGeneralHistory CoreCallableRunningOccurrence CoreResumeEntry CoreRequestFrames CoreCaptureEntry

/-- The selected handler comes from the SAME produced occurrence's tail. -/
noncomputable def tail_location
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    (occurrence : RunningOccurrence start heap physical target)
    (index : Fin (handler_locations occurrence.tailHistory).length) : HandlerLocation graph heap physical target := by
  let original := (handler_locations occurrence.tailHistory)[index]
  exact {
    inside := occurrence.front ++ .cleanupCompletion data.identity savedValue :: original.inside
    front := occurrence.frontTarget.append (.push (.running data savedCode start.running.value.closed) original.front)
    before := occurrence.frontHistory.append
      ((GeneralHistory.running (start.running.heap_weaken occurrence.extension)).append original.before)
    owners := original.owners, site := original.site, environment := original.environment, data := original.data
    installation := original.installation, header := original.header
    outside := original.outside, tail := original.tail, after := original.after
    physicalSame := occurrence.physicalSame.trans (by simp only [original.physicalSame,List.append_assoc,List.cons_append])
    targetSame := occurrence.targetSame.trans (by simp only [original.targetSame,stack_append_assoc,Stack.append]) }

/-- The contained grouping is computed from the exact original occurrence. -/
noncomputable def contained_occurrence
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    (occurrence : RunningOccurrence start heap physical target)
    (index : Fin (handler_locations occurrence.tailHistory).length) :
    RunningOccurrence start heap
      ((tail_location occurrence index).inside ++ [.handlerBoundary (tail_location occurrence index).site
        (tail_location occurrence index).environment (tail_location occurrence index).data.activation])
      ((tail_location occurrence index).front.append (.push (.handler (tail_location occurrence index).data) .nil)) := by
  let original := (handler_locations occurrence.tailHistory)[index]
  refine {
    extension := occurrence.extension
    front := occurrence.front
    frontTarget := occurrence.frontTarget
    frontHistory := occurrence.frontHistory
    tail := original.inside ++ [.handlerBoundary original.site original.environment original.data.activation]
    tailTarget := original.front.append (.push (.handler original.data) .nil)
    tailHistory := original.before.append (.handler original.installation original.header .nil)
    physicalSame := ?_
    targetSame := ?_ }
  · simp only [tail_location,List.append_assoc,List.cons_append]; rfl
  · simp only [tail_location,stack_append_assoc,Stack.append]; rfl

/-- This receipt is generated by actual capture. Its contained occurrence is
structural dormant history, not an assertion of active saved caller scope. -/
structure CapturedOccurrence
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    (occurrence : RunningOccurrence start heap physical target)
    (index : Fin (handler_locations occurrence.tailHistory).length)
    (selectedClause : CoreSyntax.Clause) (dynamicTicket : Nat) where
  installation : GeneralClausePast graph (tail_location occurrence index).owners
    (tail_location occurrence index).installation.handler selectedClause.owner
    (tail_location occurrence index).data.activation dynamicTicket
    ((tail_location occurrence index).inside ++ [.handlerBoundary (tail_location occurrence index).site
      (tail_location occurrence index).environment (tail_location occurrence index).data.activation])
    (tail_location occurrence index).data
  header : OwnerHeader graph (tail_location occurrence index).owners heap
    (tail_location occurrence index).installation.handler selectedClause.owner
    (tail_location occurrence index).data.activation (tail_location occurrence index).data
  sameInstallation : HEq installation.installation (tail_location occurrence index).installation
  sameSelected : installation.selected = selectedClause
  sameInside : installation.originalInside = (tail_location occurrence index).inside
  sameOutside : installation.originalOutside = (tail_location occurrence index).outside
  sameSite : installation.site = (tail_location occurrence index).site
  sameEnvironment : installation.environment = (tail_location occurrence index).environment

noncomputable def CapturedOccurrence.history
    (captured : CapturedOccurrence (graph := graph) (heap := heap) occurrence index selectedClause dynamicTicket) (result : Ty) :
    GeneralHistory graph heap
      (.clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
        (tail_location occurrence index).data.activation dynamicTicket
        (some ((tail_location occurrence index).inside ++ [.handlerBoundary (tail_location occurrence index).site
          (tail_location occurrence index).environment (tail_location occurrence index).data.activation])) ::
        (tail_location occurrence index).outside)
      (.live dynamicTicket result (tail_location occurrence index).data.answer
        ((tail_location occurrence index).front.append (.push (.handler (tail_location occurrence index).data) .nil))
        (tail_location occurrence index).data.scope (tail_location occurrence index).tail) :=
  GeneralHistory.live (result := result) captured.installation captured.header (contained_occurrence occurrence index).history
    (tail_location occurrence index).after

/-- Actual completion capture constructs the SAME dormant occurrence receipt. -/
theorem capture {base : CoreMachine.State}
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    (occurrence : RunningOccurrence start base.heap physical target)
    (index : Fin (handler_locations occurrence.tailHistory).length) :
    let location := tail_location occurrence index
    ∀ (_same : location.data.effectInst = requested)
      (_prefixScope : SourceRecursiveRoutes.Scope context location.front.erase)
      (_route : SourceResourceRoutes.Route outward context requested none)
      (_lookup : CoreMachine.findInterpreter graph (Instantiation.freezeEffect requested) physical =
        .ok (.handler location.inside location.site location.environment location.data.activation location.outside))
      (_selected : location.installation.clauses.find? (fun clause => clause.operation == operation) = some selectedClause)
      (_operand : ValueRel graph operandOwners base.heap value operandCode)
      (_requestCarrier : EnvCloses graph operandOwners base.heap requestEnvironment
        (.perform effect operation .unit) (.perform (Instantiation.freezeEffect requested) operation .unit))
      (plain : PlainData) (_context : plain.context = .perform (Instantiation.freezeEffect requested) operation)
      (_ready : ∀ parameter binder body, ClauseAt operation location.data.clauses parameter binder body → ClosedExcept parameter body)
      (operationResult : Ty) (_runtimeScope : Execution.Scope),
    ∃ (fuel : Nat) (argument : Binder) (rawBody body : Code),
      selectedClause.argument = .binder argument ∧
      ClauseAt operation location.data.clauses argument.id (CoreTranslation.ticket graph selectedClause.owner) body ∧
      translateFuel graph fuel
        (⟨location.installation.handler,selectedClause.owner,CoreTranslation.ticket graph selectedClause.owner⟩ :: location.owners)
        selectedClause.body = .ok rawBody ∧
      EnvCloses graph
        (⟨location.installation.handler,selectedClause.owner,CoreTranslation.ticket graph selectedClause.owner⟩ :: location.owners)
        base.heap (.binding argument.id value location.environment) rawBody (body.subst argument.id operandCode) ∧
      GeneralStepWitness graph
        ⟨captureBefore base value effect operation requestEnvironment physical,
          .eval ⟨.perform (Instantiation.freezeEffect requested) operation operandCode,plain.scope,target⟩,
          operandOwners,[(operandOwners,.request effect operation requestEnvironment)]⟩
        ⟨captureAfter base selectedClause argument.id value location.installation.handler location.data.activation
          location.site location.environment location.inside location.outside,
          .eval ⟨body.subst argument.id operandCode,.ticket (CoreTranslation.ticket graph selectedClause.owner) base.nextOwner,
            .live base.nextOwner operationResult location.data.answer
              (location.front.append (.push (.handler location.data) .nil)) location.data.scope location.tail⟩,
          ⟨location.installation.handler,selectedClause.owner,CoreTranslation.ticket graph selectedClause.owner⟩ :: location.owners,[]⟩
          [.ticket base.nextOwner] [] ∧
      ∃ captured : CapturedOccurrence occurrence index selectedClause base.nextOwner,
        captured.installation.predecessor = base ∧
        captured.installation.originalInside = location.inside ∧
        captured.installation.originalOutside = location.outside := by
  dsimp only
  intro same prefixScope route lookup selected operand requestCarrier plain context ready operationResult runtimeScope
  let location := tail_location occurrence index
  have cut : GeneralHandlerCut graph base.heap requested physical target location.inside location.owners location.site
      location.environment location.data location.outside
      (location.front.append (.push (.handler location.data) .nil)) location.tail :=
    .split occurrence.history.related location.before.related location.header same location.after.related
      location.targetSame prefixScope route lookup
  obtain ⟨fuel,argument,rawBody,body,pattern,clauseAt,translated,closed,header,step⟩ :=
    capture_general cut location.installation.known location.installation.kind selected
      operand requestCarrier plain context ready operationResult runtimeScope
  let installation : GeneralClausePast graph location.owners location.installation.handler selectedClause.owner
      location.data.activation base.nextOwner
      (location.inside ++ [.handlerBoundary location.site location.environment location.data.activation]) location.data := {
    site := location.site, environment := location.environment, installation := location.installation,
    sameHandler := rfl, sameOccurrence := rfl, selected := selectedClause,
    member := List.mem_of_find?_eq_some selected, sameOwner := rfl,
    predecessor := base, originalInside := location.inside, originalOutside := location.outside,
    originalCapturedMaps := none, originalInsideMaps := none, originalOutsideMaps := none,
    mapsSame := (by intro maps same; cases same),
    insideMapsSame := (by intro maps same; cases same),
    outsideMapsSame := (by intro maps same; cases same), capturedSame := rfl,
    argument := argument.id, value := value, requestEffect := effect, operation := operation,
    requestEnvironment := requestEnvironment, sameTicket := rfl,
    actual := by simpa only [← location.physicalSame] using step.core }
  let captured : CapturedOccurrence occurrence index selectedClause base.nextOwner :=
    ⟨installation,header,HEq.rfl,rfl,rfl,rfl,rfl,rfl⟩
  exact ⟨fuel,argument,rawBody,body,pattern,clauseAt,translated,closed,step,captured,rfl,rfl,rfl⟩

/-- The physical live head is precisely the actual generated capture receipt. -/
noncomputable def CapturedOccurrence.owner_location
    (captured : CapturedOccurrence (graph := graph) (heap := heap) occurrence index selectedClause dynamicTicket)
    (result : Ty) :
    OwnerLocation graph heap (tail_location occurrence index).installation.handler selectedClause.owner
      (.clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
        (tail_location occurrence index).data.activation dynamicTicket
        (some ((tail_location occurrence index).inside ++ [.handlerBoundary (tail_location occurrence index).site
          (tail_location occurrence index).environment (tail_location occurrence index).data.activation])) ::
        (tail_location occurrence index).outside)
      (.live dynamicTicket result (tail_location occurrence index).data.answer
        ((tail_location occurrence index).front.append (.push (.handler (tail_location occurrence index).data) .nil))
        (tail_location occurrence index).data.scope (tail_location occurrence index).tail) := {
  front := [],frontTarget := .nil,frontHistory := .nil
  owners := (tail_location occurrence index).owners
  occurrence := (tail_location occurrence index).data.activation,dynamicTicket := dynamicTicket
  data := (tail_location occurrence index).data,result := result
  captured := (tail_location occurrence index).inside ++ [.handlerBoundary (tail_location occurrence index).site
    (tail_location occurrence index).environment (tail_location occurrence index).data.activation]
  capturedTarget := (tail_location occurrence index).front.append (.push (.handler (tail_location occurrence index).data) .nil)
  capturedHistory := (contained_occurrence occurrence index).history
  installation := captured.installation,header := captured.header
  outside := (tail_location occurrence index).outside,tail := (tail_location occurrence index).tail
  outsideHistory := (tail_location occurrence index).after,whole := captured.history result
  physicalSame := rfl,targetSame := rfl
  cut := .hit captured.header (contained_occurrence occurrence index).history.related
    (tail_location occurrence index).after.related }

private theorem and_rec_self {α : Sort u} {β : Sort v} {γ : Sort w} {x : α} {y : β}
    (f : x = x → y = y → γ) (h : x = x ∧ y = y) : And.rec f h = f rfl rfl := by
  have same : h = ⟨rfl,rfl⟩ := Subsingleton.elim _ _
  cases same
  rfl

theorem CapturedOccurrence.owner_picked
    (captured : CapturedOccurrence occurrence index selectedClause dynamicTicket) (result : Ty) :
    owner_search (captured.history result) (tail_location occurrence index).installation.handler selectedClause.owner =
      .found (captured.owner_location result) := by
  simp [CapturedOccurrence.history,owner_search,CapturedOccurrence.owner_location]
  rw [and_rec_self]

/-- Resume reconstructs the contained running occurrence from this generated
capture and SAME selected marker. No independent front or desired origin enters. -/
noncomputable def CapturedOccurrence.restored
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    {occurrence : RunningOccurrence start heap physical target}
    {index : Fin (handler_locations occurrence.tailHistory).length}
    (captured : CapturedOccurrence (graph := graph) (heap := heap) occurrence index selectedClause dynamicTicket)
    (result : Ty) :
    RunningOccurrence start heap
      ((captured.owner_location result).captured ++
        .clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
          (tail_location occurrence index).data.activation dynamicTicket none :: (tail_location occurrence index).outside)
      ((captured.owner_location result).capturedTarget.append
        (.spent dynamicTicket (tail_location occurrence index).data.answer
          (tail_location occurrence index).data.scope (tail_location occurrence index).tail)) := by
  let contained := contained_occurrence occurrence index
  refine {
    extension := contained.extension
    front := contained.front,frontTarget := contained.frontTarget,frontHistory := contained.frontHistory
    tail := contained.tail ++ .clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
      (tail_location occurrence index).data.activation dynamicTicket none :: (tail_location occurrence index).outside
    tailTarget := contained.tailTarget.append (.spent dynamicTicket (tail_location occurrence index).data.answer
      (tail_location occurrence index).data.scope (tail_location occurrence index).tail)
    tailHistory := contained.tailHistory.append (.spent captured.installation captured.header (tail_location occurrence index).after)
    physicalSame := ?_
    targetSame := ?_ }
  · exact (congrArg (fun xs => xs ++ .clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
      (tail_location occurrence index).data.activation dynamicTicket none :: (tail_location occurrence index).outside)
      contained.physicalSame).trans (by simp only [List.append_assoc,List.cons_append])
  · simpa only [CapturedOccurrence.owner_location,stack_append_assoc,Stack.append] using
      congrArg (fun xs => xs.append (.spent dynamicTicket (tail_location occurrence index).data.answer
        (tail_location occurrence index).data.scope (tail_location occurrence index).tail)) contained.targetSame

/-- Actual immediate resume consumes the computed head owner of the generated
live capture and emits the restored occurrence with that SAME spent receipt. -/
theorem CapturedOccurrence.resume {base : CoreMachine.State}
    {start : RunningStartPast graph cleanupOwners action environment data savedValue savedCode originalPhysical originalTarget}
    {occurrence : RunningOccurrence start base.heap physical target}
    {index : Fin (handler_locations occurrence.tailHistory).length}
    (captured : CapturedOccurrence occurrence index selectedClause dynamicTicket) (result : Ty)
    (frame : CoreResumeFrames.ResumeRel graph frameOwners base.heap
      (.resume (tail_location occurrence index).installation.handler selectedClause.owner) plain)
    (context : plain.context = .resume binder)
    (value : ValueRel graph owners base.heap coreValue code)
    (resolve : plain.scope.resolve binder = some dynamicTicket) (runtimeScope : Execution.Scope) :
    let location := captured.owner_location result
    GeneralStepWitness graph
      ⟨resumeBefore base location.installation.installation.handler selectedClause.owner coreValue
          (.clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
            (tail_location occurrence index).data.activation dynamicTicket (some location.captured) :: location.outside),
        .eval ⟨.resume binder code,plain.scope,
          .live dynamicTicket result location.data.answer location.capturedTarget location.data.scope location.tail⟩,
        owners,[(frameOwners,.resume (tail_location occurrence index).installation.handler selectedClause.owner)]⟩
      ⟨resumeAfter base (tail_location occurrence index).installation.handler selectedClause.owner
          location.occurrence dynamicTicket coreValue location.captured [] location.outside,
        .eval ⟨code,plain.scope,location.capturedTarget.append
          (.spent dynamicTicket location.data.answer location.data.scope location.tail)⟩,owners,[]⟩ [] [.ticket dynamicTicket] ∧
    ∃ next : RunningOccurrence start base.heap
        (location.captured ++ .clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
          location.occurrence dynamicTicket none :: location.outside)
        (location.capturedTarget.append (.spent dynamicTicket location.data.answer location.data.scope location.tail)),
      next = captured.restored result ∧ next.front = occurrence.front ∧
      next.tail = ((handler_locations occurrence.tailHistory)[index]).inside ++
        [.handlerBoundary ((handler_locations occurrence.tailHistory)[index]).site
          ((handler_locations occurrence.tailHistory)[index]).environment
          ((handler_locations occurrence.tailHistory)[index]).data.activation] ++
        .clauseBoundary (tail_location occurrence index).installation.handler selectedClause.owner
          location.occurrence dynamicTicket none :: location.outside := by
  have actual := (resume_history (captured.history result) (captured.owner_picked result)
    frame context value resolve runtimeScope).1
  have handlerSame := captured.installation.sameHandler
  refine ⟨?_,captured.restored result,rfl,rfl,rfl⟩
  simpa only [CapturedOccurrence.owner_location,List.nil_append,Stack.append,handlerSame] using actual

