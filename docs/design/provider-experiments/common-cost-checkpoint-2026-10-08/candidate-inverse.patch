-fn flag(ownership: &mut [Ownership], port: usize, bits: u16,
-    budget: &mut TypeWorkBudget) -> Result<(), Failure>
-{
-    charge(budget, 1)?;
-    ownership.get_mut(port).ok_or(Failure::Invalid)?.flags |= bits;
